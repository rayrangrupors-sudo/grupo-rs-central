func _log_product_details(product: Dictionary) -> String:
	if product.is_empty():
		return ""

	var parts: Array[String] = []
	var plate := str(product.get("plate", "")).strip_edges()
	var model := str(product.get("model", product.get("category", ""))).strip_edges()
	var operator_name := str(product.get("operator", "")).strip_edges()
	var status := str(product.get("tracker_status", product.get("status", ""))).strip_edges()

	if plate != "":
		parts.append("Placa: %s" % plate)
	if model != "":
		parts.append("Tipo: %s" % model)
	if operator_name != "":
		parts.append("Operadora: %s" % operator_name)
	if status != "":
		parts.append("Status: %s" % status)

	return " | ".join(parts)


