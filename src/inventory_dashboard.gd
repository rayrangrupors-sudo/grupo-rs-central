func _parse_client_financial_xlsx_file(path: String) -> Dictionary:
	var errors: Array[String] = []
	var rows: Array[Dictionary] = []
	var reader := ZIPReader.new()
	if reader.open(path) != OK:
		return {"rows": rows, "errors": ["Não foi possível abrir a planilha XLSX."]}
	var strings := _read_xlsx_shared_strings(reader)
	var sheets := _find_xlsx_sheet_paths(reader)
	if sheets.is_empty():
		reader.close()
		return {"rows": rows, "errors": ["Nenhuma aba foi encontrada na planilha."]}
	var sheet_rows := _read_xlsx_sheet_rows(reader, sheets[0], strings)
	reader.close()
	if sheet_rows.is_empty():
		return {"rows": rows, "errors": ["A planilha está vazia."]}
	var header_index := -1
	var header_map: Dictionary = {}
	for row_index in range(mini(sheet_rows.size(), 12)):
		var candidate: Array = sheet_rows[row_index]
		var next_map: Dictionary = {}
		for column in range(candidate.size()):
			var key := _bulk_key(str(candidate[column]))
			if _client_financial_header_matches(key, "client_number"):
				next_map["client_number"] = column
			elif _client_financial_header_matches(key, "client"):
				next_map["client"] = column
			elif _client_financial_header_matches(key, "regional"):
				next_map["regional"] = column
			elif _client_financial_header_matches(key, "status"):
				next_map["status"] = column
			elif _client_financial_header_matches(key, "amount"):
				next_map["amount"] = column
			elif _client_financial_header_matches(key, "ticket"):
				next_map["ticket"] = column
			elif _client_financial_header_matches(key, "count"):
				next_map["count"] = column
		if next_map.has("client") or next_map.has("client_number"):
			header_index = row_index
			header_map = next_map
			break
	if header_index < 0:
		return {"rows": rows, "errors": ["Não encontrei uma coluna Cliente ou Número do cliente."]}
	var grouped: Dictionary = {}
	for row_index in range(header_index + 1, sheet_rows.size()):
		var cells: Array = sheet_rows[row_index]
		var client_number := _xlsx_cell(cells, int(header_map.get("client_number", -1))).strip_edges()
		var client := _xlsx_cell(cells, int(header_map.get("client", -1))).strip_edges()
		if client == "" and client_number == "":
			continue
		var group_key := _bulk_key(client_number if client_number != "" else client)
		if not grouped.has(group_key):
			grouped[group_key] = {
				"client_number": client_number,
				"client": client if client != "" else "Não informado",
				"regional": _xlsx_cell(cells, int(header_map.get("regional", -1))).strip_edges() if header_map.has("regional") else "Não informado",
				"status": _xlsx_cell(cells, int(header_map.get("status", -1))).strip_edges() if header_map.has("status") else "Não informado",
				"boleto_total": 0.0,
				"boleto_count": 0,
				"ticket_medio": 0.0,
				"has_financial": false,
				"updated_at": Time.get_datetime_string_from_system(false, true),
			}
		var item: Dictionary = grouped[group_key]
		var amount := _client_financial_parse_money(_xlsx_cell(cells, int(header_map.get("amount", -1)))) if header_map.has("amount") else 0.0
		var count := _client_financial_parse_count(_xlsx_cell(cells, int(header_map.get("count", -1)))) if header_map.has("count") else (1 if amount > 0.0 else 0)
		var explicit_ticket := _client_financial_parse_money(_xlsx_cell(cells, int(header_map.get("ticket", -1)))) if header_map.has("ticket") else 0.0
		item["boleto_total"] = float(item.get("boleto_total", 0.0)) + amount
		item["boleto_count"] = int(item.get("boleto_count", 0)) + count
		item["ticket_medio"] = explicit_ticket if explicit_ticket > 0.0 else float(item.get("ticket_medio", 0.0))
		item["has_financial"] = bool(item.get("has_financial", false)) or amount > 0.0 or explicit_ticket > 0.0
		grouped[group_key] = item
	return {"rows": _client_financial_sorted_rows(grouped.values()), "errors": errors}


func _client_financial_header_matches(key: String, kind: String) -> bool:
	match kind:
		"client_number": return key in ["numerodocliente", "codigodocliente", "codcliente", "idcliente", "numerocliente"] or key.contains("codigocliente")
		"client": return key in ["cliente", "nomecliente", "nome"] or key.contains("nomecliente")
		"regional": return key in ["regional", "regiao", "filial", "base"] or key.contains("regional")
		"status": return key in ["status", "statusdocliente", "situacao", "situacaocliente"] or key.contains("status")
		"amount": return key.contains("valortotal") or key.contains("valorboleto") or key.contains("mensalidade") or key.contains("fechamento")
		"ticket": return key.contains("ticket") or key.contains("valormedio") or key.contains("medioboleto")
		"count": return key.contains("qtdboleto") or key.contains("quantidadeboleto") or key == "boletos" or key == "quantidade"
	return false


func _client_financial_parse_money(value: String) -> float:
	var clean := value.strip_edges().replace("R$", "").replace(" ", "")
	if clean == "":
		return 0.0
	if clean.contains(","):
		clean = clean.replace(".", "").replace(",", ".")
	return float(clean) if clean.is_valid_float() else 0.0


func _client_financial_parse_count(value: String) -> int:
	var digits := _digits_only(value)
	return int(digits) if digits != "" else 0


func _client_financial_sorted_rows(values: Array) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	for value in values:
		if typeof(value) == TYPE_DICTIONARY:
			rows.append((value as Dictionary).duplicate(true))
	rows.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return _bulk_key(str(a.get("client", ""))) < _bulk_key(str(b.get("client", "")))
	)
	return rows

