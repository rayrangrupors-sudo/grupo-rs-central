			"__EVENTARGUMENT": "",
			"ddlStatus": "A",
			"txtPsq": clean_plate,
		})
		if not bool(response.get("ok", false)):
			return {"ok": false, "exists": false, "message": str(response.get("message", ""))}
		var rows := _parse_legacy_grupo_rs_vehicle_rows(str(response.get("body", "")))
		var found := false
		for row in rows:
			if typeof(row) != TYPE_DICTIONARY:
				continue
			var candidate := row as Dictionary
