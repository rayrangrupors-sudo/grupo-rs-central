	row.add_child(_make_preview_cell(str(result.get(value_key, "")), 290, BLUE_DARK))
	row.add_child(_make_preview_cell(str(result.get("status", "")), 0, GREEN if ok else ORANGE, true))
	return panel


func _change_bulk_client_lookup_page(delta: int) -> void:
	bulk_client_lookup_current_page += delta
	_render_bulk_client_lookup_report_page()


func _bulk_client_lookup_sheet_text(results: Array[Dictionary], value_key: String = "serial_text") -> String:
	var lines: Array[String] = []
	for result in results:
		var client_name := str(result.get("input_name", "")).replace("\t", " ").replace("\n", " ").strip_edges()
		var second_column := str(result.get(value_key, "")).replace("\t", " ").replace("\n", " ").strip_edges()
		lines.append("%s\t%s" % [client_name, second_column])
	return "\n".join(lines)


func _bulk_client_sga_sheet_text(results: Array[Dictionary]) -> String:
	var lines: Array[String] = []
	for result in results:
		var client_name := str(result.get("input_name", "")).replace("\t", " ").replace("\n", " ").strip_edges()
		var rastreio := str(result.get("sga_rastreio_text", "")).replace("\t", " ").replace("\n", " ").strip_edges()
		var protecao := str(result.get("sga_protecao_text", "")).replace("\t", " ").replace("\n", " ").strip_edges()
		lines.append("%s\t%s\t%s" % [client_name, rastreio, protecao])
	return "\n".join(lines)


