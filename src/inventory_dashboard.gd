class SidebarEquipmentGuide extends Control:
	var item_count := 3
	var line_color := Color("#315775")
	var dot_color := Color("#6e91ac")

	func _ready() -> void:
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		queue_redraw()

	func _notification(what: int) -> void:
		if what == NOTIFICATION_RESIZED:
			queue_redraw()

	func _draw() -> void:
		if size.y <= 0.0:
			return
		var center_x: float = size.x * 0.5
		var top: float = 9.0
		var bottom: float = maxf(top, size.y - 9.0)
		draw_line(Vector2(center_x, top), Vector2(center_x, bottom), line_color, 2.0, true)
		for index in range(item_count):
			var ratio: float = float(index) / float(maxi(1, item_count - 1))
			var y: float = lerpf(top, bottom, ratio)
			draw_circle(Vector2(center_x, y), 3.5, dot_color)

