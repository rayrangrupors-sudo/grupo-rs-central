func _select_branch(branch_id: String, from_auto_preview: bool = false) -> void:
	var config := _branch_config(branch_id)
	if config.is_empty():
		_show_warning("Aviso", "Base nao encontrada.")
		return

	branch_preview_auto_active = from_auto_preview
	selected_branch_id = str(config.get("id", ""))
	selected_branch_name = str(config.get("name", ""))
	selected_branch_db_path = str(config.get("db_path", ""))
	selected_branch_backup_name = str(config.get("backup_name", ""))
	selected_branch_backup_dir = str(config.get("backup_dir", ""))
	selected_branch_grupo_rs_mode = str(config.get("grupo_rs_mode", "modern"))
	selected_branch_grupo_rs_base_url = str(config.get("grupo_rs_base_url", GRUPO_RS_BASE_URL))
	selected_branch_grupo_rs_platform_url = str(config.get("grupo_rs_platform_url", selected_branch_grupo_rs_base_url))
	selected_status_filter_key = "all"
	table_current_page = 0
	# Nenhum dado operacional deve atravessar a troca de base.
	_clear_inventory_visible_scope()
	location_visible_batch_id += 1
	inventory_device_cycle_generation += 1
	location_status_cache.clear()
	location_status_busy.clear()
	location_auto_queue.clear()
	location_auto_running = 0
	grupo_rs_api_logged_in = false
	grupo_rs_api_token = ""
	grupo_rs_api_health_state = "unknown"
	grupo_rs_api_last_health_at = 0
	grupo_rs_api_next_retry_at = 0
	grupo_rs_api_reconnect_attempt = 0
	grupo_rs_api_health_running = false
	grupo_rs_api_location_cache.clear()
	grupo_rs_api_location_cache_checked_at = 0
	grupo_rs_api_vehicle_cache.clear()
	grupo_rs_api_vehicle_cache_checked_at = 0
	grupo_rs_api_last_failure_at = 0
	grupo_rs_api_last_error = ""
	arya_status_cache.clear()
	arya_status_busy.clear()
	linksolutions_sim_cache.clear()
	internal_battery_cache.clear()
	internal_battery_busy.clear()
	internal_battery_queue.clear()
	internal_battery_running = 0
	_start_branch_preview_sync(branch_id, config)
	_update_branch_selector_visuals()


func _enter_selected_branch(branch_id: String) -> void:
	if selected_branch_id != branch_id:
		_select_branch(branch_id)
	_show_waiting_screen()


func _branch_display_name(branch_id: String, fallback: String = "") -> String:
	match branch_id.strip_edges().to_lower():
		"imperatriz":
			return "Imperatriz"
		"araguaina":
			return "Araguaína"
		"acailandia":
			return "Açailândia"
		"maraba":
			return "Marabá"
		_:
			return fallback.capitalize()


func _start_branch_preview_sync(branch_id: String, config: Dictionary) -> void:
	var existing_state: Dictionary = branch_preview_sync_states.get(branch_id, {})
	if selected_branch_preview_store != null and selected_branch_preview_branch_id == branch_id \
			and str(existing_state.get("state", "")) in ["connecting", "syncing", "synced", "online"]:
		return
	branch_preview_generation += 1
	var generation := branch_preview_generation
	selected_branch_preview_branch_id = branch_id
	selected_branch_preview_store = StoreScript.new()
	selected_branch_preview_store.configure(
		str(config.get("db_path", "")),
		str(config.get("backup_name", "")),
		str(config.get("backup_dir", "")),
		branch_id == "imperatriz"
	)
	selected_branch_preview_store.load_db()
	branch_preview_sync_states[branch_id] = {
		"state": "connecting",
		"message": "Iniciando pré-sincronização...",
		"last_sync_at": "",
	}
	var firebase_sync := _firebase_sync()
	if firebase_sync == null:
		branch_preview_sync_states[branch_id] = {"state": "error", "message": "Firebase indisponível."}
		return
	var status_callable := Callable(self, "_on_branch_preview_status_changed")
	if not firebase_sync.is_connected("status_changed", status_callable):
		firebase_sync.connect("status_changed", status_callable)
	firebase_sync.call("bind_store", selected_branch_preview_store, branch_id)
	call_deferred("_finish_branch_preview_sync", firebase_sync, branch_id, generation)


func _finish_branch_preview_sync(firebase_sync: Node, branch_id: String, generation: int) -> void:
	if firebase_sync == null or not is_instance_valid(firebase_sync):
		return
	var result: Variant = await firebase_sync.call("refresh_remote")
	if generation != branch_preview_generation or branch_id != selected_branch_id:
		return
	if typeof(result) == TYPE_DICTIONARY:
		_on_branch_preview_status_changed(result as Dictionary)


func _on_branch_preview_status_changed(status: Dictionary) -> void:
	var branch_id := str(status.get("branch", "")).strip_edges().to_lower()
	if branch_id == "":
		return
	branch_preview_sync_states[branch_id] = status.duplicate(true)
	_update_branch_selector_visuals()


func _branch_preview_state(branch_id: String) -> String:
	var status: Dictionary = branch_preview_sync_states.get(branch_id, {})
	return str(status.get("state", "idle")).strip_edges().to_lower()


func _branch_preview_status_text(branch_id: String) -> String:
	match _branch_preview_state(branch_id):
		"synced", "online":
			return "Online"
		"connecting", "syncing", "pending":
			return "Sincronizando"
		"offline":
			return "Offline"
		"error", "auth_error", "conflict":
			return "Atenção"
		_:
			return "Aguardando"


func _branch_preview_hint(branch_id: String) -> String:
	var status: Dictionary = branch_preview_sync_states.get(branch_id, {})
	match _branch_preview_state(branch_id):
		"synced", "online":
			return "Base sincronizada"
		"connecting", "syncing", "pending":
			return "Firebase preparando os dados..."
		"offline":
			return "Sem conexão; tente novamente"
		"error", "auth_error", "conflict":
			return str(status.get("message", "Não foi possível sincronizar.")).strip_edges()
		_:
			return "Selecione para sincronizar"


func _update_branch_selector_visuals() -> void:
	var online_count := 0
	var last_sync := ""
	for config in _branch_configs():
		var branch_id := str(config.get("id", ""))
		var state := _branch_preview_state(branch_id)
		if state in ["synced", "online"]:
			online_count += 1
			var sync_value: Dictionary = branch_preview_sync_states.get(branch_id, {})
			var sync_at := str(sync_value.get("last_sync_at", "")).strip_edges()
			if sync_at != "":
				last_sync = sync_at
		var summary_status: Variant = branch_summary_status_labels.get(branch_id)
		if summary_status is Label:
			var summary_online := state in ["synced", "online"]
			(summary_status as Label).text = "Base sincronizada" if summary_online else _branch_preview_status_text(branch_id)
			(summary_status as Label).add_theme_color_override("font_color", Color("#60758d") if summary_online else (ORANGE if state in ["connecting", "syncing", "pending"] else MUTED))
		var summary_dot: Variant = branch_summary_dot_labels.get(branch_id)
		if summary_dot is Label:
			(summary_dot as Label).text = "●"
			(summary_dot as Label).add_theme_color_override("font_color", Color("#16a05f") if state in ["synced", "online"] else (ORANGE if state in ["connecting", "syncing", "pending"] else MUTED))
		var entry: Dictionary = branch_card_entries.get(branch_id, {})
		if entry.is_empty():
			continue
		var button: Button = entry.get("button")
		var fill: Color = entry.get("fill", ORANGE)
		var selected := branch_id == selected_branch_id and not branch_preview_auto_active
		button.add_theme_stylebox_override("normal", _style_box(Color.WHITE, Color("#0879bc") if selected else Color("#d9e4ef"), 2 if selected else 1, 12, true))
		button.add_theme_stylebox_override("hover", _style_box(Color("#fbfdff"), Color("#0879bc"), 2 if selected else 1, 12, true))
		var status_label: Label = entry.get("status_label")
		var status_panel: PanelContainer = entry.get("status_panel")
		var status_text := _branch_preview_status_text(branch_id)
		status_label.text = "● %s" % status_text
		var status_color := Color("#149b61") if state in ["synced", "online"] else (ORANGE if state in ["connecting", "syncing", "pending"] else MUTED)
		status_label.add_theme_color_override("font_color", status_color)
		status_panel.add_theme_stylebox_override("panel", _style_box(Color(status_color.r, status_color.g, status_color.b, 0.10), Color(status_color.r, status_color.g, status_color.b, 0.28), 1, 14))
		var hint_label: Label = entry.get("hint_label")
		hint_label.text = _branch_preview_hint(branch_id)
		hint_label.add_theme_color_override("font_color", ORANGE if state in ["idle", "synced", "online"] else status_color)
	if branch_selector_online_badge_label != null:
		branch_selector_online_badge_label.text = "●  %d base%s online" % [online_count, "s" if online_count != 1 else ""] if online_count > 0 else "○  %d bases disponíveis" % _branch_configs().size()
	if branch_summary_count_label != null:
		branch_summary_count_label.text = "●  %d base%s online" % [online_count, "s" if online_count != 1 else ""]
	if branch_summary_last_sync_label != null and last_sync != "":
		branch_summary_last_sync_label.text = "◷  Última sincronização: %s" % last_sync


