func _parse_legacy_grupo_rs_location_rows(html: String) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	var table_regex := RegEx.new()
	if table_regex.compile("(?is)<table[^>]*class=[\"'][^\"']*accordionHeaderLocalizacao[^\"']*[\"'][^>]*>(.*?)</table>") != OK:
		return rows
	for match_result in table_regex.search_all(html):
		var cells := _html_table_cells(match_result.get_string(1))
		if cells.size() < 12:
			continue
		var plate := str(cells[1]).strip_edges()
		var serial := str(cells[2]).strip_edges()
		if plate == "" or serial == "":
			continue
		var lat_text := str(cells[9]).strip_edges()
		var lng_text := str(cells[10]).strip_edges()
		if selected_branch_id == "araguaina":
			lng_text = str(cells[9]).strip_edges()
			lat_text = str(cells[10]).strip_edges()
		var state := _legacy_location_state_from_cells(cells)
		rows.append({
			"plate": plate,
			"equipment_serial": serial,
			"speed": str(cells[3]).strip_edges(),
			"battery": str(cells[4]).strip_edges(),
			"backup_battery": str(cells[6]).strip_edges(),
			"updated_at": str(cells[7]).strip_edges(),
			"odometer": str(cells[8]).strip_edges(),
			"lat": lat_text,
			"lng": lng_text,
			"address": str(cells[11]).strip_edges(),
			"ignition": str(state.get("ignition", "")),
			"monitoring_status": str(state.get("monitoring_status", "")),
			"client": "RS300",
		})
	return rows


func _legacy_location_state_from_cells(cells: Array[String]) -> Dictionary:
	var result := {"ignition": "", "monitoring_status": ""}
	for raw_value in cells:
		var value := str(raw_value).strip_edges()
		var key := value.to_lower()
		if key == "" or key == "-":
			continue
		if key.contains("igni") or key.contains("ligad") or key == "on" or key == "off":
			result["ignition"] = value
			result["monitoring_status"] = value
			return result
		if key.contains("movimento") or key.contains("parado") or key.contains("deslig"):
			result["monitoring_status"] = value
	return result


func _legacy_select_option_value(html: String, select_id_or_name: String, wanted_text: String) -> String:
	var select_html := _regex_first_group(
		html,
		"(?is)<select[^>]+(?:id|name)=[\"']?%s[\"']?[^>]*>(.*?)</select>" % select_id_or_name
	)
	if select_html == "":
		return ""
	var option_regex := RegEx.new()
	if option_regex.compile("(?is)<option[^>]*value=[\"']?([^\"' >]+)[\"']?[^>]*>(.*?)</option>") != OK:
		return ""
	var target := _search_key(wanted_text)
	for match_result in option_regex.search_all(select_html):
		var value := _decode_basic_html_entities(match_result.get_string(1)).strip_edges()
		var label := _clean_html_text(match_result.get_string(2))
		if _search_key(label) == target:
			return value
	return ""


func _extract_selected_option_text_by_id_or_name(html: String, select_id_or_name: String) -> String:
	var select_html := _regex_first_group(
		html,
		"(?is)<select[^>]+(?:id|name)=[\"']?%s[\"']?[^>]*>(.*?)</select>" % select_id_or_name
	)
	if select_html == "":
		return ""
	var selected := _regex_first_group(select_html, "(?is)<option[^>]+selected[^>]*>(.*?)</option>")
	if selected == "":
		var value := _regex_first_group(select_html, "(?is)<option[^>]+value=[\"']?([^\"' >]+)[\"']?[^>]*>(.*?)</option>")
		if value != "":
			selected = value
	return _clean_html_text(selected)


func _html_table_cells(row_html: String) -> Array[String]:
	var cells: Array[String] = []
	var cell_regex := RegEx.new()
	if cell_regex.compile("(?s)<td[^>]*>(.*?)</td>") != OK:
		return cells

	for match_result in cell_regex.search_all(row_html):
		cells.append(_clean_html_text(match_result.get_string(1)))
	return cells


func _clean_html_text(value: String) -> String:
	var text_value := value
	var tag_regex := RegEx.new()
	if tag_regex.compile("(?s)<[^>]+>") == OK:
		text_value = tag_regex.sub(text_value, " ", true)
	return _decode_basic_html_entities(text_value).replace("\n", " ").replace("\t", " ").strip_edges()


func _regex_first_group(value: String, pattern: String) -> String:
	var regex := RegEx.new()
	if regex.compile(pattern) != OK:
		return ""
	var found := regex.search(value)
	if found == null:
		return ""
	return found.get_string(1)


func _show_location_lookup(serial: String, fallback_plate: String = "", fallback_client: String = "") -> void:
	var clean_serial := serial.strip_edges()
	if clean_serial == "":
		_show_warning("Localizacao", "Numero de serie nao informado.")
		return

	var progress := _show_location_progress_dialog(clean_serial)
	var progress_callback := func(stage: int, message: String, detail: String):
		_set_location_progress(progress, stage, message, detail)

	var result := await _lookup_grupo_rs_location(clean_serial, progress_callback, "", fallback_plate, fallback_client)

	if not bool(result.get("ok", false)):
		_close_location_progress(progress)
		_show_warning("Localizacao", str(result.get("message", "Nao foi possivel consultar a localizacao.")))
		return

	_set_location_progress(progress, 3, "Estimando cobertura", "Monitor 4G")
	result["signal_forecast"] = _build_monitor_4g_signal_forecast(clean_serial, result)
	_cache_location_status(clean_serial, result)
	_set_location_progress(progress, 3, "Localizacao pronta", str(_location_monitoring_status(result).get("label", "")))
	await get_tree().create_timer(0.12).timeout
	_close_location_progress(progress)
	await _show_location_dialog(result)


