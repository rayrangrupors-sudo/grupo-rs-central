	return pager


func _refresh_table_pager(total_count: int, page_count: int, start_index: int, end_index: int) -> void:
	if table_pager == null:
		return

	if table_page_info_label:
		if total_count <= 0:
			table_page_info_label.text = "Nenhum registro"
		else:
			table_page_info_label.text = "Mostrando %d-%d de %d encontrados" % [start_index + 1, end_index, total_count]
	var next_signature := "%d|%d|%d|%d|%d" % [
		total_count,
		page_count,
		start_index,
		end_index,
		table_current_page,
	]
	if table_pager_signature == next_signature:
		return
	table_pager_signature = next_signature

	for i in range(table_pager.get_child_count() - 1, 0, -1):
		var child := table_pager.get_child(i)
		table_pager.remove_child(child)
		child.queue_free()

	if page_count <= 1:
		return

	table_pager.add_child(_make_page_button("<", table_current_page > 0, Callable(self, "_change_table_page").bind(-1), false))

	for page_index in _visible_page_indexes(page_count):
		if page_index < 0:
			table_pager.add_child(_make_page_gap())
			continue
		table_pager.add_child(_make_page_button(
			str(page_index + 1),
			page_index != table_current_page,
			Callable(self, "_set_table_page").bind(page_index),
			page_index == table_current_page
		))

	table_pager.add_child(_make_page_button("Proximo", table_current_page < page_count - 1, Callable(self, "_change_table_page").bind(1), false))


func _visible_page_indexes(page_count: int) -> Array[int]:
	return _visible_page_indexes_for(page_count, table_current_page)


func _visible_page_indexes_for(page_count: int, current_page: int) -> Array[int]:
	var result: Array[int] = []
	if page_count <= 7:
		for page_index in range(page_count):
			result.append(page_index)
		return result

	result.append(0)
	var window_start := maxi(current_page - 1, 1)
	var window_end := mini(current_page + 1, page_count - 2)
	if window_start > 1:
		result.append(-1)
	for page_index in range(window_start, window_end + 1):
		result.append(page_index)
	if window_end < page_count - 2:
		result.append(-1)
	result.append(page_count - 1)
	return result


