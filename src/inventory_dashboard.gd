func _parse_grupo_rs_equipment_rows(html: String) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	var tbody := _regex_first_group(html, "(?s)<tbody[^>]*>(.*?)</tbody>")
	if tbody == "":
		return rows

	var row_regex := RegEx.new()
	if row_regex.compile("(?s)<tr[^>]*>(.*?)</tr>") != OK:
		return rows

	for match_result in row_regex.search_all(tbody):
		var row_html := match_result.get_string(1)
		var cells := _html_table_cells(row_html)
		if cells.size() < 6:
			continue
		var serial := str(cells[0]).strip_edges()
		if serial == "":
			continue
		# O portal novo inclui a coluna Modelo entre Serie e Placa (e uma
		# coluna Acoes no final). O portal antigo nao inclui Modelo. Detecte o
		# layout pela quantidade de celulas para nao deslocar placa, chip e
		# telefone — um deslocamento aqui pode fazer uma reentrada consultar a
		# associacao errada.
		var modern_layout := cells.size() >= 7
		var plate_index := 2 if modern_layout else 1
		var client_index := 3 if modern_layout else 2
		var chip_index := 4 if modern_layout else 3
		var phone_index := 5 if modern_layout else 4
		var status_index := 6 if modern_layout else 5
		if status_index >= cells.size():
			continue
		var edit_href := _regex_first_group(row_html, "(?is)href=[\"']([^\"']*equipamentos_editar\\.php\\?id=[^\"']+)[\"']")
		var activate_href := _decode_basic_html_entities(_regex_first_group(row_html, "(?is)href=[\"']([^\"']*equipamentos_actions?\\.php\\?acao=ativar[^\"']+)[\"']"))
		var inactivate_href := _decode_basic_html_entities(_regex_first_group(row_html, "(?is)href=[\"']([^\"']*equipamentos_actions?\\.php\\?acao=inativar[^\"']+)[\"']"))
		var edit_id := _regex_first_group(row_html, "(?is)data-id=[\"']?(\\d+)[\"']?")
		if edit_id == "":
			edit_id = _regex_first_group(edit_href + activate_href + inactivate_href, "(?is)[?&]id=(\\d+)")
		rows.append({
			"serial": serial,
			"plate": str(cells[plate_index]).strip_edges(),
			"client": str(cells[client_index]).strip_edges(),
			"chip": str(cells[chip_index]).strip_edges(),
			"phone": str(cells[phone_index]).strip_edges(),
			"status": str(cells[status_index]).strip_edges(),
			"edit_href": edit_href,
			"activate_href": activate_href,
			"inactivate_href": inactivate_href,
			"edit_id": edit_id,
		})

	return rows


func _parse_modern_grupo_rs_vehicle_rows(html: String) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	var tbody := _regex_first_group(html, "(?s)<tbody[^>]*>(.*?)</tbody>")
	if tbody == "":
		return rows

	var row_regex := RegEx.new()
