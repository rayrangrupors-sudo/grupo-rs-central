func _set_option_value(option_value, value: String) -> void:
	if not (option_value is OptionButton):
		return
	var option := option_value as OptionButton
	var target := value.strip_edges().to_lower()
	for i in range(option.item_count):
		if option.get_item_text(i).strip_edges().to_lower() == target:
			option.select(i)
			return
	if option.item_count > 0:
		option.select(0)


func _selected_option_text(option_value, ignore_placeholder: bool) -> String:
	if not (option_value is OptionButton):
		return ""
	var option := option_value as OptionButton
	if option.selected < 0:
		return ""
	var text_value := option.get_item_text(option.selected).strip_edges()
	if ignore_placeholder and text_value.to_lower() == "selecione":
		return ""
	return text_value


func _field_text(key: String) -> String:
	var field = form_fields.get(key)
	if field is LineEdit:
		return (field as LineEdit).text.strip_edges()
	return ""


