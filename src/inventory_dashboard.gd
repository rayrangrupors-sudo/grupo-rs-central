func _guardian_on_snapshot_changed(_snapshot: Dictionary) -> void:
	_refresh_guardian_status_labels()
	if guardian_view_body != null and is_instance_valid(guardian_view_body):
		_refresh_guardian_view_body()


func _refresh_guardian_status_labels() -> void:
	if system_guardian == null or not is_instance_valid(system_guardian):
		return
	var snapshot: Dictionary = system_guardian.call("get_snapshot")
	var status := str(snapshot.get("status", "idle"))
	var color := _guardian_status_color(status)
	if guardian_status_label != null and is_instance_valid(guardian_status_label):
		guardian_status_label.text = _guardian_topbar_text(snapshot, status)
		guardian_status_label.add_theme_color_override("font_color", color)
	if guardian_status_dot != null and is_instance_valid(guardian_status_dot):
		guardian_status_dot.set_dot_color(color)
	if guardian_time_label != null and is_instance_valid(guardian_time_label):
		guardian_time_label.text = _guardian_time_text(snapshot)
		guardian_time_label.add_theme_color_override("font_color", color)


func _guardian_topbar_text(snapshot: Dictionary, status: String) -> String:
	if not bool(snapshot.get("enabled", true)):
		return "Pausado"
	if bool(snapshot.get("running", false)) or status == "checking":
		return "Analisando"
	match status:
		"warning":
			return "Atencao"
		"error":
			return "Verificar"
		_:
			return "Ativo"


func _guardian_time_text(snapshot: Dictionary) -> String:
	if not bool(snapshot.get("enabled", true)):
		return "pausado"
	if bool(snapshot.get("running", false)) or str(snapshot.get("status", "")) == "checking":
		return "agora"
	if system_guardian != null and is_instance_valid(system_guardian):
		return _format_countdown(int(system_guardian.call("seconds_until_next")))
	return "--:--"


func _guardian_status_color(status: String) -> Color:
	match status:
		"ok", "recovered":
			return GREEN
		"checking", "idle":
			return BLUE
		"info":
			return BLUE
		"warning":
			return YELLOW
		"error":
			return RED
	return MUTED


func _make_auto_reset_status_widget() -> Control:
	var button := Button.new()
	button.text = ""
