	match status:
		"normal":
			return Color("#43c751")
		"attention":
			return Color("#ffd21f")
		"unstable":
			return Color("#ff8315")
		"critical":
			return Color("#ff382c")
		"no_comm":
			return Color("#8d98a6")
	return Color("#43c751")


