func _update_form_vehicle_fields_state() -> void:
	var enabled := form_associate_vehicle_toggle != null and form_associate_vehicle_toggle.button_pressed
	for key in ["plate", "vehicle_model", "vehicle_brand", "vehicle_year", "vehicle_color", "vehicle_chassis", "vehicle_observation", "client", "vehicle_type"]:
		var node: Control = form_fields.get(key) if form_fields.get(key) is Control else form_options.get(key) if form_options.get(key) is Control else null
		if node != null and is_instance_valid(node):
			node.modulate = Color.WHITE if enabled else Color(0.72, 0.78, 0.84, 1.0)
			node.mouse_filter = Control.MOUSE_FILTER_STOP if enabled else Control.MOUSE_FILTER_IGNORE
	_update_form_summary()


func _update_form_summary() -> void:
	if form_summary_label == null or not is_instance_valid(form_summary_label):
		return
	var serial := _digits_only(_field_text("imei"))
	var plate := _format_grupo_rs_vehicle_plate(_field_text("plate"))
	var apn := _selected_option_text(form_options.get("apn_source"), true)
	var operator_name := _selected_option_text(form_options.get("operator"), true)
	var status := _selected_option_text(form_options.get("tracker_status"), false)
	var associated := form_associate_vehicle_toggle != null and form_associate_vehicle_toggle.button_pressed
	form_summary_label.text = "Serie: %s\nAPN: %s\nOperadora: %s\nStatus local: %s\n\n" % [serial if serial != "" else "Aguardando", apn if apn != "" else "A definir", operator_name if operator_name != "" else "A definir", status if status != "" else "Estoque"]
	form_summary_label.text += ("Vinculo: %s\nPlaca: %s" % ["Novo vinculo" if form_mode == "new" else "Reentrada", plate if associated and plate != "" else "Sem veiculo associado"])
	# O vinculo remoto e o espelho Firebase sao estados independentes: um
	# aparelho antigo pode existir no Grupo RS e ainda ser um novo registro local.
	# Exiba ambos para evitar que "Novo vinculo" seja interpretado como novo
	# cadastro remoto.
	if serial != "" and not form_grupo_rs_data.is_empty():
		var remote_plate := _format_grupo_rs_vehicle_plate(str(form_grupo_rs_data.get("plate", "")))
		if remote_plate != "":
			form_summary_label.text += "\nVinculo remoto: existente (%s)" % remote_plate
		var local_record := store.get_product(serial) if store != null else {}
		form_summary_label.text += "\nRegistro Firebase: %s" % ("existente" if not local_record.is_empty() else "novo")
	if form_summary_status_label != null and is_instance_valid(form_summary_status_label):
		form_summary_status_label.text = "Pronto para revisar" if serial != "" else "Aguardando IMEI"


