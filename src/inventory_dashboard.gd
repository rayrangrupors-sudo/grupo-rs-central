func _log_action_color(action: String, details: String = "") -> Color:
	var key := ("%s %s" % [action, details]).to_lower()
	if key.contains("recuperado"):
		return GREEN
	if key.contains("falhou") or key.contains("erro"):
		return RED
	if key.contains("enviou reset") or key.contains("sms"):
		return BLUE
	if key.contains("manut"):
		return YELLOW
	if key.contains("sincroniza"):
		return Color("#2f7fc1")
	if key.contains("editou") or key.contains("cadastro"):
		return ORANGE
	return MUTED


func _log_action_badge(action: String) -> String:
	var key := action.to_lower()
	if key.contains("recuperado"):
		return "Recuperado"
	if key.contains("falhou"):
		return "Falha"
	if key.contains("enviou reset"):
		return "SMS"
	if key.contains("automatico"):
		return "Monitor"
	if key.contains("sincroniza"):
		return "Sync"
	if key.contains("editou"):
		return "Edicao"
	return "Evento"


func _system_log_entry_color(entry: Dictionary) -> Color:
	if _system_log_is_error(entry):
		return RED
	if bool(entry.get("fallback_used", false)) or str(entry.get("transport", "")).to_lower() == "web":
		return ORANGE
	if _system_log_is_completed(entry):
		return GREEN
	var phase := str(entry.get("phase", "")).to_lower()
	if phase == "comunicacao" or phase == "sincronizacao":
		return BLUE
	return MUTED


func _system_log_entry_badge(entry: Dictionary) -> String:
	if _system_log_is_error(entry):
		return "Falha"
	if bool(entry.get("fallback_used", false)) or str(entry.get("transport", "")).to_lower() == "web":
		return "Fallback"
	if _system_log_is_completed(entry):
		return "Concluido"
	var phase := str(entry.get("phase", "")).to_lower()
	match phase:
		"cadastro": return "Cadastro"
		"modificacao": return "Modificacao"
		"vinculacao": return "Vinculacao"
		"localizacao": return "Localizacao"
		"sincronizacao": return "Sync"
		"comunicacao": return "SMS"
		_: return "Em andamento"


func _system_log_transport_label(entry: Dictionary) -> String:
	var transport := str(entry.get("transport", "local")).to_lower()
	match transport:
		"api": return "API principal"
		"web": return "Portal web (fallback)"
		"firebase": return "Firebase"
		_: return "Sistema local"


func _system_log_http_label(entry: Dictionary) -> String:
	var code := int(entry.get("http_code", 0))
	return str(code) if code > 0 else "Nao informado"


func _system_log_attempt_label(entry: Dictionary) -> String:
	var attempt := int(entry.get("attempt", 0))
	var maximum := int(entry.get("max_attempts", 0))
	if attempt <= 0:
		return "1 / 1"
	return "%d / %d" % [attempt, maximum if maximum > 0 else attempt]


func _log_detail_value(details: String, key: String) -> String:
	var target := key.strip_edges().to_lower()
	for part in details.split("|"):
		var clean := str(part).strip_edges()
		var lower := clean.to_lower()
		if lower.begins_with("%s:" % target):
			return clean.substr(clean.find(":") + 1).strip_edges()
	return ""


