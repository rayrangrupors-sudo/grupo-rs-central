func _make_internal_battery_cell(product: Dictionary) -> Control:
	var wrap := CenterContainer.new()
	wrap.custom_minimum_size = Vector2(100, 0)
	var serial := _digits_only(_location_serial_for_product(product))
	var cached: Dictionary = internal_battery_cache.get(serial, {})
	var percent := int(cached.get("percent", -1))
	var loading := bool(internal_battery_busy.get(serial, false))
	var no_data := percent < 0 and not loading and not cached.is_empty()
	var color := _internal_battery_color(percent) if percent >= 0 else (BLUE if loading else (YELLOW if no_data else MUTED))

	var panel := PanelContainer.new()
	panel.custom_minimum_size = Vector2(96, 36)
	panel.add_theme_stylebox_override("panel", _style_box(_internal_battery_background(color), color.lightened(0.18), 1, 9))
	panel.tooltip_text = _internal_battery_tooltip(product, cached, loading)
	wrap.add_child(panel)

	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 9)
	margin.add_theme_constant_override("margin_right", 9)
	margin.add_theme_constant_override("margin_top", 7)
	margin.add_theme_constant_override("margin_bottom", 7)
	panel.add_child(margin)

	var row := HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 5)
	margin.add_child(row)

	var icon := InternalBatteryIcon.new()
	icon.set_value(percent, loading, color, no_data)
	row.add_child(icon)

	var label := Label.new()
	label.text = "%d%%" % percent if percent >= 0 else ("..." if loading else ("S/D" if no_data else "--"))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.add_theme_font_override("font", UI_FONT)
	label.add_theme_font_size_override("font_size", 14)
	label.add_theme_color_override("font_color", color)
	row.add_child(label)

	return wrap


func _internal_battery_color(percent: int) -> Color:
	if percent < 0:
		return MUTED
	if percent <= 20:
		return RED
	if percent <= 50:
		return YELLOW
	return GREEN


func _internal_battery_background(color: Color) -> Color:
	return Color(
		0.94 + color.r * 0.06,
		0.94 + color.g * 0.06,
		0.94 + color.b * 0.06,
		1.0
	)


func _internal_battery_display_text(value: Variant) -> String:
	if typeof(value) != TYPE_DICTIONARY:
		return "Nao consultada"
	var data := value as Dictionary
	var percent := int(data.get("percent", -1))
	if percent < 0:
		return str(data.get("message", "Indisponivel"))
	var source_at := str(data.get("source_at", "")).strip_edges()
	return "%d%%" % percent if source_at == "" else "%d%% | Registro: %s" % [percent, source_at]


func _internal_battery_tooltip(product: Dictionary, cached: Dictionary, loading: bool) -> String:
	var percent := int(cached.get("percent", -1))
	if loading and percent < 0:
		return "Consultando bateria interna na base selecionada..."
	if percent < 0:
		var message := str(cached.get("message", "Aguardando consulta.")).strip_edges()
		if message == "":
			message = "Sem dados de Bat. Int retornados pelo Grupo RS."
		var voltage := str(cached.get("voltage", "")).strip_edges()
		if voltage != "":
			message += "\nTensao registrada: %s V."
			message = message % voltage
		return "%s\nS/D = percentual interno nao informado.\nAtualizacao automatica a cada 1 minuto." % message
	var source_at := str(cached.get("source_at", "")).strip_edges()
	var detail := "Bateria interna: %d%%" % percent
	if source_at != "":
		detail += "\nRegistro: %s" % source_at
	if str(cached.get("status", "")) == "stale":
		detail += "\nSem registro novo; exibindo o ultimo valor conhecido."
	var source := str(cached.get("source", "")).strip_edges()
	if source != "":
		detail += "\nFonte: %s" % source
	return detail + "\nAtualizacao automatica a cada 1 minuto."


func _arya_product_query_key(product: Dictionary) -> String:
	return _arya_product_query_value(product)


func _arya_product_query_value(product: Dictionary) -> String:
	var iccid := _arya_product_local_iccid(product)
	if iccid != "":
		return iccid

	var serial := _digits_only(str(product.get("imei", product.get("sku", ""))))
	if serial == "":
		serial = _digits_only(str(product.get("equipment_number", "")))
	return serial


func _arya_product_local_iccid(product: Dictionary) -> String:
	var chip := _digits_only(str(product.get("chip_number", product.get("chip", ""))))
	if chip.length() >= 18:
		return chip
	return ""


func _arya_product_chip_key(product: Dictionary) -> String:
	var chip := _digits_only(str(product.get("chip_number", product.get("chip", ""))))
	if chip == "":
		chip = _digits_only(str(product.get("chip_phone", product.get("phone", ""))))
	return chip


func _arya_product_chip_short(product: Dictionary) -> String:
	var chip := _arya_product_chip_key(product)
	if chip.length() > 8:
		return chip.substr(chip.length() - 8)
	return chip


func _arya_status_label(status: String) -> String:
	match status.to_lower():
		"online":
			return "Online"
		"offline":
			return "Off"
		"standby":
			return "Off"
		"login":
			return "Login"
		"consultando":
			return "..."
		"erro":
			return "Erro"
		"desconhecido":
			return "Verificar"
		_:
			return "Chip"


func _arya_status_color(status: String) -> Color:
	match status.to_lower():
		"online":
			return GREEN
		"offline":
			return RED
		"standby":
			return RED
		"login":
			return YELLOW
		"consultando":
			return BLUE
		"erro":
			return Color("#6f7c89")
		"desconhecido":
			return YELLOW
		_:
			return BLUE


func _arya_status_tooltip(status: String, query_value: String, message: String) -> String:
	var base := "Consultar status do chip por %s" % query_value
	if status == "consultar":
		return base
	if message.strip_edges() != "":
		return "%s: %s" % [_arya_status_label(status), message]
	return "%s: %s" % [base, _arya_status_label(status)]


func _schedule_visible_arya_status_batch(products: Array[Dictionary], start_index: int, end_index: int, total_count: int) -> void:
	var signature := _visible_arya_signature(products, start_index, end_index, total_count)
	if signature == arya_visible_signature:
		return

	arya_visible_signature = signature
	arya_visible_batch_id += 1
	arya_auto_queue.clear()
	arya_auto_running = 0
	call_deferred("_start_visible_arya_status_batch", products, arya_visible_batch_id)


func _visible_arya_signature(products: Array[Dictionary], start_index: int, end_index: int, total_count: int) -> String:
	var parts: Array[String] = [
		str(table_current_page),
		str(start_index),
		str(end_index),
		str(total_count),
		str(int(Time.get_unix_time_from_system()) / ARYA_STATUS_CACHE_SECONDS),
	]
	for product in products:
		parts.append(_arya_product_query_key(product))
	return "|".join(parts)


func _start_visible_arya_status_batch(products: Array[Dictionary], batch_id: int) -> void:
	if batch_id != arya_visible_batch_id:
		return

	var queued := false
	for product in products:
		var query_key := _arya_product_query_key(product)
		var query_value := _arya_product_query_value(product)
		if query_key == "" or query_value == "":
			continue
		if bool(arya_status_busy.get(query_key, false)):
			continue
		if _arya_status_cache_is_fresh(query_key):
			continue

		arya_status_busy[query_key] = batch_id
		arya_status_cache[query_key] = {
			"status": "consultando",
			"message": "Consultando automaticamente...",
			"checked_at": Time.get_unix_time_from_system(),
		}
		arya_auto_queue.append(product)
		queued = true

	if queued:
		_refresh_table()
		_pump_arya_auto_queue(batch_id)


func _pump_arya_auto_queue(batch_id: int) -> void:
	if batch_id != arya_visible_batch_id:
		return
	while arya_auto_running < ARYA_VISIBLE_AUTO_CONCURRENCY and not arya_auto_queue.is_empty():
		var product := arya_auto_queue.pop_front() as Dictionary
		arya_auto_running += 1
		_run_auto_arya_lookup(product, batch_id)


func _run_auto_arya_lookup(product: Dictionary, batch_id: int) -> void:
	var query_key := _arya_product_query_key(product)
	var result := await _lookup_arya_status_result_for_product(product, true, true)
	if batch_id != arya_visible_batch_id:
		if int(arya_status_busy.get(query_key, -9999)) == batch_id:
			arya_status_busy.erase(query_key)
		return

	arya_status_busy.erase(query_key)
	result["checked_at"] = Time.get_unix_time_from_system()
	arya_status_cache[query_key] = result
	arya_auto_running = maxi(arya_auto_running - 1, 0)
	_refresh_table()
	_pump_arya_auto_queue(batch_id)


func _arya_status_cache_is_fresh(query_key: String) -> bool:
	var cached: Dictionary = arya_status_cache.get(query_key, {})
	if cached.is_empty():
		return false
	if str(cached.get("status", "")) == "consultando":
		return false
	var checked_at := int(cached.get("checked_at", 0))
	if checked_at <= 0:
		return false
	return int(Time.get_unix_time_from_system()) - checked_at < ARYA_STATUS_CACHE_SECONDS


func _show_arya_status_for_product(product: Dictionary) -> void:
	var query_key := _arya_product_query_key(product)
	var query_value := _arya_product_query_value(product)
	if query_value == "":
		_show_warning("Chip", "Este equipamento nao tem chip nem serie cadastrados.")
		return
	if bool(arya_status_busy.get(query_key, false)):
		return

	arya_status_busy[query_key] = -1
	arya_status_cache[query_key] = {"status": "consultando", "message": "Consultando Arya..."}
	_refresh_table()

	var result := await _lookup_arya_status_result_for_product(product, false)
	arya_status_busy.erase(query_key)
	result["checked_at"] = Time.get_unix_time_from_system()
	arya_status_cache[query_key] = result
	_refresh_table()


func _lookup_arya_status_result_for_product(product: Dictionary, use_resolve_cache: bool, fast_mode: bool = false) -> Dictionary:
	# O cadastro local ja possui a APN e o chip usado pela linha. Para Link
	# Solutions, consultar o portal web antes da API transforma um lookup curto
	# em varias requisicoes lentas e deixa a fila presa em "Aguardando".
	var local_apn := str(product.get("apn", "")).strip_edges()
	var local_chip := _arya_product_chip_key(product)
	if local_chip != "" and _apn_is_linksolutions(local_apn):
		var local_link_result := await _lookup_linksolutions_chip_status(local_chip, not fast_mode)
		local_link_result["message"] = "%s Chip %s via cadastro local. APN %s." % [
			str(local_link_result.get("message", "")),
			local_chip,
			local_apn,
		]
		return local_link_result

	var local_iccid := _arya_product_local_iccid(product)
	if local_iccid != "" and _apn_is_hinova(local_apn):
		var local_arya_result := await _lookup_arya_chip_status(local_iccid)
		local_arya_result["message"] = "%s ICCID %s via cadastro local. APN %s." % [
			str(local_arya_result.get("message", "")),
			local_iccid,
			local_apn,
		]
		return local_arya_result

	var resolved := await _resolve_arya_iccid_for_product_cached(product) if use_resolve_cache else await _resolve_arya_iccid_for_product(product)
	if not bool(resolved.get("ok", false)):
		return {
			"status": str(resolved.get("status", "erro")),
			"message": str(resolved.get("message", "Nao foi possivel resolver o chip.")),
		}

	var apn := str(resolved.get("apn", "")).strip_edges()
	if _apn_is_linksolutions(apn):
		var link_result := await _lookup_linksolutions_chip_status(str(resolved.get("iccid", "")), not fast_mode)
		var link_origin := str(resolved.get("origin", ""))
		if link_origin != "":
			link_result["message"] = "%s ICCID %s via %s. APN %s." % [
				str(link_result.get("message", "")),
				str(resolved.get("iccid", "")),
				link_origin,
				apn,
			]
		return link_result

	if not _apn_is_hinova(apn):
		return {
			"status": "desconhecido",
			"message": "APN no Grupo RS e %s. Consulta automatica bloqueada para evitar erro." % _blank(apn),
		}

	var result := await _lookup_arya_chip_status(str(resolved.get("iccid", "")))
	var origin := str(resolved.get("origin", ""))
	if origin != "":
		result["message"] = "%s ICCID %s via %s. APN %s." % [
			str(result.get("message", "")),
			str(resolved.get("iccid", "")),
			origin,
			apn,
		]
	return result


func _resolve_arya_iccid_for_product_cached(product: Dictionary) -> Dictionary:
	var query_key := _arya_product_query_key(product)
	var cached: Dictionary = arya_resolve_cache.get(query_key, {})
	var checked_at := int(cached.get("checked_at", 0))
	if not cached.is_empty() and checked_at > 0 and int(Time.get_unix_time_from_system()) - checked_at < ARYA_RESOLVE_CACHE_SECONDS:
		return cached.get("result", {})

	var result := await _resolve_arya_iccid_for_product(product)
	arya_resolve_cache[query_key] = {
		"checked_at": Time.get_unix_time_from_system(),
		"result": result,
	}
	return result


func _resolve_arya_iccid_for_product(product: Dictionary) -> Dictionary:
	var serial := _digits_only(str(product.get("imei", product.get("sku", ""))))
	if serial == "":
		serial = _digits_only(str(product.get("equipment_number", "")))

	var local_iccid := _arya_product_local_iccid(product)
	var chosen: Dictionary = {}
	if serial != "":
		var rows := await _fetch_grupo_rs_equipment_rows(serial)
		if not rows.is_empty():
			var serial_key := _search_key(serial)
			for row in rows:
				if typeof(row) != TYPE_DICTIONARY:
					continue
				var candidate := row as Dictionary
				if _search_key(str(candidate.get("serial", ""))) == serial_key:
					chosen = candidate
					break
			if chosen.is_empty() and typeof(rows[0]) == TYPE_DICTIONARY:
				chosen = rows[0] as Dictionary

	var apn := ""
	if not chosen.is_empty():
		apn = await _fetch_grupo_rs_equipment_apn(chosen)
	if apn == "":
		apn = str(product.get("apn", "")).strip_edges()

	var iccid := _digits_only(str(chosen.get("chip", "")))
	if iccid == "" and local_iccid != "":
		iccid = local_iccid
	if serial == "" and iccid == "":
		return {"ok": false, "status": "erro", "message": "Sem serie/chip para buscar no Grupo RS."}
	if chosen.is_empty() and local_iccid == "":
		return {"ok": false, "status": "desconhecido", "message": "Grupo RS nao retornou este equipamento."}
	if iccid == "":
		return {"ok": false, "status": "desconhecido", "message": "Grupo RS achou a serie, mas sem chip cadastrado."}
	if iccid.length() < 18:
		return {"ok": false, "status": "desconhecido", "message": "Chip retornado pelo Grupo RS nao parece ICCID completo: %s" % iccid}
	if apn == "":
		return {"ok": false, "status": "desconhecido", "message": "Nao foi possivel confirmar a APN no Grupo RS."}
	return {"ok": true, "iccid": iccid, "origin": "Grupo RS" if not chosen.is_empty() else "cadastro local", "apn": apn}


func _lookup_arya_chip_status(query_value: String) -> Dictionary:
	var inventory := await _lookup_arya_inventory_data(query_value)
	if not bool(inventory.get("ok", false)):
		return {
			"status": str(inventory.get("status", "erro")),
			"message": str(inventory.get("message", "Consulta indisponivel.")),
		}

	var parsed: Dictionary = inventory.get("parsed", {})
	var status := str(parsed.get("status", "desconhecido"))
	if status == "" or status == "desconhecido":
		return {"status": "desconhecido", "message": "Chip encontrado, mas sem estado claro."}

	return {"status": status, "message": "Chip %s na Arya." % status}


func _lookup_arya_inventory_data(iccid: String) -> Dictionary:
	var ensure := await _ensure_arya_token(false)
	if not bool(ensure.get("ok", false)) and _arya_token() == "":
		return {"ok": false, "status": "login", "message": str(ensure.get("message", "Credenciais Arya nao configuradas."))}
	var url := ARYA_API_INVENTARY_URL % iccid.uri_encode()
	var response := await _http_get_text_with_headers(url, _arya_request_headers())
	if not bool(response.get("ok", false)):
		var message := str(response.get("message", "Consulta indisponivel."))
		if message.contains("401") or message.contains("403"):
			var relogin := await _ensure_arya_token(true)
			if bool(relogin.get("ok", false)):
				response = await _http_get_text_with_headers(url, _arya_request_headers())
				if bool(response.get("ok", false)):
					message = ""
				else:
					message = str(response.get("message", "Consulta indisponivel."))
			if not bool(response.get("ok", false)):
				return {"ok": false, "status": "login", "message": "Arya pediu login/token: %s" % message}
		if not bool(response.get("ok", false)):
			return {"ok": false, "status": "erro", "message": message}

	var body := str(response.get("body", ""))
	var lower := body.to_lower()
	if lower.contains("login") or lower.contains("senha") or lower.contains("entrar"):
		var relogin := await _ensure_arya_token(true)
		if bool(relogin.get("ok", false)):
			response = await _http_get_text_with_headers(url, _arya_request_headers())
			if bool(response.get("ok", false)):
				body = str(response.get("body", ""))
				lower = body.to_lower()
		if lower.contains("login") or lower.contains("senha") or lower.contains("entrar"):
			return {"ok": false, "status": "login", "message": "Arya pediu login. Credenciais salvas foram tentadas."}

	var parsed := _parse_rs300_arya_response(body, iccid)
	if parsed.is_empty():
		# Alguns chips da Arya usam um prefixo diferente. Quando a consulta
		# direta pelo ICCID completo falha, a listagem autenticada permite
		# localizar pelo sufixo informado no cadastro.
		var suffix := _arya_chip_search_suffix(iccid)
		if suffix != "":
			var search_result := await _lookup_arya_inventory_search_data(suffix)
			if bool(search_result.get("ok", false)):
				return search_result
		return {"ok": false, "status": "desconhecido", "message": "Chip nao localizado automaticamente."}
	return {"ok": true, "parsed": parsed, "body": body}


func _lookup_arya_inventory_search_data(query: String) -> Dictionary:
	var clean_query := _digits_only(query)
	if clean_query == "":
		return {"ok": false, "status": "desconhecido", "message": "Numero do chip vazio para busca na Arya."}
	var ensure := await _ensure_arya_token(false)
	if not bool(ensure.get("ok", false)) and _arya_token() == "":
		return {"ok": false, "status": "login", "message": str(ensure.get("message", "Credenciais Arya nao configuradas."))}
	var response := await _http_post_json_with_headers(
		ARYA_API_INVENTARY_SEARCH_URL,
		{"per_page": 10, "filters": {"iccid": clean_query}},
		_arya_json_request_headers()
	)
	if not bool(response.get("ok", false)):
		var message := str(response.get("message", "Consulta indisponivel."))
		if message.contains("401") or message.contains("403"):
			var relogin := await _ensure_arya_token(true)
			if bool(relogin.get("ok", false)):
				response = await _http_post_json_with_headers(
					ARYA_API_INVENTARY_SEARCH_URL,
					{"per_page": 10, "filters": {"iccid": clean_query}},
					_arya_json_request_headers()
				)
		if not bool(response.get("ok", false)):
			return {"ok": false, "status": "login" if message.contains("401") or message.contains("403") else "erro", "message": message}
	var body := str(response.get("body", ""))
	var parsed := _parse_rs300_arya_response(body, clean_query)
	if parsed.is_empty():
		return {"ok": false, "status": "desconhecido", "message": "Chip nao localizado na busca de inventario da Arya."}
	return {"ok": true, "parsed": parsed, "body": body}


func _arya_chip_search_suffix(value: String) -> String:
	var digits := _digits_only(value)
	if digits.length() <= 12:
		return digits
	return digits.substr(maxi(0, digits.length() - 8))


func _lookup_linksolutions_chip_status(iccid: String, allow_deep_scan: bool = true) -> Dictionary:
	var sim_data := await _lookup_linksolutions_sim_data(iccid, allow_deep_scan)
	if not bool(sim_data.get("ok", false)):
		return {
			"status": str(sim_data.get("status", "erro")),
			"message": str(sim_data.get("message", "Consulta Linksolutions indisponivel.")),
		}

	var parsed: Dictionary = sim_data.get("parsed", {})
	var status_value: Variant = parsed.get("status__name", parsed.get("status_name", parsed.get("status", parsed.get("connection_status", parsed.get("connectionStatus", "")))))
	var status := _normalize_linksolutions_status(status_value)
	var details: Array[String] = ["Linksolutions: chip %s" % _arya_status_label(status)]
	var last_conn := str(parsed.get("last_conn", "")).strip_edges()
	var last_rat := str(parsed.get("last_rat_type", parsed.get("rat_type", parsed.get("lastRatType", "")))).strip_edges()
	var last_network := str(parsed.get("last_network", parsed.get("operator__name", parsed.get("operator", "")))).strip_edges()
	if last_conn != "":
		details.append("ultima conexao %s" % last_conn)
	if last_network != "":
		details.append("rede %s" % last_network)
	if last_rat != "":
		details.append(last_rat)
	return {"ok": true, "status": status, "message": ". ".join(details) + "."}


func _lookup_linksolutions_sim_data(iccid: String, allow_deep_scan: bool = true) -> Dictionary:
	var query := await _query_linksolutions_sim_data(iccid, allow_deep_scan)
	if bool(query.get("ok", false)):
		return query
	var query_status := str(query.get("status", ""))
	var query_message := str(query.get("message", ""))
	var should_recover := query_status == "login" or query_status == "transient" or _linksolutions_message_is_transient(query_message)
	if not should_recover:
		return query
	if not allow_deep_scan:
		# Nao renovar sessao nem repetir a consulta durante o ciclo automatico.
		# A proxima rodada tentara novamente sem bloquear as demais etapas da
		# linha atual.
		return query

	var login := await _request_linksolutions_login()
	if not bool(login.get("ok", false)):
		return {
			"ok": false,
			"status": "login",
			"message": "Linksolutions indisponivel e a sessao nao pode ser renovada: %s" % str(login.get("message", "falha de autenticacao.")),
		}
	await get_tree().create_timer(LINKSOLUTIONS_RETRY_DELAY_SECONDS).timeout
	var retry := await _query_linksolutions_sim_data(iccid, allow_deep_scan)
	if not bool(retry.get("ok", false)):
		var retry_message := str(retry.get("message", ""))
		if str(retry.get("status", "")) == "transient" or _linksolutions_message_is_transient(retry_message):
			retry["message"] = "Linksolutions nao respondeu apos renovar a sessao. Tente novamente em alguns segundos."
	return retry


func _query_linksolutions_sim_data(iccid: String, allow_deep_scan: bool = true) -> Dictionary:
	var clean_iccid := _digits_only(iccid)
	if clean_iccid == "":
		return {"ok": false, "status": "desconhecido", "message": "ICCID vazio para Linksolutions."}
	var transient_result: Dictionary = {}
	var cached: Variant = linksolutions_sim_cache.get(clean_iccid, {})
	if typeof(cached) == TYPE_DICTIONARY:
		var cached_data := cached as Dictionary
		var cached_at := int(cached_data.get("checked_at", 0))
		var cached_result: Dictionary = cached_data.get("result", {})
		var cache_ttl := LINKSOLUTIONS_SIM_CACHE_TTL_SECONDS if bool(cached_result.get("ok", false)) else LINKSOLUTIONS_FAILURE_CACHE_SECONDS
		if cached_at > 0 and Time.get_ticks_msec() - cached_at < cache_ttl * 1000:
			return cached_result
		linksolutions_sim_cache.erase(clean_iccid)

	var is_short_query := clean_iccid.length() < 18
	var filtered_attempted := false
	# Chips curtos sao resolvidos pela rota filtrada da propria Link. Ela
	# devolve o ICCID completo sem precisar varrer paginas de 1000 registros.
	# No ciclo automatico, se a rota rapida falhar, encerramos esta linha para
	# que a proxima possa ser consultada; a varredura profunda fica somente para
	# consultas manuais, onde o usuario decidiu esperar.
	if is_short_query:
		filtered_attempted = true
		var fast_filtered_url := LINKSOLUTIONS_SIM_BY_ICCID_FILTER_URL % clean_iccid.uri_encode()
		var fast_filtered := await _http_get_text_with_headers(fast_filtered_url, _linksolutions_request_headers(), LINKSOLUTIONS_FAST_QUERY_TIMEOUT_SECONDS)
		var fast_filtered_result := _parse_linksolutions_sim_response(fast_filtered)
		if bool(fast_filtered_result.get("ok", false)) and _linksolutions_sim_matches_query(fast_filtered_result.get("parsed", {}), clean_iccid):
			return _cache_linksolutions_sim_result(clean_iccid, fast_filtered_result)
		if str(fast_filtered_result.get("status", "")) == "login":
			return fast_filtered_result
		if str(fast_filtered_result.get("status", "")) == "transient":
			transient_result = fast_filtered_result
		if not allow_deep_scan:
			if not transient_result.is_empty():
				return transient_result
			return {"ok": false, "status": "desconhecido", "message": "Rota rapida da Link nao localizou o chip curto."}

	# O frontend oficial do LSIM usa esta rota para uma consulta exata por ICCID.
	# A listagem geral fica apenas como fallback para versões antigas do portal.
	var direct_url := LINKSOLUTIONS_SIM_BY_ICCID_URL % clean_iccid.uri_encode()
	var direct := await _http_get_text_with_headers(direct_url, _linksolutions_request_headers(), LINKSOLUTIONS_HTTP_TIMEOUT_SECONDS)
	var direct_result := _parse_linksolutions_sim_response(direct)
	if bool(direct_result.get("ok", false)):
		if _linksolutions_sim_matches_query(direct_result.get("parsed", {}), clean_iccid):
			return _cache_linksolutions_sim_result(clean_iccid, direct_result)
	elif str(direct_result.get("status", "")) == "login":
		return direct_result
	elif str(direct_result.get("status", "")) == "transient":
		transient_result = direct_result
	if not allow_deep_scan:
		# O ciclo automatico usa uma unica rota por linha. Fallbacks, renovacao
		# de sessao e varredura em lote ficam restritos a consultas manuais para
		# que um chip indisponivel nao segure localizacao e registros.
		return direct_result if not direct_result.is_empty() else {
			"ok": false,
			"status": "transient",
			"message": "Linksolutions nao respondeu na rota rapida."
		}

	# Algumas instalações publicam somente a variante em lote, que recebe uma lista JSON.
	# A API do LSIM aceita filtro por ICCID e tambem resolve o numero curto
	# informado no cadastro. Esta rota evita varrer milhares de chips pagina a pagina.
	if not filtered_attempted:
		var filtered_url := LINKSOLUTIONS_SIM_BY_ICCID_FILTER_URL % clean_iccid.uri_encode()
		var filtered := await _http_get_text_with_headers(filtered_url, _linksolutions_request_headers(), LINKSOLUTIONS_HTTP_TIMEOUT_SECONDS)
		var filtered_result := _parse_linksolutions_sim_response(filtered)
		if bool(filtered_result.get("ok", false)):
			if _linksolutions_sim_matches_query(filtered_result.get("parsed", {}), clean_iccid):
				return _cache_linksolutions_sim_result(clean_iccid, filtered_result)
		elif str(filtered_result.get("status", "")) == "login":
			return filtered_result
		elif str(filtered_result.get("status", "")) == "transient" and transient_result.is_empty():
			transient_result = filtered_result

	var batch := await _http_post_json_with_headers(
		LINKSOLUTIONS_SIM_BY_ICCID_LIST_URL,
		[clean_iccid],
		_linksolutions_json_request_headers(),
		LINKSOLUTIONS_HTTP_TIMEOUT_SECONDS
	)
	var batch_result := _parse_linksolutions_sim_response(batch)
	if bool(batch_result.get("ok", false)):
		if _linksolutions_sim_matches_query(batch_result.get("parsed", {}), clean_iccid):
			return _cache_linksolutions_sim_result(clean_iccid, batch_result)
	elif str(batch_result.get("status", "")) == "login":
		return batch_result
	elif str(batch_result.get("status", "")) == "transient" and transient_result.is_empty():
		transient_result = batch_result

	# Compatibilidade com a rota de pesquisa paginada usada por versões antigas do LSIM.
	var legacy := await _http_post_json_with_headers(
		LINKSOLUTIONS_SIMS_URL,
		{"iccid": [clean_iccid]},
		_linksolutions_json_request_headers(),
		LINKSOLUTIONS_HTTP_TIMEOUT_SECONDS
	)
	var legacy_result := _parse_linksolutions_sim_response(legacy)
	if bool(legacy_result.get("ok", false)):
		if _linksolutions_sim_matches_query(legacy_result.get("parsed", {}), clean_iccid):
			return _cache_linksolutions_sim_result(clean_iccid, legacy_result)
	elif str(legacy_result.get("status", "")) == "login":
		return legacy_result
	elif str(legacy_result.get("status", "")) == "transient" and transient_result.is_empty():
		transient_result = legacy_result
	if clean_iccid.length() < 18:
		var scanned := await _scan_linksolutions_sim_by_iccid_suffix(clean_iccid)
		if bool(scanned.get("ok", false)):
			return _cache_linksolutions_sim_result(clean_iccid, scanned)
		if str(scanned.get("status", "")) in ["login", "transient"]:
			return scanned
		if not transient_result.is_empty():
			return transient_result
		return scanned
	var not_found := {"ok": false, "status": "desconhecido", "message": "Chip nao localizado na Linksolutions."}
	if not transient_result.is_empty():
		return transient_result
	return not_found


func _parse_linksolutions_sim_response(response: Dictionary) -> Dictionary:
	if not bool(response.get("ok", false)):
		var code := int(response.get("response_code", 0))
		if code == 401 or code == 403:
			return {"ok": false, "status": "login", "message": "Linksolutions pediu login."}
		var message := str(response.get("message", "Consulta indisponivel."))
		var status := "transient" if _linksolutions_message_is_transient(message) else "erro"
		return {"ok": false, "status": status, "message": message}

	var parsed: Variant = JSON.parse_string(str(response.get("body", "")))
	var item := _first_linksolutions_sim_item(parsed)
	if item.is_empty():
		return {"ok": false, "status": "desconhecido", "message": "Chip nao localizado na Linksolutions."}
	return {"ok": true, "parsed": item}


func _first_linksolutions_sim_item(value: Variant) -> Dictionary:
	if typeof(value) == TYPE_ARRAY:
		for row in value as Array:
			var item := _first_linksolutions_sim_item(row)
			if not item.is_empty():
				return item
		return {}
	if typeof(value) != TYPE_DICTIONARY:
		return {}

	var data := value as Dictionary
	for key in ["data", "content", "items", "results", "result", "sim", "sims"]:
		if data.has(key):
			var nested := _first_linksolutions_sim_item(data.get(key))
			if not nested.is_empty():
				return nested

	# Resposta unitária: aceita o item mesmo que a API não use um envelope.
	for key in ["id", "iccid", "msisdn", "status", "status__name", "status_name", "connection_status", "last_conn"]:
		if data.has(key) and _linksolutions_sim_item_has_identity(data):
			return data
	return {}


func _linksolutions_sim_item_has_identity(data: Dictionary) -> bool:
	var iccid := _digits_only(str(data.get("iccid", data.get("ICCID", ""))))
	if iccid.length() >= 15:
		return true
	var phone := _digits_only(_chip_phone_from_data(data))
	return phone.length() >= 10


func _linksolutions_sim_items(value: Variant) -> Array[Dictionary]:
	var items: Array[Dictionary] = []
	_collect_linksolutions_sim_items(value, items)
	return items


func _collect_linksolutions_sim_items(value: Variant, items: Array[Dictionary]) -> void:
	if typeof(value) == TYPE_ARRAY:
		for row in value as Array:
			_collect_linksolutions_sim_items(row, items)
		return
	if typeof(value) != TYPE_DICTIONARY:
		return
	var data := value as Dictionary
	var nested := false
	for key in ["data", "content", "items", "results", "result", "sim", "sims"]:
		if data.has(key):
			nested = true
			_collect_linksolutions_sim_items(data.get(key), items)
	if not nested and _linksolutions_sim_item_has_identity(data):
		items.append(data)


func _linksolutions_sim_matches_query(data: Variant, query: String) -> bool:
	if typeof(data) != TYPE_DICTIONARY:
		return false
	var wanted := _digits_only(query)
	var candidate := _digits_only(str((data as Dictionary).get("iccid", (data as Dictionary).get("ICCID", ""))))
	if candidate == "" or wanted == "":
		return false
	if candidate == wanted:
		return true
	return wanted.length() >= 6 and candidate.ends_with(wanted)


func _scan_linksolutions_sim_by_iccid_suffix(suffix: String) -> Dictionary:
	var wanted := _digits_only(suffix)
	for page in range(1, LINKSOLUTIONS_SIM_SCAN_MAX_PAGES + 1):
		var url := "https://lsm.tnsi.com.br/api/sims?size=%d&page=%d&order=-last_conn" % [LINKSOLUTIONS_SIM_SCAN_PAGE_SIZE, page]
		var response := await _http_get_text_with_headers(url, _linksolutions_request_headers(), LINKSOLUTIONS_HTTP_TIMEOUT_SECONDS)
		if not bool(response.get("ok", false)):
			var code := int(response.get("response_code", 0))
			if code == 401 or code == 403:
				return {"ok": false, "status": "login", "message": "Linksolutions pediu login."}
			var message := str(response.get("message", "Consulta Linksolutions indisponivel."))
			var status := "transient" if _linksolutions_message_is_transient(message) else "erro"
			return {"ok": false, "status": status, "message": message}
		var parsed: Variant = JSON.parse_string(str(response.get("body", "")))
		for item in _linksolutions_sim_items(parsed):
			if _linksolutions_sim_matches_query(item, wanted):
				return {"ok": true, "parsed": item}
	return {"ok": false, "status": "desconhecido", "message": "Chip nao localizado na Linksolutions."}


func _cache_linksolutions_sim_result(query: String, result: Dictionary) -> Dictionary:
	linksolutions_sim_cache[query] = {"checked_at": Time.get_ticks_msec(), "result": result.duplicate(true)}
	return result


func _request_linksolutions_login() -> Dictionary:
	if linksolutions_login_in_flight:
		var deadline := Time.get_ticks_msec() + int(LINKSOLUTIONS_HTTP_TIMEOUT_SECONDS * 1000.0)
		while linksolutions_login_in_flight and Time.get_ticks_msec() < deadline:
			await get_tree().process_frame
		if not linksolutions_login_in_flight and _linksolutions_token() != "":
			return {"ok": true, "shared": true}
		return {"ok": false, "status": "login", "message": "A renovacao da sessao da Linksolutions excedeu o tempo limite."}
	linksolutions_login_in_flight = true
	var result := await _request_linksolutions_login_once()
	linksolutions_login_in_flight = false
	return result


func _request_linksolutions_login_once() -> Dictionary:
	var credentials := _linksolutions_credentials()
	var username := str(credentials.get("username", "")).strip_edges()
	var password := str(credentials.get("password", ""))
	if username == "" or password == "":
		return {"ok": false, "status": "login", "message": "Configure login e senha da Linksolutions."}

	var response := await _http_post_json_with_response_headers(
		LINKSOLUTIONS_AUTH_URL,
		{
			"username": username,
			"password": password,
			"rememberMe": true,
			"blockInit": false,
		},
		PackedStringArray([
			"User-Agent: GrupoRSCentral/1.0",
			"Accept: application/json",
			"Content-Type: application/json",
		]),
		LINKSOLUTIONS_HTTP_TIMEOUT_SECONDS
	)
	if not bool(response.get("ok", false)):
		return {"ok": false, "status": "login", "message": "Login da Linksolutions falhou: %s" % str(response.get("message", ""))}

	var auth_header := _http_header_value(response.get("headers", PackedStringArray()), "Authorization")
	var token := auth_header
	if token.begins_with("Bearer "):
		token = token.substr(7).strip_edges()
	if token == "":
		return {"ok": false, "status": "login", "message": "Linksolutions autenticou, mas nao retornou token."}
	_save_linksolutions_token(token)
	return {"ok": true}


func _linksolutions_credentials() -> Dictionary:
	var env_user := OS.get_environment("LINKSOLUTIONS_EMAIL").strip_edges()
	var env_password := OS.get_environment("LINKSOLUTIONS_PASSWORD")
	if env_user != "" and env_password != "":
		return {"username": env_user, "password": env_password}

	var settings := _read_json_dictionary(SETTINGS_PATH)
	return {
		"username": str(settings.get("linksolutions_email", "")).strip_edges(),
		"password": str(settings.get("linksolutions_password", "")),
	}


func _linksolutions_request_headers() -> PackedStringArray:
	var headers := PackedStringArray([
		"User-Agent: GrupoRSCentral/1.0",
		"Accept: application/json",
	])
	var token := _linksolutions_token()
	if token != "":
		headers.append("Authorization: Bearer %s" % token)
	return headers


func _linksolutions_json_request_headers() -> PackedStringArray:
	var headers := _linksolutions_request_headers()
	headers.append("Content-Type: application/json")
	return headers


func _linksolutions_token() -> String:
	var env_token := OS.get_environment("LINKSOLUTIONS_JWT_TOKEN").strip_edges()
	if env_token != "":
		return env_token
	var settings := _read_json_dictionary(SETTINGS_PATH)
	return str(settings.get("linksolutions_token", "")).strip_edges()


func _save_linksolutions_token(token: String) -> void:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	settings["linksolutions_token"] = token.strip_edges()
	settings["linksolutions_token_saved_at"] = Time.get_datetime_string_from_system(false, true)
	_write_json_dictionary(SETTINGS_PATH, settings)


func _linksolutions_message_is_transient(message: String) -> bool:
	var key := message.strip_edges().to_lower()
	return key.contains("sem conexao") \
		or key.contains("dns") \
		or key.contains("conexao encerrada") \
		or key.contains("nao respondeu") \
		or key.contains("tempo de conexao") \
		or key.contains("falha de transporte") \
		or key.contains("tls")


func _normalize_linksolutions_status(value: Variant) -> String:
	var text_value := str(value).strip_edges().to_lower()
	if ["online", "on", "ativo", "conectado"].has(text_value):
		return "online"
	if ["standby", "off", "offline", "inativo", "desconectado"].has(text_value):
		return "offline"
	if text_value.contains("standby") or text_value.contains("offline") or text_value.contains("descon"):
		return "offline"
	if text_value.contains("online") or text_value.contains("conect") or text_value.contains("connect"):
		return "online"
	return "desconhecido"


func _show_arya_sms_dialog(product: Dictionary) -> void:
	if not _branch_supports_sms():
		_show_warning("SMS", "O envio de SMS esta desativado nas bases regionais.")
		return
	var serial := _digits_only(str(product.get("imei", product.get("sku", ""))))
	if serial == "":
		serial = _digits_only(str(product.get("equipment_number", "")))

	var loading := _show_progress_dialog("SMS Manual Grupo RS", "Pesquisando telefone do aparelho", "Serie %s" % _blank(serial))
	var resolved := await _resolve_grupo_rs_manual_sms_target(product)
	if is_instance_valid(loading):
		loading.queue_free()
	if not bool(resolved.get("ok", false)):
		_show_arya_sms_feedback(
			false,
			"SMS Manual Grupo RS",
			str(resolved.get("message", "Nao foi possivel localizar telefone/APN do aparelho.")),
			[
				"Serie: %s" % _blank(serial),
				"Origem: %s" % _blank(str(resolved.get("origin", ""))),
			]
		)
		return

	var phone := _format_grupo_rs_sms_phone(str(resolved.get("phone", "")))
	var apn := str(resolved.get("apn", "")).strip_edges().to_lower()
	var command := _rs300_apn_command_for_apn(serial, apn)
	if command == "":
		_show_arya_sms_feedback(
			false,
			"APN bloqueada",
			"Este equipamento esta com APN %s. Use somente Hinova ou Link Solutions." % _blank(apn),
			[
				"Serie: %s" % serial,
				"Telefone: %s" % _blank(phone),
				"APN Grupo RS: %s" % _blank(apn),
			]
		)
		return

	loading = _show_progress_dialog("SMS Manual Grupo RS", "Enviando para a fila", "%s | %s" % [phone, apn.to_upper()])
	var result := await _send_grupo_rs_sms_manual_queue(phone, serial, apn, command)
	if is_instance_valid(loading):
		loading.queue_free()

	if bool(result.get("ok", false)):
		_log_system_action(
			"SMS Manual Grupo RS",
			"Telefone: %s | APN: %s | Origem: %s | Comando: %s" % [
				phone,
				apn,
				str(resolved.get("origin", "")),
				command,
			],
			serial
		)
		_show_arya_sms_feedback(
			true,
			"Enviado para fila",
			"O comando foi colocado na fila do SMS Manual do Grupo RS.",
			[
				"Serie: %s" % serial,
				"Telefone: %s" % phone,
				"APN: %s" % apn,
				"Comando: %s" % command,
			]
		)
	else:
		_show_arya_sms_feedback(
			false,
			"Falha na fila",
			str(result.get("message", "O Grupo RS nao confirmou o envio.")),
			[
				"Serie: %s" % serial,
				"Telefone: %s" % phone,
				"APN: %s" % apn,
				"Comando: %s" % command,
			]
		)


func _resolve_grupo_rs_manual_sms_target(product: Dictionary) -> Dictionary:
	var serial := _digits_only(str(product.get("imei", product.get("sku", ""))))
	if serial == "":
		serial = _digits_only(str(product.get("equipment_number", product.get("serial", ""))))
	if not _manual_sms_serial_is_024(serial):
		return {"ok": false, "message": "Comando manual permitido apenas para series 024.", "origin": "cadastro"}
	if not _grupo_rs_supports_modern_api():
		return {"ok": false, "message": "SMS Manual pela fila esta disponivel somente no Grupo RS novo.", "origin": "filial"}

	var local_phone := _format_grupo_rs_sms_phone(str(product.get("phone", product.get("chip_phone", ""))))
	var local_apn := str(product.get("apn", "")).strip_edges().to_lower()
	var chosen: Dictionary = {}
	var rows := await _fetch_grupo_rs_equipment_rows(serial)
	if not rows.is_empty():
		var serial_key := _search_key(serial)
		for row in rows:
			if typeof(row) != TYPE_DICTIONARY:
				continue
			var candidate := row as Dictionary
			if _search_key(str(candidate.get("serial", ""))) == serial_key:
				chosen = candidate
				break
		if chosen.is_empty() and typeof(rows[0]) == TYPE_DICTIONARY:
			chosen = rows[0] as Dictionary

	var phone := local_phone
	var apn := local_apn
	var origin := "cadastro local"
	if not chosen.is_empty():
		origin = "Grupo RS"
		var online_phone := _format_grupo_rs_sms_phone(str(chosen.get("phone", "")))
		if online_phone != "":
			phone = online_phone
		var online_apn := await _fetch_grupo_rs_equipment_apn(chosen)
		if online_apn.strip_edges() != "":
			apn = online_apn.strip_edges().to_lower()

	if phone == "":
		return {"ok": false, "message": "Telefone do aparelho nao localizado no Grupo RS.", "serial": serial, "apn": apn, "origin": origin}
	if not _apn_is_hinova(apn) and not _apn_is_linksolutions(apn):
		return {"ok": false, "message": "APN %s nao permite envio automatico. Use Hinova ou Link Solutions." % _blank(apn), "serial": serial, "phone": phone, "apn": apn, "origin": origin}

	return {
		"ok": true,
		"serial": serial,
		"phone": phone,
		"apn": apn,
		"origin": origin,
		"row": chosen,
	}


func _format_grupo_rs_sms_phone(value: String) -> String:
	var digits := _digits_only(value)
	if digits.begins_with("55") and (digits.length() == 12 or digits.length() == 13):
		digits = digits.substr(2)
	if digits.length() == 11:
		return "(%s) %s-%s" % [digits.substr(0, 2), digits.substr(2, 5), digits.substr(7, 4)]
	if digits.length() == 10:
		return "(%s) %s-%s" % [digits.substr(0, 2), digits.substr(2, 4), digits.substr(6, 4)]
	return ""


