func _remote_queue_enqueue(kind: String, serial: String, plate: String = "", initial_stage: String = "Cadastro do equipamento") -> String:
	remote_queue_sequence += 1
	var id := "remote-%d-%d" % [Time.get_ticks_msec(), remote_queue_sequence]
	var clean_serial := _digits_only(serial)
	var item := {
		"id": id,
		"kind": kind,
		"serial": clean_serial,
		"plate": _format_grupo_rs_vehicle_plate(plate),
		"stage": initial_stage,
		"detail": "Aguardando inicio",
		"state": "queued",
		"source": "API",
		"created_at": Time.get_ticks_msec(),
	}
	remote_queue_items.append(item)
	_remote_queue_show_panel()
	_remote_queue_rebuild_panel()
	return id


func _remote_queue_has_serial(serial: String) -> bool:
	var target := _digits_only(serial)
	if target == "":
		return false
	for item in remote_queue_items:
		var state := str(item.get("state", ""))
		if state in ["queued", "running", "fallback", "pending"] and _digits_only(str(item.get("serial", ""))) == target:
			return true
	return false


func _remote_queue_update(id: String, stage: String, detail: String = "", state: String = "running", source: String = "API") -> void:
	if id.strip_edges() == "":
		return
	for index in range(remote_queue_items.size()):
		if str(remote_queue_items[index].get("id", "")) != id:
			continue
		remote_queue_items[index]["stage"] = stage
		remote_queue_items[index]["detail"] = detail if detail.strip_edges() != "" else stage
		remote_queue_items[index]["state"] = state
		remote_queue_items[index]["source"] = source
		_remote_queue_show_panel()
		_remote_queue_rebuild_panel()
		return


func _remote_queue_finish(id: String, success: bool, detail: String, source: String = "API", state_override: String = "") -> void:
	if id.strip_edges() == "":
		return
	for index in range(remote_queue_items.size()):
		if str(remote_queue_items[index].get("id", "")) != id:
			continue
		var pending := state_override == "pending"
		remote_queue_items[index]["stage"] = "Pendente" if pending else ("Concluido" if success else "Falhou")
		remote_queue_items[index]["detail"] = detail
		remote_queue_items[index]["state"] = state_override if state_override != "" else ("success" if success else "error")
		remote_queue_items[index]["source"] = source
		remote_queue_active_jobs.erase(id)
		_remote_queue_rebuild_panel()
		if _remote_queue_active_count() == 0 and remote_queue_hide_timer != null:
			remote_queue_hide_timer.start()
		return


func _remote_queue_stage(request: Dictionary, stage: String, detail: String = "", state: String = "running", source: String = "API") -> void:
	var queue_id := str(request.get("_remote_queue_id", "")).strip_edges()
	if queue_id != "":
		_remote_queue_update(queue_id, stage, detail, state, source)


func _enqueue_remote_operation(kind: String, local_product: Dictionary, request: Dictionary) -> String:
	var serial := _digits_only(str(request.get("serial", request.get("remote_serial", local_product.get("imei", "")))))
	if serial == "":
		return ""
	if _remote_queue_has_serial(serial):
		_show_warning("Operacao em andamento", "O aparelho %s ja possui uma operacao remota na fila." % serial)
		return ""
	var stage := "Cadastro do equipamento" if kind == "Cadastro" else "Modificando chip e telefone"
	var plate := str(request.get("new_plate", request.get("plate", "")))
	var queue_id := _remote_queue_enqueue(kind, serial, plate, stage)
	var queued_request := request.duplicate(true)
	queued_request["serial"] = serial
	queued_request["_remote_queue_id"] = queue_id
	remote_operation_queue.append({
		"kind": kind,
		"local_product": local_product.duplicate(true),
		"request": queued_request,
		"queue_id": queue_id,
	})
	_drain_remote_operation_queue()
	return queue_id


func _drain_remote_operation_queue() -> void:
	while not remote_operation_queue.is_empty() and remote_queue_active_jobs.size() < REMOTE_OPERATION_MAX_CONCURRENCY:
		var job: Dictionary = remote_operation_queue.pop_front()
		var queue_id := str(job.get("queue_id", ""))
		if queue_id == "":
			continue
		remote_queue_active_jobs[queue_id] = true
		_remote_queue_update(queue_id, "Iniciando", "API oficial", "running", "API")
		call_deferred("_run_remote_operation_job", job)


func _run_remote_operation_job(job: Dictionary) -> void:
	var kind := str(job.get("kind", ""))
	var request: Dictionary = job.get("request", {}) as Dictionary
	var local_product: Dictionary = job.get("local_product", {}) as Dictionary
	var queue_id := str(job.get("queue_id", request.get("_remote_queue_id", "")))
	var serial := _digits_only(str(request.get("serial", request.get("remote_serial", ""))))
	var result: Dictionary
	if kind == "Cadastro":
		_remote_queue_stage(request, "Cadastro do equipamento", "API oficial consultando")
		result = await _perform_equipment_registration(request)
		if bool(result.get("ok", false)):
			var registration_confirmation_pending := bool(result.get("confirmation_pending", false))
			if registration_confirmation_pending and typeof(result.get("request", {})) == TYPE_DICTIONARY:
				request.merge(result.get("request", {}) as Dictionary, true)
			if registration_confirmation_pending:
				_remote_queue_stage(request, "Confirmando cadastro e vinculo", "Aguardando leitura da API", "running", "API")
				result = await _retry_pending_equipment_registration(request, result)
				registration_confirmation_pending = bool(result.get("confirmation_pending", false))
				if typeof(result.get("request", {})) == TYPE_DICTIONARY:
					request.merge(result.get("request", {}) as Dictionary, true)
			if registration_confirmation_pending:
				var pending_message := str(result.get("message", "A API aceitou o cadastro, mas a confirmacao ainda esta pendente."))
				_remote_queue_finish(queue_id, true, pending_message, "API", "pending")
				_log_system_action_event(
					"Confirmacao remota pendente",
					"Cadastro aceito pela API; a fila retomara sem repetir o POST. Serie: %s | %s" % [serial, pending_message],
					serial,
					{
						"status": "pending",
						"phase": "cadastro",
						"operation": "cadastro_e_vinculo",
						"transport": "api",
						"http_code": int(result.get("response_code", result.get("http_code", 0))),
						"retryable": true,
						"correlation_id": "remote-%s" % queue_id,
					}
				)
				_drain_remote_operation_queue()
				return
			_remote_queue_stage(request, "Confirmando cadastro e vinculo", str(request.get("plate", "")))
			var finalized := _finalize_local_equipment_registration(local_product, request)
			if not bool(finalized.get("ok", false)):
				result = {"ok": false, "message": str(finalized.get("message", "Falha ao atualizar o cadastro local."))}
			else:
				result["local"] = finalized
				var firebase_result := await _ensure_firebase_registration_saved(serial, finalized.get("product", {}) as Dictionary)
				if not bool(firebase_result.get("ok", false)):
					result = {"ok": false, "message": str(firebase_result.get("message", "O Firebase nao confirmou a gravacao do cadastro.")), "firebase_pending": true}
				else:
					result["firebase"] = firebase_result
	else:
		_remote_queue_stage(request, "Consultando o aparelho", "API oficial")
		result = await _perform_equipment_modification(request)
		if bool(result.get("ok", false)):
			if bool(result.get("confirmation_pending", false)):
				var pending_message := str(result.get("message", "A API aceitou a modificacao, mas a confirmacao ainda esta pendente."))
				_remote_queue_finish(queue_id, false, pending_message, "API", "pending")
				_log_system_action_event(
					"Operacao remota pendente",
					"Modificacao aceita pela API, aguardando confirmacao. Serie: %s | %s" % [serial, pending_message],
					serial,
					{
						"status": "pending",
						"phase": "modificacao",
						"operation": "modificacao_equipamento",
						"transport": "api",
						"http_code": int(result.get("response_code", result.get("http_code", 0))),
						"retryable": true,
						"correlation_id": "remote-%s" % queue_id,
					}
				)
				_drain_remote_operation_queue()
				return
			_remote_queue_stage(request, "Confirmando modificacao", "API oficial" if not bool(result.get("web", false)) else "Fallback web", "running", "API" if not bool(result.get("web", false)) else "Fallback web")
	if kind == "Modificacao" and store != null:
		var finalized_modification := _finalize_local_equipment_modification(request)
		if not bool(finalized_modification.get("ok", false)):
			result = {"ok": false, "message": str(finalized_modification.get("message", "Falha ao atualizar o cadastro local."))}
		else:
			result["local"] = finalized_modification
			var firebase_result := await _ensure_firebase_modification_saved(serial, finalized_modification.get("product", {}) as Dictionary)
			if not bool(firebase_result.get("ok", false)):
				result = {"ok": false, "message": str(firebase_result.get("message", "O Firebase nao confirmou a gravacao da modificacao.")), "firebase_pending": true}
			else:
				result["firebase"] = firebase_result
	if bool(result.get("confirmation_pending", false)) and not bool(result.get("ok", false)):
		var pending_failure_message := str(result.get("message", "A API aceitou a operacao, mas a confirmacao ainda esta pendente."))
		_remote_queue_finish(queue_id, false, pending_failure_message, "API", "pending")
		_log_system_action_event(
			"Operacao remota pendente",
			"A operacao foi aceita ou pode ter sido aplicada, mas a leitura de confirmacao ainda esta pendente. Serie: %s | %s" % [serial, pending_failure_message],
			serial,
			{
				"status": "pending",
				"phase": "modificacao" if kind != "Cadastro" else "cadastro",
				"operation": "modificacao_equipamento" if kind != "Cadastro" else "cadastro_e_vinculo",
				"transport": "api",
				"http_code": int(result.get("response_code", result.get("http_code", 0))),
				"retryable": true,
				"correlation_id": "remote-%s" % queue_id,
			}
		)
		_drain_remote_operation_queue()
		return
	if bool(result.get("ok", false)):
		var confirmation_pending := bool(result.get("confirmation_pending", false))
		_remote_queue_finish(
			queue_id,
			true,
			"API aceitou; confirmacao completa pendente. Nenhum fallback foi repetido." if confirmation_pending else "Confirmado | %s" % ("cadastro e vinculo" if kind == "Cadastro" else "dados sincronizados"),
			"API",
			"pending" if confirmation_pending else ""
		)
		if confirmation_pending:
			_log_system_action("Confirmacao remota pendente", "A API aceitou a placa, mas a leitura completa ainda esta propagando. Nenhum fallback foi repetido. Serie: %s" % serial, serial)
		else:
			_log_system_action("Operacao remota concluida", "%s | Serie: %s" % [kind, serial], serial)
	else:
		var message := str(result.get("message", "A operacao remota nao foi confirmada."))
		_remote_queue_finish(queue_id, false, message, "Fallback web" if bool(result.get("fallback_web", false)) else "API")
		_log_system_action("Falhou operacao remota", "%s | Serie: %s" % [message, serial], serial)
	if bool(result.get("ok", false)) and not bool(result.get("confirmation_pending", false)) and has_method("_on_remote_operation_localized"):
		call_deferred("_on_remote_operation_localized", kind, serial)
	_drain_remote_operation_queue()


func _remote_queue_active_count() -> int:
	var total := 0
	for item in remote_queue_items:
		if str(item.get("state", "")) in ["queued", "running", "fallback"]:
			total += 1
	return total


func _remote_queue_show_panel() -> void:
	if remote_queue_hide_timer != null:
		remote_queue_hide_timer.stop()
	if remote_queue_panel == null or not is_instance_valid(remote_queue_panel):
		return
	if remote_queue_panel.visible:
		return
	remote_queue_panel.visible = true
	if remote_queue_hide_tween != null and remote_queue_hide_tween.is_valid():
		remote_queue_hide_tween.kill()
	remote_queue_panel.modulate.a = 0.0
	remote_queue_panel.scale = Vector2(0.97, 0.97)
	remote_queue_hide_tween = remote_queue_panel.create_tween()
	remote_queue_hide_tween.set_parallel(true)
	remote_queue_hide_tween.tween_property(remote_queue_panel, "modulate:a", 1.0, MOTION_FAST)
	remote_queue_hide_tween.tween_property(remote_queue_panel, "scale", Vector2.ONE, MOTION_BASE).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


func _hide_remote_queue_panel() -> void:
	if remote_queue_panel == null or not is_instance_valid(remote_queue_panel):
		return
	if _remote_queue_active_count() > 0:
		return
	if remote_queue_hide_tween != null and remote_queue_hide_tween.is_valid():
		remote_queue_hide_tween.kill()
	remote_queue_hide_tween = remote_queue_panel.create_tween()
	remote_queue_hide_tween.tween_property(remote_queue_panel, "modulate:a", 0.0, MOTION_FAST)
	remote_queue_hide_tween.finished.connect(func():
		if is_instance_valid(remote_queue_panel) and _remote_queue_active_count() == 0:
			remote_queue_panel.visible = false
			remote_queue_items.clear()
			_remote_queue_rebuild_panel()
	)


func _remote_queue_rebuild_panel() -> void:
	if remote_queue_body == null or not is_instance_valid(remote_queue_body):
		return
	for child in remote_queue_body.get_children():
		child.queue_free()
	if remote_queue_summary_label != null and is_instance_valid(remote_queue_summary_label):
		var active := _remote_queue_active_count()
		var running := remote_queue_active_jobs.size()
		remote_queue_summary_label.text = "%d operacoes | %d em andamento" % [remote_queue_items.size(), running if running > 0 else active]
	remote_queue_body.visible = not remote_queue_collapsed
	if remote_queue_collapsed:
		return
	var count := 0
	for item in remote_queue_items:
		if count >= REMOTE_QUEUE_MAX_VISIBLE_ROWS:
			break
		remote_queue_body.add_child(_build_remote_queue_row(item))
		count += 1
	if remote_queue_items.size() > REMOTE_QUEUE_MAX_VISIBLE_ROWS:
		var more := Label.new()
		more.text = "+ %d operacao(oes) na fila" % (remote_queue_items.size() - REMOTE_QUEUE_MAX_VISIBLE_ROWS)
		more.add_theme_font_override("font", UI_FONT)
		more.add_theme_font_size_override("font_size", 11)
		more.add_theme_color_override("font_color", MUTED)
		remote_queue_body.add_child(more)


func _build_remote_queue_row(item: Dictionary) -> Control:
	var state := str(item.get("state", "queued"))
	var color := GREEN if state == "success" else RED if state == "error" else ORANGE if state in ["fallback", "pending"] else BLUE
	var row := PanelContainer.new()
	row.custom_minimum_size = Vector2(0, 31)
	row.add_theme_stylebox_override("panel", _style_box(Color("#fbfdff"), Color("#e4edf5"), 1, 5))
	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 7)
	margin.add_theme_constant_override("margin_right", 7)
	margin.add_theme_constant_override("margin_top", 3)
	margin.add_theme_constant_override("margin_bottom", 3)
	row.add_child(margin)
	var line := HBoxContainer.new()
	line.add_theme_constant_override("separation", 7)
	margin.add_child(line)
	var dot := Label.new()
	dot.text = "✓" if state == "success" else "!" if state == "error" else "◔" if state in ["running", "fallback"] else "…" if state == "pending" else "○"
	dot.custom_minimum_size = Vector2(17, 0)
	dot.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	dot.add_theme_font_override("font", UI_FONT)
	dot.add_theme_font_size_override("font_size", 13)
	dot.add_theme_color_override("font_color", color)
	line.add_child(dot)
	var stack := VBoxContainer.new()
	stack.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	stack.add_theme_constant_override("separation", 0)
	line.add_child(stack)
	var serial := Label.new()
	serial.text = str(item.get("serial", ""))
	serial.add_theme_font_override("font", UI_FONT)
	serial.add_theme_font_size_override("font_size", 11)
	serial.add_theme_color_override("font_color", TEXT)
	stack.add_child(serial)
	var stage := Label.new()
	var plate := str(item.get("plate", ""))
	stage.text = str(item.get("stage", "")) + (" | %s" % plate if plate != "" else "")
	stage.clip_text = true
	stage.add_theme_font_override("font", UI_FONT)
	stage.add_theme_font_size_override("font_size", 10)
	stage.add_theme_color_override("font_color", MUTED)
	stack.add_child(stage)
	var source := Label.new()
	source.text = str(item.get("source", "API"))
	source.custom_minimum_size = Vector2(48, 0)
	source.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	source.add_theme_font_override("font", UI_FONT)
	source.add_theme_font_size_override("font_size", 10)
	source.add_theme_color_override("font_color", color)
	line.add_child(source)
	return row


