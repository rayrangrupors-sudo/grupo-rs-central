	form_lookup_status_label.text = message
	form_lookup_status_label.add_theme_color_override("font_color", color)


func _format_plate_input(_new_text: String, input: LineEdit) -> void:
	if input == null:
		return
	if formatting_plate_fields.has(input.get_instance_id()):
		return

	formatting_plate_fields[input.get_instance_id()] = true
	var raw := input.text.to_upper()
	var clean := ""
	for i in range(raw.length()):
		var code := raw.unicode_at(i)
		var char_value := raw.substr(i, 1)
		if (code >= 65 and code <= 90) or (code >= 48 and code <= 57):
			clean += char_value

	var formatted := clean
	if clean.length() > 3:
		formatted = "%s - %s" % [clean.substr(0, 3), clean.substr(3, mini(clean.length() - 3, 8))]
	elif clean.length() == 3 and raw.length() >= 3:
		formatted = "%s - " % clean

	input.text = formatted
	input.caret_column = input.text.length()
	formatting_plate_fields.erase(input.get_instance_id())
	_apply_plate_model_hint(input.text)


func _apply_plate_model_hint(plate: String) -> void:
	var inferred_model := _infer_bulk_model_from_plate(plate)
