			else "Proxima atualizacao %s" % _smart_4g_next_scan_text()
		)


func _smart_4g_next_scan_text() -> String:
	if smart_4g_refreshing:
		return "Varredura em andamento"
	if smart_4g_next_scan_unix <= 0:
		return "Aguardando agendamento"
	var remaining := maxi(smart_4g_next_scan_unix - int(Time.get_unix_time_from_system()), 0)
	return "%02d:%02d" % [remaining / 60, remaining % 60]


func _refresh_dashboard_communication() -> void:
	if dashboard_communication_refreshing or not _grupo_rs_supports_modern_api():
		return
	if not _grupo_rs_platform_reads_enabled():
		dashboard_communication_snapshot = {"disabled": true}
		dashboard_communication_last_error = ""
		_apply_dashboard_communication_snapshot(false)
		return
	dashboard_communication_refreshing = true
	if dashboard_communication_status_label != null and is_instance_valid(dashboard_communication_status_label):
		dashboard_communication_status_label.text = "Atualizando agora..."
		dashboard_communication_status_label.add_theme_color_override("font_color", BLUE)

	var result := await _fetch_dashboard_communication_snapshot()
	if bool(result.get("ok", false)):
		dashboard_communication_snapshot = result
		dashboard_communication_last_error = ""
	else:
		dashboard_communication_last_error = str(result.get("message", "Atualizacao indisponivel.")).strip_edges()
	dashboard_communication_refreshing = false
	_apply_dashboard_communication_snapshot(true)


func _refresh_dashboard_data() -> void:
	## O botao principal precisa testar o Firebase antes de atualizar os paineis.
	## Sem esta chamada, a tela podia continuar mostrando o ultimo estado verde
	## quando a internet caia e nao havia nenhuma alteracao pendente.
	await _refresh_cloud_status()
	if not online_data_available:
		return
	if current_section == "dashboard" and is_instance_valid(content_area):
		# Atualiza somente o conteudo do Dashboard; o shell e os servicos globais
		# continuam vivos durante a consulta.
		_show_dashboard()


func _fetch_dashboard_communication_snapshot() -> Dictionary:
	var counts := {}
	var rows_by_interval := {}
	var errors: Array[String] = []
	var successful_intervals := 0
	var cycle_deadline := Time.get_ticks_msec() + int(DASHBOARD_COMMUNICATION_CYCLE_TIMEOUT_SECONDS * 1000.0)
	for interval_name in DASHBOARD_COMMUNICATION_INTERVALS:
		var clean_interval := str(interval_name)
		if Time.get_ticks_msec() >= cycle_deadline:
			errors.append("%s: limite do ciclo atingido" % clean_interval)
			break
		var response := await _fetch_dashboard_communication_interval(
			clean_interval,
			2,
			DASHBOARD_COMMUNICATION_REQUEST_TIMEOUT_SECONDS,
			cycle_deadline
		)
		if not bool(response.get("ok", false)):
			errors.append("%s: %s" % [clean_interval, str(response.get("message", "falha na consulta"))])
			rows_by_interval[clean_interval] = []
			counts[clean_interval] = 0
			continue
		successful_intervals += 1
		var rows := _parse_dashboard_communication_rows(str(response.get("body", "")), clean_interval)
		counts[clean_interval] = rows.size()
		rows_by_interval[clean_interval] = rows

	if not errors.is_empty() or successful_intervals != DASHBOARD_COMMUNICATION_INTERVALS.size():
		var message := "; ".join(errors)
		if message.is_empty():
			message = "Uma ou mais faixas nao foram confirmadas."
		return {
			"ok": false,
			"complete": false,
			"message": message,
			"errors": errors,
			"successful_intervals": successful_intervals,
		}

	var total := 0
	for interval_name in DASHBOARD_COMMUNICATION_INTERVALS:
		total += int(counts.get(str(interval_name), 0))
	return {
		"ok": true,
		"counts": counts,
		"rows_by_interval": rows_by_interval,
		"total": total,
		"complete": true,
		"partial": false,
		"warning": "; ".join(errors),
		"updated_at": Time.get_datetime_string_from_system(),
		"updated_time": Time.get_time_string_from_system().substr(0, 5),
	}


func _fetch_dashboard_communication_interval(
	interval_name: String,
	max_attempts: int = 2,
	timeout_seconds: float = DASHBOARD_COMMUNICATION_REQUEST_TIMEOUT_SECONDS,
	deadline_msec: int = -1
) -> Dictionary:
	if not _grupo_rs_platform_reads_enabled():
		return {"ok": false, "state": "disabled", "message": "Leitura das faixas do portal esta desligada."}
	var url := _modern_grupo_rs_url("/get_veiculos_intervalo.php?intervalo=%s" % interval_name.uri_encode())
	var last_response: Dictionary = {}
	for attempt in range(maxi(max_attempts, 1)):
		var request_timeout := timeout_seconds
		if deadline_msec > 0:
			var remaining_seconds := float(deadline_msec - Time.get_ticks_msec()) / 1000.0
			if remaining_seconds <= 0.0:
				return {"ok": false, "message": "limite do ciclo atingido"}
			request_timeout = minf(request_timeout, maxf(remaining_seconds, 0.1))
		last_response = await _http_get_text(url, request_timeout)
		if bool(last_response.get("ok", false)):
			return last_response
		if attempt + 1 < maxi(max_attempts, 1):
			var retry_delay := 0.8
			if deadline_msec > 0:
				var retry_remaining := float(deadline_msec - Time.get_ticks_msec()) / 1000.0
				if retry_remaining <= 0.0:
					return {"ok": false, "message": "limite do ciclo atingido"}
				retry_delay = minf(retry_delay, retry_remaining)
			await get_tree().create_timer(retry_delay).timeout
	return last_response


func _parse_dashboard_communication_rows(html: String, interval_name: String) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	var tbody := _regex_first_group(html, "(?is)<tbody[^>]*>(.*?)</tbody>")
	if tbody == "":
		return rows

	var row_regex := RegEx.new()
	if row_regex.compile("(?is)<tr[^>]*>(.*?)</tr>") != OK:
		return rows
	for match_result in row_regex.search_all(tbody):
		var row_html := match_result.get_string(1)
		if row_html.contains("dcm-apn-row"):
			continue
		var cells := _html_table_cells(row_html)
		if cells.size() < 6:
			continue
		var sms_args := _parse_grupo_rs_sms_modal_args(row_html)
		var serial := _digits_only(str(sms_args.get("serial", cells[2])))
		if serial == "":
			serial = _digits_only(str(cells[2]))
		if serial == "":
			continue
		var phone := str(sms_args.get("phone", cells[4])).strip_edges()
		var apn := str(sms_args.get("apn", cells[3])).strip_edges().to_lower()
		if phone == "":
			phone = str(cells[4]).strip_edges()
		if apn == "":
			apn = str(cells[3]).strip_edges().to_lower()
		rows.append({
			"client": str(cells[0]).strip_edges(),
			"plate": str(cells[1]).strip_edges().to_upper(),
			"serial": serial,
			"apn": apn,
			"phone": phone,
			"updated_at": str(cells[5]).strip_edges(),
			"monitor_interval": interval_name,
		})
	return rows


func _apply_dashboard_communication_snapshot(animate: bool = false) -> void:
	if bool(dashboard_communication_snapshot.get("disabled", false)):
		if dashboard_communication_total_label != null and is_instance_valid(dashboard_communication_total_label):
			dashboard_communication_total_label.text = "API sem faixas de comunicacao"
		if dashboard_communication_status_label != null and is_instance_valid(dashboard_communication_status_label):
			dashboard_communication_status_label.text = "Leitura do portal desligada | API fornece placa e localizacao"
			dashboard_communication_status_label.tooltip_text = "O endpoint oficial atual ainda nao substitui as faixas de comunicacao do portal."
			dashboard_communication_status_label.add_theme_color_override("font_color", MUTED)
		return
	var counts: Dictionary = dashboard_communication_snapshot.get("counts", {})
	var total := int(dashboard_communication_snapshot.get("total", 0))
	var chart_max := maxi(total, 1)
	for interval_name in DASHBOARD_COMMUNICATION_INTERVALS:
		var key := str(interval_name)
		var value := int(counts.get(key, 0))
		var progress: Variant = dashboard_communication_bar_nodes.get(key)
		if is_instance_valid(progress) and progress is ProgressBar:
			progress.max_value = chart_max
			if animate:
				progress.create_tween().tween_property(progress, "value", float(value), 0.42).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
			else:
				progress.value = value
		var value_label: Variant = dashboard_communication_value_labels.get(key)
		if is_instance_valid(value_label) and value_label is Label:
			var percentage := (float(value) / float(total)) * 100.0 if total > 0 else 0.0
			value_label.text = "%d  %.1f%%" % [value, percentage]

	if dashboard_communication_total_label != null and is_instance_valid(dashboard_communication_total_label):
		dashboard_communication_total_label.text = "%d veiculos" % total if total > 0 else "Aguardando dados"
	if dashboard_communication_status_label != null and is_instance_valid(dashboard_communication_status_label):
		if bool(dashboard_communication_snapshot.get("partial", false)):
			dashboard_communication_status_label.text = "Leitura parcial as %s | nova tentativa em 1 min" % str(dashboard_communication_snapshot.get("updated_time", "--:--"))
			dashboard_communication_status_label.tooltip_text = str(dashboard_communication_snapshot.get("warning", "Uma ou mais faixas nao responderam."))
			dashboard_communication_status_label.add_theme_color_override("font_color", ORANGE)
		elif not dashboard_communication_last_error.is_empty():
			var last_time := str(dashboard_communication_snapshot.get("updated_time", "--:--"))
			dashboard_communication_status_label.text = "Ultima leitura valida as %s | nova tentativa em 1 min" % last_time if not dashboard_communication_snapshot.is_empty() else "Atualizacao indisponivel"
			dashboard_communication_status_label.tooltip_text = dashboard_communication_last_error
			dashboard_communication_status_label.add_theme_color_override("font_color", RED)
		elif not dashboard_communication_snapshot.is_empty():
			dashboard_communication_status_label.text = "Atualizado as %s | automatico a cada 1 min" % str(dashboard_communication_snapshot.get("updated_time", "--:--"))
			dashboard_communication_status_label.tooltip_text = ""
			dashboard_communication_status_label.add_theme_color_override("font_color", MUTED)
		else:
			dashboard_communication_status_label.text = "Carregando dados do Grupo RS..."
			dashboard_communication_status_label.add_theme_color_override("font_color", BLUE)


func _setup_system_guardian() -> void:
	system_guardian = GuardianScript.new()
	system_guardian.name = "SystemGuardian"
	add_child(system_guardian)
	system_guardian.call(
		"configure",
		selected_branch_id,
		Callable(self, "_guardian_collect_health"),
		Callable(self, "_guardian_apply_safe_fix"),
		Callable(self, "_guardian_audit_event"),
		"",
		GUARDIAN_CHECK_INTERVAL_SECONDS,
		Callable(self, "_guardian_read_online_state"),
		Callable(self, "_guardian_write_online_state")
	)
	system_guardian.connect("snapshot_changed", Callable(self, "_guardian_on_snapshot_changed"))
	system_guardian.call("start", 8.0)
	_guardian_on_snapshot_changed(system_guardian.call("get_snapshot"))


func _guardian_collect_health() -> Dictionary:
	var components: Array[Dictionary] = []
	components.append(_guardian_local_data_component())
	components.append(_guardian_timer_component())
	components.append(_guardian_runtime_lock_component())
	components.append(_guardian_request_queue_component())
	components.append(await _guardian_probe_grupo_rs())
	components.append(await _guardian_probe_arya())
	components.append(await _guardian_probe_linksolutions())
	return {
		"components": components,
		"branch": selected_branch_id,
		"checked_at": Time.get_datetime_string_from_system(false, true),
	}


func _guardian_local_data_component() -> Dictionary:
	if store == null:
		return {
			"id": "firebase_data",
			"label": "Firebase",
			"status": "error",
			"message": "A base online nao foi inicializada.",
		}
	var firebase_sync := _firebase_sync()
	var firebase_status: Dictionary = firebase_sync.call("get_status") if firebase_sync != null else {}
	if not bool(firebase_status.get("data_available", false)):
		return {
			"id": "firebase_data",
			"label": "Firebase",
			"status": "error",
			"message": "Dados bloqueados: servidor online indisponivel.",
		}
	var health := store.get_system_health()
	var diagnostics := store.get_diagnostics()
	var products := int(health.get("products", 0))
	if not diagnostics.is_empty():
		return {
			"id": "firebase_data",
			"label": "Firebase",
			"status": "warning",
			"message": "%d cadastro(s), %d pendencia(s) para revisao humana." % [products, diagnostics.size()],
		}
	return {
		"id": "firebase_data",
		"label": "Firebase",
		"status": "ok",
		"message": "%d cadastro(s) carregado(s) da base online." % products,
	}


func _guardian_read_online_state() -> Dictionary:
	if store == null or not store.is_remote_available():
		return {}
	var value: Variant = store.get_runtime_state("system_guardian_state", {})
	return (value as Dictionary).duplicate(true) if typeof(value) == TYPE_DICTIONARY else {}


func _guardian_write_online_state(value: Dictionary) -> bool:
	return store != null and store.set_runtime_state("system_guardian_state", value)


func _guardian_timer_map() -> Dictionary:
	var timers := {
		"servidor": cloud_sync_timer,
		"sincronizacao": online_plate_sync_timer,
	}
	if _branch_supports_auto_monitor():
		timers["monitor"] = auto_reset_timer
		timers["rechecks"] = auto_reset_recheck_timer
		timers["relogio"] = auto_reset_countdown_timer
	if _branch_supports_monitor_4g():
		timers["monitor_4g"] = smart_4g_timer
	return timers


func _guardian_timer_component() -> Dictionary:
	var stopped: Array[String] = []
	for timer_name in _guardian_timer_map().keys():
		var timer: Variant = _guardian_timer_map().get(timer_name)
		if timer == null or not is_instance_valid(timer) or (timer as Timer).is_stopped():
			stopped.append(str(timer_name))
	if not stopped.is_empty():
		return {
			"id": "routines",
			"label": "Rotinas autonomas",
			"status": "error",
			"message": "Rotinas paradas: %s" % ", ".join(stopped),
			"fix_action": "restart_timers",
			"repair_after": 1,
		}
	return {
		"id": "routines",
		"label": "Rotinas autonomas",
		"status": "ok",
		"message": "%d temporizadores ativos." % _guardian_timer_map().size(),
	}


func _guardian_runtime_lock_component() -> Dictionary:
	var active_operations: Array[String] = []
	if auto_reset_running:
		active_operations.append("monitor automatico")
	if online_plate_sync_running:
		active_operations.append("sincronizacao Grupo RS")
	if not active_operations.is_empty():
		return {
			"id": "runtime_locks",
			"label": "Operacoes locais",
			"status": "warning",
			"message": "Em execucao durante a amostragem: %s." % ", ".join(active_operations),
			"fix_action": "release_transient_locks",
			"repair_after": 2,
		}
	return {
		"id": "runtime_locks",
		"label": "Operacoes locais",
		"status": "ok",
		"message": "Nenhuma trava temporaria pendente.",
	}


func _guardian_request_queue_component() -> Dictionary:
	var pending := arya_status_busy.size() + location_status_busy.size()
	var queued := arya_auto_queue.size() + location_auto_queue.size()
	var running := arya_auto_running + location_auto_running
	if pending > 60 or queued > 30 or _guardian_transient_queries_are_stale():
		return {
			"id": "request_queues",
			"label": "Filas de consulta",
			"status": "warning",
			"message": "%d consulta(s) podem estar travadas; %d em fila, %d executando." % [pending, queued, running],
			"fix_action": "clear_transient_caches",
			"repair_after": 2,
		}
	if pending > 0 or queued > 0 or running > 0:
		return {
			"id": "request_queues",
			"label": "Filas de consulta",
			"status": "ok",
			"message": "%d consulta(s) temporaria(s) em andamento normal." % maxi(pending, queued + running),
		}
	return {
		"id": "request_queues",
		"label": "Filas de consulta",
		"status": "ok",
		"message": "Filas temporarias livres.",
	}


func _guardian_transient_queries_are_stale(max_age_seconds: int = 120) -> bool:
	var now := int(Time.get_unix_time_from_system())
	for serial in arya_status_busy.keys():
		var cached: Dictionary = arya_status_cache.get(serial, {})
		var checked_at := int(cached.get("checked_at", now))
		if now - checked_at > max_age_seconds:
			return true
	for serial in location_status_busy.keys():
		var cached: Dictionary = location_status_cache.get(serial, {})
		var checked_at := int(cached.get("checked_at", now))
		if now - checked_at > max_age_seconds:
			return true
	return false


func _guardian_probe_grupo_rs() -> Dictionary:
	var response: Dictionary = {}
	if _grupo_rs_api_reads_enabled():
		var api_result := await _grupo_rs_api_fetch_vehicles()
		if bool(api_result.get("ok", false)):
			return {
				"id": "grupo_rs",
				"label": "Grupo RS",
				"status": "ok",
				"message": "API oficial conectada em modo somente leitura.",
			}
		if not _grupo_rs_platform_reads_enabled():
			return {
				"id": "grupo_rs",
				"label": "Grupo RS",
				"status": "error",
				"message": str(api_result.get("message", "API oficial indisponivel.")),
				"fix_action": "renew_grupo_rs_session",
				"repair_after": 2,
			}
	if _grupo_rs_platform_reads_enabled() and _grupo_rs_supports_modern_api():
		response = await _http_get_text(_modern_grupo_rs_url("equipamentos_listar.php?busca=__guardian__&status=todos"))
		if bool(response.get("ok", false)) and _modern_grupo_rs_page_is_login(str(response.get("body", ""))):
			response = {"ok": false, "message": "Grupo RS novo pediu login na consulta somente leitura."}
	elif _grupo_rs_platform_reads_enabled():
		response = await _legacy_grupo_rs_get("/Cadastros/EquipamentosListar")
	else:
		return {
			"id": "grupo_rs",
			"label": "Grupo RS",
			"status": "info",
			"message": "Leituras Grupo RS desligadas nas configuracoes.",
		}
	if bool(response.get("ok", false)):
		return {
			"id": "grupo_rs",
			"label": "Grupo RS",
			"status": "ok",
			"message": "Portal conectado em modo somente leitura.",
