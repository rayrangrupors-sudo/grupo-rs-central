func _auto_reset_only_logs(logs: Array[Dictionary]) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for entry in logs:
		if str(entry.get("action", "")).to_lower().begins_with("monitor"):
			result.append(entry)
	return result


func _auto_reset_logs_for_prefix(logs: Array[Dictionary], prefix: String) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for entry in logs:
		if str(entry.get("timestamp", "")).begins_with(prefix):
			result.append(entry)
	return result


func _auto_reset_log_metrics(logs: Array[Dictionary]) -> Dictionary:
	var metrics := {"sms": 0, "recovered": 0, "maintenance": 0, "errors": 0, "cost": 0.0}
	for entry in logs:
		var action := str(entry.get("action", "")).to_lower()
		if action == "monitor enviou sms grupo rs" or action == "monitor enviou reset":
			metrics["sms"] = int(metrics.get("sms", 0)) + 1
		if action.contains("monitor recuperado"):
			metrics["recovered"] = int(metrics.get("recovered", 0)) + 1
		if action.contains("monitor colocou em manutencao"):
			metrics["maintenance"] = int(metrics.get("maintenance", 0)) + 1
		if action.contains("monitor falhou") or action.contains("monitor pausou"):
			metrics["errors"] = int(metrics.get("errors", 0)) + 1
	metrics["cost"] = float(metrics.get("sms", 0)) * AUTO_RESET_SMS_COST_USD
	return metrics


func _auto_reset_combined_cost_metrics(log_metrics: Dictionary, prefix: String) -> Dictionary:
	var provider := _experttexting_usage_for_prefix(prefix)
	var log_count := int(log_metrics.get("sms", 0))
	var provider_count := int(provider.get("count", 0))
	var fallback_count := maxi(log_count - provider_count, 0)
	var total_count := maxi(log_count, provider_count)
	var real_cost := float(provider.get("cost", 0.0))
	var estimated_cost := float(fallback_count) * AUTO_RESET_SMS_COST_USD
	var detail := "estimativa local"
	if provider_count > 0 and fallback_count > 0:
		detail = "custo real + estimativa"
	elif provider_count > 0:
		detail = "custo informado pela API"
	return {
		"count": total_count,
		"cost": real_cost + estimated_cost,
		"provider_count": provider_count,
		"fallback_count": fallback_count,
		"detail": detail,
	}


func _experttexting_provider_label() -> String:
	if _experttexting_is_enabled() and _experttexting_is_configured():
		return "ExpertTexting"
	return "Fila Grupo RS/Arya"


func _experttexting_status_label() -> String:
	if not _experttexting_is_enabled():
		return "API desativada"
	if not _experttexting_is_configured():
		return "Aguardando chaves"
	if experttexting_last_error != "":
		return "Atencao na API"
	if experttexting_last_sync_at > 0:
		return "API conectada"
	return "API configurada"


func _experttexting_last_sync_text() -> String:
	if experttexting_last_sync_at <= 0:
		return "Nunca sincronizado"
	return "Atualizado %s" % _format_datetime(Time.get_datetime_string_from_unix_time(experttexting_last_sync_at, true))


func _experttexting_pending_status_count() -> int:
	var count := 0
	for serial in auto_reset_attempts.keys():
		var attempt: Dictionary = auto_reset_attempts.get(serial, {})
		var message_id := str(attempt.get("message_id", "")).strip_edges()
		var status := str(attempt.get("provider_status", "")).to_upper()
		if message_id != "" and not ["SENT", "DELIVERED", "FAILED", "REJECTED", "EXPIRED", "UNDELIVERED", "REPLIED"].has(status):
			count += 1
	return count


