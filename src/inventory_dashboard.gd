func _apply_system_log_filters() -> void:
	if system_log_date_input != null:
		system_log_selected_date = system_log_date_input.text.strip_edges()
	if system_log_end_date_input != null:
		system_log_end_date = system_log_end_date_input.text.strip_edges()
	if system_log_search_input != null:
		system_log_search_term = system_log_search_input.text.strip_edges()
	if system_log_selected_date == "":
		system_log_selected_date = "%s 00:00" % Time.get_date_string_from_system()
	if system_log_end_date == "":
		system_log_end_date = "%s 23:59" % Time.get_date_string_from_system()
	system_log_current_page = 0
	system_log_selected_id = ""
	_show_system_log()


func _show_system_log_type(filter_key: String) -> void:
	system_log_type_filter = filter_key.strip_edges().to_lower()
	if system_log_type_filter == "":
		system_log_type_filter = "all"
	system_log_current_page = 0
	system_log_selected_id = ""
	_show_system_log()


func _filter_logs_by_date(logs: Array, date_value: String, limit: int) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var clean_date := date_value.strip_edges()
	for entry in logs:
		if typeof(entry) != TYPE_DICTIONARY:
			continue
		var normalized := entry as Dictionary
		if clean_date != "" and not str(normalized.get("timestamp", "")).begins_with(clean_date):
			continue
		result.append(normalized)
		if limit > 0 and result.size() >= limit:
			break
	return result


