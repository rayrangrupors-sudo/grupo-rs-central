	text_value: String,
	icon_kind: String,
	section_key: String,
	callback: Callable,
	child: bool = false,
	group_toggle: bool = false
) -> Button:
	var button := Button.new()
	if group_toggle:
		button.name = "SidebarEquipmentToggle"
	button.text = ""
	button.custom_minimum_size = Vector2(0, 46 if child else 56)
	button.focus_mode = Control.FOCUS_NONE
	if callback.is_valid():
		button.pressed.connect(callback)
	button.set_meta("section_key", section_key)
	button.set_meta("icon_kind", icon_kind)
	button.set_meta("sidebar_child", child)
	button.set_meta("sidebar_group_toggle", group_toggle)
	if group_toggle:
		# A dedicated card keeps the parent visually dark even when Godot places
		# the button in its active/pressed state. The card is non-interactive;
		# the Button remains the hit target for expand/collapse.
		var group_card := Panel.new()
		group_card.name = "SidebarEquipmentGroupCard"
		group_card.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		group_card.mouse_filter = Control.MOUSE_FILTER_IGNORE
		group_card.add_theme_stylebox_override("panel", AppDesignSystem.sidebar_group_button(false, "normal"))
		button.add_child(group_card)

	var margin := MarginContainer.new()
	margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	margin.mouse_filter = Control.MOUSE_FILTER_IGNORE
	margin.add_theme_constant_override("margin_left", 16 if child else 13)
	margin.add_theme_constant_override("margin_right", 11)
	button.add_child(margin)

	var row := HBoxContainer.new()
	row.name = "SidebarRow"
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 11 if child else 14)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	margin.add_child(row)

	var icon := _make_sidebar_icon(icon_kind, AppDesignSystem.NAVY)
	if child:
		icon.custom_minimum_size = Vector2(21, 21)
	icon.name = "SidebarIcon"
	row.add_child(icon)

	var label := Label.new()
	label.name = "SidebarLabel"
	label.text = text_value
	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.add_theme_font_override("font", UI_FONT)
	label.add_theme_font_size_override("font_size", 13 if child else 15)
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_child(label)

	if group_toggle:
		var chevron := Label.new()
		chevron.name = "SidebarChevron"
		chevron.text = "⌃" if sidebar_equipment_expanded else "⌄"
		chevron.custom_minimum_size = Vector2(22, 22)
		chevron.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		chevron.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		chevron.add_theme_font_override("font", UI_FONT)
		chevron.add_theme_font_size_override("font_size", 20)
		chevron.add_theme_color_override("font_color", Color("#c2d5e5"))
		chevron.mouse_filter = Control.MOUSE_FILTER_IGNORE
		row.add_child(chevron)

	sidebar_buttons[section_key] = button
	var active_accent := ColorRect.new()
	active_accent.name = "SidebarActiveAccent"
	active_accent.color = Color("#22b8ff")
	active_accent.custom_minimum_size = Vector2(4, 0)
	active_accent.set_anchors_preset(Control.PRESET_LEFT_WIDE)
	active_accent.set_anchor(SIDE_RIGHT, 0.0)
	active_accent.set_offset(SIDE_LEFT, 0.0)
	active_accent.set_offset(SIDE_RIGHT, 4.0)
	active_accent.set_offset(SIDE_TOP, 8.0)
	active_accent.set_offset(SIDE_BOTTOM, -8.0)
	active_accent.mouse_filter = Control.MOUSE_FILTER_IGNORE
	active_accent.visible = group_toggle and section_key == current_section
	button.add_child(active_accent)
	_apply_sidebar_button_state(button, section_key == current_section)
	return button


func _apply_sidebar_button_state(button: Button, active: bool) -> void:
	var is_group_toggle := button == sidebar_equipment_toggle or bool(button.get_meta("sidebar_group_toggle", false)) or str(button.get_meta("section_key", "")) == "equipment_group"
	if is_group_toggle:
		button.add_theme_stylebox_override("normal", AppDesignSystem.sidebar_group_button(active, "normal"))
		button.add_theme_stylebox_override("hover", AppDesignSystem.sidebar_group_button(active, "hover"))
		button.add_theme_stylebox_override("pressed", AppDesignSystem.sidebar_group_button(active, "pressed"))
		button.add_theme_stylebox_override("focus", AppDesignSystem.sidebar_group_button(active, "hover"))
	else:
		button.add_theme_stylebox_override("normal", AppDesignSystem.sidebar_button(active, "normal"))
		button.add_theme_stylebox_override("hover", AppDesignSystem.sidebar_button(active, "hover"))
		button.add_theme_stylebox_override("pressed", AppDesignSystem.sidebar_button(active, "pressed"))
		button.add_theme_stylebox_override("focus", AppDesignSystem.sidebar_button(active, "hover"))
	var icon := button.find_child("SidebarIcon", true, false) as Control
	if icon != null:
		if icon is TextureRect:
			(icon as TextureRect).modulate = Color.WHITE if active else Color("#c2d5e5")
		else:
			icon.set("icon_color", Color.WHITE if active else Color("#c2d5e5"))
			icon.queue_redraw()
	var label := button.find_child("SidebarLabel", true, false) as Label
	if label != null:
		label.add_theme_color_override("font_color", Color.WHITE if active else Color("#d6e5f0"))
	var accent := button.find_child("SidebarActiveAccent", true, false) as ColorRect
	if accent != null:
		accent.visible = is_group_toggle and active
	var chevron := button.find_child("SidebarChevron", true, false) as Label
	if chevron != null:
		chevron.add_theme_color_override("font_color", Color.WHITE if active else Color("#c2d5e5"))


func _is_sidebar_equipment_section(section: String) -> bool:
	return section in ["inventory", "vehicle_location", "bulk"]


func _toggle_sidebar_equipment_group() -> void:
	_set_sidebar_equipment_expanded(not sidebar_equipment_expanded)


func _set_sidebar_equipment_expanded(expanded: bool) -> void:
	sidebar_equipment_expanded = expanded
	if sidebar_equipment_children != null and is_instance_valid(sidebar_equipment_children):
		sidebar_equipment_children.visible = expanded
	var chevron := sidebar_equipment_toggle.find_child("SidebarChevron", true, false) as Label if sidebar_equipment_toggle != null and is_instance_valid(sidebar_equipment_toggle) else null
	if chevron != null:
		chevron.text = "⌃" if expanded else "⌄"
	if sidebar_equipment_toggle != null and is_instance_valid(sidebar_equipment_toggle):
		sidebar_equipment_toggle.set_meta("expanded", expanded)


func _set_page_context(section: String, title: String, subtitle: String = "") -> void:
	var previous_section := current_section
	if previous_section == "inventory" and section != "inventory":
		_clear_inventory_visible_scope()
	current_section = section
	if is_instance_valid(topbar_title_label):
		topbar_title_label.text = title
	if is_instance_valid(topbar_subtitle_label):
		topbar_subtitle_label.text = subtitle
	for section_key in sidebar_buttons:
		var button: Button = sidebar_buttons[section_key]
		if is_instance_valid(button):
			var active := str(section_key) == section
			if str(section_key) == "equipment_group":
				active = _is_sidebar_equipment_section(section)
			_apply_sidebar_button_state(button, active)
	if _is_sidebar_equipment_section(section) and not sidebar_equipment_expanded:
		_set_sidebar_equipment_expanded(true)
	var event_bus := _app_event_bus()
	if event_bus != null:
		event_bus.call("publish_page", section, title, subtitle)


func _make_sidebar_icon(icon_kind: String, color: Color) -> Control:
	var path := _sidebar_icon_path(icon_kind)
	if path != "":
		var texture_icon := TextureRect.new()
		texture_icon.texture = load(path)
		texture_icon.custom_minimum_size = Vector2(22, 22)
		texture_icon.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		texture_icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		texture_icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		texture_icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		texture_icon.modulate = color
		texture_icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
		return texture_icon
	var drawn_icon := TopbarIcon.new(icon_kind, color)
	drawn_icon.custom_minimum_size = Vector2(22, 22)
	drawn_icon.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	drawn_icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	return drawn_icon


