func _bulk_validation_errors(rows: Array) -> Array[String]:
	var errors: Array[String] = []
	var seen_serials := {}
	var seen_plates := {}
	for row in rows:
		var serial := str(row.get("serial", "")).strip_edges().to_upper()
		var plate := str(row.get("plate", "")).strip_edges().to_upper()
		if serial == "":
			errors.append("Linha sem numero de serie.")
			continue
		if seen_serials.has(serial):
			errors.append("%s: numero duplicado na colagem." % serial)
			continue
		seen_serials[serial] = true
		if plate != "":
			if seen_plates.has(plate):
				errors.append("%s: placa duplicada na colagem." % plate)
				continue
			seen_plates[plate] = true
		if store != null:
			var product := {
				"sku": serial,
				"imei": serial,
				"model": str(row.get("model", "")),
				"operator": _selected_bulk_operator(),
				"plate": plate,
			}
			var duplicate := store.find_duplicate_product(product, serial)
			if not duplicate.is_empty():
				var duplicate_product: Dictionary = duplicate.get("product", {})
				errors.append("%s: %s ja usada por %s." % [
					serial,
					str(duplicate.get("field", "informacao")),
					str(duplicate_product.get("sku", "")),
				])
	return errors


func _parse_bulk_registration_text(raw_text: String) -> Dictionary:
	var rows: Array[Dictionary] = []
	var errors: Array[String] = []
	var normalized_text := raw_text.replace("\r\n", "\n").replace("\r", "\n")
	var line_number := 0

	for raw_line in normalized_text.split("\n"):
		line_number += 1
		var line := str(raw_line).strip_edges()
		if line == "":
			continue

		var pdf_line_row := _extract_bulk_pdf_text_row(line)
		if not pdf_line_row.is_empty():
			rows.append(pdf_line_row)
			continue
		if _is_ignored_bulk_pdf_text_line(line):
			continue

		var cells := _split_bulk_line(line)
		if _is_bulk_header(cells) or _is_bulk_smart_header(cells):
			continue

		var smart_row := _parse_bulk_smart_line(line, cells)
		if smart_row.is_empty():
			errors.append("Linha %d: nao foi possivel identificar placa e serie." % line_number)
			continue
		rows.append(smart_row)

	return {
		"rows": rows,
		"errors": errors,
	}


func _parse_bulk_smart_line(line: String, cells: Array[String]) -> Dictionary:
	var serial := ""
	var plate := ""
	var model := ""
	var operator_name := ""
	for cell in cells:
		var clean := _clean_pasted_cell(cell)
		if serial == "" and _looks_like_bulk_serial(clean):
			serial = _clean_xlsx_serial(clean)
		var normalized_plate := _normalize_bulk_plate(clean)
		if plate == "" and _looks_like_bulk_plate(normalized_plate):
			plate = normalized_plate
		var model_candidate := _normalize_bulk_model(clean)
		if model == "" and _bulk_key(model_candidate) != _bulk_key(clean) and model_candidate != "":
			model = model_candidate
		var operator_candidate := _normalize_bulk_operator(clean)
		if operator_name == "" and ["Tim", "Claro", "Vivo"].has(operator_candidate):
			operator_name = operator_candidate

	if serial == "":
		serial = _extract_bulk_serial_from_text(line)
	if plate == "":
		plate = _extract_bulk_plate_from_text(line)
	if serial == "" or plate == "":
		return {}
	if model == "":
		model = str(_infer_bulk_fields_from_plate(plate).get("model", ""))
	if operator_name == "":
		operator_name = str(_infer_bulk_fields_from_plate(plate).get("operator", "Sem operadora"))
	if model == "":
		model = "Nao informado"
	if operator_name == "":
		operator_name = "Sem operadora"
	return {
		"serial": serial,
		"plate": plate,
		"model": model,
		"operator": operator_name,
	}


func _is_bulk_smart_header(cells: Array[String]) -> bool:
	var has_plate := false
	var has_serial := false
	var has_auxiliary := false
	for cell in cells:
		var key := _bulk_key(_clean_pasted_cell(cell))
		if _is_bulk_plate_header_key(key):
			has_plate = true
		if _is_bulk_serial_header_key(key) or key == "serie":
			has_serial = true
		if key == "id" or key == "codigo" or key == "selecionar" or key == "desativar":
			has_auxiliary = true
	return (has_plate and has_serial) or (has_plate and has_auxiliary)


func _parse_bulk_file(path: String) -> Dictionary:
	var extension := path.get_extension().to_lower()
	if extension == "xlsx":
		return _parse_bulk_xlsx_file(path)
	if extension == "pdf":
		return _parse_bulk_pdf_file(path)
	return {"rows": [], "errors": ["Selecione um arquivo .xlsx ou .pdf."]}


func _parse_bulk_xlsx_file(path: String) -> Dictionary:
	var rows: Array[Dictionary] = []
	var errors: Array[String] = []
	if path.strip_edges() == "":
		return {"rows": rows, "errors": ["Arquivo nao informado."]}
	if path.get_extension().to_lower() != "xlsx":
		return {"rows": rows, "errors": ["Selecione um arquivo .xlsx."]}

	var reader := ZIPReader.new()
	var open_error := reader.open(path)
	if open_error != OK:
		return {"rows": rows, "errors": ["Nao foi possivel abrir o .xlsx."]}

	var shared_strings := _read_xlsx_shared_strings(reader)
	var sheet_paths := _find_xlsx_sheet_paths(reader)
	if sheet_paths.is_empty():
		reader.close()
		return {"rows": rows, "errors": ["Planilha nao encontrada no .xlsx."]}

	var seen_keys := {}
	for sheet_number in range(sheet_paths.size()):
		var sheet_rows := _read_xlsx_sheet_rows(reader, sheet_paths[sheet_number], shared_strings)
		if sheet_rows.is_empty():
			continue

		var header_map := _detect_xlsx_header(sheet_rows)
		var start_index := int(header_map.get("start_index", 0))
		var serial_index := int(header_map.get("serial_index", 0))
		var plate_index := int(header_map.get("plate_index", 1))

		for i in range(start_index, sheet_rows.size()):
			var cells: Array = sheet_rows[i]
			if _xlsx_row_is_empty(cells):
				continue

			var extracted := _extract_xlsx_bulk_row(cells, serial_index, plate_index)
			var serial := str(extracted.get("serial", ""))
			var plate := str(extracted.get("plate", ""))
			if serial == "" and plate == "":
				continue

			var inferred := _infer_bulk_fields_from_plate(plate)
			var model := str(inferred.get("model", ""))
			var operator_name := str(inferred.get("operator", ""))

			if model == "":
				errors.append("Aba %d linha %d: nao foi possivel interpretar o tipo da placa '%s'." % [sheet_number + 1, i + 1, plate])
				continue

			var unique_key := "%s|%s" % [serial.to_upper(), plate.to_upper()]
			if seen_keys.has(unique_key):
				continue
			seen_keys[unique_key] = true

			rows.append({
				"serial": serial,
				"plate": plate,
				"model": model,
				"operator": operator_name,
			})

	reader.close()

	if rows.is_empty() and errors.is_empty():
		errors.append("Nenhuma linha com numero de serie e placa foi encontrada no .xlsx.")

	return {"rows": rows, "errors": errors}


func _parse_bulk_pdf_file(path: String) -> Dictionary:
	var rows: Array[Dictionary] = []
	var errors: Array[String] = []
	if path.strip_edges() == "":
		return {"rows": rows, "errors": ["Arquivo nao informado."]}
	if path.get_extension().to_lower() != "pdf":
		return {"rows": rows, "errors": ["Selecione um arquivo .pdf."]}
	if not FileAccess.file_exists(path):
		return {"rows": rows, "errors": ["Arquivo nao encontrado."]}

	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		return {"rows": rows, "errors": ["Nao foi possivel abrir o PDF."]}

	var bytes := file.get_buffer(file.get_length())
	var text_value := bytes.get_string_from_ascii()
	if not text_value.contains("<td>"):
		text_value = bytes.get_string_from_utf8()
	file.close()

	var html_rows := _extract_bulk_pdf_html_rows(text_value)
	rows.append_array(html_rows)
	if rows.is_empty():
		for raw_line in text_value.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
			var row := _extract_bulk_pdf_text_row(str(raw_line))
			if not row.is_empty():
				rows.append(row)

	if rows.is_empty():
		errors.append("Nao foi possivel encontrar Codigo, Numero Equipamento e Placa neste PDF.")

	return {"rows": rows, "errors": errors}


func _find_xlsx_sheet_paths(reader: ZIPReader) -> Array[String]:
	var result: Array[String] = []
	var files := reader.get_files()
	for file_path in files:
		var text_path := str(file_path)
		if text_path.begins_with("xl/worksheets/") and text_path.ends_with(".xml"):
			result.append(text_path)
	result.sort_custom(func(a: String, b: String) -> bool:
		return _xlsx_sheet_sort_key(a) < _xlsx_sheet_sort_key(b)
	)
	return result


func _xlsx_sheet_sort_key(path: String) -> int:
	var file_name := path.get_file().get_basename()
	var digits := ""
	for i in range(file_name.length()):
		var code := file_name.unicode_at(i)
		if code >= 48 and code <= 57:
			digits += file_name.substr(i, 1)
	return int(digits) if digits != "" else 0


func _read_xlsx_shared_strings(reader: ZIPReader) -> Array[String]:
	var result: Array[String] = []
	if not reader.get_files().has("xl/sharedStrings.xml"):
		return result

	var parser := XMLParser.new()
	var open_error := parser.open_buffer(_zip_text(reader, "xl/sharedStrings.xml").to_utf8_buffer())
	if open_error != OK:
		return result

	var in_string := false
	var in_text := false
	var current := ""
	while parser.read() == OK:
		match parser.get_node_type():
			XMLParser.NODE_ELEMENT:
				var node_name := parser.get_node_name()
				if node_name == "si":
					in_string = true
					current = ""
				elif in_string and node_name == "t":
					in_text = true
			XMLParser.NODE_TEXT:
				if in_text:
					current += parser.get_node_data()
			XMLParser.NODE_ELEMENT_END:
				var end_name := parser.get_node_name()
				if end_name == "t":
					in_text = false
				elif end_name == "si":
					result.append(current)
					in_string = false
	return result


func _read_xlsx_sheet_rows(reader: ZIPReader, sheet_path: String, shared_strings: Array[String]) -> Array:
	var result: Array = []
	var parser := XMLParser.new()
	var open_error := parser.open_buffer(_zip_text(reader, sheet_path).to_utf8_buffer())
	if open_error != OK:
		return result

	var current_row: Array[String] = []
	var in_row := false
	var in_cell := false
	var in_value := false
	var cell_ref := ""
	var cell_type := ""
	var cell_value := ""

	while parser.read() == OK:
		match parser.get_node_type():
			XMLParser.NODE_ELEMENT:
				var node_name := parser.get_node_name()
				if node_name == "row":
					in_row = true
					current_row = []
				elif in_row and node_name == "c":
					in_cell = true
					cell_ref = _xml_attr(parser, "r")
					cell_type = _xml_attr(parser, "t")
					cell_value = ""
				elif in_cell and (node_name == "v" or node_name == "t"):
					in_value = true
			XMLParser.NODE_TEXT:
				if in_value:
					cell_value += parser.get_node_data()
			XMLParser.NODE_ELEMENT_END:
				var end_name := parser.get_node_name()
				if end_name == "v" or end_name == "t":
					in_value = false
				elif end_name == "c":
					var column_index := _xlsx_column_index(cell_ref)
					var resolved_value := _resolve_xlsx_cell_value(cell_value, cell_type, shared_strings)
					while current_row.size() <= column_index:
						current_row.append("")
					current_row[column_index] = resolved_value.strip_edges()
					in_cell = false
				elif end_name == "row":
					if not _xlsx_row_is_empty(current_row):
						result.append(current_row)
					in_row = false
	return result


func _resolve_xlsx_cell_value(raw_value: String, cell_type: String, shared_strings: Array[String]) -> String:
	var value := raw_value.strip_edges()
	if cell_type == "s":
		var index := int(value)
		if index >= 0 and index < shared_strings.size():
			return shared_strings[index]
	return value


func _detect_xlsx_header(sheet_rows: Array) -> Dictionary:
	for row_index in range(mini(sheet_rows.size(), 10)):
		var cells: Array = sheet_rows[row_index]
		var serial_index := -1
		var plate_index := -1
		for col in range(cells.size()):
			var key := _bulk_key(str(cells[col]))
			if _is_bulk_serial_header_key(key):
				serial_index = col
			elif _is_bulk_plate_header_key(key):
				plate_index = col
		if serial_index >= 0 and plate_index >= 0:
			return {"start_index": row_index + 1, "serial_index": serial_index, "plate_index": plate_index}
	return {"start_index": 0, "serial_index": 0, "plate_index": 1}


func _xlsx_cell(cells: Array, index: int) -> String:
	if index < 0 or index >= cells.size():
		return ""
	return str(cells[index]).strip_edges()


func _extract_xlsx_bulk_row(cells: Array, serial_index: int, plate_index: int) -> Dictionary:
	var serial := _clean_xlsx_serial(_xlsx_cell(cells, serial_index))
	var plate := _normalize_bulk_plate(_xlsx_cell(cells, plate_index))
	if _looks_like_bulk_serial(serial) and _looks_like_bulk_plate(plate):
		return {"serial": serial, "plate": plate}

	var row_text := ""
	for cell in cells:
		var clean := str(cell).strip_edges()
		if clean == "":
			continue
		if row_text != "":
			row_text += " "
		row_text += clean

	return {
		"serial": _extract_bulk_serial_from_text(row_text),
		"plate": _extract_bulk_plate_from_text(row_text),
	}


func _xlsx_row_is_empty(cells: Array) -> bool:
	for cell in cells:
		if str(cell).strip_edges() != "":
			return false
	return true


func _xlsx_column_index(cell_ref: String) -> int:
	var index := 0
	for i in range(cell_ref.length()):
		var code := cell_ref.unicode_at(i)
		if code >= 65 and code <= 90:
			index = index * 26 + (code - 64)
		elif code >= 97 and code <= 122:
			index = index * 26 + (code - 96)
		else:
			break
	return maxi(index - 1, 0)


func _xml_attr(parser: XMLParser, attr_name: String) -> String:
	for i in range(parser.get_attribute_count()):
		if parser.get_attribute_name(i) == attr_name:
			return parser.get_attribute_value(i)
	return ""


func _zip_text(reader: ZIPReader, path: String) -> String:
	var bytes := reader.read_file(path)
	return bytes.get_string_from_utf8()


func _bulk_rows_to_text(rows: Array) -> String:
	var lines: Array[String] = []
	for row in rows:
		lines.append("%s\t%s\t%s\t%s" % [
			str(row.get("serial", "")),
			str(row.get("plate", "")),
			str(row.get("model", "")),
			str(row.get("operator", "")),
		])
	return "\n".join(lines)


func _looks_like_bulk_data(raw_text: String) -> bool:
	var parsed := _parse_bulk_registration_text(raw_text)
	var rows: Array = parsed.get("rows", [])
	return not rows.is_empty()


func _selected_bulk_operator() -> String:
	var operator_name := _selected_option_text(bulk_operator_option, false)
	if operator_name == "":
		return "Claro"
	return _normalize_bulk_operator(operator_name)


func _extract_bulk_pdf_html_rows(text_value: String) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	var regex := RegEx.new()
	if regex.compile("<td>\\d+</td>\\s*<td>([^<]+)</td>\\s*<td>(024\\d{6})</td>") != OK:
		return rows

	var seen := {}
	for result in regex.search_all(text_value):
		var plate := _normalize_bulk_plate(_decode_basic_html_entities(result.get_string(1)))
		var serial := _clean_xlsx_serial(result.get_string(2))
		var row := _make_bulk_pdf_row(serial, plate)
		if row.is_empty():
			continue
		var key := "%s|%s" % [serial.to_upper(), plate.to_upper()]
		if seen.has(key):
			continue
		seen[key] = true
		rows.append(row)
	return rows


func _extract_bulk_pdf_text_row(line: String) -> Dictionary:
	var serial := _extract_bulk_serial_from_text(line)
	var plate := _extract_bulk_plate_from_text(line)
	if serial == "" or plate == "":
		return {}
	return _make_bulk_pdf_row(serial, plate)


func _is_ignored_bulk_pdf_text_line(line: String) -> bool:
	var key := _bulk_key(line)
	return key == "listadeclientes" \
		or key.contains("codigonumeroequipamentoplaca") \
		or key.begins_with("pagina") \
		or key == "codigonumeroequipamentoplacadatavinculacao"


func _make_bulk_pdf_row(serial: String, plate: String) -> Dictionary:
	var clean_serial := _clean_xlsx_serial(serial)
	var clean_plate := _normalize_bulk_plate(plate)
	if not _looks_like_bulk_serial(clean_serial) or not _looks_like_bulk_plate(clean_plate):
		return {}

	var inferred := _infer_bulk_fields_from_plate(clean_plate)
	var model := str(inferred.get("model", ""))
	if model == "":
		return {}

	return {
		"serial": clean_serial,
		"plate": clean_plate,
		"model": model,
		"operator": str(inferred.get("operator", "")),
	}


