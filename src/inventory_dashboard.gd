func _rs300_sms_commands(serial: String) -> Dictionary:
	var sms_module := _app_module("sms")
	if sms_module != null:
		return sms_module.call("commands_for", serial)
	return {
		"time": "ST300RPT;%s;02;%s" % [serial, RS300_TIME_PROFILE],
		"apn": "ST300NTW;%s;319H;0;hinova.br;hinova;hinova;grupors1.ddns.net;5940;grupors1.ddns.net;5941;#" % serial,
		"link": "ST300NTW;%s;319H;0;linksolutions.br;link;link;grupors1.ddns.net;5940;grupors1.ddns.net;5941;#" % serial,
	}


func _rs300_apn_command_for_apn(serial: String, apn: String) -> String:
	var sms_module := _app_module("sms")
	if sms_module != null:
		return str(sms_module.call("command_for_apn", serial, apn))
	var commands := _rs300_sms_commands(serial)
	if _apn_is_linksolutions(apn):
		return str(commands.get("link", ""))
	if _apn_is_hinova(apn):
		return str(commands.get("apn", ""))
	return ""


func _request_send_arya_sms(number: String, message: String, serial: String, status_label: Label) -> void:
	var clean_message := message.strip_edges()
	if clean_message == "":
		_show_warning("SMS Arya", "Mensagem vazia.")
		return
	_confirm_action(
		"Enviar SMS",
		"Enviar para %s?\n\n%s" % [number, clean_message],
		func(): _send_arya_sms_confirmed(number, clean_message, serial, status_label)
	)


func _request_send_arya_sms_pair(number: String, commands: Dictionary, serial: String, status_label: Label) -> void:
	_confirm_action(
		"Enviar SMS",
		"Enviar TEMPO primeiro e depois APN para %s?" % number,
		func(): _send_arya_sms_pair_confirmed(number, commands, serial, status_label)
	)


func _send_arya_sms_confirmed(number: String, message: String, serial: String, status_label: Label) -> void:
	await _send_arya_sms_and_update(number, message, serial, status_label)


func _send_arya_sms_pair_confirmed(number: String, commands: Dictionary, serial: String, status_label: Label) -> void:
	var first := await _send_arya_sms_and_update(number, str(commands.get("time", "")), serial, status_label)
	if bool(first.get("ok", false)):
		await _send_arya_sms_and_update(number, str(commands.get("apn", "")), serial, status_label)


func _send_arya_sms_and_update(number: String, message: String, serial: String, status_label: Label) -> Dictionary:
	if status_label:
		status_label.text = "Enviando SMS..."
		status_label.add_theme_color_override("font_color", BLUE_DARK)
	var result := await _send_arya_sms(number, message)
	_sms_panel_record_send(serial, number, result, "Programa", message)
	if bool(result.get("ok", false)):
		if status_label:
			status_label.text = "SMS enviado para %s." % number
			status_label.add_theme_color_override("font_color", GREEN)
		_log_system_action("SMS Arya", "Numero: %s | Mensagem: %s" % [number, message], serial)
	else:
		if status_label:
			status_label.text = "Falha ao enviar SMS: %s" % str(result.get("message", ""))
			status_label.add_theme_color_override("font_color", RED)
	return result


func _send_arya_sms(number: String, message: String) -> Dictionary:
	if _experttexting_is_enabled() and _experttexting_is_configured():
		return await _experttexting_send_sms(number, message)
	var ensure := await _ensure_arya_token(false)
	if not bool(ensure.get("ok", false)) and _arya_token() == "":
		return {"ok": false, "message": str(ensure.get("message", "Credenciais Arya nao configuradas."))}
	var body := {
		"number": number,
		"message": message,
	}
	var response := await _http_post_json_with_headers(ARYA_SMS_SEND_URL, body, _arya_json_request_headers())
	if not bool(response.get("ok", false)) and (str(response.get("message", "")).contains("401") or str(response.get("message", "")).contains("403")):
		var relogin := await _ensure_arya_token(true)
		if bool(relogin.get("ok", false)):
			response = await _http_post_json_with_headers(ARYA_SMS_SEND_URL, body, _arya_json_request_headers())
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": str(response.get("message", "Falha HTTP"))}
	var parsed: Variant = JSON.parse_string(str(response.get("body", "")))
	if typeof(parsed) == TYPE_DICTIONARY:
		var data := parsed as Dictionary
		if data.has("error"):
			return {"ok": false, "message": str(data.get("error", ""))}
		if data.has("status") and not bool(data.get("status", true)):
			return {"ok": false, "message": str(data.get("message", "SMS recusado."))}
	return {"ok": true}


func _format_arya_sms_history(history: Array[Dictionary]) -> String:
	if history.is_empty():
		return "Sem historico retornado pela Arya."
	var lines: Array[String] = []
	for item in history:
		var message := str(item.get("message", item.get("text", item.get("body", "")))).strip_edges()
		var date := str(item.get("created_at", item.get("createdAt", item.get("date", "")))).strip_edges()
		var status := str(item.get("status", item.get("status_code", ""))).strip_edges()
		lines.append("%s  %s\n%s" % [_blank(date), _blank(status), _blank(message)])
	return "\n\n".join(lines)


