func _request_bulk_sms_reset() -> void:
	if not _branch_supports_sms():
		_show_warning("SMS em massa", "O envio de SMS esta desativado nas bases regionais.")
		return
	if bulk_sms_reset_running:
		_show_warning("SMS em massa", "Ja existe um envio em massa rodando.")
		return
	if bulk_text_edit == null or bulk_text_edit.text.strip_edges() == "":
		_show_warning("SMS em massa", "Cole a lista de aparelhos na area de massa.")
		return

	var parsed := _parse_bulk_sms_reset_items(bulk_text_edit.text)
	var items: Array = parsed.get("items", [])
	var ignored := int(parsed.get("ignored", 0))
	var errors: Array = parsed.get("errors", [])
	if items.is_empty():
		var empty_message := "Nenhum aparelho 024 encontrado para reset."
		if ignored > 0:
			empty_message += " Ignorados por nao comecarem com 024: %d." % ignored
		if not errors.is_empty():
			empty_message += "\n" + _join_messages(errors, 5)
		_show_bulk_result(empty_message, false)
		_show_warning("SMS em massa", empty_message)
		return

	var start_text := "Reconheci %d aparelho(s) 024. Vou buscar chip/numero na Arya e enviar 1 SMS a cada 5 segundos. Ignorados nao 024: %d." % [
		items.size(),
		ignored,
	]
	if not errors.is_empty():
		start_text += "\n" + _join_messages(errors, 4)
	_show_bulk_result(start_text, true)
	_send_bulk_sms_reset_confirmed(items, ignored)


func _parse_bulk_sms_reset_items(raw_text: String) -> Dictionary:
	var items: Array[Dictionary] = []
	var seen := {}
	var ignored := 0
	var normalized_text := raw_text.replace("\r\n", "\n").replace("\r", "\n")

	for raw_line in normalized_text.split("\n"):
		var line := str(raw_line).strip_edges()
		if line == "":
			continue
		var cells := _split_bulk_line(line)
		if _is_bulk_header(cells):
			continue

		var serial := _extract_bulk_sms_serial(line, cells)
		if serial == "":
			if _bulk_sms_line_has_serial_but_not_024(line, cells):
				ignored += 1
			continue
		if seen.has(serial):
			continue
		seen[serial] = true

		items.append({
			"serial": serial,
			"plate": _normalize_bulk_plate(_clean_pasted_cell(cells[1])) if cells.size() > 1 else "",
			"number": "",
			"line": line,
		})

	return {
		"items": items,
		"errors": [],
		"ignored": ignored,
	}


func _extract_bulk_sms_serial(line: String, cells: Array[String]) -> String:
	for cell in cells:
		var digits := _digits_only(str(cell))
		if digits.begins_with("024") and digits.length() >= 8 and digits.length() <= 12:
			return digits
	for digits in _extract_digit_runs(line, 8, 12):
		var candidate := str(digits)
		if candidate.begins_with("024"):
			return candidate
	return ""


func _bulk_sms_line_has_serial_but_not_024(line: String, cells: Array[String]) -> bool:
	for cell in cells:
		var digits := _digits_only(str(cell))
		if digits.length() >= 8 and digits.length() <= 12 and not digits.begins_with("024"):
			return true
	for digits in _extract_digit_runs(line, 8, 12):
		var candidate := str(digits)
		if not candidate.begins_with("024"):
			return true
	return false


func _extract_bulk_sms_phone(line: String, cells: Array[String]) -> String:
	for cell in cells:
		var number := _normalize_arya_sms_number(str(cell))
		if number != "":
			return number
	var found := _find_brazil_phone(line)
	return _normalize_arya_sms_number(found)


func _normalize_arya_sms_number(value: String) -> String:
	var digits := _digits_only(value)
	if digits == "":
		return ""
	if digits.begins_with("55") and (digits.length() == 12 or digits.length() == 13):
		return digits
	if digits.length() == 10 or digits.length() == 11:
		return "55%s" % digits
	return ""


func _send_bulk_sms_reset_confirmed(items: Array, ignored: int) -> void:
	if bulk_sms_reset_running:
		return
	bulk_sms_reset_running = true
	var total := items.size()
	var sent := 0
	var failed := 0
	var resolved_numbers := 0
	var command_errors: Array[String] = []

	_show_bulk_result("SMS em massa iniciado: %d aparelho(s), intervalo de 5s." % total, true)

	for index in range(total):
		var item: Dictionary = items[index] as Dictionary
		var serial := str(item.get("serial", "")).strip_edges()
		var number := str(item.get("number", "")).strip_edges()
		if number == "":
			_show_bulk_result("Buscando numero na Arya %d/%d: %s" % [index + 1, total, serial], true)
			var resolved := await _resolve_bulk_sms_reset_number(serial)
			if bool(resolved.get("ok", false)):
				number = str(resolved.get("number", ""))
				resolved_numbers += 1

		if number == "":
			failed += 1
			var fail_message := "%s sem telefone para enviar SMS." % serial
			command_errors.append(fail_message)
			_log_system_action("SMS massa falhou", fail_message, serial)
			_show_bulk_result("SMS em massa %d/%d | enviados: %d | falhas: %d | %s" % [index + 1, total, sent, failed, fail_message], false)
		else:
			var command := str(_rs300_sms_commands(serial).get("apn", ""))
			_show_bulk_result("Enviando %d/%d: %s -> %s" % [index + 1, total, serial, number], true)
			var result := await _send_arya_sms(number, command)
			if bool(result.get("ok", false)):
				sent += 1
				_log_system_action(
					"SMS massa reset",
					"Numero: %s | Comando: %s | Placa: %s" % [number, command, str(item.get("plate", ""))],
					serial
				)
				_show_bulk_result("SMS em massa %d/%d | enviados: %d | falhas: %d | ultimo: %s" % [index + 1, total, sent, failed, serial], true)
			else:
				failed += 1
				var error_text := "%s: %s" % [serial, str(result.get("message", "Falha ao enviar."))]
				command_errors.append(error_text)
				_log_system_action("SMS massa falhou", "Numero: %s | Erro: %s" % [number, str(result.get("message", ""))], serial)
				_show_bulk_result("SMS em massa %d/%d | enviados: %d | falhas: %d | %s" % [index + 1, total, sent, failed, error_text], false)

		if index < total - 1:
			await get_tree().create_timer(BULK_SMS_RESET_INTERVAL_SECONDS).timeout

	bulk_sms_reset_running = false
	var summary := "SMS em massa finalizado. Enviados: %d | Falhas: %d | Ignorados nao 024: %d | Telefones resolvidos: %d" % [
		sent,
		failed,
		ignored,
		resolved_numbers,
	]
	if not command_errors.is_empty():
		summary += "\n" + _join_messages(command_errors, 6)
	_show_bulk_result(summary, failed == 0)
	if failed == 0:
		_show_success("SMS em massa", summary)
	else:
		_show_warning("SMS em massa", summary)


func _resolve_bulk_sms_reset_number(serial: String) -> Dictionary:
	var clean_serial := _digits_only(serial)
	if clean_serial == "":
		return {"ok": false, "message": "Serie vazia."}

	var tried_iccids := {}
	if store != null:
		var product := store.get_product(clean_serial)
		if typeof(product) == TYPE_DICTIONARY and not (product as Dictionary).is_empty():
			var local_iccid := _arya_product_local_iccid(product as Dictionary)
			if local_iccid != "":
				tried_iccids[local_iccid] = true
				var local_result := await _lookup_arya_phone_for_iccid(local_iccid)
				if bool(local_result.get("ok", false)):
					local_result["origin"] = "Arya via cadastro local"
					return local_result

	var rows := await _fetch_grupo_rs_equipment_rows(clean_serial)
	for row_value in rows:
		if typeof(row_value) != TYPE_DICTIONARY:
			continue
		var row := row_value as Dictionary
		var chip := _digits_only(str(row.get("chip", "")))
		if chip != "" and not tried_iccids.has(chip):
			tried_iccids[chip] = true
			var grupo_result := await _lookup_arya_phone_for_iccid(chip)
			if bool(grupo_result.get("ok", false)):
				grupo_result["origin"] = "Arya via Grupo RS"
				return grupo_result

	var resolved := await _resolve_arya_iccid_for_product({"sku": clean_serial, "imei": clean_serial})
	if bool(resolved.get("ok", false)):
		var resolved_iccid := _digits_only(str(resolved.get("iccid", "")))
		if resolved_iccid != "" and not tried_iccids.has(resolved_iccid):
			var resolved_result := await _lookup_arya_phone_for_iccid(resolved_iccid)
			if bool(resolved_result.get("ok", false)):
				resolved_result["origin"] = "Arya"
				return resolved_result

	return {"ok": false, "message": "Telefone nao localizado."}


func _lookup_arya_phone_for_iccid(iccid: String) -> Dictionary:
	var clean_iccid := _digits_only(iccid)
	if clean_iccid == "":
		return {"ok": false, "message": "ICCID vazio."}
	var inventory := await _lookup_arya_inventory_data(clean_iccid)
	if not bool(inventory.get("ok", false)):
		return {"ok": false, "message": str(inventory.get("message", "Arya indisponivel."))}
	var parsed: Dictionary = inventory.get("parsed", {})
	var arya_number := _normalize_arya_sms_number(str(parsed.get("phone", "")))
	if arya_number == "":
		return {"ok": false, "message": "Arya nao retornou telefone para %s." % clean_iccid}
	return {
		"ok": true,
		"number": arya_number,
		"iccid": clean_iccid,
		"status": str(parsed.get("status", "")),
	}


func _register_bulk_items(show_dialog: bool = true) -> void:
	if bulk_text_edit == null:
		return

	var pasted_text := bulk_text_edit.text.strip_edges()
	if pasted_text == "":
		_show_bulk_result("Cole os dados antes de cadastrar.", false)
		if show_dialog:
			_show_warning("Aviso", "Cole os dados antes de cadastrar.")
		return

	var analysis := _analyze_bulk_input(pasted_text)
	var rows: Array = analysis.get("clean_rows", [])
	var errors: Array = analysis.get("errors", [])
	var conflicts: Array = analysis.get("conflicts", [])
	for conflict in conflicts:
		errors.append("%s / %s: %s." % [str(conflict.get("plate", "")), str(conflict.get("serial", "")), str(conflict.get("reason", "Conflito"))])
	var selected_operator := _selected_bulk_operator()
	if not conflicts.is_empty():
		var conflict_message := "Cadastro interrompido: existem conflitos de placa/serie."
		if not errors.is_empty():
			conflict_message += "\n" + _join_messages(errors, 6)
		_render_bulk_preview(rows, errors, [])
		_show_bulk_result(conflict_message, false)
		if show_dialog:
			_show_error("Cadastro em massa", conflict_message)
		return
	if rows.is_empty():
		var no_rows_message := "Nenhuma linha valida encontrada."
		if not errors.is_empty():
			no_rows_message += "\n" + _join_messages(errors, 6)
		_render_bulk_preview([], errors, [])
		_show_bulk_result(no_rows_message, false)
		if show_dialog:
			_show_error("Erro", no_rows_message)
		return

	var created := 0
	var updated := 0
	var skipped := 0
	var save_errors: Array[String] = []
	var seen_serials := {}
	var seen_plates := {}

	for row in rows:
		var serial := str(row.get("serial", "")).strip_edges()
		var plate_key := str(row.get("plate", "")).strip_edges().to_upper()
		if seen_serials.has(serial.to_upper()):
			skipped += 1
			save_errors.append("%s: numero duplicado na importacao." % serial)
			continue
		if plate_key != "" and seen_plates.has(plate_key):
			skipped += 1
			save_errors.append("%s: placa duplicada na importacao." % plate_key)
			continue
		seen_serials[serial.to_upper()] = true
		if plate_key != "":
			seen_plates[plate_key] = true

		var existing := store.get_product(serial)
		var bulk_status := "Estoque" if _is_regional_branch() else "Reserva"
		var product := {
			"sku": serial.to_upper(),
			"imei": serial,
			"equipment_number": "",
			"apn": "",
			"chip_number": "",
			"chip_phone": "",
			"model": str(row.get("model", "")),
			"operator": selected_operator,
			"plate": str(row.get("plate", "")).to_upper(),
			"client": "",
			"tracker_status": bulk_status,
			"status": bulk_status,
			"name": _name_from_bulk_row(row),
			"category": str(row.get("model", "")),
			"location": bulk_status,
			"unit": "un",
			"stock": 1 if _is_regional_branch() else 0,
			"min_stock": 0,
			"cost": 0.0,
			"notes": "Operadora: %s" % selected_operator,
		}

		var duplicate := store.find_duplicate_product(product, serial)
		if not duplicate.is_empty():
			var duplicate_product: Dictionary = duplicate.get("product", {})
			skipped += 1
			save_errors.append("%s: %s ja usada por %s." % [
				serial,
				str(duplicate.get("field", "informacao")),
				str(duplicate_product.get("sku", "")),
			])
			continue

		var saved := store.upsert_product(product)
		if saved.is_empty():
			skipped += 1
			save_errors.append("%s: nao foi possivel salvar." % serial)
			continue

		if existing.is_empty():
			created += 1
			_log_system_action("Cadastro em massa", _log_product_details(saved), serial)
		else:
			updated += 1
			_log_system_action("Atualizacao em massa", _log_product_details(saved), serial)

	var all_errors: Array = []
	all_errors.append_array(errors)
	all_errors.append_array(save_errors)

	var message := "Cadastrados: %d | Atualizados: %d | Ignorados: %d" % [created, updated, skipped]
	if not all_errors.is_empty():
		message += "\n" + _join_messages(all_errors, 6)
		if all_errors.size() > 6:
			message += "\nOutros problemas: %d" % (all_errors.size() - 6)

	_show_bulk_result(message, skipped == 0 and all_errors.is_empty())
	if show_dialog:
		if skipped == 0 and all_errors.is_empty():
			_show_success("Sucesso", message)
		else:
			_show_error("Erro", message)


func _request_delete_legacy_grupo_rs_bulk_items() -> void:
