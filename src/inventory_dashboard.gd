func _play_rs_intro() -> void:
	var layer := CanvasLayer.new()
	layer.layer = 90
	add_child(layer)

	var backdrop := ColorRect.new()
	backdrop.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	backdrop.color = PORTAL_BLUE
	layer.add_child(backdrop)

	var signal_map := RsSignalMap.new()
	signal_map.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	signal_map.modulate.a = 0.70
	layer.add_child(signal_map)

	var center := CenterContainer.new()
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	layer.add_child(center)

	var stack := VBoxContainer.new()
	stack.alignment = BoxContainer.ALIGNMENT_CENTER
	stack.add_theme_constant_override("separation", 17)
	stack.modulate.a = 0.0
	stack.scale = Vector2(0.96, 0.96)
	center.add_child(stack)

	var logo_panel := PanelContainer.new()
	logo_panel.custom_minimum_size = Vector2(184, 184)
	logo_panel.pivot_offset = Vector2(92, 92)
	logo_panel.add_theme_stylebox_override("panel", _style_box(Color.WHITE, Color("#f0f3f6"), 1, 22, true))
	stack.add_child(logo_panel)

	var logo := TextureRect.new()
	logo.texture = LOGO_TEXTURE
	logo.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
	logo.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	logo_panel.add_child(logo)

	var title := Label.new()
	title.text = "GRUPO RS CENTRAL"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_override("font", NAV_FONT)
	title.add_theme_font_size_override("font_size", 38)
	title.add_theme_color_override("font_color", Color.WHITE)
	stack.add_child(title)

	var subtitle := Label.new()
	subtitle.text = "Gestao de rastreadores e bases"
	subtitle.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	subtitle.add_theme_font_override("font", UI_FONT)
	subtitle.add_theme_font_size_override("font_size", 20)
	subtitle.add_theme_color_override("font_color", Color("#dce8f7"))
	stack.add_child(subtitle)

	var line_wrap := CenterContainer.new()
	line_wrap.custom_minimum_size = Vector2(340, 10)
	stack.add_child(line_wrap)

	var accent := ColorRect.new()
	accent.color = ORANGE
	accent.custom_minimum_size = Vector2(0, 5)
	line_wrap.add_child(accent)

	var tween := create_tween()
	tween.set_parallel(true)
	tween.tween_method(Callable(signal_map, "set_progress"), 0.0, 1.0, 2.15).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.tween_property(stack, "modulate:a", 1.0, 0.72).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.tween_property(stack, "scale", Vector2.ONE, 1.05).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.tween_property(accent, "custom_minimum_size:x", 250.0, 1.04).set_delay(0.28).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.set_parallel(false)
	tween.tween_interval(0.95)
	tween.set_parallel(true)
	tween.tween_property(backdrop, "modulate:a", 0.0, 0.72).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(signal_map, "modulate:a", 0.0, 0.64).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(stack, "modulate:a", 0.0, 0.56).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(stack, "scale", Vector2(1.04, 1.04), 0.68).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.set_parallel(false)
	await tween.finished
	if is_instance_valid(layer):
		layer.queue_free()


func _add_signal_background(parent: Node, alpha: float = 0.22) -> RsSignalMap:
	var signal_map := RsSignalMap.new()
	signal_map.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	signal_map.modulate.a = alpha
	signal_map.set_progress(1.0)
	parent.add_child(signal_map)
	return signal_map


func _animate_screen_card(panel: Control, stack: VBoxContainer) -> void:
	panel.modulate.a = 0.0
	panel.scale = Vector2(0.96, 0.96)
	var panel_pivot_size := panel.custom_minimum_size
	if panel_pivot_size.y <= 0.0:
		panel_pivot_size.y = 640.0
	panel.pivot_offset = panel_pivot_size * 0.5

	var panel_tween := panel.create_tween()
	panel_tween.set_parallel(true)
	panel_tween.tween_property(panel, "modulate:a", 1.0, 0.48).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	panel_tween.tween_property(panel, "scale", Vector2.ONE, 0.76).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)

	var index := 0
	for child in stack.get_children():
		if child is Control:
			var control := child as Control
			control.modulate.a = 0.0
			control.scale = Vector2(0.98, 0.98)
			control.pivot_offset = control.custom_minimum_size * 0.5
			var delay := 0.16 + float(index) * 0.075
			var tween := control.create_tween()
			tween.set_parallel(true)
			tween.tween_property(control, "modulate:a", 1.0, 0.42).set_delay(delay).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
			tween.tween_property(control, "scale", Vector2.ONE, 0.58).set_delay(delay).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
			index += 1


