	actions.add_child(_make_action_button("Excluir", RED, RED, Color.WHITE, Vector2(120, 42), func():
		if input.text.strip_edges() != expected_serial:
			error_label.text = "Digite o numero de serie exatamente igual para confirmar."
			return
		layer.queue_free()
		confirmed_callback.call()
	))

	input.grab_focus()


func _equipment_registration_request_from_form() -> Dictionary:
	var imei := _field_text("imei")
	var source := _selected_option_text(form_options.get("apn_source"), true).to_lower()
	var tracker_status := _selected_option_text(form_options.get("tracker_status"), false)
	if tracker_status == "":
		tracker_status = "Estoque"
	var entered_plate := _format_grupo_rs_vehicle_plate(_field_text("plate"))
	# O cadastro novo nao depende de um checkbox visivel: informar uma placa
	# significa pedir a vinculacao; sem placa, o equipamento fica somente no
	# estoque. Na reentrada, preservamos a politica explicita de desassociacao.
	var associate_vehicle := form_associate_vehicle_toggle == null or form_associate_vehicle_toggle.button_pressed
	if form_mode == "new":
		associate_vehicle = entered_plate != ""
	var client_name := _selected_option_text(form_options.get("client"), false)
	if client_name == "":
		client_name = "RS300"
	var vehicle_type := _selected_option_text(form_options.get("vehicle_type"), false)
	if vehicle_type == "":
		vehicle_type = "Carro"
	return {
		"local_sku": imei.to_upper(),
		"serial": _digits_only(imei),
		"plate": entered_plate if associate_vehicle else "",
		"client": client_name if associate_vehicle else "",
		"vehicle_type": vehicle_type if associate_vehicle else "",
		"associate_vehicle": associate_vehicle,
		"vehicle_model": _field_text("vehicle_model") if associate_vehicle else "",
		"vehicle_brand": _field_text("vehicle_brand") if associate_vehicle else "",
		"vehicle_year": _field_text("vehicle_year") if associate_vehicle else "",
		"vehicle_color": _field_text("vehicle_color") if associate_vehicle else "",
		"vehicle_chassis": _field_text("vehicle_chassis") if associate_vehicle else "",
		"vehicle_observation": _field_text("vehicle_observation") if associate_vehicle else "",
		"chip_number": _digits_only(_field_text("chip_number")),
		"phone": _local_registration_phone(_field_text("chip_phone")),
		"apn": source,
		"model": _selected_option_text(form_options.get("model"), true),
		"operator": _selected_option_text(form_options.get("operator"), true),
		"tracker_status": tracker_status,
		"equipment_only": not associate_vehicle,
		"clear_vehicle_fields": false,
	}


func _request_save_form() -> void:
	var imei := (form_fields.get("imei") as LineEdit).text.strip_edges()
	if editing_sku != "" and remote_queue_controller != null and is_instance_valid(remote_queue_controller) \
			and remote_queue_controller.has_serial(_digits_only(imei)):
		_show_warning("Edicao em andamento", "A modificacao deste aparelho esta na fila. Aguarde a confirmacao antes de salvar outra alteracao.")
		return
	if editing_sku != "" and _equipment_api_edit_queue_contains_serial(_digits_only(imei)):
		_show_warning("Edicao em andamento", "Aguarde a confirmacao da API antes de salvar outra alteracao neste aparelho.")
		return
	var model := _selected_option_text(form_options.get("model"), true)
	var operator_name := _selected_option_text(form_options.get("operator"), true)
	if imei == "" or model == "" or operator_name == "":
		_show_warning("Aviso", "Preencha IMEI, tipo/modelo e operadora antes de salvar.")
		return

	var entered_plate := _format_grupo_rs_vehicle_plate(_field_text("plate"))
	var associate_vehicle := form_associate_vehicle_toggle == null or form_associate_vehicle_toggle.button_pressed
	if form_mode == "new":
		# No fluxo novo a placa e a propria intencao de vincular; o operador nao
		# precisa descobrir um checkbox escondido para concluir o cadastro.
		associate_vehicle = entered_plate != ""
	var plate := entered_plate if associate_vehicle else ""
	if editing_sku != "" and _grupo_rs_supports_modern_api():
		var loaded_serial := _search_key(str(form_grupo_rs_data.get("serial", "")))
		var current_remote_plate := _format_grupo_rs_vehicle_plate(str(form_grupo_rs_data.get("plate", "")))
		var requested_plate := _format_grupo_rs_vehicle_plate(plate)
		if loaded_serial == _search_key(imei) and current_remote_plate != "" \
				and requested_plate != "" \
				and _normalize_location_plate(current_remote_plate) != _normalize_location_plate(requested_plate):
			_show_warning(
				"Use Modificar para trocar a placa",
				"A placa remota nao sera alterada pelo botao Salvar. Clique em Modificar para atualizar a placa, o titular e a associacao com confirmacao da API."
			)
			return
	if editing_sku == "" and plate != "":
		var registration_request := _equipment_registration_request_from_form()
		var chip_query := _digits_only(str(registration_request.get("chip_number", "")))
		if chip_query.length() < 6:
			_show_warning("Dados do chip", "Informe o ICCID completo ou pelo menos 6 digitos finais para a busca em segundo plano.")
			return
		_show_equipment_registration_password_dialog(registration_request)
		return
	if editing_sku == "" and (plate == "" or not associate_vehicle) and _grupo_rs_supports_modern_api():
		var api_only_request := _equipment_registration_request_from_form()
		if _digits_only(str(api_only_request.get("chip_number", ""))).length() >= 6:
			api_only_request["equipment_only"] = true
			_show_equipment_registration_password_dialog(api_only_request)
			return

	_confirm_action(
		"Salvar cadastro",
		"Deseja realmente salvar este equipamento?",
		func(): _save_form()
	)


