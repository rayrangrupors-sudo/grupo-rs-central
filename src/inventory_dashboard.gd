func _request_arya_login() -> void:
	if not _require_config_vault_access():
		return
	var email := str(arya_email_input.text if arya_email_input else "").strip_edges()
	var password := str(arya_password_input.text if arya_password_input else "")
	if email == "" or password == "":
		_show_warning("Arya", "Informe login e senha da Arya.")
		return

	_set_arya_config_status("Conectando na Arya...", BLUE_DARK)
	var result := await _login_arya(email, password)
	if not bool(result.get("ok", false)):
		_set_arya_config_status(str(result.get("message", "Login da Arya falhou.")), RED)
		_show_warning("Arya", str(result.get("message", "Login da Arya falhou.")))
		return

	_save_arya_credentials_and_token(email, password, str(result.get("token", "")))
	if arya_password_input:
		arya_password_input.clear()
	arya_status_cache.clear()
	_set_arya_config_status("Conectado. Token salvo e pronto para a coluna Arya.", GREEN)
	_show_success("Arya", "Conexao salva com sucesso.")


func _save_modern_grupo_rs_credentials() -> bool:
	if not _require_config_vault_access():
		return false
	var username := str(grupo_rs_modern_user_input.text if grupo_rs_modern_user_input else "").strip_edges()
	var password := str(grupo_rs_modern_password_input.text if grupo_rs_modern_password_input else "")
	var api_username := str(grupo_rs_api_user_input.text if grupo_rs_api_user_input else "").strip_edges()
	var api_password := str(grupo_rs_api_password_input.text if grupo_rs_api_password_input else "")
	var api_url_input := str(grupo_rs_api_url_input.text if grupo_rs_api_url_input else "").strip_edges()
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var configured_url := str(grupo_rs_modern_url_input.text if grupo_rs_modern_url_input else settings.get("grupo_rs_modern_base_url", GRUPO_RS_BASE_URL)).strip_edges()
	if password == "":
		password = str(settings.get("grupo_rs_modern_password", ""))
	if username == "":
		username = str(settings.get("grupo_rs_modern_user", DEFAULT_GRUPO_RS_MODERN_USER)).strip_edges()
	if password == "":
		password = DEFAULT_GRUPO_RS_MODERN_PASSWORD
	if api_username == "":
		api_username = str(settings.get("grupo_rs_api_user", "")).strip_edges()
	if api_password == "":
		api_password = str(settings.get("grupo_rs_api_password", ""))
	if api_username.begins_with("http://") or api_username.begins_with("https://"):
		if api_url_input == "":
			api_url_input = api_username
		api_username = ""
	var normalized_url := _normalize_modern_grupo_rs_base_url(configured_url)
	if not normalized_url.begins_with("http://") and not normalized_url.begins_with("https://"):
		_set_modern_grupo_rs_config_status("Informe uma URL valida do sistema novo.", YELLOW)
		return false
	if username == "" or password == "":
		_set_modern_grupo_rs_config_status("Informe login e senha do Grupo RS novo.", YELLOW)
		return false
	settings["grupo_rs_modern_base_url"] = normalized_url
	settings["grupo_rs_modern_user"] = username
	settings["grupo_rs_modern_password"] = password
	settings["grupo_rs_api_user"] = api_username
	settings["grupo_rs_api_password"] = api_password
	settings["grupo_rs_api_base_url"] = _normalize_grupo_rs_api_base_url(api_url_input)
	settings["grupo_rs_use_api_reads"] = grupo_rs_api_reads_check == null or grupo_rs_api_reads_check.button_pressed
	settings["grupo_rs_use_platform_reads"] = grupo_rs_platform_reads_check == null or grupo_rs_platform_reads_check.button_pressed
	settings["grupo_rs_modern_saved_at"] = Time.get_datetime_string_from_system(false, true)
	settings["integrations_credentials_saved_at"] = Time.get_datetime_string_from_system(false, true)
	_write_json_dictionary(SETTINGS_PATH, settings)
	if grupo_rs_modern_password_input:
		grupo_rs_modern_password_input.clear()
	if grupo_rs_api_password_input:
		grupo_rs_api_password_input.clear()
	if grupo_rs_modern_url_input:
		grupo_rs_modern_url_input.text = normalized_url
	modern_grupo_rs_cookies.clear()
	modern_grupo_rs_logged_in = false
	grupo_rs_api_logged_in = false
	grupo_rs_api_token = ""
	grupo_rs_api_health_state = "unknown"
	grupo_rs_api_last_health_at = 0
	grupo_rs_api_next_retry_at = 0
	grupo_rs_api_reconnect_attempt = 0
	grupo_rs_api_health_running = false
	grupo_rs_api_location_cache.clear()
	grupo_rs_api_vehicle_cache.clear()
	grupo_rs_api_location_cache_checked_at = 0
	grupo_rs_api_vehicle_cache_checked_at = 0
	location_visible_signature = ""
	location_status_cache.clear()
	location_status_busy.clear()
	location_auto_queue.clear()
	location_auto_running = 0
	_set_modern_grupo_rs_config_status(
		"URL, credenciais e fontes de leitura salvas. API: %s | Plataforma: %s." % [
