	margin.add_theme_constant_override("margin_left", 14)
	margin.add_theme_constant_override("margin_right", 14)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_bottom", 12)
	panel.add_child(margin)
	var card := _sms_panel_chart("Status dos envios", GREEN)
	margin.add_child(card)
	var counts := {"Aceito": 0, "Enviado": 0, "Entregue": 0, "Falho": 0}
	for event in events:
		var status := str(event.get("status", ""))
		if counts.has(status):
			counts[status] = int(counts[status]) + 1
	for status in counts.keys():
		var row := HBoxContainer.new()
		row.add_child(_make_table_label(str(status), 80, false, TEXT, HORIZONTAL_ALIGNMENT_LEFT, 12))
		row.add_child(_make_table_label(str(counts[status]), 50, true, GREEN if status != "Falho" else RED, HORIZONTAL_ALIGNMENT_RIGHT, 13))
		card.add_child(row)
	return panel


func _build_sms_panel_origin_chart(events: Array[Dictionary]) -> Control:
