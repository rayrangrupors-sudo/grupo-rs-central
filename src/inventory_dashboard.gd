func _update_vehicle_reassignment_progress(layer: CanvasLayer, current_step: int) -> void:
	if layer == null or not is_instance_valid(layer):
		return
	for index in range(4):
		var dot := layer.find_child("ProgressStepDot%d" % index, true, false) as Label
		var label := layer.find_child("ProgressStepLabel%d" % index, true, false) as Label
		if dot:
			dot.text = "OK" if index < current_step else ("..." if index == current_step else "-")
			dot.add_theme_color_override("font_color", GREEN if index < current_step else (BLUE if index == current_step else MUTED))
		if label:
			label.add_theme_color_override("font_color", GREEN if index < current_step else (BLUE if index == current_step else MUTED))
		var connector := layer.find_child("ProgressConnector%d" % index, true, false) as ColorRect
		if connector:
			connector.color = GREEN if index < current_step else BORDER


