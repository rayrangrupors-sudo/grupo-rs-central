func legacy_remote_queue_enqueue(kind: String, serial: String, plate: String = "", initial_stage: String = "Cadastro do equipamento") -> String:
	remote_queue_sequence += 1
	var id := "remote-%d-%d" % [Time.get_ticks_msec(), remote_queue_sequence]
	remote_queue_items.append({"id": id, "kind": kind, "serial": _digits_only(serial), "plate": _format_grupo_rs_vehicle_plate(plate), "stage": initial_stage, "detail": "Aguardando inicio", "state": "queued", "source": "API", "created_at": Time.get_ticks_msec()})
	_remote_queue_show_panel()
	_remote_queue_rebuild_panel()
	return id


func legacy_remote_queue_has_serial(serial: String) -> bool:
	var target := _digits_only(serial)
	for item in remote_queue_items:
		if str(item.get("state", "")) in ["queued", "running", "fallback"] and _digits_only(str(item.get("serial", ""))) == target:
			return target != ""
	return false


func legacy_remote_queue_update(id: String, stage: String, detail: String = "", state: String = "running", source: String = "API") -> void:
	for item in remote_queue_items:
		if str(item.get("id", "")) == id:
			item["stage"] = stage
			item["detail"] = detail if detail.strip_edges() != "" else stage
			item["state"] = state
			item["source"] = source
			_remote_queue_show_panel()
			_remote_queue_rebuild_panel()
			return


func legacy_remote_queue_finish(id: String, success: bool, detail: String, source: String = "API") -> void:
	for item in remote_queue_items:
		if str(item.get("id", "")) == id:
			item["stage"] = "Concluido" if success else "Falhou"
			item["detail"] = detail
			item["state"] = "success" if success else "error"
			item["source"] = source
			remote_queue_active_jobs.erase(id)
			_remote_queue_rebuild_panel()
			if _remote_queue_active_count() == 0 and remote_queue_hide_timer != null:
				remote_queue_hide_timer.start()
			return


func legacy_remote_queue_active_count() -> int:
	var count := 0
	for item in remote_queue_items:
		if str(item.get("state", "")) in ["queued", "running", "fallback"]:
			count += 1
	return count


func legacy_remote_queue_show_panel() -> void:
	if remote_queue_hide_timer != null:
		remote_queue_hide_timer.stop()
	if remote_queue_panel == null or not is_instance_valid(remote_queue_panel):
		return
	if remote_queue_panel.visible:
		return
	remote_queue_panel.visible = true
	remote_queue_panel.modulate.a = 0.0
	remote_queue_panel.scale = Vector2(0.97, 0.97)
	remote_queue_hide_tween = remote_queue_panel.create_tween()
	remote_queue_hide_tween.set_parallel(true)
	remote_queue_hide_tween.tween_property(remote_queue_panel, "modulate:a", 1.0, MOTION_FAST)
	remote_queue_hide_tween.tween_property(remote_queue_panel, "scale", Vector2.ONE, MOTION_BASE).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


func legacy_hide_remote_queue_panel() -> void:
	if remote_queue_panel == null or not is_instance_valid(remote_queue_panel) or _remote_queue_active_count() > 0:
		return
	remote_queue_hide_tween = remote_queue_panel.create_tween()
	remote_queue_hide_tween.tween_property(remote_queue_panel, "modulate:a", 0.0, MOTION_FAST)
	remote_queue_hide_tween.finished.connect(func():
		if is_instance_valid(remote_queue_panel) and _remote_queue_active_count() == 0:
			remote_queue_panel.visible = false
			remote_queue_items.clear()
			_remote_queue_rebuild_panel()
	)


func legacy_remote_queue_rebuild_panel() -> void:
	if remote_queue_body == null or not is_instance_valid(remote_queue_body):
		return
	for child in remote_queue_body.get_children():
		child.queue_free()
	if remote_queue_summary_label != null and is_instance_valid(remote_queue_summary_label):
		remote_queue_summary_label.text = "%d operacoes | %d em andamento" % [remote_queue_items.size(), _remote_queue_active_count()]
	remote_queue_body.visible = not remote_queue_collapsed
	if remote_queue_collapsed:
		return
	var shown := 0
	for item in remote_queue_items:
		if shown >= REMOTE_QUEUE_MAX_VISIBLE_ROWS:
			break
		remote_queue_body.add_child(_build_remote_queue_row(item))
		shown += 1
	if remote_queue_items.size() > REMOTE_QUEUE_MAX_VISIBLE_ROWS:
		var more := Label.new()
		more.text = "+ %d operacao(oes) na fila" % (remote_queue_items.size() - REMOTE_QUEUE_MAX_VISIBLE_ROWS)
		more.add_theme_font_override("font", UI_FONT)
		more.add_theme_font_size_override("font_size", 11)
		more.add_theme_color_override("font_color", MUTED)
		remote_queue_body.add_child(more)


