		var edit_href := _decode_basic_html_entities(_regex_first_group(row_html, "(?is)href=[\"']([^\"']*veiculos_editar\\.php\\?id=[^\"']+)[\"']"))
		var inactivate_href := _decode_basic_html_entities(_regex_first_group(row_html, "(?is)href=[\"']([^\"']*veiculos_actions\\.php\\?acao=inativar[^\"']+)[\"']"))
