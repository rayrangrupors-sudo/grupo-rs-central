	strip.alignment = BoxContainer.ALIGNMENT_BEGIN
	_populate_system_log_health_strip(strip, logs)
	return strip


func _refresh_system_log_health_strip(logs: Array[Dictionary]) -> void:
	if not is_instance_valid(system_log_health_strip):
		return
	_populate_system_log_health_strip(system_log_health_strip as HBoxContainer, logs)


func _populate_system_log_health_strip(strip: HBoxContainer, logs: Array[Dictionary]) -> void:
	for child in strip.get_children():
		strip.remove_child(child)
		child.queue_free()
	var metrics := _system_log_extended_metrics(logs)
	_add_system_log_health_item(strip, "API principal", "operante", GREEN)
	_add_system_log_health_item(strip, "Firebase", "sincronizado" if store != null and store.is_remote_available() else "pendente", BLUE)
	_add_system_log_health_item(strip, "Fallback web", str(metrics.get("fallback", 0)), ORANGE)
	_add_system_log_health_item(strip, "HTTP 5xx", str(metrics.get("http_5xx", 0)), RED if int(metrics.get("http_5xx", 0)) > 0 else GREEN)
	var pending := int(store.get_pending_sync_status().get("count", 0)) if store != null else 0
	_add_system_log_health_item(strip, "Fila", str(pending), ORANGE if pending > 0 else GREEN)
	var live := Label.new()
	live.text = "● tempo real"
	live.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	live.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	live.add_theme_font_override("font", UI_FONT)
	live.add_theme_font_size_override("font_size", 10)
	live.add_theme_color_override("font_color", GREEN)
	strip.add_child(live)


func _add_system_log_health_item(strip: HBoxContainer, label_text: String, value_text: String, color: Color) -> void:
	var item := Label.new()
	item.text = "● %s  %s" % [label_text, value_text]
	item.add_theme_font_override("font", UI_FONT)
	item.add_theme_font_size_override("font_size", 10)
	item.add_theme_color_override("font_color", color)
	strip.add_child(item)


func _system_log_percent_text(value: int, total: int) -> String:
	if total <= 0:
		return "0% do total"
	return "%.1f%% do total" % (float(value) * 100.0 / float(total))


func _refresh_system_log_event_list(logs: Array[Dictionary], page_logs: Array[Dictionary], page_data: Dictionary) -> void:
	var previous_scroll := 0
	if is_instance_valid(system_log_event_scroll):
		previous_scroll = system_log_event_scroll.scroll_vertical
	if is_instance_valid(system_log_event_title):
		system_log_event_title.text = "Eventos (%d)" % logs.size()
	if is_instance_valid(system_log_event_body):
		for child in system_log_event_body.get_children():
			system_log_event_body.remove_child(child)
			child.queue_free()
		system_log_event_rows.clear()
		if page_logs.is_empty():
			system_log_event_body.add_child(_make_empty_log_card("Nenhum evento encontrado para os filtros informados."))
		else:
			for log_entry in page_logs:
				system_log_event_body.add_child(_make_system_log_event_row(log_entry))
	if is_instance_valid(system_log_pager):
		var parent := system_log_pager.get_parent()
		if parent != null:
			var index := system_log_pager.get_index()
			parent.remove_child(system_log_pager)
			system_log_pager.queue_free()
			var replacement := _build_system_log_pager(int(page_data.get("total", 0)), int(page_data.get("page_count", 1)), int(page_data.get("start", 0)), int(page_data.get("end", 0)))
			parent.add_child(replacement)
			parent.move_child(replacement, index)
			system_log_pager = replacement
	if is_instance_valid(system_log_event_scroll):
		# Keep the list visually stable during a refresh. Filter and page actions
		# still start at the top because their handlers reset the current page.
		system_log_event_scroll.set_deferred("scroll_vertical", previous_scroll)


