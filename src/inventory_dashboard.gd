func _make_action_button(text_value: String, fill: Color, border: Color, font_color: Color, min_size: Vector2, callback: Callable) -> Button:
	var button := Button.new()
	button.text = text_value
	button.custom_minimum_size = min_size
	if callback.is_valid():
		button.pressed.connect(callback)
	var palette := _button_palette(fill, border, font_color)
	var normal_fill: Color = palette.get("fill", fill)
	var normal_border: Color = palette.get("border", border)
	var normal_font: Color = palette.get("font", font_color)
	var icon_path := _action_icon_path(text_value)
	if icon_path != "":
		button.icon = load(icon_path)
		# Keep the source SVG crisp without letting its intrinsic size expand the button.
		button.expand_icon = false
		button.add_theme_constant_override("icon_max_width", 22)
		button.icon_alignment = HORIZONTAL_ALIGNMENT_LEFT
		button.add_theme_constant_override("h_separation", 7)
	button.add_theme_font_override("font", UI_FONT)
	button.add_theme_font_size_override("font_size", 16 if min_size.y <= 40 else 18)
	button.add_theme_color_override("font_color", normal_font)
	button.add_theme_color_override("font_hover_color", normal_font)
	button.add_theme_color_override("font_pressed_color", normal_font)
	button.add_theme_color_override("font_focus_color", normal_font)
	button.add_theme_color_override("icon_normal_color", normal_font)
	button.add_theme_color_override("icon_hover_color", normal_font)
	button.add_theme_color_override("icon_pressed_color", normal_font)
	button.add_theme_color_override("icon_focus_color", normal_font)
	button.add_theme_stylebox_override("normal", _style_box(normal_fill, normal_border, 1, 8))
	button.add_theme_stylebox_override("hover", _style_box(_button_hover_fill(normal_fill), normal_border, 1, 8))
	button.add_theme_stylebox_override("pressed", _style_box(_button_pressed_fill(normal_fill), normal_border.darkened(0.08), 1, 8))
	button.add_theme_stylebox_override("focus", _style_box(_button_hover_fill(normal_fill), BLUE, 1, 8))
	return button


func _make_icon_action_button(icon_path: String, fill: Color, border: Color, min_size: Vector2, callback: Callable) -> Button:
