func _system_log_page_data(logs: Array[Dictionary], requested_page: int, page_size: int = SYSTEM_LOG_PAGE_SIZE) -> Dictionary:
	var safe_page_size := maxi(page_size, 1)
	var total := logs.size()
	var page_count := maxi(1, ceili(float(total) / float(safe_page_size)))
	var page := clampi(requested_page, 0, page_count - 1)
	var start_index := page * safe_page_size
	var end_index := mini(start_index + safe_page_size, total)
	var entries: Array[Dictionary] = []
	for index in range(start_index, end_index):
		entries.append(logs[index])
	return {
		"entries": entries,
		"page": page,
		"page_count": page_count,
		"total": total,
		"start": start_index,
		"end": end_index,
	}


func _build_system_log_pager(total: int, page_count: int, start_index: int, end_index: int) -> HBoxContainer:
	var pager := HBoxContainer.new()
	pager.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	pager.alignment = BoxContainer.ALIGNMENT_CENTER
	pager.add_theme_constant_override("separation", 6)

	var info := Label.new()
	info.custom_minimum_size = Vector2(310, 42)
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	info.add_theme_font_override("font", UI_FONT)
	info.add_theme_font_size_override("font_size", 15)
	info.add_theme_color_override("font_color", MUTED)
	info.text = "Nenhum registro" if total <= 0 else "Mostrando %d-%d de %d registros" % [start_index + 1, end_index, total]
	pager.add_child(info)

	if page_count <= 1:
		return pager

	pager.add_child(_make_page_button("<", system_log_current_page > 0, Callable(self, "_change_system_log_page").bind(-1), false))
	for page_index in _visible_page_indexes_for(page_count, system_log_current_page):
		if page_index < 0:
			pager.add_child(_make_page_gap())
			continue
		pager.add_child(_make_page_button(
			str(page_index + 1),
			page_index != system_log_current_page,
			Callable(self, "_set_system_log_page").bind(page_index),
			page_index == system_log_current_page
		))
	pager.add_child(_make_page_button("Proximo", system_log_current_page < page_count - 1, Callable(self, "_change_system_log_page").bind(1), false))
	return pager


func _set_system_log_page(page_index: int) -> void:
	system_log_current_page = maxi(page_index, 0)
	_show_system_log()


func _change_system_log_page(delta: int) -> void:
	_set_system_log_page(system_log_current_page + delta)


