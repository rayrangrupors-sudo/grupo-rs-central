func _fill_form(product: Dictionary) -> void:
	if product.is_empty():
		return

	form_grupo_rs_data.clear()
	(form_fields.get("imei") as LineEdit).text = str(product.get("imei", product.get("sku", "")))
	(form_fields.get("plate") as LineEdit).text = str(product.get("plate", ""))
	if form_fields.has("chip_number"):
		(form_fields.get("chip_number") as LineEdit).text = str(product.get("chip_number", ""))
	if form_fields.has("chip_phone"):
		(form_fields.get("chip_phone") as LineEdit).text = _local_registration_phone(str(product.get("chip_phone", "")))
	_set_option_value(form_options.get("model"), str(product.get("model", product.get("category", ""))))
	_set_option_value(form_options.get("operator"), str(product.get("operator", "")))
	_set_option_value(form_options.get("tracker_status"), str(product.get("tracker_status", "Estoque")))
	_set_option_value(form_options.get("client"), str(product.get("client", "RS300")) if str(product.get("client", "")).strip_edges() != "" else "RS300")
	_set_option_value(form_options.get("vehicle_type"), str(product.get("vehicle_type", "Carro")) if str(product.get("vehicle_type", "")).strip_edges() != "" else "Carro")
	var apn := str(product.get("apn", "")).strip_edges().to_lower()
	if apn in ["hinova.br", "linksolutions.br"]:
		_set_option_value(form_options.get("apn_source"), apn)
	for key in ["vehicle_model", "vehicle_brand", "vehicle_year", "vehicle_color", "vehicle_chassis", "vehicle_observation"]:
		if form_fields.get(key) is LineEdit:
			(form_fields.get(key) as LineEdit).text = str(product.get(key, ""))
	if form_associate_vehicle_toggle != null and is_instance_valid(form_associate_vehicle_toggle):
		form_associate_vehicle_toggle.button_pressed = str(product.get("plate", "")).strip_edges() != ""


func _schedule_registration_background_probe() -> void:
	if registration_probe_applying:
		return
	var serial := _digits_only(_field_text("imei"))
	var chip := _digits_only(_field_text("chip_number"))
	if serial == "" and chip == "":
		registration_probe_result.clear()
		registration_probe_running = false
		return
	registration_probe_generation += 1
	var generation := registration_probe_generation
	registration_probe_active_generation = generation
	registration_probe_serial = serial
	registration_probe_running = true
	registration_probe_result = {
		"state": "consultando",
		"serial": serial,
		"chip_query": chip,
	}
	if form_lookup_status_label != null and is_instance_valid(form_lookup_status_label):
		_set_form_lookup_status("Consultando equipamento e chip em segundo plano...", BLUE)
	call_deferred("_run_registration_background_probe", serial, chip, generation)


func _on_form_imei_changed(_text: String) -> void:
	_schedule_registration_background_probe()
	_schedule_form_auto_lookup()


func _on_form_chip_changed(_text: String) -> void:
	_schedule_registration_background_probe()


func _schedule_form_auto_lookup() -> void:
	form_auto_lookup_generation += 1
	var generation := form_auto_lookup_generation
	var serial := _digits_only(_field_text("imei"))
	# IMEIs usados pela plataforma possuem pelo menos oito digitos. O debounce
	# evita uma requisicao por tecla enquanto o operador ainda esta digitando.
	if serial.length() < 8:
		return
	call_deferred("_run_form_auto_lookup", serial, generation)


func _run_form_auto_lookup(serial: String, generation: int) -> void:
	await get_tree().create_timer(0.65).timeout
	if generation != form_auto_lookup_generation:
		return
	if _digits_only(_field_text("imei")) != serial:
		return
	await _lookup_form_grupo_rs_data()


func _run_registration_background_probe(serial: String, chip: String, generation: int) -> void:
	# O debounce evita uma requisicao por tecla, mas nao prende o formulario.
	await get_tree().create_timer(0.35).timeout
	if generation != registration_probe_active_generation:
		return
	var current_serial := _digits_only(_field_text("imei"))
	var current_chip := _digits_only(_field_text("chip_number"))
	if current_serial != serial or current_chip != chip:
		return
	var probe_state := {
		"equipment_done": serial == "",
		"chip_done": chip == "",
		"equipment": {"state": "not_requested"},
		"chip": {"ok": false, "state": "not_requested"},
	}
	if serial != "":
		call("_registration_probe_equipment_guarded", serial, probe_state)
	if chip != "":
		call("_registration_probe_chip_guarded", chip, probe_state)
	var probe_deadline := Time.get_ticks_msec() + 12000
	while (not bool(probe_state.get("equipment_done", false)) or not bool(probe_state.get("chip_done", false))) and Time.get_ticks_msec() < probe_deadline:
		await get_tree().process_frame
	var existence: Dictionary = probe_state.get("equipment", {}) as Dictionary
	var chip_result: Dictionary = probe_state.get("chip", {}) as Dictionary
	if generation != registration_probe_active_generation:
		return
	registration_probe_result = {
		"state": "concluido",
		"serial": serial,
		"chip_query": chip,
		"equipment": existence.duplicate(true),
		"chip": chip_result.duplicate(true),
	}
	registration_probe_running = false
	_apply_registration_probe_to_form(registration_probe_result)


func _registration_probe_equipment_guarded(serial: String, state: Dictionary) -> void:
	state["equipment"] = await _grupo_rs_api_find_equipment(serial, true)
	state["equipment_done"] = true


func _registration_probe_chip_guarded(chip: String, state: Dictionary) -> void:
	state["chip"] = await _lookup_registration_chip_parallel(chip)
	state["chip_done"] = true


func _registration_chip_candidate_identity(parsed: Dictionary) -> Dictionary:
	return {
		"iccid": _digits_only(str(parsed.get("iccid", parsed.get("ICCID", "")))),
		"phone": _local_registration_phone(_chip_phone_from_data(parsed)),
		"operator": _smart_registration_operator_label(_registration_operator_from_chip_data(parsed)),
	}


func _lookup_registration_chip_parallel(query: String) -> Dictionary:
	var clean_query := _digits_only(query)
	if clean_query.length() < 6:
		return {"ok": false, "state": "invalid", "message": "Informe ao menos 6 digitos do ICCID."}
	# A Arya precisa de um prefixo para a rota direta; a Link Solutions aceita
	# o sufixo. As duas tarefas sao iniciadas antes do primeiro await.
	var arya_query := clean_query if clean_query.length() >= 18 else "895554830000%s" % clean_query
	var source_state := {
		"hinova_done": false,
		"link_done": false,
		"hinova": {},
		"link": {},
	}
	call("_registration_chip_source_guarded", "hinova", arya_query, source_state)
	call("_registration_chip_source_guarded", "link", clean_query, source_state)
	var deadline := Time.get_ticks_msec() + int(REGISTRATION_CHIP_LOOKUP_DEADLINE_SECONDS * 1000.0)
	while (not bool(source_state.get("hinova_done", false)) or not bool(source_state.get("link_done", false))) and Time.get_ticks_msec() < deadline:
		await get_tree().process_frame
	var arya: Dictionary = source_state.get("hinova", {}) as Dictionary
	var link: Dictionary = source_state.get("link", {}) as Dictionary
	var candidates: Array[Dictionary] = []
	if bool(arya.get("ok", false)) and typeof(arya.get("parsed", {})) == TYPE_DICTIONARY:
		var arya_parsed: Dictionary = arya.get("parsed", {}) as Dictionary
		if not arya_parsed.is_empty():
			candidates.append({"source": "hinova.br", "parsed": arya_parsed})
	if bool(link.get("ok", false)) and typeof(link.get("parsed", {})) == TYPE_DICTIONARY:
		var link_parsed: Dictionary = link.get("parsed", {}) as Dictionary
		if not link_parsed.is_empty():
			candidates.append({"source": "linksolutions.br", "parsed": link_parsed})
	if candidates.is_empty():
		var messages: Array[String] = []
		for result in [arya, link]:
			var message := str(result.get("message", "")).strip_edges()
			if message != "" and not messages.has(message):
				messages.append(message)
		return {
			"ok": false,
			"state": "not_found" if not messages.is_empty() else "unavailable",
			"message": "Chip nao localizado nas APNs consultadas." if messages.is_empty() else " | ".join(messages),
		}
	# Quando a consulta e completa, uma resposta com outro ICCID e descartada.
	# Para consultas curtas, aceitamos o sufixo somente quando houver uma unica
	# identidade coerente entre as fontes.
	var filtered_candidates: Array[Dictionary] = []
	for candidate in candidates:
		var candidate_identity := _registration_chip_candidate_identity(candidate.get("parsed", {}) as Dictionary)
		var candidate_iccid := str(candidate_identity.get("iccid", ""))
		if clean_query.length() >= 18 and candidate_iccid != "" and candidate_iccid != clean_query:
			continue
		filtered_candidates.append(candidate)
	if filtered_candidates.is_empty():
		return {"ok": false, "state": "conflict", "message": "As fontes retornaram um ICCID diferente do chip informado."}

	var identities: Array[Dictionary] = []
	for candidate in filtered_candidates:
		identities.append(_registration_chip_candidate_identity(candidate.get("parsed", {}) as Dictionary))
	var base_identity: Dictionary = identities[0]
	for identity in identities:
		for key in ["iccid", "phone", "operator"]:
			var base_value := str(base_identity.get(key, "")).strip_edges()
			var current_value := str(identity.get(key, "")).strip_edges()
			if base_value != "" and current_value != "" and base_value != current_value:
				return {
					"ok": false,
					"state": "conflict",
					"message": "As consultas Hinova e Link Solutions retornaram dados divergentes para o mesmo chip.",
				}

	# Se as duas fontes responderem, prefira a que contenha o ICCID exato;
	# nunca escolha uma operadora diferente por fallback silencioso.
	var chosen: Dictionary = filtered_candidates[0]
	for candidate in filtered_candidates:
		var parsed: Dictionary = candidate.get("parsed", {}) as Dictionary
		if _digits_only(str(parsed.get("iccid", ""))) == clean_query:
			chosen = candidate
			break
	var parsed_chosen: Dictionary = chosen.get("parsed", {}) as Dictionary
	var resolved_iccid := _digits_only(str(parsed_chosen.get("iccid", "")))
	var phone := _local_registration_phone(_chip_phone_from_data(parsed_chosen))
	var operator := _registration_operator_from_chip_data(parsed_chosen)
	return {
		"ok": true,
		"state": "found",
		"source": str(chosen.get("source", "")),
		"parsed": parsed_chosen,
		"iccid": resolved_iccid,
		"phone": phone,
		"apn": str(chosen.get("source", "")).strip_edges().to_lower(),
		"operator": operator,
	}


func _registration_chip_source_guarded(source: String, query: String, state: Dictionary) -> void:
	var result: Dictionary
	if source == "hinova":
		result = await _lookup_arya_inventory_data(query)
	else:
		result = await _lookup_linksolutions_sim_data(query, false)
	state[source] = result
	state["%s_done" % source] = true


func _apply_registration_probe_to_form(probe: Dictionary) -> void:
	registration_probe_applying = true
	var chip_result: Dictionary = probe.get("chip", {}) as Dictionary
	var chip_found := bool(chip_result.get("ok", false))
	if chip_found:
		var resolved_iccid := _digits_only(str(chip_result.get("iccid", "")))
		var phone := _local_registration_phone(str(chip_result.get("phone", "")))
		if resolved_iccid != "" and form_fields.has("chip_number"):
			(form_fields.get("chip_number") as LineEdit).text = resolved_iccid
		if phone != "" and form_fields.has("chip_phone"):
			(form_fields.get("chip_phone") as LineEdit).text = phone
		var apn := str(chip_result.get("apn", "")).strip_edges().to_lower()
		if apn in ["hinova.br", "linksolutions.br"]:
			_set_option_value(form_options.get("apn_source"), apn)
		var discovered_operator := str(chip_result.get("operator", "")).strip_edges()
		var selected_operator := _selected_option_text(form_options.get("operator"), true)
		if discovered_operator != "" and (selected_operator == "" or _search_key(selected_operator) == _search_key("selecione")):
			_set_option_value(form_options.get("operator"), discovered_operator)
		var operator_note := ""
		if discovered_operator != "" and selected_operator != "" and _search_key(selected_operator) != _search_key("selecione") and _search_key(selected_operator) != _search_key(discovered_operator):
			operator_note = " Operadora informada manualmente (%s) foi preservada; descoberta: %s." % [selected_operator, discovered_operator]
		_set_form_lookup_status("Chip confirmado: ICCID completo, telefone e APN preenchidos.%s" % operator_note, GREEN)
	else:
		var equipment_result: Dictionary = probe.get("equipment", {}) as Dictionary
		if bool(equipment_result.get("ok", false)):
			_set_form_lookup_status("Equipamento ja existe na plataforma; o salvamento sera tratado como atualizacao segura.", YELLOW)
		else:
			_set_form_lookup_status("Equipamento ainda nao confirmado; voce pode continuar preenchendo o cadastro.", MUTED)
	registration_probe_applying = false


func _await_registration_probe_data(request: Dictionary) -> Dictionary:
	var serial := _digits_only(str(request.get("serial", "")))
	var chip := _digits_only(str(request.get("chip_number", "")))
	if serial == "" and chip == "":
		return request
	var probe_context_serial := _digits_only(str(registration_probe_result.get("serial", "")))
	var probe_context_chip := _digits_only(str(registration_probe_result.get("chip_query", "")))
	var has_probe_context := registration_probe_running or probe_context_serial == serial or (chip != "" and (probe_context_chip == chip or probe_context_chip.ends_with(chip) or chip.ends_with(probe_context_chip)))
	if not has_probe_context:
		# Chamadas da API fora da tela (testes, fila de sincronizacao e fallback)
		# nao devem aguardar uma sondagem que nunca foi iniciada pelo formulario.
		return request
	var deadline := Time.get_ticks_msec() + 12000
	while Time.get_ticks_msec() < deadline:
		var probe_serial := _digits_only(str(registration_probe_result.get("serial", "")))
		var probe_chip := _digits_only(str(registration_probe_result.get("chip_query", "")))
		var chip_matches := chip == "" or probe_chip == chip or probe_chip.ends_with(chip) or chip.ends_with(probe_chip)
		if probe_serial == serial and chip_matches and not registration_probe_running:
			break
		await get_tree().process_frame
	var enriched := request.duplicate(true)
	var chip_result: Dictionary = registration_probe_result.get("chip", {}) as Dictionary
	if bool(chip_result.get("ok", false)):
		var resolved_iccid := _digits_only(str(chip_result.get("iccid", "")))
		var resolved_phone := _local_registration_phone(str(chip_result.get("phone", "")))
		if resolved_iccid != "":
			enriched["chip_number"] = resolved_iccid
		if resolved_phone != "":
			enriched["phone"] = resolved_phone
		if str(chip_result.get("apn", "")).strip_edges() != "":
			enriched["apn"] = str(chip_result.get("apn", "")).strip_edges().to_lower()
		if str(chip_result.get("operator", "")).strip_edges() != "" and _search_key(str(enriched.get("operator", ""))) == _search_key("selecione"):
			enriched["operator"] = str(chip_result.get("operator", "")).strip_edges()
	return enriched


func _lookup_form_grupo_rs_data() -> void:
	var serial := _field_text("imei").strip_edges()
	if serial == "":
		_set_form_lookup_status("Informe o numero de serie para buscar.", YELLOW)
		return

	_set_form_lookup_status("Consultando Grupo RS...", Color("#dce8f7"))
	var rows := await _fetch_grupo_rs_equipment_rows(serial)
	if rows.is_empty():
		form_grupo_rs_data.clear()
		_update_form_grupo_rs_reassign_button()
		_set_form_lookup_status("Nao encontrei essa serie no Grupo RS.", YELLOW)
		return
	var serial_matches: Array[Dictionary] = []
	var serial_key := _search_key(serial)
	for candidate in rows:
		if _search_key(str(candidate.get("serial", ""))) == serial_key:
			serial_matches.append(candidate)
	if serial_matches.size() > 1:
		form_grupo_rs_data.clear()
		_update_form_grupo_rs_reassign_button()
		_set_form_lookup_status("A consulta retornou mais de um cadastro para essa serie; nenhuma alteracao foi liberada.", RED)
		return

	var chosen := serial_matches[0] if serial_matches.size() == 1 else _choose_grupo_rs_equipment_row(rows, serial)
	var details := await _fetch_grupo_rs_equipment_details(chosen)
	form_grupo_rs_data = chosen.duplicate(true)
	for key in details.keys():
		form_grupo_rs_data[key] = details[key]

	_apply_grupo_rs_data_to_form(form_grupo_rs_data)
	_update_form_grupo_rs_reassign_button()


func _lookup_form_chip() -> void:
	var short_chip := _digits_only(_field_text("chip_number"))
	if short_chip.length() < 6 or short_chip.length() > 22:
		_set_form_lookup_status("Informe o ICCID completo ou ao menos 6 digitos finais do chip.", YELLOW)
		return
	_set_form_lookup_status("Consultando chip em paralelo na Hinova e na Link Solutions...", BLUE)
	var lookup := await _lookup_registration_chip_parallel(short_chip)
	if not bool(lookup.get("ok", false)):
		_set_form_lookup_status(str(lookup.get("message", "Chip nao localizado.")), RED)
		return
	var phone := _local_registration_phone(str(lookup.get("phone", "")))
	if phone == "":
		_set_form_lookup_status("Chip encontrado, mas a plataforma nao retornou telefone valido.", YELLOW)
		return
	var resolved_iccid := _digits_only(str(lookup.get("iccid", "")))
	(form_fields.get("chip_number") as LineEdit).text = resolved_iccid if resolved_iccid != "" else short_chip
	(form_fields.get("chip_phone") as LineEdit).text = phone
	var source := str(lookup.get("apn", "")).strip_edges().to_lower()
	if source in ["hinova.br", "linksolutions.br"]:
		_set_option_value(form_options.get("apn_source"), source)
	var remote_operator := str(lookup.get("operator", "")).strip_edges()
	if remote_operator != "":
		var selected_operator := _selected_option_text(form_options.get("operator"), true)
		if selected_operator == "" or _search_key(selected_operator) == _search_key("selecione"):
			_set_option_value(form_options.get("operator"), remote_operator)
		else:
			_set_form_lookup_status("Chip encontrado; operadora manual %s preservada (origem informou %s)." % [selected_operator, remote_operator], YELLOW)
			return
	_set_form_lookup_status("Chip encontrado: ICCID completo, telefone, APN e operadora preenchidos.", GREEN)


func _chip_phone_from_data(data: Dictionary) -> String:
	# O LSIM exibe o telefone como `msisdn`, mas algumas respostas usam o
	# relacionamento da linha (`line__msisdn`) ou um objeto aninhado.
	for key in [
		"msisdn", "line__msisdn", "line_msisdn", "msisdn__value", "msisdn__number",
		"msisdn_value", "msisdn__msisdn", "phone", "phone_number", "mobile",
		"mobile_number", "number_phone", "number_msisdn", "telefone", "telephone",
		"line__number", "line_number"
	]:
		var value := _chip_phone_candidate(data.get(key, ""), key)
		if value != "":
			return value

	# Compatibilidade com envelopes de versões diferentes do portal.
	for key in data.keys():
		var normalized_key := str(key).to_lower()
		if normalized_key.contains("msisdn") or normalized_key.contains("phone") or normalized_key.contains("telefone") or normalized_key.contains("telephone"):
			var value := _chip_phone_candidate(data.get(key, ""), normalized_key)
			if value != "":
				return value

	# Algumas respostas agrupam os dados da linha em `line`/`sim` e deixam
	# o nome msisdn apenas no objeto interno.
	for key in ["line", "sim", "subscription", "mobile_line"]:
		var value := _chip_phone_candidate(data.get(key, {}), "msisdn")
		if value != "":
			return value
	return ""


func _chip_phone_candidate(value: Variant, key_hint: String = "") -> String:
	if typeof(value) == TYPE_DICTIONARY:
		var nested := value as Dictionary
		for key in ["value", "number", "msisdn", "phone", "telefone", "telephone", "text"]:
			var candidate := _chip_phone_candidate(nested.get(key, ""), key_hint + " " + key)
			if candidate != "":
				return candidate
		return ""
	if typeof(value) == TYPE_ARRAY:
		for item in value as Array:
			var candidate := _chip_phone_candidate(item, key_hint)
			if candidate != "":
				return candidate
		return ""

	var text := str(value).strip_edges()
	if text == "":
		return ""
	var digits := _digits_only(text)
	# Somente campos explicitamente relacionados a telefone podem ser usados.
	# Isso evita aceitar `id`, `number` de contrato ou outro identificador.
	var is_phone_key := key_hint.contains("msisdn") or key_hint.contains("phone") or key_hint.contains("telefone") or key_hint.contains("telephone")
	return text if is_phone_key and digits.length() >= 10 and digits.length() <= 15 else ""


func _local_registration_phone(value: String) -> String:
	var digits := _digits_only(value)
	if digits.begins_with("55") and digits.length() > 11:
		digits = digits.substr(2)
	return digits if digits.length() in [10, 11] else ""


func _registration_operator_from_chip_data(data: Dictionary) -> String:
	var value := str(data.get("operator__name", data.get("operator", data.get("operadora", "")))).strip_edges().to_lower()
	if value.contains("tim"):
		return "Tim"
	if value.contains("claro"):
		return "Claro"
	if value.contains("vivo") or value.contains("telefonica"):
		return "Vivo"
	return ""


func _update_form_grupo_rs_reassign_button() -> void:
	if form_grupo_rs_reassign_button == null or not is_instance_valid(form_grupo_rs_reassign_button):
		return
	var remote_serial := str(form_grupo_rs_data.get("serial", "")).strip_edges()
	var remote_plate := str(form_grupo_rs_data.get("plate", "")).strip_edges()
	# Um equipamento pode existir no Grupo RS sem estar vinculado a uma placa;
	# a serie confirmada e suficiente para liberar a modificacao dos campos.
	# A modificacao continua segura porque a serie foi confirmada pela consulta
	# remota; a placa passa a ser apenas mais um campo opcional da operacao.
	var available := _grupo_rs_supports_modern_api() and remote_serial != "" and not _equipment_api_edit_queue_contains_serial(_digits_only(remote_serial))
	form_grupo_rs_reassign_button.disabled = not available or vehicle_reassignment_running
	form_grupo_rs_reassign_button.tooltip_text = (
		"Modificar placa, chip, telefone e APN no Grupo RS novo"
		if available
		else "Aguarde a edicao remota atual terminar ou busque um equipamento existente no Grupo RS de Imperatriz"
	)


func _choose_grupo_rs_equipment_row(rows: Array[Dictionary], serial: String) -> Dictionary:
	var serial_key := _search_key(serial)
	for row in rows:
		if _search_key(str(row.get("serial", ""))) == serial_key:
			return row
	return rows[0] if rows.size() > 0 else {}


func _apply_grupo_rs_data_to_form(data: Dictionary) -> void:
	if data.is_empty():
		return

	var serial := str(data.get("serial", "")).strip_edges()
	var plate := str(data.get("plate", "")).strip_edges()
	var chip := _digits_only(str(data.get("chip", "")))
	var phone := str(data.get("phone", "")).strip_edges()
	var client := str(data.get("client", "")).strip_edges()
	var apn := str(data.get("apn", "")).strip_edges()
	var operator_name := str(data.get("operator", "")).strip_edges()

	if serial != "" and form_fields.has("imei"):
		(form_fields.get("imei") as LineEdit).text = serial
	if plate != "" and form_fields.has("plate"):
		(form_fields.get("plate") as LineEdit).text = plate.to_upper()
	if chip != "" and form_fields.has("chip_number"):
		(form_fields.get("chip_number") as LineEdit).text = chip
	if phone != "" and form_fields.has("chip_phone"):
		(form_fields.get("chip_phone") as LineEdit).text = _local_registration_phone(phone)
	if apn.to_lower() in ["hinova.br", "linksolutions.br"]:
		_set_option_value(form_options.get("apn_source"), apn.to_lower())

	var model := _infer_form_model_from_grupo_rs_plate(plate)
	if model != "":
		_set_option_value(form_options.get("model"), model)

	if operator_name == "" or operator_name == "Sem operadora":
		operator_name = _infer_bulk_operator_from_plate(plate)
	if operator_name != "" and operator_name != "Sem operadora":
		_set_option_value(form_options.get("operator"), operator_name)

	# A consulta remota preenche os dados cadastrais, mas nao pode desfazer
	# uma baixa/instalacao ja registrada no cadastro local.
	var is_existing_equipment := editing_sku.strip_edges() != ""
	if not is_existing_equipment:
		if model == "Reutilizado":
			_set_option_value(form_options.get("tracker_status"), "Manutencao")
		elif model != "":
			_set_option_value(form_options.get("tracker_status"), "Estoque")

	var detail_parts: Array[String] = []
	if model != "":
		detail_parts.append(model)
	if operator_name != "" and operator_name != "Sem operadora":
		detail_parts.append(operator_name)
	if chip != "":
		detail_parts.append("chip %s" % chip)
	if apn != "":
		detail_parts.append("APN %s" % apn)
	if client != "":
		detail_parts.append("cliente %s" % _truncate(client, 28))

	_set_form_lookup_status(
		"Grupo RS encontrado: %s" % (" | ".join(detail_parts) if not detail_parts.is_empty() else "dados aplicados."),
		GREEN
	)
	if form_associate_vehicle_toggle != null and is_instance_valid(form_associate_vehicle_toggle):
		# No modo novo a placa permanece editavel mesmo quando a consulta do
		# IMEI ainda nao encontrou um vinculo remoto. Na reentrada, o estado
		# continua refletindo a associacao que ja existe.
		form_associate_vehicle_toggle.button_pressed = true if form_mode == "new" else plate != ""
	_update_form_vehicle_fields_state()
	_update_form_summary()


func _infer_form_model_from_grupo_rs_plate(plate: String) -> String:
	var inferred := _infer_bulk_model_from_plate(plate)
	if inferred != "":
		return inferred
	if plate.strip_edges() != "":
		return "Reutilizado"
	return ""


func _set_form_lookup_status(message: String, color: Color) -> void:
