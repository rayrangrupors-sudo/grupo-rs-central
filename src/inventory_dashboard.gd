func _display_log_date(value: String) -> String:
	var parts := value.split("-")
	if parts.size() == 3:
		return "%s/%s/%s" % [parts[2], parts[1], parts[0]]
	return value


func _system_log_filter_label(filter_key: String) -> String:
	match filter_key:
		"sms":
			return "SMS / reset"
		"recovered":
			return "Recuperados"
		"maintenance":
			return "Manutencoes"
		"errors":
