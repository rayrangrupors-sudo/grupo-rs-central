func _system_log_metrics(logs: Array[Dictionary]) -> Dictionary:
	var metrics := {
		"sms": 0,
		"recovered": 0,
		"maintenance": 0,
		"errors": 0,
	}
	for entry in logs:
		var action := str(entry.get("action", "")).to_lower()
		var details := str(entry.get("details", "")).to_lower()
		var joined := "%s %s" % [action, details]
		if action.contains("enviou reset") or joined.contains("sms"):
			metrics["sms"] = int(metrics.get("sms", 0)) + 1
		if action.contains("recuperado"):
			metrics["recovered"] = int(metrics.get("recovered", 0)) + 1
		if joined.contains("manut"):
			metrics["maintenance"] = int(metrics.get("maintenance", 0)) + 1
		if action.contains("falhou") or joined.contains("erro"):
			metrics["errors"] = int(metrics.get("errors", 0)) + 1
	return metrics


