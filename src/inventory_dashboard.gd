func _location_speed_display(value: Variant) -> String:
	var text_value := str(value).replace(",", ".").strip_edges()
	if text_value == "" or not text_value.is_valid_float():
		return "Nao informado"
	return "%.0f km/h" % text_value.to_float()


func _location_elapsed_display(updated_at: String) -> String:
	var clean := updated_at.strip_edges()
	if clean == "":
		return "Nao informado"
	var hours := _hours_since_grupo_rs_datetime(clean)
	if hours < 0.0:
		return clean
	var minutes := roundi(hours * 60.0)
	if minutes < 1:
		return "agora | %s" % clean
	if minutes < 60:
		return "ha %d min | %s" % [minutes, clean]
	return "ha %.1f h | %s" % [hours, clean]


