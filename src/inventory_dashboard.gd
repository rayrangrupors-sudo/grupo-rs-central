func _delete_legacy_grupo_rs_bulk_confirmed(items: Array[Dictionary]) -> void:
	if items.is_empty():
		return

	var success_count := 0
	var fail_count := 0
	var messages: Array[String] = []
	var result_rows: Array[Dictionary] = []
	_show_bulk_delete_progress(items.size())
	await get_tree().process_frame

	for index in range(items.size()):
		var item := items[index]
		var kind := str(item.get("kind", "equipment"))
		var target := _bulk_delete_item_target(item)
		var label := _bulk_delete_item_label(item)
		_bulk_delete_progress_begin_item(index + 1, items.size(), label, kind)
		_show_bulk_result("Excluindo %d/%d: %s..." % [index + 1, items.size(), label], true)
		await get_tree().process_frame

		var result: Dictionary = {}
		if kind == "plate":
			result = await _delete_legacy_grupo_rs_plate(target, Callable(self, "_bulk_delete_progress_stage"))
		else:
			result = await _delete_legacy_grupo_rs_equipment(target, Callable(self, "_bulk_delete_progress_stage"), str(item.get("link_code", "")))
		if bool(result.get("ok", false)):
			success_count += 1
			messages.append("%s: OK" % label)
			_log_system_action("Exclusao Grupo RS em massa", str(result.get("message", "")), label)
		else:
			fail_count += 1
			messages.append("%s: %s" % [label, str(result.get("message", "falhou"))])
		result_rows.append({
			"kind": kind,
			"target": target,
			"serial": str(item.get("serial", "")),
			"plate": str(item.get("plate", "")),
			"link_code": str(item.get("link_code", "")),
			"ok": bool(result.get("ok", false)),
			"pending_verify": bool(result.get("pending_verify", false)),
			"message": str(result.get("message", "")),
		})
		_bulk_delete_progress_finish_item(label, bool(result.get("ok", false)), str(result.get("message", "")), index + 1, items.size())
		await get_tree().create_timer(0.22).timeout

	var needs_final_check := false
	for row in result_rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var result_row := row as Dictionary
		if not bool(result_row.get("ok", false)) or bool(result_row.get("pending_verify", false)):
			needs_final_check = true
			break

	if needs_final_check:
		_show_bulk_result("Conferindo baixas pendentes no Grupo RS antigo...", true)
		await get_tree().process_frame
		for index in range(result_rows.size()):
			var result_row := result_rows[index]
			if typeof(result_row) != TYPE_DICTIONARY:
				continue
			var row_dict := result_row as Dictionary
			if bool(row_dict.get("ok", false)) and not bool(row_dict.get("pending_verify", false)):
				continue
			var kind := str(row_dict.get("kind", "equipment"))
			var target := _bulk_delete_item_target(row_dict)
			if target == "":
				continue
			var verify_state: Dictionary = {}
			if kind == "plate":
				verify_state = await _legacy_grupo_rs_vehicle_exists(target, 5, 1.5)
			else:
				verify_state = await _legacy_grupo_rs_equipment_exists(target, 5, 1.5)
			if not bool(verify_state.get("ok", false)):
				continue
			if not bool(verify_state.get("exists", true)):
				row_dict["ok"] = true
				row_dict["pending_verify"] = false
				row_dict["message"] = "Confirmado removido na verificacao final do lote."
			elif bool(row_dict.get("pending_verify", false)):
				row_dict["ok"] = false
				row_dict["pending_verify"] = false
				row_dict["message"] = "A exclusao foi enviada, mas o equipamento ainda apareceu na verificacao final do lote."
			result_rows[index] = row_dict

	success_count = 0
	fail_count = 0
	messages.clear()
	for row in result_rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var result_row := row as Dictionary
		var label := _bulk_delete_item_label(result_row)
		if bool(result_row.get("ok", false)):
			success_count += 1
			messages.append("%s: OK" % label)
		else:
			fail_count += 1
			messages.append("%s: %s" % [label, str(result_row.get("message", "falhou"))])

	var message := "Exclusao Grupo RS concluida: %d sucesso(s), %d falha(s)." % [success_count, fail_count]
	if not messages.is_empty():
		message += "\n" + _join_messages(messages, 8)
		if messages.size() > 8:
			message += "\n... e mais %d item(ns)." % (messages.size() - 8)
	_bulk_delete_progress_complete(success_count, fail_count, items.size())
	await get_tree().create_timer(0.75).timeout
	_close_bulk_delete_progress()
	_show_bulk_result(message, fail_count == 0)
	_show_bulk_delete_report(items.size(), success_count, fail_count, result_rows)


func _parse_bulk_delete_serials(raw_text: String) -> Dictionary:
	var serials: Array[String] = []
	var parsed := _parse_bulk_delete_items(raw_text)
	for item in parsed.get("items", []):
		if typeof(item) != TYPE_DICTIONARY:
			continue
		var item_dict := item as Dictionary
		if str(item_dict.get("kind", "equipment")) != "equipment":
			continue
		var serial := str(item_dict.get("serial", "")).strip_edges()
		if serial != "":
			serials.append(serial)
	return {
		"serials": serials,
		"errors": parsed.get("errors", []),
	}


func _parse_bulk_delete_items(raw_text: String) -> Dictionary:
	var items: Array[Dictionary] = []
	var errors: Array[String] = []
	var seen := {}
	var parsed_registration := _parse_bulk_registration_text(raw_text)
	for row in parsed_registration.get("rows", []):
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var serial := str((row as Dictionary).get("serial", "")).strip_edges()
		if serial != "" and not _legacy_delete_line_has_table_shape(serial, raw_text) and not _legacy_delete_line_has_vehicle_shape(serial, raw_text):
			_add_bulk_delete_item(_make_bulk_delete_preview_row(serial, str((row as Dictionary).get("plate", ""))), items, errors, seen)

	for raw_line in raw_text.replace("\r", "\n").split("\n", false):
		var line := str(raw_line).strip_edges()
		if line == "" or _is_bulk_header(_split_bulk_line(line)):
			continue

		var standalone_plate_row := _standalone_bulk_delete_plate_row_from_line(line)
		if not standalone_plate_row.is_empty():
			_add_bulk_delete_item(standalone_plate_row, items, errors, seen)
			continue

		var vehicle_row := _legacy_delete_vehicle_preview_row_from_line(line)
		if not vehicle_row.is_empty():
			_add_bulk_delete_item(vehicle_row, items, errors, seen)
			continue

		var equipment_row := _legacy_delete_preview_row_from_line(line)
		if not equipment_row.is_empty():
			_add_bulk_delete_item(equipment_row, items, errors, seen)
			continue

		var serial := _extract_bulk_delete_serial_from_line(line)
		if serial != "":
			_add_bulk_delete_item(_make_bulk_delete_preview_row(serial, ""), items, errors, seen)

	return {
		"items": items,
		"errors": errors,
	}


func _parse_bulk_delete_preview_rows(raw_text: String) -> Dictionary:
	var rows: Array[Dictionary] = []
	var errors: Array[String] = []
	var seen := {}
	var prefer_delete_preview := false
	var line_number := 0

	for raw_line in raw_text.replace("\r\n", "\n").replace("\r", "\n").split("\n", false):
		line_number += 1
		var line := str(raw_line).strip_edges()
		if line == "" or _is_bulk_header(_split_bulk_line(line)):
			continue

		var standalone_plate_row := _standalone_bulk_delete_plate_row_from_line(line)
		if not standalone_plate_row.is_empty():
			prefer_delete_preview = true
			var standalone_plate := str(standalone_plate_row.get("plate", "")).strip_edges()
			var standalone_key := "plate:%s" % standalone_plate.to_upper()
			if seen.has(standalone_key):
				continue
			seen[standalone_key] = true
			rows.append(standalone_plate_row)
			continue

		var vehicle_row := _legacy_delete_vehicle_preview_row_from_line(line)
		if not vehicle_row.is_empty():
			prefer_delete_preview = true
			var vehicle_plate := str(vehicle_row.get("plate", "")).strip_edges()
			var vehicle_key := "plate:%s" % vehicle_plate.to_upper()
			if seen.has(vehicle_key):
				continue
			seen[vehicle_key] = true
			rows.append(vehicle_row)
			continue

		var legacy_row := _legacy_delete_preview_row_from_line(line)
		if not legacy_row.is_empty():
			prefer_delete_preview = true
			var legacy_serial := str(legacy_row.get("serial", "")).strip_edges()
			var legacy_key := "equipment:%s" % legacy_serial.to_upper()
			if seen.has(legacy_key):
				continue
			seen[legacy_key] = true
			rows.append(legacy_row)
			continue

		var cells := _split_bulk_line(line)
		if cells.size() == 1:
			var serial := _extract_bulk_delete_serial_from_line(line)
			if serial != "":
				var key := serial.to_upper()
				if seen.has(key):
					continue
				seen[key] = true
				rows.append(_make_bulk_delete_preview_row(serial, ""))
			else:
				errors.append("Linha %d: numero de serie nao reconhecido." % line_number)

	return {
		"rows": rows,
		"errors": errors,
		"prefer_delete_preview": prefer_delete_preview or (not rows.is_empty() and _parse_bulk_registration_text(raw_text).get("rows", []).is_empty()),
	}


func _standalone_bulk_delete_plate_row_from_line(line: String) -> Dictionary:
	var cells := _split_bulk_line(line)
	if cells.size() != 1:
		return {}
	var plate := _normalize_bulk_plate(_clean_pasted_cell(cells[0]))
	if not _looks_like_standalone_bulk_delete_plate(plate):
		return {}
	return _make_bulk_delete_preview_row("", plate, "plate")


func _legacy_delete_preview_row_from_line(line: String) -> Dictionary:
	var cells := _split_bulk_line(line)
	if cells.size() < 3:
		return {}
	var first := _digits_only(_clean_pasted_cell(cells[0]))
	var plate := _normalize_bulk_plate(_clean_pasted_cell(cells[1]))
	var serial := _digits_only(_clean_pasted_cell(cells[2]))
	if first.length() == 5 and _looks_like_legacy_delete_plate(plate) and _looks_like_bulk_delete_serial(serial):
		var row := _make_bulk_delete_preview_row(serial, plate)
		row["link_code"] = first
		return row
	return {}


func _legacy_delete_vehicle_preview_row_from_line(line: String) -> Dictionary:
	var cells := _split_bulk_line(line)
	if cells.size() < 4:
		return {}
	var first := _digits_only(_clean_pasted_cell(cells[0]))
	var plate := _normalize_bulk_plate(_clean_pasted_cell(cells[1]))
	var third_cell := _clean_pasted_cell(cells[2])
	if first.length() != 5 or not _looks_like_legacy_delete_plate(plate):
		return {}
	if _looks_like_bulk_delete_serial(third_cell):
		return {}
	var has_action := false
	for cell in cells:
		var key := _bulk_key(_clean_pasted_cell(cell))
		if key == "selecionar" or key == "desativar":
			has_action = true
			break
	if not has_action and not _looks_like_legacy_vehicle_date(_clean_pasted_cell(cells[3])):
		return {}
	return _make_bulk_delete_preview_row("", plate, "plate")


func _make_bulk_delete_preview_row(serial: String, plate: String, kind: String = "equipment") -> Dictionary:
	var clean_kind := "plate" if kind == "plate" else "equipment"
	return {
		"serial": "" if clean_kind == "plate" else _digits_only(serial),
		"plate": _normalize_bulk_plate(plate),
		"model": "Excluir placa" if clean_kind == "plate" else "Excluir aparelho",
		"operator": "Grupo RS antigo",
		"mode": "delete",
		"delete_kind": clean_kind,
		"kind": clean_kind,
	}


func _legacy_delete_line_has_table_shape(serial: String, raw_text: String) -> bool:
	var serial_key := _digits_only(serial)
	if serial_key.length() != 5:
		return false
	for raw_line in raw_text.replace("\r", "\n").split("\n", false):
		var cells := _split_bulk_line(str(raw_line))
		if cells.size() >= 3 and _digits_only(_clean_pasted_cell(cells[0])) == serial_key:
			return _looks_like_legacy_delete_plate(_clean_pasted_cell(cells[1])) and _looks_like_bulk_delete_serial(_clean_pasted_cell(cells[2]))
	return false


func _legacy_delete_line_has_vehicle_shape(code: String, raw_text: String) -> bool:
	var code_key := _digits_only(code)
	if code_key.length() != 5:
		return false
	for raw_line in raw_text.replace("\r", "\n").split("\n", false):
		var cells := _split_bulk_line(str(raw_line))
		if cells.size() >= 4 and _digits_only(_clean_pasted_cell(cells[0])) == code_key:
			return not _legacy_delete_vehicle_preview_row_from_line(str(raw_line)).is_empty()
	return false


func _add_bulk_delete_serial(serial: String, serials: Array[String], errors: Array[String], seen: Dictionary) -> void:
	var clean_serial := serial.strip_edges()
	if not _looks_like_bulk_delete_serial(clean_serial):
		errors.append("%s: numero de serie invalido." % clean_serial)
		return
	var key := clean_serial.to_upper()
	if seen.has(key):
		return
	seen[key] = true
	serials.append(clean_serial)


func _add_bulk_delete_item(item: Dictionary, items: Array[Dictionary], errors: Array[String], seen: Dictionary) -> void:
	var kind := str(item.get("kind", item.get("delete_kind", "equipment")))
	kind = "plate" if kind == "plate" else "equipment"
	if kind == "plate":
		var clean_plate := _normalize_bulk_plate(str(item.get("plate", item.get("target", ""))))
		if not _looks_like_legacy_delete_plate(clean_plate):
			errors.append("%s: placa invalida para exclusao." % _blank(clean_plate))
			return
		var plate_key := "plate:%s" % clean_plate.to_upper()
		if seen.has(plate_key):
			return
		seen[plate_key] = true
		items.append({
			"kind": "plate",
			"target": clean_plate,
			"serial": "",
			"plate": clean_plate,
		})
		return

	var clean_serial := _digits_only(str(item.get("serial", item.get("target", ""))))
	if not _looks_like_bulk_delete_serial(clean_serial):
		errors.append("%s: numero de serie invalido." % _blank(clean_serial))
		return
	var serial_key := "equipment:%s" % clean_serial.to_upper()
	if seen.has(serial_key):
		return
	seen[serial_key] = true
	items.append({
		"kind": "equipment",
		"target": clean_serial,
		"serial": clean_serial,
		"plate": _normalize_bulk_plate(str(item.get("plate", ""))),
		"link_code": _digits_only(str(item.get("link_code", ""))),
	})


func _bulk_delete_item_target(item: Dictionary) -> String:
	if str(item.get("kind", "equipment")) == "plate":
		return _normalize_bulk_plate(str(item.get("plate", item.get("target", ""))))
	return _digits_only(str(item.get("serial", item.get("target", ""))))


func _bulk_delete_item_label(item: Dictionary) -> String:
	if str(item.get("kind", "equipment")) == "plate":
		return "Placa %s" % _bulk_delete_item_target(item)
	return "Equipamento %s" % _bulk_delete_item_target(item)


func _request_clear_bulk_registration() -> void:
	_confirm_action(
		"Limpar cadastro",
		"Deseja realmente limpar os dados informados?",
		_clear_bulk_registration
	)


func _clear_bulk_registration() -> void:
	if bulk_text_edit:
		bulk_text_edit.text = ""
	if bulk_result_label:
		bulk_result_label.text = "Cole os dados ou escolha um arquivo para analisar antes de salvar."
		bulk_result_label.add_theme_color_override("font_color", MUTED)
	if bulk_operator_option:
		bulk_operator_option.select(0)
	_render_bulk_preview([], [], [])
	bulk_last_auto_text = ""
	bulk_import_pending = false
	bulk_paste_requested = false
	bulk_last_analysis = {}
	bulk_text_before_cleanup = ""
	bulk_cleaned_text = ""
	bulk_cleanup_applied = false
	_update_bulk_analysis_summary({})
	_show_success("Sucesso", "Campos limpos com sucesso.")


func _open_bulk_xlsx_dialog() -> void:
	if bulk_file_dialog == null:
		return
	bulk_file_dialog.popup_centered(Vector2i(900, 650))


func _on_bulk_file_selected(path: String) -> void:
	var parsed := _parse_bulk_file(path)
	var rows: Array = parsed.get("rows", [])
	var errors: Array = parsed.get("errors", [])

	if rows.is_empty():
		var file_message := "Nenhuma linha valida encontrada no arquivo."
		if not errors.is_empty():
			file_message += "\n" + _join_messages(errors, 6)
		_render_bulk_preview([], errors, [])
		_show_bulk_result(file_message, false)
		_show_error("Erro", file_message)
		return

	var preview_text := _bulk_rows_to_text(rows)
	if bulk_text_edit:
		bulk_import_pending = true
		bulk_text_edit.text = preview_text
		bulk_last_auto_text = preview_text
		bulk_paste_requested = false
		bulk_import_pending = false

	var message := "Arquivo lido: %d linha(s)." % rows.size()
	if not errors.is_empty():
		message += "\n" + _join_messages(errors, 6)
	_show_bulk_result(message, errors.is_empty())
	_preview_bulk_registration_text(preview_text)


func _on_bulk_text_gui_input(event: InputEvent) -> void:
	if event is InputEventKey:
		var key_event := event as InputEventKey
		if key_event.pressed and not key_event.echo and key_event.keycode == KEY_V:
			if key_event.ctrl_pressed or key_event.meta_pressed:
				bulk_paste_requested = true


func _on_bulk_text_changed() -> void:
	if bulk_text_edit == null:
		return

	var current_text := bulk_text_edit.text.strip_edges()
	if current_text == "":
		bulk_paste_requested = false
		bulk_last_auto_text = ""
		bulk_last_analysis = {}
		bulk_cleaned_text = ""
		bulk_cleanup_applied = false
		_render_bulk_preview([], [], [])
		_update_bulk_analysis_summary({})
		if bulk_result_label:
			bulk_result_label.text = "Cole os dados ou escolha um arquivo para analisar antes de salvar."
			bulk_result_label.add_theme_color_override("font_color", MUTED)
		return
	if current_text == bulk_last_auto_text:
		bulk_paste_requested = false
		return
	if not bulk_paste_requested and not current_text.contains("\n") and current_text.length() < 9:
		return
	if bulk_import_pending:
		return

	bulk_import_pending = true
	await get_tree().create_timer(0.2).timeout
	bulk_import_pending = false

	if bulk_text_edit == null:
		return

	current_text = bulk_text_edit.text.strip_edges()
	if current_text == "" or current_text == bulk_last_auto_text:
		bulk_paste_requested = false
		return
	if not _looks_like_bulk_data(current_text):
		bulk_paste_requested = false
		_render_bulk_preview([], ["Nao reconheci linhas validas. Confira se os dados possuem numero de serie e placa."], [])
		_show_bulk_result("Nao reconheci linhas validas. Confira se os dados possuem numero de serie e placa.", false)
		return

	bulk_last_auto_text = current_text
	bulk_paste_requested = false
	_preview_bulk_registration_text(current_text)


func _request_bulk_analysis() -> void:
	if bulk_text_edit == null or bulk_text_edit.text.strip_edges() == "":
		_show_warning("Organizacao inteligente", "Cole os dados antes de analisar.")
		return
	_preview_bulk_registration_text(bulk_text_edit.text)


func _request_bulk_cleanup() -> void:
	if bulk_text_edit == null or bulk_text_edit.text.strip_edges() == "":
		_show_warning("Limpar e organizar", "Cole os dados antes de limpar.")
		return

	var analysis := _analyze_bulk_input(bulk_text_edit.text)
	var clean_rows: Array = analysis.get("clean_rows", [])
	var errors: Array = analysis.get("errors", [])
	var conflicts: Array = analysis.get("conflicts", [])
	if clean_rows.is_empty():
		var empty_message := "Nenhum registro valido foi encontrado para limpar."
		if not errors.is_empty():
			empty_message += "\n" + _join_messages(errors, 5)
		_show_bulk_result(empty_message, false)
		_show_error("Limpar e organizar", empty_message)
		return
	if not conflicts.is_empty():
		var conflict_message := "Existem %d conflito(s) de placa/serie. Revise antes de limpar." % conflicts.size()
		_show_bulk_result(conflict_message, false)
		_show_warning("Limpar e organizar", conflict_message)
		return

	bulk_text_before_cleanup = bulk_text_edit.text
	bulk_cleaned_text = _bulk_clean_rows_to_text(clean_rows)
	bulk_cleanup_applied = true
	bulk_import_pending = true
	bulk_last_auto_text = bulk_cleaned_text
	bulk_paste_requested = false
	bulk_text_edit.text = bulk_cleaned_text
	bulk_import_pending = false
	_preview_bulk_registration_text(bulk_cleaned_text)
	var removed := int(analysis.get("auxiliary_fields", 0))
	var message := "Limpeza concluida: %d registro(s) organizado(s)." % clean_rows.size()
	if removed > 0:
		message += " Campos auxiliares removidos: %d." % removed
	_show_bulk_result(message, true)


func _undo_bulk_cleanup() -> void:
	if not bulk_cleanup_applied or bulk_text_before_cleanup == "":
		_show_warning("Desfazer", "Nao existe uma limpeza recente para desfazer.")
		return
	var original := bulk_text_before_cleanup
	bulk_cleanup_applied = false
	bulk_cleaned_text = ""
	bulk_import_pending = true
	bulk_last_auto_text = original
	bulk_paste_requested = false
	bulk_text_edit.text = original
	bulk_import_pending = false
	_preview_bulk_registration_text(original)
	_show_bulk_result("Texto original restaurado. A limpeza foi desfeita.", true)


func _copy_bulk_clean_result() -> void:
	if bulk_text_edit == null or bulk_text_edit.text.strip_edges() == "":
		_show_warning("Copiar resultado", "Cole os dados antes de copiar o resultado.")
		return
	var analysis := _analyze_bulk_input(bulk_text_edit.text)
	var clean_rows: Array = analysis.get("clean_rows", [])
	if clean_rows.is_empty():
		_show_warning("Copiar resultado", "Nenhum registro valido esta disponivel para copiar.")
		return
	DisplayServer.clipboard_set(_bulk_clean_rows_to_text(clean_rows))
	_show_success("Copiado", "%d registro(s) copiado(s) em duas colunas: placa e serie." % clean_rows.size())


func _preview_bulk_registration_text(raw_text: String) -> void:
	var analysis := _analyze_bulk_input(raw_text)
	bulk_last_analysis = analysis
	var rows: Array = analysis.get("clean_rows", [])
	var errors: Array = analysis.get("errors", [])
	var review_errors: Array = analysis.get("review_errors", [])
	var conflicts: Array = analysis.get("conflicts", [])
	_render_bulk_preview(rows, errors, review_errors)
	_update_bulk_analysis_summary(analysis)
	var ready_count := maxi(rows.size() - review_errors.size(), 0)
	var message := "Validacao pronta: %d linha(s) prontas para salvar" % ready_count
	var duplicate_count := int(analysis.get("duplicate_count", 0))
	if duplicate_count > 0:
		message += " | %d duplicada(s) removida(s) da previa" % duplicate_count
	if conflicts.size() > 0:
		message += " | %d conflito(s) precisam revisar" % conflicts.size()
	if review_errors.size() > 0:
		message += " | %d precisam revisar" % review_errors.size()
	if not errors.is_empty():
		message += " | %d erro(s) de leitura" % errors.size()
	var all_errors: Array = []
	all_errors.append_array(errors)
	all_errors.append_array(review_errors)
	if not all_errors.is_empty():
		message += "\n" + _join_messages(all_errors, 6)
		if all_errors.size() > 6:
			message += "\nOutros problemas: %d" % (all_errors.size() - 6)
	if rows.is_empty():
		message = "Nenhuma linha valida encontrada para salvar."
		if not errors.is_empty():
			message += "\n" + _join_messages(errors, 6)
	_show_bulk_result(message, rows.size() > 0 and all_errors.is_empty() and conflicts.is_empty())


func _analyze_bulk_input(raw_text: String) -> Dictionary:
	var parsed := _parse_bulk_registration_text(raw_text)
	var rows: Array = parsed.get("rows", [])
	var errors: Array = parsed.get("errors", [])
	var clean_rows: Array = []
	var duplicates: Array = []
	var conflicts: Array = []
	var seen_serials := {}
	var seen_plates := {}
	for row_value in rows:
		if typeof(row_value) != TYPE_DICTIONARY:
			continue
		var row := (row_value as Dictionary).duplicate(true)
		var serial := str(row.get("serial", "")).strip_edges().to_upper()
		var plate := str(row.get("plate", "")).strip_edges().to_upper()
		if serial == "":
			continue
		if seen_serials.has(serial):
			var previous_plate := str(seen_serials[serial])
			if previous_plate == plate:
				duplicates.append(row)
			else:
				conflicts.append({"serial": serial, "plate": plate, "reason": "serie associada a placas diferentes"})
			continue
		if plate != "" and seen_plates.has(plate):
			var previous_serial := str(seen_plates[plate])
			if previous_serial == serial:
				duplicates.append(row)
			else:
				conflicts.append({"serial": serial, "plate": plate, "reason": "placa associada a series diferentes"})
			continue
		seen_serials[serial] = plate
		if plate != "":
			seen_plates[plate] = serial
		clean_rows.append(row)

	var review_errors := _bulk_validation_errors(clean_rows)
	var auxiliary_fields := _count_bulk_auxiliary_fields(raw_text)
	return {
		"raw_text": raw_text,
		"rows": rows,
		"clean_rows": clean_rows,
		"errors": errors,
		"review_errors": review_errors,
		"duplicates": duplicates,
		"duplicate_count": duplicates.size(),
		"conflicts": conflicts,
		"auxiliary_fields": auxiliary_fields,
	}


func _count_bulk_auxiliary_fields(raw_text: String) -> int:
	var count := 0
	var normalized_text := raw_text.replace("\r\n", "\n").replace("\r", "\n")
	for raw_line in normalized_text.split("\n"):
		var line := str(raw_line).strip_edges()
		if line == "":
			continue
		var cells := _split_bulk_line(line)
		for cell in cells:
			var clean := _clean_pasted_cell(cell)
			var key := _bulk_key(clean)
			if key == "selecionar" or key == "desativar" or key == "id" or key == "codigo" or key == "cod":
				count += 1
			elif clean.is_valid_int() and not _looks_like_bulk_serial(clean):
				count += 1
	return count


func _detect_bulk_auxiliary_names(raw_text: String) -> Array[String]:
	var names: Array[String] = []
	var normalized_text := raw_text.replace("\r\n", "\n").replace("\r", "\n")
	for raw_line in normalized_text.split("\n"):
		var line := str(raw_line).strip_edges()
		if line == "":
			continue
		for cell in _split_bulk_line(line):
			var clean := _clean_pasted_cell(cell)
			var key := _bulk_key(clean)
			var label := ""
			if key == "selecionar":
				label = "Selecionar"
			elif key == "desativar":
				label = "Desativar"
			elif key == "id" or key == "codigo" or key == "cod" or (clean.is_valid_int() and not _looks_like_bulk_serial(clean)):
				label = "ID"
			if label != "" and not names.has(label):
				names.append(label)
	return names


func _update_bulk_analysis_summary(analysis: Dictionary) -> void:
	var rows: Array = analysis.get("rows", [])
	var clean_rows: Array = analysis.get("clean_rows", [])
	var errors: Array = analysis.get("errors", [])
	var review_errors: Array = analysis.get("review_errors", [])
	var conflicts: Array = analysis.get("conflicts", [])
	var duplicate_count := int(analysis.get("duplicate_count", 0))
	var valid_count := maxi(clean_rows.size() - review_errors.size(), 0)
	var invalid_count := errors.size() + review_errors.size() + conflicts.size()
	if bulk_analysis_button != null:
		bulk_analysis_button.disabled = rows.is_empty()
	if bulk_clean_button != null:
		bulk_clean_button.disabled = clean_rows.is_empty() or not conflicts.is_empty()
	if bulk_undo_button != null:
		bulk_undo_button.disabled = not bulk_cleanup_applied
	if bulk_copy_button != null:
		bulk_copy_button.disabled = clean_rows.is_empty()
	if bulk_input_note_label != null and is_instance_valid(bulk_input_note_label):
		var auxiliary_names := _detect_bulk_auxiliary_names(str(analysis.get("raw_text", "")))
		if auxiliary_names.is_empty():
			bulk_input_note_label.text = "Colunas auxiliares serao identificadas sem apagar o texto original."
		else:
			bulk_input_note_label.text = "Colunas auxiliares detectadas: %s." % ", ".join(auxiliary_names)
	if bulk_summary_value_labels.has("read"):
		(bulk_summary_value_labels["read"] as Label).text = str(rows.size())
	if bulk_summary_value_labels.has("valid"):
		(bulk_summary_value_labels["valid"] as Label).text = str(valid_count)
	if bulk_summary_value_labels.has("duplicate"):
		(bulk_summary_value_labels["duplicate"] as Label).text = str(duplicate_count)
	if bulk_summary_value_labels.has("invalid"):
		(bulk_summary_value_labels["invalid"] as Label).text = str(invalid_count)
	if bulk_summary_status_label == null or not is_instance_valid(bulk_summary_status_label):
		return
	if rows.is_empty() and errors.is_empty():
		bulk_summary_status_label.text = "Cole os dados ou escolha um arquivo para analisar."
		bulk_summary_status_label.add_theme_color_override("font_color", BLUE_DARK)
		if bulk_summary_status_panel != null:
			bulk_summary_status_panel.add_theme_stylebox_override("panel", _style_box(Color("#eef6fd"), Color("#d3e5f4"), 1, 9))
	elif not conflicts.is_empty():
		bulk_summary_status_label.text = "%d conflito(s) detectado(s). Revise antes de limpar ou salvar." % conflicts.size()
		bulk_summary_status_label.add_theme_color_override("font_color", RED)
		if bulk_summary_status_panel != null:
			bulk_summary_status_panel.add_theme_stylebox_override("panel", _style_box(Color("#fff4f4"), Color("#f0b8b8"), 1, 9))
	elif invalid_count > 0:
		bulk_summary_status_label.text = "%d registro(s) precisam de revisao antes de salvar." % invalid_count
		bulk_summary_status_label.add_theme_color_override("font_color", ORANGE)
		if bulk_summary_status_panel != null:
			bulk_summary_status_panel.add_theme_stylebox_override("panel", _style_box(Color("#fff8e8"), Color("#f5d89c"), 1, 9))
	else:
		bulk_summary_status_label.text = "Dados organizados e prontos para salvar."
		bulk_summary_status_label.add_theme_color_override("font_color", GREEN)
		if bulk_summary_status_panel != null:
			bulk_summary_status_panel.add_theme_stylebox_override("panel", _style_box(Color("#eefaf4"), Color("#c7ead7"), 1, 9))


func _bulk_clean_rows_to_text(rows: Array) -> String:
	var lines: Array[String] = []
	for row_value in rows:
		if typeof(row_value) != TYPE_DICTIONARY:
			continue
		var row := row_value as Dictionary
		lines.append("%s\t%s" % [str(row.get("plate", "")), str(row.get("serial", ""))])
	return "\n".join(lines)


func _render_bulk_preview(rows: Array, parse_errors: Array, review_errors: Array) -> void:
	if bulk_preview_body == null:
		return

	for child in bulk_preview_body.get_children():
		bulk_preview_body.remove_child(child)
		child.queue_free()

	var serial_counts := {}
	var plate_counts := {}
	for row in rows:
		var serial := str(row.get("serial", "")).strip_edges().to_upper()
		var plate := str(row.get("plate", "")).strip_edges().to_upper()
		if serial != "":
			serial_counts[serial] = int(serial_counts.get(serial, 0)) + 1
		if plate != "":
			plate_counts[plate] = int(plate_counts.get(plate, 0)) + 1

	var ready_count := 0
	var review_count := 0
	for row in rows:
		var issue := _bulk_preview_issue(row, serial_counts, plate_counts)
		if issue == "":
			ready_count += 1
		else:
			review_count += 1
		bulk_preview_body.add_child(_make_bulk_preview_row(row, issue))

	for error in parse_errors:
		bulk_preview_body.add_child(_make_bulk_preview_message(str(error), false))

	if rows.is_empty() and parse_errors.is_empty():
		bulk_preview_body.add_child(_make_bulk_preview_empty())

	if bulk_preview_count_label:
		bulk_preview_count_label.text = "%d pronto(s)" % ready_count
		var count_ok := ready_count > 0 and review_count == 0 and parse_errors.is_empty()
		bulk_preview_count_label.add_theme_color_override("font_color", GREEN if count_ok else BLUE_DARK)
		bulk_preview_count_label.add_theme_stylebox_override(
			"normal",
			_style_box(Color("#e9f9f1") if count_ok else Color("#e8f3ff"), Color("#bfe8d3") if count_ok else Color("#cfe7fb"), 1, 17)
		)

	if bulk_preview_status_label:
		if rows.is_empty() and parse_errors.is_empty():
			bulk_preview_status_label.text = "Dados limpos e organizados para importação."
			bulk_preview_status_label.add_theme_color_override("font_color", MUTED)
		elif review_count > 0 or not parse_errors.is_empty() or not review_errors.is_empty():
			bulk_preview_status_label.text = "%d item(ns) precisam de revisao" % maxi(review_count, review_errors.size())
			bulk_preview_status_label.add_theme_color_override("font_color", RED)
		else:
			bulk_preview_status_label.text = "Dados limpos e organizados para importação."
			bulk_preview_status_label.add_theme_color_override("font_color", MUTED)


func _bulk_preview_rows_are_delete(rows: Array) -> bool:
	for row in rows:
		if typeof(row) == TYPE_DICTIONARY and str((row as Dictionary).get("mode", "")) == "delete":
			return true
	return false


func _bulk_preview_issue(row: Dictionary, serial_counts: Dictionary, plate_counts: Dictionary) -> String:
	var serial := str(row.get("serial", "")).strip_edges().to_upper()
	var plate := str(row.get("plate", "")).strip_edges().to_upper()
	if serial == "":
		return "Sem numero de serie"
	if int(serial_counts.get(serial, 0)) > 1:
		return "Numero duplicado"
	if plate != "" and int(plate_counts.get(plate, 0)) > 1:
		return "Placa duplicada"
	if store != null:
		var product := {
			"sku": serial,
			"imei": serial,
			"model": str(row.get("model", "")),
			"operator": _selected_bulk_operator(),
			"plate": plate,
		}
		var duplicate := store.find_duplicate_product(product, serial)
		if not duplicate.is_empty():
			return "%s ja existe" % str(duplicate.get("field", "Dado"))
	return ""


