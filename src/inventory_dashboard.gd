func _refresh_maintenance_pager(total_count: int, page_count: int, start_index: int, end_index: int) -> void:
	if maintenance_pager == null or not is_instance_valid(maintenance_pager):
		return
	if maintenance_page_info_label:
		maintenance_page_info_label.text = "Nenhum registro" if total_count <= 0 else "Mostrando %d-%d de %d manutencoes" % [start_index + 1, end_index, total_count]
	var next_signature := "%d|%d|%d|%d|%d" % [
		total_count,
		page_count,
		start_index,
		end_index,
		maintenance_current_page,
	]
	if maintenance_pager_signature == next_signature:
		return
	maintenance_pager_signature = next_signature
	for index in range(maintenance_pager.get_child_count() - 1, 0, -1):
		var child := maintenance_pager.get_child(index)
		maintenance_pager.remove_child(child)
		child.queue_free()
	if page_count <= 1:
		return

	maintenance_pager.add_child(_make_page_button("<", maintenance_current_page > 0, Callable(self, "_change_maintenance_page").bind(-1), false))
	for page_index in _visible_page_indexes_for(page_count, maintenance_current_page):
		if page_index < 0:
			maintenance_pager.add_child(_make_page_gap())
			continue
		maintenance_pager.add_child(_make_page_button(
			str(page_index + 1),
			page_index != maintenance_current_page,
			Callable(self, "_set_maintenance_page").bind(page_index),
			page_index == maintenance_current_page
		))
	maintenance_pager.add_child(_make_page_button("Proximo", maintenance_current_page < page_count - 1, Callable(self, "_change_maintenance_page").bind(1), false))


func _refresh_maintenance_done_rows() -> void:
	if maintenance_done_body == null:
		return
	for child in maintenance_done_body.get_children():
		maintenance_done_body.remove_child(child)
		child.queue_free()

	var query := maintenance_done_search_input.text if maintenance_done_search_input else ""
	var rows := store.get_scheduled_maintenances(query)
	if rows.is_empty():
		var empty := Label.new()
		empty.text = "Nenhuma manutencao OK encontrada."
		empty.custom_minimum_size = Vector2(0, 58)
		empty.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		empty.add_theme_color_override("font_color", MUTED)
		maintenance_done_body.add_child(empty)
