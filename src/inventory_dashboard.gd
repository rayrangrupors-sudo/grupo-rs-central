func _attempt_login() -> void:
	var login := login_user_input.text.strip_edges() if login_user_input else ""
	var password := login_password_input.text.strip_edges() if login_password_input else ""
	if _validate_login(login, password):
		_update_remembered_login(login)
		_open_selected_branch()
		return
	if login_error_label:
		login_error_label.text = "Login ou senha incorretos."
	if login_password_input:
		login_password_input.clear()
		login_password_input.grab_focus()


func _validate_login(login: String, password: String) -> bool:
	var auth := _load_auth_config()
	var auth_module := _app_module("auth")
	if auth_module != null:
		return bool(auth_module.call("validate", login, password, auth))
	var expected_user := str(auth.get("user", "")).strip_edges()
	var salt := str(auth.get("salt", "")).strip_edges()
	var expected_hash := str(auth.get("password_hash", "")).strip_edges()
	if expected_user == "" or salt == "" or expected_hash == "":
		return false
	return login == expected_user and _password_hash(password, salt) == expected_hash


func _load_auth_config() -> Dictionary:
	var config := _read_json_dictionary(AUTH_CONFIG_PATH)
	if _auth_config_is_valid(config):
		return config

	config = {
		"user": DEFAULT_AUTH_USER,
		"salt": DEFAULT_AUTH_SALT,
		"password_hash": DEFAULT_AUTH_PASSWORD_HASH,
		"version": 1,
	}
	_write_json_dictionary(AUTH_CONFIG_PATH, config)
	return config


func _auth_config_is_valid(config: Dictionary) -> bool:
	return str(config.get("user", "")).strip_edges() != "" \
		and str(config.get("salt", "")).strip_edges() != "" \
		and str(config.get("password_hash", "")).strip_edges() != ""


func _password_hash(password: String, salt: String) -> String:
	var auth_module := _app_module("auth")
	if auth_module != null:
		return str(auth_module.call("password_hash", password, salt))
	return ("%s:%s" % [salt, password]).sha256_text()


func _remembered_login() -> String:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	return str(settings.get("remembered_login", "")).strip_edges()


func _update_remembered_login(login: String) -> void:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	settings["remembered_login"] = login if remember_user_check != null and remember_user_check.button_pressed else ""
	_write_json_dictionary(SETTINGS_PATH, settings)


func _read_json_dictionary(path: String) -> Dictionary:
	var result := _read_json_dictionary_raw(path)
	if path != SETTINGS_PATH:
		return result
	var vault := _secret_vault()
	if vault == null:
		return result
	var sanitized: Dictionary = vault.call(
		"extract_secrets",
		"app",
		result,
		SecretVaultScript.APP_SECRET_KEYS
	)
	if sanitized != result:
		_write_json_dictionary_raw(path, sanitized)
	return vault.call(
		"merge_secrets",
		"app",
		sanitized,
		SecretVaultScript.APP_SECRET_KEYS
	)


func _read_json_dictionary_raw(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		return {}
	var text_value := file.get_as_text()
	if text_value.strip_edges() == "":
		return {}
	var parsed: Variant = JSON.parse_string(text_value)
	if typeof(parsed) != TYPE_DICTIONARY:
		return {}
	return parsed


func _write_json_dictionary(path: String, value: Dictionary) -> bool:
	var stored_value := value.duplicate(true)
	if path == SETTINGS_PATH:
		var vault := _secret_vault()
		if vault != null:
			stored_value = vault.call(
				"extract_secrets",
				"app",
				stored_value,
				SecretVaultScript.APP_SECRET_KEYS
			)
	return _write_json_dictionary_raw(path, stored_value)


func _write_json_dictionary_raw(path: String, value: Dictionary) -> bool:
	var temp_path := "%s.tmp" % path
	var file := FileAccess.open(temp_path, FileAccess.WRITE)
	if file == null:
		return false
	file.store_string(JSON.stringify(value, "\t"))
	file.flush()
	file = null
	var absolute_path := ProjectSettings.globalize_path(path)
	var absolute_temp_path := ProjectSettings.globalize_path(temp_path)
	if FileAccess.file_exists(path):
		DirAccess.remove_absolute(absolute_path)
	var rename_error := DirAccess.rename_absolute(absolute_temp_path, absolute_path)
	if rename_error == OK:
		return true
	var fallback := FileAccess.open(path, FileAccess.WRITE)
	if fallback == null:
		return false
	fallback.store_string(JSON.stringify(value, "\t"))
	fallback.flush()
	fallback = null
	DirAccess.remove_absolute(absolute_temp_path)
	return true


func _secret_vault() -> Node:
	var tree := get_tree()
	if tree == null:
		return null
	var vault := tree.root.get_node_or_null("SecretVault")
	if vault != null:
		return vault
	vault = SecretVaultScript.new()
	vault.name = "SecretVault"
	tree.root.add_child(vault)
	return vault


func _remove_app_vault_secrets(keys: PackedStringArray) -> void:
	var vault := _secret_vault()
	if vault != null:
		vault.call("remove_secrets", "app", keys)


func _register_integrations_credentials_log() -> void:
	if store == null:
		return
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var saved_at := str(settings.get("integrations_credentials_saved_at", "")).strip_edges()
	if saved_at == "":
		return

	var configured: Array[String] = []
	if str(settings.get("grupo_rs_modern_user", "")).strip_edges() != "" and str(settings.get("grupo_rs_modern_password", "")) != "":
		configured.append("Grupo RS novo")
	if str(settings.get("grupo_rs_legacy_user", "")).strip_edges() != "" and str(settings.get("grupo_rs_legacy_password", "")) != "":
		configured.append("Grupo RS antigo")
	for config in _branch_configs():
		var branch_id := str(config.get("id", "")).strip_edges().to_lower()
		if str(config.get("grupo_rs_mode", "")) != "legacy":
			continue
		var branch_user := str(settings.get(_legacy_branch_setting_key(branch_id, "user"), "")).strip_edges()
		var branch_password := str(settings.get(_legacy_branch_setting_key(branch_id, "password"), ""))
		if branch_user != "" and branch_password != "":
			configured.append("Grupo RS %s" % str(config.get("name", branch_id)).capitalize())
	if str(settings.get("arya_email", "")).strip_edges() != "" and str(settings.get("arya_password", "")) != "":
		configured.append("Arya")
	if str(settings.get("linksolutions_email", "")).strip_edges() != "" and str(settings.get("linksolutions_password", "")) != "":
		configured.append("Link Solutions")
	for source in [SGA_SOURCE_RASTREIO, SGA_SOURCE_PROTECAO]:
		if str(settings.get(_sga_setting_key(source, "api_token"), "")).strip_edges() != "" \
			and str(settings.get(_sga_setting_key(source, "user"), "")).strip_edges() != "" \
			and str(settings.get(_sga_setting_key(source, "password"), "")) != "":
			configured.append("SGA %s" % _sga_source_label(source))
	if configured.is_empty():
		return

	for log_entry in store.get_system_logs(0):
		if str(log_entry.get("action", "")) == "Credenciais configuradas" and str(log_entry.get("details", "")).contains(saved_at):
			settings["integrations_credentials_log_recorded_at"] = saved_at
			_write_json_dictionary(SETTINGS_PATH, settings)
			return

	_log_system_action(
		"Credenciais configuradas",
		"%s gravado(s) no cofre criptografado. Senhas ocultas. Ref: %s" % [", ".join(configured), saved_at]
	)
	settings["integrations_credentials_log_recorded_at"] = saved_at
	_write_json_dictionary(SETTINGS_PATH, settings)


func _open_selected_branch() -> void:
	_clear_screen()
	var preview_status: Dictionary = branch_preview_sync_states.get(selected_branch_id, {})
	var reuse_preview := selected_branch_preview_store != null and selected_branch_preview_branch_id == selected_branch_id
	if reuse_preview:
		store = selected_branch_preview_store
	else:
		store = StoreScript.new()
		store.configure(selected_branch_db_path, selected_branch_backup_name, selected_branch_backup_dir, selected_branch_id == "imperatriz")
		store.load_db()
	var firebase_sync := _firebase_sync()
	if firebase_sync != null:
		var status_callable := Callable(self, "_on_firebase_status_changed")
		if not firebase_sync.is_connected("status_changed", status_callable):
			firebase_sync.connect("status_changed", status_callable)
		if not reuse_preview or str(preview_status.get("state", "")) not in ["synced", "online"]:
			firebase_sync.call("bind_store", store, selected_branch_id)
	_register_integrations_credentials_log()
	_build_ui()
	_prepare_startup_animation()
	_setup_cloud_sync_timer()
	_setup_st310_location_poll_timer()
	# A sincronizacao do ExpertTexting pertence ao ciclo normal da base SMS;
	# nao depende do monitor automatico legado, que foi aposentado.
	if _branch_supports_sms():
		_load_sms_panel_history()
		_setup_experttexting_poll()
	_refresh_cloud_status()
	_show_dashboard()
	_play_startup_animation()
