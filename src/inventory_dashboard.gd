func _build_sms_panel_volume_chart(events: Array[Dictionary]) -> Control:
	var panel := PanelContainer.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.add_theme_stylebox_override("panel", _style_box(Color.WHITE, BORDER, 1, 8, true))
	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 14)
	margin.add_theme_constant_override("margin_right", 14)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_bottom", 12)
	panel.add_child(margin)
	var card := _sms_panel_chart("Volume de SMS", BLUE)
	margin.add_child(card)
	var by_day: Dictionary = {}
	for event in events:
		var day := str(event.get("date", ""))
		by_day[day] = int(by_day.get(day, 0)) + 1
	var days := by_day.keys()
	days.sort()
	if days.is_empty():
		card.add_child(_make_empty_log_card("Aguardando os primeiros envios."))
	else:
		for day in days.slice(maxi(0, days.size() - 7), days.size()):
			var row := HBoxContainer.new()
			row.add_child(_make_table_label(_format_monitor_date(str(day)), 70, false, MUTED, HORIZONTAL_ALIGNMENT_LEFT, 12))
			var bar := ProgressBar.new()
			bar.max_value = maxi(1, events.size())
			bar.value = int(by_day.get(day, 0))
			bar.show_percentage = false
			bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			row.add_child(bar)
			row.add_child(_make_table_label(str(by_day.get(day, 0)), 35, true, TEXT, HORIZONTAL_ALIGNMENT_RIGHT, 12))
			card.add_child(row)
	return panel


func _build_sms_panel_status_chart(events: Array[Dictionary]) -> Control:
	var panel := PanelContainer.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.add_theme_stylebox_override("panel", _style_box(Color.WHITE, BORDER, 1, 8, true))
