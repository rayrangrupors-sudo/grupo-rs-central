func _build_auto_reset_daily_cost_chart(logs: Array[Dictionary]) -> Control:
	var panel := PanelContainer.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.size_flags_vertical = Control.SIZE_EXPAND_FILL
	panel.add_theme_stylebox_override("panel", _style_box(Color.WHITE, BORDER, 1, 8, true))
	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 22)
	margin.add_theme_constant_override("margin_right", 22)
	margin.add_theme_constant_override("margin_top", 20)
	margin.add_theme_constant_override("margin_bottom", 20)
	panel.add_child(margin)
	var stack := VBoxContainer.new()
	stack.add_theme_constant_override("separation", 12)
	margin.add_child(stack)
	var title := Label.new()
	title.text = "Ultimos 7 dias"
	title.add_theme_font_override("font", UI_FONT)
	title.add_theme_font_size_override("font_size", 21)
	title.add_theme_color_override("font_color", TEXT)
	stack.add_child(title)
	var counts: Array[int] = []
	var dates: Array[String] = []
	var max_count := 1
	var now := int(Time.get_unix_time_from_system())
	for offset in range(6, -1, -1):
		var date := Time.get_date_string_from_unix_time(now - offset * 86400)
		var day_log_metrics := _auto_reset_log_metrics(_auto_reset_logs_for_prefix(logs, date))
		var day_cost_metrics := _auto_reset_combined_cost_metrics(day_log_metrics, date)
		var count := int(day_cost_metrics.get("count", 0))
		dates.append(date)
		counts.append(count)
		max_count = maxi(max_count, count)
	for index in range(dates.size()):
		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation", 12)
		row.add_child(_make_table_label(_format_monitor_date(str(dates[index])), 115, false, MUTED, HORIZONTAL_ALIGNMENT_LEFT, 14))
		var bar := ProgressBar.new()
		bar.min_value = 0
		bar.max_value = max_count
		bar.value = counts[index]
		bar.show_percentage = false
		bar.custom_minimum_size = Vector2(0, 24)
		bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		bar.add_theme_stylebox_override("background", _style_box(Color("#edf2f7"), Color("#edf2f7"), 0, 5))
		bar.add_theme_stylebox_override("fill", _style_box(BLUE, BLUE, 0, 5))
		row.add_child(bar)
		var display_cost := float(_auto_reset_combined_cost_metrics(_auto_reset_log_metrics(_auto_reset_logs_for_prefix(logs, str(dates[index]))), str(dates[index])).get("cost", 0.0))
		row.add_child(_make_table_label("%d SMS | %s" % [counts[index], _format_monitor_usd(display_cost)], 190, false, TEXT, HORIZONTAL_ALIGNMENT_RIGHT, 14))
		stack.add_child(row)
	return panel


