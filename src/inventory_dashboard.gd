func _status_icon_path(status: String) -> String:
	match _status_key_from_text(status):
		"instalado":
			return ICON_DIR + "status_instalado.svg"
		"reserva":
			return ICON_DIR + "status_reserva.svg"
		"manutencao":
			return ICON_DIR + "status_manutencao.svg"
		"inativo":
			return ICON_DIR + "status_inativo.svg"
		_:
			return ICON_DIR + "status_estoque.svg"


func _toggle_equipment_status(sku: String) -> void:
	var product := store.get_product(sku)
	if product.is_empty():
		return

	var next_status := "Reserva" if _status_key(product) == "inativo" else "Inativo"
	_confirm_action(
		"Alterar status",
		"Deseja realmente alterar o status deste equipamento para %s?" % next_status,
		func():
			if store.set_tracker_status(sku, next_status):
				_log_system_action("Alterou status", "Novo status: %s" % next_status, sku)
				_refresh_table()
				_show_success("Sucesso", "Status alterado com sucesso!")
			else:
				_show_error("Erro", "Nao foi possivel alterar o status.")
	)



func _install_equipment(sku: String, plate_input: LineEdit) -> void:
	var plate := plate_input.text.strip_edges()

	if plate == "":
		_show_warning("Aviso", "Informe a placa antes de dar baixa no aparelho.")
		return

	_confirm_action(
		"Dar baixa",
		"Deseja realmente dar baixa neste equipamento?",
		func():
			if not store.install_tracker(sku, plate):
				_show_error("Erro", "Nao foi possivel dar baixa no aparelho.")
			else:
				table_plate_drafts.erase(sku)
				_log_system_action("Dar baixa", "Instalado na placa %s" % plate.to_upper(), sku)
				_refresh_table()
				_show_success("Sucesso", "Aparelho instalado com sucesso!")
	)



func _send_to_stock(sku: String) -> void:
	_confirm_action(
		"Voltar para estoque",
		"Deseja realmente devolver este equipamento para o estoque?",
		func():
			if not store.set_tracker_status(sku, "Estoque"):
				_show_error("Erro", "Nao foi possivel enviar o aparelho para estoque.")
				return
			_log_system_action("Voltou para estoque", "Status alterado para Estoque", sku)
			_refresh_table()
			_show_success("Sucesso", "Aparelho voltou para o estoque.")
	)


func _show_product_history(sku: String) -> void:
	var product := store.get_product(sku)
	var events := store.get_product_history(sku, 12)
	if product.is_empty() and events.is_empty():
		_show_warning("Historico", "Nenhum historico encontrado para este equipamento.")
		return

	var title := "Historico do equipamento"
	var lines: Array[String] = []
	if not product.is_empty():
		lines.append("Numero: %s" % str(product.get("imei", sku)))
		lines.append("Placa: %s" % _blank(str(product.get("plate", ""))))
		lines.append("Status: %s" % str(product.get("tracker_status", "")))
		lines.append("")

	if events.is_empty():
		lines.append("Sem eventos registrados.")
	else:
		for event in events:
			lines.append("%s | %s | %s" % [
				_format_datetime(str(event.get("timestamp", ""))),
				str(event.get("action", "")),
				_blank(str(event.get("details", "")))
			])

	_show_info("%s\n\n%s" % [title, "\n".join(lines)])


