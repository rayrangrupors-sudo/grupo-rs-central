func _request_save_as_stock_form() -> void:
	# O botao de estoque nunca pode herdar uma associacao veicular marcada no
	# formulario. O pedido e montado imediatamente e o estado visual anterior e
	# restaurado depois, portanto o operador pode continuar editando a tela.
	if form_associate_vehicle_toggle == null or not is_instance_valid(form_associate_vehicle_toggle):
		_request_save_form()
		return
	var previous := form_associate_vehicle_toggle.button_pressed
	form_associate_vehicle_toggle.button_pressed = false
	_request_save_form()
	form_associate_vehicle_toggle.button_pressed = previous


