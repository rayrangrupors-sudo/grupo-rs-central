func _set_content(control: Control, allow_offline: bool = false) -> void:
	if not is_instance_valid(content_area):
		return
	var navigation_id := _begin_content_navigation()
	var firebase_required := _section_requires_firebase(current_section)
	current_content_allows_offline = allow_offline or not firebase_required
	if store != null and not online_data_available and firebase_required and not allow_offline:
		control.queue_free()
		control = _build_online_unavailable_view()
		online_unavailable_visible = true
	else:
		online_unavailable_visible = false
	_replace_content_area(control, navigation_id)


func _show_online_unavailable_view(state: String = "offline", detail: String = "") -> void:
	if content_area == null or current_content_allows_offline:
		return
	online_unavailable_visible = true
	_set_content_margins(120, 70, 120, 70)
	var view := _build_online_unavailable_view(state, detail)
	_replace_content_area(view, _begin_content_navigation())


func _begin_content_navigation() -> int:
	# Este e o unico contador usado por telas de conteudo. Ao trocar de aba,
	# qualquer callback que tenha capturado o token anterior fica obsoleto.
	content_navigation_generation += 1
	page_transition_id = content_navigation_generation
	active_content_section = current_section
	return page_transition_id


func _is_current_content_navigation(navigation_id: int) -> bool:
	return navigation_id == page_transition_id and active_content_section == current_section and is_instance_valid(content_area)


func _replace_content_area(control: Control, navigation_id: int) -> void:
	if not is_instance_valid(content_area) or control == null:
		if control != null:
			control.queue_free()
		return
	# Preserva todo o shell da aplicacao; somente este host e alterado.
	for child in content_area.get_children():
		content_area.remove_child(child)
		child.queue_free()
	control.set_meta("content_navigation_generation", navigation_id)
	content_area.add_child(control)
	_animate_content_in(control)


func _build_online_unavailable_view(state: String = "offline", detail: String = "") -> Control:
	var center := CenterContainer.new()
	center.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	center.size_flags_vertical = Control.SIZE_EXPAND_FILL

	var panel := PanelContainer.new()
	panel.custom_minimum_size = Vector2(620, 380)
	panel.add_theme_stylebox_override("panel", _style_box(Color.WHITE, Color("#f0b7b7"), 1, 8, true))
	center.add_child(panel)

	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 46)
	margin.add_theme_constant_override("margin_right", 46)
	margin.add_theme_constant_override("margin_top", 38)
	margin.add_theme_constant_override("margin_bottom", 38)
	panel.add_child(margin)

	var stack := VBoxContainer.new()
	stack.alignment = BoxContainer.ALIGNMENT_CENTER
	stack.add_theme_constant_override("separation", 16)
	margin.add_child(stack)

	var icon := TextureRect.new()
	icon.texture = load(ICON_DIR + "sem_internet.svg")
	icon.custom_minimum_size = Vector2(88, 88)
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	stack.add_child(icon)

	var title := Label.new()
	title.text = "Sem internet" if state == "offline" else "Dados online indisponiveis"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_override("font", UI_FONT)
	title.add_theme_font_size_override("font_size", 30)
	title.add_theme_color_override("font_color", RED)
	stack.add_child(title)

	var message := Label.new()
	message.text = detail if detail.strip_edges() != "" else "Nao foi possivel acessar o Firebase."
	message.text += "\nOs cadastros ficam ocultos e nenhuma alteracao e salva ate a conexao voltar."
	message.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	message.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	message.custom_minimum_size = Vector2(500, 70)
	message.add_theme_font_override("font", UI_FONT)
	message.add_theme_font_size_override("font_size", 17)
	message.add_theme_color_override("font_color", MUTED)
	stack.add_child(message)

	var actions := HBoxContainer.new()
	actions.alignment = BoxContainer.ALIGNMENT_CENTER
	actions.add_theme_constant_override("separation", 10)
	stack.add_child(actions)
	actions.add_child(_make_action_button("Tentar novamente", BLUE, BLUE, Color.WHITE, Vector2(190, 46), _retry_online_connection))
	actions.add_child(_make_action_button("Configurar servidor", Color("#6c7f91"), Color("#6c7f91"), Color.WHITE, Vector2(200, 46), _show_firebase_config))
