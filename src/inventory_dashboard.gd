func _parse_bulk_client_names(raw_text: String) -> Dictionary:
	var names: Array[String] = []
	var invalid: Array[String] = []
	var seen := {}
	var normalized_text := raw_text.replace("\r\n", "\n").replace("\r", "\n")
	var letter_regex := RegEx.new()
	letter_regex.compile("(?i)[a-záàãâéêíóõôúç]")

	for raw_line in normalized_text.split("\n"):
		var line := str(raw_line).strip_edges()
		if line == "":
			continue
		var first_cell := line.split("\t", false, 1)[0].strip_edges()
		var name := " ".join(first_cell.replace("\t", " ").split(" ", false)).strip_edges()
		var key := _search_key(name)
		if ["cliente", "clientes", "nome", "nomedocliente", "consultaporcliente", "consultadeclientes"].has(key):
			continue
		if name.length() < 3 or key == "" or letter_regex.search(name) == null:
			invalid.append(line)
			continue
		if seen.has(key):
			continue
		seen[key] = true
		names.append(name)

	return {"names": names, "invalid": invalid}


func _run_bulk_client_tracker_lookup(names: Array[String], invalid_count: int = 0) -> void:
	var results: Array[Dictionary] = []
	var found_count := 0
	for index in range(names.size()):
		var name := names[index]
		_show_bulk_result("Consultando cliente %d/%d no Grupo RS: %s" % [index + 1, names.size(), name], true)
		var rows := await _fetch_grupo_rs_equipment_rows(name)
		var result := _build_bulk_client_tracker_result(name, rows)
		results.append(result)
		if bool(result.get("ok", false)):
			found_count += 1

	bulk_client_lookup_running = false
	bulk_client_lookup_results = results
	bulk_client_lookup_current_page = 0
	var missing_count := results.size() - found_count
	var summary := "Consulta finalizada. Clientes: %d | Com rastreador: %d | Sem correspondencia: %d" % [results.size(), found_count, missing_count]
	if invalid_count > 0:
		summary += " | Linhas ignoradas: %d" % invalid_count
	_show_bulk_result(summary, true)
	_log_system_action("Consulta em massa por cliente", summary)
	_show_bulk_client_lookup_report(results, "trackers", names.size())


func _run_bulk_client_sga_lookup(names: Array[String], invalid_count: int = 0) -> void:
	var results: Array[Dictionary] = []
	var rastreio_found := 0
	var protecao_found := 0
	for index in range(names.size()):
		var name := names[index]
		_show_bulk_result(
			"Consultando cliente %d/%d nos dois SGA: %s" % [index + 1, names.size(), name],
			true
		)
		var lookup := await _lookup_sga_status_by_customer(name)
		var result := _build_bulk_client_sga_result(name, lookup)
		results.append(result)
		if bool((result.get(SGA_SOURCE_RASTREIO, {}) as Dictionary).get("ok", false)):
			rastreio_found += 1
		if bool((result.get(SGA_SOURCE_PROTECAO, {}) as Dictionary).get("ok", false)):
			protecao_found += 1

	bulk_client_lookup_running = false
	bulk_client_lookup_results = results
	bulk_client_lookup_current_page = 0
	var summary := "Consulta SGA finalizada. Clientes: %d | Rastreio: %d | Protecao: %d" % [
		results.size(),
		rastreio_found,
		protecao_found,
	]
	if invalid_count > 0:
		summary += " | Linhas ignoradas: %d" % invalid_count
	_show_bulk_result(summary, true)
	_log_system_action("Consulta em massa nos SGA", summary)
	_show_bulk_client_lookup_report(results, "sga", names.size())


func _run_bulk_client_maintenance_lookup(names: Array[String], invalid_count: int = 0) -> void:
	_show_bulk_result("Consultando a lista Manutencao do Grupo RS para %d cliente(s)..." % names.size(), true)
	var fetched := await _fetch_grupo_rs_maintenance_rows_with_status(false)
	var succeeded_intervals: Array = fetched.get("succeeded_intervals", [])
	var maintenance_source_ok := false
	for interval_name in succeeded_intervals:
		if _auto_reset_text_key(str(interval_name)) == "manutencao":
			maintenance_source_ok = true
			break
	if succeeded_intervals.is_empty() and bool(fetched.get("complete", false)):
		maintenance_source_ok = true

	if not maintenance_source_ok:
		bulk_client_lookup_running = false
		var error_message := "A lista Manutencao do Grupo RS nao respondeu. Nenhum resultado foi considerado."
		var source_message := str(fetched.get("message", "")).strip_edges()
		if source_message != "":
			error_message += "\n" + source_message
		_show_bulk_result(error_message, false)
		_show_error("Consulta de manutencao", error_message)
		return

	var maintenance_rows: Array[Dictionary] = []
	var raw_rows: Variant = fetched.get("rows", [])
	if typeof(raw_rows) == TYPE_ARRAY:
		for value in raw_rows:
			if typeof(value) != TYPE_DICTIONARY:
				continue
			var row := value as Dictionary
			if _auto_reset_is_platform_maintenance(row):
				maintenance_rows.append(row)

	var results: Array[Dictionary] = []
	var seen := {}
	for input_name in names:
		var matched := _match_bulk_client_rows(input_name, maintenance_rows)
		var selected_rows: Array = matched.get("rows", [])
		if str(matched.get("state", "")) not in ["exact", "approximate"]:
			continue
		for value in selected_rows:
			if typeof(value) != TYPE_DICTIONARY:
				continue
			var row := value as Dictionary
			var client_name := str(row.get("client", input_name)).strip_edges()
			var plate := str(row.get("plate", "")).strip_edges().to_upper()
			var serial := str(row.get("serial", "")).strip_edges()
			var result_key := "%s|%s|%s" % [_search_key(client_name), _normalize_location_plate(plate), _search_key(serial)]
			if seen.has(result_key):
				continue
			seen[result_key] = true
			results.append({
				"input_name": client_name if client_name != "" else input_name,
				"matched_name": client_name,
				"plate_text": plate,
				"serial_text": serial,
				"status": "Em manutencao",
				"ok": true,
			})

	bulk_client_lookup_running = false
	bulk_client_lookup_results = results
	bulk_client_lookup_current_page = 0
	var summary := "Consulta finalizada. Nomes consultados: %d | Entraram em manutencao: %d" % [names.size(), results.size()]
	if invalid_count > 0:
		summary += " | Linhas ignoradas: %d" % invalid_count
	_show_bulk_result(summary, true)
	_log_system_action("Consulta em massa de manutencao", summary)
	_show_bulk_client_lookup_report(results, "maintenance", names.size())


func _match_bulk_client_rows(input_name: String, rows: Array[Dictionary]) -> Dictionary:
	var target_key := _search_key(input_name)
	var exact_rows: Array[Dictionary] = []
	var approximate_by_client := {}
	for row in rows:
		var client_name := str(row.get("client", "")).strip_edges()
		var client_key := _search_key(client_name)
		if client_key == "":
			continue
		if client_key == target_key:
			exact_rows.append(row)
		elif client_key.contains(target_key) or target_key.contains(client_key):
			if not approximate_by_client.has(client_key):
				approximate_by_client[client_key] = []
			var similar_rows: Array = approximate_by_client[client_key]
			similar_rows.append(row)
			approximate_by_client[client_key] = similar_rows

	if not exact_rows.is_empty():
		return {"state": "exact", "rows": exact_rows}
	if approximate_by_client.size() == 1:
		var selected: Array[Dictionary] = []
		var only_key := str(approximate_by_client.keys()[0])
		for value in approximate_by_client.get(only_key, []):
			if typeof(value) == TYPE_DICTIONARY:
				selected.append(value as Dictionary)
		return {"state": "approximate", "rows": selected}
	if approximate_by_client.size() > 1:
		return {"state": "ambiguous", "rows": []}
	return {"state": "not_found", "rows": []}


func _build_bulk_client_tracker_result(input_name: String, rows: Array[Dictionary]) -> Dictionary:
	var matched := _match_bulk_client_rows(input_name, rows)
	var match_state := str(matched.get("state", "not_found"))
	var selected_rows: Array[Dictionary] = []
	for value in matched.get("rows", []):
		if typeof(value) == TYPE_DICTIONARY:
			selected_rows.append(value as Dictionary)
	if match_state == "ambiguous":
		return {
			"input_name": input_name,
			"matched_name": "",
			"serials": [],
			"serial_text": "",
			"status": "Nome ambiguo",
			"ok": false,
		}

	if selected_rows.is_empty():
		return {
			"input_name": input_name,
			"matched_name": "",
			"serials": [],
			"serial_text": "",
			"status": "Nao encontrado",
			"ok": false,
		}

	var serials: Array[String] = []
	var seen_serials := {}
	var matched_name := ""
	for row in selected_rows:
		if matched_name == "":
			matched_name = str(row.get("client", "")).strip_edges()
		var serial := str(row.get("serial", "")).strip_edges()
		var serial_key := _search_key(serial)
		if serial == "" or seen_serials.has(serial_key):
			continue
		seen_serials[serial_key] = true
		serials.append(serial)

	if serials.is_empty():
		return {
			"input_name": input_name,
			"matched_name": matched_name,
			"serials": serials,
			"serial_text": "",
			"status": "Sem numero vinculado",
			"ok": false,
		}

	var status := "Nome aproximado" if match_state == "approximate" else ("%d aparelhos" % serials.size() if serials.size() > 1 else "Encontrado")
	return {
		"input_name": input_name,
		"matched_name": matched_name,
		"serials": serials,
		"serial_text": ", ".join(serials),
		"status": status,
		"ok": true,
	}


func _build_bulk_client_sga_result(input_name: String, lookup: Dictionary) -> Dictionary:
	var rastreio: Dictionary = lookup.get(SGA_SOURCE_RASTREIO, {})
	var protecao: Dictionary = lookup.get(SGA_SOURCE_PROTECAO, {})
	var matched_name := str(lookup.get("client", input_name)).strip_edges()
	for source_result in [rastreio, protecao]:
		var candidate_name := str((source_result as Dictionary).get("customer_name", "")).strip_edges()
		if candidate_name != "":
			matched_name = candidate_name
			break
	var rastreio_ok := bool(rastreio.get("ok", false))
	var protecao_ok := bool(protecao.get("ok", false))
	var status := "Encontrado nos dois SGA"
	if rastreio_ok != protecao_ok:
		status = "Retorno parcial"
	elif not rastreio_ok and not protecao_ok:
		status = "Sem correspondencia"
	return {
		"input_name": input_name,
		"matched_name": matched_name,
		SGA_SOURCE_RASTREIO: rastreio,
		SGA_SOURCE_PROTECAO: protecao,
		"sga_rastreio_text": _bulk_sga_result_text(SGA_SOURCE_RASTREIO, rastreio),
		"sga_protecao_text": _bulk_sga_result_text(SGA_SOURCE_PROTECAO, protecao),
		"status": status,
		"ok": rastreio_ok or protecao_ok,
	}


func _bulk_sga_result_text(source: String, result: Dictionary) -> String:
	var prefix := "%s: " % _sga_source_label(source)
	return _sga_result_text(source, result).trim_prefix(prefix)


