func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var app_theme := Theme.new()
	app_theme.default_font = UI_FONT
	app_theme.default_font_size = 18
	app_theme.set_constant("icon_max_width", "Button", 22)
	theme = app_theme
	_show_branch_selector()
	await get_tree().process_frame
	await _play_rs_intro()
	var update_bootstrap := _update_bootstrap()
	if update_bootstrap != null:
		update_bootstrap.call("mark_boot_success")

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("EXIT"):
		_request_exit()
	elif event.is_action_pressed("minimizar"):
		_minimize_window()
		get_viewport().set_input_as_handled()
	elif event is InputEventKey:
		var key_event := event as InputEventKey
		if key_event.pressed and not key_event.echo and key_event.ctrl_pressed:
			if content_area == null:
				return
			match key_event.keycode:
				KEY_N:
					_show_form("")
					get_viewport().set_input_as_handled()
				KEY_F:
					_show_list()
					await get_tree().process_frame
					if search_input:
						search_input.grab_focus()
						search_input.select_all()
					get_viewport().set_input_as_handled()
				KEY_E:
					_edit_first_visible_product()
					get_viewport().set_input_as_handled()


