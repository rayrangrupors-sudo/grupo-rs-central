func _guardian_status_title(status: String) -> String:
	match status:
		"ok":
			return "Sistema normal"
		"recovered":
			return "Correcao concluida"
		"checking":
			return "Verificando agora"
		"warning":
			return "Em observacao"
		"error":
			return "Atencao necessaria"
		"paused":
			return "Assistente pausado"
		"info":
			return "Informativo"
	return "Aguardando verificacao"


func _guardian_status_short(status: String) -> String:
	match status:
		"ok":
			return "NORMAL"
		"recovered":
			return "RECUPERADO"
		"error":
			return "FALHA"
		"warning":
			return "ALERTA"
		"info":
			return "INFO"
		"checking":
			return "ANALISANDO"
	return "AGUARDANDO"


func _guardian_automation_text(component: Dictionary) -> String:
	var automation := str(component.get("automation", ""))
	var message := str(component.get("automation_message", "")).strip_edges()
	match automation:
		"repaired":
			return "Correcao segura aplicada"
		"observing":
			return "Confirmando antes de agir"
		"cooldown":
			return "Protecao de repeticao ativa"
		"blocked":
			return "Acao bloqueada: %s" % message
		"failed":
			return "Nao foi possivel corrigir: %s" % message
	return message


func _guardian_last_run_text(snapshot: Dictionary) -> String:
	var unix_time := int(snapshot.get("last_run_at", 0))
	if unix_time <= 0:
		return "Pendente"
	var datetime := Time.get_datetime_dict_from_unix_time(unix_time)
	return "%02d/%02d %02d:%02d" % [
		int(datetime.get("day", 0)),
		int(datetime.get("month", 0)),
		int(datetime.get("hour", 0)),
		int(datetime.get("minute", 0)),
	]


