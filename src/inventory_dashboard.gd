func _make_dashboard_alert_filter_button(filter_key: String, label_text: String) -> Button:
	var button := Button.new()
	button.text = label_text
	button.custom_minimum_size = Vector2(82 if filter_key != "informational" else 108, 30)
	button.focus_mode = Control.FOCUS_NONE
	button.add_theme_font_override("font", UI_FONT)
	button.add_theme_font_size_override("font_size", 11)
	button.pressed.connect(func(): _set_dashboard_alert_filter(filter_key))
	dashboard_alert_filter_buttons[filter_key] = button
	_style_dashboard_alert_filter_button(button, filter_key == dashboard_alert_filter)
	return button


func _style_dashboard_alert_filter_button(button: Button, active: bool) -> void:
	if button == null or not is_instance_valid(button):
		return
	button.add_theme_stylebox_override("normal", _style_box(BLUE if active else Color("#f8fbff"), BLUE if active else Color("#d7e4ef"), 1, 14))
	button.add_theme_stylebox_override("hover", _style_box(Color("#eaf5ff"), BLUE, 1, 14))
	button.add_theme_color_override("font_color", Color.WHITE if active else BLUE_DARK)


func _set_dashboard_alert_filter(filter_key: String) -> void:
	dashboard_alert_filter = filter_key
	for key in dashboard_alert_filter_buttons:
		_style_dashboard_alert_filter_button(dashboard_alert_filter_buttons[key], str(key) == filter_key)
	_refresh_dashboard_alerts()


func _mark_dashboard_alerts_read() -> void:
	dashboard_alerts_marked_read = true
	_refresh_dashboard_alerts()


func _refresh_dashboard_alerts() -> void:
	if dashboard_alert_body == null or not is_instance_valid(dashboard_alert_body):
		return
	for child in dashboard_alert_body.get_children():
		dashboard_alert_body.remove_child(child)
		child.queue_free()
	var visible_items: Array[Dictionary] = []
	if not dashboard_alerts_marked_read:
		for item in dashboard_diagnostics:
			if _dashboard_alert_matches_filter(item, dashboard_alert_filter):
				visible_items.append(item)
	if dashboard_alert_count_label != null and is_instance_valid(dashboard_alert_count_label):
		dashboard_alert_count_label.text = "%d pendencia(s)" % visible_items.size()
		dashboard_alert_count_label.add_theme_color_override("font_color", RED if not visible_items.is_empty() else GREEN)
	if visible_items.is_empty():
		var empty_panel := PanelContainer.new()
		empty_panel.custom_minimum_size = Vector2(0, 42)
		empty_panel.add_theme_stylebox_override("panel", _style_box(Color("#f8fcfa"), Color("#d7eee1"), 1, 8))
		var empty := Label.new()
		empty.text = "Nenhuma inconsistencia encontrada nos cadastros." if not dashboard_alerts_marked_read else "Todos os alertas atuais foram marcados como lidos."
		empty.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		empty.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		empty.add_theme_font_size_override("font_size", 13)
		empty.add_theme_color_override("font_color", GREEN)
		empty_panel.add_child(empty)
		dashboard_alert_body.add_child(empty_panel)
		return
	var shown := mini(visible_items.size(), 4)
	for index in range(shown):
		var item: Dictionary = visible_items[index]
		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation", 8)
		var dot := Label.new()
		dot.text = "●"
		dot.add_theme_font_size_override("font_size", 11)
		dot.add_theme_color_override("font_color", _dashboard_alert_severity_color(str(item.get("severity", ""))))
		row.add_child(dot)
		var text_label := Label.new()
		text_label.text = "%s  ·  %s" % [str(item.get("sku", "")), str(item.get("details", ""))]
		text_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		text_label.clip_text = true
		text_label.add_theme_font_size_override("font_size", 12)
		text_label.add_theme_color_override("font_color", TEXT)
		row.add_child(text_label)
		dashboard_alert_body.add_child(row)
	if visible_items.size() > shown:
		var more := Label.new()
		more.text = "Mais %d alerta(s). Abra o historico para revisar todos." % (visible_items.size() - shown)
		more.add_theme_font_size_override("font_size", 11)
		more.add_theme_color_override("font_color", MUTED)
		dashboard_alert_body.add_child(more)


func _dashboard_alert_matches_filter(item: Dictionary, filter_key: String) -> bool:
	if filter_key == "all":
		return true
	var severity := _search_key(str(item.get("severity", "")))
	if filter_key == "critical":
		return severity in ["alto", "critico", "critical"]
	if filter_key == "warning":
		return severity in ["medio", "aviso", "warning", "atencao"]
	return severity not in ["alto", "critico", "critical", "medio", "aviso", "warning", "atencao"]


func _dashboard_alert_severity_color(severity: String) -> Color:
	var normalized := _search_key(severity)
	if normalized in ["alto", "critico", "critical"]:
		return RED
	if normalized in ["medio", "aviso", "warning", "atencao"]:
		return ORANGE
	return BLUE


