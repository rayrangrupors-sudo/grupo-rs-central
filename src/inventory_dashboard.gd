	badge.add_theme_stylebox_override("normal", _style_box(GREEN if ok else RED, GREEN if ok else RED, 0, 14))
	row.add_child(badge)

	row.add_child(_make_preview_cell(_bulk_delete_item_label(result), 190, TEXT))
	row.add_child(_make_preview_cell(_bulk_report_short_message(str(result.get("message", "")), ok), 0, MUTED if ok else RED, true))
	return panel


func _bulk_report_short_message(message: String, ok: bool) -> String:
	var clean := message.replace("\n", " | ").strip_edges()
	if clean == "":
		return "Concluido" if ok else "Falha nao especificada"
	var parts := clean.split("|", false)
	if parts.size() > 0:
		return str(parts[0]).strip_edges()
	return clean


func _bulk_delete_report_text(total: int, success_count: int, fail_count: int, results: Array[Dictionary]) -> String:
	var lines: Array[String] = []
	lines.append("Relatorio de exclusao Grupo RS")
	lines.append("Total: %d | Excluidos: %d | Falhas: %d" % [total, success_count, fail_count])
	lines.append("")
	for result in results:
		lines.append("%s - %s - %s" % [
			_bulk_delete_item_label(result),
			"OK" if bool(result.get("ok", false)) else "FALHA",
			_bulk_report_short_message(str(result.get("message", "")), bool(result.get("ok", false))),
		])
	return "\n".join(lines)


