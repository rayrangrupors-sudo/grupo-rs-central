	button.add_theme_font_override("font", UI_FONT)
	button.add_theme_font_size_override("font_size", 13)
	button.add_theme_color_override("font_color", Color.WHITE if selected else BLUE_DARK)
	button.add_theme_color_override("font_hover_color", Color.WHITE)
	button.add_theme_color_override("font_pressed_color", Color.WHITE)
	var normal_fill := BLUE if selected else (Color("#eaf3fb") if is_today else Color("#f5f9fd"))
	var normal_border := BLUE_DARK if selected else (BLUE if is_today else Color("#c6dbea"))
	button.add_theme_stylebox_override("normal", _style_box(normal_fill, normal_border, 1 if selected or is_today else 1, 9))
	button.add_theme_stylebox_override("hover", _style_box(BLUE_DARK, BLUE_DARK, 1, 7))
	button.add_theme_stylebox_override("pressed", _style_box(BLUE_DARK.darkened(0.08), BLUE_DARK, 1, 7))
	button.add_theme_stylebox_override("focus", _style_box(BLUE_DARK, BLUE, 1, 7))
	if is_today and not selected:
		button.tooltip_text = "Hoje"
	button.pressed.connect(func():
		_commit_system_log_calendar_date(system_log_calendar_year, system_log_calendar_month, day)
	)
	return button


func _change_system_log_calendar_month(delta: int) -> void:
	system_log_calendar_month += delta
	if system_log_calendar_month < 1:
		system_log_calendar_month = 12
		system_log_calendar_year -= 1
	elif system_log_calendar_month > 12:
		system_log_calendar_month = 1
		system_log_calendar_year += 1
	_refresh_system_log_calendar_popup()


func _refresh_system_log_calendar_popup() -> void:
	if not is_instance_valid(system_log_calendar_popup):
		return
	var popup := system_log_calendar_popup
	popup.hide()
	popup.queue_free()
	system_log_calendar_popup = null
	_open_system_log_calendar(system_log_calendar_target, system_log_calendar_end_of_day)


func _commit_system_log_calendar_date(year: int, month: int, day: int) -> void:
	var value := "%02d/%02d/%04d" % [day, month, year]
	if system_log_calendar_target == system_log_date_input:
		system_log_selected_date = value
	elif system_log_calendar_target == system_log_end_date_input:
		system_log_end_date = value
	elif system_log_calendar_target == inventory_date_input:
		inventory_start_date = value
	elif system_log_calendar_target == inventory_end_date_input:
		inventory_end_date = value
	elif system_log_calendar_target == sms_panel_date_input:
		sms_panel_start_date = value
	elif system_log_calendar_target == sms_panel_end_date_input:
		sms_panel_end_date = value
	if system_log_calendar_target != null:
		system_log_calendar_target.text = value
	if is_instance_valid(system_log_calendar_popup):
		system_log_calendar_popup.hide()
	if system_log_calendar_target == inventory_date_input or system_log_calendar_target == inventory_end_date_input:
		call_deferred("_apply_inventory_date_filters")
	elif system_log_calendar_target == sms_panel_date_input or system_log_calendar_target == sms_panel_end_date_input:
		call_deferred("_refresh_sms_panel_date_filters")


