func _build_experttexting_delivery_panel() -> Control:
	var panel := PanelContainer.new()
	panel.custom_minimum_size = Vector2(520, 0)
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.size_flags_vertical = Control.SIZE_EXPAND_FILL
	panel.add_theme_stylebox_override("panel", _style_box(Color.WHITE, BORDER, 1, 8, true))
	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 18)
	margin.add_theme_constant_override("margin_right", 18)
	margin.add_theme_constant_override("margin_top", 16)
	margin.add_theme_constant_override("margin_bottom", 16)
	panel.add_child(margin)
	var stack := VBoxContainer.new()
	stack.add_theme_constant_override("separation", 9)
	margin.add_child(stack)
	var title := Label.new()
	title.text = "Entregas recentes"
	title.add_theme_font_override("font", UI_FONT)
	title.add_theme_font_size_override("font_size", 20)
	title.add_theme_color_override("font_color", TEXT)
	stack.add_child(title)
	var attempts: Array[Dictionary] = []
	for serial in auto_reset_attempts.keys():
		var attempt: Dictionary = auto_reset_attempts.get(serial, {}).duplicate(true)
		if str(attempt.get("message_id", "")).strip_edges() == "":
			continue
		attempt["serial"] = str(serial)
		attempts.append(attempt)
	attempts.sort_custom(func(a: Dictionary, b: Dictionary): return int(a.get("last_sent", 0)) > int(b.get("last_sent", 0)))
	if attempts.is_empty():
		stack.add_child(_make_empty_log_card("Nenhum envio pela API foi registrado ainda."))
		return panel
	var scroll := ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	stack.add_child(scroll)
	var rows := VBoxContainer.new()
	rows.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	rows.add_theme_constant_override("separation", 7)
	scroll.add_child(rows)
	for index in range(mini(attempts.size(), 30)):
		var attempt := attempts[index]
		var status := str(attempt.get("provider_status", "ACEITO")).to_upper()
		var color := GREEN if ["SENT", "DELIVERED", "REPLIED"].has(status) else (RED if ["FAILED", "REJECTED", "EXPIRED", "UNDELIVERED"].has(status) else YELLOW)
		var row := HBoxContainer.new()
		row.custom_minimum_size = Vector2(0, 44)
		row.add_theme_constant_override("separation", 9)
		row.add_child(_make_table_label(str(attempt.get("serial", "")), 105, false, TEXT, HORIZONTAL_ALIGNMENT_LEFT, 13))
		row.add_child(_make_table_label(status, 105, false, color, HORIZONTAL_ALIGNMENT_LEFT, 13))
		row.add_child(_make_table_label("...%s" % str(attempt.get("message_id", "")).right(8), 105, false, MUTED, HORIZONTAL_ALIGNMENT_LEFT, 12))
		row.add_child(_make_table_label(_format_monitor_usd(float(attempt.get("price", 0.0))), 85, true, TEXT, HORIZONTAL_ALIGNMENT_RIGHT, 13))
		rows.add_child(row)
	return panel


func _format_monitor_usd(value: float) -> String:
	return "US$ %.2f" % maxf(value, 0.0)


func _format_monitor_date(value: String) -> String:
	var parts := value.split("-")
	if parts.size() == 3:
		return "%s/%s" % [parts[2], parts[1]]
	return value


