func _register_timeline_items() -> void:
	if timeline_last_rows.is_empty():
		return

	_show_timeline_result("Carregando... cadastrando registros, aguarde.", true)
	await get_tree().process_frame

	var created := 0
	var updated := 0
	var skipped := 0
	var errors: Array[String] = []

	for i in range(timeline_last_rows.size()):
		var row: Dictionary = timeline_last_rows[i]
		var serial: String = str(row.get("serial", "")).strip_edges()
		var existing: Dictionary = store.get_product(serial)
		var product: Dictionary = {
			"sku": serial.to_upper(),
			"imei": serial,
			"equipment_number": "",
			"apn": "",
			"chip_number": "",
			"chip_phone": "",
			"model": str(row.get("model", "")),
			"operator": str(row.get("operator", "")),
			"plate": str(row.get("plate", "")).to_upper(),
			"client": "",
			"tracker_status": "Instalado",
			"status": "Instalado",
			"name": _name_from_bulk_row(row),
			"category": str(row.get("model", "")),
			"location": "Instalado",
			"unit": "un",
			"stock": 0,
			"min_stock": 0,
			"cost": 0.0,
			"notes": "Importado da linha do tempo. Operadora: %s" % str(row.get("operator", "")),
		}

		var saved: Dictionary = store.upsert_historical_installed_product(product, str(row.get("installed_at", "")))
		if saved.is_empty():
			skipped += 1
			errors.append("%s: nao foi possivel salvar." % serial)
			continue

		if existing.is_empty():
			created += 1
			_log_system_action("Linha do tempo", _log_product_details(saved), serial)
		else:
			updated += 1
			_log_system_action("Atualizou linha do tempo", _log_product_details(saved), serial)

		if i % 80 == 0:
			await get_tree().process_frame

	var processed := created + updated
	var message := "Processados: %d | Cadastrados: %d | Atualizados: %d | Ignorados: %d" % [processed, created, updated, skipped]
	if not errors.is_empty():
		message += "\n" + _join_messages(errors, 8)
	_show_timeline_result(message, errors.is_empty())
	if errors.is_empty():
		_show_success("Linha do tempo", message)
	else:
		_show_error("Linha do tempo", message)


