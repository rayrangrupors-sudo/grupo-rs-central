func _show_alert(
	type: AlertDialog.Type,
	title: String,
	message: String,
	supporting_note: String = "",
	confirm_text: String = "",
	cancel_text: String = "Cancelar"
) -> AlertDialog:
	var dialog := AlertDialog.new()
	add_child(dialog)
	dialog.show_alert(type, title, message, supporting_note, confirm_text, cancel_text)
	return dialog


func _confirm_action(
	title: String,
	message: String,
	confirmed_callback: Callable,
	confirm_text: String = "",
	supporting_note: String = "",
	cancel_text: String = "Cancelar"
) -> void:
	var dialog := _show_alert(
		AlertDialog.Type.QUESTION,
		title,
		message,
		supporting_note,
		confirm_text,
		cancel_text
	)
	dialog.confirmed.connect(confirmed_callback)


