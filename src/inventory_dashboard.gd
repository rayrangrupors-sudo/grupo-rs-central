func _render_bulk_client_lookup_report_page() -> void:
	if bulk_client_lookup_report_body == null or not is_instance_valid(bulk_client_lookup_report_body):
		return
	for child in bulk_client_lookup_report_body.get_children():
		bulk_client_lookup_report_body.remove_child(child)
		child.queue_free()

	var page_count := maxi(1, ceili(float(bulk_client_lookup_results.size()) / float(BULK_CLIENT_LOOKUP_PAGE_SIZE)))
	bulk_client_lookup_current_page = clampi(bulk_client_lookup_current_page, 0, page_count - 1)
	var first := bulk_client_lookup_current_page * BULK_CLIENT_LOOKUP_PAGE_SIZE
	var last := mini(first + BULK_CLIENT_LOOKUP_PAGE_SIZE, bulk_client_lookup_results.size())
	for index in range(first, last):
		bulk_client_lookup_report_body.add_child(_make_bulk_client_lookup_report_row(bulk_client_lookup_results[index]))
	if bulk_client_lookup_results.is_empty():
		var empty_message := "Nenhum rastreador foi encontrado para os clientes informados."
		if bulk_client_lookup_report_mode == "maintenance":
			empty_message = "Nenhum dos clientes informados esta na lista de Manutencao."
		elif bulk_client_lookup_report_mode == "sga":
			empty_message = "Nenhum cliente foi consultado nos SGA."
		bulk_client_lookup_report_body.add_child(_make_bulk_preview_message(empty_message, true))

	if bulk_client_lookup_page_label:
		bulk_client_lookup_page_label.text = "%d-%d de %d | Pagina %d de %d" % [first + 1 if not bulk_client_lookup_results.is_empty() else 0, last, bulk_client_lookup_results.size(), bulk_client_lookup_current_page + 1, page_count]
	if bulk_client_lookup_previous_button:
		bulk_client_lookup_previous_button.disabled = bulk_client_lookup_current_page <= 0
	if bulk_client_lookup_next_button:
		bulk_client_lookup_next_button.disabled = bulk_client_lookup_current_page >= page_count - 1


