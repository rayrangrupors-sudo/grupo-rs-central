func _assistant_report_safe(value: Variant) -> Variant:
	match typeof(value):
		TYPE_DICTIONARY:
			var result := {}
			for key in (value as Dictionary).keys():
				var clean_key := str(key)
				if _assistant_report_key_is_secret(clean_key):
					result[clean_key] = "[removido]"
				else:
					result[clean_key] = _assistant_report_safe((value as Dictionary).get(key))
			return result
		TYPE_ARRAY:
			var result: Array = []
			for item in value as Array:
				result.append(_assistant_report_safe(item))
			return result
		TYPE_COLOR:
			return "#%s" % (value as Color).to_html(true)
		TYPE_OBJECT:
			return str(value)
	return value


func _assistant_report_key_is_secret(key: String) -> bool:
	var clean := key.to_lower()
	for fragment in ["password", "senha", "token", "cookie", "secret", "authorization", "auth"]:
		if clean.contains(fragment):
			return true
	return false


func _assistant_web_answer(question: String) -> String:
	if assistant_chat_status_label != null and is_instance_valid(assistant_chat_status_label):
		assistant_chat_status_label.text = "Pesquisando na internet..."
		assistant_chat_status_label.add_theme_color_override("font_color", YELLOW)
	var query := ("Grupo RS rastreamento " + question).uri_encode()
	var response := await _http_get_text_with_headers(
		"https://duckduckgo.com/html/?q=%s" % query,
		PackedStringArray(["User-Agent: Mozilla/5.0 GrupoRSCentral/1.0"])
	)
	if not bool(response.get("ok", false)):
		var escalation := _assistant_create_codex_escalation("Pergunta sem resposta local; web falhou", question, {"web_error": str(response.get("message", "sem resposta"))})
		return "Nao encontrei resposta nos dados online e a pesquisa web falhou agora: %s\n%s" % [str(response.get("message", "sem resposta")), _assistant_escalation_answer(escalation)]
	var results := _assistant_parse_web_results(str(response.get("body", "")))
	if results.is_empty():
		var escalation := _assistant_create_codex_escalation("Pergunta sem resposta local/web", question, {"web": "sem resultado claro"})
		return "Nao encontrei resposta local e a pesquisa web nao trouxe resultado claro.\n%s" % _assistant_escalation_answer(escalation)
	var lines: Array[String] = ["Nao achei isso nos dados online. Pesquisa web retornou:"]
	for index in range(mini(results.size(), 3)):
		var item := results[index] as Dictionary
		lines.append("%d. %s - %s" % [index + 1, str(item.get("title", "")), str(item.get("url", ""))])
	lines.append("Antes de aplicar qualquer correcao encontrada fora, confirme comigo.")
	return "\n".join(lines)


func _assistant_parse_web_results(html: String) -> Array[Dictionary]:
	var results: Array[Dictionary] = []
	var regex := RegEx.new()
	if regex.compile("(?is)<a[^>]+class=[\"'][^\"']*result__a[^\"']*[\"'][^>]+href=[\"']([^\"']+)[\"'][^>]*>(.*?)</a>") != OK:
		return results
	for match_result in regex.search_all(html):
		var title := _clean_html_text(match_result.get_string(2))
		var url := _assistant_clean_search_url(_decode_basic_html_entities(match_result.get_string(1)))
		if title == "" or url == "":
			continue
		results.append({"title": title, "url": url})
		if results.size() >= 5:
			break
	return results


func _assistant_clean_search_url(url: String) -> String:
	var clean := url.strip_edges()
	var marker := "uddg="
	var index := clean.find(marker)
	if index >= 0:
		clean = clean.substr(index + marker.length())
		var end := clean.find("&")
		if end >= 0:
			clean = clean.substr(0, end)
		clean = clean.uri_decode()
	return clean


func _assistant_extract_serial(question: String) -> String:
	var digits := _digits_only(question)
	if digits.length() < 9:
		return ""
	for index in range(0, digits.length() - 8):
		var candidate := digits.substr(index, 9)
		if candidate.begins_with("024"):
			return candidate
	return ""


func _assistant_operator_key(value: String) -> String:
	var key := _assistant_text_key(value)
	if key.contains("claro"):
		return "claro"
	if key.contains("vivo"):
		return "vivo"
	if key.contains("tim"):
		return "tim"
	return "outros"


func _assistant_has_any(value: String, needles: Array[String]) -> bool:
	for needle in needles:
		if value.contains(str(needle)):
			return true
	return false


func _assistant_text_key(value: String) -> String:
	return value.strip_edges().to_lower() \
		.replace(" ", "") \
		.replace("-", "") \
		.replace("_", "") \
		.replace(".", "") \
		.replace("/", "") \
		.replace(":", "") \
		.replace("?", "") \
		.replace("!", "") \
		.replace(",", "") \
		.replace(";", "") \
		.replace("(", "") \
		.replace(")", "") \
		.replace("á", "a") \
		.replace("à", "a") \
		.replace("ã", "a") \
		.replace("â", "a") \
		.replace("ç", "c") \
		.replace("é", "e") \
		.replace("ê", "e") \
		.replace("í", "i") \
		.replace("ó", "o") \
		.replace("õ", "o") \
		.replace("ô", "o") \
		.replace("ú", "u")


