func _save_experttexting_settings() -> bool:
	if not _require_config_vault_access():
		return false
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var username := str(experttexting_username_input.text if experttexting_username_input else "").strip_edges()
	var api_key := str(experttexting_api_key_input.text if experttexting_api_key_input else "").strip_edges()
	var api_secret := str(experttexting_api_secret_input.text if experttexting_api_secret_input else "").strip_edges()
	var sender := str(experttexting_sender_input.text if experttexting_sender_input else "DEFAULT").strip_edges()
	if username == "":
		username = str(settings.get("experttexting_username", "")).strip_edges()
	if api_key == "":
		api_key = str(settings.get("experttexting_api_key", "")).strip_edges()
	if api_secret == "":
		api_secret = str(settings.get("experttexting_api_secret", "")).strip_edges()
	if sender == "":
		sender = "DEFAULT"
	settings["experttexting_username"] = username
	settings["experttexting_sender"] = sender
	settings["experttexting_enabled"] = experttexting_enabled_check == null or experttexting_enabled_check.button_pressed
	settings["experttexting_inbox_enabled"] = experttexting_inbox_enabled_check == null or experttexting_inbox_enabled_check.button_pressed
	settings["experttexting_daily_limit_usd"] = experttexting_daily_limit_input.value if experttexting_daily_limit_input else EXPERTTEXTING_DEFAULT_DAILY_LIMIT_USD
	settings["experttexting_monthly_limit_usd"] = experttexting_monthly_limit_input.value if experttexting_monthly_limit_input else EXPERTTEXTING_DEFAULT_MONTHLY_LIMIT_USD
	settings["experttexting_minimum_balance_usd"] = experttexting_minimum_balance_input.value if experttexting_minimum_balance_input else EXPERTTEXTING_DEFAULT_MINIMUM_BALANCE_USD
	if api_key != "":
		settings["experttexting_api_key"] = api_key
	if api_secret != "":
		settings["experttexting_api_secret"] = api_secret
	settings["experttexting_saved_at"] = Time.get_datetime_string_from_system(false, true)
	_write_json_dictionary(SETTINGS_PATH, settings)
	if experttexting_api_key_input:
		experttexting_api_key_input.clear()
		experttexting_api_key_input.placeholder_text = "Chave da API (ja salva)" if api_key != "" else "Chave da API"
	if experttexting_api_secret_input:
		experttexting_api_secret_input.clear()
