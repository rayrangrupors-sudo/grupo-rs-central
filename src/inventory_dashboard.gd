func _update_bootstrap() -> Node:
	return get_node_or_null("/root/UpdateBootstrap")


func _update_state_dictionary(state: Dictionary, key: String) -> Dictionary:
	var value: Variant = state.get(key, {})
	return value as Dictionary if typeof(value) == TYPE_DICTIONARY else {}


func _set_app_update_status(message: String, color: Color) -> void:
	if update_status_label != null and is_instance_valid(update_status_label):
		update_status_label.text = message
		update_status_label.add_theme_color_override("font_color", color)


func _save_app_update_source() -> String:
	var bootstrap := _update_bootstrap()
	var source := str(update_manifest_source_input.text if update_manifest_source_input else "").strip_edges()
	if source == "" and bootstrap != null:
		source = str(bootstrap.call("default_manifest_source"))
		if update_manifest_source_input:
			update_manifest_source_input.text = source
	var settings := _read_json_dictionary(SETTINGS_PATH)
	settings["update_manifest_source"] = source
	_write_json_dictionary(SETTINGS_PATH, settings)
	return source


func _check_app_updates() -> void:
	var bootstrap := _update_bootstrap()
	if bootstrap == null:
		_set_app_update_status("Carregador de atualizacoes indisponivel.", RED)
		return
	var source := _save_app_update_source()
	if update_progress_bar:
		update_progress_bar.value = 30
	_set_app_update_status("Consultando o manifesto de atualizacao...", BLUE_DARK)
	var result: Dictionary = await bootstrap.call("check_for_updates", source)
	if update_progress_bar:
		update_progress_bar.value = 100 if bool(result.get("ok", false)) else 0
	if not bool(result.get("ok", false)):
		_set_app_update_status(str(result.get("message", "Falha ao verificar atualizacoes.")), RED)
		if update_install_button:
			update_install_button.disabled = true
		return
	var available := bool(result.get("available", false))
	_set_app_update_status(str(result.get("message", "")), GREEN if available else MUTED)
	if update_install_button:
		update_install_button.disabled = not available
	if update_notes_label:
		var notes := str(result.get("notes", "")).strip_edges()
		update_notes_label.text = ("Novidades: %s" % notes) if notes != "" else ""


func _install_app_update() -> void:
	var bootstrap := _update_bootstrap()
	if bootstrap == null:
		return
	if update_install_button:
		update_install_button.disabled = true
	if update_progress_bar:
		update_progress_bar.value = 45
	_set_app_update_status("Baixando e verificando o pacote...", BLUE_DARK)
	var result: Dictionary = await bootstrap.call("install_available_update")
	if update_progress_bar:
		update_progress_bar.value = 100 if bool(result.get("ok", false)) else 0
	if not bool(result.get("ok", false)):
		_set_app_update_status(str(result.get("message", "A atualizacao nao foi instalada.")), RED)
		if update_install_button:
			update_install_button.disabled = false
		return
	_set_app_update_status(str(result.get("message", "Atualizacao pronta.")), GREEN)
	if update_restart_button:
		update_restart_button.disabled = false
	_log_system_action(
		"Atualizacao instalada",
		"Versao %s validada por SHA-256 e pronta para reinicio." % str(result.get("version", ""))
	)


func _confirm_app_update_restart() -> void:
	_confirm_action(
		"Aplicar atualizacao",
		"O monitor automatico sera parado com seguranca, o sistema reiniciara e a nova versao sera carregada.",
		_restart_app_after_safe_stop
	)


func _restart_app_after_safe_stop() -> void:
	var bootstrap := _update_bootstrap()
	if bootstrap == null:
		return
	var monitor_was_enabled := auto_reset_enabled
	if monitor_was_enabled:
		_set_app_update_status("Aguardando a parada segura do monitor automatico...", YELLOW)
		_request_auto_reset_safe_stop()
		while auto_reset_running or auto_reset_stop_requested:
			await get_tree().create_timer(0.25).timeout
		auto_reset_enabled = true
		auto_reset_stop_requested = false
		_save_auto_reset_state()
	_log_system_action("Aplicando atualizacao", "Sistema reiniciado depois da parada segura do monitor.")
	var result: Dictionary = bootstrap.call("restart_application")
	if not bool(result.get("ok", false)):
		_set_app_update_status(str(result.get("message", "Reinicio automatico falhou.")), RED)


func _confirm_app_update_rollback() -> void:
	_confirm_action(
		"Restaurar versao",
		"A versao anterior sera preparada e aplicada no proximo reinicio seguro.",
		_prepare_app_update_rollback
	)


func _prepare_app_update_rollback() -> void:
	var bootstrap := _update_bootstrap()
	if bootstrap == null:
		return
	var result: Dictionary = bootstrap.call("prepare_rollback")
	if not bool(result.get("ok", false)):
		_set_app_update_status(str(result.get("message", "Restauracao indisponivel.")), RED)
		return
	_set_app_update_status(str(result.get("message", "Restauracao preparada.")), YELLOW)
	if update_restart_button:
		update_restart_button.disabled = false
	_log_system_action("Restauracao preparada", str(result.get("message", "")))


func _open_app_update_folder() -> void:
	var bootstrap := _update_bootstrap()
	if bootstrap == null:
		return
	var path := str(bootstrap.call("update_directory"))
	if path != "":
		OS.shell_open(path)


