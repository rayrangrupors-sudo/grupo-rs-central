class DonutChart:
	extends Control

	var updated := 0
	var outdated := 0

	func set_values(next_updated: int, next_outdated: int) -> void:
		updated = maxi(next_updated, 0)
		outdated = maxi(next_outdated, 0)
		queue_redraw()

	func _ready() -> void:
		custom_minimum_size = Vector2(430, 260)


	func _draw() -> void:
		var total := updated + outdated
		var center := size * 0.5
		center.y -= 5.0
		var radius: float = minf(size.x, size.y) * 0.34
		var width := 64.0
		var start := -PI * 0.5

		if total <= 0:
			draw_arc(center, radius, 0.0, TAU, 128, Color("#e7ebf0"), width, true)
			return

		var updated_angle := TAU * (float(updated) / float(total))
		draw_arc(center, radius, start, start + updated_angle, 128, Color("#2daf65"), width, true)
		draw_arc(center, radius, start + updated_angle, start + TAU, 128, Color("#ff1111"), width, true)


class DashboardOperatorDonut:
	extends Control

	var segments: Array[Dictionary] = []

	func set_segments(next_segments: Array[Dictionary]) -> void:
		segments = next_segments.duplicate(true)
		queue_redraw()

	func _ready() -> void:
		custom_minimum_size = Vector2(150, 150)
		mouse_filter = Control.MOUSE_FILTER_IGNORE

	func _draw() -> void:
		var total := 0
		for segment in segments:
			total += maxi(int(segment.get("value", 0)), 0)
		var center := size * 0.5
		var radius := minf(size.x, size.y) * 0.34
		var width := 22.0
		if total <= 0:
			draw_arc(center, radius, 0.0, TAU, 96, Color("#dfe7ef"), width, true)
			return
		var start := -PI * 0.5
		for segment in segments:
			var value := maxi(int(segment.get("value", 0)), 0)
			if value <= 0:
				continue
			var sweep := TAU * float(value) / float(total)
			draw_arc(center, radius, start, start + sweep, 64, segment.get("color", Color("#9aa8b6")), width, true)
			start += sweep
		draw_circle(center, radius - width * 0.62, Color("#ffffff"))


class ServerHealthCore:
	extends Control

	var state := "connecting"
	var phase := 0.0
	var animation_elapsed := 0.0
	var latency_ms := -1
	var pending := false
	const ANIMATION_INTERVAL_SECONDS := 0.08

	func _ready() -> void:
		custom_minimum_size = Vector2(300, 225)
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		set_process(true)

	func set_health(next_state: String, next_latency_ms: int, next_pending: bool) -> void:
		state = next_state
		latency_ms = next_latency_ms
		pending = next_pending
		queue_redraw()

	func _process(delta: float) -> void:
		animation_elapsed += delta
		if animation_elapsed < ANIMATION_INTERVAL_SECONDS:
			return
		var elapsed := animation_elapsed
		animation_elapsed = 0.0
		phase = fmod(phase + elapsed * 0.28, 1.0)
		queue_redraw()

	func _draw() -> void:
		var center := Vector2(size.x * 0.5, size.y * 0.48)
		var radius := minf(size.x, size.y) * 0.29
		var color := _state_color()
		var pulse := (sin(phase * TAU) + 1.0) * 0.5
		var arc_start := -PI * 0.5 + phase * TAU

		draw_circle(center, radius + 24.0 + pulse * 5.0, Color(color, 0.055))
		draw_arc(center, radius + 13.0, 0.0, TAU, 96, Color("#e5edf5"), 8.0, true)
		draw_arc(center, radius + 13.0, arc_start, arc_start + PI * 1.22, 64, color, 8.0, true)
		draw_circle(center, radius, Color("#f7fbff"))
		draw_arc(center, radius, 0.0, TAU, 96, Color(color, 0.32), 2.0, true)
		draw_circle(center, radius * 0.58, Color(color, 0.11 + pulse * 0.04))
		draw_circle(center, radius * 0.23, color)
		draw_circle(center, radius * 0.095, Color.WHITE)

		for index in range(5):
			var angle := -PI * 0.5 + float(index) * TAU / 5.0
			var dot_center := center + Vector2(cos(angle), sin(angle)) * (radius + 13.0)
			var dot_color := color if index <= _active_dot_count() else Color("#cfd9e3")
			draw_circle(dot_center, 5.0, dot_color)

	func _active_dot_count() -> int:
		if state in ["synced", "online"]:
			return 4
		if state == "degraded":
			return 2
		if state in ["syncing", "connecting", "pending"]:
			return 3
		if state == "offline":
			return 1
		return 0

	func _state_color() -> Color:
		match state:
			"synced", "online":
				return Color("#13a56a")
			"degraded":
				return Color("#f29727")
			"syncing", "connecting", "pending", "idle":
				return Color("#0070b8")
			"offline":
				return Color("#d64545")
			"conflict", "auth_error", "error":
				return Color("#d64545")
			_:
				return Color("#8291a2")

class ChevronIcon:
	extends Control

	var chevron_color := Color.WHITE

	func _init(next_color: Color = Color.WHITE) -> void:
		chevron_color = next_color
