func _fetch_arya_sms_history(number: String) -> Array[Dictionary]:
	await _ensure_arya_token(false)
	var response := await _http_get_text_with_headers(ARYA_SMS_HISTORY_URL % number.uri_encode(), _arya_request_headers())
	if not bool(response.get("ok", false)) and str(response.get("message", "")).contains("401"):
		var relogin := await _ensure_arya_token(true)
		if bool(relogin.get("ok", false)):
			response = await _http_get_text_with_headers(ARYA_SMS_HISTORY_URL % number.uri_encode(), _arya_request_headers())
	if not bool(response.get("ok", false)):
		return []
	var parsed_json: Variant = JSON.parse_string(str(response.get("body", "")))
	if typeof(parsed_json) != TYPE_ARRAY:
		return []
	var rows: Array[Dictionary] = []
	for item in parsed_json as Array:
		if typeof(item) == TYPE_DICTIONARY:
			rows.append(item as Dictionary)
	return rows


