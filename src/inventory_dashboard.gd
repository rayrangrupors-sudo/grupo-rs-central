func _assistant_seed_chat() -> void:
	var subject_text := "aparelhos, placas, operadoras, manutencoes, Bat. Int e saude da plataforma"
	if _branch_supports_sms():
		subject_text = "aparelhos, placas, operadoras, manutencoes, Bat. Int, SMS automatico e saude da plataforma"
	assistant_chat_messages.append({
		"role": "assistant",
		"text": "Pode perguntar sobre %s. Se eu nao achar nos dados online, tento pesquisar fora; se ainda assim nao resolver, gero um chamado para Codex com o contexto." % subject_text,
	})


func _assistant_render_chat_messages() -> void:
	if assistant_chat_body == null or not is_instance_valid(assistant_chat_body):
		return
	for child in assistant_chat_body.get_children():
		assistant_chat_body.remove_child(child)
		child.queue_free()
	var start := maxi(assistant_chat_messages.size() - 6, 0)
	for index in range(start, assistant_chat_messages.size()):
		assistant_chat_body.add_child(_make_assistant_chat_bubble(assistant_chat_messages[index]))


func _make_assistant_chat_bubble(message: Dictionary) -> Control:
	var role := str(message.get("role", "assistant"))
	var is_user := role == "user"
	var row := HBoxContainer.new()
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.alignment = BoxContainer.ALIGNMENT_END if is_user else BoxContainer.ALIGNMENT_BEGIN

	var panel := PanelContainer.new()
	panel.custom_minimum_size = Vector2(0, 42)
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.add_theme_stylebox_override("panel", _style_box(
		Color("#eaf4ff") if is_user else Color("#f7f9fc"),
		Color("#b9d9f2") if is_user else Color("#dce6ef"),
		1,
		8
	))
	row.add_child(panel)

	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_top", 9)
	margin.add_theme_constant_override("margin_bottom", 9)
	panel.add_child(margin)

	var label := Label.new()
	label.text = str(message.get("text", ""))
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	label.add_theme_font_override("font", UI_FONT)
	label.add_theme_font_size_override("font_size", 14)
	label.add_theme_color_override("font_color", BLUE_DARK if is_user else TEXT)
	margin.add_child(label)
	return row


func _assistant_send_quick_question(question: String) -> void:
	if assistant_chat_input != null and is_instance_valid(assistant_chat_input):
		assistant_chat_input.text = question
	_assistant_submit_question()


func _assistant_submit_question() -> void:
	if assistant_chat_busy:
		return
	var question := str(assistant_chat_input.text if assistant_chat_input else "").strip_edges()
	if question == "":
		return
	if assistant_chat_input != null and is_instance_valid(assistant_chat_input):
		assistant_chat_input.clear()
	_assistant_handle_question(question)


func _assistant_handle_question(question: String) -> void:
	assistant_chat_busy = true
	assistant_chat_messages.append({"role": "user", "text": question})
	assistant_chat_messages.append({"role": "assistant", "text": "Analisando os dados online..."})
	_assistant_render_chat_messages()
	if assistant_chat_status_label != null and is_instance_valid(assistant_chat_status_label):
		assistant_chat_status_label.text = "Analisando..."
		assistant_chat_status_label.add_theme_color_override("font_color", BLUE)

	var answer := await _assistant_answer_question(question)
	assistant_chat_busy = false
	if assistant_chat_messages.size() > 0:
		assistant_chat_messages[assistant_chat_messages.size() - 1] = {"role": "assistant", "text": answer}
	_assistant_render_chat_messages()
	if assistant_chat_status_label != null and is_instance_valid(assistant_chat_status_label):
		assistant_chat_status_label.text = "Pronto"
		assistant_chat_status_label.add_theme_color_override("font_color", GREEN)
	if assistant_chat_input != null and is_instance_valid(assistant_chat_input):
		assistant_chat_input.editable = true


func _assistant_answer_question(question: String) -> String:
	var local_answer := _assistant_local_answer(question)
	if local_answer.strip_edges() != "":
		return local_answer
	return await _assistant_web_answer(question)


func _assistant_local_answer(question: String) -> String:
	var q := _assistant_text_key(question)
	if q == "":
		return "Pergunta vazia. Me mande uma serie, placa ou tema do sistema."
	if _assistant_has_any(q, ["codex", "escalar", "encaminhar", "chamado", "resolvercomcodex"]):
		var manual_problem := _assistant_manual_codex_problem(question)
		if manual_problem == "":
			return "Nao encontrei falha ou alerta real para escalar agora. Descreva o problema junto com o pedido, por exemplo: 'Escalar Codex: monitor SMS nao concluiu o recheck depois de 24 horas'."
		var escalation := _assistant_create_codex_escalation("Solicitacao manual no chat da IA", manual_problem, {"manual_question": question})
		return _assistant_escalation_answer(escalation)

	var product := _assistant_find_product(question)
	if not product.is_empty():
		return _assistant_describe_product(product)

	if _assistant_has_any(q, ["ajuda", "oquevocefaz", "oquevocepode", "comofunciona", "chat"]):
		var capabilities := "consultar o Firebase, resumir a plataforma, explicar status de aparelho por serie ou placa, verificar manutencoes, Bat. Int, operadoras, caches de online/off e alertas do Assistente Autonomo"
		if _branch_supports_sms():
			capabilities += " e monitor SMS"
		return "Eu consigo %s." % capabilities
	if _assistant_has_any(q, ["sms", "comando", "monitorautomatico", "monitor"]):
		return _assistant_sms_summary()
	if _assistant_has_any(q, ["batint", "bateriainterna", "bateria", "intbat"]):
		return _assistant_battery_summary()
	if _assistant_has_any(q, ["manutencao", "manutencoes", "agendada", "agenda"]):
		return _assistant_maintenance_summary()
	if _assistant_has_any(q, ["online", "offline", "ligado", "desligado", "desatualizado", "localizacao"]):
		return _assistant_connection_summary()
	if _assistant_has_any(q, ["operadora", "claro", "vivo", "tim"]):
		return _assistant_operator_summary(q)
	if _assistant_has_any(q, ["base", "filial", "imperatriz", "araguaina", "acailandia", "maraba"]):
		return _assistant_branch_summary()
	if _assistant_has_any(q, ["erro", "falha", "problema", "plataforma", "sistema", "saude"]):
		return _assistant_platform_summary()
	return ""


func _assistant_manual_codex_problem(question: String) -> String:
	var clean_question := question.strip_edges()
	var q_key := _assistant_text_key(clean_question)
	var only_escalation_words := ["codex", "escalar", "encaminhar", "chamado", "resolvercomcodex"].has(q_key)
	var snapshot: Dictionary = {}
	if system_guardian != null and is_instance_valid(system_guardian):
		snapshot = system_guardian.call("get_snapshot")
	var unresolved := _assistant_unresolved_components(snapshot)
	var status := str(snapshot.get("status", ""))
	var summary := str(snapshot.get("summary", "")).strip_edges()
	if not unresolved.is_empty():
		var lines: Array[String] = []
		lines.append(clean_question)
		lines.append("Status do assistente: %s | %s" % [status, summary])
		for component in unresolved:
			lines.append("- %s: %s" % [
				str(component.get("label", component.get("id", "Componente"))),
				str(component.get("message", "Sem detalhes.")),
			])
		return "\n".join(lines)
	if only_escalation_words:
		return ""
	if clean_question.length() <= 22:
		return ""
	return clean_question


func _assistant_find_product(question: String) -> Dictionary:
	if store == null:
		return {}
	var products := store.get_products("", "all", false)
	var serial := _assistant_extract_serial(question)
	if serial != "":
		for product in products:
			if typeof(product) != TYPE_DICTIONARY:
				continue
			var item := product as Dictionary
			for key in ["imei", "sku", "equipment_number"]:
				if _digits_only(str(item.get(key, ""))) == serial:
					return item

	var q_key := _search_key(question)
	for product in products:
		if typeof(product) != TYPE_DICTIONARY:
			continue
		var item := product as Dictionary
		for key in ["plate", "imei", "sku", "equipment_number", "chip_number", "chip_phone"]:
			var value_key := _search_key(str(item.get(key, "")))
			if value_key.length() >= 5 and q_key.contains(value_key):
				return item
	return {}


func _assistant_describe_product(product: Dictionary) -> String:
	var serial := _digits_only(str(product.get("imei", product.get("sku", ""))))
	var plate := str(product.get("plate", "")).strip_edges()
	var lines: Array[String] = []
	lines.append("Encontrei o aparelho %s." % _blank(serial))
	lines.append("Placa: %s | Cliente: %s" % [_blank(plate), _blank(str(product.get("client", "")))])
	lines.append("Tipo: %s | Operadora: %s | Status local: %s" % [
		_blank(str(product.get("model", product.get("category", "")))),
		_blank(str(product.get("operator", ""))),
		_blank(str(product.get("tracker_status", product.get("status", "")))),
	])
	lines.append("Chip: %s | Telefone: %s | APN: %s" % [
		_blank(str(product.get("chip_number", ""))),
		_blank(str(product.get("chip_phone", ""))),
		_blank(str(product.get("apn", ""))),
	])

	var arya_key := _arya_product_query_key(product)
	var arya: Dictionary = arya_status_cache.get(arya_key, {})
	if arya.is_empty():
		lines.append("Online/offline: ainda nao consultado nesta tela.")
	else:
		lines.append("Online/offline: %s (%s)" % [_arya_status_label(str(arya.get("status", ""))), str(arya.get("message", "")).strip_edges()])

	var location: Dictionary = location_status_cache.get(serial, {})
	if location.is_empty():
		lines.append("Localizacao/sinal: ainda nao consultado nesta tela.")
	else:
		lines.append("Localizacao/sinal: %s | Ignicao: %s | Ultima: %s" % [
			str(location.get("label", "Nao verificado")),
			_blank(str(location.get("ignition", ""))),
			_blank(str(location.get("updated_at", ""))),
		])

	var battery: Dictionary = internal_battery_cache.get(serial, {})
	lines.append("Bat. Int: %s" % _internal_battery_display_text(battery))

	var maintenance := _assistant_find_maintenance(serial, plate)
	if maintenance.is_empty():
		lines.append("Manutencao: nao esta na lista local.")
	else:
		lines.append("Manutencao: %s | Data: %s %s | Obs: %s" % [
			str(maintenance.get("status", "pendente")),
			_blank(str(maintenance.get("scheduled_date", ""))),
			_blank(str(maintenance.get("scheduled_time", ""))),
			_blank(str(maintenance.get("note", ""))),
		])
	return "\n".join(lines)


func _assistant_find_maintenance(serial: String, plate: String) -> Dictionary:
	if store == null:
		return {}
	var serial_key := _digits_only(serial)
	var plate_key := _search_key(plate)
	for item in store.get_maintenances(true):
		if typeof(item) != TYPE_DICTIONARY:
			continue
		var maintenance := item as Dictionary
		if serial_key != "" and _digits_only(str(maintenance.get("serial", ""))) == serial_key:
			return maintenance
		if plate_key != "" and _search_key(str(maintenance.get("plate", ""))) == plate_key:
			return maintenance
	return {}


func _assistant_sms_summary() -> String:
	if not _branch_supports_sms():
		return "O recurso de SMS esta desativado para esta base regional."
	var lines: Array[String] = []
	lines.append("Monitor SMS automatico: %s" % ("rodando" if auto_reset_running else "aguardando proximo ciclo"))
	lines.append("Intervalo de varredura: %d min | Recheck: %d min" % [AUTO_RESET_MONITOR_INTERVAL_SECONDS / 60, AUTO_RESET_RECHECK_SECONDS / 60])
	lines.append("Fonte Grupo RS: %s | Intervalos: %s" % [selected_branch_grupo_rs_mode, ", ".join(AUTO_RESET_GRUPO_RS_SMS_INTERVALS)])
	lines.append("Regra ativa: somente series 024 com 9 digitos e 24h01 sem comunicacao, 1 SMS vitalicio por serie, 15s entre envios e standby/recheck de 24h.")
	lines.append("Travas: pausa com %d falhas seguidas e limite emergencial de %d SMS por ciclo." % [AUTO_RESET_GRUPO_RS_MAX_CONSECUTIVE_ERRORS, AUTO_RESET_GRUPO_RS_MAX_SMS_PER_CYCLE])
	lines.append("Tentativas registradas: %d | Rechecks pendentes: %d" % [auto_reset_attempts.size(), auto_reset_due_rechecks.size()])
	lines.append("Ultimo resumo: %s" % auto_reset_last_summary)
	return "\n".join(lines)


func _assistant_battery_summary() -> String:
	var total := internal_battery_cache.size()
	var ok_count := 0
	var no_data_count := 0
	var stale_count := 0
	for value in internal_battery_cache.values():
		if typeof(value) != TYPE_DICTIONARY:
			continue
		var data := value as Dictionary
		if int(data.get("percent", -1)) >= 0:
			ok_count += 1
		else:
			no_data_count += 1
		if str(data.get("status", "")) == "stale":
			stale_count += 1
	return "Bat. Int consulta os registros do Grupo RS novo. Cache atual: %d aparelho(s), %d com percentual, %d sem dados e %d usando ultimo valor conhecido. Quando nao retorna dado, a tabela mostra S/D com icone sinalizado." % [total, ok_count, no_data_count, stale_count]


func _assistant_maintenance_summary() -> String:
	if store == null:
		return "Abra uma base para consultar manutencoes."
	var pending := store.get_maintenances(false)
	var all_rows := store.get_maintenances(true)
	var scheduled := 0
	var no_date := 0
	var completed := 0
	for item in all_rows:
		if typeof(item) != TYPE_DICTIONARY:
			continue
		var row := item as Dictionary
		if str(row.get("status", "")) == "concluido":
			completed += 1
		elif str(row.get("scheduled_date", "")).strip_edges() != "" or str(row.get("scheduled_time", "")).strip_edges() != "":
			scheduled += 1
		else:
			no_date += 1
	return "Manutencoes na base %s: %d pendente(s), %d agendada(s), %d sem data e %d concluida(s)." % [selected_branch_name, pending.size(), scheduled, no_date, completed]


func _assistant_connection_summary() -> String:
	var online := 0
	var offline := 0
	var checking := 0
	for value in arya_status_cache.values():
		if typeof(value) != TYPE_DICTIONARY:
			continue
		var status := str((value as Dictionary).get("status", "")).to_lower()
		if status == "online":
			online += 1
		elif status == "offline" or status == "standby":
			offline += 1
		elif status == "consultando":
			checking += 1
	var ligado := 0
	var desligado := 0
	var desatualizado := 0
	for value in location_status_cache.values():
		if typeof(value) != TYPE_DICTIONARY:
			continue
		var label := str((value as Dictionary).get("label", "")).to_lower()
		if label.contains("ligado"):
			ligado += 1
		elif label.contains("desligado"):
			desligado += 1
		elif label.contains("desatualizado"):
			desatualizado += 1
	return "Status em cache: Arya/Link com %d online, %d off e %d consultando. Localizacao Grupo RS com %d ligado, %d desligado e %d desatualizado. Esses numeros refletem os aparelhos ja consultados na tela." % [online, offline, checking, ligado, desligado, desatualizado]


func _assistant_operator_summary(q: String) -> String:
	if store == null:
		return "Abra uma base para consultar operadoras."
	var wanted := ""
	for candidate in ["claro", "vivo", "tim"]:
		if q.contains(candidate):
			wanted = candidate
			break
	var counts := {"claro": 0, "vivo": 0, "tim": 0, "outros": 0}
	var installed := {"claro": 0, "vivo": 0, "tim": 0, "outros": 0}
	for product in store.get_products("", "all", false):
		if typeof(product) != TYPE_DICTIONARY:
			continue
		var item := product as Dictionary
		var operator_key := _assistant_operator_key(str(item.get("operator", "")))
		counts[operator_key] = int(counts.get(operator_key, 0)) + 1
		if _status_key(item) == "instalado":
			installed[operator_key] = int(installed.get(operator_key, 0)) + 1
	if wanted != "":
		return "Operadora %s na base %s: %d cadastro(s), %d instalado(s)." % [wanted.to_upper(), selected_branch_name, int(counts.get(wanted, 0)), int(installed.get(wanted, 0))]
	return "Operadoras na base %s: Claro %d, Vivo %d, Tim %d, outros/sem operadora %d." % [selected_branch_name, int(counts.get("claro", 0)), int(counts.get("vivo", 0)), int(counts.get("tim", 0)), int(counts.get("outros", 0))]


func _assistant_branch_summary() -> String:
