func _refresh_table() -> void:
	if table_body == null or not is_instance_valid(table_body):
		return

	_hide_search_busy()
	var products := _filtered_products()
	var total_count := products.size()
	var existing_rows := {}
	var disposable_nodes: Array[Node] = []
	for child in table_body.get_children():
		if child == online_lookup_panel:
			continue
		var child_sku := str(child.get_meta("inventory_sku", ""))
		if child_sku != "" and not existing_rows.has(child_sku):
			existing_rows[child_sku] = child
		else:
			disposable_nodes.append(child)
	for node in disposable_nodes:
		_remove_inventory_table_node(node)
	var table_has_active_editor := false
	for row_node in existing_rows.values():
		if row_node is Control and _inventory_row_is_being_edited(row_node as Control):
			table_has_active_editor = true
			break

	if products.is_empty():
		_sync_inventory_visible_scope([])
		_invalidate_visible_inventory_device_cycle()
		for row_node in existing_rows.values():
			_remove_inventory_table_node(row_node as Node)
		table_row_nodes.clear()
		table_row_signatures.clear()
		var empty := _inventory_empty_row()
		table_body.add_child(empty)
		_attach_online_lookup_panel_to_table()
		_refresh_table_pager(0, 0, 0, 0)
		_set_search_idle_hint()
		return

	var page_count := ceili(float(total_count) / float(TABLE_PAGE_SIZE))
	table_current_page = clampi(table_current_page, 0, maxi(page_count - 1, 0))
	var start_index := table_current_page * TABLE_PAGE_SIZE
	var end_index := mini(start_index + TABLE_PAGE_SIZE, total_count)
	var visible_products: Array[Dictionary] = []
	var next_row_nodes := {}
	var next_signatures := {}

	for index in range(start_index, end_index):
		var product := products[index] as Dictionary
		var sku := str(product.get("sku", ""))
		var signature := _inventory_row_signature(product)
		var row_node := existing_rows.get(sku) as Control
		if row_node == null \
				or not is_instance_valid(row_node) \
				or (
					str(row_node.get_meta("inventory_signature", "")) != signature
					and not _inventory_row_is_being_edited(row_node)
				):
			var replacement := _make_table_row(product)
			if row_node != null and is_instance_valid(row_node):
				_remove_inventory_table_node(row_node)
			table_body.add_child(replacement)
			row_node = replacement
		if row_node.get_parent() != table_body:
			table_body.add_child(row_node)
		if not table_has_active_editor:
			table_body.move_child(row_node, index - start_index)
		next_row_nodes[sku] = row_node
		next_signatures[sku] = str(row_node.get_meta("inventory_signature", signature))
		visible_products.append(product)

	for sku in existing_rows:
		if not next_row_nodes.has(sku):
			_remove_inventory_table_node(existing_rows.get(sku) as Node)
	table_row_nodes = next_row_nodes
	table_row_signatures = next_signatures

	_sync_inventory_visible_scope(visible_products)
	_attach_online_lookup_panel_to_table()
	_refresh_table_pager(total_count, page_count, start_index, end_index)
	_set_search_idle_hint()
	if not _is_regional_branch():
		_schedule_sga_status_for_products(visible_products)
		schedule_visible_inventory_device_cycle(visible_products, start_index, end_index, total_count)


func _inventory_empty_row() -> Label:
	var empty := Label.new()
	empty.set_meta("inventory_empty", true)
	empty.text = "Nenhum equipamento encontrado."
	empty.custom_minimum_size = Vector2(0, 56)
	empty.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	empty.add_theme_color_override("font_color", MUTED)
	return empty


func _remove_inventory_table_node(node: Node) -> void:
	if node == null or not is_instance_valid(node) or node == online_lookup_panel:
		return
	if node.get_parent() != null:
		node.get_parent().remove_child(node)
	node.queue_free()


func _inventory_row_is_being_edited(row_node: Control) -> bool:
	if row_node == null or not is_instance_valid(row_node):
		return false
	var focus_owner := get_viewport().gui_get_focus_owner()
	var current: Node = focus_owner
	while current != null:
		if current == row_node:
			return true
		current = current.get_parent()
	return false


func _inventory_row_signature(product: Dictionary) -> String:
	var arya_key := _arya_product_query_key(product)
	var sga_key := _sga_product_cache_key(product)
	var serial := _digits_only(_location_serial_for_product(product))
	var payload := {
		"product": product,
		"exact": _is_exact_search_match(product),
		"sga_visible": _sga_search_is_active(),
		"arya": arya_status_cache.get(arya_key, {}),
		"arya_busy": bool(arya_status_busy.get(arya_key, false)),
		"sga": sga_status_cache.get(sga_key, {}),
		"sga_busy": bool(sga_status_busy.get(sga_key, false)),
		"location": location_status_cache.get(serial, {}),
		"location_busy": bool(location_status_busy.get(serial, false)),
	}
	return str(JSON.stringify(payload).hash())


func _attach_online_lookup_panel_to_table() -> void:
	if table_body == null or online_lookup_panel == null:
		return
	if online_lookup_panel.get_parent() != null and online_lookup_panel.get_parent() != table_body:
		online_lookup_panel.get_parent().remove_child(online_lookup_panel)
	if online_lookup_panel.get_parent() == null:
		table_body.add_child(online_lookup_panel)
	else:
		table_body.move_child(online_lookup_panel, table_body.get_child_count() - 1)


