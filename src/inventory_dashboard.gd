	summary.add_theme_constant_override("separation", 8)
	footer.add_child(summary)
	var installed_total := int(stats.get("installed", 0))
	var with_operator := total - int(operators.get("Sem operadora", 0))
	summary.add_child(_make_operator_summary_metric("Total de aparelhos", str(total), "100%", BLUE_DARK))
	summary.add_child(_make_operator_summary_metric("Com operadora", str(with_operator), _dashboard_percent_text(with_operator, total), GREEN))
	summary.add_child(_make_operator_summary_metric("Sem operadora", str(int(operators.get("Sem operadora", 0))), _dashboard_percent_text(int(operators.get("Sem operadora", 0)), total), YELLOW))
	var donut_host := Control.new()
	donut_host.custom_minimum_size = Vector2(150, 145)
	footer.add_child(donut_host)
	var donut := DashboardOperatorDonut.new()
	donut.set_segments(donut_segments)
	donut.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	donut_host.add_child(donut)
	var donut_center := CenterContainer.new()
	donut_center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	donut_host.add_child(donut_center)
	var donut_text := VBoxContainer.new()
	donut_text.alignment = BoxContainer.ALIGNMENT_CENTER
	donut_text.mouse_filter = Control.MOUSE_FILTER_IGNORE
	donut_center.add_child(donut_text)
	var donut_total := Label.new()
	donut_total.text = str(total)
	donut_total.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	donut_total.add_theme_font_override("font", UI_FONT)
	donut_total.add_theme_font_size_override("font_size", 20)
	donut_total.add_theme_color_override("font_color", TEXT)
	donut_text.add_child(donut_total)
	var donut_caption := Label.new()
	donut_caption.text = "Total"
	donut_caption.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	donut_caption.add_theme_font_size_override("font_size", 10)
	donut_caption.add_theme_color_override("font_color", MUTED)
	donut_text.add_child(donut_caption)

	return panel


