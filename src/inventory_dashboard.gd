func _play_startup_animation() -> void:
	if is_instance_valid(app_background):
		var bg_tween := app_background.create_tween()
		bg_tween.tween_property(app_background, "modulate:a", 1.0, MOTION_FAST).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)

	if is_instance_valid(topbar_panel):
		var top_tween := topbar_panel.create_tween()
		top_tween.set_parallel(true)
		top_tween.tween_property(topbar_panel, "modulate:a", 1.0, MOTION_BASE).set_delay(0.04).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		top_tween.tween_property(topbar_panel, "position:y", 0.0, MOTION_SLOW).set_delay(0.04).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)

	if is_instance_valid(sidebar_panel):
		var sidebar_tween := sidebar_panel.create_tween()
		sidebar_tween.set_parallel(true)
		sidebar_tween.tween_method(_set_sidebar_width, 0.0, AppDesignSystem.SIDEBAR_WIDTH, 0.58).set_delay(0.12).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		sidebar_tween.tween_property(sidebar_panel, "modulate:a", 1.0, MOTION_BASE).set_delay(0.12).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		_animate_children_cascade(sidebar_panel, 0.045, 0.22)

	if is_instance_valid(content_area):
		var content_tween := content_area.create_tween()
		content_tween.set_parallel(true)
		content_tween.tween_property(content_area, "modulate:a", 1.0, MOTION_BASE).set_delay(0.24).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		content_tween.tween_property(content_area, "position:y", 0.0, MOTION_SLOW).set_delay(0.24).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)


func _set_sidebar_width(width: float) -> void:
	if is_instance_valid(sidebar_panel):
		sidebar_panel.custom_minimum_size = Vector2(width, 0)


func _animate_content_in(control: Control) -> void:
	if not is_instance_valid(control):
		return
	control.modulate.a = 0.0
	control.position.y = 8.0
	var tween := control.create_tween()
	tween.set_parallel(true)
	tween.tween_property(control, "modulate:a", 1.0, MOTION_BASE).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(control, "position:y", 0.0, MOTION_SLOW).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	_animate_children_cascade(control, 0.035, 0.04)


func _animate_children_cascade(parent: Control, step_delay: float, base_delay: float = 0.0) -> void:
	var index := 0
	for child in parent.get_children():
		if child is Control:
			var control := child as Control
			control.modulate.a = 0.0
			control.scale = Vector2(0.985, 0.985)
			control.pivot_offset = control.size * 0.5
			var tween := control.create_tween()
			tween.set_parallel(true)
			var delay := base_delay + step_delay * float(index)
			tween.tween_property(control, "modulate:a", 1.0, MOTION_BASE).set_delay(delay).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			tween.tween_property(control, "scale", Vector2.ONE, MOTION_SLOW).set_delay(delay).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
			index += 1


