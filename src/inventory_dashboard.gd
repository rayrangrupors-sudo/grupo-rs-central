func _build_monitor_4g_signal_forecast(serial: String, location: Dictionary) -> Dictionary:
	var clean_serial := _digits_only(serial)
	var target_plate := _normalize_location_plate(str(location.get("plate", "")))
	for device in _smart_4g_all_devices():
		var device_serial := _digits_only(str(device.get("serial", "")))
		var device_plate := _normalize_location_plate(str(device.get("plate", "")))
		if clean_serial == "" or (device_serial != clean_serial and (target_plate == "" or device_plate != target_plate)):
			continue
		var score := int(device.get("estimated_signal_score", 0))
		if score <= 0:
			continue
		var label := str(device.get("signal_label", "")).strip_edges()
		if label == "" or label == "Sem leitura":
			label = _monitor_4g_forecast_label(score)
		var operator_name := str(device.get("operator", "")).strip_edges()
		var network := str(device.get("network", "4G")).strip_edges()
		if network == "":
			network = "4G"
		var confidence := str(device.get("signal_confidence", "Media")).strip_edges()
		if confidence == "":
			confidence = "Media"
		var updated_at := str(device.get("last_communication", smart_4g_snapshot.get("updated_at", ""))).strip_edges()
		var tower_distance := float(device.get("anatel_station_distance_km", -1.0))
		var detail := "Fonte: Monitor 4G"
		if operator_name != "":
			detail += " | %s %s" % [operator_name, network]
		detail += " | Confianca %s" % confidence
		if updated_at != "":
			detail += " | Atualizado %s" % updated_at
		return {
			"label": label,
			"detail": detail,
			"color": _monitor_4g_forecast_color(score),
			"score": score,
			"confidence": confidence,
			"operator": operator_name,
			"network": network,
			"tower_distance_km": tower_distance,
			"source": "Monitor 4G",
			"is_estimate": false,
		}

	return _build_monitor_4g_coverage_forecast(clean_serial, location)


func _build_monitor_4g_coverage_forecast(serial: String, location: Dictionary) -> Dictionary:
	var latitude := str(location.get("lat", "0")).replace(",", ".").to_float()
	var longitude := str(location.get("lng", "0")).replace(",", ".").to_float()
	if not is_finite(latitude) or not is_finite(longitude) or (latitude == 0.0 and longitude == 0.0):
		return _monitor_4g_signal_without_data()
	_ensure_smart_4g_anatel()
	if smart_4g_anatel == null:
		return _monitor_4g_signal_without_data()

	var operator_name := _monitor_4g_operator_for_serial(serial)
	var seed: Array[Dictionary] = [{
		"serial": serial,
		"plate": str(location.get("plate", "")),
		"operator": operator_name,
		"network": "4G",
		"latitude": latitude,
		"longitude": longitude,
		"location_available": true,
		"platform_delay_minutes": -1,
		"estimated_signal_score": 0,
	}]
	var enriched_variant: Variant = smart_4g_anatel.call("enrich_devices", seed)
	if typeof(enriched_variant) != TYPE_ARRAY or (enriched_variant as Array).is_empty():
		return _monitor_4g_signal_without_data()
	var enriched: Dictionary = (enriched_variant as Array)[0] as Dictionary
	var profiles: Dictionary = enriched.get("operator_profiles", {})
	var profile: Dictionary = profiles.get(operator_name, {})
	if profile.is_empty():
		var recommended := str(enriched.get("recommended_operator", "")).strip_edges()
		profile = profiles.get(recommended, {})
		if operator_name == "":
			operator_name = recommended
	if profile.is_empty():
		return _monitor_4g_signal_without_data()

	var score := int(profile.get("score", enriched.get("recommendation_score", 0)))
	var confidence := int(profile.get("confidence", enriched.get("recommendation_confidence", 0)))
	if score <= 0:
		return _monitor_4g_signal_without_data()
	var detail := "Fonte: Monitor 4G | Cobertura cadastrada"
	if operator_name != "":
		detail += " | %s 4G" % operator_name
	var distance := float(profile.get("nearest_tower_km", -1.0))
	if distance >= 0.0:
		detail += " | ERB mais proxima %.1f km" % distance
	detail += " | Confianca %d%%" % confidence
	return {
		"label": _monitor_4g_coverage_label(score),
		"detail": detail,
		"color": _monitor_4g_forecast_color(score),
		"score": score,
		"confidence": confidence,
		"operator": operator_name,
		"network": "4G",
		"tower_distance_km": distance,
		"source": "Monitor 4G",
		"is_estimate": true,
	}


func _monitor_4g_operator_for_serial(serial: String) -> String:
	for device in _smart_4g_all_devices():
		if _digits_only(str(device.get("serial", ""))) == _digits_only(serial):
			return str(device.get("operator", "")).strip_edges()
	if store == null:
		return ""
	for product_value in store.get_products("", "all", false):
		if typeof(product_value) != TYPE_DICTIONARY:
			continue
		var product := product_value as Dictionary
		if _digits_only(_location_serial_for_product(product)) != _digits_only(serial):
			continue
		return str(product.get("operator", product.get("operadora", ""))).strip_edges()
	return ""


func _monitor_4g_signal_without_data() -> Dictionary:
	return {
		"label": "Sem previsao",
		"detail": "Monitor 4G ainda nao possui leitura ou cobertura para esta posicao.",
		"color": MUTED,
		"score": 0,
		"confidence": 0,
		"tower_distance_km": -1.0,
		"source": "Monitor 4G",
		"is_estimate": true,
	}


func _monitor_4g_forecast_label(score: int) -> String:
	if score >= 85:
		return "Excelente"
	if score >= 65:
		return "Boa"
	if score >= 45:
		return "Atencao"
	return "Possivel problema"


func _monitor_4g_coverage_label(score: int) -> String:
	if score >= 78:
		return "Forte"
	if score >= 58:
		return "Boa"
	if score >= 38:
		return "Fraca"
	return "Insuficiente"


func _monitor_4g_forecast_color(score: int) -> Color:
	if score >= 65:
		return GREEN
	if score >= 45:
		return YELLOW
	return RED


func _monitor_4g_signal_display_text(value: Variant) -> String:
	if typeof(value) != TYPE_DICTIONARY:
		return "Sem previsao"
	var signal_data := value as Dictionary
	var text_value := str(signal_data.get("label", "Sem previsao"))
	var detail := str(signal_data.get("detail", "")).strip_edges()
	if detail != "":
		text_value += " - %s" % detail
	return text_value


func _location_monitoring_status(location: Dictionary) -> Dictionary:
	var updated_at := str(location.get("updated_at", "")).strip_edges()
	var hours := _hours_since_grupo_rs_datetime(updated_at)
	if updated_at == "" or hours < 0.0:
		return {"label": "Sem data", "color": MUTED}
	if hours >= 24.0:
		return {"label": "Desatualizado", "color": Color("#d97706")}

	var ignition_state := _location_ignition_state(location.get("ignition", null))
	if ignition_state == 1:
		return {"label": "Ligado", "color": GREEN}
	if ignition_state == 0:
		return {"label": "Desligado", "color": Color("#dc3545")}
	var monitoring_status := str(location.get("monitoring_status", "")).strip_edges().to_lower()
	if monitoring_status.contains("movimento") or monitoring_status.contains("ligad") or monitoring_status == "on":
		return {"label": "Ligado", "color": GREEN}
	if monitoring_status.contains("parado") or monitoring_status.contains("deslig") or monitoring_status == "off":
		return {"label": "Parado", "color": RED}
	var speed := str(location.get("speed", "0")).replace(",", ".").strip_edges()
	if speed.is_valid_float() and speed.to_float() > 0.0:
		return {"label": "Ligado", "color": GREEN}

	return {"label": "Sem status", "color": MUTED}


func _location_ignition_state(value: Variant) -> int:
	if value == null:
		return -1
	match typeof(value):
		TYPE_BOOL:
			return 1 if bool(value) else 0
		TYPE_INT:
			return 1 if int(value) > 0 else 0
		TYPE_FLOAT:
			return 1 if float(value) > 0.0 else 0

	var text_value := str(value).strip_edges().to_lower()
	if text_value == "":
		return -1
	if text_value.contains("deslig") or text_value in ["0", "false", "off", "nao", "no"]:
		return 0
	if text_value.contains("ligad") or text_value in ["1", "true", "on", "sim", "yes"]:
		return 1
	if text_value.is_valid_float():
		return 1 if float(text_value) > 0.0 else 0
	return -1


func _location_ignition_is_on(value: Variant) -> bool:
	return _location_ignition_state(value) == 1


func _lookup_arya_signal_for_serial(serial: String) -> Dictionary:
	var fake_product := {
		"sku": serial,
		"imei": serial,
		"equipment_number": serial,
	}
	var resolved := await _resolve_arya_iccid_for_product(fake_product)
	if not bool(resolved.get("ok", false)):
		return {
			"label": "Nao verificado",
			"detail": str(resolved.get("message", "Nao foi possivel consultar Arya.")),
			"color": MUTED,
		}

	var apn := str(resolved.get("apn", "")).strip_edges()
	if not _apn_is_hinova(apn):
		return {
			"label": "Nao verificado",
			"detail": "APN %s no Grupo RS" % _blank(apn),
			"color": MUTED,
		}

	var inventory := await _lookup_arya_inventory_data(str(resolved.get("iccid", "")))
	if not bool(inventory.get("ok", false)):
		return {
			"label": "Nao verificado",
			"detail": str(inventory.get("message", "Arya indisponivel.")),
			"color": MUTED,
		}

	var parsed: Dictionary = inventory.get("parsed", {})
	return _arya_signal_status_from_inventory(parsed, str(resolved.get("iccid", "")))


func _arya_signal_status_from_inventory(parsed: Dictionary, iccid: String) -> Dictionary:
	var status := str(parsed.get("status", "desconhecido"))
	var last_update := str(parsed.get("last_conn_update", "")).strip_edges()
	var network := _arya_rat_label(parsed.get("rat_type", ""))
	var detail := "ICCID %s" % iccid
	if last_update != "":
		detail += " | Ultima conexao %s" % last_update
	if network != "":
		detail += " | Rede %s" % network

	if status == "offline":
		return {"label": "Sem sinal", "detail": detail, "color": RED}
	if status != "online":
		return {"label": "Nao verificado", "detail": detail, "color": MUTED}
	if network == "2G":
		return {"label": "Fraco", "detail": detail, "color": YELLOW}
	return {"label": "Bom", "detail": detail, "color": GREEN}


func _arya_rat_label(value: Variant) -> String:
	var text_value := str(value).strip_edges()
	match text_value:
		"6":
			return "4G"
		"3":
			return "3G"
		"2":
			return "2G"
		_:
			return text_value


