func _legacy_clear_equipment_events_fields(html: String) -> Dictionary:
	var button_regex := RegEx.new()
	if button_regex.compile("(?is)<button[^>]*>.*?</button>") != OK:
		return {}
	for match_result in button_regex.search_all(html):
		var button_html := match_result.get_string(0)
		if _search_key(_clean_html_text(button_html)) != _search_key("Equipamentos"):
			continue
		var actions := _legacy_postback_actions(button_html)
		if actions.size() != 1:
			return {}
		return {
			"__EVENTTARGET": str(actions[0].get("target", "")),
			"__EVENTARGUMENT": str(actions[0].get("argument", "")),
		}
	return {}


func _clear_legacy_grupo_rs_equipment_events(serial: String, stage_callback: Callable = Callable()) -> Dictionary:
	var clean_serial := serial.strip_edges()
	if clean_serial == "":
		return {"ok": false, "message": "Numero de serie vazio."}

	var previous_mode := selected_branch_grupo_rs_mode
	var previous_base_url := selected_branch_grupo_rs_base_url
	var previous_platform_url := selected_branch_grupo_rs_platform_url
	selected_branch_grupo_rs_mode = "legacy"
	selected_branch_grupo_rs_base_url = _legacy_grupo_rs_delete_base_url()
	selected_branch_grupo_rs_platform_url = _legacy_grupo_rs_delete_platform_url()
	var result := await _clear_legacy_grupo_rs_equipment_events_record(clean_serial, stage_callback)
	selected_branch_grupo_rs_mode = previous_mode
	selected_branch_grupo_rs_base_url = previous_base_url
	selected_branch_grupo_rs_platform_url = previous_platform_url
	return result


func _clear_legacy_grupo_rs_equipment_events_record(serial: String, stage_callback: Callable = Callable()) -> Dictionary:
	_emit_legacy_delete_stage(stage_callback, "equipment", "active", "Localizando equipamento")
	var search_response := await _legacy_grupo_rs_postback("/Cadastros/EquipamentosListar", {
		"__EVENTTARGET": "btnPsq",
		"__EVENTARGUMENT": "",
		"ddlStatus": "A",
		"txtPsq": serial,
	})
	if not bool(search_response.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel pesquisar o equipamento no sistema antigo: %s" % str(search_response.get("message", ""))}
	var chosen: Dictionary = {}
	for row in _parse_legacy_grupo_rs_equipment_rows(str(search_response.get("body", ""))):
		if _search_key(str(row.get("serial", row.get("equipment_number", "")))) == _search_key(serial):
			if not chosen.is_empty():
				return {"ok": false, "message": "Mais de um equipamento ativo respondeu pela serie %s." % serial}
			chosen = row
	if chosen.is_empty():
		return {"ok": false, "message": "O equipamento %s nao esta ativo no sistema antigo; os eventos nao foram alterados." % serial}
	var edit_id := str(chosen.get("edit_id", "")).strip_edges()
	if edit_id == "":
		return {"ok": false, "message": "O equipamento foi encontrado sem codigo de edicao."}

	var path := "/Cadastros/EquipamentosView/%s" % edit_id.uri_encode()
	var page := await _legacy_grupo_rs_get(path)
	if not bool(page.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel abrir o equipamento para limpar os eventos."}
	var html := str(page.get("body", ""))
	if _search_key(_extract_legacy_input_value(html, "txtNumeroSerie")) != _search_key(serial):
		return {"ok": false, "message": "A tela aberta nao confirmou a serie esperada. A limpeza foi bloqueada."}
	var clear_fields := _legacy_clear_equipment_events_fields(html)
	if clear_fields.is_empty():
		return {"ok": false, "message": "O botao Equipamentos, usado para limpar eventos, nao foi identificado."}

	_emit_legacy_delete_stage(stage_callback, "history", "active", "Solicitando limpeza dos eventos")
	var question := await _legacy_grupo_rs_postback_from_html(path, html, clear_fields)
	if not bool(question.get("ok", false)):
		return {"ok": false, "message": "O sistema antigo nao abriu a confirmacao de limpeza: %s" % str(question.get("message", ""))}
	var question_html := str(question.get("body", ""))
	var question_key := _search_key(_clean_html_text(question_html))
	if not question_key.contains(_search_key("excluir todos os eventos deste equipamento")):
		return {"ok": false, "message": "A confirmacao recebida nao era a exclusao de eventos. A operacao foi bloqueada."}
	var confirmation_fields := _legacy_confirmation_fields(question_html, ["sim"])
	if confirmation_fields.is_empty():
		return {"ok": false, "message": "O botao Sim da limpeza de eventos nao foi identificado."}
	var cleared := await _legacy_grupo_rs_postback_from_html(path, question_html, confirmation_fields)
	if not bool(cleared.get("ok", false)):
		return {"ok": false, "message": "Falha ao confirmar a limpeza de eventos: %s" % str(cleared.get("message", ""))}
	var cleared_html := str(cleared.get("body", ""))
	if not _search_key(_clean_html_text(cleared_html)).contains(_search_key("Eventos Deletados com sucesso")):
		return {"ok": false, "message": "O sistema antigo nao confirmou que os eventos foram apagados."}
	_emit_legacy_delete_stage(stage_callback, "history", "done", "Eventos removidos")

	_emit_legacy_delete_stage(stage_callback, "save", "active", "Salvando equipamento preservado")
	var saved := await _legacy_grupo_rs_postback_from_html(path, cleared_html, {
		"__EVENTTARGET": "btnSalvar",
		"__EVENTARGUMENT": "",
	})
	if not bool(saved.get("ok", false)):
		return {"ok": false, "message": "Os eventos foram apagados, mas o equipamento nao respondeu ao salvar: %s" % str(saved.get("message", ""))}
	var saved_html := str(saved.get("body", ""))
	if not _search_key(_clean_html_text(saved_html)).contains(_search_key("Equipamento salvo com sucesso")):
		return {"ok": false, "message": "Os eventos foram apagados, mas o portal nao confirmou o salvamento do equipamento."}
	var preserved := await _legacy_grupo_rs_equipment_exists(serial, 3, 1.0)
	if not bool(preserved.get("ok", false)) or not bool(preserved.get("exists", false)):
		return {"ok": false, "message": "O portal nao confirmou que o equipamento permaneceu ativo apos a limpeza."}
	_emit_legacy_delete_stage(stage_callback, "save", "done", "Equipamento mantido ativo")
	return {
		"ok": true,
		"message": "Eventos antigos removidos; equipamento %s preservado e salvo." % serial,
		"equipment_id": edit_id,
	}


func _delete_legacy_grupo_rs_equipment(serial: String, stage_callback: Callable = Callable(), link_code: String = "") -> Dictionary:
	var clean_serial := serial.strip_edges()
	if clean_serial == "":
		return {"ok": false, "message": "Numero de serie vazio."}

	_emit_legacy_delete_stage(stage_callback, "prepare", "active", "Preparando base antiga")
	var previous_mode := selected_branch_grupo_rs_mode
	var previous_base_url := selected_branch_grupo_rs_base_url
	var previous_platform_url := selected_branch_grupo_rs_platform_url

	selected_branch_grupo_rs_mode = "legacy"
	selected_branch_grupo_rs_base_url = _legacy_grupo_rs_delete_base_url()
	selected_branch_grupo_rs_platform_url = _legacy_grupo_rs_delete_platform_url()
	_emit_legacy_delete_stage(stage_callback, "prepare", "done", "Base antiga pronta")

	var result: Dictionary = {}
	var messages: Array[String] = []
	_emit_legacy_delete_stage(stage_callback, "link", "active", "Pesquisando vinculo com placa")
	var unlink_result := await _legacy_grupo_rs_unlink_equipment(clean_serial, link_code)
	if not bool(unlink_result.get("ok", false)):
		_emit_legacy_delete_stage(stage_callback, "link", "failed", "Vinculo falhou")
		result = unlink_result
	else:
		_emit_legacy_delete_stage(stage_callback, "link", "done", "Vinculo liberado")
		messages.append(str(unlink_result.get("message", "Vinculo verificado.")))
		var delete_result := await _legacy_grupo_rs_delete_equipment_record(clean_serial, true, stage_callback)
		if not bool(delete_result.get("ok", false)):
			result = delete_result
		else:
			messages.append(str(delete_result.get("message", "Cadastro excluido.")))
			result = {
				"ok": true,
				"pending_verify": bool(delete_result.get("pending_verify", false)),
				"message": "\n".join(messages),
			}

	selected_branch_grupo_rs_mode = previous_mode
	selected_branch_grupo_rs_base_url = previous_base_url
	selected_branch_grupo_rs_platform_url = previous_platform_url
	return result


func _delete_legacy_grupo_rs_plate(plate: String, stage_callback: Callable = Callable()) -> Dictionary:
	var clean_plate := plate.strip_edges()
	if clean_plate == "":
		return {"ok": false, "message": "Placa vazia."}

	_emit_legacy_delete_stage(stage_callback, "prepare", "active", "Preparando base antiga")
	var previous_mode := selected_branch_grupo_rs_mode
	var previous_base_url := selected_branch_grupo_rs_base_url
	var previous_platform_url := selected_branch_grupo_rs_platform_url

	selected_branch_grupo_rs_mode = "legacy"
	selected_branch_grupo_rs_base_url = _legacy_grupo_rs_delete_base_url()
	selected_branch_grupo_rs_platform_url = _legacy_grupo_rs_delete_platform_url()
	_emit_legacy_delete_stage(stage_callback, "prepare", "done", "Base antiga pronta")
	_emit_legacy_delete_stage(stage_callback, "link", "skipped", "Nao usa vinculo")
	_emit_legacy_delete_stage(stage_callback, "equipment", "skipped", "Somente placa")
	_emit_legacy_delete_stage(stage_callback, "plate", "active", "Excluindo %s" % clean_plate)

	var result := await _legacy_grupo_rs_delete_vehicle_record(clean_plate, true)
	if bool(result.get("ok", false)):
		_emit_legacy_delete_stage(stage_callback, "plate", "done", "Placa removida")
		_emit_legacy_delete_stage(stage_callback, "verify", "done", "Confirmado")
	else:
		_emit_legacy_delete_stage(stage_callback, "plate", "failed", "Placa falhou")
		_emit_legacy_delete_stage(stage_callback, "verify", "failed", "Revisar")

	selected_branch_grupo_rs_mode = previous_mode
	selected_branch_grupo_rs_base_url = previous_base_url
	selected_branch_grupo_rs_platform_url = previous_platform_url
	return result


func _emit_legacy_delete_stage(stage_callback: Callable, stage_key: String, status: String, detail: String = "") -> void:
	if stage_callback.is_valid():
		stage_callback.call(stage_key, status, detail)


func _legacy_grupo_rs_unlink_equipment(serial: String, link_code: String = "") -> Dictionary:
	var page := await _legacy_grupo_rs_get("/Cadastros/VeiculosEquipamentosListar")
	if not bool(page.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel abrir vinculos no sistema antigo: %s" % str(page.get("message", ""))}

	var found := await _legacy_grupo_rs_find_link_row(serial, str(page.get("body", "")), link_code)
	if not bool(found.get("ok", false)):
		return {"ok": false, "message": str(found.get("message", "Nao foi possivel pesquisar vinculo no sistema antigo."))}
	if str(found.get("row_html", "")) == "":
		if _digits_only(link_code) != "":
			return {"ok": false, "message": "Nao encontrei a associacao codigo %s para desvincular o aparelho %s. Confira se ela ainda aparece em Veiculo x Equipamento." % [_digits_only(link_code), serial]}
		return {"ok": true, "message": "Nenhum vinculo com placa encontrado para desvincular."}

	var html := str(found.get("html", ""))
	var row_html := str(found.get("row_html", ""))
	var search_fields: Dictionary = found.get("fields", {})
	var button_name := _legacy_image_button_name_by_title(row_html, "desativar")
	var action := _legacy_last_postback_action(row_html)
	if button_name == "" and action.is_empty():
		return {"ok": false, "message": "Encontrei o vinculo, mas nao consegui identificar o botao vermelho de desativar."}

	var unlink_fields := search_fields.duplicate()
	unlink_fields["__EVENTTARGET"] = ""
	unlink_fields["__EVENTARGUMENT"] = ""
	if button_name != "":
		unlink_fields["%s.x" % button_name] = "8"
		unlink_fields["%s.y" % button_name] = "8"
	else:
		unlink_fields["__EVENTTARGET"] = str(action.get("target", ""))
		unlink_fields["__EVENTARGUMENT"] = str(action.get("argument", ""))

	var unlink_response := await _legacy_grupo_rs_postback_from_html("/Cadastros/VeiculosEquipamentosListar", html, unlink_fields)
	if not bool(unlink_response.get("ok", false)):
		return {"ok": false, "message": "Falha ao desvincular placa: %s" % str(unlink_response.get("message", ""))}
	if _legacy_grupo_rs_page_is_login(str(unlink_response.get("body", ""))):
		return {"ok": false, "message": "O sistema antigo pediu login durante a desvinculacao."}
	var unlink_html := str(unlink_response.get("body", ""))
	var confirm_unlink_fields := _legacy_confirmation_fields(unlink_html, ["sim", "confirmar", "desativar"])
	if not confirm_unlink_fields.is_empty():
		unlink_response = await _legacy_grupo_rs_postback_from_html("/Cadastros/VeiculosEquipamentosListar", unlink_html, confirm_unlink_fields)
		if not bool(unlink_response.get("ok", false)):
			return {"ok": false, "message": "Falha ao confirmar a desvinculacao: %s" % str(unlink_response.get("message", ""))}
		if _legacy_grupo_rs_page_is_login(str(unlink_response.get("body", ""))):
			return {"ok": false, "message": "O sistema antigo pediu login durante a confirmacao da desvinculacao."}

	var verify_found := await _legacy_grupo_rs_find_link_row(serial, "", link_code)
	if bool(verify_found.get("ok", false)) and str(verify_found.get("row_html", "")) != "":
		var row := verify_found.get("row", {}) as Dictionary
		var plate := str(row.get("plate", ""))
		var client := str(row.get("client", ""))
		var plate_text := " com placa %s" % plate if plate != "" else ""
		var client_text := " em %s" % client if client != "" else ""
		return {
			"ok": false,
			"message": "O sistema antigo manteve a associacao%s%s mesmo apos o cadeado vermelho. A exclusao do equipamento fica bloqueada ate essa associacao ser removida no Grupo RS antigo." % [plate_text, client_text],
		}

	return {"ok": true, "message": "Vinculo com placa desativado ou removido."}


func _legacy_grupo_rs_find_link_row(serial: String, initial_html: String = "", link_code: String = "") -> Dictionary:
	var base_fields := {
		"__EVENTTARGET": "btnPsq",
		"__EVENTARGUMENT": "",
		"txtPsq": serial,
	}

	var response := await _legacy_grupo_rs_postback("/Cadastros/VeiculosEquipamentosListar", base_fields)
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel pesquisar vinculo no sistema antigo: %s" % str(response.get("message", ""))}

	var html := str(response.get("body", ""))
	var found := _legacy_link_row_from_html(html, serial, link_code)
	if not found.is_empty():
		found["ok"] = true
		found["html"] = html
		found["fields"] = base_fields
		return found

	var option_source := initial_html if initial_html != "" else html
	if option_source == "":
		var page := await _legacy_grupo_rs_get("/Cadastros/VeiculosEquipamentosListar")
		if bool(page.get("ok", false)):
			option_source = str(page.get("body", ""))

	var options := _legacy_prioritized_link_client_options(_legacy_select_options(option_source, "ddlCliente"))
	var seen_values := {}
	for option in options:
		var value := str(option.get("value", "")).strip_edges()
		if value == "" or seen_values.has(value):
			continue
		seen_values[value] = true
		var fields := base_fields.duplicate()
		fields["ddlCliente"] = value
		response = await _legacy_grupo_rs_postback("/Cadastros/VeiculosEquipamentosListar", fields)
		if not bool(response.get("ok", false)):
			continue
		html = str(response.get("body", ""))
		found = _legacy_link_row_from_html(html, serial, link_code)
		if found.is_empty():
			continue
		var row := found.get("row", {}) as Dictionary
		row["client"] = str(option.get("label", ""))
		found["row"] = row
		found["ok"] = true
		found["html"] = html
		found["fields"] = fields
		return found

	return {
		"ok": true,
		"row_html": "",
		"html": html,
		"fields": base_fields,
		"row": {},
	}


func _legacy_link_row_from_html(html: String, serial: String, link_code: String = "") -> Dictionary:
	var serial_key := _search_key(serial)
	var code_key := _digits_only(link_code)
	var row_regex := RegEx.new()
	if row_regex.compile("(?is)<tr[^>]*>(.*?)</tr>") != OK:
		return {}
	for match_result in row_regex.search_all(html):
		var row_html := match_result.get_string(0)
		var cells := _html_table_cells(row_html)
		if cells.size() < 3:
			continue
		var code := str(cells[0]).strip_edges()
		var plate := str(cells[1]).strip_edges()
		var row_serial := str(cells[2]).strip_edges()
		if code == "" or plate == "" or not _looks_like_bulk_delete_serial(row_serial):
			continue
		var code_matches := code_key != "" and _digits_only(code) == code_key
		var serial_matches := serial_key != "" and _search_key(row_serial) == serial_key
		if not code_matches and not serial_matches:
			continue
		return {
			"row_html": row_html,
			"row": {
				"code": code,
				"plate": plate,
				"serial": row_serial,
			},
		}
	return {}


func _legacy_select_options(html: String, select_id_or_name: String) -> Array[Dictionary]:
	var options: Array[Dictionary] = []
	var select_html := _regex_first_group(
		html,
		"(?is)<select[^>]+(?:id|name)=[\"']?%s[\"']?[^>]*>(.*?)</select>" % select_id_or_name
	)
	if select_html == "":
		return options
	var option_regex := RegEx.new()
	if option_regex.compile("(?is)<option[^>]*>(.*?)</option>") != OK:
		return options
	for match_result in option_regex.search_all(select_html):
		var option_tag := match_result.get_string(0)
		var label := _clean_html_text(match_result.get_string(1)).strip_edges()
		var value := _decode_basic_html_entities(_html_attr(option_tag, "value")).strip_edges()
		if value == "" and label == "":
			continue
		options.append({
			"value": value,
			"label": label,
		})
	return options


func _legacy_prioritized_link_client_options(options: Array[Dictionary]) -> Array[Dictionary]:
	var ordered: Array[Dictionary] = []
	var used := {}
	var priority_keys := [_search_key("MANUTENÇÕES"), _search_key("MANUTENCOES"), _search_key("RS300")]
	for priority in priority_keys:
		for option in options:
			var value := str(option.get("value", "")).strip_edges()
			var label_key := _search_key(str(option.get("label", "")))
			if value == "" or label_key == "" or used.has(value):
				continue
			if label_key == priority or label_key.contains(priority) or priority.contains(label_key):
				ordered.append(option)
				used[value] = true
	return ordered


func _legacy_grupo_rs_client_name_for_serial(serial: String) -> String:
	var response := await _legacy_grupo_rs_postback("/Cadastros/EquipamentosListar", {
		"__EVENTTARGET": "btnPsq",
		"__EVENTARGUMENT": "",
		"ddlStatus": "A",
		"txtPsq": serial,
	})
	if not bool(response.get("ok", false)):
		return "RS300"

	var serial_key := _search_key(serial)
	for row in _parse_legacy_grupo_rs_equipment_rows(str(response.get("body", ""))):
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var candidate := row as Dictionary
		if _search_key(str(candidate.get("serial", candidate.get("equipment_number", "")))) == serial_key \
				or _search_key(str(candidate.get("equipment_number", ""))) == serial_key:
			var client_name := str(candidate.get("client", "")).strip_edges()
			return client_name if client_name != "" else "RS300"
	return "RS300"


func _legacy_grupo_rs_delete_equipment_record(serial: String, allow_vehicle_cleanup: bool = true, stage_callback: Callable = Callable()) -> Dictionary:
	_emit_legacy_delete_stage(stage_callback, "equipment", "active", "Pesquisando equipamento")
	var search_response := await _legacy_grupo_rs_postback("/Cadastros/EquipamentosListar", {
		"__EVENTTARGET": "btnPsq",
		"__EVENTARGUMENT": "",
		"ddlStatus": "A",
		"txtPsq": serial,
	})
	if not bool(search_response.get("ok", false)):
		_emit_legacy_delete_stage(stage_callback, "equipment", "failed", "Pesquisa falhou")
		return {"ok": false, "message": "Nao foi possivel pesquisar equipamento no sistema antigo: %s" % str(search_response.get("message", ""))}

	var rows := _parse_legacy_grupo_rs_equipment_rows(str(search_response.get("body", "")))
	var serial_key := _search_key(serial)
	var chosen: Dictionary = {}
	for row in rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var candidate := row as Dictionary
		if _search_key(str(candidate.get("serial", candidate.get("equipment_number", "")))) == serial_key \
				or _search_key(str(candidate.get("equipment_number", ""))) == serial_key:
			chosen = candidate
			break
	if chosen.is_empty():
		_emit_legacy_delete_stage(stage_callback, "plate", "skipped", "Sem placa")
		_emit_legacy_delete_stage(stage_callback, "equipment", "done", "Ja removido")
		_emit_legacy_delete_stage(stage_callback, "verify", "done", "Nao encontrado")
		return {"ok": true, "message": "Equipamento %s ja nao foi encontrado no sistema antigo." % serial}

	var edit_id := str(chosen.get("edit_id", "")).strip_edges()
	if edit_id == "":
		_emit_legacy_delete_stage(stage_callback, "equipment", "failed", "Sem codigo")
		return {"ok": false, "message": "O equipamento foi encontrado, mas sem codigo de edicao."}

	var path := "/Cadastros/EquipamentosView/%s" % edit_id.uri_encode()
	_emit_legacy_delete_stage(stage_callback, "equipment", "active", "Abrindo cadastro")
	var page := await _legacy_grupo_rs_get(path)
	if not bool(page.get("ok", false)):
		_emit_legacy_delete_stage(stage_callback, "equipment", "failed", "Cadastro nao abriu")
		return {"ok": false, "message": "Nao foi possivel abrir o cadastro do equipamento: %s" % str(page.get("message", ""))}

	var html := str(page.get("body", ""))
	var delete_fields := _legacy_delete_equipment_fields(html)
	if delete_fields.is_empty():
		_emit_legacy_delete_stage(stage_callback, "equipment", "failed", "Botao nao identificado")
		return {"ok": false, "message": "Nao consegui identificar o botao 'Deletar Equipamento' na tela antiga."}

	_emit_legacy_delete_stage(stage_callback, "equipment", "active", "Enviando exclusao")
	var delete_response := await _legacy_grupo_rs_postback_from_html(path, html, delete_fields)
	if not bool(delete_response.get("ok", false)):
		_emit_legacy_delete_stage(stage_callback, "equipment", "failed", "Envio falhou")
		return {"ok": false, "message": "Falha ao excluir equipamento: %s" % str(delete_response.get("message", ""))}
	if _legacy_grupo_rs_page_is_login(str(delete_response.get("body", ""))):
		_emit_legacy_delete_stage(stage_callback, "equipment", "failed", "Login solicitado")
		return {"ok": false, "message": "O sistema antigo pediu login durante a exclusao."}
	var delete_html := str(delete_response.get("body", ""))
	var confirm_delete_fields := _legacy_confirmation_fields(delete_html, ["confirmar", "sim", "deletar"])
	if not confirm_delete_fields.is_empty():
		_emit_legacy_delete_stage(stage_callback, "equipment", "active", "Confirmando exclusao")
		delete_response = await _legacy_grupo_rs_postback_from_html(path, delete_html, confirm_delete_fields)
		if not bool(delete_response.get("ok", false)):
			_emit_legacy_delete_stage(stage_callback, "equipment", "failed", "Confirmacao falhou")
			return {"ok": false, "message": "Falha ao confirmar exclusao do equipamento: %s" % str(delete_response.get("message", ""))}
		if _legacy_grupo_rs_page_is_login(str(delete_response.get("body", ""))):
			_emit_legacy_delete_stage(stage_callback, "equipment", "failed", "Login solicitado")
			return {"ok": false, "message": "O sistema antigo pediu login durante a confirmacao da exclusao."}
		delete_html = str(delete_response.get("body", ""))
	var delete_alert := _legacy_grupo_rs_alert_message(delete_html)
	var associated_plate := _legacy_grupo_rs_associated_vehicle_plate(delete_html)
	if associated_plate != "":
		_emit_legacy_delete_stage(stage_callback, "equipment", "active", "Bloqueado por placa")
		if not allow_vehicle_cleanup:
			_emit_legacy_delete_stage(stage_callback, "plate", "failed", associated_plate)
			return {
				"ok": false,
				"message": "O equipamento ainda esta associado a placa %s no sistema antigo." % associated_plate,
			}
		_emit_legacy_delete_stage(stage_callback, "plate", "active", "Excluindo %s" % associated_plate)
		var vehicle_delete := await _legacy_grupo_rs_delete_vehicle_record(associated_plate)
		if not bool(vehicle_delete.get("ok", false)):
			_emit_legacy_delete_stage(stage_callback, "plate", "failed", associated_plate)
			return {
				"ok": false,
				"message": "Nao consegui remover a placa %s antes de excluir o equipamento: %s" % [
					associated_plate,
					str(vehicle_delete.get("message", "")),
				],
			}
		_emit_legacy_delete_stage(stage_callback, "plate", "done", "Placa removida")
		_emit_legacy_delete_stage(stage_callback, "equipment", "active", "Tentando novamente")
		var retry_delete := await _legacy_grupo_rs_delete_equipment_record(serial, false, stage_callback)
		if not bool(retry_delete.get("ok", false)):
			return retry_delete
		return {
			"ok": true,
			"message": "%s\n%s" % [
				str(vehicle_delete.get("message", "Placa removida do sistema antigo.")),
				str(retry_delete.get("message", "Equipamento excluido do sistema antigo.")),
			],
		}
	else:
		_emit_legacy_delete_stage(stage_callback, "plate", "skipped", "Sem placa")

	_emit_legacy_delete_stage(stage_callback, "verify", "active", "Confirmando retirada")
	var verify_state := await _legacy_grupo_rs_equipment_exists(serial, 10, 1.5)
	if bool(verify_state.get("ok", false)) and bool(verify_state.get("exists", false)):
		if delete_alert != "":
			_emit_legacy_delete_stage(stage_callback, "verify", "failed", "Ainda encontrado")
			return {"ok": false, "message": delete_alert}
		_emit_legacy_delete_stage(stage_callback, "equipment", "done", "Exclusao enviada")
		_emit_legacy_delete_stage(stage_callback, "verify", "done", "Aguardando baixa")
		return {
			"ok": true,
			"pending_verify": true,
			"message": "Exclusao do equipamento %s enviada ao sistema antigo. Ele ainda apareceu na consulta imediata, mas o Grupo RS pode levar alguns instantes para atualizar." % serial,
		}

	_emit_legacy_delete_stage(stage_callback, "equipment", "done", "Aparelho excluido")
	_emit_legacy_delete_stage(stage_callback, "verify", "done", "Confirmado")
	return {"ok": true, "message": "Equipamento %s excluido do sistema antigo." % serial}


func _legacy_grupo_rs_equipment_exists(serial: String, attempts: int = 1, delay_seconds: float = 0.0) -> Dictionary:
	var serial_key := _search_key(serial)
	for attempt in range(maxi(attempts, 1)):
		var response := await _legacy_grupo_rs_postback("/Cadastros/EquipamentosListar", {
			"__EVENTTARGET": "btnPsq",
			"__EVENTARGUMENT": "",
			"ddlStatus": "A",
			"txtPsq": serial,
		})
		if not bool(response.get("ok", false)):
			return {"ok": false, "exists": false, "message": str(response.get("message", ""))}
		var rows := _parse_legacy_grupo_rs_equipment_rows(str(response.get("body", "")))
		var found := false
		for row in rows:
			if typeof(row) != TYPE_DICTIONARY:
				continue
			var candidate := row as Dictionary
			if _search_key(str(candidate.get("serial", candidate.get("equipment_number", "")))) == serial_key \
					or _search_key(str(candidate.get("equipment_number", ""))) == serial_key:
				found = true
				break
		if not found:
			return {"ok": true, "exists": false}
		if attempt < maxi(attempts, 1) - 1 and delay_seconds > 0.0:
			await get_tree().create_timer(delay_seconds).timeout
	return {"ok": true, "exists": true}


func _legacy_grupo_rs_associated_vehicle_plate(html: String) -> String:
	var text_value := _clean_html_text(html)
	var patterns := [
		"(?is)associa\\S*\\s+de\\s+ve\\S*culo[^\\(]*\\(\\s*([^\\)]+?)\\s*\\)",
		"(?is)associa\\S*[^\\(]{0,160}\\(\\s*([^\\)]+?)\\s*\\)",
	]
	for pattern in patterns:
		var plate := _legacy_grupo_rs_plate_candidate(_regex_first_group(text_value, pattern))
		if plate != "":
			return plate
	for pattern in patterns:
		var plate := _legacy_grupo_rs_plate_candidate(_regex_first_group(html, pattern))
		if plate != "":
			return plate
	return ""


func _legacy_grupo_rs_plate_candidate(value: String) -> String:
	var clean_value := _clean_html_text(value).strip_edges().replace("\"", "").replace("'", "")
	if clean_value == "" or clean_value.to_lower().contains("btn") or clean_value.contains(","):
		return ""
	var plate := _regex_first_group(clean_value, "(?is)([a-z0-9]{2,}\\s*-\\s*[a-z0-9]{1,})")
	return plate.strip_edges()


func _legacy_grupo_rs_delete_vehicle_record(plate: String, allow_pending: bool = false) -> Dictionary:
	var clean_plate := plate.strip_edges()
	if clean_plate == "":
		return {"ok": false, "message": "Placa vazia para exclusao no sistema antigo."}

	var search_fields := {
		"__EVENTTARGET": "btnPsq",
		"__EVENTARGUMENT": "",
		"ddlStatus": "A",
		"txtPsq": clean_plate,
	}
	var search_response := await _legacy_grupo_rs_postback("/Cadastros/VeiculosListar", search_fields)
	if not bool(search_response.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel pesquisar a placa no sistema antigo: %s" % str(search_response.get("message", ""))}

	var rows := _parse_legacy_grupo_rs_vehicle_rows(str(search_response.get("body", "")))
	var plate_key := _search_key(clean_plate)
	var chosen: Dictionary = {}
	for row in rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var candidate := row as Dictionary
		if _search_key(str(candidate.get("plate", ""))) == plate_key:
			chosen = candidate
			break
	if chosen.is_empty():
		return {"ok": true, "message": "Placa %s ja nao foi encontrada no sistema antigo." % clean_plate}

	var edit_id := str(chosen.get("code", "")).strip_edges()
	if edit_id == "":
		return {"ok": false, "message": "A placa foi encontrada, mas sem codigo de edicao."}

	var path := "/Cadastros/VeiculosView/%s" % edit_id.uri_encode()
	var page := await _legacy_grupo_rs_get(path)
	if not bool(page.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel abrir a placa %s: %s" % [clean_plate, str(page.get("message", ""))]}

	var html := str(page.get("body", ""))
	var delete_fields := _legacy_delete_vehicle_fields(html)
	if delete_fields.is_empty():
		return {"ok": false, "message": "Nao consegui identificar o botao de confirmar exclusao da placa %s." % clean_plate}

	var delete_response := await _legacy_grupo_rs_postback_from_html(path, html, delete_fields)
	if not bool(delete_response.get("ok", false)):
		return {"ok": false, "message": "Falha ao excluir a placa %s: %s" % [clean_plate, str(delete_response.get("message", ""))]}
	if _legacy_grupo_rs_page_is_login(str(delete_response.get("body", ""))):
		return {"ok": false, "message": "O sistema antigo pediu login durante a exclusao da placa."}

	var delete_alert := _legacy_grupo_rs_alert_message(str(delete_response.get("body", "")))
	var verify_state := await _legacy_grupo_rs_vehicle_exists(clean_plate, 10, 1.5)
	if bool(verify_state.get("ok", false)) and bool(verify_state.get("exists", false)):
		if delete_alert != "":
			return {"ok": false, "message": delete_alert}
		if allow_pending:
			return {
				"ok": true,
				"pending_verify": true,
				"message": "Exclusao da placa %s enviada ao sistema antigo. Ela ainda apareceu na consulta imediata, mas o Grupo RS pode levar alguns instantes para atualizar." % clean_plate,
			}
		return {"ok": false, "message": "A exclusao da placa %s foi enviada, mas ela ainda apareceu na pesquisa." % clean_plate}

	return {"ok": true, "message": "Placa %s excluida do sistema antigo." % clean_plate}


func _legacy_grupo_rs_vehicle_exists(plate: String, attempts: int = 1, delay_seconds: float = 0.0) -> Dictionary:
	var clean_plate := plate.strip_edges()
	var plate_key := _search_key(clean_plate)
	for attempt in range(maxi(attempts, 1)):
		var response := await _legacy_grupo_rs_postback("/Cadastros/VeiculosListar", {
