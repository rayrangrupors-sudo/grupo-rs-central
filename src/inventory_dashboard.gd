func _assistant_create_codex_escalation(source: String, problem: String, extra: Dictionary = {}) -> Dictionary:
	var clean_source := source.strip_edges()
	if clean_source == "":
		clean_source = "IA local"
	var clean_problem := problem.strip_edges()
	if clean_problem == "":
		clean_problem = "Problema sem descricao."

	var key := _assistant_text_key("%s %s %s" % [clean_source, clean_problem, str(extra.get("component", extra.get("id", "")))])
	var now := int(Time.get_unix_time_from_system())
	var last := int(assistant_escalation_last_by_key.get(key, 0))
	if key != "" and last > 0 and now - last < CODEX_ESCALATION_COOLDOWN_SECONDS:
		return {
			"ok": true,
			"skipped": true,
			"path": assistant_last_escalation_path,
			"message": "Esse chamado ja foi gerado ha pouco tempo.",
		}

	var absolute_dir := ProjectSettings.globalize_path(CODEX_ESCALATION_DIR)
	if not DirAccess.dir_exists_absolute(absolute_dir):
		var make_error := DirAccess.make_dir_recursive_absolute(absolute_dir)
		if make_error != OK:
			return {"ok": false, "message": "Nao foi possivel criar pasta de chamados Codex."}

	var stamp := _assistant_file_stamp()
	var base_name := "codex_chamado_%s_%s" % [_assistant_text_key(selected_branch_id).left(18), stamp]
	var json_path := "%s/%s.json" % [CODEX_ESCALATION_DIR, base_name]
	var text_path := "%s/%s.txt" % [CODEX_ESCALATION_DIR, base_name]
	var absolute_json_path := ProjectSettings.globalize_path(json_path)
	var absolute_text_path := ProjectSettings.globalize_path(text_path)
	var report := _assistant_build_codex_escalation_report(clean_source, clean_problem, extra, absolute_json_path, absolute_text_path)
	var delivery := _assistant_initial_codex_delivery()
	report["delivery"] = delivery
	var prompt_text := _assistant_codex_prompt_text(report, absolute_json_path)

	var json_file := FileAccess.open(json_path, FileAccess.WRITE)
	if json_file == null:
		return {"ok": false, "message": "Nao foi possivel gravar JSON do chamado Codex."}
	json_file.store_string(JSON.stringify(_assistant_report_safe(report), "\t"))
	json_file = null

	var text_file := FileAccess.open(text_path, FileAccess.WRITE)
	if text_file != null:
		text_file.store_string(prompt_text)
		text_file = null

	assistant_last_escalation_path = absolute_json_path
	if key != "":
		assistant_escalation_last_by_key[key] = now
	if DisplayServer.get_name() != "headless":
		DisplayServer.clipboard_set(prompt_text)
	_log_system_action("Chamado Codex criado", "Origem: %s | Arquivo: %s" % [clean_source, absolute_json_path])
	call_deferred("_assistant_send_codex_escalation_file", json_path)
	return {
		"ok": true,
		"path": absolute_json_path,
		"text_path": absolute_text_path,
		"copied": DisplayServer.get_name() != "headless",
		"delivery_status": str(delivery.get("status", "pending")),
		"message": "Chamado Codex gerado.",
	}


func _assistant_build_codex_escalation_report(source: String, problem: String, extra: Dictionary, absolute_json_path: String, absolute_text_path: String) -> Dictionary:
	var snapshot: Dictionary = {}
	if system_guardian != null and is_instance_valid(system_guardian):
		snapshot = system_guardian.call("get_snapshot")
	var products_count := 0
	var maintenance_count := 0
	var logs: Array[Dictionary] = []
	if store != null:
		products_count = store.get_products("", "all", false).size()
		maintenance_count = store.get_maintenances(true).size()
		logs = store.get_system_logs(CODEX_ESCALATION_RECENT_LOG_LIMIT)
	return {
		"schema": "grupo_rs_codex_escalation_v1",
		"created_at": Time.get_datetime_string_from_system(false, true),
		"source": source,
		"problem": problem,
		"project_path": ProjectSettings.globalize_path("res://"),
		"json_path": absolute_json_path,
		"text_path": absolute_text_path,
		"branch": {
			"id": selected_branch_id,
			"name": selected_branch_name,
			"db_path": selected_branch_db_path,
			"grupo_rs_mode": selected_branch_grupo_rs_mode,
			"grupo_rs_base_url": selected_branch_grupo_rs_base_url,
		},
		"local_counts": {
			"products": products_count,
			"maintenances": maintenance_count,
			"recent_logs": logs.size(),
		},
		"platform_summary": _assistant_platform_summary(),
		"guardian_snapshot": snapshot,
		"unresolved_components": _assistant_unresolved_components(snapshot),
		"queues": {
			"arya_busy": arya_status_busy.size(),
			"arya_queue": arya_auto_queue.size(),
			"location_busy": location_status_busy.size(),
			"location_queue": location_auto_queue.size(),
			"internal_battery_busy": internal_battery_busy.size(),
			"internal_battery_queue": internal_battery_queue.size(),
			"auto_reset_rechecks": auto_reset_due_rechecks.size(),
		},
		"auto_reset_monitor": {
			"running": auto_reset_running,
			"summary": auto_reset_last_summary,
			"attempts": auto_reset_attempts.size(),
			"due_rechecks": auto_reset_due_rechecks.size(),
			"interval_seconds": AUTO_RESET_MONITOR_INTERVAL_SECONDS,
			"recheck_seconds": AUTO_RESET_RECHECK_SECONDS,
		},
		"assistant_chat_tail": assistant_chat_messages.slice(maxi(assistant_chat_messages.size() - 8, 0), assistant_chat_messages.size()),
		"recent_logs": logs,
		"extra": extra,
	}


func _assistant_initial_codex_delivery() -> Dictionary:
	var model := _assistant_codex_model()
	if not _assistant_codex_auto_send_enabled():
		return {
			"status": "pending_manual",
			"provider": "openai_responses",
			"model": model,
			"message": "Envio automatico desativado.",
			"updated_at": Time.get_datetime_string_from_system(false, true),
		}
	if _assistant_openai_api_key() == "":
		return {
			"status": "pending_api_key",
			"provider": "openai_responses",
			"model": model,
			"message": "Configure OPENAI_API_KEY ou salve a chave OpenAI nas preferencias.",
			"updated_at": Time.get_datetime_string_from_system(false, true),
		}
	return {
		"status": "pending",
		"provider": "openai_responses",
		"model": model,
		"message": "Aguardando envio automatico.",
		"updated_at": Time.get_datetime_string_from_system(false, true),
	}


func _assistant_send_codex_escalation_file(json_path: String) -> void:
	if not FileAccess.file_exists(json_path):
		return
	if not _assistant_codex_auto_send_enabled():
		_assistant_update_codex_escalation_delivery(json_path, {
			"status": "pending_manual",
			"message": "Envio automatico desativado.",
			"updated_at": Time.get_datetime_string_from_system(false, true),
		})
		_log_system_action("Chamado Codex pendente", "Envio automatico desativado | Arquivo: %s" % ProjectSettings.globalize_path(json_path))
		return

	var api_key := _assistant_openai_api_key()
	if api_key == "":
		_assistant_update_codex_escalation_delivery(json_path, {
			"status": "pending_api_key",
			"message": "Configure OPENAI_API_KEY ou salve a chave OpenAI nas preferencias.",
			"updated_at": Time.get_datetime_string_from_system(false, true),
		})
		_log_system_action("Chamado Codex pendente", "Sem chave OpenAI | Arquivo: %s" % ProjectSettings.globalize_path(json_path))
		return
	if not is_inside_tree():
		_assistant_update_codex_escalation_delivery(json_path, {
			"status": "send_failed",
			"message": "Tela ainda nao esta pronta para requisicoes HTTP.",
			"updated_at": Time.get_datetime_string_from_system(false, true),
		})
		return

	_assistant_update_codex_escalation_delivery(json_path, {
		"status": "sending",
		"message": "Enviando chamado para OpenAI.",
		"model": _assistant_codex_model(),
		"updated_at": Time.get_datetime_string_from_system(false, true),
	})
	var report := _read_json_dictionary(json_path)
	if report.is_empty():
		_assistant_update_codex_escalation_delivery(json_path, {
			"status": "send_failed",
			"message": "JSON do chamado nao pode ser lido.",
			"updated_at": Time.get_datetime_string_from_system(false, true),
		})
		return

	var result := await _assistant_send_codex_escalation_to_openai(report, api_key)
	if not bool(result.get("ok", false)):
		var error_code := str(result.get("code", ""))
		var delivery_status := "send_failed"
		if ["insufficient_quota", "billing_hard_limit_reached"].has(error_code):
			delivery_status = "pending_billing"
		elif error_code == "rate_limit_exceeded":
			delivery_status = "retry_later"
		_assistant_update_codex_escalation_delivery(json_path, {
			"status": delivery_status,
			"error_code": error_code,
			"message": _truncate(str(result.get("message", "Falha no envio.")), 700),
			"updated_at": Time.get_datetime_string_from_system(false, true),
		})
		_log_system_action("Chamado Codex pendente", "Falha no envio OpenAI: %s | Arquivo: %s" % [
			_truncate(str(result.get("message", "erro")), 360),
			ProjectSettings.globalize_path(json_path),
		])
		return

	var response_text := str(result.get("text", "")).strip_edges()
	var response_path := _assistant_codex_response_text_path(json_path)
	var response_file := FileAccess.open(response_path, FileAccess.WRITE)
	if response_file != null:
		response_file.store_string(response_text)
		response_file = null
	var absolute_response_path := ProjectSettings.globalize_path(response_path)
	_assistant_update_codex_escalation_delivery(json_path, {
		"status": "sent",
		"message": "Resposta recebida da OpenAI.",
		"response_id": str(result.get("id", "")),
		"response_text_path": absolute_response_path,
		"response_preview": _truncate(response_text, 700),
		"sent_at": Time.get_datetime_string_from_system(false, true),
		"updated_at": Time.get_datetime_string_from_system(false, true),
		"model": str(result.get("model", _assistant_codex_model())),
	})
	_log_system_action("Chamado Codex enviado", "Modelo: %s | Resposta: %s" % [
		str(result.get("model", _assistant_codex_model())),
		absolute_response_path,
	])


func _assistant_send_codex_escalation_to_openai(report: Dictionary, api_key: String) -> Dictionary:
	var safe_variant: Variant = _assistant_report_safe(report)
	var safe_report: Dictionary = safe_variant if typeof(safe_variant) == TYPE_DICTIONARY else {}
	var absolute_json_path := str(safe_report.get("json_path", ""))
	var request_body := {
		"model": _assistant_codex_model(),
		"store": false,
		"reasoning": {"effort": "low"},
		"max_output_tokens": CODEX_ESCALATION_MAX_OUTPUT_TOKENS,
		"input": [
			{
				"role": "system",
				"content": "Voce e uma extensao do Codex ajudando o sistema Grupo RS Central. Analise chamados tecnicos em portugues, sem revelar segredos, e devolva um plano objetivo de correcao com riscos e testes.",
			},
			{
				"role": "user",
				"content": "%s\n\nRELATORIO SEGURO JSON:\n%s" % [
					_assistant_codex_prompt_text(safe_report, absolute_json_path),
					JSON.stringify(safe_report, "\t"),
				],
			},
		],
	}
	var response := await _http_post_json_with_headers(
		CODEX_ESCALATION_API_URL,
		request_body,
		PackedStringArray([
			"User-Agent: GrupoRSCentral/1.0",
			"Content-Type: application/json",
			"Authorization: Bearer %s" % api_key,
		]),
		CODEX_ESCALATION_TIMEOUT_SECONDS
	)
	if not bool(response.get("ok", false)):
		var error_details := _assistant_openai_error_details(response)
		return {
			"ok": false,
			"message": str(error_details.get("message", "Falha HTTP OpenAI.")),
			"code": str(error_details.get("code", "")),
		}

	var body_text := str(response.get("body", ""))
	var parsed: Variant = JSON.parse_string(body_text)
	if typeof(parsed) != TYPE_DICTIONARY:
		return {"ok": false, "message": "OpenAI retornou JSON invalido."}
	var data := parsed as Dictionary
	var response_text := _assistant_extract_openai_response_text(data)
	if response_text == "":
		response_text = _truncate(body_text, 1200)
	return {
		"ok": true,
		"id": str(data.get("id", "")),
		"model": str(data.get("model", _assistant_codex_model())),
		"text": response_text,
	}


func _assistant_openai_error_details(response: Dictionary) -> Dictionary:
	var http_message := str(response.get("message", "Falha HTTP OpenAI.")).strip_edges()
	var body := str(response.get("body", "")).strip_edges()
	var code := ""
	var error_type := ""
	var api_message := ""
	var parsed: Variant = JSON.parse_string(body)
	if typeof(parsed) == TYPE_DICTIONARY:
		var root := parsed as Dictionary
		var error_value: Variant = root.get("error", {})
		if typeof(error_value) == TYPE_DICTIONARY:
			var error := error_value as Dictionary
			code = str(error.get("code", "")).strip_edges()
			error_type = str(error.get("type", "")).strip_edges()
			api_message = str(error.get("message", "")).strip_edges()
	var clean_code := code if code != "" else error_type
	match clean_code:
		"insufficient_quota":
			return {
				"code": "insufficient_quota",
				"message": "%s | Conta OpenAI sem credito/cota de API. Adicione creditos no Billing da OpenAI e o proximo chamado podera ser enviado." % http_message,
			}
		"billing_hard_limit_reached":
			return {
				"code": "billing_hard_limit_reached",
				"message": "%s | Limite de gastos da OpenAI atingido. Ajuste o limite ou adicione saldo no Billing." % http_message,
			}
		"rate_limit_exceeded":
			return {
				"code": "rate_limit_exceeded",
				"message": "%s | Limite temporario de requisicoes da OpenAI. O chamado ficou salvo para tentar novamente depois." % http_message,
			}
	var details := api_message if api_message != "" else _truncate(body, 500)
	if details == "":
		details = "Sem detalhe adicional da OpenAI."
	return {
		"code": clean_code,
		"message": "%s | %s" % [http_message, details],
	}


func _assistant_extract_openai_response_text(data: Dictionary) -> String:
	var direct := str(data.get("output_text", "")).strip_edges()
	if direct != "":
		return direct
	var chunks: Array[String] = []
	var output_value: Variant = data.get("output", [])
	var output: Array = output_value if typeof(output_value) == TYPE_ARRAY else []
	for raw_item in output:
		if typeof(raw_item) != TYPE_DICTIONARY:
			continue
		var item := raw_item as Dictionary
		var content_value: Variant = item.get("content", [])
		var content: Array = content_value if typeof(content_value) == TYPE_ARRAY else []
		for raw_content in content:
			if typeof(raw_content) != TYPE_DICTIONARY:
				continue
			var content_item := raw_content as Dictionary
			var content_type := str(content_item.get("type", ""))
			if not ["output_text", "text"].has(content_type):
				continue
			var text_value := str(content_item.get("text", content_item.get("content", ""))).strip_edges()
			if text_value != "":
				chunks.append(text_value)
	return "\n".join(chunks).strip_edges()


func _assistant_update_codex_escalation_delivery(json_path: String, delivery_patch: Dictionary) -> Dictionary:
	var report := _read_json_dictionary(json_path)
	if report.is_empty():
		return {}
	var delivery: Dictionary = {}
	var current_delivery: Variant = report.get("delivery", {})
	if typeof(current_delivery) == TYPE_DICTIONARY:
		delivery = (current_delivery as Dictionary).duplicate(true)
	for key in delivery_patch.keys():
		delivery[key] = delivery_patch.get(key)
	report["delivery"] = delivery
	var safe_variant: Variant = _assistant_report_safe(report)
	if typeof(safe_variant) == TYPE_DICTIONARY:
		_write_json_dictionary(json_path, safe_variant as Dictionary)
	else:
		_write_json_dictionary(json_path, report)
	return delivery


func _assistant_codex_response_text_path(json_path: String) -> String:
	if json_path.ends_with(".json"):
		return json_path.substr(0, json_path.length() - 5) + ".response.txt"
	return "%s.response.txt" % json_path


func _assistant_openai_api_key() -> String:
	var env_key := OS.get_environment("OPENAI_API_KEY").strip_edges()
	if env_key != "":
		return env_key
	var settings := _read_json_dictionary(SETTINGS_PATH)
	return str(settings.get("openai_api_key", "")).strip_edges()


func _assistant_codex_model() -> String:
	var env_model := OS.get_environment("OPENAI_CODEX_MODEL").strip_edges()
	if env_model == "":
		env_model = OS.get_environment("OPENAI_MODEL").strip_edges()
	if env_model != "":
		return env_model
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var model := str(settings.get("codex_escalation_model", CODEX_ESCALATION_DEFAULT_MODEL)).strip_edges()
	return CODEX_ESCALATION_DEFAULT_MODEL if model == "" else model


func _assistant_codex_auto_send_enabled() -> bool:
	if assistant_codex_auto_send_disabled_for_tests:
		return false
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var value: Variant = settings.get("codex_escalation_auto_send", false)
	if typeof(value) == TYPE_BOOL:
		return bool(value)
	var text_value := str(value).strip_edges().to_lower()
	return not ["false", "0", "nao", "off", "disabled"].has(text_value)


func _assistant_unresolved_components(snapshot: Dictionary) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var components: Array = snapshot.get("components", []) if typeof(snapshot.get("components", [])) == TYPE_ARRAY else []
	for raw_component in components:
		if typeof(raw_component) != TYPE_DICTIONARY:
			continue
		var component := raw_component as Dictionary
		var status := str(component.get("status", "")).to_lower()
		var automation := str(component.get("automation", "")).to_lower()
		if ["warning", "error"].has(status) or ["blocked", "failed", "unavailable"].has(automation):
			result.append(component.duplicate(true))
	return result


func _assistant_codex_prompt_text(report: Dictionary, absolute_json_path: String) -> String:
	var lines: Array[String] = []
	lines.append("Codex, resolva este chamado gerado pela IA local do Grupo RS Central.")
	lines.append("")
	lines.append("Arquivo JSON do chamado:")
	lines.append(absolute_json_path)
	lines.append("")
	lines.append("Projeto:")
	lines.append(str(report.get("project_path", "")))
	lines.append("")
	lines.append("Origem:")
	lines.append(str(report.get("source", "")))
	lines.append("")
	lines.append("Problema:")
	lines.append(str(report.get("problem", "")))
	lines.append("")
	lines.append("O que fazer:")
	lines.append("1. Leia o JSON completo do chamado.")
	lines.append("2. Encontre a causa no projeto e corrija no proprio sistema.")
	lines.append("3. Rode os testes Godot relacionados.")
	lines.append("4. Registre no log do sistema o que foi resolvido.")
	return "\n".join(lines)


func _assistant_escalation_answer(escalation: Dictionary) -> String:
	if not bool(escalation.get("ok", false)):
		return "Tentei gerar o chamado para Codex, mas falhou: %s" % str(escalation.get("message", "erro desconhecido"))
	if bool(escalation.get("skipped", false)):
		return "Ja existe um chamado recente para esse mesmo problema: %s" % _blank(str(escalation.get("path", "")))
	var copied := bool(escalation.get("copied", false))
	var delivery_status := str(escalation.get("delivery_status", "pending"))
	var delivery_text := ""
	match delivery_status:
		"pending":
			delivery_text = "\nEnvio automatico: tentando agora."
		"pending_api_key":
			delivery_text = "\nEnvio automatico: pendente ate configurar OPENAI_API_KEY ou salvar a chave OpenAI."
		"pending_manual":
			delivery_text = "\nModo manual: o chamado foi salvo e copiado para voce colar aqui."
	return "Gerei um chamado para Codex e registrei no log.\nJSON: %s\nTXT: %s%s%s" % [
		str(escalation.get("path", "")),
		str(escalation.get("text_path", "")),
		"\nO pedido tambem foi copiado para a area de transferencia." if copied else "",
		delivery_text,
	]


func _assistant_create_codex_escalation_from_guardian_event(event: Dictionary) -> void:
	var kind := str(event.get("kind", ""))
	if not ["error", "blocked"].has(kind):
		return
	var problem := "%s | %s | %s" % [
		str(event.get("component", "")),
		str(event.get("title", "")),
