		settings["openai_api_key"] = api_key
	var model := str(openai_model_input.text if openai_model_input else "").strip_edges()
	if model == "":
		model = CODEX_ESCALATION_DEFAULT_MODEL
	settings["codex_escalation_model"] = model
	settings["codex_escalation_auto_send"] = openai_auto_send_check != null and openai_auto_send_check.button_pressed
	settings["codex_escalation_saved_at"] = Time.get_datetime_string_from_system(false, true)
	_write_json_dictionary(SETTINGS_PATH, settings)
	if openai_api_key_input:
		openai_api_key_input.clear()
	var has_key := _assistant_openai_api_key() != ""
	if not bool(settings.get("codex_escalation_auto_send", false)):
		_set_codex_openai_config_status("Modo manual salvo. A IA vai copiar o chamado para voce colar aqui.", MUTED)
	elif not has_key:
		_set_codex_openai_config_status("Preferencias salvas, mas falta chave OpenAI para envio automatico.", YELLOW)
	elif bool(settings.get("codex_escalation_auto_send", false)):
		_set_codex_openai_config_status("Ajuda Codex/OpenAI salva. Envio automatico ativo.", GREEN)
	else:
		_set_codex_openai_config_status("Ajuda Codex/OpenAI salva, com envio automatico desativado.", MUTED)


func _set_codex_openai_config_status(message: String, color: Color) -> void:
	if openai_integration_status_label == null or not is_instance_valid(openai_integration_status_label):
		return
	openai_integration_status_label.text = message
	openai_integration_status_label.add_theme_color_override("font_color", color)


func _login_arya(email: String, password: String) -> Dictionary:
	var body := {
		"email": email,
		"password": password,
	}
	var response := await _http_post_json_with_headers(
		ARYA_API_AUTH_URL,
		body,
		PackedStringArray(["User-Agent: GrupoRSCentral/1.0", "Content-Type: application/json"])
	)
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": "Arya recusou o login: %s" % str(response.get("message", ""))}

	var parsed: Variant = JSON.parse_string(str(response.get("body", "")))
	if typeof(parsed) != TYPE_DICTIONARY:
		return {"ok": false, "message": "Arya retornou resposta invalida."}

	var data := parsed as Dictionary
	if data.has("status") and not bool(data.get("status", false)):
		return {"ok": false, "message": str(data.get("message", "Login invalido na Arya."))}

	var token := str(data.get("token", "")).strip_edges()
	if token == "":
		return {"ok": false, "message": "Arya autenticou, mas nao retornou token JWT."}
	return {"ok": true, "token": token}


