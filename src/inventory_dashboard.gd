func _save_maintenance_schedule_dialog(layer: CanvasLayer, id: String, date_value: String, time_value: String, note_value: String) -> void:
	var clean_date := date_value.strip_edges()
	var clean_time := time_value.strip_edges()
	if clean_date == "" or clean_time == "":
		_show_warning("Agendamento", "Informe data e hora para salvar o retorno.")
		return
	store.update_maintenance_note(id, note_value)
	if not store.update_maintenance_schedule(id, clean_date, clean_time):
		_show_error("Agendamento", "Nao foi possivel salvar esta manutencao.")
		return
	_log_system_action("Agendou manutencao", "%s %s | ID: %s" % [clean_date, clean_time, id])
	if is_instance_valid(layer):
		layer.queue_free()
	_refresh_maintenance_schedule_rows()
	_show_success("Agendamento", "Retorno salvo para %s as %s." % [clean_date, clean_time])


