func _hours_since_grupo_rs_datetime(value: String) -> float:
	var unix := _grupo_rs_datetime_to_unix(value)
	if unix <= 0:
		return -1.0
	return maxf(0.0, float(_local_now_to_unix_like() - unix) / 3600.0)


func _local_now_to_unix_like() -> int:
	return Time.get_unix_time_from_datetime_dict(Time.get_datetime_dict_from_system(false))


func _grupo_rs_datetime_to_unix(value: String) -> int:
	var text_value := value.strip_edges().replace("T", " ")
	if text_value == "":
		return 0

	var parts := text_value.split(" ")
	if parts.size() < 2:
		return 0

	var date_text := str(parts[0]).strip_edges()
	var date_parts := date_text.split("/")
	var dash_format := false
	if date_parts.size() != 3 and date_text.contains("-"):
		date_parts = date_text.split("-")
		dash_format = true
	var time_parts := str(parts[1]).split(":")
	if date_parts.size() != 3 or time_parts.size() < 2:
		return 0
	var year := int(date_parts[2])
	var month := int(date_parts[1])
	var day := int(date_parts[0])
	if dash_format and str(date_parts[0]).length() == 4:
		year = int(date_parts[0])
		month = int(date_parts[1])
		day = int(date_parts[2])

	return Time.get_unix_time_from_datetime_dict({
		"year": year,
		"month": month,
		"day": day,
		"hour": int(time_parts[0]),
		"minute": int(time_parts[1]),
		"second": int(time_parts[2]) if time_parts.size() > 2 else 0,
	})


func _load_location_tile(texture_rect: TextureRect, marker: Control, lat: float, lng: float) -> void:
	var viewport_size := Vector2i(760, 300)
	var zoom := 16
	var tile_size := 256
	var world_pixel := _lat_lng_to_world_pixel(lat, lng, zoom)
	var top_left := Vector2i(
		roundi(world_pixel.x - float(viewport_size.x) * 0.5),
		roundi(world_pixel.y - float(viewport_size.y) * 0.5)
	)
	var first_tile := Vector2i(floori(float(top_left.x) / float(tile_size)), floori(float(top_left.y) / float(tile_size)))
	var last_tile := Vector2i(
		floori(float(top_left.x + viewport_size.x - 1) / float(tile_size)),
		floori(float(top_left.y + viewport_size.y - 1) / float(tile_size))
	)

	var preview := Image.create(viewport_size.x, viewport_size.y, false, Image.FORMAT_RGBA8)
	preview.fill(Color("#eef3f8"))
	var max_tile := int(pow(2.0, float(zoom)))

	for tile_y in range(first_tile.y, last_tile.y + 1):
		if tile_y < 0 or tile_y >= max_tile:
			continue
		for tile_x in range(first_tile.x, last_tile.x + 1):
			var wrapped_x := posmod(tile_x, max_tile)
			var response := await _http_get_bytes(OSM_TILE_URL % [zoom, wrapped_x, tile_y])
			if not bool(response.get("ok", false)):
				continue

			var tile_image := Image.new()
			var error := tile_image.load_png_from_buffer(response.get("bytes", PackedByteArray()))
			if error != OK:
				continue
			tile_image.convert(Image.FORMAT_RGBA8)

			var dest := Vector2i(tile_x * tile_size - top_left.x, tile_y * tile_size - top_left.y)
			_blit_visible_tile(preview, tile_image, dest, viewport_size)

	texture_rect.texture = ImageTexture.create_from_image(preview)
	var marker_position := Vector2(float(viewport_size.x) * 0.5 - 18.0, float(viewport_size.y) * 0.5 - 44.0)
	marker.position = marker_position + Vector2(0, -24)
	var tween := marker.create_tween()
	tween.set_parallel(true)
	tween.tween_property(texture_rect, "modulate:a", 1.0, 0.22).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.tween_property(marker, "modulate:a", 1.0, 0.18).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.tween_property(marker, "position", marker_position, 0.42).set_trans(Tween.TRANS_BOUNCE).set_ease(Tween.EASE_OUT)


func _blit_visible_tile(target: Image, tile_image: Image, dest: Vector2i, viewport_size: Vector2i) -> void:
	var tile_size := tile_image.get_size()
	var source_pos := Vector2i.ZERO
	var target_pos := dest
	var copy_size := tile_size

	if target_pos.x < 0:
		source_pos.x = -target_pos.x
		copy_size.x -= source_pos.x
		target_pos.x = 0
	if target_pos.y < 0:
		source_pos.y = -target_pos.y
		copy_size.y -= source_pos.y
		target_pos.y = 0
	if target_pos.x + copy_size.x > viewport_size.x:
		copy_size.x = viewport_size.x - target_pos.x
	if target_pos.y + copy_size.y > viewport_size.y:
		copy_size.y = viewport_size.y - target_pos.y
	if copy_size.x <= 0 or copy_size.y <= 0:
		return

	target.blit_rect(tile_image, Rect2i(source_pos, copy_size), target_pos)


func _lat_lng_to_tile(lat: float, lng: float, zoom: int) -> Dictionary:
	var lat_rad := deg_to_rad(lat)
	var n := pow(2.0, float(zoom))
	var x_float := (lng + 180.0) / 360.0 * n
	var y_float := (1.0 - log(tan(lat_rad) + 1.0 / cos(lat_rad)) / PI) / 2.0 * n
	var x := floori(x_float)
	var y := floori(y_float)
	return {
		"x": x,
		"y": y,
		"frac_x": clampf(x_float - float(x), 0.0, 1.0),
		"frac_y": clampf(y_float - float(y), 0.0, 1.0),
	}


func _lat_lng_to_world_pixel(lat: float, lng: float, zoom: int) -> Vector2:
	var tile := _lat_lng_to_tile(lat, lng, zoom)
	var x := float(tile.get("x", 0)) + float(tile.get("frac_x", 0.0))
	var y := float(tile.get("y", 0)) + float(tile.get("frac_y", 0.0))
	return Vector2(x * 256.0, y * 256.0)


func _world_pixel_to_lat_lng(point: Vector2, zoom: int) -> Vector2:
	var n := pow(2.0, float(zoom))
	var longitude := point.x / 256.0 / n * 360.0 - 180.0
	var mercator_y := PI * (1.0 - 2.0 * point.y / 256.0 / n)
	var latitude := rad_to_deg(atan(sinh(mercator_y)))
	return Vector2(latitude, longitude)


func _openstreetmap_url(lat: float, lng: float) -> String:
	var delta := 0.008
	return "https://www.openstreetmap.org/export/embed.html?bbox=%s%%2C%s%%2C%s%%2C%s&layer=mapnik&marker=%s%%2C%s" % [
		str(lng - delta),
		str(lat - delta),
		str(lng + delta),
		str(lat + delta),
		str(lat),
		str(lng),
	]


