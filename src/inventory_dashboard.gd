func _parse_timeline_text(raw_text: String) -> Dictionary:
	var rows: Array[Dictionary] = []
	var errors: Array[String] = []
	var normalized_text := raw_text.replace("\r\n", "\n").replace("\r", "\n").strip_edges()
	if normalized_text == "":
		return {"rows": rows, "errors": ["Cole os dados da planilha antes de gerar a previa."]}

	var lines := normalized_text.split("\n")
	var header_cells: Array[String] = []
	var header_index := -1
	for i in range(mini(lines.size(), 12)):
		var cells := _split_timeline_line(str(lines[i]))
		if cells.size() < 3:
			continue
		if _timeline_header_map(cells).get("plate", -1) >= 0:
			header_cells = cells
			header_index = i
			break

	if header_index < 0:
		return _parse_timeline_loose_lines(lines)

	var map := _timeline_header_map(header_cells)
	var plate_index := int(map.get("plate", -1))
	var serial_index := int(map.get("serial", -1))
	var date_index := int(map.get("date", -1))
	var operator_index := int(map.get("operator", -1))
	var model_index := int(map.get("model", -1))
	var status_index := int(map.get("status", -1))
	var action_index := int(map.get("action", -1))

	if plate_index < 0 or serial_index < 0 or date_index < 0:
		errors.append("A planilha precisa ter PLACA, NUMERO DE SERIE e DATA.")
		return {"rows": rows, "errors": errors}

	for i in range(header_index + 1, lines.size()):
		var cells := _split_timeline_line(str(lines[i]))
		if cells.size() == 0:
			continue

		var plate := _normalize_timeline_plate(_clean_pasted_cell(_safe_cell(cells, plate_index)))
		var serial := _clean_xlsx_serial(_clean_pasted_cell(_safe_cell(cells, serial_index)))
		var installed_at := _normalize_import_date(_clean_pasted_cell(_safe_cell(cells, date_index)))
		var operator_name := _normalize_bulk_operator(_clean_pasted_cell(_safe_cell(cells, operator_index))) if operator_index >= 0 else "Sem operadora"
		var model := _normalize_bulk_model(_clean_pasted_cell(_safe_cell(cells, model_index))) if model_index >= 0 else "Nao informado"
		var status_value := _timeline_key(_clean_pasted_cell(_safe_cell(cells, status_index))) if status_index >= 0 else ""
		var action_value := _timeline_key(_clean_pasted_cell(_safe_cell(cells, action_index))) if action_index >= 0 else ""
		if operator_name == "":
			operator_name = "Sem operadora"
		if model == "":
			model = "Nao informado"

		if plate == "" and serial == "":
			continue
		if status_value != "" and status_value != "instalado":
			errors.append("Linha %d: ignorada porque o status e %s." % [i + 1, _clean_pasted_cell(_safe_cell(cells, status_index))])
			continue
		if action_value != "" and not (action_value.contains("instalacao") or action_value.contains("troca")):
			errors.append("Linha %d: acao nao parece instalacao/troca." % (i + 1))
			continue
		if serial == "" or installed_at == "":
			errors.append("Linha %d: serie ou data ausente." % (i + 1))
			continue
		if plate == "":
			plate = "Nao informado"

		rows.append({
			"serial": serial,
			"plate": plate,
			"installed_at": installed_at,
			"model": model,
			"operator": operator_name,
		})

	return {"rows": rows, "errors": errors}


func _parse_timeline_loose_lines(lines: PackedStringArray) -> Dictionary:
	var rows: Array[Dictionary] = []
	var errors: Array[String] = []
	for i in range(lines.size()):
		var cells := _split_timeline_line(str(lines[i]))
		if cells.size() < 3:
			continue

		var serial := ""
		var installed_at := ""
		var status_value := ""
		var operator_name := "Sem operadora"
		var model := "Nao informado"
		var plate_candidates: Array[String] = []

		for cell in cells:
			var clean := _clean_pasted_cell(str(cell))
			var key := _timeline_key(clean)
			var possible_date := _normalize_import_date(clean)
			if serial == "" and _looks_like_bulk_serial(_clean_xlsx_serial(clean)):
				serial = _clean_xlsx_serial(clean)
			elif installed_at == "" and possible_date != "":
				installed_at = possible_date
			elif key == "instalado" or key == "retirado" or key == "trocado":
				status_value = key
			elif key == "tim" or key == "claro" or key == "vivo":
				operator_name = _normalize_bulk_operator(clean)
			elif key == "rsnovo" or key == "reutilizado" or key == "novo":
				model = _normalize_bulk_model(clean)
			elif _looks_like_timeline_plate(clean):
				plate_candidates.append(_normalize_timeline_plate(clean))

		if serial == "" and installed_at == "" and plate_candidates.is_empty():
			continue
		if status_value != "" and status_value != "instalado":
			errors.append("Linha %d: ignorada porque o status e %s." % [i + 1, status_value])
			continue
		if serial == "" or installed_at == "":
			errors.append("Linha %d: nao foi possivel identificar serie e data." % (i + 1))
			continue

		rows.append({
			"serial": serial,
			"plate": plate_candidates[plate_candidates.size() - 1] if not plate_candidates.is_empty() else "Nao informado",
			"installed_at": installed_at,
			"model": model,
			"operator": operator_name,
		})

	if rows.is_empty() and errors.is_empty():
		errors.append("Nao foi possivel interpretar os dados colados.")
	return {"rows": rows, "errors": errors}


func _split_timeline_line(line: String) -> Array[String]:
	var separators: Array[String] = ["\t", ";", ","]
	for separator in separators:
		if line.contains(separator):
			var result: Array[String] = []
			var parts := line.split(separator, true)
			for part in parts:
				result.append(str(part).strip_edges())
			return result
	var fallback: Array[String] = []
	fallback.append(line.strip_edges())
	return fallback


func _timeline_header_map(cells: Array[String]) -> Dictionary:
	var result: Dictionary = {"plate": -1, "serial": -1, "date": -1, "operator": -1, "model": -1, "status": -1, "action": -1}
	for i in range(cells.size()):
		var raw: String = str(cells[i]).strip_edges()
		var key: String = _timeline_key(raw)
		if key == "placa":
			result["plate"] = i
		elif key.contains("placaapr") or key.contains("placaaprov") or key.contains("placaficticia"):
			continue
		elif result.get("serial", -1) == -1 and (_is_bulk_serial_header_key(key) or key == "aparelho" or key == "equipamento"):
			result["serial"] = i
		elif result.get("date", -1) == -1 and (key == "data" or key.contains("datainstal") or key.contains("instalacao")):
			result["date"] = i
		elif result.get("operator", -1) == -1 and key.contains("operadora"):
			result["operator"] = i
		elif result.get("model", -1) == -1 and (key == "tipo" or key.contains("modelo")):
			result["model"] = i
		elif result.get("status", -1) == -1 and key == "status":
			result["status"] = i
		elif result.get("action", -1) == -1 and (key == "acao" or key.contains("acao")):
			result["action"] = i
	return result


func _timeline_key(value: String) -> String:
	var text_value := value.strip_edges().to_lower()
	var replacements: Dictionary = {
		" ": "",
		"-": "",
		"_": "",
		".": "",
		"/": "",
		":": "",
		"\n": "",
		"\t": "",
		"á": "a",
		"à": "a",
		"ã": "a",
		"â": "a",
		"é": "e",
		"ê": "e",
		"í": "i",
		"ó": "o",
		"õ": "o",
		"ô": "o",
		"ú": "u",
		"ç": "c",
	}
	for from_value in replacements.keys():
		text_value = text_value.replace(str(from_value), str(replacements[from_value]))
	return _bulk_key(text_value)


func _safe_cell(cells: Array[String], index: int) -> String:
	if index < 0 or index >= cells.size():
		return ""
	return str(cells[index])


func _normalize_timeline_plate(value: String) -> String:
	var clean := _normalize_bulk_plate(value)
	if clean == "":
		return ""
	if not clean.contains("-"):
		var key := _bulk_key(clean).to_upper()
		if key.length() > 3:
			return "%s - %s" % [key.substr(0, 3), key.substr(3)]
	return clean


func _looks_like_timeline_plate(value: String) -> bool:
	var key := _bulk_key(value)
	if key.length() < 6 or key.length() > 8:
		return false
	var letters := 0
	var digits := 0
	for i in range(key.length()):
		var code := key.unicode_at(i)
		if code >= 97 and code <= 122:
			letters += 1
		elif code >= 48 and code <= 57:
			digits += 1
		else:
			return false
	return letters >= 3 and digits >= 3


func _normalize_import_date(value: String) -> String:
	var clean: String = value.strip_edges()
	if clean == "":
		return ""
	if clean.is_valid_float():
		var serial_days := int(float(clean))
		if serial_days > 20000:
			var unix_time := int((serial_days - 25569) * 86400)
			return Time.get_date_string_from_unix_time(unix_time) + "T00:00:00"
	var date_part := clean.split(" ")[0].split("T")[0]
	if date_part.contains("/"):
		var parts := date_part.split("/")
		if parts.size() == 3:
			var first: int = int(str(parts[0]))
			var second: int = int(str(parts[1]))
			var month: String = _two_digit(str(parts[0]))
			var day: String = _two_digit(str(parts[1]))
			if first > 12 and second <= 12:
				day = _two_digit(str(parts[0]))
				month = _two_digit(str(parts[1]))
			var year := str(parts[2])
			if year.length() == 2:
				year = "20" + year
			return "%s-%s-%sT00:00:00" % [year, month, day]
	if date_part.contains("-"):
		var parts_dash := date_part.split("-")
		if parts_dash.size() == 3:
			if str(parts_dash[0]).length() == 4:
				return "%s-%s-%sT00:00:00" % [str(parts_dash[0]), _two_digit(str(parts_dash[1])), _two_digit(str(parts_dash[2]))]
			return "%s-%s-%sT00:00:00" % [str(parts_dash[2]), _two_digit(str(parts_dash[1])), _two_digit(str(parts_dash[0]))]
	return ""


func _two_digit(value: String) -> String:
	var clean := value.strip_edges()
	if clean.length() == 1:
		return "0" + clean
	return clean


func _render_timeline_preview(rows: Array) -> void:
	if timeline_preview_body == null:
		return
	for child in timeline_preview_body.get_children():
		timeline_preview_body.remove_child(child)
		child.queue_free()

	if rows.is_empty():
		var empty := Label.new()
		empty.text = "Nenhum registro na previa."
		empty.add_theme_color_override("font_color", MUTED)
		timeline_preview_body.add_child(empty)
		return

	var limit := mini(rows.size(), 80)
	for i in range(limit):
		var row: Dictionary = rows[i]
		var label := Label.new()
		label.text = "%s | %s | %s | %s | %s" % [
			str(row.get("installed_at", "")).split("T")[0],
			str(row.get("serial", "")),
			str(row.get("plate", "")),
			str(row.get("model", "")),
			str(row.get("operator", "")),
		]
		label.add_theme_font_size_override("font_size", 15)
		label.add_theme_color_override("font_color", TEXT)
		timeline_preview_body.add_child(label)
	if rows.size() > limit:
		var more := Label.new()
		more.text = "... e mais %d registro(s)." % (rows.size() - limit)
		more.add_theme_color_override("font_color", MUTED)
		timeline_preview_body.add_child(more)


func _show_timeline_result(message: String, success: bool) -> void:
