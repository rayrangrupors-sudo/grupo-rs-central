func _client_financial_rows_from_store() -> Array[Dictionary]:
	var grouped: Dictionary = {}
	if store == null or not store.has_method("get_products"):
		return []
	for product_value in store.call("get_products") as Array:
		if typeof(product_value) != TYPE_DICTIONARY:
			continue
		var product := product_value as Dictionary
		var client := str(product.get("client", "")).strip_edges()
		if client == "":
			continue
		var key := _bulk_key(client)
		if not grouped.has(key):
			grouped[key] = {
				"client_number": str(product.get("client_id", "")).strip_edges(),
				"client": client,
				"regional": selected_branch_name.strip_edges() if selected_branch_name.strip_edges() != "" else "Não informado",
				"status": str(product.get("tracker_status", product.get("status", ""))).strip_edges(),
				"boleto_total": 0.0,
				"boleto_count": 0,
				"ticket_medio": 0.0,
				"has_financial": false,
				"updated_at": str(product.get("updated_at", "")).strip_edges(),
			}
	return _client_financial_sorted_rows(grouped.values())


func _client_financial_regions() -> Array[String]:
	var values: Array[String] = []
	for row in client_financial_rows:
		var value := str(row.get("regional", "")).strip_edges()
		if value != "" and not values.has(value):
			values.append(value)
	values.sort()
	return values


func _client_financial_statuses() -> Array[String]:
	var values: Array[String] = []
	for row in client_financial_rows:
		var value := str(row.get("status", "")).strip_edges()
		if value != "" and not values.has(value):
			values.append(value)
	values.sort()
	return values


func _client_financial_selected_filter(option: OptionButton, fallback: String) -> String:
	if option == null or not is_instance_valid(option) or option.selected <= 0:
		return fallback
	return option.get_item_text(option.selected).strip_edges()


func _refresh_client_financial_report_view() -> void:
	if client_financial_table_body == null or not is_instance_valid(client_financial_table_body):
		return
	var region := _client_financial_selected_filter(client_financial_region_filter, "")
	var status := _client_financial_selected_filter(client_financial_status_filter, "")
	var filtered: Array[Dictionary] = []
	for row in client_financial_rows:
		if region != "" and str(row.get("regional", "")) != region:
			continue
		if status != "" and str(row.get("status", "")) != status:
			continue
		filtered.append(row)
	for child in client_financial_table_body.get_children():
		client_financial_table_body.remove_child(child)
		child.queue_free()
	for row in filtered:
		client_financial_table_body.add_child(_make_client_financial_row(row))
	if filtered.is_empty():
		client_financial_table_body.add_child(_make_bulk_preview_message("Nenhum cliente encontrado para os filtros atuais.", true))
	_update_client_financial_summary(filtered)


func _update_client_financial_summary(rows: Array[Dictionary]) -> void:
	if client_financial_summary_body == null or not is_instance_valid(client_financial_summary_body):
		return
	for child in client_financial_summary_body.get_children():
		client_financial_summary_body.remove_child(child)
		child.queue_free()
	var total := 0.0
	var count := 0
	var ticket_sum := 0.0
	var regions: Dictionary = {}
	for row in rows:
		total += float(row.get("boleto_total", 0.0))
		count += int(row.get("boleto_count", 0))
		var explicit_ticket := float(row.get("ticket_medio", 0.0))
		ticket_sum += explicit_ticket if explicit_ticket > 0.0 else (float(row.get("boleto_total", 0.0)) / float(maxi(1, int(row.get("boleto_count", 0)))))
		regions[str(row.get("regional", "Não informado"))] = true
	var ticket := ticket_sum / float(maxi(1, rows.size()))
	client_financial_summary_body.add_child(_make_bulk_report_stat_card("Clientes", str(rows.size()), BLUE_DARK))
	client_financial_summary_body.add_child(_make_bulk_report_stat_card("Total boletos fechamento", _client_financial_money(total), GREEN))
	client_financial_summary_body.add_child(_make_bulk_report_stat_card("Ticket médio", _client_financial_money(ticket) if count > 0 else "Não informado", ORANGE))
	client_financial_summary_body.add_child(_make_bulk_report_stat_card("Regionais", str(regions.size()), BLUE))


func _make_client_financial_row(row_data: Dictionary) -> Control:
	var panel := PanelContainer.new()
	panel.custom_minimum_size = Vector2(0, 42)
	panel.add_theme_stylebox_override("panel", _style_box(Color("#f8fbff"), Color("#dce8f4"), 1, 7))
	var margin := MarginContainer.new()
	for side in ["left", "right", "top", "bottom"]:
		margin.add_theme_constant_override("margin_%s" % side, 7 if side in ["left", "right"] else 5)
	panel.add_child(margin)
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 8)
	margin.add_child(row)
	row.add_child(_make_preview_cell(str(row_data.get("client_number", "Não informado")), 125, BLUE_DARK))
	row.add_child(_make_preview_cell(str(row_data.get("client", "Não informado")), 260, TEXT))
	row.add_child(_make_preview_cell(str(row_data.get("regional", "Não informado")), 170, MUTED))
	row.add_child(_make_preview_cell(str(row_data.get("status", "Não informado")), 150, GREEN if _client_financial_status_is_active(str(row_data.get("status", ""))) else ORANGE))
	var total := float(row_data.get("boleto_total", 0.0))
	row.add_child(_make_preview_cell(_client_financial_money(total) if bool(row_data.get("has_financial", false)) else "Não informado", 165, GREEN))
	var ticket := float(row_data.get("ticket_medio", 0.0))
	if ticket <= 0.0 and int(row_data.get("boleto_count", 0)) > 0:
		ticket = total / float(maxi(1, int(row_data.get("boleto_count", 0))))
	row.add_child(_make_preview_cell(_client_financial_money(ticket) if bool(row_data.get("has_financial", false)) else "Não informado", 145, ORANGE))
	row.add_child(_make_preview_cell(str(row_data.get("updated_at", "Não informado")), 0, MUTED, true))
	return panel


