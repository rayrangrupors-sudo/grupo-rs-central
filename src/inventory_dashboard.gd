	center.add_child(icon)

	return button


func _button_palette(fill: Color, border: Color, font_color: Color) -> Dictionary:
	if _is_soft_button_color(fill):
		return {
			"fill": BUTTON_GRAY,
			"border": BUTTON_GRAY_BORDER,
			"font": BLUE_DARK,
		}
	if _is_medium_gray_button_color(fill):
		return {
			"fill": BUTTON_MEDIUM_GRAY,
			"border": BUTTON_MEDIUM_GRAY.darkened(0.05),
			"font": Color.WHITE,
		}
	return {
		"fill": fill,
		"border": border,
		"font": font_color,
	}


func _is_soft_button_color(color: Color) -> bool:
	return color.a > 0.2 and color.r > 0.82 and color.g > 0.86 and color.b > 0.90


func _is_medium_gray_button_color(color: Color) -> bool:
	return color.a > 0.2 \
		and absf(color.r - color.g) < 0.04 \
		and absf(color.g - color.b) < 0.04 \
		and color.r > 0.30 \
		and color.r < 0.58


func _button_hover_fill(fill: Color) -> Color:
	if fill == BUTTON_GRAY:
		return BUTTON_LIGHT_BLUE
	if fill == BUTTON_MEDIUM_GRAY:
		return BUTTON_MEDIUM_GRAY.lightened(0.07)
	return fill.lightened(0.06)


func _button_pressed_fill(fill: Color) -> Color:
	if fill == BUTTON_GRAY:
		return Color("#c8d6e4")
	if fill == BUTTON_MEDIUM_GRAY:
		return BUTTON_MEDIUM_GRAY.darkened(0.08)
	return fill.darkened(0.08)


func _action_icon_path(text_value: String) -> String:
	var key := _bulk_key(text_value)
	if key.contains("backup"):
		return ICON_DIR + "backup.svg"
	if key.contains("restaurar"):
		return ICON_DIR + "restaurar.svg"
	if key.contains("pesquisar") or key.contains("consultar") or key.contains("checar"):
		return ICON_DIR + "pesquisar.svg"
	if key.contains("exportar"):
		return ICON_DIR + "exportar.svg"
	if key.contains("escolher"):
		return ICON_DIR + "arquivo.svg"
	if key.contains("analisar"):
		return ICON_DIR + "relatorios.svg"
	if key.contains("desfazer"):
		return ICON_DIR + "restaurar.svg"
	if key.contains("copiar"):
		return ICON_DIR + "arquivo.svg"
	if key.contains("cadastrar") or key.contains("cadastro") or key.contains("gerarprevia"):
		return ICON_DIR + "cadastrar.svg"
	if key.contains("confirmar") or key == "ok" or key.contains("concluido") or key.contains("hoje"):
		return ICON_DIR + "confirmar.svg"
	if key.contains("limpar"):
		return ICON_DIR + "limpar.svg"
	if key.contains("reset") and key.contains("sms"):
		return ICON_DIR + "mensagem.svg"
	if key.contains("atualizar"):
		return ICON_DIR + "atualizar.svg"
	if key.contains("voltar"):
		return ICON_DIR + "voltar.svg"
	if key.contains("deletar") or key.contains("excluir"):
		return ICON_DIR + "deletar.svg"
	if key.contains("salvar"):
		return ICON_DIR + "salvar.svg"
	if key.contains("editar"):
		return ICON_DIR + "editar.svg"
	if key.contains("estoque"):
		return ICON_DIR + "estoque.svg"
	return ""


