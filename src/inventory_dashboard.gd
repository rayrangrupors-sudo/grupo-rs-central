func _render_dashboard_communication_detail_page() -> void:
	if dashboard_communication_detail_body == null or not is_instance_valid(dashboard_communication_detail_body):
		return
	for child in dashboard_communication_detail_body.get_children():
		dashboard_communication_detail_body.remove_child(child)
		child.queue_free()

	var total := dashboard_communication_detail_rows.size()
	var page_count := maxi(1, ceili(float(total) / float(DASHBOARD_COMMUNICATION_DETAIL_PAGE_SIZE)))
	dashboard_communication_detail_page = clampi(dashboard_communication_detail_page, 0, page_count - 1)
	var first := dashboard_communication_detail_page * DASHBOARD_COMMUNICATION_DETAIL_PAGE_SIZE
	var last := mini(first + DASHBOARD_COMMUNICATION_DETAIL_PAGE_SIZE, total)
	if total <= 0:
		dashboard_communication_detail_body.add_child(_make_empty_log_card("Nenhum veiculo nesta faixa."))
	else:
		for index in range(first, last):
			dashboard_communication_detail_body.add_child(_make_dashboard_communication_detail_row(dashboard_communication_detail_rows[index]))

	if dashboard_communication_detail_page_label:
		dashboard_communication_detail_page_label.text = "Nenhum registro" if total <= 0 else "Mostrando %d-%d de %d veiculos" % [first + 1, last, total]
	if dashboard_communication_detail_previous_button:
		dashboard_communication_detail_previous_button.disabled = dashboard_communication_detail_page <= 0
	if dashboard_communication_detail_next_button:
		dashboard_communication_detail_next_button.disabled = dashboard_communication_detail_page >= page_count - 1


