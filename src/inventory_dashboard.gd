func _set_progress_dialog_content(layer: CanvasLayer, message: String, detail: String = "") -> void:
	if layer == null or not is_instance_valid(layer):
		return
	var message_label := layer.find_child("ProgressMessage", true, false) as Label
	if message_label:
		message_label.text = message
	var detail_label := layer.find_child("ProgressDetail", true, false) as Label
	if detail_label:
		detail_label.text = detail
	if layer.find_child("ProgressSteps", true, false) != null:
		var current_step := 0
		var lower_message := message.to_lower()
		if lower_message.contains("conferindo") or lower_message.contains("conclu") or lower_message.contains("final"):
			current_step = 3
		elif lower_message.contains("enviando") or lower_message.contains("confirmando") or lower_message.contains("2/2"):
			current_step = 2
		elif lower_message.contains("atualizando") or lower_message.contains("salvando") or lower_message.contains("1/2"):
			current_step = 1
		_update_vehicle_reassignment_progress(layer, current_step)
		var progress_bar := layer.find_child("ProgressBar", true, false) as ProgressBar
		var progress_percent := layer.find_child("ProgressPercent", true, false) as Label
		var progress_values: Array[float] = [30.0, 52.0, 76.0, 100.0]
		if progress_bar:
			var target_value: float = progress_values[current_step]
			progress_bar.create_tween().tween_property(progress_bar, "value", target_value, 0.42).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		if progress_percent:
			progress_percent.text = "%d%%" % int(progress_values[current_step])


