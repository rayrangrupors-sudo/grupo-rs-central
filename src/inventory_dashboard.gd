func _system_log_event_icon_path(entry: Dictionary) -> String:
	if _system_log_is_error(entry):
		return ICON_DIR + "alerts/error.svg"
	var action := str(entry.get("action", "")).to_lower()
	var details := str(entry.get("details", "")).to_lower()
	if action.contains("localiza") or details.contains("localiza"):
		return ICON_DIR + "localizacao_consulta.svg"
	if action.contains("sincron") or details.contains("sincron"):
		return ICON_DIR + "atualizar.svg"
	if action.contains("manut") or details.contains("manut"):
		return ICON_DIR + "status_manutencao.svg"
	if _system_log_is_completed(entry):
		return ICON_DIR + "alerts/success.svg"
	return ICON_DIR + "atualizar.svg"


func _system_log_event_time(entry: Dictionary) -> String:
	var formatted := _format_datetime(str(entry.get("timestamp", "")))
	var parts := formatted.split(" ")
	if parts.size() > 1:
		return parts[1]
	return "--:--:--"


func _select_system_log_entry(entry_id: String) -> void:
	system_log_selected_id = entry_id
	var logs := _filter_system_log_records(store.get_system_logs(0))
	var selected_entry := _find_system_log_entry(logs, entry_id)
	if selected_entry.is_empty():
		return
	for row_id in system_log_event_rows.keys():
		var event_row := system_log_event_rows[row_id] as Button
		if is_instance_valid(event_row):
			_set_system_log_event_row_selected(event_row, str(row_id) == entry_id)
	if not is_instance_valid(system_log_detail_panel):
		return
	_replace_system_log_detail_panel(selected_entry)


func _set_system_log_event_row_selected(event_row: Button, active: bool) -> void:
	event_row.add_theme_stylebox_override("normal", _style_box(Color("#f5f9fe") if active else Color.WHITE, BLUE if active else Color("#e2e8f0"), 2 if active else 1, 7))
	var margin := event_row.get_child(0) as MarginContainer if event_row.get_child_count() > 0 else null
	if margin == null or margin.get_child_count() == 0:
		return
	var row := margin.get_child(0) as HBoxContainer
	if row == null or row.get_child_count() == 0:
		return
	var selection := row.get_child(0) as Label
	if selection == null:
		return
	selection.text = "OK" if active else ""
	selection.add_theme_stylebox_override("normal", _style_box(Color("#eef6ff") if active else Color.WHITE, BLUE if active else Color("#d4dee9"), 1, 14))
	event_row.queue_redraw()


func _replace_system_log_detail_panel(entry: Dictionary) -> void:
	var current := system_log_detail_panel
	var parent := current.get_parent() if is_instance_valid(current) else null
	if parent == null:
		return
	var index := current.get_index()
	var replacement := _build_system_log_detail_panel(entry)
	replacement.custom_minimum_size = Vector2(0, 465)
	replacement.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	replacement.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	parent.remove_child(current)
	current.queue_free()
	parent.add_child(replacement)
	parent.move_child(replacement, index)
	system_log_detail_panel = replacement


func _system_log_entry_id(entry: Dictionary) -> String:
	var id := str(entry.get("id", "")).strip_edges()
	if id != "":
		return id
	return "%s|%s|%s|%s" % [str(entry.get("timestamp", "")), str(entry.get("action", "")), str(entry.get("sku", "")), str(entry.get("details", ""))]


func _find_system_log_entry(logs: Array[Dictionary], entry_id: String) -> Dictionary:
	if entry_id == "":
		return {}
	for entry in logs:
		if _system_log_entry_id(entry) == entry_id:
			return entry
	return {}


func _system_log_extended_metrics(logs: Array[Dictionary]) -> Dictionary:
	var metrics := {"completed": 0, "progress": 0, "errors": 0, "fallback": 0, "http_5xx": 0, "last_hour": 0}
	for entry in logs:
		if _system_log_is_error(entry):
			metrics["errors"] = int(metrics.get("errors", 0)) + 1
		elif _system_log_is_completed(entry):
			metrics["completed"] = int(metrics.get("completed", 0)) + 1
		else:
			metrics["progress"] = int(metrics.get("progress", 0)) + 1
		if bool(entry.get("fallback_used", false)) or str(entry.get("transport", "")).to_lower() == "web":
			metrics["fallback"] = int(metrics.get("fallback", 0)) + 1
		if int(entry.get("http_code", 0)) >= 500:
			metrics["http_5xx"] = int(metrics.get("http_5xx", 0)) + 1
		if _system_log_is_recent(entry):
			metrics["last_hour"] = int(metrics.get("last_hour", 0)) + 1
	return metrics


func _system_log_is_recent(entry: Dictionary, window_seconds: int = 3600) -> bool:
	var timestamp := str(entry.get("timestamp", "")).replace("T", " ").strip_edges()
	if timestamp == "":
		return false
	var parsed := Time.get_datetime_dict_from_datetime_string(timestamp, false)
	if parsed.is_empty():
		return false
	var event_unix := Time.get_unix_time_from_datetime_dict(parsed)
	var age := Time.get_unix_time_from_system() - event_unix
	return age >= 0 and age <= window_seconds


func _system_log_is_error(entry: Dictionary) -> bool:
	var status := str(entry.get("status", "")).to_lower()
	if status == "failed" or status == "error":
		return true
	if status == "completed" or status == "success":
		return false
	var joined := ("%s %s" % [str(entry.get("action", "")), str(entry.get("details", ""))]).to_lower()
	return joined.contains("falhou") or joined.contains("erro") or joined.contains("timeout") or joined.contains("nao confirmado") or joined.contains("indisponivel")


func _system_log_is_completed(entry: Dictionary) -> bool:
	var status := str(entry.get("status", "")).to_lower()
	if status == "completed" or status == "success":
		return true
	if status == "failed" or status == "error":
		return false
	var action := str(entry.get("action", "")).to_lower()
	var details := str(entry.get("details", "")).to_lower()
	return not _system_log_is_error(entry) and (action.contains("conclu") or action.contains("sucesso") or action.contains("recuperado") or details.contains("concluido com sucesso"))


func _system_log_origin(entry: Dictionary) -> String:
	var explicit_origin := str(entry.get("origin", "")).strip_edges()
	if explicit_origin != "":
		return explicit_origin
	var transport := str(entry.get("transport", "")).to_lower()
	if transport == "api":
		return "API Grupo RS"
	if transport == "web":
		return "Portal web"
	if transport == "firebase":
		return "Firebase"
	var joined := ("%s %s" % [str(entry.get("action", "")), str(entry.get("details", ""))]).to_lower()
	if joined.contains("api"):
		return "API Grupo RS"
	if joined.contains("firebase"):
		return "Firebase"
	return "Sistema local"


func _system_log_result(entry: Dictionary) -> String:
	if _system_log_is_error(entry):
		return "Falha acionavel"
	if _system_log_is_completed(entry):
		return "Operacao concluida e confirmada"
	return "Em andamento / aguardando confirmacao"


func _log_input_date(value: String) -> String:
	var clean := value.strip_edges()
	var date_part := clean.split(" ")[0] if clean.contains(" ") else clean
	if date_part.contains("/"):
		var parts := date_part.split("/")
		if parts.size() == 3:
			return "%s-%s-%s" % [parts[2], parts[1], parts[0]]
	return date_part


func _log_input_bound(value: String, end_of_day: bool) -> String:
	var clean := value.strip_edges()
	var date_part := _log_input_date(clean)
	var time_part := clean.split(" ")[1] if clean.contains(" ") and clean.split(" ").size() > 1 else ("23:59:59" if end_of_day else "00:00:00")
	if time_part.count(":") == 1:
		time_part += ":00"
	return "%s %s" % [date_part, time_part]


func _filter_system_log_records(logs: Array) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var start := _log_input_bound(system_log_selected_date, false)
	var finish := _log_input_bound(system_log_end_date, true)
	var search := system_log_search_term.strip_edges().to_lower()
	for raw_entry in logs:
		if typeof(raw_entry) != TYPE_DICTIONARY:
			continue
		var entry := raw_entry as Dictionary
		var timestamp := str(entry.get("timestamp", "")).replace("T", " ")
		if start != "" and timestamp < start:
			continue
		if finish != "" and timestamp > finish:
			continue
		if search != "":
			var haystack := ("%s %s %s" % [str(entry.get("sku", "")), str(entry.get("action", "")), str(entry.get("details", ""))]).to_lower()
			if not haystack.contains(search):
				continue
		if not _log_matches_type(entry, system_log_type_filter):
			continue
		result.append(entry)
	return result


