	if arya_manual_token_input:
		arya_manual_token_input.clear()
	_set_arya_config_status("Token manual salvo. Clique em Testar para confirmar.", GREEN)


func _request_test_arya_token() -> void:
	var token := _arya_token()
	if token == "":
		_show_warning("Arya", "Nenhum token salvo para testar.")
		return
	_set_arya_config_status("Testando API da Arya...", BLUE_DARK)
	var result := await _lookup_arya_chip_status("89555483000025854947")
	var status := str(result.get("status", ""))
	if status == "login":
		_set_arya_config_status("Token ausente, vencido ou invalido. Conecte de novo.", RED)
