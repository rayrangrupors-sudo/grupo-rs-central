func _on_remote_operation_localized(kind: String, serial: String) -> void:
	var clean_serial := _digits_only(serial)
	var current_serial := _digits_only(_field_text("imei")) if form_fields.has("imei") else ""
	# A fila conclui a operacao enquanto o formulario ainda esta aberto. Para
	# cadastro e modificacao, voltar para a lista evita deixar o operador preso
	# em uma tela com "confirmacao pendente" depois que a API e o Firebase ja
	# confirmaram a mesma serie.
	# Nessa situacao editing_sku pode estar vazio (por exemplo, aparelho
	# legado/inicializado fora do Firebase), portanto a presenca de um campo IMEI
	# e a evidencia mais confiavel de que devemos voltar para a lista.
	var imei_field: Variant = form_fields.get("imei", null)
	var on_equipment_form := editing_sku != "" or (imei_field is LineEdit and is_instance_valid(imei_field))
	if on_equipment_form and (current_serial == "" or current_serial == clean_serial):
		_show_list()
	else:
		_refresh_table()


func _execute_equipment_modification(request: Dictionary) -> void:
	if vehicle_reassignment_running:
		return
	vehicle_reassignment_running = true
	_update_form_grupo_rs_reassign_button()
	var progress := _show_vehicle_reassignment_progress_dialog(
		"Modificando equipamento no Grupo RS",
		"1/3 Consultando o aparelho e validando os dados",
		"Nenhum registro sera excluido"
	)
	var result := await _perform_equipment_modification(request, progress)
	if is_instance_valid(progress):
		progress.queue_free()
	vehicle_reassignment_running = false
	_update_form_grupo_rs_reassign_button()
	var serial := str(request.get("remote_serial", request.get("serial", "")))
	if not bool(result.get("ok", false)):
		var failure_message := str(result.get("message", "Nao foi possivel concluir a modificacao."))
		_log_system_action("Falhou modificacao Grupo RS", failure_message, serial)
		_show_error("Modificacao remota", failure_message)
		return
	var local_result := _finalize_local_equipment_modification(request)
	if not bool(local_result.get("ok", false)):
		_log_system_action("Falhou atualizacao local apos modificacao", str(local_result.get("message", "")), serial)
		_show_error("Modificacao remota", "O Grupo RS confirmou a modificacao, mas o cadastro local nao foi atualizado.")
		return
	var firebase_result := await _ensure_firebase_modification_saved(serial, local_result.get("product", {}) as Dictionary)
	if not bool(firebase_result.get("ok", false)):
		var firebase_message := str(firebase_result.get("message", "O Firebase nao confirmou a gravacao da modificacao."))
		_log_system_action("Falhou gravacao Firebase apos modificacao", firebase_message, serial)
		_show_error("Modificacao remota", firebase_message)
		return
	var details := "Serie: %s | Placa: %s | Chip: %s | Telefone: %s | APN: %s" % [
		serial,
		str(request.get("new_plate", "")) if str(request.get("new_plate", "")).strip_edges() != "" else "mantida",
		str(request.get("chip_number", request.get("chip", ""))),
		str(request.get("phone", "")),
		str(request.get("apn", "")),
	]
	details += " | Tipo: %s | Operadora: %s | Status: %s" % [
		str(request.get("model", "")),
		str(request.get("operator", "")),
		str(request.get("tracker_status", "")),
	]
	_log_system_action("Modificou equipamento Grupo RS", details, serial)
	_show_success("Grupo RS", "Equipamento modificado e confirmado com sucesso.")
	_show_list()


func _execute_vehicle_reassignment(request: Dictionary) -> void:
	if vehicle_reassignment_running:
		return
	vehicle_reassignment_running = true
	_update_form_grupo_rs_reassign_button()
	var progress := _show_vehicle_reassignment_progress_dialog(
		"Alterando placa no Grupo RS",
		"1/2 Conferindo serie, placa e disponibilidade",
		"Nenhum registro sera excluido"
	)
	var result := await _perform_vehicle_reassignment(request, progress)
	if is_instance_valid(progress):
		progress.queue_free()
	vehicle_reassignment_running = false
	_update_form_grupo_rs_reassign_button()

	var serial := str(request.get("remote_serial", ""))
	if not bool(result.get("ok", false)):
		var failure_message := str(result.get("message", "Nao foi possivel concluir a alteracao."))
		_log_system_action(
			"Falhou alteracao de placa Grupo RS",
			"%s -> %s | %s" % [str(request.get("old_plate", "")), str(request.get("new_plate", "")), failure_message],
			serial
		)
		_show_error("Alteracao de placa", failure_message)
		return

	var success_message := "Serie: %s\nPlaca: %s -> %s\nTitular: RS300\nTipo: Carro\nEquipamento e registros: preservados\nStatus local: Manutencao" % [
		serial,
		str(request.get("old_plate", "")),
		str(request.get("new_plate", "")),
	]
	_log_system_action(
		"Alterou placa Grupo RS",
		"Placa: %s -> %s | Equipamento e registros preservados | Titular: RS300 | Tipo: Carro | Status: Manutencao" % [str(request.get("old_plate", "")), str(request.get("new_plate", ""))],
		serial
	)
	_show_list()
	_show_vehicle_reassignment_success(request)


func _perform_vehicle_reassignment(request: Dictionary, progress: CanvasLayer = null, legacy_stage_callback: Callable = Callable()) -> Dictionary:
	if _grupo_rs_api_reads_enabled() and _grupo_rs_supports_modern_api():
		_set_progress_dialog_content(progress, "1/2 Conferindo serie, placa e disponibilidade pela API", "%s -> %s" % [str(request.get("old_plate", "")), str(request.get("new_plate", ""))])
		var api_result := await _perform_api_vehicle_reassignment(request)
		if bool(api_result.get("handled", false)):
			if not bool(api_result.get("ok", false)):
				return {"ok": false, "message": str(api_result.get("message", "A API nao confirmou a alteracao da placa.")), "api": true}
			_set_progress_dialog_content(progress, "2/2 Placa confirmada pela API oficial", "Preservando equipamento e registros locais")
			var api_local_result := _finalize_local_vehicle_reassignment(request)
			if not bool(api_local_result.get("ok", false)):
				var rollback := await _rollback_api_vehicle_reassignment(api_result, request)
				var rollback_message := "Placa anterior restaurada na API." if bool(rollback.get("ok", false)) else "Restauracao da placa na API falhou: %s" % str(rollback.get("message", ""))
				return {"ok": false, "partial": true, "message": "O cadastro local nao foi atualizado: %s\n%s" % [str(api_local_result.get("message", "")), rollback_message], "api": true}
			return {"ok": true, "api": true, "remote": api_result, "local": api_local_result}
	var prepared := await _prepare_modern_vehicle_reassignment(request)
	if not bool(prepared.get("ok", false)):
		return prepared
	_set_progress_dialog_content(progress, "2/2 Salvando e verificando no Grupo RS novo", "%s -> %s" % [str(request.get("old_plate", "")), str(request.get("new_plate", ""))])
	var modern_result := {
		"ok": true,
		"message": "A alteracao ja estava confirmada no Grupo RS novo; retomando as etapas pendentes.",
		"after": prepared.get("before", {}),
		"resumed": true,
	}
	if not bool(prepared.get("already_applied", false)):
		modern_result = await _update_modern_grupo_rs_vehicle_reassignment(prepared)
	if not bool(modern_result.get("ok", false)):
		return modern_result

	var local_result := _finalize_local_vehicle_reassignment(request)
	if not bool(local_result.get("ok", false)):
		return {
			"ok": false,
			"partial": true,
			"message": "Os dois sistemas remotos confirmaram a operacao, mas o Firebase nao aceitou a atualizacao: %s" % str(local_result.get("message", "")),
		}
	return {
		"ok": true,
		"modern": modern_result,
		"local": local_result,
	}


func _verify_legacy_grupo_rs_reassignment_removed(serial: String) -> Dictionary:
	var previous_mode := selected_branch_grupo_rs_mode
	var previous_base_url := selected_branch_grupo_rs_base_url
	var previous_platform_url := selected_branch_grupo_rs_platform_url
	selected_branch_grupo_rs_mode = "legacy"
	selected_branch_grupo_rs_base_url = _legacy_grupo_rs_delete_base_url()
	selected_branch_grupo_rs_platform_url = _legacy_grupo_rs_delete_platform_url()
	var exists := await _legacy_grupo_rs_equipment_exists(serial, 6, 2.0)
	selected_branch_grupo_rs_mode = previous_mode
	selected_branch_grupo_rs_base_url = previous_base_url
	selected_branch_grupo_rs_platform_url = previous_platform_url
	return exists


func _finalize_local_vehicle_reassignment(request: Dictionary) -> Dictionary:
	var previous_sku := str(request.get("local_sku", "")).strip_edges()
	var remote_serial := str(request.get("remote_serial", "")).strip_edges()
	var product := store.get_product(previous_sku)
	if product.is_empty():
		product = store.get_product(remote_serial)
	product["sku"] = remote_serial
	product["imei"] = remote_serial
	product["equipment_number"] = remote_serial
	product["plate"] = _format_grupo_rs_vehicle_plate(str(request.get("new_plate", "")))
	product["client"] = "RS300"
	product["tracker_status"] = "Manutencao"
	product["status"] = "Manutencao"
	product["location"] = "Manutencao"
	product["stock"] = 0
	if str(product.get("model", "")).strip_edges() == "":
		product["model"] = str(request.get("model", "Reutilizado"))
	if str(product.get("category", "")).strip_edges() == "":
		product["category"] = str(product.get("model", "Reutilizado"))
	if str(product.get("operator", "")).strip_edges() == "":
		product["operator"] = str(request.get("operator", ""))
	if str(product.get("chip_number", "")).strip_edges() == "":
		product["chip_number"] = str(request.get("chip", ""))
	if str(product.get("chip_phone", "")).strip_edges() == "":
		product["chip_phone"] = str(request.get("phone", ""))
	if str(product.get("apn", "")).strip_edges() == "":
		product["apn"] = str(request.get("apn", ""))
	var operation_note := "Placa reaproveitada no Grupo RS: %s -> %s. Equipamento e registros preservados." % [
		str(request.get("old_plate", "")),
		str(request.get("new_plate", "")),
	]
	var notes := str(product.get("notes", "")).strip_edges()
	if not notes.contains(operation_note):
		product["notes"] = "%s | %s" % [notes, operation_note] if notes != "" else operation_note
	var saved := store.upsert_product_replacing_sku(previous_sku, product)
	if saved.is_empty():
		return {"ok": false, "message": "falha ao atualizar o equipamento"}
	var maintenance := store.add_maintenances([{
		"client": "RS300",
		"plate": str(saved.get("plate", "")),
		"serial": remote_serial,
		"provider": "Reaproveitamento Grupo RS",
		"source_date": Time.get_datetime_string_from_system(false, true),
		"note": operation_note,
		"status": "pendente",
	}])
	var maintenance_errors: Array[String] = maintenance.get("errors", []) as Array[String]
	if not maintenance_errors.is_empty():
		return {"ok": false, "message": "falha ao registrar a manutencao"}
	return {"ok": true, "product": saved, "maintenance": maintenance}


func _save_form(remote_request: Dictionary = {}) -> void:
	var imei := (form_fields.get("imei") as LineEdit).text.strip_edges()
	var model := _selected_option_text(form_options.get("model"), true)
	var operator_name := _selected_option_text(form_options.get("operator"), true)

	if imei == "" or model == "" or operator_name == "":
		if not remote_request.is_empty():
			equipment_registration_running = false
		_show_warning("Aviso", "Preencha IMEI, tipo/modelo e operadora antes de salvar.")
		return

	var status := _selected_option_text(form_options.get("tracker_status"), false)
	if status == "":
		status = "Estoque"

	var stock := 1 if _status_key_from_text(status) == "estoque" else 0
	var grupo_data := form_grupo_rs_data if _search_key(str(form_grupo_rs_data.get("serial", ""))) == _search_key(imei) else {}
	var chip_number := _field_text("chip_number")
	var chip_phone := _local_registration_phone(_field_text("chip_phone"))
	var client_name := str(grupo_data.get("client", "")).strip_edges()
	var apn := _selected_option_text(form_options.get("apn_source"), true).to_lower()
	if chip_number == "":
		chip_number = str(grupo_data.get("chip", "")).strip_edges()
	if chip_phone == "":
		chip_phone = _local_registration_phone(str(grupo_data.get("phone", "")))
	if apn == "":
		apn = str(grupo_data.get("apn", "")).strip_edges().to_lower()
	var notes_parts: Array[String] = ["Operadora: %s" % operator_name]
	if client_name != "":
		notes_parts.append("Cliente Grupo RS: %s" % client_name)
	if apn != "":
		notes_parts.append("APN: %s" % apn)
	var requested_plate := _format_grupo_rs_vehicle_plate(_field_text("plate"))
	var remote_pending := not remote_request.is_empty()
	if remote_pending and requested_plate != "":
		notes_parts.append("Vinculacao pendente: %s" % requested_plate)

	var product := {
		"sku": imei.to_upper(),
		"imei": imei,
		"equipment_number": str(grupo_data.get("serial", imei)).strip_edges(),
		"apn": apn,
		"chip_number": chip_number,
		"chip_phone": chip_phone,
		"model": model,
		"operator": operator_name,
		# Enquanto a API nao confirmar, nao exponha a placa como se ja estivesse
		# vinculada. A finalizacao remota preenche estes campos somente apos a
		# leitura confirmada da associacao.
		"plate": "" if remote_pending else requested_plate,
		"client": "" if remote_pending else client_name,
		"tracker_status": status,
		"status": status,
		"name": _name_from_form(imei),
		"category": model,
		"location": status,
		"unit": "un",
		"stock": stock,
		"min_stock": 0,
		"cost": 0.0,
		"remote_registration_status": "pendente" if remote_pending else "local",
		"notes": " | ".join(notes_parts),
	}

	var target_sku := imei.to_upper()
	var was_editing := editing_sku != "" or not store.get_product(target_sku).is_empty()
	var old_sku := editing_sku
	var duplicate := store.find_duplicate_product(product, old_sku)
	if not duplicate.is_empty():
		var duplicate_product: Dictionary = duplicate.get("product", {})
		_show_warning(
			"Possivel duplicidade",
			"Ja existe um cadastro com a mesma %s:\n%s" % [
				str(duplicate.get("field", "informacao")),
				_log_product_details(duplicate_product),
			]
		)
		if not remote_request.is_empty():
			equipment_registration_running = false
		return

	# Cadastro remoto e transacional: nao persistir um rascunho sem placa antes
	# da confirmacao estrita da API. A fila mantem os dados somente em memoria e
	# a finalizacao grava o produto apenas quando IMEI e placa forem confirmados.
	if not remote_request.is_empty():
		if remote_queue_controller != null and is_instance_valid(remote_queue_controller):
			var queue_id: String = remote_queue_controller.enqueue("Cadastro", product.duplicate(true), remote_request.duplicate(true))
			if queue_id != "":
				return
		else:
			var legacy_queue_id: String = _enqueue_remote_operation("Cadastro", product.duplicate(true), remote_request.duplicate(true))
			if legacy_queue_id != "":
				return
		equipment_registration_running = false
		_show_error("Cadastro remoto", "Nao foi possivel colocar o cadastro na fila. Nenhum dado foi gravado.")
		return

	var saved := store.upsert_product_replacing_sku(old_sku, product)
	if saved.is_empty():
		if not remote_request.is_empty():
			equipment_registration_running = false
		_show_error("Erro", "Nao foi possivel salvar o equipamento.")
		return

	var action := "Editou equipamento" if was_editing else "Cadastrou equipamento"
	var details := _log_product_details(saved)
	if old_sku != "" and old_sku != target_sku:
		details += " | Codigo anterior: %s" % old_sku
	_log_system_action(action, details, target_sku)
	var api_edit_request: Dictionary = {}
	if was_editing and remote_request.is_empty() and _grupo_rs_supports_modern_api():
		api_edit_request = _equipment_registration_request_from_form()
		api_edit_request["serial"] = imei
	_show_list()
	if not api_edit_request.is_empty():
		if remote_queue_controller != null and is_instance_valid(remote_queue_controller):
			remote_queue_controller.enqueue("Modificacao", saved.duplicate(true), api_edit_request.duplicate(true))
		else:
			_enqueue_equipment_api_edit(saved, api_edit_request)
	if not remote_request.is_empty():
		if remote_queue_controller != null and is_instance_valid(remote_queue_controller):
			remote_queue_controller.enqueue("Cadastro", saved.duplicate(true), remote_request.duplicate(true))
		return

	await get_tree().process_frame

	_show_error_dialog(
	true,
	"Sucesso",
	"Aparelho salvo com sucesso!"
)


func _preview_timeline_import() -> void:
