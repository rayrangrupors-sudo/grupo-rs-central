func _is_bulk_serial_header_key(key: String) -> bool:
	return key == "numero" \
		or key == "numeroserie" \
		or key == "serie" \
		or key == "numerodeserie" \
		or key == "numeroequipamento" \
		or key == "numeroequip" \
		or key.contains("numeroserie") \
		or key.contains("numerodeequipamento") \
		or key.contains("numeroequipamento")


func _is_bulk_plate_header_key(key: String) -> bool:
	return key == "placa" or key.contains("placa")


func _clean_xlsx_serial(value: String) -> String:
	var clean := value.strip_edges()
	if clean.ends_with(".0") and clean.is_valid_float():
		clean = clean.substr(0, clean.length() - 2)
	return _digits_only(clean)


func _digits_only(value: String) -> String:
	var result := ""
	for i in range(value.length()):
		var code := value.unicode_at(i)
		if code >= 48 and code <= 57:
			result += value.substr(i, 1)
	return result


func _normalize_bulk_plate(value: String) -> String:
	var clean := value.strip_edges().to_upper()
	clean = clean.replace("â€“", "-").replace("â€”", "-")
	while clean.contains("  "):
		clean = clean.replace("  ", " ")
	var plate_regex := RegEx.new()
	if plate_regex.compile("^([A-Z]{3})\\s*-\\s*([A-Z0-9]{3,4})$") == OK:
		var plate_match := plate_regex.search(clean)
		if plate_match != null:
			return "%s - %s" % [plate_match.get_string(1), plate_match.get_string(2)]
	return clean


func _looks_like_bulk_serial(value: String) -> bool:
	var clean := _digits_only(value)
	return clean.length() == 9 and clean.begins_with("024")


func _looks_like_bulk_delete_serial(value: String) -> bool:
	var clean := _digits_only(value)
	return clean.length() == 9


func _looks_like_bulk_plate(value: String) -> bool:
	var key := _bulk_key(value)
	if key.length() < 4:
		return false
	return key.begins_with("grs") or key.begins_with("aaa") or key.begins_with("nov") or key.begins_with("xrs")


func _looks_like_standalone_bulk_delete_plate(value: String) -> bool:
	var clean := _normalize_bulk_plate(value)
	var regex := RegEx.new()
	if regex.compile("^[A-Z]{3}\\s-\\s[A-Z0-9]{3,4}$") != OK:
		return false
	return regex.search(clean) != null


func _extract_bulk_serial_from_text(value: String) -> String:
	var regex := RegEx.new()
	if regex.compile("\\b024\\d{6}\\b") != OK:
		return ""
	var match := regex.search(value)
	if match == null:
		return ""
	return _clean_xlsx_serial(match.get_string())


func _extract_bulk_delete_serial_from_line(line: String) -> String:
	var cells := _split_bulk_line(line)
	if cells.size() >= 3:
		for i in range(1, cells.size() - 1):
			var plate := _normalize_bulk_plate(_clean_pasted_cell(cells[i]))
			if not _looks_like_legacy_delete_plate(plate):
				continue
			var next_cell := _clean_pasted_cell(cells[i + 1])
			if _looks_like_bulk_delete_serial(next_cell):
				return _digits_only(next_cell)

	for cell in cells:
		var clean_cell := _clean_pasted_cell(cell)
		var action_key := _bulk_key(clean_cell)
		if action_key == "selecionar" or action_key == "desativar":
			continue
		if _looks_like_bulk_delete_serial(clean_cell):
			return _digits_only(clean_cell)

	var regex := RegEx.new()
	if regex.compile("\\b\\d{9}\\b") != OK:
		return ""
	var match := regex.search(line)
	if match == null:
		return ""
	return _digits_only(match.get_string())


func _looks_like_legacy_delete_plate(value: String) -> bool:
	var clean := value.strip_edges()
	if clean == "":
		return false
	if _looks_like_bulk_plate(clean):
		return true
	var key := _bulk_key(clean)
	if key == "selecionar" or key == "desativar":
		return false
	if key.length() < 3:
		return false
	if clean.contains("-"):
		return true
	if key.is_valid_int():
		return false
	return key.length() >= 3


func _looks_like_legacy_vehicle_date(value: String) -> bool:
	var regex := RegEx.new()
	if regex.compile("^\\s*\\d{2}/\\d{2}/\\d{4}(?:\\s+\\d{2}:\\d{2}(?::\\d{2})?)?\\s*$") != OK:
		return false
	return regex.search(value) != null


func _extract_bulk_plate_from_text(value: String) -> String:
	var regex := RegEx.new()
	if regex.compile("\\b(?:GRS|AAA|NOV|XRS)\\s*-?\\s*[A-Z]?\\d+\\b") != OK:
		return ""
	var match := regex.search(value.to_upper())
	if match == null:
		return ""
	var plate := match.get_string()
	if not plate.contains("-"):
		var key := _bulk_key(plate).to_upper()
		if key.length() > 3:
			plate = "%s - %s" % [key.substr(0, 3), key.substr(3)]
	return _normalize_bulk_plate(plate)


func _name_from_bulk_row(row: Dictionary) -> String:
	var plate := str(row.get("plate", "")).strip_edges().to_upper()
	if plate != "":
		return plate
	return "Rastreador %s" % str(row.get("serial", "")).strip_edges()


func _show_bulk_result(message: String, success: bool) -> void:
