func _set_location_progress(progress: Dictionary, stage: int, message: String, detail: String = "") -> void:
	var layer: Variant = progress.get("layer")
	if layer == null or not is_instance_valid(layer):
		return
	var indicator: Variant = progress.get("indicator")
	if indicator != null and is_instance_valid(indicator) and indicator.has_method("set_state"):
		indicator.set_state(stage, GREEN if stage >= 3 else BLUE)
	var message_label: Variant = progress.get("message")
	if message_label != null and is_instance_valid(message_label):
		message_label.text = message
	var detail_label: Variant = progress.get("detail")
	if detail_label != null and is_instance_valid(detail_label):
		detail_label.text = detail
	var step_labels: Array = progress.get("steps", []) as Array
	for index in range(step_labels.size()):
		var step_label: Variant = step_labels[index]
		if step_label == null or not is_instance_valid(step_label):
			continue
		var step_color := MUTED
		if index < stage:
			step_color = GREEN
		elif index == stage:
			step_color = BLUE_DARK
		step_label.add_theme_color_override("font_color", step_color)
		step_label.add_theme_font_size_override("font_size", 14 if index == stage else 13)


func _close_location_progress(progress: Dictionary) -> void:
	var layer: Variant = progress.get("layer")
	if layer != null and is_instance_valid(layer):
		layer.queue_free()


func _location_progress(callback: Callable, stage: int, message: String, detail: String = "") -> void:
	if callback.is_valid():
		callback.call(stage, message, detail)


func _schedule_visible_location_status_batch(products: Array[Dictionary], start_index: int, end_index: int, total_count: int) -> void:
	var signature := _visible_location_signature(products, start_index, end_index, total_count)
	if signature == location_visible_signature:
		return

	location_visible_signature = signature
	location_visible_batch_id += 1
	location_auto_queue.clear()
	location_auto_running = 0
	call_deferred("_start_visible_location_status_batch", products, location_visible_batch_id)


func _visible_location_signature(products: Array[Dictionary], start_index: int, end_index: int, total_count: int) -> String:
	var parts: Array[String] = [
		str(table_current_page),
		str(start_index),
		str(end_index),
		str(total_count),
		str(int(Time.get_unix_time_from_system()) / LOCATION_STATUS_CACHE_SECONDS),
	]
	for product in products:
		parts.append(_location_serial_for_product(product))
	return "|".join(parts)


func _start_visible_location_status_batch(products: Array[Dictionary], batch_id: int) -> void:
	if batch_id != location_visible_batch_id:
		return

	var queued := false
	for product in products:
		var serial := _location_serial_for_product(product)
		if serial == "":
			continue
		if bool(location_status_busy.get(serial, false)):
			continue
		if _location_status_cache_is_fresh(serial):
			continue

		location_status_busy[serial] = batch_id
		location_status_cache[serial] = {
			"label": "Consultando",
			"color": Color("#0b6fae"),
			"checked_at": Time.get_unix_time_from_system(),
			"previous": location_status_cache.get(serial, {}).duplicate(true),
		}
		location_auto_queue.append(serial)
		queued = true

	if queued:
		_refresh_table()
		_pump_location_auto_queue(batch_id)


func _pump_location_auto_queue(batch_id: int) -> void:
	if batch_id != location_visible_batch_id:
		return
	while location_auto_running < LOCATION_VISIBLE_AUTO_CONCURRENCY and not location_auto_queue.is_empty():
		var serial := str(location_auto_queue.pop_front())
		location_auto_running += 1
		_run_auto_location_lookup(serial, batch_id)


func _run_auto_location_lookup(serial: String, batch_id: int) -> void:
	var result := await _lookup_grupo_rs_location(serial)
	if batch_id != location_visible_batch_id:
		if int(location_status_busy.get(serial, -9999)) == batch_id:
			location_status_busy.erase(serial)
		return

	location_status_busy.erase(serial)
	if bool(result.get("ok", false)):
		_cache_location_status(serial, result)
	else:
		_cache_location_failure(serial, result)
	location_auto_running = maxi(location_auto_running - 1, 0)
	_refresh_table()
	_pump_location_auto_queue(batch_id)


func _cache_location_status(serial: String, location: Dictionary) -> void:
	var status := _location_monitoring_status(location)
	var status_data := {
		"label": str(status.get("label", "Nao verificado")),
		"color": status.get("color", Color("#0b6fae")),
		"updated_at": str(location.get("updated_at", "")),
		"ignition": str(location.get("ignition", "")),
		"monitoring_status": str(location.get("monitoring_status", "")),
		"speed": str(location.get("speed", "")),
		"battery": str(location.get("battery", "")),
		"battery_voltage": str(location.get("battery_voltage", location.get("battery", ""))),
		"backup_battery": str(location.get("backup_battery", "")),
		"client": str(location.get("client", "")),
		"client_id": str(location.get("client_id", "")),
		"vehicle_id": str(location.get("vehicle_id", "")),
		"plate": str(location.get("plate", "")),
		"checked_at": Time.get_unix_time_from_system(),
	}
	location_status_cache[serial] = status_data

	var equipment_serial := str(location.get("equipment_serial", "")).strip_edges()
	if equipment_serial != "" and equipment_serial != serial:
		location_status_cache[equipment_serial] = status_data


func _location_failure_is_transient(result: Dictionary) -> bool:
	var message := str(result.get("message", "")).strip_edges().to_lower()
	if message == "":
		return false
	if message.contains("nao localizou") or message.contains("nao encontrou o equipamento") or message.contains("mapa nao retornou"):
		return false
	for fragment in ["login", "token", "indisponivel", "sem resposta", "conexao", "timeout", "http ", "falha", "recusou", "plataforma esta desligada"]:
		if message.contains(fragment):
			return true
	return false


func _cache_location_failure(serial: String, result: Dictionary, previous: Dictionary = {}) -> void:
	var old_status := previous.duplicate(true)
	if old_status.is_empty():
		var current: Dictionary = location_status_cache.get(serial, {})
		var saved_previous: Variant = current.get("previous", {})
		if typeof(saved_previous) == TYPE_DICTIONARY:
			old_status = (saved_previous as Dictionary).duplicate(true)
	var message := str(result.get("message", "Localizacao indisponivel.")).strip_edges()
	if _location_failure_is_transient(result):
		var temporary := old_status if not old_status.is_empty() and str(old_status.get("label", "")) not in ["Consultando", "Nao localizado"] else {}
		if temporary.is_empty():
			temporary = {
				"label": "Aguardando API",
				"color": YELLOW,
			}
		else:
			temporary["label"] = "Revalidando"
			temporary["color"] = YELLOW
		temporary["message"] = message
		temporary["temporary"] = true
		temporary["checked_at"] = Time.get_unix_time_from_system()
		location_status_cache[serial] = temporary
		return
	location_status_cache[serial] = {
		"label": "Nao localizado",
		"color": MUTED,
		"message": message if message != "" else "Localizacao indisponivel.",
		"temporary": false,
		"checked_at": Time.get_unix_time_from_system(),
	}


func _cached_location_status_for_serial(serial: String) -> Dictionary:
	var clean_serial := serial.strip_edges()
	if clean_serial == "":
		return {"label": "Sem serie", "color": MUTED}
	if bool(location_status_busy.get(clean_serial, false)):
		return {"label": "Consultando", "color": Color("#0b6fae")}
	var cached: Dictionary = location_status_cache.get(clean_serial, {})
	if cached.is_empty():
		return {"label": "Consultar localizacao", "color": Color("#0b6fae")}
	return cached


func _location_status_cache_is_fresh(serial: String) -> bool:
	var cached: Dictionary = location_status_cache.get(serial, {})
	if cached.is_empty():
		return false
	if str(cached.get("label", "")) == "Consultando":
		return false
	var checked_at := int(cached.get("checked_at", 0))
	if checked_at <= 0:
		return false
	return int(Time.get_unix_time_from_system()) - checked_at < LOCATION_STATUS_CACHE_SECONDS


func _refresh_visible_internal_batteries() -> void:
	# A bateria interna nao participa mais do ciclo de consultas.
	return


func _inventory_visible_scope_identity(product: Dictionary) -> String:
	var sku := str(product.get("sku", product.get("id", ""))).strip_edges()
	var serial := _digits_only(_location_serial_for_product(product))
	var query := _arya_product_query_key(product).strip_edges()
	if sku == "" and serial == "" and query == "":
		return ""
	return "%s|%s|%s" % [sku, serial, query]


func _inventory_visible_scope_snapshot(products: Array[Dictionary]) -> Dictionary:
	var scope: Dictionary = {}
	for product in products:
		var identity := _inventory_visible_scope_identity(product)
		if identity == "":
			continue
		scope[identity] = {
			"serial": _digits_only(_location_serial_for_product(product)),
			"query": _arya_product_query_key(product),
			"iccid": _arya_product_local_iccid(product),
		}
	return scope


func _sync_inventory_visible_scope(products: Array[Dictionary]) -> void:
	var next_scope := _inventory_visible_scope_snapshot(products)
	var next_context_signature := "%d|%s|%s|%s" % [
		table_current_page,
		selected_status_filter_key,
		str(search_input.text if search_input else ""),
		selected_branch_id,
	]
	var context_changed := next_context_signature != inventory_visible_scope_context_signature
	if not context_changed and next_scope.size() == inventory_visible_scope.size():
		var unchanged := true
		for raw_identity in next_scope.keys():
			if not inventory_visible_scope.has(raw_identity):
				unchanged = false
				break
		if unchanged:
			return
	if context_changed:
		# Filtro, pagina ou base diferente: nenhuma resposta da tela anterior
		# pode continuar sendo exibida como se pertencesse ao novo contexto.
		location_status_cache.clear()
		location_status_busy.clear()
		arya_status_cache.clear()
		arya_status_busy.clear()
		arya_resolve_cache.clear()
		linksolutions_sim_cache.clear()
		location_auto_queue.clear()
		location_auto_running = 0
		arya_auto_queue.clear()
		arya_auto_running = 0
		inventory_visible_scope.clear()

	# A pagina/filtro mudou: invalida consultas antigas e descarta apenas os
	# caches operacionais das linhas que deixaram de estar visiveis.
	for raw_identity in inventory_visible_scope.keys():
		var identity := str(raw_identity)
		if next_scope.has(identity):
			continue
		var previous := inventory_visible_scope.get(identity, {}) as Dictionary
		var serial := _digits_only(str(previous.get("serial", "")))
		var query := str(previous.get("query", "")).strip_edges()
		var iccid := str(previous.get("iccid", "")).strip_edges()
		if serial != "":
			location_status_cache.erase(serial)
			location_status_busy.erase(serial)
		if query != "":
			arya_status_cache.erase(query)
			arya_status_busy.erase(query)
			arya_resolve_cache.erase(query)
		if iccid != "":
			linksolutions_sim_cache.erase(iccid)

	location_visible_batch_id += 1
	location_visible_signature = ""
	location_auto_queue.clear()
	location_auto_running = 0
	arya_visible_batch_id += 1
	arya_visible_signature = ""
	arya_auto_queue.clear()
	arya_auto_running = 0
	online_location_queue.clear()
	# Descarta qualquer estado residual do caminho legado de bateria ao trocar
	# pagina, filtro, aba ou base.
	internal_battery_queue.clear()
	internal_battery_cache.clear()
	internal_battery_busy.clear()
	internal_battery_running = 0
	inventory_visible_scope = next_scope
	inventory_visible_scope_context_signature = next_context_signature
	_invalidate_visible_inventory_device_cycle()


func _clear_inventory_visible_scope() -> void:
	if not inventory_visible_scope.is_empty():
		_sync_inventory_visible_scope([])
	else:
		_invalidate_visible_inventory_device_cycle()
	inventory_visible_scope.clear()
	inventory_visible_scope_context_signature = ""


func schedule_visible_inventory_device_cycle(products: Array[Dictionary], start_index: int, end_index: int, total_count: int) -> void:
	var signature := _visible_inventory_device_cycle_signature(products, start_index, end_index, total_count)
	if signature == inventory_device_cycle_signature and inventory_device_cycle_pending_signature == "":
		return

	var snapshot: Array[Dictionary] = products.duplicate(true)
	_cancel_inventory_query_requests()
	inventory_device_cycle_queue.clear()
	inventory_device_cycle_generation += 1
	if inventory_device_cycle_running:
		inventory_device_cycle_pending_products = snapshot
		inventory_device_cycle_pending_signature = signature
		return

	_start_visible_inventory_device_cycle(snapshot, signature, inventory_device_cycle_generation)


func _visible_inventory_device_cycle_signature(products: Array[Dictionary], start_index: int, end_index: int, total_count: int) -> String:
	var parts: Array[String] = [
		str(table_current_page),
		str(start_index),
		str(end_index),
		str(total_count),
		str(selected_status_filter_key),
		str(search_input.text if search_input else ""),
	]
	for product in products:
		# Cache e flags de consulta mudam a cada retorno e nao podem reiniciar o ciclo.
		# A fila so deve trocar quando a pagina, filtro ou identidade da linha mudar.
		parts.append(str(product.get("sku", product.get("id", ""))))
		parts.append(_location_serial_for_product(product))
		parts.append(_arya_product_query_key(product))
	return "|".join(parts)


func _invalidate_visible_inventory_device_cycle() -> void:
	_cancel_inventory_query_requests()
	inventory_device_cycle_generation += 1
	inventory_device_cycle_signature = ""
	inventory_device_cycle_pending_products.clear()
	inventory_device_cycle_pending_signature = ""
	if not inventory_device_cycle_running:
		inventory_device_cycle_products.clear()
		inventory_device_cycle_queue.clear()
		inventory_device_cycle_workers = 0


func _start_visible_inventory_device_cycle(products: Array[Dictionary], signature: String, generation: int) -> void:
	inventory_device_cycle_products = products.duplicate(true)
	inventory_device_cycle_signature = signature
	inventory_device_cycle_queue.clear()
	inventory_device_cycle_workers = 0
	inventory_device_cycle_running = true
	call_deferred("_run_visible_inventory_device_cycle", generation)


func _handoff_visible_inventory_device_cycle() -> void:
	if inventory_device_cycle_pending_signature == "":
		inventory_device_cycle_running = false
		inventory_device_cycle_signature = ""
		inventory_device_cycle_products.clear()
		inventory_device_cycle_queue.clear()
		inventory_device_cycle_workers = 0
		return

	var next_products: Array[Dictionary] = inventory_device_cycle_pending_products.duplicate(true)
	var next_signature := inventory_device_cycle_pending_signature
	inventory_device_cycle_pending_products.clear()
	inventory_device_cycle_pending_signature = ""
	_start_visible_inventory_device_cycle(next_products, next_signature, inventory_device_cycle_generation)


func _run_visible_inventory_device_cycle(generation: int) -> void:
	while inventory_device_cycle_running and is_inside_tree():
		if generation != inventory_device_cycle_generation:
			_handoff_visible_inventory_device_cycle()
			return

		inventory_device_cycle_queue = inventory_device_cycle_products.duplicate(true)
		inventory_device_cycle_workers = 0
		while generation == inventory_device_cycle_generation and (not inventory_device_cycle_queue.is_empty() or inventory_device_cycle_workers > 0):
			while inventory_device_cycle_workers < INVENTORY_DEVICE_CYCLE_CONCURRENCY and not inventory_device_cycle_queue.is_empty():
				var product := inventory_device_cycle_queue.pop_front() as Dictionary
				inventory_device_cycle_workers += 1
				_run_visible_inventory_device_lookup_worker(product, generation)
			await get_tree().process_frame

		if generation != inventory_device_cycle_generation:
			_handoff_visible_inventory_device_cycle()
			return

		var pause_until := Time.get_ticks_msec() + int(inventory_device_cycle_pause_seconds * 1000.0)
		while Time.get_ticks_msec() < pause_until:
			if generation != inventory_device_cycle_generation:
				_handoff_visible_inventory_device_cycle()
				return
			await get_tree().process_frame

	if not is_inside_tree():
		inventory_device_cycle_running = false



func _run_visible_inventory_device_lookup_worker(product: Dictionary, generation: int) -> void:
	var worker_state: Dictionary = {"done": false, "cancelled": false}
	_run_visible_inventory_device_lookup_guarded(product, generation, worker_state)
	var deadline_msec := Time.get_ticks_msec() + int(INVENTORY_DEVICE_CYCLE_ROW_TIMEOUT_SECONDS * 1000.0)
	while not bool(worker_state.get("done", false)) and Time.get_ticks_msec() < deadline_msec:
		await get_tree().process_frame

	if not bool(worker_state.get("done", false)):
		worker_state["cancelled"] = true
		if generation == inventory_device_cycle_generation:
			_mark_inventory_device_lookup_timeout(product)

	if generation == inventory_device_cycle_generation:
		inventory_device_cycle_workers = maxi(inventory_device_cycle_workers - 1, 0)


func _run_visible_inventory_device_lookup_guarded(product: Dictionary, generation: int, worker_state: Dictionary) -> void:
	var result := await _run_visible_inventory_device_lookup(product, generation, worker_state)
	worker_state["result"] = result
	worker_state["done"] = true


func _run_visible_inventory_device_lookup(product: Dictionary, generation: int, worker_state: Dictionary = {}) -> bool:
	var serial := _digits_only(_location_serial_for_product(product))
	if serial == "":
		return true
	var query_key := _arya_product_query_key(product)
	var query_value := _arya_product_query_value(product)
	if not _inventory_query_can_continue(generation, worker_state):
		return false

	# Cada aparelho continua com uma fila serial e uma geracao propria. A linha
	# so e redesenhada quando o pacote completo (localizacao, chip e registros)
	# termina, evitando que um resultado parcial pareca atual.
	inventory_query_scope_generation = generation
	location_status_busy[serial] = generation
	if query_value != "":
		arya_status_busy[query_key] = generation

	var source_mode := _grupo_rs_location_source_mode_for_product(product)
	var location_result := await _inventory_query_location_with_retries(product, generation, worker_state, source_mode)
	if not _inventory_query_can_continue(generation, worker_state):
		_finish_inventory_query_state(serial, query_key, generation)
		return false

	var previous_location: Dictionary = location_status_cache.get(serial, {}).duplicate(true)
	if bool(location_result.get("ok", false)):
		_cache_location_status(serial, location_result)
	else:
		_cache_location_failure(serial, location_result, previous_location)

	var arya_result: Dictionary = {}
	if query_value != "":
		arya_result = await _inventory_query_chip_with_retries(product, generation, worker_state)
		if not _inventory_query_can_continue(generation, worker_state):
			_finish_inventory_query_state(serial, query_key, generation)
			return false

	var records_result := await _inventory_query_records_with_retries(product, location_result, generation, worker_state)
	if not _inventory_query_can_continue(generation, worker_state):
		_finish_inventory_query_state(serial, query_key, generation)
		return false

	if query_value != "":
		arya_result["checked_at"] = Time.get_unix_time_from_system()
		arya_status_cache[query_key] = arya_result
	var completed_location: Dictionary = location_status_cache.get(serial, {}).duplicate(true)
	completed_location["records"] = records_result.get("event", {})
	completed_location["records_ok"] = bool(records_result.get("ok", false))
	completed_location["records_message"] = str(records_result.get("message", ""))
	location_status_cache[serial] = completed_location
	_finish_inventory_query_state(serial, query_key, generation)
	_request_inventory_table_refresh()
	return true


func _inventory_query_can_continue(generation: int, worker_state: Dictionary) -> bool:
	return is_inside_tree() and generation == inventory_device_cycle_generation and not bool(worker_state.get("cancelled", false))


func _inventory_retry_wait(generation: int, worker_state: Dictionary) -> bool:
	await get_tree().create_timer(INVENTORY_QUERY_RETRY_DELAY_SECONDS).timeout
	return _inventory_query_can_continue(generation, worker_state)


func _inventory_query_location_with_retries(product: Dictionary, generation: int, worker_state: Dictionary, source_mode: String) -> Dictionary:
	var serial := _digits_only(_location_serial_for_product(product))
	var last_result: Dictionary = {"ok": false, "message": "Localizacao nao consultada."}
	for attempt in range(INVENTORY_QUERY_MAX_ATTEMPTS):
		if not _inventory_query_can_continue(generation, worker_state):
			return {"ok": false, "cancelled": true}
		last_result = await _lookup_grupo_rs_location(serial, Callable(), source_mode)
		if bool(last_result.get("ok", false)) or attempt + 1 >= INVENTORY_QUERY_MAX_ATTEMPTS or not _location_failure_is_transient(last_result):
			return last_result
		if not await _inventory_retry_wait(generation, worker_state):
			return {"ok": false, "cancelled": true}
	return last_result


func _inventory_query_chip_with_retries(product: Dictionary, generation: int, worker_state: Dictionary) -> Dictionary:
	var last_result: Dictionary = {"ok": false, "status": "desconhecido", "message": "Chip nao informado."}
	# A consulta automatica de Link Solutions ja usa a rota filtrada rapida.
	# Repeti-la na mesma passagem so aumenta a fila e pode atrasar a localizacao
	# das linhas seguintes. A proxima rodada de um minuto cobre a recuperacao.
	var apn := str(product.get("apn", product.get("source", "")))
	var max_attempts := 1 if _apn_is_linksolutions(apn) else INVENTORY_QUERY_MAX_ATTEMPTS
	for attempt in range(max_attempts):
		if not _inventory_query_can_continue(generation, worker_state):
			return {"ok": false, "cancelled": true}
		last_result = await _lookup_arya_status_result_for_product(product, false, true)
		var status := str(last_result.get("status", "")).strip_edges().to_lower()
		if bool(last_result.get("ok", false)) or status in ["online", "offline", "on", "off"] or attempt + 1 >= max_attempts or not _location_failure_is_transient(last_result):
			return last_result
		if not await _inventory_retry_wait(generation, worker_state):
			return {"ok": false, "cancelled": true}
	return last_result


func _inventory_query_records_with_retries(product: Dictionary, location_result: Dictionary, generation: int, worker_state: Dictionary) -> Dictionary:
	var vehicle_id := str(location_result.get("vehicle_id", "")).strip_edges()
	if vehicle_id == "" and _grupo_rs_api_reads_enabled():
		var plate := str(location_result.get("plate", product.get("plate", ""))).strip_edges()
		# A consulta da linha atual nunca deve varrer a lista inteira de veiculos.
		# A API ja devolve o codVeiculo na localizacao quando ele esta disponivel;
		# se nao vier, fazemos apenas a busca direta por placa/serie.
		var found := await _grupo_rs_api_find_vehicle(plate, _digits_only(_location_serial_for_product(product)), true, false)
		if bool(found.get("ok", false)):
			vehicle_id = str(found.get("vehicle_id", "")).strip_edges()
	if vehicle_id == "":
		return {"ok": false, "message": "Registros nao consultados: veiculo sem identificador."}
	var reference_datetime := str(location_result.get("updated_at", ""))
	var last_result: Dictionary = {"ok": false, "message": "Registros nao consultados."}
	for attempt in range(INVENTORY_QUERY_MAX_ATTEMPTS):
		if not _inventory_query_can_continue(generation, worker_state):
			return {"ok": false, "cancelled": true}
		last_result = await _grupo_rs_api_latest_event(vehicle_id, reference_datetime)
		if bool(last_result.get("ok", false)) or attempt + 1 >= INVENTORY_QUERY_MAX_ATTEMPTS or not _location_failure_is_transient(last_result):
			return last_result
		if not await _inventory_retry_wait(generation, worker_state):
			return {"ok": false, "cancelled": true}
	return last_result


func _finish_inventory_query_state(serial: String, query_key: String, generation: int) -> void:
	if int(location_status_busy.get(serial, -9999)) == generation:
		location_status_busy.erase(serial)
	if query_key != "" and int(arya_status_busy.get(query_key, -9999)) == generation:
		arya_status_busy.erase(query_key)
	if inventory_query_scope_generation == generation:
		inventory_query_scope_generation = -1


func _mark_inventory_device_lookup_timeout(product: Dictionary) -> void:
	_cancel_inventory_query_requests()
	var serial := _digits_only(_location_serial_for_product(product))
	var query_key := _arya_product_query_key(product)
	var now := Time.get_unix_time_from_system()
	if serial != "":
		location_status_busy.erase(serial)
		location_status_cache[serial] = {
			"label": "Aguardando API",
			"color": ORANGE,
			"message": "Consulta interrompida por tempo limite; sera tentada novamente.",
			"temporary": true,
			"checked_at": now,
		}
	if query_key != "":
		arya_status_busy.erase(query_key)
		arya_status_cache[query_key] = {
			"status": "erro",
			"message": "Consulta interrompida por tempo limite; sera tentada novamente.",
			"checked_at": now - ARYA_STATUS_CACHE_SECONDS,
		}
	_request_inventory_table_refresh()


func _request_inventory_table_refresh() -> void:
	if table_body == null or not is_instance_valid(table_body) or inventory_table_refresh_pending:
		return
	inventory_table_refresh_pending = true
	call_deferred("_flush_inventory_table_refresh")


func _flush_inventory_table_refresh() -> void:
	inventory_table_refresh_pending = false
	_refresh_table()


func _schedule_visible_internal_battery_batch(products: Array[Dictionary]) -> void:
	# Compatibilidade para chamadas antigas: nenhuma consulta de bateria deve
	# entrar na fila automatica da lista ou da tela de consulta. Limpar tambem
	# qualquer estado antigo evita que uma versao anterior volte a aparecer.
	_pump_internal_battery_queue()
	return


func _schedule_online_tracker_records(products: Array[Dictionary]) -> void:
	var location_queued := false
	for raw_product in products:
		var product := _online_lookup_action_product(raw_product)
		var serial := _digits_only(_location_serial_for_product(product))
		if serial == "":
			continue
		if _location_status_cache_is_fresh(serial):
			continue
		if bool(location_status_busy.get(serial, false)):
			continue
		location_status_busy[serial] = -1
		location_status_cache[serial] = {
			"label": "Consultando",
			"color": Color("#0b6fae"),
			"checked_at": Time.get_unix_time_from_system(),
			"previous": location_status_cache.get(serial, {}).duplicate(true),
		}
		online_location_queue.append(serial)
		location_queued = true
	if location_queued:
		_pump_online_location_queue()


func _pump_online_location_queue() -> void:
	while online_location_running < LOCATION_VISIBLE_AUTO_CONCURRENCY and not online_location_queue.is_empty():
		var serial := str(online_location_queue.pop_front())
		online_location_running += 1
		_run_online_location_lookup(serial)


func _run_online_location_lookup(serial: String) -> void:
	var result := await _lookup_grupo_rs_location(serial)
	location_status_busy.erase(serial)
	if bool(result.get("ok", false)):
		_cache_location_status(serial, result)
	else:
		_cache_location_failure(serial, result)
	online_location_running = maxi(online_location_running - 1, 0)
	_refresh_online_lookup_from_cache()
	_pump_online_location_queue()


func _online_lookup_product_for_serial(serial: String) -> Dictionary:
	var clean_serial := _digits_only(serial)
	for raw_product in online_lookup_current_rows:
		var product := _online_lookup_action_product(raw_product)
		if _digits_only(_location_serial_for_product(product)) == clean_serial:
			return product
	return {}


func _refresh_online_lookup_from_cache() -> void:
	if online_lookup_current_rows.is_empty() or online_lookup_body == null or not is_instance_valid(online_lookup_body):
		return
	var rows := online_lookup_current_rows.duplicate(true)
	_render_online_lookup_rows(rows)


func _pump_internal_battery_queue() -> void:
	# Fila aposentada. O método permanece apenas para compatibilidade com
	# cenas/scripts antigos que ainda possam chamá-lo.
	internal_battery_queue.clear()
	internal_battery_busy.clear()
	internal_battery_cache.clear()
	internal_battery_running = 0


func _run_internal_battery_lookup(product: Dictionary) -> void:
	# Não iniciar novas consultas antigas de bateria.
	return


func _cache_internal_battery_result(serial: String, result: Dictionary, previous: Dictionary) -> void:
	if bool(result.get("ok", false)):
		internal_battery_cache[serial] = result
	elif int(previous.get("percent", -1)) >= 0:
		previous["status"] = "stale"
		previous["checked_at"] = int(Time.get_unix_time_from_system())
		previous["message"] = str(result.get("message", "Sem novo registro de bateria."))
		internal_battery_cache[serial] = previous
	else:
		internal_battery_cache[serial] = {
			"ok": false,
			"status": "error",
			"percent": -1,
			"checked_at": int(Time.get_unix_time_from_system()),
			"message": str(result.get("message", "Bateria interna indisponivel.")),
		}


func _internal_battery_cache_is_fresh(serial: String) -> bool:
	var cached: Dictionary = internal_battery_cache.get(serial, {})
	if cached.is_empty():
		return false
	var checked_at := int(cached.get("checked_at", 0))
	return checked_at > 0 and int(Time.get_unix_time_from_system()) - checked_at < INTERNAL_BATTERY_CACHE_SECONDS


func _lookup_grupo_rs_internal_battery(product: Dictionary, previous: Dictionary = {}) -> Dictionary:
	var serial := _digits_only(_location_serial_for_product(product))
	if serial == "":
		return {"ok": false, "message": "Numero de serie nao informado."}

	var location: Dictionary = location_status_cache.get(serial, {}).duplicate(true)
	if str(location.get("client_id", "")).strip_edges() == "" or str(location.get("plate", "")).strip_edges() == "":
		location = await _lookup_grupo_rs_location(serial)
		if not bool(location.get("ok", false)):
			return {"ok": false, "message": str(location.get("message", "Localizacao indisponivel."))}
		_cache_location_status(serial, location)
	return await _lookup_grupo_rs_internal_battery_from_location(location, previous)


func _lookup_grupo_rs_internal_battery_from_location(location: Dictionary, previous: Dictionary = {}) -> Dictionary:
	if not _grupo_rs_supports_modern_api():
		return _legacy_internal_battery_from_location(location, previous)
	var force_platform_battery := str(location.get("source", "")).strip_edges() == "grupo_rs_api"
	# A API oficial ainda nao entrega percentual de bateria interna. Para esse
	# campo, o Grupo RS continua sendo a fonte oficial, mesmo quando a
	# localizacao veio exclusivamente pela API.
	var client_id := str(location.get("client_id", "")).strip_edges()
	var plate := str(location.get("plate", "")).strip_edges()
	var vehicle_id := str(previous.get("vehicle_id", "")).strip_edges()
	if force_platform_battery:
		var serial := str(location.get("serial", "")).strip_edges()
		if serial != "":
			var online_rows := await _fetch_grupo_rs_equipment_rows(serial)
			if not online_rows.is_empty():
				var equipment := online_rows[0] as Dictionary
				if plate == "":
					plate = str(equipment.get("plate", "")).strip_edges()
				var client_name := str(equipment.get("client", "")).strip_edges()
				if client_id == "" and client_name != "":
					client_id = await _fetch_grupo_rs_client_id(client_name)
		if client_id == "":
			var fallback_client := str(location.get("client", "")).strip_edges()
			if fallback_client != "":
				client_id = await _fetch_grupo_rs_client_id(fallback_client)
	if not _grupo_rs_platform_reads_enabled() and not force_platform_battery:
		return {
			"ok": false,
			"status": "unavailable",
			"percent": -1,
			"checked_at": int(Time.get_unix_time_from_system()),
			"message": "A API atual fornece placa e localizacao; bateria interna aguarda endpoint proprio.",
			"source": "Grupo RS API",
		}
	if client_id == "":
		return {
			"ok": false,
			"status": "unavailable",
			"percent": -1,
			"checked_at": int(Time.get_unix_time_from_system()),
			"message": "Grupo RS nao retornou o cliente necessario para consultar a bateria interna.",
			"source": "Grupo RS",
		}
	if vehicle_id == "":
		vehicle_id = await _fetch_grupo_rs_records_vehicle_id(client_id, plate)
	if vehicle_id == "":
		vehicle_id = str(location.get("vehicle_id", "")).strip_edges()
	if vehicle_id == "":
		return {"ok": false, "message": "Veiculo nao localizado na tela de registros."}

	var lookback := INTERNAL_BATTERY_REFRESH_LOOKBACK_SECONDS if int(previous.get("percent", -1)) >= 0 else INTERNAL_BATTERY_INITIAL_LOOKBACK_SECONDS
	var reference_datetime := "" if int(previous.get("percent", -1)) >= 0 else str(location.get("updated_at", ""))
	var result := await _fetch_grupo_rs_internal_battery_events(client_id, vehicle_id, lookback, reference_datetime)
	if not bool(result.get("ok", false)):
		return result
	result["client_id"] = client_id
	result["vehicle_id"] = vehicle_id
	result["plate"] = plate
	return result


func _legacy_internal_battery_from_location(location: Dictionary, previous: Dictionary = {}) -> Dictionary:
	var raw_backup := str(location.get("backup_battery", "")).strip_edges()
	var raw_main := str(location.get("battery", "")).strip_edges()
	var raw_value := raw_backup if raw_backup != "" and raw_backup != "-" else raw_main
	var percent := _parse_internal_battery_percent(raw_value)
	if percent >= 0:
		return {
			"ok": true,
			"status": "ok",
			"percent": percent,
			"source_at": str(location.get("updated_at", "")),
			"checked_at": int(Time.get_unix_time_from_system()),
			"message": "Atualizado pela localizacao da base regional.",
			"source": "Grupo RS legado",
		}
	if int(previous.get("percent", -1)) >= 0:
		var stale := previous.duplicate(true)
		stale["status"] = "stale"
		stale["checked_at"] = int(Time.get_unix_time_from_system())
		stale["message"] = "A base regional nao retornou bateria nova; ultimo valor preservado."
		return stale
	return {
		"ok": false,
		"status": "error",
		"percent": -1,
		"checked_at": int(Time.get_unix_time_from_system()),
		"message": "A base regional nao retornou a bateria interna.",
		"source": "Grupo RS legado",
	}


func _fetch_grupo_rs_records_vehicle_id(client_id: String, plate: String) -> String:
	var clean_plate := plate.strip_edges()
	var path := "/registros.php?acao=placas_registros_ajax&cliente=%s&q=%s&term=%s&search=%s" % [
		client_id.uri_encode(),
		clean_plate.uri_encode(),
		clean_plate.uri_encode(),
		clean_plate.uri_encode(),
	]
	var response := await _modern_grupo_rs_read_get(path)
	if not bool(response.get("ok", false)):
		return ""
	var parsed: Variant = JSON.parse_string(str(response.get("body", "")))
	var items: Array = []
	if typeof(parsed) == TYPE_DICTIONARY:
		items = (parsed as Dictionary).get("items", (parsed as Dictionary).get("results", []))
	elif typeof(parsed) == TYPE_ARRAY:
		items = parsed as Array
	var plate_key := _search_key(clean_plate)
	var first_id := ""
	for entry in items:
		if typeof(entry) != TYPE_DICTIONARY:
			continue
		var item := entry as Dictionary
		var candidate_id := _grupo_rs_vehicle_id_from_value(item)
		var candidate_plate := str(item.get("placa", item.get("Placa", item.get("text", item.get("nome", ""))))).strip_edges()
		if first_id == "" and candidate_id != "":
			first_id = candidate_id
		if candidate_id != "" and plate_key != "" and _search_key(candidate_plate) == plate_key:
			return candidate_id
	return first_id


func _grupo_rs_vehicle_id_from_value(value: Dictionary) -> String:
	for key in ["id", "CodVeiculo", "codVeiculo", "codveiculo", "value", "codigo"]:
		var candidate := _clean_json_id(value.get(key, ""))
		if candidate != "":
			return candidate
	return ""


func _fetch_grupo_rs_internal_battery_events(client_id: String, vehicle_id: String, lookback_seconds: int, reference_datetime: String = "") -> Dictionary:
	var end_unix := _local_now_to_unix_like()
	var start_text := _format_grupo_rs_records_datetime(end_unix - maxi(lookback_seconds, 60))
	var end_text := _format_grupo_rs_records_datetime(end_unix)
	var reference_unix := _grupo_rs_datetime_to_unix(reference_datetime)
	if reference_unix > 0:
		var reference := Time.get_datetime_dict_from_unix_time(reference_unix)
		start_text = "%02d/%02d/%04d 00:00" % [
			int(reference.get("day", 1)),
			int(reference.get("month", 1)),
			int(reference.get("year", 1970)),
		]
		end_text = "%02d/%02d/%04d 23:59" % [
			int(reference.get("day", 1)),
			int(reference.get("month", 1)),
			int(reference.get("year", 1970)),
		]
	var path := "/get_eventos.php?cliente=%s&veiculo=%s&inicio=%s&fim=%s" % [
		client_id.uri_encode(),
		vehicle_id.uri_encode(),
		start_text.uri_encode(),
		end_text.uri_encode(),
	]
	var response := await _modern_grupo_rs_read_get(path)
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": str(response.get("message", "Falha ao consultar registros."))}
	return _parse_grupo_rs_internal_battery_response(str(response.get("body", "")))


func _parse_grupo_rs_internal_battery_response(body: String) -> Dictionary:
	var parsed: Variant = JSON.parse_string(body)
	if typeof(parsed) != TYPE_DICTIONARY:
		return {"ok": false, "message": "Resposta de registros invalida."}
	var events: Variant = (parsed as Dictionary).get("eventos", [])
	if typeof(events) != TYPE_ARRAY or (events as Array).is_empty():
		return {"ok": false, "message": "Nenhum registro recente de bateria."}
	var newest: Dictionary = {}
	var newest_unix := -1
	for raw_event in events as Array:
		if typeof(raw_event) != TYPE_DICTIONARY:
			continue
		var event := raw_event as Dictionary
		var raw_percent: Variant = event.get("bateria_bkp", event.get("bkp", event.get("bateria_backup", null)))
		var percent := _parse_internal_battery_percent(raw_percent)
		if percent < 0:
			continue
		var source_at := str(event.get("data", event.get("data_servidor", event.get("DataServidor", "")))).strip_edges()
		var source_unix := _grupo_rs_datetime_to_unix(source_at)
		if not newest.is_empty() and (source_unix <= 0 or source_unix <= newest_unix):
			continue
		newest = {
			"ok": true,
			"status": "ok",
			"percent": percent,
			"source_at": source_at,
			"checked_at": int(Time.get_unix_time_from_system()),
			"message": "Atualizado pelos registros do Grupo RS.",
		}
		newest_unix = source_unix
	if not newest.is_empty():
		return newest
	return {"ok": false, "message": "Os registros nao retornaram Bat. Int."}


func _parse_internal_battery_percent(value: Variant) -> int:
	if value == null:
		return -1
	if typeof(value) == TYPE_INT or typeof(value) == TYPE_FLOAT:
		return clampi(int(round(float(value))), 0, 100)
	var clean := str(value).replace("%", "").replace(",", ".").strip_edges()
	if not clean.is_valid_float():
		return -1
	return clampi(int(round(clean.to_float())), 0, 100)


func _format_grupo_rs_records_datetime(unix_seconds: int) -> String:
	var datetime := Time.get_datetime_dict_from_unix_time(unix_seconds)
	return "%02d/%02d/%04d %02d:%02d" % [
		int(datetime.get("day", 1)),
		int(datetime.get("month", 1)),
		int(datetime.get("year", 1970)),
		int(datetime.get("hour", 0)),
		int(datetime.get("minute", 0)),
	]


func _format_grupo_rs_api_records_datetime(unix_seconds: int) -> String:
	var datetime := Time.get_datetime_dict_from_unix_time(unix_seconds)
	return "%04d-%02d-%02d %02d:%02d:%02d" % [
		int(datetime.get("year", 1970)),
		int(datetime.get("month", 1)),
		int(datetime.get("day", 1)),
		int(datetime.get("hour", 0)),
		int(datetime.get("minute", 0)),
		int(datetime.get("second", 0)),
	]


func _location_serial_for_product(product: Dictionary) -> String:
	var serial := str(product.get("imei", product.get("sku", ""))).strip_edges()
	if serial == "":
		serial = str(product.get("equipment_number", "")).strip_edges()
	if serial == "":
		serial = str(product.get("serial", "")).strip_edges()
	return serial


func _local_product_for_serial(serial: String) -> Dictionary:
	if store == null:
		return {}
	var clean_serial := _digits_only(serial)
	if clean_serial == "":
		return {}
	var direct := store.get_product(serial)
	if not direct.is_empty() and _digits_only(_location_serial_for_product(direct)) == clean_serial:
		return direct
	for raw_product in store.get_products("", "all", false):
		var product := raw_product as Dictionary
		if _digits_only(_location_serial_for_product(product)) == clean_serial:
			return product
	return {}


func _grupo_rs_api_location_result(serial: String, fallback_plate: String, fallback_client: String, location: Dictionary) -> Dictionary:
	var api_lat := str(location.get("lat", "0")).replace(",", ".").to_float()
	var api_lng := str(location.get("lng", "0")).replace(",", ".").to_float()
	if not is_finite(api_lat) or not is_finite(api_lng) or (api_lat == 0.0 and api_lng == 0.0):
		return {"ok": false, "message": "A API retornou localizacao sem coordenadas validas."}
	return {
		"ok": true,
		"source": "grupo_rs_api",
		"serial": serial,
		"equipment_serial": str(location.get("serial", serial)),
		"client": str(location.get("client", fallback_client)).strip_edges() if str(location.get("client", "")).strip_edges() != "" else fallback_client,
		"client_id": str(location.get("client_id", "")),
		"vehicle_id": str(location.get("vehicle_id", "")),
		"plate": str(location.get("plate", fallback_plate)).strip_edges() if str(location.get("plate", "")).strip_edges() != "" else fallback_plate,
		"lat": api_lat,
		"lng": api_lng,
		"address": str(location.get("address", "")),
		"updated_at": str(location.get("updated_at", "")),
		"ignition": location.get("ignition", ""),
		"monitoring_status": str(location.get("monitoring_status", "")),
		"speed": str(location.get("speed", "0")),
		"battery": str(location.get("battery", "")),
		"gps_signal": str(location.get("gps_signal", "")),
		"odometer": str(location.get("odometer", "")),
		"heading": str(location.get("heading", "")),
		"event_type": str(location.get("event_type", "")),
	}


func _lookup_grupo_rs_location(
	serial: String,
	progress_callback: Callable = Callable(),
	source_mode: String = "",
	fallback_plate: String = "",
	fallback_client: String = ""
) -> Dictionary:
	_location_progress(progress_callback, 0, "Buscando equipamento", "Serie %s" % serial)
	if not _grupo_rs_supports_modern_api():
		return await _lookup_legacy_grupo_rs_location(serial)

	var local_product := _local_product_for_serial(serial)
	var local_plate := str(local_product.get("plate", "")).strip_edges()
	var local_client := str(local_product.get("client", "")).strip_edges()
	# A busca online do Grupo RS ja entrega a associacao serie/placa/cliente.
	# Preserve esses dados no clique da linha: a API de equipamentos pode
	# retornar somente o cadastro do rastreador, sem a associacao do veiculo.
	if local_plate == "":
		local_plate = fallback_plate.strip_edges()
	if local_client == "":
		local_client = fallback_client.strip_edges()
	var api_message := ""
	var resolved_source_mode := source_mode.strip_edges().to_lower()
	if resolved_source_mode == "":
		resolved_source_mode = _grupo_rs_location_source_mode_for_product(local_product)
	var use_api := _grupo_rs_api_reads_enabled()
	var use_platform := _grupo_rs_platform_reads_enabled()
	if resolved_source_mode == "api":
		use_api = true
		# API primaria; portal web permanece como fallback quando a API nao
		# localizar, estiver sem coordenadas ou estiver indisponivel.
		use_platform = _grupo_rs_platform_reads_enabled()
	elif resolved_source_mode == "platform":
		use_api = _grupo_rs_api_reads_enabled()
		use_platform = true

	if use_api:
		_location_progress(progress_callback, 1, "Consultando API oficial", "Placa %s" % _blank(local_plate))
		var api_lookup := await _grupo_rs_api_find_location(serial, local_plate)
		if bool(api_lookup.get("ok", false)):
			var api_location: Dictionary = api_lookup.get("location", {})
			var api_result := _grupo_rs_api_location_result(
				serial,
				local_plate,
				local_client,
				api_location
			)
			if bool(api_result.get("ok", false)):
				return api_result
			api_message = str(api_result.get("message", "API sem coordenadas validas."))
		else:
			api_message = str(api_lookup.get("message", "API nao localizou a placa vinculada."))

	if not use_platform:
		return {
			"ok": false,
			"message": "Leitura pela plataforma esta desligada e a API nao retornou localizacao. %s" % api_message.strip_edges(),
		}

	_location_progress(progress_callback, 1, "Buscando equipamento na plataforma", "Serie %s" % serial)
	var online_rows := await _fetch_grupo_rs_equipment_rows(serial)
	if online_rows.is_empty():
		return {"ok": false, "message": "Equipamento nao encontrado no Grupo RS online."}

	var equipment := online_rows[0] as Dictionary
	var client_name := str(equipment.get("client", "")).strip_edges()
	var plate := str(equipment.get("plate", "")).strip_edges()
	if client_name == "":
		client_name = local_client
	if plate == "":
		plate = local_plate
	# Se a API de equipamentos trouxe apenas o rastreador, tente resolver a
	# associacao pela placa antes de usar o portal. Isso evita uma busca de
	# cliente vazia e tambem impede que um cliente aleatorio seja escolhido.
	var vehicle_id := ""
	if (client_name == "" or plate == "") and (plate != "" or serial.strip_edges() != ""):
		var vehicle_identity := await _grupo_rs_api_find_vehicle(plate, serial, true, true)
		if bool(vehicle_identity.get("ok", false)):
			var identity_row: Dictionary = vehicle_identity.get("row", {})
			if client_name == "":
				client_name = str(identity_row.get("client", "")).strip_edges()
			if plate == "":
				plate = str(identity_row.get("plate", "")).strip_edges()
			vehicle_id = str(identity_row.get("vehicle_id", "")).strip_edges()
	if client_name == "":
		return {"ok": false, "message": "O Grupo RS nao retornou cliente para este equipamento."}

	if use_api and _normalize_location_plate(plate) != _normalize_location_plate(local_plate):
		_location_progress(progress_callback, 2, "Consultando API oficial", "Placa %s" % _blank(plate))
		var platform_plate_api := await _grupo_rs_api_find_location(serial, plate, vehicle_id)
		if bool(platform_plate_api.get("ok", false)):
			var platform_api_location: Dictionary = platform_plate_api.get("location", {})
			var platform_api_result := _grupo_rs_api_location_result(
				serial,
				plate,
				client_name,
				platform_api_location
			)
			if bool(platform_api_result.get("ok", false)):
				return platform_api_result

	_location_progress(progress_callback, 1, "Localizando cliente", "%s | %s" % [_blank(client_name), _blank(plate)])
	var client_id := await _fetch_grupo_rs_client_id(client_name)
	if client_id == "":
		return {"ok": false, "message": "Cliente encontrado, mas nao foi possivel localizar o ID no mapa do Grupo RS."}

	_location_progress(progress_callback, 2, "Carregando posicao no mapa", "Placa %s" % _blank(plate))
	var vehicle := await _fetch_grupo_rs_vehicle_location(client_id, plate, serial)
	if vehicle.is_empty():
		return {"ok": false, "message": "Cliente encontrado, mas o mapa nao retornou localizacao para a placa %s." % _blank(plate)}

	var lat := float(str(vehicle.get("lat", vehicle.get("Latitude", "0"))).replace(",", "."))
	var lng := float(str(vehicle.get("lng", vehicle.get("Longitude", "0"))).replace(",", "."))
	if not is_finite(lat) or not is_finite(lng) or (lat == 0.0 and lng == 0.0):
		return {"ok": false, "message": "Localizacao retornada sem latitude/longitude valida."}

	_location_progress(progress_callback, 3, "Calculando estado do aparelho", str(vehicle.get("UltimaComunicacao", vehicle.get("DataEvento", ""))))
	var ignition_value = vehicle.get("ignicao", vehicle.get("Ignicao", vehicle.get("ignition", vehicle.get("Ignition", ""))))
	var monitoring_value = vehicle.get("status_monitoramento", vehicle.get("StatusMonitoramento", vehicle.get("monitoring_status", "")))
	return {
		"ok": true,
		"source": "grupo_rs_platform",
		"serial": serial,
		"equipment_serial": str(vehicle.get("equipamento", vehicle.get("Equipamento", serial))),
		"client": client_name,
		"client_id": client_id,
		"vehicle_id": _grupo_rs_vehicle_id_from_value(vehicle),
		"plate": str(vehicle.get("placa", plate)),
		"lat": lat,
		"lng": lng,
		"address": str(vehicle.get("endereco", vehicle.get("Endereco", ""))),
		"updated_at": str(vehicle.get("UltimaComunicacao", vehicle.get("DataEvento", ""))),
		"ignition": ignition_value,
		"monitoring_status": str(monitoring_value),
		"speed": str(vehicle.get("velocidade", vehicle.get("Velocidade", "0"))),
	}


func _fetch_grupo_rs_equipment_rows(serial: String) -> Array[Dictionary]:
	if not _grupo_rs_supports_modern_api():
		return await _fetch_legacy_grupo_rs_equipment_rows(serial)
	# A API oficial e a fonte primaria do estoque. O portal novo fica como
	# fallback somente quando a API nao responder ou devolver um formato invalido.
	var api_query := serial.strip_edges()
	var inventory_rows: Array[Dictionary] = []
	if api_query != "" and _grupo_rs_api_reads_enabled():
		var api_response := await _grupo_rs_api_get(
			"/endpoints/equipamentos.php?q=%s&skip=0&take=50" % api_query.uri_encode()
		)
		if bool(api_response.get("ok", false)):
			var payload: Variant = JSON.parse_string(str(api_response.get("body", "")))
			var api_rows := _grupo_rs_api_equipment_rows(payload)
			for raw in api_rows:
				var normalized := _grupo_rs_api_inventory_equipment_row(raw)
				if not normalized.is_empty():
					inventory_rows.append(normalized)
			if not inventory_rows.is_empty():
				# A consulta de equipamentos pode trazer somente os campos do
				# rastreador. Complete a linha pela associacao em veiculos.php para
				# que a edicao de placa nao fique desabilitada no formulario.
				for index in range(inventory_rows.size()):
					var enriched := await _grupo_rs_api_enrich_equipment_row_with_vehicle(inventory_rows[index], api_query)
					inventory_rows[index] = enriched
				return inventory_rows
		# A rota de equipamentos indexa bem a serie, mas algumas implantacoes
		# indexam placa e cliente somente em veiculos.php. Ainda e API-first:
		# fazemos a segunda consulta oficial antes de cair no portal web.
		var vehicle_response := await _grupo_rs_api_get(
			"/endpoints/veiculos.php?q=%s&skip=0&take=50" % api_query.uri_encode()
		)
		if bool(vehicle_response.get("ok", false)):
			for raw_vehicle in _grupo_rs_api_extract_rows(JSON.parse_string(str(vehicle_response.get("body", "")))):
				var vehicle_row := _grupo_rs_api_inventory_equipment_row_from_vehicle(raw_vehicle)
				if not vehicle_row.is_empty():
					inventory_rows.append(vehicle_row)
			if not inventory_rows.is_empty():
				return inventory_rows
	var url := _modern_grupo_rs_url("equipamentos_listar.php?busca=%s&status=todos" % serial.uri_encode())
	if url == "":
		return []
	var response := await _modern_grupo_rs_read_get("equipamentos_listar.php?busca=%s&status=todos" % serial.uri_encode())
	if not bool(response.get("ok", false)):
		return []
	return _parse_grupo_rs_equipment_rows(str(response.get("body", "")))


func _grupo_rs_api_enrich_equipment_row_with_vehicle(row: Dictionary, serial: String) -> Dictionary:
	var result := row.duplicate(true)
	if str(result.get("plate", "")).strip_edges() != "" and str(result.get("client", "")).strip_edges() != "":
		return result
	# A tela de cadastro precisa responder rapidamente. A consulta direta por
	# serie e suficiente para enriquecer o equipamento quando existe vinculo;
	# nao faça aqui uma varredura paginada de todos os veiculos, pois uma serie
	# inexistente ou ainda nao indexada podia bloquear o formulario por dezenas
	# de segundos. A varredura completa continua disponivel nos fluxos de
	# modificacao/localizacao que a solicitam explicitamente.
	var vehicle_result := await _grupo_rs_api_find_vehicle("", serial, true, false)
	if not bool(vehicle_result.get("ok", false)):
		return result
	var vehicle: Dictionary = vehicle_result.get("row", {})
	if str(result.get("plate", "")).strip_edges() == "":
		result["plate"] = str(vehicle.get("plate", "")).strip_edges()
	if str(result.get("client", "")).strip_edges() == "":
		result["client"] = str(vehicle.get("client", "")).strip_edges()
	if str(result.get("vehicle_id", "")).strip_edges() == "":
		result["vehicle_id"] = str(vehicle.get("vehicle_id", "")).strip_edges()
	if str(result.get("client", "")).strip_edges() == "":
		# Algumas implantacoes da API retornam a associacao serie/placa sem o
		# titular. Consulte somente a linha correspondente no portal web para
		# completar o formulario, sem usar a primeira linha da lista.
		var portal_response := await _modern_grupo_rs_read_get("equipamentos_listar.php?busca=%s&status=todos" % serial.uri_encode())
		if bool(portal_response.get("ok", false)):
			var portal_rows := _parse_grupo_rs_equipment_rows(str(portal_response.get("body", "")))
			for portal_row in portal_rows:
				if _search_key(str(portal_row.get("serial", ""))) != _search_key(serial):
					continue
				if str(result.get("plate", "")).strip_edges() == "":
					result["plate"] = str(portal_row.get("plate", "")).strip_edges()
				result["client"] = str(portal_row.get("client", "")).strip_edges()
				break
	return result


func _grupo_rs_api_inventory_equipment_row(raw: Dictionary) -> Dictionary:
	var data := raw.duplicate(true)
	var serial_value := _grupo_rs_api_serial_from_row(data)
	var equipment_id := _grupo_rs_api_equipment_id_from_row(data, true)
	if serial_value == "" and equipment_id <= 0:
		return {}
	var plate_value := _grupo_rs_api_string_value(data, ["placa", "plate", "Placa"])
	var client_value := _grupo_rs_api_string_value(data, ["cliente", "client", "Cliente", "nomeCliente", "nome_cliente"])
	var chip_value := _grupo_rs_api_string_value(data, ["numeroChip", "numero_chip", "chip", "iccid"])
	var phone_value := _grupo_rs_api_string_value(data, ["numeroTelefone", "numero_telefone", "telefone", "phone"])
	var status_value := _grupo_rs_api_string_value(data, ["status", "situacao", "situacaoCadastro", "ativo"])
	return {
		"serial": serial_value,
		"plate": plate_value,
		"client": client_value,
		"chip": chip_value,
		"phone": phone_value,
		"apn": _grupo_rs_api_string_value(data, ["apn", "APN"]),
		"model": _grupo_rs_api_model_label(data.get("codModelo", data.get("CodModelo", 0))),
		"operator": _grupo_rs_api_operator_label(data.get("codOperadora", data.get("CodOperadora", 0))),
		"codModelo": _grupo_rs_api_integer_value(data.get("codModelo", data.get("CodModelo", 0))),
		"codOperadora": _grupo_rs_api_integer_value(data.get("codOperadora", data.get("CodOperadora", 0))),
		"status": status_value,
		"edit_id": str(equipment_id) if equipment_id > 0 else "",
		"api_id": equipment_id,
		"source": "grupo_rs_api",
		"raw": data,
	}


func _grupo_rs_api_model_label(value: Variant) -> String:
	var model_id := _grupo_rs_api_integer_value(value)
	return GRUPO_RS_REMOTE_MODEL_LABEL if model_id == GRUPO_RS_REMOTE_MODEL_ID else ""


func _grupo_rs_api_operator_label(value: Variant) -> String:
	var operator_id := _grupo_rs_api_integer_value(value)
	if grupo_rs_api_operator_labels.has(operator_id):
		return str(grupo_rs_api_operator_labels.get(operator_id, ""))
	match operator_id:
		3:
			return "Claro"
		1:
			return "Vivo"
		4:
			return "Tim"
		6:
			return "Multi Operadora"
		2:
			return "Oi"
		5:
			return "NLT"
	return ""


func _grupo_rs_api_integer_value(value: Variant) -> int:
	if typeof(value) in [TYPE_INT, TYPE_FLOAT]:
		return int(value)
	var text := str(value).strip_edges()
	if text.is_valid_int():
		return int(text)
	if text.is_valid_float():
		return int(float(text))
	return 0


func _grupo_rs_api_inventory_equipment_row_from_vehicle(raw: Dictionary) -> Dictionary:
	var normalized := _grupo_rs_api_normalize_location(raw)
	var serial_value := str(normalized.get("serial", "")).strip_edges()
	var equipment_id := str(normalized.get("equipment_id", "")).strip_edges()
	if serial_value == "" and equipment_id == "":
		return {}
	return {
		"serial": serial_value,
		"plate": str(normalized.get("plate", "")),
		"client": str(normalized.get("client", "")),
		"chip": str(normalized.get("chip", "")),
		"phone": str(normalized.get("phone", "")),
		"status": str(normalized.get("status", "")),
		"edit_id": equipment_id,
		"api_id": int(equipment_id) if equipment_id.is_valid_int() else 0,
		"source": "grupo_rs_api",
		"raw": raw.duplicate(true),
	}


func _select_grupo_rs_equipment_row_by_plate(rows: Array[Dictionary], plate: String) -> Dictionary:
	var target_plate := _normalize_location_plate(plate)
	if target_plate == "":
		return {}

	var selected: Dictionary = {}
	var selected_client_key := ""
	for row in rows:
		if _normalize_location_plate(str(row.get("plate", ""))) != target_plate:
			continue
		var client_name := str(row.get("client", "")).strip_edges()
		var client_key := _sga_client_key(client_name)
		if client_key == "":
			continue
		if selected.is_empty():
			selected = row
			selected_client_key = client_key
		elif client_key != selected_client_key:
			return {}
	return selected


func _fetch_grupo_rs_client_by_plate(plate: String) -> Dictionary:
	var clean_plate := _normalize_location_plate(plate)
	if clean_plate == "":
		return {"ok": false, "state": "no_plate", "message": "Placa nao informada para localizar o associado."}
	if not _grupo_rs_supports_modern_api():
		return {"ok": false, "state": "cpf_unavailable", "message": "A consulta do associado pela placa esta disponivel somente no Sistema RS de Imperatriz."}

	var queries: Array[String] = [plate.strip_edges()]
	if queries[0] != clean_plate:
		queries.append(clean_plate)
	var rows: Array[Dictionary] = []
	for query in queries:
		var list_path := "equipamentos_listar.php?busca=%s&status=todos" % query.uri_encode()
		var list_response := await _modern_grupo_rs_read_get(list_path)
		if not bool(list_response.get("ok", false)):
			return {"ok": false, "state": "rs_error", "message": "Nao foi possivel consultar a placa no Sistema RS."}
		rows = _parse_grupo_rs_equipment_rows(str(list_response.get("body", "")))
		if not rows.is_empty():
			break
	var selected := _select_grupo_rs_equipment_row_by_plate(rows, clean_plate)
	if selected.is_empty():
		return {"ok": false, "state": "client_not_found", "message": "Associado nao localizado pela placa no Sistema RS."}

	return {
		"ok": true,
		"state": "ok",
		"client": str(selected.get("client", "")).strip_edges(),
		"plate": str(selected.get("plate", plate)).strip_edges(),
		"serial": str(selected.get("serial", "")).strip_edges(),
	}


func _fetch_grupo_rs_equipment_apn(equipment: Dictionary) -> String:
	var details := await _fetch_grupo_rs_equipment_details(equipment)
	return str(details.get("apn", ""))


func _fetch_grupo_rs_equipment_details(equipment: Dictionary) -> Dictionary:
	if not _grupo_rs_supports_modern_api():
		return await _fetch_legacy_grupo_rs_equipment_details(equipment)
	# A API oficial ja devolve ICCID, telefone, APN, modelo e operadora.
	# Nao substitua esses dados por uma tela web antiga: em algumas bases o
	# portal mantem uma copia legada e isso fazia a edicao voltar para valores
	# antigos antes do PATCH API-first.
	if str(equipment.get("source", "")) == "grupo_rs_api" or equipment.has("api_id"):
		return {
			"apn": str(equipment.get("apn", "")).strip_edges().to_lower(),
			"chip": str(equipment.get("chip", "")).strip_edges(),
			"phone": str(equipment.get("phone", "")).strip_edges(),
			"operator": str(equipment.get("operator", "")).strip_edges(),
			"grupo_model": str(equipment.get("model", "")).strip_edges(),
		}

	var href := str(equipment.get("edit_href", "")).strip_edges()
	var edit_id := str(equipment.get("edit_id", "")).strip_edges()
	var url := ""
	if href != "":
		url = href
		if not url.begins_with("http"):
			if url.begins_with("/"):
				url = selected_branch_grupo_rs_base_url + url.substr(1)
			else:
				url = selected_branch_grupo_rs_base_url + url
	elif edit_id != "":
		url = _grupo_rs_edit_url(edit_id)
	if url == "":
		return {}

	var response := await _modern_grupo_rs_read_get(url)
	if not bool(response.get("ok", false)):
		return {}
	var html := str(response.get("body", ""))
	return {
		"apn": _extract_grupo_rs_apn(html),
		# A listagem do portal ja traz ICCID e telefone; preserva-los aqui
		# para que a busca do formulario preencha tudo mesmo quando a tela de
		# edicao nao expuser esses dois campos.
		"chip": str(equipment.get("chip", "")).strip_edges(),
		"phone": str(equipment.get("phone", "")).strip_edges(),
		"operator": _normalize_bulk_operator(_extract_selected_option_text(html, "CodOperadora")),
		"grupo_model": _extract_selected_option_text(html, "CodModelo"),
	}


func _lookup_legacy_grupo_rs_location(serial: String) -> Dictionary:
	var response := await _legacy_grupo_rs_postback("/Geral/LocalizacaoView", {
		"__EVENTTARGET": "btnFiltrar",
		"__EVENTARGUMENT": "",
		"txtFiltro": serial,
		"cbAtualizacaoAutomatica": "on",
		"txtMinutos": "10",
	})
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": "Base antiga: %s" % str(response.get("message", "consulta indisponivel."))}

	var rows := _parse_legacy_grupo_rs_location_rows(str(response.get("body", "")))
	if rows.is_empty():
		return {"ok": false, "message": "A base antiga nao retornou localizacao para a serie %s." % serial}
	var serial_key := _search_key(serial)
	var chosen: Dictionary = {}
	for row in rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var candidate := row as Dictionary
		if _search_key(str(candidate.get("equipment_serial", ""))) == serial_key:
			chosen = candidate
			break
	if chosen.is_empty():
		chosen = rows[0] as Dictionary

	var lat := float(str(chosen.get("lat", "0")).replace(",", "."))
	var lng := float(str(chosen.get("lng", "0")).replace(",", "."))
	if not is_finite(lat) or not is_finite(lng) or (lat == 0.0 and lng == 0.0):
		return {"ok": false, "message": "Localizacao antiga retornou latitude/longitude invalida."}

	return {
		"ok": true,
		"serial": serial,
		"equipment_serial": str(chosen.get("equipment_serial", serial)),
		"client": str(chosen.get("client", "RS300")),
		"client_id": "",
		"plate": str(chosen.get("plate", "")),
		"lat": lat,
		"lng": lng,
		"address": str(chosen.get("address", "")),
		"updated_at": str(chosen.get("updated_at", "")),
		"ignition": str(chosen.get("ignition", "")),
		"monitoring_status": str(chosen.get("monitoring_status", "")),
		"battery": str(chosen.get("battery", "")),
		"backup_battery": str(chosen.get("backup_battery", "")),
		"speed": str(chosen.get("speed", "0")),
	}


func _fetch_legacy_grupo_rs_equipment_rows(serial: String) -> Array[Dictionary]:
	var response := await _legacy_grupo_rs_postback("/Cadastros/EquipamentosListar", {
		"__EVENTTARGET": "btnPsq",
		"__EVENTARGUMENT": "",
		"ddlStatus": "A",
		"txtPsq": serial,
	})
	if not bool(response.get("ok", false)):
		return []

	var rows := _parse_legacy_grupo_rs_equipment_rows(str(response.get("body", "")))
	if rows.is_empty():
		return rows

	for i in range(rows.size()):
		var row := rows[i]
		if not _legacy_serial_matches_query(serial, row):
			continue
		var details := await _fetch_legacy_grupo_rs_equipment_details(row)
		# Algumas bases antigas entregam a tela de detalhes incompleta na primeira resposta.
		# Confirma somente quando os campos essenciais vierem vazios e preserva a melhor leitura.
		for _attempt in range(4):
			if not _legacy_equipment_details_incomplete(details):
				break
			var confirmed_details := await _fetch_legacy_grupo_rs_equipment_details(row)
			if _legacy_equipment_details_score(confirmed_details) > _legacy_equipment_details_score(details):
				details = confirmed_details
		for key in details.keys():
			row[key] = details[key]
		var linkage := await _fetch_legacy_grupo_rs_linkage(serial, str(row.get("client", "RS300")))
		if not linkage.is_empty():
			row["plate"] = str(linkage.get("plate", ""))
			row["client"] = str(linkage.get("client", row.get("client", "RS300")))
		elif not row.has("plate"):
			var location := await _lookup_legacy_grupo_rs_location(serial)
			if bool(location.get("ok", false)):
				row["plate"] = str(location.get("plate", ""))
				row["client"] = str(location.get("client", "RS300"))
		if _legacy_equipment_details_incomplete(details):
			# Um GET de aquecimento estabiliza a resposta de detalhes em Maraba.
			await _legacy_grupo_rs_get("/Cadastros/EquipamentosView/%s" % str(row.get("edit_id", "")).uri_encode())
			var post_linkage_details := await _fetch_legacy_grupo_rs_equipment_details(row)
			if _legacy_equipment_details_score(post_linkage_details) > _legacy_equipment_details_score(details):
				details = post_linkage_details
				for key in details.keys():
					row[key] = details[key]
		rows[i] = row
	return rows


func _legacy_equipment_details_incomplete(details: Dictionary) -> bool:
	if details.is_empty():
		return true
	for key in ["apn", "chip", "operator"]:
		if str(details.get(key, "")).strip_edges() == "":
			return true
	return false


func _legacy_serial_matches_query(query: String, row: Dictionary) -> bool:
	var wanted := _search_key(query)
	if wanted.length() < 8:
		return false
	for candidate_value in [str(row.get("serial", "")), str(row.get("equipment_number", ""))]:
		var candidate := _search_key(candidate_value)
		if candidate == "":
			continue
		if candidate == wanted:
			return true
		if candidate.length() >= wanted.length() and candidate.ends_with(wanted):
			return true
		if wanted.length() >= candidate.length() and wanted.ends_with(candidate) and candidate.length() >= 8:
			return true
	return false


func _legacy_equipment_details_score(details: Dictionary) -> int:
	var score := 0
	for key in ["apn", "chip", "phone", "operator", "grupo_model", "equipment_number", "serial"]:
		if str(details.get(key, "")).strip_edges() != "":
			score += 1
	return score


func _fetch_legacy_grupo_rs_equipment_details(equipment: Dictionary) -> Dictionary:
	var edit_id := str(equipment.get("edit_id", "")).strip_edges()
	if edit_id == "":
		return {}
	var response := await _legacy_grupo_rs_get("/Cadastros/EquipamentosView/%s" % edit_id.uri_encode())
	if not bool(response.get("ok", false)):
		return {}
	var html := str(response.get("body", ""))
	return {
		"apn": _extract_legacy_input_value(html, "txtApn"),
		"chip": _extract_legacy_input_value(html, "txtNumeroChip"),
		"phone": _extract_legacy_input_value(html, "txtTelefone"),
		"operator": _normalize_bulk_operator(_extract_selected_option_text_by_id_or_name(html, "ddlOperadora")),
		"grupo_model": _extract_selected_option_text_by_id_or_name(html, "ddlModelo"),
		"equipment_number": _extract_legacy_input_value(html, "txtNumeroEquipamento"),
		"serial": _extract_legacy_input_value(html, "txtNumeroSerie"),
	}


func _fetch_legacy_grupo_rs_linkage(serial: String, client_name: String = "RS300") -> Dictionary:
	var page := await _legacy_grupo_rs_get("/Cadastros/VeiculosEquipamentosListar")
	if not bool(page.get("ok", false)):
		return {}
	var html := str(page.get("body", ""))
	var client_id := _legacy_select_option_value(html, "ddlCliente", client_name)
	if client_id == "":
		return {}
	var response := await _legacy_grupo_rs_postback("/Cadastros/VeiculosEquipamentosListar", {
		"__EVENTTARGET": "btnPsq",
		"__EVENTARGUMENT": "",
		"ddlCliente": client_id,
		"txtPsq": serial,
	})
	if not bool(response.get("ok", false)):
		return {}
	var rows := _parse_legacy_grupo_rs_link_rows(str(response.get("body", "")))
	for row in rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var candidate := row as Dictionary
		if _legacy_serial_matches_query(serial, candidate):
			candidate["client"] = client_name
			return candidate
	if rows.size() > 0 and typeof(rows[0]) == TYPE_DICTIONARY:
		var first := rows[0] as Dictionary
		first["client"] = client_name
		return first
	return {}


func _delete_modern_grupo_rs_vehicle_for_serial(serial: String) -> Dictionary:
	var clean_serial := serial.strip_edges()
	if clean_serial == "":
		return {"ok": false, "message": "Numero de serie vazio para remover no sistema novo."}

	var powershell_result := _delete_modern_grupo_rs_vehicle_with_powershell(clean_serial)
	if powershell_result.has("ok"):
		return powershell_result

	var lookup_rows := await _fetch_modern_grupo_rs_equipment_rows(clean_serial)
	var plate := ""
	if not lookup_rows.is_empty():
		var equipment := _choose_grupo_rs_equipment_row(lookup_rows, clean_serial)
		plate = str(equipment.get("plate", "")).strip_edges()
	# O serial e a chave inequívoca; a coluna de placa da listagem de
	# equipamentos pode conter o modelo em instalações antigas.
	var query := clean_serial

	var active_rows := await _fetch_modern_grupo_rs_vehicle_rows(query, "Ativo")
	var active := _choose_modern_grupo_rs_vehicle_row(active_rows, clean_serial, plate)
	if active.is_empty() and plate != "":
		active_rows = await _fetch_modern_grupo_rs_vehicle_rows(plate, "Ativo")
		active = _choose_modern_grupo_rs_vehicle_row(active_rows, clean_serial, plate)
	if not active.is_empty():
		var inactivate_href := str(active.get("inactivate_href", "")).strip_edges()
		if inactivate_href == "":
			return {"ok": false, "message": "Encontrei o veiculo no sistema novo, mas sem botao de inativar."}
		var inactivate_response := await _modern_grupo_rs_get(inactivate_href)
		if not bool(inactivate_response.get("ok", false)):
			return {"ok": false, "message": "Falha ao inativar veiculo no sistema novo: %s" % str(inactivate_response.get("message", ""))}
		if _modern_grupo_rs_page_is_login(str(inactivate_response.get("body", ""))):
			return {"ok": false, "message": "O sistema novo pediu login durante a inativacao do veiculo."}

	var inactive_rows := await _fetch_modern_grupo_rs_vehicle_rows(query, "Inativo")
	var inactive := _choose_modern_grupo_rs_vehicle_row(inactive_rows, clean_serial, plate)
	if inactive.is_empty() and plate != "":
		inactive_rows = await _fetch_modern_grupo_rs_vehicle_rows(clean_serial, "Inativo")
		inactive = _choose_modern_grupo_rs_vehicle_row(inactive_rows, clean_serial, plate)
	if inactive.is_empty():
		if active.is_empty():
			return {"ok": true, "message": "Nenhum veiculo vinculado a serie %s foi encontrado no sistema novo." % clean_serial}
		return {"ok": false, "message": "Veiculo inativado no sistema novo, mas nao apareceu no filtro Inativos."}

	var label := plate if plate != "" else clean_serial
	return {"ok": true, "message": "Veiculo %s inativado no sistema novo." % label}


func _delete_modern_grupo_rs_vehicle_with_powershell(serial: String) -> Dictionary:
	var safe_serial := serial.replace("'", "''")
	var script := """
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
Add-Type -AssemblyName System.Web

function Emit($ok, $message) {
  [pscustomobject]@{ ok = [bool]$ok; message = [string]$message } | ConvertTo-Json -Compress -Depth 6
}

function Clean([string]$value) {
  if ($null -eq $value) { return '' }
  $decoded = [System.Web.HttpUtility]::HtmlDecode(($value -replace '<[^>]+>', ' '))
  return (($decoded -replace '\\s+', ' ').Trim())
}

function Key([string]$value) {
  if ($null -eq $value) { return '' }
  return (($value -replace '[^A-Za-z0-9]', '').ToUpperInvariant())
}

function AbsUrl([string]$href) {
  if ([string]::IsNullOrWhiteSpace($href)) { return '' }
  $decoded = [System.Web.HttpUtility]::HtmlDecode($href)
  if ($decoded -match '^https?://') { return $decoded }
  if ($decoded.StartsWith('/')) { return 'https://novogrupors.ddns.net' + $decoded }
  return 'https://novogrupors.ddns.net/cadastro/' + $decoded
}

function GetPage([string]$url) {
  return (Invoke-WebRequest -Uri $url -WebSession $script:Session -UseBasicParsing -TimeoutSec 25).Content
}

function GetHref([string]$row, [string]$acao) {
  $needle = 'veiculos_actions.php?acao=' + $acao
  $idx = $row.IndexOf($needle, [System.StringComparison]::OrdinalIgnoreCase)
  if ($idx -lt 0) { return '' }
  $hrefIdx = $row.LastIndexOf('href=', $idx, [System.StringComparison]::OrdinalIgnoreCase)
  if ($hrefIdx -lt 0) { return '' }
  $doubleQuote = [char]34
  $singleQuote = [char]39
  $quoteStart = $row.IndexOf($doubleQuote, $hrefIdx)
  $quote = $doubleQuote
  if ($quoteStart -lt 0 -or $quoteStart -gt $idx) {
    $quoteStart = $row.IndexOf($singleQuote, $hrefIdx)
    $quote = $singleQuote
  }
  if ($quoteStart -lt 0) { return '' }
  $quoteEnd = $row.IndexOf($quote, $quoteStart + 1)
  if ($quoteEnd -le $quoteStart) { return '' }
  return (AbsUrl $row.Substring($quoteStart + 1, $quoteEnd - $quoteStart - 1))
}

function GetVehicleRows([string]$query, [string]$status) {
  $url = 'https://novogrupors.ddns.net/cadastro/veiculos_listar.php?busca=' + [uri]::EscapeDataString($query) + '&status=' + [uri]::EscapeDataString($status)
  $html = GetPage $url
  $rows = @()
  foreach ($m in [regex]::Matches($html, '(?is)<tr[^>]*>(.*?)</tr>')) {
    $row = $m.Groups[1].Value
    $cellMatches = [regex]::Matches($row, '(?is)<td[^>]*>(.*?)</td>')
    if ($cellMatches.Count -lt 7) { continue }
    $cells = @()
    foreach ($cell in $cellMatches) { $cells += (Clean $cell.Groups[1].Value) }
    if ([string]::IsNullOrWhiteSpace($cells[0]) -or $cells[0] -match 'Nenhum registro') { continue }
    $id = ''
    $idMatch = [regex]::Match($row, '(?is)[?&]id=(\\d+)')
    if ($idMatch.Success) { $id = $idMatch.Groups[1].Value }
    $deletePostAction = ''
    $deletePostId = ''
	if ($row.IndexOf('name="acao"', [System.StringComparison]::OrdinalIgnoreCase) -ge 0 -and $row.IndexOf('value="excluir"', [System.StringComparison]::OrdinalIgnoreCase) -ge 0) {
	  $actionMatch = [regex]::Match($row, '(?is)<form[^>]+action=["'']([^"'']+)["'']')
      if ($actionMatch.Success) { $deletePostAction = AbsUrl $actionMatch.Groups[1].Value }
	  if ([string]::IsNullOrWhiteSpace($deletePostAction)) { $deletePostAction = AbsUrl 'veiculos_actions.php' }
	  $codMatch = [regex]::Match($row, '(?is)name=["'']CodVeiculo["''][^>]*value=["'']([^"'']+)["'']')
      if ($codMatch.Success) { $deletePostId = $codMatch.Groups[1].Value }
    }
    $rows += [pscustomobject]@{
      id = $id
      plate = $cells[0]
      serial = $cells[4]
      client = $cells[5]
      status = $cells[6]
      inactivate = (GetHref $row 'inativar')
      delete = (GetHref $row 'excluir')
      deletePostAction = $deletePostAction
      deletePostId = $deletePostId
    }
  }
  return @($rows)
}

function ChooseVehicle($rows, [string]$serial, [string]$plate) {
  $serialKey = Key $serial
  $plateKey = Key $plate
  foreach ($row in @($rows)) {
    if ($serialKey -ne '' -and (Key $row.serial) -eq $serialKey) { return $row }
    if ($plateKey -ne '' -and (Key $row.plate) -eq $plateKey) { return $row }
  }
  if (@($rows).Count -eq 1) { return @($rows)[0] }
  return $null
}

try {
  $serial = '__SERIAL__'
  $settingsPath = Join-Path $env:APPDATA 'Godot\\app_userdata\\GRUPO RS CENTRAL\\app_settings.json'
  if (!(Test-Path $settingsPath)) {
    Emit $false 'Credenciais do Grupo RS nao encontradas nas preferencias.'
    exit 0
  }
  $settings = Get-Content $settingsPath -Raw | ConvertFrom-Json
  $modernUser = [string]$env:GRUPO_RS_MODERN_USER
  $modernPassword = [string]$env:GRUPO_RS_MODERN_PASSWORD
  if ([string]::IsNullOrWhiteSpace($modernUser)) { $modernUser = [string]$settings.grupo_rs_modern_user }
  if ([string]::IsNullOrWhiteSpace($modernPassword)) { $modernPassword = [string]$settings.grupo_rs_modern_password }
  if ([string]::IsNullOrWhiteSpace($modernUser) -and [string]::IsNullOrWhiteSpace($modernPassword)) {
    $modernUser = [string]$settings.grupo_rs_legacy_user
    $modernPassword = [string]$settings.grupo_rs_legacy_password
  }
  if ([string]::IsNullOrWhiteSpace($modernUser) -or [string]::IsNullOrWhiteSpace($modernPassword)) {
    Emit $false 'Configure login e senha do Grupo RS novo nas preferencias.'
    exit 0
  }

  $script:Session = New-Object Microsoft.PowerShell.Commands.WebRequestSession
  Invoke-WebRequest -Uri 'https://novogrupors.ddns.net/login.php' -WebSession $script:Session -UseBasicParsing -TimeoutSec 25 | Out-Null
  $login = Invoke-WebRequest -Uri 'https://novogrupors.ddns.net/login.php' -Method Post -Body @{ usuario = $modernUser; senha = $modernPassword } -WebSession $script:Session -UseBasicParsing -TimeoutSec 25
  if ($login.Content -match 'id="usuario"' -and $login.Content -notmatch 'admin') {
    Emit $false 'Login do sistema novo recusado.'
    exit 0
  }

  $equipmentUrl = 'https://novogrupors.ddns.net/cadastro/equipamentos_listar.php?busca=' + [uri]::EscapeDataString($serial) + '&status=todos'
  $equipmentHtml = GetPage $equipmentUrl
  $plate = ''
  foreach ($m in [regex]::Matches($equipmentHtml, '(?is)<tr[^>]*>(.*?)</tr>')) {
    $cellMatches = [regex]::Matches($m.Groups[1].Value, '(?is)<td[^>]*>(.*?)</td>')
    if ($cellMatches.Count -lt 2) { continue }
    $rowSerial = Clean $cellMatches[0].Groups[1].Value
    if ((Key $rowSerial) -eq (Key $serial)) {
      $plate = Clean $cellMatches[1].Groups[1].Value
      break
    }
  }

  # A listagem de equipamentos pode colocar o modelo (por exemplo, RS 300)
  # na coluna que algumas versoes antigas tratavam como placa. Consulte pelo
  # IMEI primeiro, que e a chave inequívoca do vinculo; use a placa somente
  # como fallback quando o portal nao aceitar a busca pelo serial.
  $active = ChooseVehicle (GetVehicleRows $serial 'Ativo') $serial $plate
  if ($null -eq $active -and ![string]::IsNullOrWhiteSpace($plate)) {
    $active = ChooseVehicle (GetVehicleRows $plate 'Ativo') $serial $plate
  }
  if ($null -ne $active) {
    if ([string]::IsNullOrWhiteSpace($active.inactivate)) {
      Emit $false 'Encontrei o veiculo no sistema novo, mas sem botao de inativar.'
      exit 0
    }
    GetPage $active.inactivate | Out-Null
    Start-Sleep -Milliseconds 500
  }

  $inactive = ChooseVehicle (GetVehicleRows $serial 'Inativo') $serial $plate
  if ($null -eq $inactive -and ![string]::IsNullOrWhiteSpace($plate)) {
    $inactive = ChooseVehicle (GetVehicleRows $serial 'Inativo') $serial $plate
  }

  if ($null -eq $inactive) {
    if ($null -eq $active) {
      Emit $true ('Nenhum veiculo vinculado a serie ' + $serial + ' foi encontrado no sistema novo.')
      exit 0
    }
    Emit $false 'Veiculo inativado no sistema novo, mas nao apareceu em Inativos.'
    exit 0
  }

  $label = $serial
  if (![string]::IsNullOrWhiteSpace($plate)) { $label = $plate }
  Emit $true ('Veiculo ' + $label + ' inativado no sistema novo.')
}
catch {
  Emit $false ('Falha no sistema novo: ' + $_.Exception.Message)
}
	"""
	script = script.replace("__SERIAL__", safe_serial)
	var credentials := _modern_grupo_rs_credentials()
	var previous_user := OS.get_environment("GRUPO_RS_MODERN_USER")
	var previous_password := OS.get_environment("GRUPO_RS_MODERN_PASSWORD")
	OS.set_environment("GRUPO_RS_MODERN_USER", str(credentials.get("username", "")))
	OS.set_environment("GRUPO_RS_MODERN_PASSWORD", str(credentials.get("password", "")))
	var result := _run_powershell_json(script)
	OS.set_environment("GRUPO_RS_MODERN_USER", previous_user)
	OS.set_environment("GRUPO_RS_MODERN_PASSWORD", previous_password)
	return result


func _run_powershell_json(script: String) -> Dictionary:
	var output: Array = []
	var exit_code := OS.execute(
		"powershell.exe",
		PackedStringArray(["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", script]),
		output,
		true,
		false
	)
	if exit_code < 0:
		return {}

	var lines: Array[String] = []
	for item in output:
		var text_value := str(item)
		for line in text_value.split("\n"):
			var clean_line := line.strip_edges()
			if clean_line != "":
				lines.append(clean_line)
	for i in range(lines.size() - 1, -1, -1):
		var line := lines[i]
		if not line.begins_with("{"):
			continue
		var parsed: Variant = JSON.parse_string(line)
		if typeof(parsed) == TYPE_DICTIONARY:
			return parsed as Dictionary
	var detail := " ".join(lines).strip_edges()
	if detail.length() > 420:
		detail = detail.substr(0, 420) + "..."
	return {"ok": false, "message": "PowerShell nao retornou JSON. %s" % detail}


func _fetch_modern_grupo_rs_vehicle_rows(query: String, status: String) -> Array[Dictionary]:
	var response := await _modern_grupo_rs_read_get(_modern_grupo_rs_vehicle_list_url(query, status))
	if not bool(response.get("ok", false)):
		return []
	return _parse_modern_grupo_rs_vehicle_rows(str(response.get("body", "")))


func _fetch_modern_grupo_rs_equipment_rows(serial: String, force_refresh: bool = false) -> Array[Dictionary]:
	var query := "equipamentos_listar.php?busca=%s&status=todos" % serial.uri_encode()
	if force_refresh:
		# O portal pode manter a listagem antiga por alguns segundos depois de um
		# POST. Um cache-buster torna a confirmacao independente da resposta
		# anterior e evita declarar falha antes da propagacao.
		query += "&_confirmacao=%d" % Time.get_ticks_msec()
	var response := await _modern_grupo_rs_read_get(_modern_grupo_rs_url(query))
	if not bool(response.get("ok", false)):
		return []
	return _parse_grupo_rs_equipment_rows(str(response.get("body", "")))


func _choose_modern_grupo_rs_vehicle_row(rows: Array[Dictionary], serial: String, plate: String = "") -> Dictionary:
	var serial_key := _search_key(serial)
	var plate_key := _search_key(plate)
	for row in rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var candidate := row as Dictionary
		var candidate_serial := _search_key(str(candidate.get("serial", "")))
		var candidate_plate := _search_key(str(candidate.get("plate", "")))
		if serial_key != "" and candidate_serial == serial_key:
			return candidate
		if plate_key != "" and candidate_plate == plate_key:
			return candidate
	# A lista pode ignorar o filtro e devolver varios veiculos. Nunca inative
	# uma linha apenas por ser a primeira resposta; sem correspondencia exata,
	# a operacao remota deve ser bloqueada.
	return {}


func _choose_modern_grupo_rs_vehicle_row_exact(rows: Array[Dictionary], serial: String, plate: String) -> Dictionary:
	var serial_key := _search_key(serial)
	var plate_key := _normalize_location_plate(plate)
	if serial_key == "" or plate_key == "":
		return {}
	var selected: Dictionary = {}
	for row in rows:
		var candidate_serial := _search_key(str(row.get("serial", "")))
		var candidate_plate := _normalize_location_plate(str(row.get("plate", "")))
		if candidate_serial != serial_key or candidate_plate != plate_key:
			continue
		if not selected.is_empty():
			return {}
		selected = row
	return selected


func _choose_grupo_rs_equipment_row_exact(rows: Array[Dictionary], serial: String, plate: String) -> Dictionary:
	var serial_key := _search_key(serial)
	var plate_key := _normalize_location_plate(plate)
	if serial_key == "" or plate_key == "":
		return {}
	var selected: Dictionary = {}
	for row in rows:
		if _search_key(str(row.get("serial", ""))) != serial_key:
			continue
		if _normalize_location_plate(str(row.get("plate", ""))) != plate_key:
			continue
		if not selected.is_empty():
			return {}
		selected = row
	return selected


func _fetch_modern_grupo_rs_vehicle_rows_all_statuses(query: String, force_refresh: bool = false) -> Dictionary:
	var cache_key := _search_key(query)
	var now := int(Time.get_unix_time_from_system())
	var cached: Dictionary = modern_grupo_rs_vehicle_rows_cache.get(cache_key, {}) as Dictionary
	if not force_refresh and not cached.is_empty() and now - int(cached.get("checked_at", 0)) <= GRUPO_RS_REPLACEMENT_QUERY_CACHE_SECONDS:
		return (cached.get("response", {}) as Dictionary).duplicate(true)
	var rows: Array[Dictionary] = []
	var seen := {}
	var cache_buster := str(Time.get_ticks_msec()) if force_refresh else ""
	for status in ["Ativo", "Inativo"]:
		var response := await _modern_grupo_rs_read_get(_modern_grupo_rs_vehicle_list_url(query, status, cache_buster))
		if not bool(response.get("ok", false)):
			return {"ok": false, "rows": [], "message": "Nao foi possivel consultar veiculos %s no Grupo RS." % status.to_lower()}
		for row in _parse_modern_grupo_rs_vehicle_rows(str(response.get("body", ""))):
			var key := str(row.get("edit_id", "")).strip_edges()
			if key == "":
				key = "%s|%s|%s" % [
					_normalize_location_plate(str(row.get("plate", ""))),
					_search_key(str(row.get("serial", ""))),
					_search_key(str(row.get("status", status))),
				]
			if seen.has(key):
				continue
			seen[key] = true
			rows.append(row)
	var result := {"ok": true, "rows": rows}
	modern_grupo_rs_vehicle_rows_cache[cache_key] = {"checked_at": now, "response": result.duplicate(true)}
	return result


func _format_grupo_rs_vehicle_plate(value: String) -> String:
	var key := _normalize_location_plate(value)
	if key.length() <= 3:
		return key
	return "%s - %s" % [key.substr(0, 3), key.substr(3)]


func _format_grupo_rs_vehicle_plate_for_display(value: String) -> String:
	var raw := value.strip_edges().to_upper()
	var key := _normalize_location_plate(raw)
	if key == "":
		return ""
	# Formato antigo/Mercosul: somente placas com tres letras iniciais e
	# complemento curto recebem a separacao visual. Codigos internos como
	# MANUT007 permanecem intactos.
	var prefix_regex := RegEx.new()
	if key.length() in [6, 7] and prefix_regex.compile("^[A-Z]{3}$") == OK and prefix_regex.search(key.substr(0, 3)) != null:
		var prefix := key.substr(0, 3)
		var suffix := key.substr(3)
		return "%s - %s" % [prefix, suffix]
	return raw


func _is_valid_grupo_rs_vehicle_reassignment_plate(value: String) -> bool:
	var key := _normalize_location_plate(value)
	var regex := RegEx.new()
	return regex.compile("^[A-Z]{3}[A-Z0-9]{3,5}$") == OK and regex.search(key) != null


func _extract_html_form_by_action(html: String, action_fragment: String) -> String:
	var form_regex := RegEx.new()
	if form_regex.compile("(?is)<form[^>]*>.*?</form>") != OK:
		return ""
	for match_result in form_regex.search_all(html):
		var form_html := match_result.get_string(0)
		var open_tag := _regex_first_group(form_html, "(?is)(<form[^>]*>)")
		if _html_attr(open_tag, "action").to_lower().contains(action_fragment.to_lower()):
			return form_html
	return ""


func _html_select_option_value_by_label(html: String, select_name: String, label: String) -> String:
	var target := _search_key(label)
	for option in _legacy_select_options(html, select_name):
		if _search_key(str(option.get("label", ""))) == target:
			return str(option.get("value", "")).strip_edges()
	return ""


func _html_select_option_label_by_value(html: String, select_name: String, value: String) -> String:
	var target := value.strip_edges()
	for option in _legacy_select_options(html, select_name):
		if str(option.get("value", "")).strip_edges() == target:
			return str(option.get("label", "")).strip_edges()
	return ""


func _modern_vehicle_edit_snapshot(html: String) -> Dictionary:
	var form_html := _extract_html_form_by_action(html, "veiculos_actions.php")
	if form_html == "":
		return {}
	var fields := _legacy_form_fields(form_html)
	var equipment_value := str(fields.get("TrocarEquip", fields.get("CodEquipamento", ""))).strip_edges()
	var equipment_label := _html_select_option_label_by_value(form_html, "TrocarEquip", equipment_value)
	return {
		"vehicle_id": str(fields.get("CodVeiculo", "")).strip_edges(),
		"plate": str(fields.get("Placa", "")).strip_edges(),
		"model": str(fields.get("Modelo", "")).strip_edges(),
		"brand": str(fields.get("Marca", "")).strip_edges(),
		"year": str(fields.get("Ano", "")).strip_edges(),
		"color": str(fields.get("Cor", "")).strip_edges(),
		"chassis": str(fields.get("Chassi", "")).strip_edges(),
		"purchase_date": str(fields.get("DataCompra", "")).strip_edges(),
		"observation": str(fields.get("Observacao", "")).strip_edges(),
		"client": _html_select_option_label_by_value(form_html, "CodCliente", str(fields.get("CodCliente", ""))),
		"vehicle_type": _html_select_option_label_by_value(form_html, "CodTipoVeiculo", str(fields.get("CodTipoVeiculo", ""))),
		"equipment_value": equipment_value,
		"equipment_label": equipment_label,
	}


func _modern_vehicle_snapshot_matches_reassignment(snapshot: Dictionary, target_plate: String, clear_vehicle_fields: bool = true, request: Dictionary = {}) -> bool:
	if snapshot.is_empty():
		return false
	if _normalize_location_plate(str(snapshot.get("plate", ""))) != _normalize_location_plate(target_plate):
		return false
	if _search_key(str(snapshot.get("client", ""))) != _search_key("RS300"):
		return false
	if _search_key(str(snapshot.get("vehicle_type", ""))) != _search_key("Carro"):
		return false
	if clear_vehicle_fields:
		# DataCompra volta preenchida com a hora do servidor mesmo quando o portal recebe vazio.
		for key in ["model", "brand", "year", "color", "chassis", "observation"]:
			if str(snapshot.get(key, "")).strip_edges() != "":
				return false
	else:
		var requested_map := {"vehicle_model": "model", "vehicle_brand": "brand", "vehicle_year": "year", "vehicle_color": "color", "vehicle_chassis": "chassis", "vehicle_observation": "observation"}
		for request_key in requested_map.keys():
			var expected := str(request.get(request_key, "")).strip_edges()
			if expected != "" and _search_key(expected) != _search_key(str(snapshot.get(requested_map[request_key], ""))):
				return false
	return true


func _build_modern_vehicle_reassignment_fields(edit_html: String, new_plate: String, request: Dictionary = {}) -> Dictionary:
	var form_html := _extract_html_form_by_action(edit_html, "veiculos_actions.php")
	if form_html == "":
		return {"ok": false, "message": "O formulario de edicao do veiculo nao foi identificado."}
	var fields := _legacy_form_fields(form_html)
	var client_label := str(request.get("client", "RS300")).strip_edges()
	if client_label == "":
		client_label = "RS300"
	var vehicle_type_label := str(request.get("vehicle_type", "Carro")).strip_edges()
	if vehicle_type_label == "":
		vehicle_type_label = "Carro"
	var client_id := _html_select_option_value_by_label(form_html, "CodCliente", client_label)
	var vehicle_type_id := _html_select_option_value_by_label(form_html, "CodTipoVeiculo", vehicle_type_label)
	if str(fields.get("CodVeiculo", "")).strip_edges() == "":
		return {"ok": false, "message": "O Grupo RS nao informou o codigo do veiculo."}
	if client_id == "":
		return {"ok": false, "message": "O cliente titular %s nao apareceu no formulario do Grupo RS." % client_label}
	if vehicle_type_id == "":
		return {"ok": false, "message": "O tipo de veiculo %s nao apareceu no formulario do Grupo RS." % vehicle_type_label}

	fields["acao"] = "editar"
	fields["TipoIdentificacao"] = "placa"
	fields["Placa"] = _format_grupo_rs_vehicle_plate(new_plate)
	fields["CodCliente"] = client_id
	fields["CodTipoVeiculo"] = vehicle_type_id
	var clear_vehicle_fields := bool(request.get("clear_vehicle_fields", true))
	var metadata_map := {"Modelo": "vehicle_model", "Marca": "vehicle_brand", "Ano": "vehicle_year", "Cor": "vehicle_color", "Chassi": "vehicle_chassis", "Observacao": "vehicle_observation"}
	for field_name in metadata_map.keys():
		if not fields.has(field_name):
			continue
		var requested_value := str(request.get(metadata_map[field_name], "")).strip_edges()
		if requested_value != "":
			fields[field_name] = requested_value
		elif clear_vehicle_fields:
			fields[field_name] = ""
	if fields.has("DataCompra") and clear_vehicle_fields:
		fields["DataCompra"] = ""
	return {"ok": true, "fields": fields}


func _prepare_modern_vehicle_reassignment(request: Dictionary) -> Dictionary:
	var remote_serial := str(request.get("remote_serial", "")).strip_edges()
	var old_plate := str(request.get("old_plate", "")).strip_edges()
	var new_plate := _format_grupo_rs_vehicle_plate(str(request.get("new_plate", "")))
	if remote_serial == "" or old_plate == "":
		return {"ok": false, "message": "Consulte o equipamento no Grupo RS antes de alterar a placa."}
	if not _is_valid_grupo_rs_vehicle_reassignment_plate(new_plate):
		return {"ok": false, "message": "A nova placa e invalida. Use formatos como AAA - C31 ou AAA - 0A00."}

	var equipment_response := await _modern_grupo_rs_get("equipamentos_listar.php?busca=%s&status=todos" % remote_serial.uri_encode())
	if not bool(equipment_response.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel confirmar o rastreador no Grupo RS novo."}
	var equipment_rows := _parse_grupo_rs_equipment_rows(str(equipment_response.get("body", "")))
	var equipment := _choose_grupo_rs_equipment_row_exact(equipment_rows, remote_serial, old_plate)
	if equipment.is_empty() and _normalize_location_plate(old_plate) != _normalize_location_plate(new_plate):
		equipment = _choose_grupo_rs_equipment_row_exact(equipment_rows, remote_serial, new_plate)
	if equipment.is_empty():
		# A listagem pode devolver a associacao real do serial enquanto a placa
		# informada no cadastro local esta atrasada. Se houver uma unica linha do
		# serial, ela e a fonte de verdade; se houver mais de uma, bloquear evita
		# alterar o veiculo errado.
		var serial_matches: Array[Dictionary] = []
		var serial_key := _search_key(remote_serial)
		for candidate in equipment_rows:
			if _search_key(str(candidate.get("serial", ""))) == serial_key:
				serial_matches.append(candidate)
		if serial_matches.size() == 1:
			equipment = serial_matches[0]
		else:
			if serial_matches.size() > 1:
				return {"ok": false, "message": "O serial %s aparece em mais de uma associacao no Grupo RS; a troca foi bloqueada para evitar alterar o veiculo errado." % remote_serial}
			return {"ok": false, "message": "O rastreador nao esta vinculado a placa anterior nem a nova placa no Grupo RS. Consulte novamente."}
	var current_plate := _format_grupo_rs_vehicle_plate(str(equipment.get("plate", "")).strip_edges())
	# A listagem de equipamentos do portal pode exibir o modelo (por exemplo,
	# "RS 300") na coluna que as versoes antigas tratavam como placa. Nunca use
	# esse texto como placa: a associacao anterior informada pelo operador e a
	# consulta de veiculos sao a fonte segura para recuperar o alvo.
	if not _is_valid_grupo_rs_vehicle_reassignment_plate(current_plate):
		var requested_old_plate := _format_grupo_rs_vehicle_plate(old_plate)
		if _is_valid_grupo_rs_vehicle_reassignment_plate(requested_old_plate):
			current_plate = requested_old_plate
	if current_plate == "":
		return {"ok": false, "message": "O Grupo RS encontrou o equipamento, mas nao informou a placa atualmente associada."}

	var vehicle_response := await _fetch_modern_grupo_rs_vehicle_rows_all_statuses(current_plate)
	if not bool(vehicle_response.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel consultar a placa vinculada no Grupo RS novo."}
	var vehicle_rows: Array[Dictionary] = vehicle_response.get("rows", []) as Array[Dictionary]
	var vehicle := _choose_modern_grupo_rs_vehicle_row_exact(vehicle_rows, remote_serial, current_plate)
	if vehicle.is_empty():
		# Algumas versoes do portal ocultam a serie na tabela de veiculos. Como
		# a listagem de equipamentos ja confirmou uma unica associacao serie+placa,
		# aceitar uma unica linha da placa evita falso negativo sem escolher entre
		# dois veiculos.
		var plate_matches: Array[Dictionary] = []
		for candidate in vehicle_rows:
			if _normalize_location_plate(str(candidate.get("plate", ""))) == _normalize_location_plate(current_plate):
				plate_matches.append(candidate)
		if plate_matches.size() == 1:
			vehicle = plate_matches[0]
		else:
			return {"ok": false, "message": "Nao encontrei um unico veiculo que corresponda exatamente a serie e a placa vinculada."}

	if _normalize_location_plate(current_plate) != _normalize_location_plate(new_plate):
		var collision_response := await _fetch_modern_grupo_rs_vehicle_rows_all_statuses(new_plate)
		if not bool(collision_response.get("ok", false)):
			return {"ok": false, "message": "Nao foi possivel verificar se a nova placa esta livre."}
		var collision_rows: Array[Dictionary] = collision_response.get("rows", []) as Array[Dictionary]
		for collision in collision_rows:
			if _normalize_location_plate(str(collision.get("plate", ""))) == _normalize_location_plate(new_plate):
				return {"ok": false, "message": "A placa %s ja pertence a outro veiculo no Grupo RS." % new_plate}

	var edit_href := str(vehicle.get("edit_href", "")).strip_edges()
	if edit_href == "":
		return {"ok": false, "message": "O Grupo RS nao forneceu o endereco de edicao do veiculo."}
	var edit_response := await _modern_grupo_rs_get(edit_href)
	if not bool(edit_response.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel abrir a edicao da placa atual."}
	var edit_html := str(edit_response.get("body", ""))
	var snapshot := _modern_vehicle_edit_snapshot(edit_html)
	if snapshot.is_empty() or _normalize_location_plate(str(snapshot.get("plate", ""))) != _normalize_location_plate(current_plate):
		return {"ok": false, "message": "A tela de edicao nao confirmou a placa esperada. A operacao foi bloqueada."}
	var listed_id := str(vehicle.get("edit_id", "")).strip_edges()
	var form_id := str(snapshot.get("vehicle_id", "")).strip_edges()
	if listed_id != "" and form_id != listed_id:
		return {"ok": false, "message": "O codigo do veiculo mudou durante a consulta. A operacao foi bloqueada."}

	return {
		"ok": true,
		"remote_serial": remote_serial,
		"old_plate": old_plate,
		"current_plate": current_plate,
		"new_plate": new_plate,
		"vehicle": vehicle,
		"edit_href": edit_href,
		"edit_html": edit_html,
		"before": snapshot,
		"clear_vehicle_fields": bool(request.get("clear_vehicle_fields", true)),
		"already_applied": _modern_vehicle_snapshot_matches_reassignment(snapshot, new_plate, bool(request.get("clear_vehicle_fields", true)), request),
	}


func _verify_modern_grupo_rs_vehicle_reassignment(remote_serial: String, new_plate: String, clear_vehicle_fields: bool = true, request: Dictionary = {}) -> Dictionary:
	var last_message := "A nova placa nao apareceu vinculada a serie esperada."
	var last_after: Dictionary = {}
	for attempt in range(GRUPO_RS_WEB_CONFIRM_ATTEMPTS):
		if attempt > 0:
			var delay_seconds := minf(
				GRUPO_RS_WEB_CONFIRM_INITIAL_DELAY_SECONDS + ((attempt - 1) * GRUPO_RS_WEB_CONFIRM_STEP_SECONDS),
				GRUPO_RS_WEB_CONFIRM_MAX_DELAY_SECONDS
			)
			await get_tree().create_timer(delay_seconds).timeout
		# A consulta anterior pode ter sido feita antes do POST e ficar em cache por
		# alguns segundos. Toda confirmacao de mutacao precisa ignorar esse estado.
		var verify_response := await _fetch_modern_grupo_rs_vehicle_rows_all_statuses(new_plate, true)
		if not bool(verify_response.get("ok", false)):
			last_message = "O Grupo RS nao respondeu a verificacao final."
			continue
		var verify_rows: Array[Dictionary] = verify_response.get("rows", []) as Array[Dictionary]
		var verified := _choose_modern_grupo_rs_vehicle_row_exact(verify_rows, remote_serial, new_plate)
		if verified.is_empty():
			last_message = "A nova placa ainda nao apareceu vinculada a serie esperada."
			continue
		var verify_href := str(verified.get("edit_href", "")).strip_edges()
		if verify_href == "":
			last_message = "A nova placa apareceu, mas o Grupo RS nao forneceu a tela de confirmacao."
			continue
		var verify_page := await _modern_grupo_rs_get(verify_href)
		if not bool(verify_page.get("ok", false)):
			last_message = "A nova placa apareceu, mas os demais campos nao puderam ser verificados."
			continue
		var after := _modern_vehicle_edit_snapshot(str(verify_page.get("body", "")))
		last_after = after
		if _modern_vehicle_snapshot_matches_reassignment(after, new_plate, clear_vehicle_fields, request):
			return {"ok": true, "after": after}
		last_message = "O Grupo RS nao confirmou todos os campos exigidos apos salvar."
	return {"ok": false, "message": "%s A verificacao foi repetida %d vezes." % [last_message, GRUPO_RS_WEB_CONFIRM_ATTEMPTS], "after": last_after}


func _update_modern_grupo_rs_vehicle_reassignment(prepared: Dictionary) -> Dictionary:
	var new_plate := str(prepared.get("new_plate", "")).strip_edges()
	var remote_serial := str(prepared.get("remote_serial", "")).strip_edges()
	var edit_href := str(prepared.get("edit_href", "")).strip_edges()
	var built := _build_modern_vehicle_reassignment_fields(str(prepared.get("edit_html", "")), new_plate, prepared)
	if not bool(built.get("ok", false)):
		return built

	var response := await _modern_grupo_rs_post_form(
		"veiculos_actions.php",
		built.get("fields", {}) as Dictionary,
		edit_href
	)
	var transport_message := ""
	if not bool(response.get("ok", false)):
		transport_message = str(response.get("message", "Conexao encerrada antes da resposta.")).strip_edges()
	elif _modern_grupo_rs_page_is_login(str(response.get("body", ""))):
		transport_message = "O Grupo RS pediu login durante a alteracao da placa."

	# O portal pode salvar e encerrar a conexao sem devolver uma resposta HTTP valida.
	# A leitura do estado final e a fonte de verdade e evita repetir um POST ja aplicado.
	modern_grupo_rs_vehicle_rows_cache.clear()
	if transport_message != "":
		# Nao repita o POST: o servidor pode ter aplicado a alteracao. Aguarde a
		# publicacao e confirme com leituras novas, evitando duplicidade.
		await get_tree().create_timer(GRUPO_RS_WEB_CONFIRM_INITIAL_DELAY_SECONDS).timeout
	var verification := await _verify_modern_grupo_rs_vehicle_reassignment(remote_serial, new_plate, bool(prepared.get("clear_vehicle_fields", true)), prepared)
	if bool(verification.get("ok", false)):
		return {
			"ok": true,
			"message": "Placa alterada, titular RS300 e tipo Carro confirmados no Grupo RS novo.",
			"after": verification.get("after", {}),
			"transport_warning": transport_message,
		}
	var verification_message := str(verification.get("message", "A alteracao nao foi confirmada."))
	if transport_message != "":
		return {"ok": false, "partial": true, "message": "O Grupo RS encerrou o envio (%s) e a verificacao nao confirmou o resultado: %s" % [transport_message, verification_message]}
	return {"ok": false, "partial": true, "message": verification_message}


func _perform_api_vehicle_reassignment(request: Dictionary) -> Dictionary:
	var remote_serial := str(request.get("remote_serial", "")).strip_edges()
	var old_plate := _format_grupo_rs_vehicle_plate(str(request.get("old_plate", "")))
	var new_plate := _format_grupo_rs_vehicle_plate(str(request.get("new_plate", "")))
	if remote_serial == "" or old_plate == "" or new_plate == "":
		return {"handled": false}
	var current_result := await _grupo_rs_api_find_vehicle(old_plate, remote_serial, true, false)
	if not bool(current_result.get("ok", false)):
		# A API pode listar a placa sem expor o numero de serie no mesmo objeto.
		current_result = await _grupo_rs_api_find_vehicle(old_plate, "", true, false)
	if not bool(current_result.get("ok", false)):
		return {"handled": false, "fallback_web": true, "message": str(current_result.get("message", "A API nao localizou a placa atual."))}
	var current := current_result.get("row", {}) as Dictionary
	var current_id := str(current.get("vehicle_id", "")).strip_edges()
	if current_id == "":
		return {"handled": false, "fallback_web": true, "message": "A API nao informou o codigo da placa atual."}
	var collision := await _grupo_rs_api_find_vehicle(new_plate, "", true, false)
	if bool(collision.get("ok", false)):
		var collision_row := collision.get("row", {}) as Dictionary
		if str(collision_row.get("vehicle_id", "")).strip_edges() != current_id:
			return {"handled": true, "ok": false, "message": "A placa %s ja pertence a outro veiculo." % new_plate}
		# Mesmo que a mesma placa ja esteja associada, continue pelo PATCH para
		# padronizar RS300/Carro e remover os dados veiculares antigos.
	var collision_code := int(collision.get("response_code", 0))
	# A API responde HTTP 200 com uma lista vazia quando a nova placa esta
	# disponivel. Isso nao e falha de transporte e nao pode acionar o portal.
	if collision_code not in [0, 404] and not bool(collision.get("not_found", false)):
		if collision_code in [403, 405, 501]:
			return {"handled": false, "fallback_web": true, "message": str(collision.get("message", "A API nao permitiu verificar a nova placa."))}
		return {"handled": true, "ok": false, "message": str(collision.get("message", "Nao foi possivel validar a nova placa."))}
	var api_request := request.duplicate(true)
	api_request["remote_serial"] = remote_serial
	api_request["force_rs300_titular"] = true
	api_request["clear_vehicle_fields"] = true
	api_request["vehicle_type"] = "Carro"
	api_request["api_vehicle_type_id"] = 1
	api_request["api_display_plate"] = true
	api_request["api_vehicle_status"] = "A"
	var client_resolution := await _grupo_rs_api_resolve_rs300_client_id()
	if not bool(client_resolution.get("ok", false)):
		return {"handled": false, "fallback_web": true, "message": str(client_resolution.get("message", "Nao foi possivel resolver o titular RS300 para a API."))}
	api_request["api_client_id"] = str(client_resolution.get("client_id", ""))
	var updated := await _grupo_rs_api_update_vehicle(api_request, current, new_plate)
	if bool(updated.get("fallback_web", false)):
		return {"handled": false, "fallback_web": true, "message": str(updated.get("message", "A API de placas nao esta disponivel para este perfil."))}
	if not bool(updated.get("ok", false)):
		if bool(updated.get("partial", false)):
			return {
				"handled": false,
				"fallback_web": true,
				"message": "A API aceitou a placa, mas nao confirmou o cadastro completo; concluindo pelo formulario web.",
			}
		return {"handled": true, "ok": false, "message": str(updated.get("message", "A API nao confirmou a alteracao da placa."))}
	var updated_row := updated.get("row", {}) as Dictionary
	if not _grupo_rs_api_reassignment_row_is_complete(updated_row, new_plate):
		return {
			"handled": false,
			"fallback_web": true,
			"message": "A API confirmou placa/equipamento, mas nao confirmou RS300, Carro e a limpeza dos dados; concluindo pelo formulario web.",
		}
	return {"handled": true, "ok": true, "api": true, "after": updated_row}


func _rollback_api_vehicle_reassignment(api_result: Dictionary, request: Dictionary) -> Dictionary:
	if bool(api_result.get("already_applied", false)):
		return {"ok": true, "skipped": true, "message": "A placa ja estava confirmada antes da operacao."}
	var after := api_result.get("after", {}) as Dictionary
	if after.is_empty():
		return {"ok": false, "message": "A API nao devolveu o veiculo alterado para restauracao."}
	var old_plate := _format_grupo_rs_vehicle_plate(str(request.get("old_plate", "")))
	if old_plate == "":
		return {"ok": false, "message": "A placa anterior e invalida para restauracao."}
	var restore_request := request.duplicate(true)
	restore_request["remote_serial"] = str(request.get("remote_serial", ""))
	var restored := await _grupo_rs_api_update_vehicle(restore_request, after, old_plate)
	if bool(restored.get("ok", false)):
		return {"ok": true, "message": "Placa anterior restaurada na API oficial."}
	return {"ok": false, "message": str(restored.get("message", "Nao foi possivel restaurar a placa anterior na API."))}


func _rollback_modern_grupo_rs_vehicle_reassignment(prepared: Dictionary) -> Dictionary:
	var edit_html := str(prepared.get("edit_html", ""))
	var edit_href := str(prepared.get("edit_href", "")).strip_edges()
	var original_form := _extract_html_form_by_action(edit_html, "veiculos_actions.php")
	if original_form == "" or edit_href == "":
		return {"ok": false, "message": "Formulario original indisponivel para restauracao."}
	var original_fields := _legacy_form_fields(original_form)
	if str(original_fields.get("CodVeiculo", "")).strip_edges() == "":
		return {"ok": false, "message": "Codigo original do veiculo indisponivel para restauracao."}
	var response := await _modern_grupo_rs_post_form("veiculos_actions.php", original_fields, edit_href)
	if not bool(response.get("ok", false)) or _modern_grupo_rs_page_is_login(str(response.get("body", ""))):
		return {"ok": false, "message": "O Grupo RS recusou a restauracao do veiculo."}

	var old_plate := str(prepared.get("old_plate", ""))
	var remote_serial := str(prepared.get("remote_serial", ""))
	var verify := await _fetch_modern_grupo_rs_vehicle_rows_all_statuses(old_plate)
	if not bool(verify.get("ok", false)):
		return {"ok": false, "message": "A restauracao foi enviada, mas nao pode ser verificada."}
	var rows: Array[Dictionary] = verify.get("rows", []) as Array[Dictionary]
	if _choose_modern_grupo_rs_vehicle_row_exact(rows, remote_serial, old_plate).is_empty():
		return {"ok": false, "message": "A placa original nao reapareceu apos a tentativa de restauracao."}
	return {"ok": true, "message": "A placa original foi restaurada no Grupo RS novo."}


func _preflight_legacy_grupo_rs_reassignment(serial: String) -> Dictionary:
	var previous_mode := selected_branch_grupo_rs_mode
