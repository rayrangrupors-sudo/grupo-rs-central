func _build_system_log_view() -> Control:
	var scroll_root := ScrollContainer.new()
	scroll_root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll_root.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll_root.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll_root.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	scroll_root.follow_focus = false
	# Keep wheel/touch scrolling available without exposing a scrollbar over the
	# compact log design. The helper also removes the scrollbar's reserved width.
	_hide_system_log_scrollbars(scroll_root)

	var root := VBoxContainer.new()
	root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.custom_minimum_size = Vector2(0, 1080)
	root.add_theme_constant_override("separation", 8)
	scroll_root.add_child(root)

	system_log_date_input = LineEdit.new()
	system_log_date_input.placeholder_text = "Data inicial dd/mm/aaaa"
	if system_log_selected_date == "":
		system_log_selected_date = "%s 00:00" % Time.get_date_string_from_system()
	if system_log_end_date == "":
		system_log_end_date = "%s 23:59" % Time.get_date_string_from_system()
	system_log_date_input.text = _system_log_calendar_display_value(system_log_selected_date)
	system_log_date_input.custom_minimum_size = Vector2(0, 36)
	_style_line_edit(system_log_date_input)
	system_log_date_input.text_submitted.connect(func(_text): _apply_system_log_filters())

	system_log_end_date_input = LineEdit.new()
	system_log_end_date_input.placeholder_text = "Data final dd/mm/aaaa"
	system_log_end_date_input.text = _system_log_calendar_display_value(system_log_end_date)
	system_log_end_date_input.custom_minimum_size = Vector2(0, 36)
	_style_line_edit(system_log_end_date_input)
	system_log_end_date_input.text_submitted.connect(func(_text): _apply_system_log_filters())

	system_log_search_input = LineEdit.new()
	system_log_search_input.placeholder_text = "Ex.: AAA-T321 ou RIM-6B79"
	system_log_search_input.text = system_log_search_term
	system_log_search_input.custom_minimum_size = Vector2(240, 36)
	system_log_search_input.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_style_line_edit(system_log_search_input)
	system_log_search_input.text_submitted.connect(func(_text): _apply_system_log_filters())

	# The type selector was removed from the visible log filters. KPI cards still
	# provide the intentional shortcuts for completed, fallback and failed events.
	system_log_type_option = null

	var logs := _filter_system_log_records(store.get_system_logs(0))
	var page_data := _system_log_page_data(logs, system_log_current_page, SYSTEM_LOG_UI_PAGE_SIZE)
	system_log_current_page = int(page_data.get("page", 0))
	var page_logs: Array[Dictionary] = page_data.get("entries", [])
	var selected_entry := _find_system_log_entry(logs, system_log_selected_id)
	if selected_entry.is_empty() and not logs.is_empty():
		selected_entry = logs[0]
		system_log_selected_id = _system_log_entry_id(selected_entry)

	root.add_child(_build_system_log_reference_filters())
	system_log_health_strip = _build_system_log_health_strip(logs)
	root.add_child(system_log_health_strip)
	system_log_kpis = _build_system_log_kpis(logs) as GridContainer
	root.add_child(system_log_kpis)

	var events_panel := _build_system_log_events_panel(logs, page_logs, page_data)
	events_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	events_panel.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	root.add_child(events_panel)
	# A deferred pass is needed because Godot may recreate ScrollBar children
	# during layout after the panels are assembled.
	_hide_system_log_scrollbars_in_tree(scroll_root)
	call_deferred("_hide_system_log_scrollbars_in_tree", scroll_root)

	var detail_panel := _build_system_log_detail_panel(selected_entry)
	detail_panel.custom_minimum_size = Vector2(0, 465)
	detail_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	detail_panel.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	root.add_child(detail_panel)
	system_log_detail_panel = detail_panel
	system_log_root = scroll_root

	return scroll_root


func _hide_system_log_scrollbars(scroll: ScrollContainer) -> void:
	if scroll == null or not is_instance_valid(scroll):
		return
	_hide_system_log_scrollbar(scroll.get_v_scroll_bar())
	_hide_system_log_scrollbar(scroll.get_h_scroll_bar())


func _hide_system_log_scrollbar(bar: ScrollBar) -> void:
	if bar == null or not is_instance_valid(bar):
		return
	# Keep ScrollContainer's wheel/touch handling, but make the native bar
	# completely non-rendering and non-interactive. Clearing its minimum size
	# also prevents a blank strip from being reserved in narrow windows.
	bar.hide()
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bar.modulate = Color(1.0, 1.0, 1.0, 0.0)
	bar.custom_minimum_size = Vector2.ZERO
	var empty_style := StyleBoxEmpty.new()
	for style_name in ["scroll", "grabber", "grabber_highlight", "grabber_pressed", "increment", "decrement"]:
		bar.add_theme_stylebox_override(style_name, empty_style)


func _hide_system_log_scrollbars_in_tree(node: Node) -> void:
	if node == null or not is_instance_valid(node):
		return
	if node is ScrollContainer:
		_hide_system_log_scrollbars(node as ScrollContainer)
	for child in node.get_children():
		_hide_system_log_scrollbars_in_tree(child)


func _refresh_system_log_view() -> void:
	var logs := _filter_system_log_records(store.get_system_logs(0))
	var page_data := _system_log_page_data(logs, system_log_current_page, SYSTEM_LOG_UI_PAGE_SIZE)
	system_log_current_page = int(page_data.get("page", 0))
	var page_logs: Array[Dictionary] = page_data.get("entries", [])
	var selected_entry := _find_system_log_entry(logs, system_log_selected_id)
	if selected_entry.is_empty() and not logs.is_empty():
		selected_entry = logs[0]
		system_log_selected_id = _system_log_entry_id(selected_entry)
	_refresh_system_log_kpis(logs)
	_refresh_system_log_health_strip(logs)
	_refresh_system_log_event_list(logs, page_logs, page_data)
	if is_instance_valid(system_log_detail_panel):
		_replace_system_log_detail_panel(selected_entry)


func _refresh_system_log_kpis(logs: Array[Dictionary]) -> void:
	if not is_instance_valid(system_log_kpis):
		return
	for child in system_log_kpis.get_children():
		system_log_kpis.remove_child(child)
		child.queue_free()
	var metrics := _system_log_extended_metrics(logs)
	var total := logs.size()
	system_log_kpis.add_child(_make_system_log_kpi_card("Eventos", str(total), "+ %d na ultima hora" % int(metrics.get("last_hour", 0)), BLUE, "arquivo.svg", Callable(self, "_show_system_log_type").bind("all"), system_log_type_filter == "all"))
	system_log_kpis.add_child(_make_system_log_kpi_card("Concluidos", str(metrics.get("completed", 0)), _system_log_percent_text(int(metrics.get("completed", 0)), total), GREEN, "confirmar.svg", Callable(self, "_show_system_log_type").bind("completed"), system_log_type_filter == "completed"))
	system_log_kpis.add_child(_make_system_log_kpi_card("Fallback web", str(metrics.get("fallback", 0)), _system_log_percent_text(int(metrics.get("fallback", 0)), total), ORANGE, "atualizar.svg", Callable(self, "_show_system_log_type").bind("fallback"), system_log_type_filter == "fallback"))
	system_log_kpis.add_child(_make_system_log_kpi_card("Falhas acionaveis", str(metrics.get("errors", 0)), "%d HTTP 5xx" % int(metrics.get("http_5xx", 0)), RED, "alerts/error.svg", Callable(self, "_show_system_log_type").bind("errors"), system_log_type_filter == "errors"))


