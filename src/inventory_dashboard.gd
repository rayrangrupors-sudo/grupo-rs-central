		_set_experttexting_config_status("Preferencias salvas. Faltam usuario, chave ou segredo da API.", YELLOW)
		return false
	_set_experttexting_config_status("Integracao salva. Clique em Testar sem enviar.", GREEN)
	_log_system_action(
		"ExpertTexting configurado",
		"API preparada | Remetente: %s | Limite diario: %s | Limite mensal: %s" % [
			sender,
			_format_monitor_usd(float(settings.get("experttexting_daily_limit_usd", 0.0))),
			_format_monitor_usd(float(settings.get("experttexting_monthly_limit_usd", 0.0))),
		]
	)
	return true


