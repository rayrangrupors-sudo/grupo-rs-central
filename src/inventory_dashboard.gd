func _animate_bulk_registration_reveal(controls: Array) -> void:
	for control in controls:
		if control is CanvasItem:
			(control as CanvasItem).modulate.a = 0.0
	call_deferred("_run_bulk_registration_reveal", controls)


func _run_bulk_registration_reveal(controls: Array) -> void:
	await get_tree().process_frame
	for index in range(controls.size()):
		var raw_control: Variant = controls[index]
		if raw_control == null or not is_instance_valid(raw_control) or not raw_control is CanvasItem:
			continue
		var control := raw_control as CanvasItem
		var tween := create_tween()
		tween.tween_interval(float(index) * 0.035)
		tween.tween_property(control, "modulate:a", 1.0, 0.18).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)


