func _app_module(module_id: String) -> RefCounted:
	if not is_inside_tree():
		return null
	var tree := get_tree()
	if tree == null or tree.root == null:
		return null
	var registry := tree.root.get_node_or_null("ModuleRegistry")
	if registry == null:
