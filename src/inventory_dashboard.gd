func _legacy_grupo_rs_postback_from_html(path: String, html: String, fields: Dictionary, retry_login: bool = true) -> Dictionary:
	var all_fields := _legacy_form_fields(html)
	for key in fields.keys():
		all_fields[key] = fields[key]

	var headers := _legacy_grupo_rs_headers()
	headers.append("Referer: %s" % _legacy_grupo_rs_url(path))
	headers.append("Origin: %s" % _legacy_grupo_rs_root_url())
	var response := await _http_post_form_with_headers(_legacy_grupo_rs_url(path), all_fields, headers)
	_legacy_update_cookies(response.get("headers", PackedStringArray()))
	if bool(response.get("ok", false)) and _legacy_grupo_rs_page_is_login(str(response.get("body", ""))) and retry_login:
		legacy_grupo_rs_logged_in[_legacy_grupo_rs_root_url()] = false
		var login := await _legacy_grupo_rs_login()
		if not bool(login.get("ok", false)):
			return login
		return await _legacy_grupo_rs_postback_from_html(path, html, fields, false)
	return response


func _legacy_row_html_for_serial(html: String, serial: String) -> String:
	var serial_key := _search_key(serial)
	var row_regex := RegEx.new()
	if row_regex.compile("(?is)<tr[^>]*>(.*?)</tr>") != OK:
		return ""
	for match_result in row_regex.search_all(html):
		var row_html := match_result.get_string(0)
		var cells := _html_table_cells(row_html)
		for cell in cells:
			if _search_key(str(cell)) == serial_key:
				return row_html
	return ""


func _legacy_last_postback_action(html: String) -> Dictionary:
	var actions := _legacy_postback_actions(html)
	if actions.is_empty():
		return {}
	return actions[actions.size() - 1]


func _legacy_postback_actions(html: String) -> Array[Dictionary]:
	var actions: Array[Dictionary] = []
	var regex := RegEx.new()
	if regex.compile("(?is)__doPostBack\\(['\"]([^'\"]+)['\"]\\s*,\\s*['\"]([^'\"]*)['\"]\\)") != OK:
		return actions
	for match_result in regex.search_all(html):
		actions.append({
			"target": _decode_basic_html_entities(match_result.get_string(1)),
			"argument": _decode_basic_html_entities(match_result.get_string(2)),
		})
	return actions


func _legacy_image_button_name_by_title(html: String, title_keyword: String) -> String:
	var keyword := title_keyword.strip_edges().to_lower()
	var regex := RegEx.new()
	if regex.compile("(?is)<input[^>]+type=[\"']?image[\"']?[^>]*>") != OK:
		return ""
	for match_result in regex.search_all(html):
		var tag := match_result.get_string(0)
		var title := _html_attr(tag, "title").strip_edges().to_lower()
		var alt := _html_attr(tag, "alt").strip_edges().to_lower()
		if title.contains(keyword) or alt.contains(keyword):
			return _html_attr(tag, "name")
	return ""


func _legacy_confirmation_fields(html: String, keywords: Array[String]) -> Dictionary:
	if html.strip_edges() == "":
		return {}

	if html.contains("WucConfirmarOpcao$ctl00"):
		return {
			"__EVENTTARGET": "WucConfirmarOpcao$ctl00",
			"__EVENTARGUMENT": "",
		}

	var normalized_keywords: Array[String] = []
	for keyword in keywords:
		var clean_keyword := str(keyword).strip_edges().to_lower()
		if clean_keyword != "":
			normalized_keywords.append(clean_keyword)
	if normalized_keywords.is_empty():
		normalized_keywords = ["confirmar", "sim"]

	var direct_button := _legacy_submit_button_field(html, normalized_keywords)
	if not direct_button.is_empty():
		return direct_button

	var image_regex := RegEx.new()
	if image_regex.compile("(?is)<input[^>]+type=[\"']?image[\"']?[^>]*>") == OK:
		for match_result in image_regex.search_all(html):
			var tag := match_result.get_string(0)
			var key := "%s %s %s" % [
				_html_attr(tag, "name"),
				_html_attr(tag, "title"),
				_html_attr(tag, "alt"),
			]
			key = key.strip_edges().to_lower()
			for keyword in normalized_keywords:
				if key.contains(keyword):
					var name := _html_attr(tag, "name")
					if name != "":
						return {
							"%s.x" % name: "8",
							"%s.y" % name: "8",
						}

	var actions := _legacy_postback_actions(html)
	for action in actions:
		var target := str(action.get("target", ""))
		var argument := str(action.get("argument", ""))
		var key := "%s %s" % [target, argument]
		key = key.to_lower()
		for keyword in normalized_keywords:
			if key.contains(keyword):
				return {
					"__EVENTTARGET": target,
					"__EVENTARGUMENT": argument,
				}

	var lower := html.to_lower()
	for keyword in normalized_keywords:
		var index := lower.find(keyword)
		if index < 0:
			continue
		var start := maxi(index - 1200, 0)
		var length := mini(2400, html.length() - start)
		var window := html.substr(start, length)
		var window_actions := _legacy_postback_actions(window)
		if not window_actions.is_empty():
			var action := window_actions[window_actions.size() - 1]
			return {
				"__EVENTTARGET": str(action.get("target", "")),
				"__EVENTARGUMENT": str(action.get("argument", "")),
			}
	return {}


func _legacy_grupo_rs_alert_message(html: String) -> String:
	var message := _regex_first_group(html, "(?is)<div[^>]+id=[\"']dMsn[\"'][^>]*>(.*?)</div>")
	var clean_message := _clean_html_text(message).strip_edges()
	var clean_key := _search_key(clean_message)
	if clean_key == "descricao" or clean_key == "descrio":
		return ""
	return clean_message


func _legacy_delete_equipment_fields(html: String) -> Dictionary:
	if html.contains("btnConfirmarAutoDeletarequipamento"):
		return {
			"__EVENTTARGET": "btnConfirmarAutoDeletarequipamento",
			"__EVENTARGUMENT": "",
		}

	var keyword_index := _legacy_delete_keyword_index(html)
	if keyword_index >= 0:
		var start := maxi(keyword_index - 1400, 0)
		var length := mini(2800, html.length() - start)
		var window := html.substr(start, length)
		var postbacks := _legacy_postback_actions(window)
		if not postbacks.is_empty():
			var action := postbacks[postbacks.size() - 1]
			return {
				"__EVENTTARGET": str(action.get("target", "")),
				"__EVENTARGUMENT": str(action.get("argument", "")),
			}

	var input_button := _legacy_submit_button_field(html, ["deletar equipamento", "excluir equipamento", "deletar", "excluir"])
	if not input_button.is_empty():
		return input_button
	return {}


func _legacy_delete_vehicle_fields(html: String) -> Dictionary:
	var target := _regex_first_group(html, "(?is)__doPostBack\\(['\"](btnConfirmarAutoDeletarVe[^'\"]*culo)['\"]")
	if target == "":
		target = _regex_first_group(html, "(?is)id=[\"'](btnConfirmarAutoDeletarVe[^\"']*culo)[\"']")
	if target != "":
		return {
			"__EVENTTARGET": _decode_basic_html_entities(target),
			"__EVENTARGUMENT": "",
		}
	return _legacy_submit_button_field(html, ["deletar veiculo", "excluir veiculo", "deletar", "excluir"])


func _legacy_delete_keyword_index(html: String) -> int:
	var lower := html.to_lower()
	var keywords := ["deletar equipamento", "excluir equipamento", "deletar", "excluir"]
	for keyword in keywords:
		var index := lower.find(keyword)
		if index >= 0:
			return index
	return -1


func _legacy_submit_button_field(html: String, keywords: Array[String]) -> Dictionary:
	var input_regex := RegEx.new()
	if input_regex.compile("(?is)<input[^>]*>") == OK:
		for match_result in input_regex.search_all(html):
			var tag := match_result.get_string(0)
			var text_value := _html_attr(tag, "value").strip_edges()
			var key := text_value.to_lower()
			for keyword in keywords:
				if key.contains(keyword):
					var name := _html_attr(tag, "name")
					if name != "":
						return {name: text_value}

	var button_regex := RegEx.new()
	if button_regex.compile("(?is)<button[^>]*>(.*?)</button>") == OK:
		for match_result in button_regex.search_all(html):
			var tag := match_result.get_string(0)
			var text_value := _clean_html_text(match_result.get_string(1))
			var key := text_value.to_lower()
			for keyword in keywords:
				if key.contains(keyword):
					var name := _html_attr(tag, "name")
					if name != "":
						return {name: text_value}
	return {}


func _extract_legacy_input_value(html: String, field_id_or_name: String) -> String:
	var value := _regex_first_group(
		html,
		"(?is)<input[^>]+(?:id|name)=[\"']?%s[\"']?[^>]+value=[\"']([^\"']*)[\"']" % field_id_or_name
	)
	if value == "":
		value = _regex_first_group(
			html,
			"(?is)<input[^>]+value=[\"']([^\"']*)[\"'][^>]+(?:id|name)=[\"']?%s[\"']?" % field_id_or_name
		)
	return _decode_basic_html_entities(value).strip_edges()


func _extract_grupo_rs_apn(html: String) -> String:
	var value := _regex_first_group(html, "(?is)<input[^>]+name=[\"']?Apn[\"']?[^>]+value=[\"']([^\"']*)[\"']")
	if value == "":
		value = _regex_first_group(html, "(?is)<input[^>]+value=[\"']([^\"']*)[\"'][^>]+name=[\"']?Apn[\"']?")
	return _decode_basic_html_entities(value).strip_edges()


func _extract_selected_option_text(html: String, select_name: String) -> String:
	var pattern := "(?is)<select[^>]+name=[\"']?%s[\"']?[^>]*>(.*?)</select>" % select_name
	var select_html := _regex_first_group(html, pattern)
	if select_html == "":
		return ""
	var selected := _regex_first_group(select_html, "(?is)<option[^>]+selected[^>]*>(.*?)</option>")
	return _clean_html_text(selected)


func _apn_is_hinova(apn: String) -> bool:
	var normalized := apn.strip_edges().to_lower()
	return normalized == "hinova.br" or normalized == "hinova"


func _apn_is_linksolutions(apn: String) -> bool:
	var normalized := apn.strip_edges().to_lower()
	return normalized == "linksolutions.br" or normalized == "linksolutions" or normalized == "link"


func _fetch_grupo_rs_client_id(client_name: String) -> String:
	if client_name.strip_edges() == "":
		return ""
	var url := _grupo_rs_client_lookup_url(client_name)
	if url == "":
		return ""
	var response := await _http_get_text(url)
	if not bool(response.get("ok", false)):
		return ""

	var parsed: Variant = JSON.parse_string(str(response.get("body", "")))
	if typeof(parsed) != TYPE_DICTIONARY:
		return ""

	var items: Array = parsed.get("items", parsed.get("results", []))
	var target := _search_key(client_name)
	var first_id := ""
	for item in items:
		if typeof(item) != TYPE_DICTIONARY:
			continue
		var candidate := item as Dictionary
		var candidate_id := _clean_json_id(candidate.get("id", ""))
		var candidate_text := str(candidate.get("text", "")).strip_edges()
		if first_id == "" and candidate_id != "":
			first_id = candidate_id
		if candidate_id != "" and _search_key(candidate_text) == target:
			return candidate_id

	return first_id


func _parse_grupo_rs_user_rows(html: String) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	var tbody := _regex_first_group(html, "(?s)<tbody[^>]*>(.*?)</tbody>")
	if tbody == "":
		return rows

	var row_regex := RegEx.new()
	if row_regex.compile("(?s)<tr[^>]*>(.*?)</tr>") != OK:
		return rows
	for match_result in row_regex.search_all(tbody):
		var row_html := match_result.get_string(1)
		var cells := _html_table_cells(row_html)
		if cells.size() < 2:
			continue
		var client_name := str(cells[0]).strip_edges()
		var edit_href := _regex_first_group(row_html, "(?is)href=[\"']([^\"']*usuarios_editar\\.php\\?id=[^\"']+)[\"']")
		if client_name == "" or edit_href == "":
			continue
		rows.append({
			"client": client_name,
			"login": str(cells[1]).strip_edges(),
			"edit_href": _decode_basic_html_entities(edit_href),
		})
	return rows


func _select_grupo_rs_user_row(rows: Array[Dictionary], client_name: String) -> Dictionary:
	var target := _search_key(client_name)
	if target == "":
		return {}
	var compatible: Array[Dictionary] = []
	for row in rows:
		var candidate_key := _search_key(str(row.get("client", "")))
		if candidate_key == target:
			return row
		if candidate_key != "" and (candidate_key.contains(target) or target.contains(candidate_key)):
			compatible.append(row)
	return compatible[0] if compatible.size() == 1 else {}


func _fetch_grupo_rs_user_cpf(client_name: String) -> Dictionary:
	var clean_name := client_name.strip_edges()
	if clean_name == "":
		return {"ok": false, "state": "no_client", "message": "Cliente nao informado para consultar o SGA."}
	if not _grupo_rs_supports_modern_api():
		return {"ok": false, "state": "cpf_unavailable", "message": "A consulta de CPF em Usuarios esta disponivel somente no Sistema RS de Imperatriz."}

	var list_path := "usuarios_listar.php?busca=%s&status=todos&porpag=100" % clean_name.uri_encode()
	var list_response := await _modern_grupo_rs_read_get(list_path)
	if not bool(list_response.get("ok", false)):
		return {"ok": false, "state": "rs_error", "message": "Nao foi possivel consultar Usuarios no Sistema RS."}

	var rows := _parse_grupo_rs_user_rows(str(list_response.get("body", "")))
	var selected := _select_grupo_rs_user_row(rows, clean_name)
	if selected.is_empty():
		return {"ok": false, "state": "cpf_not_found", "message": "CPF do cliente nao localizado em Usuarios no Sistema RS."}

	var edit_href := str(selected.get("edit_href", "")).strip_edges()
	var edit_response := await _modern_grupo_rs_get(edit_href)
	if not bool(edit_response.get("ok", false)):
		return {"ok": false, "state": "rs_error", "message": "Nao foi possivel abrir o usuario do cliente no Sistema RS."}

	var cpf := _digits_only(_extract_legacy_input_value(str(edit_response.get("body", "")), "CPF_CNPJ"))
	if cpf.length() not in [11, 14]:
		return {"ok": false, "state": "cpf_invalid", "message": "O cadastro de Usuarios nao possui CPF valido para este cliente."}
	return {
		"ok": true,
		"state": "ok",
		"client": str(selected.get("client", clean_name)),
		"cpf": cpf,
	}


func _clean_json_id(value) -> String:
	match typeof(value):
		TYPE_INT:
			return str(int(value))
		TYPE_FLOAT:
			return str(int(value))
		_:
			var text_value := str(value).strip_edges()
			if text_value.ends_with(".0"):
				return text_value.substr(0, text_value.length() - 2)
			return text_value


func _fetch_grupo_rs_vehicle_location(client_id: String, plate: String, serial: String) -> Dictionary:
	var clean_plate := plate.strip_edges()
	var plate_value := "todos" if clean_plate == "" else clean_plate
	var normalized_plate := _normalize_location_plate(clean_plate)
	var url := _grupo_rs_vehicle_location_url(client_id, plate_value, normalized_plate)
	if url == "":
		return {}

	var response := await _http_get_text(url, READ_ONLY_HTTP_TIMEOUT_SECONDS)
	if not bool(response.get("ok", false)):
		return {}

	var parsed: Variant = JSON.parse_string(str(response.get("body", "")))
	if typeof(parsed) != TYPE_ARRAY:
		return {}

	var rows := parsed as Array
	var serial_key := _search_key(serial)
	var plate_key := _search_key(clean_plate)
	for row in rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var vehicle := row as Dictionary
		var equipment_key := _search_key(str(vehicle.get("equipamento", vehicle.get("CodEquipamento", ""))))
		var vehicle_plate_key := _search_key(str(vehicle.get("placa", "")))
		if equipment_key == serial_key or (plate_key != "" and vehicle_plate_key == plate_key):
			return vehicle

	# Nunca aceite a primeira linha como fallback: a rota pode retornar a lista
	# inteira quando o filtro nao foi aplicado. Sem correspondencia exata, a
	# localizacao fica inconclusiva em vez de apontar para outro veiculo.
	return {}


func _http_get_text(url: String, timeout_seconds: float = 15.0) -> Dictionary:
	return await _http_get_text_with_headers(url, PackedStringArray(["User-Agent: GrupoRSCentral/1.0"]), timeout_seconds)


func _valid_utf8_sequence_length(bytes: PackedByteArray, index: int) -> int:
	var size := bytes.size()
	if index < 0 or index >= size:
		return 0
	var first := int(bytes[index])
	if first < 0x80:
		return 1
	if first >= 0xC2 and first <= 0xDF:
		return 2 if index + 1 < size and int(bytes[index + 1]) >= 0x80 and int(bytes[index + 1]) <= 0xBF else 0
	if first >= 0xE0 and first <= 0xEF:
		if index + 2 >= size:
			return 0
		var second := int(bytes[index + 1])
		var third := int(bytes[index + 2])
		var second_valid := second >= 0x80 and second <= 0xBF
		if first == 0xE0:
			second_valid = second >= 0xA0 and second <= 0xBF
		elif first == 0xED:
			second_valid = second >= 0x80 and second <= 0x9F
		return 3 if second_valid and third >= 0x80 and third <= 0xBF else 0
	if first >= 0xF0 and first <= 0xF4:
		if index + 3 >= size:
			return 0
		var second := int(bytes[index + 1])
		var third := int(bytes[index + 2])
		var fourth := int(bytes[index + 3])
		var second_valid := second >= 0x80 and second <= 0xBF
		if first == 0xF0:
			second_valid = second >= 0x90 and second <= 0xBF
		elif first == 0xF4:
			second_valid = second >= 0x80 and second <= 0x8F
		return 4 if second_valid and third >= 0x80 and third <= 0xBF and fourth >= 0x80 and fourth <= 0xBF else 0
	return 0


func _decode_http_body_bytes(bytes: PackedByteArray) -> String:
	var index := 0
	var valid_utf8 := true
	while index < bytes.size():
		var sequence_length := _valid_utf8_sequence_length(bytes, index)
		if sequence_length == 0:
			valid_utf8 = false
			break
		index += sequence_length
	if valid_utf8:
		return bytes.get_string_from_utf8()

	var characters := PackedStringArray()
	index = 0
	while index < bytes.size():
		var sequence_length := _valid_utf8_sequence_length(bytes, index)
		if sequence_length == 0:
			characters.append(String.chr(int(bytes[index])))
			index += 1
			continue
		var codepoint := int(bytes[index])
		if sequence_length == 2:
			codepoint = ((codepoint & 0x1F) << 6) | (int(bytes[index + 1]) & 0x3F)
		elif sequence_length == 3:
			codepoint = ((codepoint & 0x0F) << 12) | ((int(bytes[index + 1]) & 0x3F) << 6) | (int(bytes[index + 2]) & 0x3F)
		elif sequence_length == 4:
			codepoint = ((codepoint & 0x07) << 18) | ((int(bytes[index + 1]) & 0x3F) << 12) | ((int(bytes[index + 2]) & 0x3F) << 6) | (int(bytes[index + 3]) & 0x3F)
		characters.append(String.chr(codepoint))
		index += sequence_length
	return "".join(characters)


func _track_inventory_query_request(request: HTTPRequest) -> void:
	if inventory_query_scope_generation < 0 or not is_instance_valid(request):
		return
	if not inventory_query_active_requests.has(request):
		inventory_query_active_requests.append(request)
	inventory_query_http_busy = true


func _untrack_inventory_query_request(request: HTTPRequest) -> void:
	if inventory_query_active_requests.has(request):
		inventory_query_active_requests.erase(request)
	inventory_query_http_busy = not inventory_query_active_requests.is_empty()


func _cancel_inventory_query_requests() -> void:
	for request in inventory_query_active_requests.duplicate():
		if is_instance_valid(request):
			request.cancel_request()
	inventory_query_active_requests.clear()
	inventory_query_http_busy = false


func _reset_operational_query_state() -> Dictionary:
	var cancelled_requests := inventory_query_active_requests.size()
	_cancel_inventory_query_requests()
	if online_lookup_request and is_instance_valid(online_lookup_request):
		online_lookup_request.cancel_request()

	# Invalidar respostas antigas antes de limpar os dados temporarios evita
	# que uma requisicao cancelada atualize uma pagina nova ao terminar.
	inventory_reset_generation += 1
	inventory_query_scope_generation = -1
	arya_visible_batch_id += 1
	location_visible_batch_id += 1
	arya_visible_signature = ""
	location_visible_signature = ""
	inventory_table_refresh_pending = false
	inventory_visible_scope.clear()
	inventory_visible_scope_context_signature = ""
	_invalidate_visible_inventory_device_cycle()

	arya_status_cache.clear()
	arya_status_busy.clear()
	arya_resolve_cache.clear()
	arya_auto_queue.clear()
	arya_auto_running = 0
	sga_status_cache.clear()
	sga_status_busy.clear()
	sga_status_queue.clear()
	sga_status_running = 0
	location_status_cache.clear()
	location_status_busy.clear()
	location_auto_queue.clear()
	location_auto_running = 0
	online_location_queue.clear()
	online_location_running = 0
	internal_battery_cache.clear()
	internal_battery_busy.clear()
	internal_battery_queue.clear()
	internal_battery_running = 0
	linksolutions_sim_cache.clear()

	grupo_rs_api_location_cache.clear()
	grupo_rs_api_location_cache_checked_at = 0
	grupo_rs_api_vehicle_cache.clear()
	grupo_rs_api_vehicle_cache_checked_at = 0
	grupo_rs_api_token = ""
	grupo_rs_api_logged_in = false
	grupo_rs_api_health_state = "unknown"
	grupo_rs_api_last_health_at = 0
	grupo_rs_api_next_retry_at = 0
	grupo_rs_api_reconnect_attempt = 0
	grupo_rs_api_last_failure_at = 0
	grupo_rs_api_last_error = ""
	modern_grupo_rs_vehicle_rows_cache.clear()
	modern_grupo_rs_cookies.clear()
	modern_grupo_rs_logged_in = false
	legacy_grupo_rs_cookies.clear()
	legacy_grupo_rs_logged_in.clear()

	return {
		"ok": true,
		"cancelled": cancelled_requests,
		"message": "Consultas pendentes canceladas e caches operacionais limpos.",
	}


func _on_inventory_reconnect_pressed() -> void:
	if inventory_reset_running:
		return
	if equipment_registration_running or vehicle_reassignment_running or appliance_replacement_running:
		_show_warning(
			"Operacao em andamento",
			"Aguarde o cadastro ou a troca remota terminar antes de reconectar o Estoque."
		)
		return

	inventory_reset_running = true
	if inventory_reset_button and is_instance_valid(inventory_reset_button):
		inventory_reset_button.disabled = true
		inventory_reset_button.text = "Reconectando..."
	var reset := _reset_operational_query_state()
	_log_system_action(
		"Reconexao do Estoque",
		"Cache operacional limpo; consultas canceladas: %d." % int(reset.get("cancelled", 0))
	)
	await get_tree().process_frame

	var results: Array[String] = []
	if _grupo_rs_api_reads_enabled():
		var api_login := await _grupo_rs_api_login()
		if bool(api_login.get("ok", false)):
			var api_probe := await _grupo_rs_api_get("/endpoints/veiculos.php", true, true)
			if bool(api_probe.get("ok", false)):
				results.append("API Grupo RS OK")
			else:
				results.append("API Grupo RS: %s" % str(api_probe.get("message", "falha na verificacao")))
		else:
			results.append("API Grupo RS: %s" % str(api_login.get("message", "falha no login")))

	if _grupo_rs_supports_modern_api() and _grupo_rs_platform_reads_enabled():
		var portal_credentials := _modern_grupo_rs_credentials()
		if str(portal_credentials.get("username", "")).strip_edges() != "" and str(portal_credentials.get("password", "")) != "":
			var portal_login := await _modern_grupo_rs_login()
			if bool(portal_login.get("ok", false)):
				results.append("Portal Grupo RS OK")
			else:
				results.append("Portal Grupo RS: %s" % str(portal_login.get("message", "falha no login")))

	var link_credentials := _linksolutions_credentials()
	if str(link_credentials.get("username", "")).strip_edges() != "" and str(link_credentials.get("password", "")) != "":
		var link_login := await _request_linksolutions_login()
		if bool(link_login.get("ok", false)):
			results.append("Link Solutions OK")
		else:
			results.append("Link Solutions: %s" % str(link_login.get("message", "falha no login")))

	_refresh_search_results()
	inventory_reset_running = false
	if inventory_reset_button and is_instance_valid(inventory_reset_button):
		inventory_reset_button.disabled = false
		inventory_reset_button.text = "Reconectar"

	var failures: Array[String] = []
	for result in results:
		if not result.ends_with("OK"):
			failures.append(result)
	if results.is_empty():
		_show_info("Cache operacional limpo. Nenhuma integracao configurada para renovar.")
	elif failures.is_empty():
		_show_success("Estoque reconectado", "Cache limpo, sessoes renovadas e pagina atual recarregada.")
	else:
		_show_warning("Reconexao parcial", "Cache limpo, mas algumas conexoes precisam de atencao: %s" % " | ".join(failures))


func _http_get_text_with_headers(url: String, headers: PackedStringArray, timeout_seconds: float = 15.0) -> Dictionary:
	var request := HTTPRequest.new()
	request.timeout = maxf(timeout_seconds, 1.0)
	add_child(request)
	_track_inventory_query_request(request)
	var state := {"done": false, "completed": []}
	request.request_completed.connect(func(result: int, response_code: int, response_headers: PackedStringArray, body: PackedByteArray):
		state["done"] = true
		state["completed"] = [result, response_code, response_headers, body]
	)
	var error := request.request(url, headers)
	if error != OK:
		_untrack_inventory_query_request(request)
		request.queue_free()
		return {"ok": false, "message": "Falha ao iniciar requisicao.", "response_code": 0, "result": error}
	var deadline := Time.get_ticks_msec() + int(maxf(timeout_seconds, 1.0) * 1000.0)
	while not bool(state.get("done", false)) and Time.get_ticks_msec() < deadline:
		await get_tree().process_frame
	if not bool(state.get("done", false)):
		request.cancel_request()
		_untrack_inventory_query_request(request)
		request.queue_free()
		return {"ok": false, "message": "Tempo limite da requisicao excedido.", "response_code": 0, "timeout": true}
	_untrack_inventory_query_request(request)
	request.queue_free()
	var completed: Array = state.get("completed", []) as Array
	var result := int(completed[0])
	var response_code := int(completed[1])
	var response_headers := completed[2] as PackedStringArray
	var body := completed[3] as PackedByteArray
	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300:
		return {"ok": false, "message": _http_result_message(result, response_code), "response_code": response_code, "headers": response_headers, "body": _decode_http_body_bytes(body)}
	return {"ok": true, "response_code": response_code, "body": _decode_http_body_bytes(body), "headers": response_headers}


func _http_post_form_with_headers(url: String, fields: Dictionary, headers: PackedStringArray, max_redirects: int = 8) -> Dictionary:
	var request := HTTPRequest.new()
	request.timeout = 15.0
	request.max_redirects = max_redirects
	add_child(request)
	_track_inventory_query_request(request)
	var state := {"done": false, "completed": []}
	request.request_completed.connect(func(result: int, response_code: int, response_headers: PackedStringArray, body: PackedByteArray):
		state["done"] = true
		state["completed"] = [result, response_code, response_headers, body]
	)
	var body := _form_urlencode(fields)
	var final_headers := PackedStringArray(headers)
	final_headers.append("Content-Type: application/x-www-form-urlencoded")
	var error := request.request(url, final_headers, HTTPClient.METHOD_POST, body)
	if error != OK:
		_untrack_inventory_query_request(request)
		request.queue_free()
		return {"ok": false, "message": "Falha ao iniciar requisicao.", "response_code": 0, "result": error}
	var deadline := Time.get_ticks_msec() + 15000
	while not bool(state.get("done", false)) and Time.get_ticks_msec() < deadline:
		await get_tree().process_frame
	if not bool(state.get("done", false)):
		request.cancel_request()
		_untrack_inventory_query_request(request)
		request.queue_free()
		return {"ok": false, "message": "Tempo limite da requisicao excedido.", "response_code": 0, "timeout": true}
	_untrack_inventory_query_request(request)
	request.queue_free()
	var completed: Array = state.get("completed", []) as Array
	var result := int(completed[0])
	var response_code := int(completed[1])
	var response_headers := completed[2] as PackedStringArray
	var response_body := completed[3] as PackedByteArray
	var accepted_redirect := max_redirects <= 0 and response_code >= 300 and response_code < 400
	if (result != HTTPRequest.RESULT_SUCCESS and not accepted_redirect) or response_code < 200 or response_code >= 400:
		return {
			"ok": false,
			"message": _http_result_message(result, response_code),
			"response_code": response_code,
			"result": result,
			"body": _decode_http_body_bytes(response_body),
			"headers": response_headers,
		}
	return {
		"ok": true,
		"response_code": response_code,
		"result": result,
		"body": _decode_http_body_bytes(response_body),
		"headers": response_headers,
	}


func _form_urlencode(fields: Dictionary) -> String:
	var parts: Array[String] = []
	for key in fields.keys():
		parts.append("%s=%s" % [str(key).uri_encode(), str(fields.get(key, "")).uri_encode()])
	return "&".join(parts)


func _modern_grupo_rs_headers() -> PackedStringArray:
	var headers := PackedStringArray([
		"User-Agent: GrupoRSCentral/1.0",
	])
	var cookie_parts: Array[String] = []
	for key in modern_grupo_rs_cookies.keys():
		var value := str(modern_grupo_rs_cookies.get(key, "")).strip_edges()
		if value != "":
			cookie_parts.append("%s=%s" % [str(key), value])
	if not cookie_parts.is_empty():
		headers.append("Cookie: %s" % "; ".join(cookie_parts))
	return headers


func _modern_update_cookies(headers: PackedStringArray) -> void:
	for line in headers:
		var text_value := str(line)
		var separator := text_value.find(":")
		if separator <= 0:
			continue
		var name := text_value.substr(0, separator).strip_edges().to_lower()
		if name != "set-cookie":
			continue
		var cookie_text := text_value.substr(separator + 1).strip_edges()
		var first_part := cookie_text.split(";", false, 1)[0]
		var eq := first_part.find("=")
		if eq <= 0:
			continue
		modern_grupo_rs_cookies[first_part.substr(0, eq).strip_edges()] = first_part.substr(eq + 1).strip_edges()


func _modern_grupo_rs_page_is_login(html: String) -> bool:
	var lower := html.to_lower()
	return lower.contains("id=\"usuario\"") and lower.contains("id=\"senha\"")


func _modern_grupo_rs_credentials() -> Dictionary:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var username := OS.get_environment("GRUPO_RS_MODERN_USER").strip_edges()
	var password := OS.get_environment("GRUPO_RS_MODERN_PASSWORD")
	if username == "":
		username = str(settings.get("grupo_rs_modern_user", "")).strip_edges()
	if password == "":
		password = str(settings.get("grupo_rs_modern_password", ""))
	if username == "":
		username = DEFAULT_GRUPO_RS_MODERN_USER
	if password == "":
		password = DEFAULT_GRUPO_RS_MODERN_PASSWORD
	return {"username": username, "password": password}


func _grupo_rs_api_base_url() -> String:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	return _normalize_grupo_rs_api_base_url(str(settings.get("grupo_rs_api_base_url", "")))


func _normalize_grupo_rs_api_base_url(value: String) -> String:
	var configured := value.strip_edges().trim_suffix("/")
	if configured == "":
		return GRUPO_RS_API_BASE_URL
	var docs_index := configured.find("/docs/index.html")
	if docs_index >= 0:
		configured = configured.substr(0, docs_index)
	var docs_root := configured.find("/docs")
	if docs_root >= 0:
		configured = configured.substr(0, docs_root)
	var api_root := configured.find("/api_rest_app")
	if api_root >= 0:
		configured = configured.substr(0, api_root + "/api_rest_app".length())
	if configured == GRUPO_RS_API_LEGACY_BASE_URL:
		return GRUPO_RS_API_BASE_URL
	if not configured.begins_with("http://") and not configured.begins_with("https://"):
		return GRUPO_RS_API_BASE_URL
	return configured.trim_suffix("/")


func _grupo_rs_api_url(path: String) -> String:
	var clean_path := path.strip_edges()
	if not clean_path.begins_with("/"):
		clean_path = "/" + clean_path
	return "%s%s" % [_grupo_rs_api_base_url(), clean_path]


func _grupo_rs_api_headers(json_body: bool = false) -> PackedStringArray:
	var headers := PackedStringArray([
		"User-Agent: GrupoRSCentral/1.0",
		"Accept: application/json",
	])
	if json_body:
		headers.append("Content-Type: application/json")
	if grupo_rs_api_token.strip_edges() != "":
		headers.append("Authorization: Bearer %s" % grupo_rs_api_token.strip_edges())
	return headers


func _grupo_rs_api_credentials() -> Dictionary:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var username := OS.get_environment("GRUPO_RS_API_USER").strip_edges()
	var password := OS.get_environment("GRUPO_RS_API_PASSWORD")
	if username == "":
		username = str(settings.get("grupo_rs_api_user", "")).strip_edges()
	if password == "":
		password = str(settings.get("grupo_rs_api_password", ""))
	if username.begins_with("http://") or username.begins_with("https://"):
		# Versoes antigas gravavam a URL da documentacao no campo de usuario.
		# O login correto deve reutilizar as credenciais do portal quando nao ha usuario API separado.
		username = ""
	if username == "" or password == "":
		var portal_credentials := _modern_grupo_rs_credentials()
		if username == "":
			username = str(portal_credentials.get("username", "")).strip_edges()
		if password == "":
			password = str(portal_credentials.get("password", ""))
	return {"username": username, "password": password}


func _grupo_rs_api_login_with_credentials(username: String, password: String) -> Dictionary:
	grupo_rs_api_logged_in = false
	grupo_rs_api_token = ""
	var clean_username := username.strip_edges()
	var clean_password := password
	if clean_username == "" or clean_password == "":
		grupo_rs_api_last_error = "Configure as credenciais da API do Grupo RS novo."
		grupo_rs_api_last_failure_at = int(Time.get_unix_time_from_system())
		grupo_rs_api_health_state = "not_configured"
		return {"ok": false, "message": grupo_rs_api_last_error}

	var response := await _sga_http_post_json(
		_grupo_rs_api_url("/endpoints/v1/auth/login.php"),
		{"usuario": clean_username, "senha": clean_password},
		_grupo_rs_api_headers(true)
	)
	if not bool(response.get("ok", false)):
		var code := int(response.get("response_code", 0))
		grupo_rs_api_last_error = "API Grupo RS recusou o login" if code == 401 else "API Grupo RS indisponivel"
		grupo_rs_api_last_failure_at = int(Time.get_unix_time_from_system())
		grupo_rs_api_health_state = "reconnecting"
		return {"ok": false, "message": grupo_rs_api_last_error, "response_code": code}

	var parsed: Variant = JSON.parse_string(str(response.get("body", "")))
	var token := _grupo_rs_api_find_token(parsed)
	if token == "":
		grupo_rs_api_last_error = "API Grupo RS respondeu sem token JWT."
		grupo_rs_api_last_failure_at = int(Time.get_unix_time_from_system())
		grupo_rs_api_health_state = "reconnecting"
		return {"ok": false, "message": grupo_rs_api_last_error}

	grupo_rs_api_token = token
	grupo_rs_api_logged_in = true
	grupo_rs_api_last_failure_at = 0
	grupo_rs_api_last_error = ""
	grupo_rs_api_health_state = "authenticated"
	grupo_rs_api_next_retry_at = 0
	grupo_rs_api_reconnect_attempt = 0
	return {"ok": true, "token_received": true}


func _grupo_rs_api_login() -> Dictionary:
	var credentials := _grupo_rs_api_credentials()
	return await _grupo_rs_api_login_with_retry(
		str(credentials.get("username", "")),
		str(credentials.get("password", ""))
	)


func _grupo_rs_api_login_as_portal() -> Dictionary:
	# Alguns perfis da API sao somente de consulta. Para gravar equipamento,
	# reutilizamos a credencial administrativa do portal, sem alterar o perfil
	# usado nas leituras quando ele ja estiver autorizado.
	var credentials := _modern_grupo_rs_credentials()
	return await _grupo_rs_api_login_with_retry(
		str(credentials.get("username", "")),
		str(credentials.get("password", ""))
	)


func _grupo_rs_api_login_with_retry(username: String, password: String) -> Dictionary:
	var last_result: Dictionary = {"ok": false, "message": "API Grupo RS indisponivel."}
	for attempt in range(3):
		last_result = await _grupo_rs_api_login_with_credentials(username, password)
		if bool(last_result.get("ok", false)):
			return last_result
		# Credencial incorreta nao melhora com novas tentativas; falhas de rede/servidor sim.
		if int(last_result.get("response_code", 0)) == 401:
			return last_result
		if attempt < 2:
			await get_tree().create_timer(1.2 + (attempt * 1.8)).timeout
	return last_result


func _grupo_rs_api_is_permission_denied(result: Dictionary) -> bool:
	if int(result.get("response_code", 0)) == 403:
		return true
	var message := str(result.get("message", "")).to_lower()
	return message.contains("sem permiss") or message.contains("permissao para gerenciar")


func _grupo_rs_api_backoff_seconds() -> int:
	var index := clampi(grupo_rs_api_reconnect_attempt, 0, GRUPO_RS_API_RECONNECT_BACKOFF_SECONDS.size() - 1)
	return int(GRUPO_RS_API_RECONNECT_BACKOFF_SECONDS[index])


func _maintain_grupo_rs_api_session() -> void:
	if grupo_rs_api_health_running:
		return
	var now := int(Time.get_unix_time_from_system())
	if now < grupo_rs_api_next_retry_at:
		return
	if grupo_rs_api_last_health_at > 0 and now - grupo_rs_api_last_health_at < GRUPO_RS_API_HEALTH_INTERVAL_SECONDS:
		return
	var credentials := _grupo_rs_api_credentials()
	if str(credentials.get("username", "")).strip_edges() == "" or str(credentials.get("password", "")) == "":
		grupo_rs_api_health_state = "not_configured"
		return

	grupo_rs_api_health_running = true
	var response := await _grupo_rs_api_get("/endpoints/veiculos.php", true, true)
	grupo_rs_api_health_running = false
	var response_ok := bool(response.get("ok", false))
	if response_ok:
		grupo_rs_api_health_state = "online"
		grupo_rs_api_last_health_at = now
		grupo_rs_api_next_retry_at = 0
		grupo_rs_api_reconnect_attempt = 0
		grupo_rs_api_last_failure_at = 0
		grupo_rs_api_last_error = ""
		return

	grupo_rs_api_health_state = "reconnecting"
	grupo_rs_api_last_failure_at = now
	grupo_rs_api_last_error = _grupo_rs_api_error_message(response, "API Grupo RS sem resposta.")
	grupo_rs_api_logged_in = false
	grupo_rs_api_token = ""
	grupo_rs_api_next_retry_at = now + _grupo_rs_api_backoff_seconds()
	grupo_rs_api_reconnect_attempt = mini(grupo_rs_api_reconnect_attempt + 1, GRUPO_RS_API_RECONNECT_BACKOFF_SECONDS.size() - 1)


func _prune_operational_cache(cache: Dictionary, busy: Dictionary = {}) -> void:
	var now := int(Time.get_unix_time_from_system())
	var expired: Array[String] = []
	for raw_key in cache.keys():
		var key := str(raw_key)
		if busy.has(raw_key) or busy.has(key):
			continue
		var raw_entry: Variant = cache.get(raw_key, {})
		if typeof(raw_entry) != TYPE_DICTIONARY:
			continue
		var entry := raw_entry as Dictionary
		var checked_at := int(entry.get("checked_at", 0))
		if checked_at > 0 and now - checked_at > OPERATIONAL_CACHE_RETENTION_SECONDS:
			expired.append(key)
	for key in expired:
		cache.erase(key)

	while cache.size() > OPERATIONAL_CACHE_MAX_ENTRIES:
		var oldest_key := ""
		var oldest_at := now + 1
		for raw_key in cache.keys():
			var key := str(raw_key)
			if busy.has(raw_key) or busy.has(key):
				continue
			var raw_entry: Variant = cache.get(raw_key, {})
			if typeof(raw_entry) != TYPE_DICTIONARY:
				continue
			var checked_at := int((raw_entry as Dictionary).get("checked_at", 0))
			if checked_at < oldest_at:
				oldest_at = checked_at
				oldest_key = key
		if oldest_key == "":
			break
		cache.erase(oldest_key)


func _prune_operational_caches() -> void:
	_prune_operational_cache(location_status_cache, location_status_busy)
	_prune_operational_cache(arya_status_cache, arya_status_busy)
	_prune_operational_cache(arya_resolve_cache)
	_prune_operational_cache(sga_status_cache, sga_status_busy)
	_prune_operational_cache(internal_battery_cache, internal_battery_busy)
	_prune_operational_cache(modern_grupo_rs_vehicle_rows_cache)
	var now := int(Time.get_unix_time_from_system())
	if not grupo_rs_api_location_cache.is_empty() and now - grupo_rs_api_location_cache_checked_at > OPERATIONAL_CACHE_RETENTION_SECONDS:
		grupo_rs_api_location_cache.clear()
		grupo_rs_api_location_cache_checked_at = 0
	if not grupo_rs_api_vehicle_cache.is_empty() and now - grupo_rs_api_vehicle_cache_checked_at > OPERATIONAL_CACHE_RETENTION_SECONDS:
		grupo_rs_api_vehicle_cache.clear()
		grupo_rs_api_vehicle_cache_checked_at = 0


func _grupo_rs_api_get(path: String, retry_login: bool = true, force_read: bool = false) -> Dictionary:
	if not _grupo_rs_supports_modern_api():
		return {"ok": false, "message": "A API oficial vale somente para o Grupo RS novo."}
	if not force_read and not _grupo_rs_api_reads_enabled():
		return {"ok": false, "state": "disabled", "message": "Leitura pela API oficial esta desligada nas configuracoes."}
	if not grupo_rs_api_logged_in or grupo_rs_api_token.strip_edges() == "":
		var login := await _grupo_rs_api_login()
		if not bool(login.get("ok", false)):
			return login

	var response := await _http_get_text_with_headers(_grupo_rs_api_url(path), _grupo_rs_api_headers())
	if bool(response.get("ok", false)):
		return response
	if retry_login and int(response.get("response_code", 0)) == 401:
		grupo_rs_api_logged_in = false
		grupo_rs_api_token = ""
		var relogin := await _grupo_rs_api_login()
		if bool(relogin.get("ok", false)):
			return await _grupo_rs_api_get(path, false, force_read)
	return response


func _grupo_rs_api_json_request(path: String, method: int, payload: Dictionary, retry_login: bool = true) -> Dictionary:
	if not _grupo_rs_supports_modern_api():
		return {"ok": false, "message": "A API oficial vale somente para o Grupo RS novo."}
	if not grupo_rs_api_logged_in or grupo_rs_api_token.strip_edges() == "":
		var login := await _grupo_rs_api_login()
		if not bool(login.get("ok", false)):
			return login

	var response := await _http_json_request_with_headers(
		_grupo_rs_api_url(path),
		method,
		payload,
		_grupo_rs_api_headers(true)
	)
	if bool(response.get("ok", false)):
		return response
	if retry_login and int(response.get("response_code", 0)) == 401:
		grupo_rs_api_logged_in = false
		grupo_rs_api_token = ""
		var relogin := await _grupo_rs_api_login()
		if bool(relogin.get("ok", false)):
			return await _grupo_rs_api_json_request(path, method, payload, false)
	return response


func _grupo_rs_api_response_has_explicit_failure(response: Dictionary) -> bool:
	if not bool(response.get("ok", false)):
		return true
	var body := str(response.get("body", "")).strip_edges()
	if body == "":
		return false
	var parsed: Variant = JSON.parse_string(body)
	if typeof(parsed) != TYPE_DICTIONARY:
		return false
	var data := parsed as Dictionary
	for key in ["ok", "success", "sucesso"]:
		if not data.has(key):
			continue
		var value: Variant = data.get(key)
		if typeof(value) == TYPE_BOOL and not bool(value):
			return true
		var normalized := str(value).strip_edges().to_lower()
		if normalized in ["0", "false", "nao", "não", "erro", "error", "falha", "fail"]:
			return true
	for key in ["error", "erro", "failure", "falha"]:
		if data.has(key) and str(data.get(key, "")).strip_edges() != "":
			return true
	return false


func _grupo_rs_api_equipment_row_from_response(response: Dictionary, requested_serial: String) -> Dictionary:
	# Algumas versoes da API retornam o codigo criado no corpo do POST, mas
	# ainda demoram para publicar a linha na listagem. Aproveitamos esse codigo
	# para seguir direto para a associacao, sem polling de pagina.
	var parsed: Variant = JSON.parse_string(str(response.get("body", "")))
	var candidates: Array[Dictionary] = _grupo_rs_api_extract_rows(parsed)
	if typeof(parsed) == TYPE_DICTIONARY:
		var root := parsed as Dictionary
		candidates.append(root)
		for key in ["data", "equipamento", "equipment", "tracker", "result"]:
			var nested: Variant = root.get(key)
			if typeof(nested) == TYPE_DICTIONARY:
				candidates.append(nested as Dictionary)
	var requested_key := _search_key(requested_serial)
	for candidate in candidates:
		var equipment_id := _grupo_rs_api_equipment_id_from_row(candidate, true)
		if equipment_id <= 0:
			continue
		var row_serial := _search_key(_grupo_rs_api_serial_from_row(candidate))
		if row_serial != "" and requested_key != "" and row_serial != requested_key:
			continue
		var normalized := candidate.duplicate(true)
		if row_serial == "":
			normalized["numeroSerie"] = _digits_only(requested_serial)
			normalized["numeroEquipamento"] = _digits_only(requested_serial)
		return normalized
	return {}


func _grupo_rs_api_error_message(response: Dictionary, fallback: String) -> String:
	var body := str(response.get("body", "")).strip_edges()
	if body != "":
		var parsed: Variant = JSON.parse_string(body)
		if typeof(parsed) == TYPE_DICTIONARY:
			var data: Dictionary = parsed as Dictionary
			for key in ["message", "mensagem", "error", "erro", "detail", "detalhe"]:
				var message := str(data.get(key, "")).strip_edges()
				if message != "":
					return message
	var code := int(response.get("response_code", 0))
	return "%s (HTTP %d)" % [fallback, code] if code > 0 else fallback


func _grupo_rs_api_equipment_rows(payload: Variant) -> Array[Dictionary]:
	if typeof(payload) == TYPE_DICTIONARY:
		var data: Dictionary = payload as Dictionary
		if data.has("equipamentos"):
			return _grupo_rs_api_extract_rows(data.get("equipamentos"))
	return _grupo_rs_api_extract_rows(payload)


func _grupo_rs_api_find_equipment(serial: String, force_read: bool = true) -> Dictionary:
	var clean_serial := _digits_only(serial)
	if clean_serial == "":
		return {"ok": false, "message": "Numero de serie nao informado para a API."}
	var response := await _grupo_rs_api_get(
		"/endpoints/equipamentos.php?q=%s&skip=0&take=50" % clean_serial.uri_encode(),
		true,
		force_read
	)
	if not bool(response.get("ok", false)):
		var response_code := int(response.get("response_code", 0))
		return {
			"ok": false,
			"message": _grupo_rs_api_error_message(response, "A API nao permitiu consultar o equipamento."),
			"response_code": response_code,
			"not_found": response_code == 404,
		}
	var payload: Variant = JSON.parse_string(str(response.get("body", "")))
	var serial_key := _search_key(clean_serial)
	for row in _grupo_rs_api_equipment_rows(payload):
		var row_serial := _search_key(_grupo_rs_api_string_value(row, ["numeroSerie", "numero_serie", "numeroEquipamento", "numero_equipamento"]))
		if row_serial == serial_key:
			return {"ok": true, "row": row, "response_code": int(response.get("response_code", 0))}
	return {"ok": false, "message": "A API nao encontrou o equipamento %s." % clean_serial, "not_found": true}


func _grupo_rs_api_equipment_is_inactive(row: Dictionary) -> bool:
	var raw_state := str(row.get("ativo", "")).strip_edges()
	if raw_state == "":
		raw_state = str(row.get("status", row.get("situacao", ""))).strip_edges()
	var state := _search_key(raw_state)
	return state in ["i", "inativo", "inactive", "0", "false", "off", "desativado", "desativada"]


func _grupo_rs_api_activate_equipment(existing: Dictionary, serial: String) -> Dictionary:
	if existing.is_empty() or not _grupo_rs_api_equipment_is_inactive(existing):
		return {"ok": true, "skipped": true, "row": existing}
	var equipment_id := _grupo_rs_api_equipment_id_from_row(existing, true)
	if equipment_id <= 0:
		return {"ok": false, "message": "A API encontrou o aparelho inativo, mas nao retornou o codigo necessario para ativa-lo."}
	var response := await _grupo_rs_api_json_request(
		"/endpoints/equipamentos.php?id=%d" % equipment_id,
		HTTPClient.METHOD_PATCH,
		{"ativo": "A"}
	)
	if not bool(response.get("ok", false)) or _grupo_rs_api_response_has_explicit_failure(response):
		return {
			"ok": false,
			"message": _grupo_rs_api_error_message(response, "A API recusou a ativacao do aparelho."),
			"response_code": int(response.get("response_code", 0)),
		}
	var refreshed := await _grupo_rs_api_find_equipment(serial, true)
	if not bool(refreshed.get("ok", false)):
		return {"ok": false, "confirmation_pending": true, "message": "A API aceitou a ativacao, mas nao confirmou o aparelho na leitura seguinte.", "response_code": int(response.get("response_code", 0))}
	var refreshed_row := refreshed.get("row", {}) as Dictionary
	if _grupo_rs_api_equipment_is_inactive(refreshed_row):
		return {"ok": false, "message": "A API respondeu, mas o aparelho ainda aparece inativo.", "response_code": int(response.get("response_code", 0))}
	return {"ok": true, "activated": true, "row": refreshed_row}


func _activate_modern_grupo_rs_equipment_if_needed(serial: String) -> Dictionary:
	# A listagem do portal e a API oficial podem expor estados diferentes. Use a
	# linha exata do serial como fonte de verdade para a ativacao e so acione o
	# link do proprio portal quando ele realmente aparecer como Inativo.
	var rows := await _fetch_modern_grupo_rs_equipment_rows(serial, true)
	var equipment := _choose_modern_grupo_rs_equipment_row_by_serial_exact(rows, serial)
	if equipment.is_empty():
		return {"ok": true, "skipped": true, "portal_not_found": true}
	var status := _search_key(str(equipment.get("status", "")))
	var inactive := status in ["i", "inativo", "inactive", "0", "false", "off", "desativado", "desativada"]
	if not inactive:
		return {"ok": true, "skipped": true, "row": equipment}
	var activate_href := str(equipment.get("activate_href", "")).strip_edges()
	if activate_href == "":
		return {"ok": false, "message": "O portal confirmou o aparelho inativo, mas nao forneceu o comando seguro para ativa-lo.", "portal": true}
	var activation_response := await _modern_grupo_rs_get(activate_href)
	if not bool(activation_response.get("ok", false)) or _modern_grupo_rs_page_is_login(str(activation_response.get("body", ""))):
		return {"ok": false, "message": "Falha ao ativar o aparelho inativo no portal Grupo RS.", "portal": true}
	var confirmed_rows := await _fetch_modern_grupo_rs_equipment_rows(serial, true)
	var confirmed := _choose_modern_grupo_rs_equipment_row_by_serial_exact(confirmed_rows, serial)
	if confirmed.is_empty() or _search_key(str(confirmed.get("status", ""))) in ["i", "inativo", "inactive", "0", "false", "off", "desativado", "desativada"]:
		return {"ok": false, "confirmation_pending": true, "message": "O portal recebeu a ativacao, mas ainda nao confirmou o aparelho como ativo.", "portal": true}
	return {"ok": true, "activated": true, "row": confirmed, "portal": true}


func _grupo_rs_api_wait_for_equipment(serial: String) -> Dictionary:
	# A gravacao e a leitura podem passar por servidores diferentes. Fazemos no
	# maximo duas leituras curtas, sem polling indefinido e sem repetir o POST.
	var last_result: Dictionary = {}
	for attempt in range(GRUPO_RS_WRITE_CONFIRM_ATTEMPTS):
		if attempt > 0:
			var delay_seconds := minf(
				GRUPO_RS_WRITE_CONFIRM_INITIAL_DELAY_SECONDS + ((attempt - 1) * GRUPO_RS_WRITE_CONFIRM_STEP_SECONDS),
				GRUPO_RS_WRITE_CONFIRM_MAX_DELAY_SECONDS
			)
			await get_tree().create_timer(delay_seconds).timeout
		last_result = await _grupo_rs_api_find_equipment(serial, true)
		if bool(last_result.get("ok", false)):
			return last_result
		if not bool(last_result.get("not_found", false)):
			return last_result
	if last_result.is_empty():
		last_result = {"ok": false, "not_found": true}
	last_result["message"] = "A API aceitou o equipamento, mas ainda nao o publicou para a consulta de confirmacao."
	last_result["confirmation_pending"] = true
	return last_result


func _grupo_rs_api_equipment_row_matches_request(row: Dictionary, request: Dictionary) -> bool:
	if row.is_empty():
		return false
	var expected_serial := _search_key(str(request.get("serial", request.get("remote_serial", ""))))
	var actual_serial := _search_key(_grupo_rs_api_serial_from_row(row))
	if expected_serial != "" and actual_serial != "" and expected_serial != actual_serial:
		return false
	var expected_values := {
		"chip": _digits_only(str(request.get("chip_number", request.get("chip", "")))),
		"phone": _digits_only(str(request.get("phone", ""))),
		"apn": str(request.get("apn", "")).strip_edges().to_lower(),
	}
	for field_name in ["chip", "phone", "apn"]:
		var expected := str(expected_values.get(field_name, "")).strip_edges()
		if expected == "":
			continue
		var actual_keys: Array[String] = []
		match field_name:
			"chip":
				actual_keys = ["chip", "Chip", "numeroChip", "numero_chip", "NumeroChip", "iccid", "ICCID"]
			"phone":
				actual_keys = ["phone", "Phone", "telefone", "Telefone", "numeroTelefone", "numero_telefone", "NumeroTelefone"]
			"apn":
				actual_keys = ["apn", "APN"]
		var actual := _grupo_rs_api_string_value(row, actual_keys)
		if field_name in ["chip", "phone"]:
			actual = _digits_only(actual)
		else:
			actual = actual.to_lower()
		# Algumas versoes da API omitem campos na listagem. Ausencia nao invalida
		# uma escrita aceita; divergencia explicita invalida.
		if actual != "" and actual != expected:
			return false
	return true


func _grupo_rs_api_model_id(request: Dictionary, existing: Dictionary = {}) -> int:
	var requested_id := int(request.get("api_model_id", 0))
	if requested_id > 0:
		return requested_id
	var existing_id := int(existing.get("codModelo", 0))
	if existing_id > 0:
		return existing_id
	# O portal Grupo RS nao usa o tipo local (RS Novo, Reutilizado etc.) como
	# modelo remoto. Todo cadastro deste fluxo deve ser enviado como RS 300.
	return GRUPO_RS_REMOTE_MODEL_ID if _search_key(str(request.get("model", ""))) in ["rsnovo", "rs300", "reutilizado", "novo", "v735", "v7355", ""] else 0


func _grupo_rs_api_operator_id(request: Dictionary, existing: Dictionary = {}) -> int:
	var requested_id := int(request.get("api_operator_id", 0))
	if requested_id > 0:
		return requested_id
	match _search_key(str(request.get("operator", ""))):
		"tim":
			return 4
		# Os demais codigos variam entre bases. Resolva-os no catalogo atual
		# para nunca transformar VIVO/CLARO em MULTI OPERADORA ou em outra linha.
	var existing_id := int(existing.get("codOperadora", 0))
	if existing_id > 0:
		return existing_id
	return 0


func _grupo_rs_api_resolve_registration_ids(request: Dictionary) -> Dictionary:
	var model_id := _grupo_rs_api_model_id(request)
	var operator_id := _grupo_rs_api_operator_id(request)
	if model_id > 0 and operator_id > 0:
		return {"ok": true, "model_id": model_id, "operator_id": operator_id, "source": "known_values"}

	# O catalogo de modelo/operadora pertence ao portal e pode mudar sem que a
	# API altere o endpoint de cadastro. Quando nao houver um mapeamento local,
	# lemos os valores atuais do formulario para nao enviar ids inventados ou 0.
	var page := await _modern_grupo_rs_get("equipamentos_editar.php?acao=novo")
	if not bool(page.get("ok", false)):
		return {
			"ok": false,
			"message": "Nao foi possivel carregar o catalogo do Grupo RS para resolver modelo e operadora.",
			"detail": str(page.get("message", "")),
		}
	var html := str(page.get("body", ""))
	_grupo_rs_api_refresh_operator_catalog(html)
	var requested_model := str(request.get("model", "")).strip_edges()
	var requested_operator := str(request.get("operator", "")).strip_edges()
	var model_candidates: Array[String] = [GRUPO_RS_REMOTE_MODEL_LABEL]
	if requested_model != "" and _search_key(requested_model) != _search_key(GRUPO_RS_REMOTE_MODEL_LABEL):
		model_candidates.append(requested_model)
	var operator_candidates: Array[String] = [requested_operator]
	for candidate in ["CLARO", "MULTI OPERADORA", "NLT", "OI", "TIM", "VIVO"]:
		if _search_key(candidate) == _search_key(requested_operator):
			operator_candidates.append(candidate)

	for candidate in model_candidates:
		if model_id <= 0 and candidate.strip_edges() != "":
			var catalog_model_id := _html_select_option_value_by_label(html, "CodModelo", candidate)
			if catalog_model_id == "":
				catalog_model_id = _html_select_option_value_by_label(html, "ddlModelo", candidate)
			if catalog_model_id.is_valid_int() and int(catalog_model_id) > 0:
				model_id = int(catalog_model_id)
				break
	for candidate in operator_candidates:
		if operator_id <= 0 and candidate.strip_edges() != "":
			var catalog_operator_id := _html_select_option_value_by_label(html, "CodOperadora", candidate)
			if catalog_operator_id == "":
				catalog_operator_id = _html_select_option_value_by_label(html, "ddlOperadora", candidate)
			if catalog_operator_id.is_valid_int() and int(catalog_operator_id) > 0:
				operator_id = int(catalog_operator_id)
				break

	if model_id > 0 and operator_id > 0:
		return {"ok": true, "model_id": model_id, "operator_id": operator_id, "source": "portal_catalog"}
	return {
		"ok": false,
		"message": "O catalogo remoto nao encontrou os codigos autorizados para o cadastro.",
		"model": requested_model,
		"operator": requested_operator,
		"model_id": model_id,
		"operator_id": operator_id,
	}


func _grupo_rs_api_refresh_operator_catalog(html: String) -> void:
	var options := _legacy_select_options(html, "CodOperadora")
	for option in options:
		var value := str(option.get("value", "")).strip_edges()
		if not value.is_valid_int() or int(value) <= 0:
			continue
		var label := str(option.get("label", "")).strip_edges()
		if label != "":
			grupo_rs_api_operator_labels[int(value)] = label


func _grupo_rs_api_equipment_payload(request: Dictionary, existing: Dictionary = {}, partial: bool = false) -> Dictionary:
	var serial := _digits_only(str(request.get("serial", "")))
	var apn := str(request.get("apn", "")).strip_edges().to_lower()
	var chip := _digits_only(str(request.get("chip_number", "")))
	var phone := _local_registration_phone(str(request.get("phone", "")))
	var payload: Dictionary = {}
	if not partial or serial != "":
		payload["numeroEquipamento"] = serial
		payload["numeroSerie"] = serial
	if not partial or apn != "":
		payload["apn"] = apn
	if not partial or chip != "":
		payload["numeroChip"] = chip
	if not partial or phone != "":
		payload["numeroTelefone"] = phone
	var model_id := _grupo_rs_api_model_id(request, existing)
	var operator_id := _grupo_rs_api_operator_id(request, existing)
	if not partial or model_id > 0:
		if model_id > 0:
			payload["codModelo"] = model_id
	if not partial or operator_id > 0:
		if operator_id > 0:
			payload["codOperadora"] = operator_id
	if not partial:
		payload["ativo"] = "A"
	return payload


func _grupo_rs_api_patch_equipment(request: Dictionary, existing: Dictionary) -> Dictionary:
	var id := _grupo_rs_api_equipment_id_from_row(existing, true)
	if id <= 0:
		return {"ok": false, "message": "A API nao retornou o codigo do equipamento para edicao."}
	var patch_request := request.duplicate(true)
	var requested_operator := str(patch_request.get("operator", "")).strip_edges()
	var requested_model := str(patch_request.get("model", "")).strip_edges()
	var needs_catalog_resolution := (requested_operator != "" and _grupo_rs_api_operator_id(patch_request, existing) <= 0) \
			or (requested_model != "" and _grupo_rs_api_model_id(patch_request, existing) <= 0)
	if needs_catalog_resolution:
		var resolved_ids := await _grupo_rs_api_resolve_registration_ids(patch_request)
		if not bool(resolved_ids.get("ok", false)):
			return {
				"ok": false,
				"fallback_web": true,
				"message": str(resolved_ids.get("message", "O catalogo remoto nao confirmou modelo/operadora para a modificacao.")),
			}
		patch_request["api_model_id"] = int(resolved_ids.get("model_id", 0))
		patch_request["api_operator_id"] = int(resolved_ids.get("operator_id", 0))
	var payload := _grupo_rs_api_equipment_payload(patch_request, existing, true)
	if payload.is_empty():
		return {"ok": true, "row": existing}
	var response := await _grupo_rs_api_json_request(
		"/endpoints/equipamentos.php?id=%d" % id,
		HTTPClient.METHOD_PATCH,
		payload
	)
	if not bool(response.get("ok", false)) or _grupo_rs_api_response_has_explicit_failure(response):
		var code := int(response.get("response_code", 0))
		if code == 500:
			# HTTP 500 e ambiguo: o PATCH pode ter sido aplicado antes de a
			# conexao ser encerrada. Confirme a serie uma vez e nunca repita por
			# outro canal sem saber o resultado.
			var after_error := await _grupo_rs_api_wait_for_equipment(str(request.get("serial", "")))
			if bool(after_error.get("ok", false)) and _grupo_rs_api_equipment_row_matches_request(after_error.get("row", {}) as Dictionary, request):
				return {
					"ok": true,
					"row": after_error.get("row", existing),
					"warning": "A API devolveu HTTP 500, mas a alteracao foi confirmada.",
					"response_code": code,
				}
			return {
				"ok": false,
				"partial": true,
				"confirmation_pending": true,
				"message": "A API devolveu HTTP 500. A alteracao nao sera repetida para evitar duplicidade; confirme novamente quando o servico responder.",
				"response_code": code,
			}
		return {
			"ok": false,
			"message": _grupo_rs_api_error_message(response, "A API recusou a edicao do equipamento."),
			"response_code": code,
			"fallback_web": code in [403, 404, 405, 500, 501],
		}
	var refreshed := await _grupo_rs_api_wait_for_equipment(str(request.get("serial", "")))
	if bool(refreshed.get("ok", false)) and _grupo_rs_api_equipment_row_matches_request(refreshed.get("row", {}) as Dictionary, request):
		return refreshed
	# Sem confirmacao, nao atualize o estoque local e nao repita por outro canal:
	# o PATCH pode ter sido aceito mesmo que a leitura ainda esteja atrasada.
	return {
		"ok": false,
		"partial": true,
		"confirmation_pending": true,
		"message": str(refreshed.get("message", "A API aceitou a alteracao, mas nao confirmou os dados na leitura seguinte.")),
		"response_code": int(refreshed.get("response_code", 0)),
	}


func _grupo_rs_api_register_equipment(request: Dictionary) -> Dictionary:
	var serial := _digits_only(str(request.get("serial", "")))
	if serial == "":
		return {"ok": false, "message": "Serie ausente para cadastrar o equipamento."}
	var requested_operator := str(request.get("operator", "")).strip_edges()
	if requested_operator == "":
		return {"ok": false, "message": "Operadora obrigatoria para cadastrar o equipamento no Grupo RS."}
	var existing_result := await _grupo_rs_api_find_equipment(serial, true)
	if _grupo_rs_api_is_permission_denied(existing_result):
		var portal_login := await _grupo_rs_api_login_as_portal()
		if bool(portal_login.get("ok", false)):
			existing_result = await _grupo_rs_api_find_equipment(serial, true)
	if bool(existing_result.get("ok", false)):
		var updated := await _grupo_rs_api_patch_equipment(request, existing_result.get("row", {}) as Dictionary)
		if _grupo_rs_api_is_permission_denied(updated):
			var portal_login := await _grupo_rs_api_login_as_portal()
			if bool(portal_login.get("ok", false)):
				updated = await _grupo_rs_api_patch_equipment(request, existing_result.get("row", {}) as Dictionary)
		if not bool(updated.get("ok", false)):
			return updated
		return {"ok": true, "row": updated.get("row", existing_result.get("row", {})), "existing": true}
	if int(existing_result.get("response_code", 0)) == 403:
		return {
			"ok": false,
			"response_code": 403,
			"message": "O perfil configurado nao tem permissao para gerenciar equipamentos, e a credencial administrativa do portal nao foi aceita.",
			"fallback_web": true,
		}
	if not bool(existing_result.get("not_found", false)):
		return {
			"ok": false,
			"message": str(existing_result.get("message", "A consulta do equipamento falhou; o cadastro foi bloqueado para evitar duplicidade.")),
			"response_code": existing_result.get("response_code", 0),
			"fallback_web": true,
		}

	var model_id := _grupo_rs_api_model_id(request)
	var operator_id := _grupo_rs_api_operator_id(request)
	if model_id <= 0 or operator_id <= 0:
		var resolved_ids := await _grupo_rs_api_resolve_registration_ids(request)
		if not bool(resolved_ids.get("ok", false)):
			return {
				"ok": false,
				"message": "%s Modelo: %s | Operadora: %s" % [
					str(resolved_ids.get("message", "A API exige um codigo de modelo e operadora autorizados para o cadastro.")),
					str(request.get("model", "")),
					str(request.get("operator", "")),
				],
				"fallback_web": true,
			}
		model_id = int(resolved_ids.get("model_id", 0))
		operator_id = int(resolved_ids.get("operator_id", 0))
		request = request.duplicate(true)
		request["api_model_id"] = model_id
		request["api_operator_id"] = operator_id
	var payload := _grupo_rs_api_equipment_payload(request)
	for required_key in ["numeroSerie", "apn", "numeroChip", "numeroTelefone"]:
		if str(payload.get(required_key, "")).strip_edges() == "":
			return {"ok": false, "message": "Campo obrigatorio ausente para a API: %s." % required_key}
	var response := await _grupo_rs_api_json_request(
		"/endpoints/equipamentos.php",
		HTTPClient.METHOD_POST,
		payload
	)
	if _grupo_rs_api_is_permission_denied(response):
		var portal_login := await _grupo_rs_api_login_as_portal()
		if bool(portal_login.get("ok", false)):
			response = await _grupo_rs_api_json_request(
				"/endpoints/equipamentos.php",
				HTTPClient.METHOD_POST,
				payload,
				false
			)
	if not bool(response.get("ok", false)) or _grupo_rs_api_response_has_explicit_failure(response):
		var fallback_message := _grupo_rs_api_error_message(response, "A API recusou o cadastro do equipamento.")
		if _grupo_rs_api_is_permission_denied(response):
			fallback_message = "Perfil sem permissao para gerenciar equipamentos. Configure um perfil administrativo do Grupo RS novo para cadastros."
		return {
			"ok": false,
			"message": fallback_message,
			"response_code": response.get("response_code", 0),
			"fallback_web": true,
		}
	var response_row := _grupo_rs_api_equipment_row_from_response(response, serial)
	if not response_row.is_empty():
		return {
			"ok": true,
			"row": response_row,
			"existing": false,
			"api": true,
			"response_code": int(response.get("response_code", 0)),
			"accepted": true,
			"confirmed_by": "write_response",
		}
	var confirmed := await _grupo_rs_api_wait_for_equipment(serial)
	if bool(confirmed.get("ok", false)):
		return {"ok": true, "row": confirmed.get("row", {}), "existing": false, "response_code": int(response.get("response_code", 0))}
	if bool(confirmed.get("confirmation_pending", false)):
		return {
			"ok": true,
			"partial": true,
			"confirmation_pending": true,
			"message": str(confirmed.get("message", "A API aceitou o cadastro, mas ainda nao confirmou o equipamento.")),
			"response_code": int(confirmed.get("response_code", response.get("response_code", 0))),
			"request": request,
		}
	return {"ok": false, "message": str(confirmed.get("message", "A API aceitou o cadastro, mas nao confirmou o equipamento.")), "partial": true, "response_code": int(confirmed.get("response_code", response.get("response_code", 0)))}


func _grupo_rs_api_find_token(value: Variant) -> String:
	if value == null:
		return ""
	if typeof(value) == TYPE_DICTIONARY:
		var data: Dictionary = value as Dictionary
		for key in ["token", "access_token", "accessToken", "jwt", "id_token"]:
			var candidate: Variant = data.get(key, "")
			if typeof(candidate) == TYPE_STRING and str(candidate).strip_edges() != "":
				return str(candidate).strip_edges()
		for nested in data.values():
			var found := _grupo_rs_api_find_token(nested)
			if found != "":
				return found
	elif typeof(value) == TYPE_ARRAY:
		for nested in value as Array:
			var found := _grupo_rs_api_find_token(nested)
			if found != "":
				return found
	return ""


func _grupo_rs_api_looks_like_row(data: Dictionary) -> bool:
	for key in ["placa", "Placa", "plate", "latitude", "Latitude", "lat", "longitude", "Longitude", "lng", "veiculo", "vehicle", "equipamento", "imei", "numeroSerie", "numeroEquipamento", "codEquipamento", "apn", "numeroChip", "ignicao", "Ignicao", "StatusIgnicao", "ignition"]:
		if data.has(key):
			return true
	return false


func _grupo_rs_api_extract_rows(value: Variant) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	if value == null:
		return rows
	if typeof(value) == TYPE_ARRAY:
		for item in value as Array:
			if typeof(item) == TYPE_DICTIONARY:
				rows.append((item as Dictionary).duplicate(true))
		return rows
	if typeof(value) != TYPE_DICTIONARY:
		return rows
	var data: Dictionary = value as Dictionary
	if _grupo_rs_api_looks_like_row(data):
		rows.append(data.duplicate(true))
		return rows
	# The official API has used both Portuguese and English keys, and some
	# deployments wrap the collection one level deeper. Keep extraction
	# independent from that presentation detail so a valid row is not lost.
	for key in [
		"data", "dados", "veiculos", "Veiculos", "vehicles", "Vehicles",
		"localizacao", "localizacoes", "locations", "items", "Items",
		"rows", "list", "lista", "results", "result", "resultado",
		"registros", "records", "content", "response", "resposta"
	]:
		if not data.has(key):
			continue
		var nested_rows := _grupo_rs_api_extract_rows(data.get(key))
		if not nested_rows.is_empty():
			return nested_rows
	return rows


func _grupo_rs_api_string_value(data: Dictionary, keys: Array[String]) -> String:
	for key in keys:
		if not data.has(key):
			continue
		var raw: Variant = data.get(key)
		if raw == null:
			continue
		if typeof(raw) == TYPE_DICTIONARY:
			var nested: Dictionary = raw as Dictionary
			for nested_key in ["id", "codigo", "code", "value", "valor", "nome", "name"]:
				var nested_value: Variant = nested.get(nested_key, "")
				if nested_value != null and str(nested_value).strip_edges() != "":
					return str(nested_value).strip_edges()
			continue
		var text_value := str(raw).strip_edges()
		if text_value != "":
			return text_value
	return ""


func _grupo_rs_api_numeric_string_value(data: Dictionary, keys: Array[String]) -> String:
	var value := _grupo_rs_api_string_value(data, keys)
	if value == "" or value.is_valid_int() or not value.is_valid_float():
		return value
	var numeric := float(value)
	if abs(numeric - round(numeric)) < 0.000001:
		return str(int(round(numeric)))
	return value


func _grupo_rs_api_normalize_location(raw: Dictionary) -> Dictionary:
	var data := raw.duplicate(true)
	for key in ["localizacao", "location", "posicao", "ultima_localizacao", "last_location"]:
		var nested: Variant = raw.get(key)
		if typeof(nested) != TYPE_DICTIONARY:
			continue
		for nested_key in (nested as Dictionary).keys():
			if not data.has(nested_key):
				data[nested_key] = (nested as Dictionary).get(nested_key)
	var decoded: Dictionary = ST310DecoderScript.decode_api_row(raw)
	var decoded_coordinates: Dictionary = decoded.get("coordinates", {}) as Dictionary
	var decoded_lat := str(decoded_coordinates.get("lat", ""))
	var decoded_lng := str(decoded_coordinates.get("lng", ""))
	return {
		"raw": raw.duplicate(true),
	"decoder": decoded,
	"decoder_protocol": str(decoded.get("protocol", "ST310")),
	"decoder_kind": str(decoded.get("kind", "communication")),
	"decoder_message": str(decoded.get("message", "")),
	"coordinates_valid": bool(decoded.get("coordinates_valid", false)),
		"serial": _grupo_rs_api_serial_from_row(data),
		"plate": _format_grupo_rs_vehicle_plate_for_display(_grupo_rs_api_string_value(data, ["placa", "plate", "Placa"])),
		"client": _grupo_rs_api_string_value(data, ["cliente", "client", "Cliente", "nomeCliente", "nomeClienteTitular", "NomeClienteTitular", "clienteTitular", "ClienteTitular"]),
		"client_id": _grupo_rs_api_string_value(data, ["cliente_id", "client_id", "idCliente", "codCliente", "cod_cliente"]),
		"vehicle_id": _grupo_rs_api_numeric_string_value(data, ["veiculo_id", "vehicle_id", "codVeiculo", "CodVeiculo", "idVeiculo", "id"]),
		"equipment_id": str(_grupo_rs_api_equipment_id_from_row(data)),
		"model": _grupo_rs_api_string_value(data, ["modelo", "Modelo", "model", "Model"]),
		"brand": _grupo_rs_api_string_value(data, ["marca", "Marca", "brand", "Brand"]),
		"year": _grupo_rs_api_string_value(data, ["ano", "Ano", "year", "Year"]),
		"color": _grupo_rs_api_string_value(data, ["cor", "Cor", "color", "Color"]),
		"chassis": _grupo_rs_api_string_value(data, ["chassi", "Chassi", "chassis", "Chassis"]),
		"purchase_date": _grupo_rs_api_string_value(data, ["dataCompra", "DataCompra", "data_compra", "purchase_date"]),
		"observation": _grupo_rs_api_string_value(data, ["observacao", "Observacao", "observacoes", "observations"]),
		"vehicle_type": _grupo_rs_api_string_value(data, ["tipoVeiculo", "TipoVeiculo", "tipo_veiculo", "vehicle_type"]),
		"status": _grupo_rs_api_string_value(data, ["status", "Status", "situacao", "Situacao", "situacao_estoque", "status_estoque"]),
		"chip": _grupo_rs_api_string_value(data, ["chip", "Chip", "numero_chip", "NumeroChip", "iccid", "ICCID"]),
		"phone": _grupo_rs_api_string_value(data, ["telefone", "Telefone", "phone", "numero_telefone", "NumeroTelefone"]),
		"operator": _grupo_rs_api_string_value(data, ["operadora", "Operadora", "operator", "carrier"]),
		"apn": _grupo_rs_api_string_value(data, ["apn", "APN"]),
		# As coordenadas sao extraidas do retorno oficial da API; o decoder
		# somente interpreta os campos do payload recebido.
		"lat": decoded_lat,
		"lng": decoded_lng,
		"address": _grupo_rs_api_string_value(data, ["endereco", "address", "Endereco"]),
		"updated_at": _grupo_rs_api_string_value(data, ["ultima_comunicacao", "ultimaComunicacao", "updated_at", "data_comunicacao", "DataComunicacao", "data", "DataEvento", "timestamp"]),
		"communication_at": _grupo_rs_api_string_value(data, ["ultima_comunicacao", "ultimaComunicacao", "data_comunicacao", "DataComunicacao", "updated_at"]),
		"event_at": _grupo_rs_api_string_value(data, ["data_evento", "dataEvento", "DataEvento", "event_at", "event_time"]),
		"ignition": _grupo_rs_api_string_value(data, ["ignicao", "Ignicao", "StatusIgnicao", "status_ignicao", "ignition", "Ignition", "ignicao_status", "ignition_status"]),
		"speed": _grupo_rs_api_string_value(data, ["velocidade", "speed", "Velocidade"]),
		# A API usa `bateria` como tensao (ex.: 12 V) e pode expor o percentual
		# separado em `bateriaInterna`. Nunca misturar os dois valores.
		"battery": _grupo_rs_api_string_value(data, ["bateria", "battery", "Bateria", "tensao_bateria", "tensaoBateria", "voltagem", "voltage"]),
		"battery_voltage": _grupo_rs_api_string_value(data, ["tensao_bateria", "tensaoBateria", "voltagem", "voltage", "bateria", "battery", "Bateria"]),
		"gps_signal": _grupo_rs_api_string_value(data, ["sinal_gps", "SinalGPS", "gps_signal", "gpsSignal", "signal_gps"]),
		"odometer": _grupo_rs_api_string_value(data, ["hodometro", "Hodometro", "odometro", "odometer", "Odometer"]),
		"heading": _grupo_rs_api_string_value(data, ["direcao", "Direcao", "heading", "Heading"]),
		"event_type": _grupo_rs_api_string_value(data, ["tipo_evento", "TipoEvento", "event_type", "eventType"]),
		"monitoring_status": _grupo_rs_api_string_value(data, ["status_monitoramento", "StatusMonitoramento", "monitoring_status", "status", "Status"]),
		"source": "API oficial",
	}


func _grupo_rs_api_page_path(path: String, skip: int, take: int = GRUPO_RS_API_PAGE_SIZE) -> String:
	var separator := "&" if path.contains("?") else "?"
	return "%s%sskip=%d&take=%d" % [path, separator, max(skip, 0), clamp(take, 1, GRUPO_RS_API_PAGE_SIZE)]


func _grupo_rs_api_pagination_state(payload: Variant, current_skip: int, row_count: int) -> Dictionary:
	var pagination: Dictionary = {}
	if typeof(payload) == TYPE_DICTIONARY:
		var root := payload as Dictionary
		for key in ["paginacao", "pagination", "pageInfo", "meta"]:
			if typeof(root.get(key)) == TYPE_DICTIONARY:
				pagination = (root.get(key) as Dictionary).duplicate(true)
				break
		if pagination.is_empty() and typeof(root.get("data")) == TYPE_DICTIONARY:
			var nested_root := root.get("data") as Dictionary
			for key in ["paginacao", "pagination", "pageInfo", "meta"]:
				if typeof(nested_root.get(key)) == TYPE_DICTIONARY:
					pagination = (nested_root.get(key) as Dictionary).duplicate(true)
					break

	var has_more := false
	var has_metadata := not pagination.is_empty()
	if has_metadata:
		var raw_more: Variant = null
		for key in ["temMais", "tem_mais", "hasMore", "has_more", "next"]:
			if pagination.has(key):
				raw_more = pagination.get(key)
				break
		if typeof(raw_more) == TYPE_BOOL:
			has_more = bool(raw_more)
		elif raw_more != null:
			has_more = str(raw_more).strip_edges().to_lower() in ["1", "true", "sim", "yes"]

	var next_skip: int = current_skip + max(row_count, GRUPO_RS_API_PAGE_SIZE)
	if has_metadata:
		for key in ["proximoSkip", "proximo_skip", "nextSkip", "next_skip"]:
			if pagination.has(key):
				next_skip = str(pagination.get(key, "")).to_int()
				break
	if has_more and next_skip <= current_skip:
		next_skip = current_skip + max(row_count, GRUPO_RS_API_PAGE_SIZE)
	if not has_metadata and row_count < GRUPO_RS_API_PAGE_SIZE:
		has_more = false
	return {"has_more": has_more, "next_skip": next_skip, "pagination": pagination}


func _grupo_rs_api_fetch_all_pages(path: String, force_read: bool = false) -> Dictionary:
	var rows: Array[Dictionary] = []
	var skip := 0
	var pages := 0
	var visited_skips: Dictionary = {}
	var previous_page_signature := ""
	var scan_deadline := Time.get_ticks_msec() + (GRUPO_RS_API_MAX_SCAN_SECONDS * 1000)
	while pages < GRUPO_RS_API_MAX_PAGES:
		if Time.get_ticks_msec() >= scan_deadline:
			var timeout_error := "A API excedeu o limite de %ds para a varredura paginada." % GRUPO_RS_API_MAX_SCAN_SECONDS
			grupo_rs_api_last_failure_at = int(Time.get_unix_time_from_system())
			grupo_rs_api_last_error = timeout_error
			return {"ok": false, "message": timeout_error, "timeout": true}
		if visited_skips.has(skip):
			var loop_error := "A API repetiu a mesma pagina; consulta interrompida para evitar loop."
			grupo_rs_api_last_failure_at = int(Time.get_unix_time_from_system())
			grupo_rs_api_last_error = loop_error
			return {"ok": false, "message": loop_error}
		visited_skips[skip] = true
		var response := await _grupo_rs_api_get(_grupo_rs_api_page_path(path, skip), true, force_read)
		if not bool(response.get("ok", false)):
			grupo_rs_api_last_failure_at = int(Time.get_unix_time_from_system())
			grupo_rs_api_last_error = str(response.get("message", "A API nao respondeu."))
			return response
		var payload: Variant = JSON.parse_string(str(response.get("body", "")))
		if payload == null:
			var parse_error := "A API retornou JSON invalido na pagina %d." % (pages + 1)
			grupo_rs_api_last_failure_at = int(Time.get_unix_time_from_system())
			grupo_rs_api_last_error = parse_error
			return {"ok": false, "message": parse_error}
		var page_rows := _grupo_rs_api_extract_rows(payload)
		var signature_parts: Array[String] = []
		for row in page_rows:
			var row_key := _grupo_rs_api_string_value(row, [
				"codVeiculo", "CodVeiculo", "veiculo_id", "vehicle_id", "codEquipamento", "CodEquipamento", "equipment_id", "numeroSerie", "numeroSerieEquipamento", "placa", "plate"
			])
			if row_key != "":
				signature_parts.append(row_key)
		var page_signature := "|".join(signature_parts)
		if page_signature != "" and page_signature == previous_page_signature:
			var repeated_page_error := "A API repetiu o conteudo da pagina; consulta interrompida para evitar loop."
			grupo_rs_api_last_failure_at = int(Time.get_unix_time_from_system())
			grupo_rs_api_last_error = repeated_page_error
			return {"ok": false, "message": repeated_page_error, "repeated_page": true}
		previous_page_signature = page_signature
		for row in page_rows:
			rows.append(row)
		pages += 1
		var page_state := _grupo_rs_api_pagination_state(payload, skip, page_rows.size())
		if not bool(page_state.get("has_more", false)) or page_rows.is_empty():
			break
		skip = int(page_state.get("next_skip", skip + GRUPO_RS_API_PAGE_SIZE))
		await get_tree().process_frame
	if pages >= GRUPO_RS_API_MAX_PAGES:
		var limit_error := "A API excedeu o limite de paginas sem finalizar a consulta."
		grupo_rs_api_last_failure_at = int(Time.get_unix_time_from_system())
		grupo_rs_api_last_error = limit_error
		return {"ok": false, "message": limit_error}
	return {"ok": true, "rows": rows, "pages": pages}


func _grupo_rs_api_fetch_locations(force_read: bool = false) -> Dictionary:
	var now := int(Time.get_unix_time_from_system())
	if not force_read and grupo_rs_api_location_cache_checked_at > 0 and now - grupo_rs_api_location_cache_checked_at < GRUPO_RS_API_LOCATION_CACHE_SECONDS:
		return {"ok": true, "rows": grupo_rs_api_location_cache, "cached": true}
	if not force_read and grupo_rs_api_last_failure_at > 0 and now - grupo_rs_api_last_failure_at < GRUPO_RS_API_FAILURE_COOLDOWN_SECONDS:
		return {"ok": false, "message": grupo_rs_api_last_error}
	var response := await _grupo_rs_api_fetch_all_pages("/endpoints/localizacao.php", force_read)
	if not bool(response.get("ok", false)):
		return response
	var normalized: Array[Dictionary] = []
	for raw in response.get("rows", []) as Array:
		normalized.append(_grupo_rs_api_normalize_location(raw))
	grupo_rs_api_location_cache = normalized
	grupo_rs_api_location_cache_checked_at = int(Time.get_unix_time_from_system())
	grupo_rs_api_last_failure_at = 0
	grupo_rs_api_last_error = ""
	return {"ok": true, "rows": normalized, "pages": response.get("pages", 0), "cached": false}


func _grupo_rs_api_fetch_vehicles(force_read: bool = false) -> Dictionary:
	var now := int(Time.get_unix_time_from_system())
	if not force_read and grupo_rs_api_vehicle_cache_checked_at > 0 and now - grupo_rs_api_vehicle_cache_checked_at < GRUPO_RS_API_VEHICLE_CACHE_SECONDS:
		return {"ok": true, "rows": grupo_rs_api_vehicle_cache, "cached": true}
	var response := await _grupo_rs_api_fetch_all_pages("/endpoints/veiculos.php", force_read)
	if not bool(response.get("ok", false)):
		return response
	var normalized: Array[Dictionary] = []
	for raw in response.get("rows", []) as Array:
		normalized.append(_grupo_rs_api_normalize_location(raw))
	grupo_rs_api_vehicle_cache = normalized
	grupo_rs_api_vehicle_cache_checked_at = int(Time.get_unix_time_from_system())
	grupo_rs_api_last_failure_at = 0
	grupo_rs_api_last_error = ""
	return {"ok": true, "rows": normalized, "pages": response.get("pages", 0), "cached": false}


func _grupo_rs_api_find_vehicle_id(plate: String, serial: String = "") -> String:
	var result := await _grupo_rs_api_fetch_vehicles()
	if not bool(result.get("ok", false)):
		return ""
	var serial_key := _search_key(serial)
	var plate_key := _normalize_location_plate(plate)
	for row in result.get("rows", []) as Array:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var vehicle: Dictionary = row as Dictionary
		var matches_serial := serial_key != "" and _search_key(str(vehicle.get("serial", ""))) == serial_key
		var matches_plate := plate_key != "" and _normalize_location_plate(str(vehicle.get("plate", ""))) == plate_key
		if matches_serial or matches_plate:
			return str(vehicle.get("vehicle_id", "")).strip_edges()
	return ""


func _grupo_rs_api_invalidate_vehicle_cache() -> void:
	grupo_rs_api_vehicle_cache.clear()
	grupo_rs_api_vehicle_cache_checked_at = 0


func _grupo_rs_api_equipment_id_from_row(row: Dictionary, allow_generic_id: bool = false) -> int:
	var direct_keys: Array[String] = ["codEquipamento", "CodEquipamento", "codigoEquipamento", "equipamento_id", "equipment_id", "idEquipamento", "id_equipamento"]
	if allow_generic_id:
		direct_keys.append("id")
		direct_keys.append("codigo")
		direct_keys.append("code")
	var direct := _grupo_rs_api_numeric_string_value(row, direct_keys)
	if direct.is_valid_int():
		return int(direct)
	for key in ["equipamento", "equipment", "tracker"]:
		var nested: Variant = row.get(key)
		if typeof(nested) != TYPE_DICTIONARY:
			continue
		var nested_id := _grupo_rs_api_numeric_string_value(nested as Dictionary, ["codEquipamento", "CodEquipamento", "id", "codigo", "code"])
		if nested_id.is_valid_int():
			return int(nested_id)
	return 0


func _grupo_rs_api_serial_from_row(data: Dictionary) -> String:
	var direct := _grupo_rs_api_string_value(data, ["serial", "numero_serie", "numeroSerie", "numeroSerieEquipamento", "imei", "IMEI"])
	if direct != "":
		return direct
	for key in ["equipamento", "equipment", "tracker"]:
		var nested: Variant = data.get(key)
		if typeof(nested) != TYPE_DICTIONARY:
			continue
		var nested_serial := _grupo_rs_api_string_value(nested as Dictionary, ["numeroSerie", "numero_serie", "numeroSerieEquipamento", "numeroEquipamento", "numero_equipamento", "imei", "IMEI"])
		if nested_serial != "":
			return nested_serial
	return ""


func _grupo_rs_api_find_vehicle(plate: String = "", serial: String = "", force_read: bool = true, allow_full_scan: bool = true) -> Dictionary:
	# The API indexes the formatted plate in this endpoint. Keep the compact
	# form only as a controlled fallback for older records/implementations.
	var clean_plate := _normalize_location_plate(plate)
	var clean_serial := _digits_only(serial)
	if clean_plate == "" and clean_serial == "":
		return {"ok": false, "message": "Informe uma placa ou serie para consultar a placa pela API."}

	var normalized: Array[Dictionary] = []
	var query_candidates: Array[String] = []
	if plate.strip_edges() != "":
		var display_plate := plate.strip_edges()
		query_candidates.append(display_plate)
		if clean_plate != display_plate:
			query_candidates.append(clean_plate)
	else:
		query_candidates.append(clean_serial)
	var last_response: Dictionary = {}
	for query in query_candidates:
		var response := await _grupo_rs_api_get(
			"/endpoints/veiculos.php?q=%s&skip=0&take=50" % query.uri_encode(),
			true,
			force_read
		)
		last_response = response
		if not bool(response.get("ok", false)):
			var response_code := int(response.get("response_code", 0))
			return {
				"ok": false,
				"message": _grupo_rs_api_error_message(response, "A API nao permitiu consultar o veiculo."),
				"response_code": response_code,
				"not_found": response_code == 404,
			}
		var payload: Variant = JSON.parse_string(str(response.get("body", "")))
		for raw in _grupo_rs_api_extract_rows(payload):
			normalized.append(_grupo_rs_api_normalize_location(raw))
		if not normalized.is_empty():
			break

	# A documentacao indexa q por placa/modelo. Se a busca por serie nao trouxer
	# linhas, usa a listagem paginada para localizar a associacao exata.
	if normalized.is_empty() and clean_serial != "" and allow_full_scan:
		var all_rows := await _grupo_rs_api_fetch_vehicles(force_read)
		if bool(all_rows.get("ok", false)):
			normalized = all_rows.get("rows", []) as Array[Dictionary]

	var plate_key := _normalize_location_plate(clean_plate)
	var serial_key := _search_key(clean_serial)
	var matches: Array[Dictionary] = []
	for vehicle in normalized:
		var vehicle_plate := _normalize_location_plate(str(vehicle.get("plate", "")))
		var vehicle_serial := _search_key(str(vehicle.get("serial", "")))
		var plate_matches := plate_key != "" and vehicle_plate == plate_key
		var serial_matches := serial_key != "" and vehicle_serial == serial_key
		if (clean_plate != "" and clean_serial != "" and plate_matches and (serial_matches or vehicle_serial == "")) \
				or (clean_plate != "" and clean_serial == "" and plate_matches) \
				or (clean_plate == "" and serial_key != "" and serial_matches):
			matches.append(vehicle)
	if matches.size() != 1:
		return {
			"ok": false,
			"message": "A API retornou %d veiculo(s); a associacao nao foi identificada de forma unica." % matches.size(),
			"rows": matches,
			"not_found": matches.is_empty(),
			"response_code": int(last_response.get("response_code", 0)),
		}
	var result: Dictionary = matches[0]
	return {"ok": true, "row": result, "rows": matches}


func _grupo_rs_api_wait_for_vehicle(plate: String, serial: String = "") -> Dictionary:
	# A confirmacao de uma escrita deve consultar somente a placa criada/editada.
	# Se a API ainda nao propagou a linha, nao fazemos varredura paginada por serie.
	var result := await _grupo_rs_api_find_vehicle(plate, serial, true, false)
	if bool(result.get("ok", false)):
		return result
	if not bool(result.get("not_found", false)):
		return result
	result["message"] = "A API aceitou a placa, mas ainda nao publicou o vinculo para a consulta unica de confirmacao."
	result["confirmation_pending"] = true
	return result


func _grupo_rs_api_vehicle_status_code(value: String) -> String:
	return "I" if _search_key(value) in ["i", "inativo", "inactive"] else "A"


func _grupo_rs_api_vehicle_type_id(request: Dictionary) -> int:
	var requested_id := int(request.get("api_vehicle_type_id", request.get("codTipoVeiculo", 0)))
	if requested_id > 0:
		return requested_id
	match _search_key(str(request.get("vehicle_type", request.get("tipoVeiculo", "")))):
		"carro":
			return 1
		"moto":
			return 2
	return 0


func _grupo_rs_api_resolve_rs300_client_id() -> Dictionary:
	# O titular nao pode ser inferido do usuario autenticado: a API pode usar
	# esse usuario como cliente padrao quando codCliente nao e enviado. Resolva
	# o codigo real do cadastro RS300 antes de qualquer POST de veiculo.
	var client_id := await _fetch_grupo_rs_client_id("RS300")
	if client_id != "" and client_id.is_valid_int() and int(client_id) > 0:
		return {"ok": true, "client_id": client_id, "source": "client_lookup"}

	# Algumas bases nao expoem o select2 para o usuario da API, mas o mesmo
	# codigo fica disponivel no formulario autenticado do portal. Isto e apenas
	# uma leitura de catalogo; a gravacao continua sendo feita pela API.
	var page := await _modern_grupo_rs_get("veiculos_editar.php?acao=novo")
	if bool(page.get("ok", false)):
		var form_html := _extract_html_form_by_action(str(page.get("body", "")), "veiculos_actions.php")
		if form_html == "":
			form_html = _extract_html_form_by_action(str(page.get("body", "")), "veiculos_action.php")
		client_id = _html_select_option_value_by_label(form_html, "CodCliente", "RS300")
		if client_id != "" and client_id.is_valid_int() and int(client_id) > 0:
			return {"ok": true, "client_id": client_id, "source": "portal_catalog"}

	return {
		"ok": false,
		"message": "Nao foi possivel resolver o codigo do titular RS300; cadastro bloqueado para evitar cliente incorreto.",
	}


func _grupo_rs_api_vehicle_payload(request: Dictionary, existing: Dictionary = {}, plate_override: String = "", equipment_id: int = -1) -> Dictionary:
	var requested_plate := plate_override if plate_override.strip_edges() != "" else str(request.get("plate", existing.get("plate", "")))
	# A API aceita os dois formatos. Nas modificacoes do fluxo unificado,
	# preservamos o formato de exibicao para nao transformar AAA - 016 em AAA016.
	var plate := _format_grupo_rs_vehicle_plate_for_display(requested_plate) if bool(request.get("api_display_plate", false)) else _normalize_location_plate(requested_plate)
	if plate == "":
		return {}
	var payload: Dictionary = {"placa": plate}
	var requested_model := str(request.get("vehicle_model", "")).strip_edges()
	var has_copy_fields := request.has("copy_vehicle_fields")
	if requested_model == "" and has_copy_fields:
		var copied: Dictionary = request.get("copy_vehicle_fields", {}) as Dictionary
		requested_model = str(copied.get("modelo", copied.get("model", ""))).strip_edges()
	if requested_model != "" or has_copy_fields:
		payload["modelo"] = requested_model
	var requested_year := str(request.get("vehicle_year", "")).strip_edges()
	if requested_year == "" and has_copy_fields:
		var copied_year: Dictionary = request.get("copy_vehicle_fields", {}) as Dictionary
		requested_year = str(copied_year.get("ano", copied_year.get("year", ""))).strip_edges()
	if requested_year != "":
		payload["ano"] = int(requested_year) if requested_year.is_valid_int() else requested_year
	elif has_copy_fields:
		payload["ano"] = ""
	# O endpoint de veiculos aceita os demais dados cadastrais no mesmo PATCH.
	# Enviar os campos digitados no formulario evita perder marca, cor ou chassi
	# durante o cadastro/reentrada.
	var direct_map := {"marca": "vehicle_brand", "cor": "vehicle_color", "chassi": "vehicle_chassis", "observacao": "vehicle_observation"}
	for remote_field in direct_map.keys():
		var direct_value := str(request.get(direct_map[remote_field], "")).strip_edges()
		if direct_value != "":
			payload[remote_field] = direct_value
	# Quando ha um espelho de campos, enviar o espelho completo evita que a troca
	# deixe marca, cor ou chassi antigos no aparelho que recebeu a placa cliente.
	if has_copy_fields:
		var copied_fields: Dictionary = request.get("copy_vehicle_fields", {}) as Dictionary
		var copy_map := {
			"marca": ["marca", "brand"],
			"cor": ["cor", "color"],
			"chassi": ["chassi", "chassis"],
			"dataCompra": ["dataCompra", "purchase_date"],
			"observacao": ["observacao", "observation"],
		}
		for remote_field in copy_map.keys():
			var aliases: Array = copy_map[remote_field]
			var copied_value := ""
			for alias in aliases:
				if copied_fields.has(alias):
					copied_value = str(copied_fields.get(alias, "")).strip_edges()
					break
			# Em troca, vazio tambem e um valor importante: ele limpa no
			# destino um dado que pertencia ao veiculo antigo.
			payload[str(remote_field)] = copied_value
	var vehicle_type_id := _grupo_rs_api_vehicle_type_id(request)
	if vehicle_type_id > 0:
		payload["codTipoVeiculo"] = vehicle_type_id
	if bool(request.get("clear_vehicle_fields", false)):
		for field_name in ["modelo", "marca", "ano", "cor", "chassi", "dataCompra", "observacao"]:
			payload[field_name] = ""
	var status_value := str(request.get("api_vehicle_status", existing.get("status", "A"))).strip_edges()
	payload["status"] = _grupo_rs_api_vehicle_status_code(status_value)
	var resolved_equipment_id := equipment_id
	var requested_equipment_id := str(request.get("target_equipment_id", "")).strip_edges()
	if requested_equipment_id.is_valid_int() and int(requested_equipment_id) >= 0:
		resolved_equipment_id = int(requested_equipment_id)
	if resolved_equipment_id < 0:
		resolved_equipment_id = _grupo_rs_api_equipment_id_from_row(existing)
	if resolved_equipment_id >= 0:
		payload["codEquipamento"] = resolved_equipment_id
	# Somente o cadastro automatico marca explicitamente o titular. A edicao
	# normal nao envia codCliente e, portanto, preserva o cliente ja existente.
	if bool(request.get("force_rs300_titular", false)):
		var client_id := str(request.get("api_client_id", "")).strip_edges()
		if client_id.is_valid_int() and int(client_id) > 0:
			payload["codCliente"] = int(client_id)
	return payload


func _grupo_rs_api_register_vehicle(request: Dictionary, equipment_row: Dictionary) -> Dictionary:
	var plate := _normalize_location_plate(str(request.get("plate", "")))
	if plate == "":
		return {"ok": false, "message": "Placa ausente para cadastrar o veiculo pela API."}
	# A resposta de equipamentos pode usar `id`; a resposta de veiculos tambem
	# usa `id` para o veiculo, por isso esta permissao fica restrita a este ponto.
	var equipment_id := _grupo_rs_api_equipment_id_from_row(equipment_row, true)
	if equipment_id <= 0:
		return {"ok": false, "fallback_web": true, "message": "A API confirmou o equipamento, mas nao retornou o codigo para associa-lo ao veiculo."}
	var existing := await _grupo_rs_api_find_vehicle(plate, "", true)
	if bool(existing.get("ok", false)):
		var current := existing.get("row", {}) as Dictionary
		var current_equipment := str(current.get("equipment_id", "")).strip_edges()
		if current_equipment == str(equipment_id) or _search_key(str(current.get("serial", ""))) == _search_key(str(request.get("serial", ""))):
			return {"ok": true, "existing": true, "row": current, "api": true}
		return {"ok": false, "message": "A placa %s ja esta associada a outro equipamento." % plate, "response_code": 409}
	# A API responde HTTP 200 com zero linhas quando a placa ainda nao existe.
	# Isso e um "nao encontrado" valido, nao uma falha de consulta; bloquear
	# aqui impedia o POST e deixava o fluxo cair em uma espera/fallback sem fim.
	if not bool(existing.get("not_found", false)) and int(existing.get("response_code", 0)) not in [0, 404]:
		var lookup_code := int(existing.get("response_code", 0))
		return {"ok": false, "fallback_web": lookup_code in [403, 405, 500, 501], "message": str(existing.get("message", "Nao foi possivel consultar a placa antes do cadastro.")), "response_code": lookup_code}
	if not bool(existing.get("not_found", false)):
		return {
			"ok": false,
			"fallback_web": false,
			"message": str(existing.get("message", "A consulta da placa falhou; o cadastro foi bloqueado para evitar associacao duplicada.")),
			"response_code": existing.get("response_code", 0),
		}
	var registration_request := request.duplicate(true)
	registration_request["force_rs300_titular"] = true
	registration_request["api_display_plate"] = true
	var has_vehicle_metadata := false
	for metadata_key in ["vehicle_model", "vehicle_brand", "vehicle_year", "vehicle_color", "vehicle_chassis", "vehicle_observation"]:
		if str(registration_request.get(metadata_key, "")).strip_edges() != "":
			has_vehicle_metadata = true
			break
	var requested_clear_fields := bool(request.get("clear_vehicle_fields", true)) if request.has("clear_vehicle_fields") else true
	registration_request["clear_vehicle_fields"] = requested_clear_fields or not has_vehicle_metadata
	# A tela de edicao nao possui um campo de tipo de veiculo. Quando o
	# aparelho ainda nao tem associacao, o fluxo precisa enviar explicitamente
	# o tipo exigido pela API; sem isso a rota pode rejeitar o POST e o processo
	# cai desnecessariamente no portal web.
	if str(registration_request.get("vehicle_type", "")).strip_edges() == "":
		registration_request["vehicle_type"] = "Carro"
	if int(registration_request.get("api_vehicle_type_id", registration_request.get("codTipoVeiculo", 0))) <= 0:
		registration_request["api_vehicle_type_id"] = 1
	var client_resolution := await _grupo_rs_api_resolve_rs300_client_id()
	if not bool(client_resolution.get("ok", false)):
		return {
			"ok": false,
			"fallback_web": true,
			"message": str(client_resolution.get("message", "Titular RS300 nao resolvido; usando o portal web.")),
		}
	registration_request["api_client_id"] = str(client_resolution.get("client_id", ""))
	var payload := _grupo_rs_api_vehicle_payload(registration_request, {}, plate, equipment_id)
	if not payload.has("codCliente"):
		return {"ok": false, "fallback_web": true, "message": "A API nao recebeu o codigo do titular RS300; cadastro bloqueado."}
	var response := await _grupo_rs_api_json_request("/endpoints/veiculos.php", HTTPClient.METHOD_POST, payload)
	if not bool(response.get("ok", false)) or _grupo_rs_api_response_has_explicit_failure(response):
		var code := int(response.get("response_code", 0))
		var failure_message := _grupo_rs_api_error_message(response, "A API recusou o cadastro da placa.")
		var normalized_failure := _search_key(failure_message)
		var association_conflict := code == 409 or (normalized_failure.contains("associado") and normalized_failure.contains("veiculo"))
		if association_conflict:
			# O equipamento pode ja estar ligado a outra placa. A criacao direta
			# nunca deve ser repetida nesse caso; localize a associacao pelo serial
			# e, somente se houver uma linha unica, converta a operacao em PATCH da
			# placa existente. Isso elimina o erro recorrente "equipamento ja esta
			# associado a outro veiculo" sem risco de escolher outra serie.
			# Em um conflito de associacao, consulte primeiro o indice direto do
			# serial. A varredura completa de veiculos aqui podia levar mais de 100 s
			# e mascarava a causa real (por exemplo, aparelho/placa inativos).
			var current_association := await _grupo_rs_api_find_vehicle("", str(request.get("serial", "")), true, false)
			if bool(current_association.get("ok", false)):
				var current_row := current_association.get("row", {}) as Dictionary
				var current_plate := _format_grupo_rs_vehicle_plate(str(current_row.get("plate", "")))
				if current_plate != "" and _normalize_location_plate(current_plate) != _normalize_location_plate(plate):
					var move_request := request.duplicate(true)
					move_request["remote_serial"] = str(request.get("serial", ""))
					move_request["force_rs300_titular"] = true
					move_request["api_display_plate"] = true
					move_request["clear_vehicle_fields"] = true
					if str(move_request.get("vehicle_type", "")).strip_edges() == "":
						move_request["vehicle_type"] = "Carro"
					if int(move_request.get("api_vehicle_type_id", move_request.get("codTipoVeiculo", 0))) <= 0:
						move_request["api_vehicle_type_id"] = 1
					var move_client := await _grupo_rs_api_resolve_rs300_client_id()
					if bool(move_client.get("ok", false)):
						move_request["api_client_id"] = str(move_client.get("client_id", ""))
						var moved := await _grupo_rs_api_update_vehicle(move_request, current_row, plate)
						if bool(moved.get("ok", false)):
							moved["reassigned_existing_vehicle"] = true
							moved["previous_plate"] = current_plate
							return moved
						if bool(moved.get("confirmation_pending", false)):
							return moved
		# A rota de veiculos pode devolver 500 depois de aceitar a transacao.
		# Confirme antes de mudar para o portal, evitando duplicidade ou perda do vinculo.
		if code == 500:
			var after_error := await _grupo_rs_api_find_vehicle(plate, str(request.get("serial", "")), true, false)
			if bool(after_error.get("ok", false)):
				var after_row := after_error.get("row", {}) as Dictionary
				var after_equipment := str(after_row.get("equipment_id", "")).strip_edges()
				var after_serial := _search_key(str(after_row.get("serial", "")))
				if after_equipment == str(equipment_id) or (after_serial != "" and after_serial == _search_key(str(request.get("serial", "")))):
					return {"ok": true, "existing": true, "row": after_row, "api": true, "warning": "A API devolveu 500, mas a associacao foi confirmada."}
				return {"ok": false, "message": "A API criou a placa, mas confirmou outro equipamento associado.", "response_code": 409}
			return {"ok": false, "partial": true, "confirmation_pending": true, "message": "%s; a operacao nao foi repetida para evitar duplicidade." % failure_message, "response_code": code}
		return {"ok": false, "fallback_web": code in [403, 404, 405, 501], "message": failure_message, "response_code": code}
	_grupo_rs_api_invalidate_vehicle_cache()
	# A resposta 2xx da rota de escrita ja e a confirmacao da operacao. Fazemos
	# somente uma leitura curta para enriquecer a linha; uma lista atrasada nao
	# deve reabrir o cadastro nem iniciar um ciclo de tentativas.
	var confirmed := await _grupo_rs_api_find_vehicle(plate, str(request.get("serial", "")), true, false)
	if bool(confirmed.get("ok", false)):
		var confirmed_row := confirmed.get("row", {}) as Dictionary
		var confirmed_equipment := str(confirmed_row.get("equipment_id", "")).strip_edges()
		var confirmed_serial := _search_key(str(confirmed_row.get("serial", "")))
		var requested_serial := _search_key(str(request.get("serial", "")))
		if confirmed_equipment == str(equipment_id) or (confirmed_serial != "" and confirmed_serial == requested_serial):
			return {"ok": true, "existing": false, "row": confirmed_row, "api": true, "response_code": int(response.get("response_code", 0))}
		return {"ok": false, "partial": true, "message": "A API criou a placa, mas a consulta confirmou outro equipamento associado."}
	# A API pode publicar a placa depois da leitura imediata. Como o POST ja
	# foi aceito, encerramos o fluxo com um registro minimo e deixamos a proxima
	# sincronizacao preencher os detalhes, sem polling ou timeout longo.
	return {
		"ok": true,
		"existing": false,
		"row": {"plate": plate, "serial": str(request.get("serial", "")), "equipment_id": str(equipment_id)},
		"api": true,
		"response_code": int(response.get("response_code", 0)),
		"accepted": true,
		"confirmation_pending": true,
		"warning": "A API aceitou a placa; a lista ainda pode levar alguns segundos para atualizar.",
	}


func _grupo_rs_api_update_vehicle(request: Dictionary, existing: Dictionary, new_plate: String) -> Dictionary:
	var vehicle_id := str(existing.get("vehicle_id", "")).strip_edges()
	if vehicle_id == "" or not vehicle_id.is_valid_int():
		return {"ok": false, "fallback_web": true, "message": "A API nao retornou o codigo do veiculo para edicao."}
	var payload := _grupo_rs_api_vehicle_payload(request, existing, new_plate, -1)
	if payload.is_empty():
		return {"ok": false, "message": "A nova placa e invalida."}
	var response := await _grupo_rs_api_json_request(
		"/endpoints/veiculos.php?id=%s" % vehicle_id,
		HTTPClient.METHOD_PATCH,
		payload
	)
	if not bool(response.get("ok", false)) or _grupo_rs_api_response_has_explicit_failure(response):
		var code := int(response.get("response_code", 0))
		if code == 500:
			# HTTP 500 e ambiguo: o PATCH pode ter sido aplicado antes de a
			# resposta ser encerrada. Confirme uma vez e nao repita por outro canal.
			var after_error := await _grupo_rs_api_find_vehicle(new_plate, str(request.get("remote_serial", request.get("serial", ""))), true, false)
			if bool(after_error.get("ok", false)):
				var after_error_row := after_error.get("row", {}) as Dictionary
				return {
					"ok": true,
					"api": true,
					"row": after_error_row,
					"ambiguous": true,
					"warning": "A API devolveu 500, mas a nova placa foi confirmada.",
				}
			return {"ok": false, "partial": true, "confirmation_pending": true, "message": "A API devolveu HTTP 500 e a nova placa ainda nao foi confirmada. A operacao nao foi repetida para evitar duplicidade."}
		return {"ok": false, "fallback_web": code in [403, 404, 405, 501], "message": _grupo_rs_api_error_message(response, "A API recusou a alteracao da placa."), "response_code": code}
	_grupo_rs_api_invalidate_vehicle_cache()
	var confirmed := await _grupo_rs_api_wait_for_vehicle(new_plate, str(request.get("remote_serial", request.get("serial", ""))))
	if bool(confirmed.get("ok", false)):
		var confirmed_row := confirmed.get("row", {}) as Dictionary
		var requested_serial := _search_key(str(request.get("remote_serial", request.get("serial", ""))))
		var confirmed_serial := _search_key(str(confirmed_row.get("serial", "")))
		if requested_serial == "" or confirmed_serial == "" or requested_serial == confirmed_serial:
			return {
				"ok": true,
				"api": true,
				"row": confirmed_row,
				"response_code": int(response.get("response_code", 0)),
				"policy_verified": _grupo_rs_api_reassignment_row_is_complete(confirmed_row, new_plate),
			}
		return {"ok": false, "partial": true, "message": "A API confirmou a nova placa, mas ela retornou outro equipamento."}
	return {"ok": false, "partial": true, "confirmation_pending": true, "message": "A API aceitou a alteracao, mas nao confirmou a nova placa na consulta seguinte.", "response_code": int(confirmed.get("response_code", response.get("response_code", 0)))}


func _grupo_rs_api_reassignment_row_is_complete(row: Dictionary, target_plate: String, clear_vehicle_fields: bool = true) -> bool:
	# A API pode confirmar placa/equipamento sem devolver os campos do cadastro.
	# Nesse caso, a operacao ainda nao esta completa: o formulario web precisa
	# aplicar RS300, Carro e limpar os dados do veiculo.
	if row.is_empty():
		return false
	if _normalize_location_plate(str(row.get("plate", ""))) != _normalize_location_plate(target_plate):
		return false
	# A resposta da API somente e suficiente quando devolve os campos da ficha
	# veicular. Marcadores criados localmente nao podem substituir a leitura real.
	var client := _grupo_rs_api_string_value(row, ["cliente", "client", "Cliente", "nomeCliente", "clienteTitular", "cliente_titular"])
	var vehicle_type := _grupo_rs_api_string_value(row, ["tipoVeiculo", "TipoVeiculo", "tipo_veiculo", "vehicle_type", "tipo", "type"])
	if client == "" or _search_key(client) != _search_key("RS300"):
		return false
	if vehicle_type == "" or _search_key(vehicle_type) != _search_key("Carro"):
		return false
	if not clear_vehicle_fields:
		return true
	for key in ["modelo", "Modelo", "model", "Model", "marca", "Marca", "brand", "Brand", "ano", "Ano", "year", "Year", "cor", "Cor", "color", "Color", "chassi", "Chassi", "chassis", "Chassis", "observacao", "Observacao", "observacoes", "observations"]:
		if row.has(key) and str(row.get(key, "")).strip_edges() != "":
			return false
	return true


func _grupo_rs_api_find_location(serial: String, plate: String, vehicle_id: String = "", allow_full_scan: bool = true) -> Dictionary:
	# The official endpoint supports q filtering. Prefer the narrow query so a
	# plate lookup never depends on the first page of the global location list.
	var query := plate.strip_edges()
	if query == "":
		query = serial.strip_edges()
	if query != "":
		var direct_response := await _grupo_rs_api_get(
			"/endpoints/localizacao.php?q=%s&skip=0&take=%d" % [query.uri_encode(), GRUPO_RS_API_PAGE_SIZE],
			true,
			true
		)
		if not bool(direct_response.get("ok", false)):
			return direct_response
		var direct_payload: Variant = JSON.parse_string(str(direct_response.get("body", "")))
		if direct_payload == null:
			return {"ok": false, "message": "A API retornou JSON invalido para a localizacao consultada."}
		var direct_rows: Array[Dictionary] = []
		for raw in _grupo_rs_api_extract_rows(direct_payload):
			direct_rows.append(_grupo_rs_api_normalize_location(raw))
		var requested_vehicle_id := _search_key(vehicle_id)
		var requested_serial := _search_key(serial)
		var requested_plate := _normalize_location_plate(plate)
		for location in direct_rows:
			var matches_vehicle := requested_vehicle_id != "" and _search_key(str(location.get("vehicle_id", ""))) == requested_vehicle_id
			var matches_serial := requested_serial != "" and _search_key(str(location.get("serial", ""))) == requested_serial
			var matches_plate := requested_plate != "" and _normalize_location_plate(str(location.get("plate", ""))) == requested_plate
			if matches_vehicle or matches_serial or matches_plate:
				return {"ok": true, "location": location, "direct": true}
		if direct_rows.is_empty():
			return {"ok": false, "message": "API Grupo RS nao localizou o veiculo consultado."}
		if not allow_full_scan:
			return {"ok": false, "message": "A API nao confirmou a localizacao pela consulta direta.", "not_found": true}

	# Fallback for older API deployments that do not implement q filtering.
	var result := await _grupo_rs_api_fetch_locations(true)
	if not bool(result.get("ok", false)):
		return result
	var serial_key := _search_key(serial)
	var plate_key := _normalize_location_plate(plate)
	var vehicle_key := _search_key(vehicle_id)
	for row in result.get("rows", []) as Array:
		if typeof(row) != TYPE_DICTIONARY:
			continue
		var location: Dictionary = row as Dictionary
		if vehicle_key != "" and _search_key(str(location.get("vehicle_id", ""))) == vehicle_key:
			return {"ok": true, "location": location}
		if serial_key != "" and _search_key(str(location.get("serial", ""))) == serial_key:
			return {"ok": true, "location": location}
		if plate_key != "" and _normalize_location_plate(str(location.get("plate", ""))) == plate_key:
			return {"ok": true, "location": location}
	return {"ok": false, "message": "API Grupo RS nao localizou o veiculo consultado."}


func _grupo_rs_api_latest_event(vehicle_id: String, reference_datetime: String) -> Dictionary:
	var clean_id := vehicle_id.strip_edges()
	if clean_id == "":
		return {"ok": false, "message": "Codigo do veiculo nao informado para a API."}
	var reference_unix := _grupo_rs_datetime_to_unix(reference_datetime)
	if reference_unix <= 0:
		reference_unix = _local_now_to_unix_like()
	var start_text := _format_grupo_rs_api_records_datetime(reference_unix - SMART_4G_RECORD_LOOKBACK_SECONDS)
	var end_text := _format_grupo_rs_api_records_datetime(reference_unix + SMART_4G_RECORD_FUTURE_SECONDS)
	var path := "/endpoints/v1/registros/listar.php?codVeiculo=%s&dataInicial=%s&dataFinal=%s&skip=0&take=%d" % [
		clean_id.uri_encode(),
		start_text.uri_encode(),
		end_text.uri_encode(),
		GRUPO_RS_API_PAGE_SIZE,
	]
	var response := await _grupo_rs_api_get(path)
	if not bool(response.get("ok", false)):
		return response
	var payload: Variant = JSON.parse_string(str(response.get("body", "")))
	var raw_rows := _grupo_rs_api_extract_rows(payload)
	if raw_rows.is_empty():
		return {"ok": false, "message": "API Grupo RS nao retornou registros na janela."}
	var newest: Dictionary = {}
	var newest_unix := -1
	for raw in raw_rows:
		var normalized := _grupo_rs_api_normalize_location(raw)
		var event := raw.duplicate(true)
		var updated_at := str(normalized.get("updated_at", "")).strip_edges()
		var ignition: Variant = normalized.get("ignition", "")
		var latitude := str(normalized.get("lat", ""))
		var longitude := str(normalized.get("lng", ""))
		if not event.has("data_comunicacao") and updated_at != "":
			event["data_comunicacao"] = updated_at
		if not event.has("data") and updated_at != "":
			event["data"] = updated_at
		if not event.has("ignicao") and str(ignition).strip_edges() != "":
			event["ignicao"] = ignition
		if not event.has("lat") and latitude != "":
			event["lat"] = latitude
		if not event.has("lng") and longitude != "":
			event["lng"] = longitude
		if not event.has("velocidade") and str(normalized.get("speed", "")).strip_edges() != "":
			event["velocidade"] = normalized.get("speed", "")
		if not event.has("bateria") and str(normalized.get("battery_voltage", normalized.get("battery", ""))).strip_edges() != "":
			event["bateria"] = normalized.get("battery_voltage", normalized.get("battery", ""))
		if not event.has("sinal_gps") and str(normalized.get("gps_signal", "")).strip_edges() != "":
			event["sinal_gps"] = normalized.get("gps_signal", "")
		if not event.has("hodometro") and str(normalized.get("odometer", "")).strip_edges() != "":
			event["hodometro"] = normalized.get("odometer", "")
		if not event.has("direcao") and str(normalized.get("heading", "")).strip_edges() != "":
			event["direcao"] = normalized.get("heading", "")
		if not event.has("tipo_evento") and str(normalized.get("event_type", "")).strip_edges() != "":
			event["tipo_evento"] = normalized.get("event_type", "")
		var event_unix := _grupo_rs_datetime_to_unix(updated_at)
		if newest.is_empty() or event_unix > newest_unix:
			newest = event
			newest_unix = event_unix
	if newest.is_empty():
		return {"ok": false, "message": "API Grupo RS retornou registros sem data valida."}
	return {"ok": true, "event": newest, "source": "grupo_rs_api"}


func _sync_legacy_credentials_from_modern(settings: Dictionary, username: String, password: String) -> Dictionary:
	var previous_modern_user := str(settings.get("grupo_rs_modern_user", "")).strip_edges()
	var previous_modern_password := str(settings.get("grupo_rs_modern_password", ""))
	var legacy_user := str(settings.get("grupo_rs_legacy_user", "")).strip_edges()
	var legacy_password := str(settings.get("grupo_rs_legacy_password", ""))
	var should_sync := legacy_user == "" \
		or legacy_password == "" \
		or (legacy_user == previous_modern_user and legacy_password == previous_modern_password)
	if should_sync:
		settings["grupo_rs_legacy_user"] = username.strip_edges()
		settings["grupo_rs_legacy_password"] = password
		settings["grupo_rs_legacy_saved_at"] = Time.get_datetime_string_from_system(false, true)
	if str(settings.get("grupo_rs_legacy_delete_base_url", "")).strip_edges() == "":
		settings["grupo_rs_legacy_delete_base_url"] = LEGACY_GRUPO_RS_DELETE_BASE_URL
	return settings


func _modern_grupo_rs_login() -> Dictionary:
	modern_grupo_rs_logged_in = false
	# Sempre inicia uma sessao limpa depois de uma conexao interrompida.
	modern_grupo_rs_cookies.clear()
	var credentials := _modern_grupo_rs_credentials()
	var username := str(credentials.get("username", "")).strip_edges()
	var password := str(credentials.get("password", ""))
	if username == "" or password == "":
		return {"ok": false, "message": "Configure login e senha do Grupo RS novo nas preferencias."}

	var login_url := _modern_grupo_rs_url("/login.php")
	var login_page := await _http_get_text_with_headers(login_url, _modern_grupo_rs_headers())
	_modern_update_cookies(login_page.get("headers", PackedStringArray()))
	if not bool(login_page.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel abrir login do sistema novo."}

	var fields := {
		"usuario": username,
		"senha": password,
	}
	var headers := _modern_grupo_rs_headers()
	headers.append("Referer: %s" % login_url)
	headers.append("Origin: %s" % _modern_grupo_rs_root_url())
	var response := await _http_post_form_with_headers(login_url, fields, headers, 0)
	_modern_update_cookies(response.get("headers", PackedStringArray()))
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": "Login do sistema novo falhou: %s" % str(response.get("message", ""))}
	if _modern_grupo_rs_page_is_login(str(response.get("body", ""))):
		return {"ok": false, "message": "Login do sistema novo recusado."}

	modern_grupo_rs_logged_in = true
	return {"ok": true}


func _modern_grupo_rs_get(path: String, retry_login: bool = true) -> Dictionary:
	if not modern_grupo_rs_logged_in:
		var login := await _modern_grupo_rs_login()
		if not bool(login.get("ok", false)):
			return login

	var response := await _http_get_text_with_headers(_modern_grupo_rs_url(path), _modern_grupo_rs_headers())
	_modern_update_cookies(response.get("headers", PackedStringArray()))
	if not bool(response.get("ok", false)) and retry_login:
		modern_grupo_rs_logged_in = false
		modern_grupo_rs_cookies.clear()
		var transport_login := await _modern_grupo_rs_login()
		if bool(transport_login.get("ok", false)):
			return await _modern_grupo_rs_get(path, false)
	if bool(response.get("ok", false)) and _modern_grupo_rs_page_is_login(str(response.get("body", ""))) and retry_login:
		modern_grupo_rs_logged_in = false
		return await _modern_grupo_rs_get(path, false)
	return response


func _modern_grupo_rs_read_get(path: String) -> Dictionary:
	# Algumas telas de consulta do portal novo respondem sem sessao; manter essa
	# leitura independente evita que uma credencial expirada esconda a telemetria.
	var public_headers := PackedStringArray(["User-Agent: GrupoRSCentral/1.0"])
	var public_response := await _http_get_text_with_headers(_modern_grupo_rs_url(path), public_headers)
	if bool(public_response.get("ok", false)) and not _modern_grupo_rs_page_is_login(str(public_response.get("body", ""))):
		return public_response

	if not modern_grupo_rs_logged_in:
		var login := await _modern_grupo_rs_login()
		if not bool(login.get("ok", false)):
			return login
	var session_response := await _modern_grupo_rs_get(path)
	if bool(session_response.get("ok", false)) and not _modern_grupo_rs_page_is_login(str(session_response.get("body", ""))):
		return session_response
	return public_response if bool(public_response.get("ok", false)) else session_response


func _modern_grupo_rs_post_form(path: String, fields: Dictionary, referer_path: String = "", retry_login: bool = true, max_redirects: int = 8) -> Dictionary:
	if not modern_grupo_rs_logged_in:
		var login := await _modern_grupo_rs_login()
		if not bool(login.get("ok", false)):
			return login

	var url := _modern_grupo_rs_url(path)
	var headers := _modern_grupo_rs_headers()
	headers.append("Referer: %s" % _modern_grupo_rs_url(referer_path if referer_path != "" else path))
	headers.append("Origin: %s" % _modern_grupo_rs_root_url())
	var response := await _http_post_form_with_headers(url, fields, headers, max_redirects)
	_modern_update_cookies(response.get("headers", PackedStringArray()))
	if bool(response.get("ok", false)) and _modern_grupo_rs_page_is_login(str(response.get("body", ""))) and retry_login:
		modern_grupo_rs_logged_in = false
		return await _modern_grupo_rs_post_form(path, fields, referer_path, false, max_redirects)
	return response


func _legacy_grupo_rs_headers() -> PackedStringArray:
	var headers := PackedStringArray([
		"User-Agent: GrupoRSCentral/1.0",
	])
	var root := _legacy_grupo_rs_root_url()
	var cookies: Dictionary = legacy_grupo_rs_cookies.get(root, {})
	var cookie_parts: Array[String] = []
	for key in cookies.keys():
		var value := str(cookies.get(key, "")).strip_edges()
		if value != "":
			cookie_parts.append("%s=%s" % [str(key), value])
	if not cookie_parts.is_empty():
		headers.append("Cookie: %s" % "; ".join(cookie_parts))
	return headers


func _legacy_grupo_rs_credentials() -> Dictionary:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var branch_id := selected_branch_id.strip_edges().to_lower()
	if branch_id in ["araguaina", "acailandia", "maraba"]:
		return _legacy_grupo_rs_credentials_for_branch(branch_id, settings)
	var username := OS.get_environment("GRUPO_RS_LEGACY_USER").strip_edges()
	var password := OS.get_environment("GRUPO_RS_LEGACY_PASSWORD")
	if username == "":
		username = str(settings.get("grupo_rs_legacy_user", "")).strip_edges()
	if password == "":
		password = str(settings.get("grupo_rs_legacy_password", ""))
	if username == "":
		username = DEFAULT_GRUPO_RS_MODERN_USER
	if password == "":
		password = DEFAULT_GRUPO_RS_MODERN_PASSWORD
	return {"username": username, "password": password}


func _legacy_update_cookies(headers: PackedStringArray) -> void:
	var root := _legacy_grupo_rs_root_url()
	if root == "":
		return
	var cookies: Dictionary = legacy_grupo_rs_cookies.get(root, {})
	for line in headers:
		var text_value := str(line)
		var separator := text_value.find(":")
		if separator <= 0:
			continue
		var name := text_value.substr(0, separator).strip_edges().to_lower()
		if name != "set-cookie":
			continue
		var cookie_text := text_value.substr(separator + 1).strip_edges()
		var first_part := cookie_text.split(";", false, 1)[0]
		var eq := first_part.find("=")
		if eq <= 0:
			continue
		cookies[first_part.substr(0, eq).strip_edges()] = first_part.substr(eq + 1).strip_edges()
	legacy_grupo_rs_cookies[root] = cookies


func _legacy_grupo_rs_page_is_login(html: String) -> bool:
	var lower := html.to_lower()
	return lower.contains("txtusuario") and lower.contains("txtsenha")


func _legacy_grupo_rs_login() -> Dictionary:
	var root := _legacy_grupo_rs_root_url()
	if root == "":
		return {"ok": false, "message": "URL da base antiga nao configurada."}
	var credentials := _legacy_grupo_rs_credentials()
	var username := str(credentials.get("username", "")).strip_edges()
	var password := str(credentials.get("password", ""))
	if username == "" or password == "":
		return {"ok": false, "message": "Configure login e senha das bases antigas nas preferencias."}

	legacy_grupo_rs_logged_in[root] = false
	var login_url := _legacy_grupo_rs_url("/Login/Login")
	var login_page := await _http_get_text_with_headers(login_url, _legacy_grupo_rs_headers())
	if not bool(login_page.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel abrir o login da base antiga."}
	_legacy_update_cookies(login_page.get("headers", PackedStringArray()))

	var html := str(login_page.get("body", ""))
	var fields := _legacy_hidden_form_fields(html)
	fields["__EVENTTARGET"] = "btnEntrar"
	fields["__EVENTARGUMENT"] = ""
	fields["txtUsuario"] = username
	fields["txtSenha"] = password
	fields["ckLembarSenha"] = "on"

	var headers := _legacy_grupo_rs_headers()
	headers.append("Referer: %s" % login_url)
	headers.append("Origin: %s" % root)
	var response := await _http_post_form_with_headers(login_url, fields, headers)
	_legacy_update_cookies(response.get("headers", PackedStringArray()))
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": "Login da base antiga falhou: %s" % str(response.get("message", ""))}
	if _legacy_grupo_rs_page_is_login(str(response.get("body", ""))):
		return {"ok": false, "message": "Login da base antiga recusado para %s." % username}

	legacy_grupo_rs_logged_in[root] = true
	return {"ok": true}


func _legacy_grupo_rs_get(path: String, retry_login: bool = true) -> Dictionary:
	var root := _legacy_grupo_rs_root_url()
	if root == "":
		return {"ok": false, "message": "URL da base antiga nao configurada."}
	if not bool(legacy_grupo_rs_logged_in.get(root, false)):
		var login := await _legacy_grupo_rs_login()
		if not bool(login.get("ok", false)):
			return login

	var response := await _http_get_text_with_headers(_legacy_grupo_rs_url(path), _legacy_grupo_rs_headers())
	_legacy_update_cookies(response.get("headers", PackedStringArray()))
	if bool(response.get("ok", false)) and _legacy_grupo_rs_page_is_login(str(response.get("body", ""))) and retry_login:
		legacy_grupo_rs_logged_in[root] = false
		return await _legacy_grupo_rs_get(path, false)
	return response


func _legacy_grupo_rs_postback(path: String, fields: Dictionary, retry_login: bool = true) -> Dictionary:
	var page := await _legacy_grupo_rs_get(path, retry_login)
	if not bool(page.get("ok", false)):
		return page
	var all_fields := _legacy_hidden_form_fields(str(page.get("body", "")))
	for key in fields.keys():
		all_fields[key] = fields[key]

	var headers := _legacy_grupo_rs_headers()
	headers.append("Referer: %s" % _legacy_grupo_rs_url(path))
	headers.append("Origin: %s" % _legacy_grupo_rs_root_url())
	var response := await _http_post_form_with_headers(_legacy_grupo_rs_url(path), all_fields, headers)
	_legacy_update_cookies(response.get("headers", PackedStringArray()))
	if bool(response.get("ok", false)) and _legacy_grupo_rs_page_is_login(str(response.get("body", ""))) and retry_login:
		legacy_grupo_rs_logged_in[_legacy_grupo_rs_root_url()] = false
		return await _legacy_grupo_rs_postback(path, fields, false)
	return response


func _legacy_hidden_form_fields(html: String) -> Dictionary:
	var fields := {}
	var regex := RegEx.new()
	if regex.compile("(?is)<input[^>]*>") != OK:
		return fields
	for match_result in regex.search_all(html):
		var tag := match_result.get_string(0)
		var field_type := _html_attr(tag, "type").to_lower()
		if field_type != "hidden":
			continue
		var name := _html_attr(tag, "name")
		if name == "":
			continue
		fields[name] = _decode_basic_html_entities(_html_attr(tag, "value"))
	return fields


func _legacy_form_fields(html: String) -> Dictionary:
	var fields := _legacy_hidden_form_fields(html)

	var input_regex := RegEx.new()
	if input_regex.compile("(?is)<input[^>]*>") == OK:
		for match_result in input_regex.search_all(html):
			var tag := match_result.get_string(0)
			var lower_tag := tag.to_lower()
			if lower_tag.contains("disabled"):
				continue
			var name := _html_attr(tag, "name")
			if name == "":
				continue
			var field_type := _html_attr(tag, "type").to_lower()
			if field_type in ["hidden", "submit", "button", "image", "file", "reset"]:
				continue
			if field_type in ["checkbox", "radio"] and not lower_tag.contains("checked"):
				continue
			fields[name] = _decode_basic_html_entities(_html_attr(tag, "value"))

	var select_regex := RegEx.new()
	if select_regex.compile("(?is)<select[^>]*>(.*?)</select>") == OK:
		for match_result in select_regex.search_all(html):
			var select_html := match_result.get_string(0)
			if select_html.to_lower().contains("disabled"):
				continue
			var name := _html_attr(select_html, "name")
			if name == "":
				continue
			var selected_value := _legacy_selected_option_value(select_html)
			if selected_value != "":
				fields[name] = selected_value

	var textarea_regex := RegEx.new()
	if textarea_regex.compile("(?is)<textarea[^>]*>(.*?)</textarea>") == OK:
		for match_result in textarea_regex.search_all(html):
			var tag := match_result.get_string(0)
			if tag.to_lower().contains("disabled"):
				continue
			var name := _html_attr(tag, "name")
			if name == "":
				continue
			fields[name] = _decode_basic_html_entities(match_result.get_string(1))

	return fields


func _legacy_selected_option_value(select_html: String) -> String:
	var option_regex := RegEx.new()
	if option_regex.compile("(?is)<option[^>]*>.*?</option>") != OK:
		return ""
	for match_result in option_regex.search_all(select_html):
		var option_tag := match_result.get_string(0)
		if not option_tag.to_lower().contains("selected"):
			continue
		return _decode_basic_html_entities(_html_attr(option_tag, "value"))
	return ""


func _html_attr(tag: String, attr_name: String) -> String:
	var pattern := "(?is)\\b%s\\s*=\\s*[\"']([^\"']*)[\"']" % attr_name
	var quoted_regex := RegEx.new()
	if quoted_regex.compile(pattern) == OK:
		var quoted_match := quoted_regex.search(tag)
		if quoted_match != null:
			return quoted_match.get_string(1)
	var unquoted_pattern := "(?is)\\b%s\\s*=\\s*([^\\s>]+)" % attr_name
	return _regex_first_group(tag, unquoted_pattern)


func _http_post_json_with_headers(url: String, value: Variant, headers: PackedStringArray, timeout_seconds: float = 15.0) -> Dictionary:
	return await _http_json_request_with_headers(url, HTTPClient.METHOD_POST, value, headers, timeout_seconds)


func _http_json_request_with_headers(url: String, method: int, value: Variant, headers: PackedStringArray, timeout_seconds: float = 15.0) -> Dictionary:
	var request := HTTPRequest.new()
	request.timeout = maxf(timeout_seconds, 1.0)
	add_child(request)
	_track_inventory_query_request(request)
	var state := {"done": false, "completed": []}
	request.request_completed.connect(func(result: int, response_code: int, response_headers: PackedStringArray, body: PackedByteArray):
		state["done"] = true
		state["completed"] = [result, response_code, response_headers, body]
	)
	var error := request.request(url, headers, method, JSON.stringify(value))
	if error != OK:
		_untrack_inventory_query_request(request)
		request.queue_free()
		return {"ok": false, "message": "Falha ao iniciar requisicao.", "response_code": 0, "result": error}
	var deadline := Time.get_ticks_msec() + int(maxf(timeout_seconds, 1.0) * 1000.0)
	while not bool(state.get("done", false)) and Time.get_ticks_msec() < deadline:
		await get_tree().process_frame
	if not bool(state.get("done", false)):
		request.cancel_request()
		_untrack_inventory_query_request(request)
		request.queue_free()
		return {"ok": false, "message": "Tempo limite da requisicao excedido.", "response_code": 0, "timeout": true}
	_untrack_inventory_query_request(request)
	request.queue_free()
	var completed: Array = state.get("completed", []) as Array
	var result := int(completed[0])
	var response_code := int(completed[1])
	var body := completed[3] as PackedByteArray
	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300:
		return {"ok": false, "message": _http_result_message(result, response_code), "response_code": response_code, "result": result, "body": body.get_string_from_utf8()}
	return {"ok": true, "response_code": response_code, "result": result, "body": body.get_string_from_utf8()}


func _http_post_json_with_response_headers(url: String, value: Dictionary, headers: PackedStringArray, timeout_seconds: float = 15.0) -> Dictionary:
	var request := HTTPRequest.new()
	request.timeout = maxf(timeout_seconds, 1.0)
	add_child(request)
	_track_inventory_query_request(request)
	var state := {"done": false, "completed": []}
	request.request_completed.connect(func(result: int, response_code: int, response_headers: PackedStringArray, body: PackedByteArray):
		state["done"] = true
		state["completed"] = [result, response_code, response_headers, body]
	)
	var error := request.request(url, headers, HTTPClient.METHOD_POST, JSON.stringify(value))
	if error != OK:
		_untrack_inventory_query_request(request)
		request.queue_free()
		return {"ok": false, "message": "Falha ao iniciar requisicao.", "response_code": 0, "result": error, "headers": PackedStringArray()}
	var deadline := Time.get_ticks_msec() + int(maxf(timeout_seconds, 1.0) * 1000.0)
	while not bool(state.get("done", false)) and Time.get_ticks_msec() < deadline:
		await get_tree().process_frame
	if not bool(state.get("done", false)):
		request.cancel_request()
		_untrack_inventory_query_request(request)
		request.queue_free()
		return {"ok": false, "message": "Tempo limite da requisicao excedido.", "response_code": 0, "timeout": true, "headers": PackedStringArray()}
	_untrack_inventory_query_request(request)
	request.queue_free()
	var completed: Array = state.get("completed", []) as Array
	var result := int(completed[0])
	var response_code := int(completed[1])
	var response_headers := completed[2] as PackedStringArray
	var body := completed[3] as PackedByteArray
	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300:
		return {
			"ok": false,
			"message": _http_result_message(result, response_code),
			"response_code": response_code,
			"result": result,
			"body": body.get_string_from_utf8(),
			"headers": response_headers,
		}
	return {
		"ok": true,
		"response_code": response_code,
		"result": result,
		"body": body.get_string_from_utf8(),
		"headers": response_headers,
	}


func _http_header_value(headers: PackedStringArray, header_name: String) -> String:
	var wanted := header_name.strip_edges().to_lower()
	for line in headers:
		var text_value := str(line)
		var separator := text_value.find(":")
		if separator <= 0:
			continue
		var name := text_value.substr(0, separator).strip_edges().to_lower()
		if name == wanted:
			return text_value.substr(separator + 1).strip_edges()
	return ""


func _arya_request_headers() -> PackedStringArray:
	var headers := PackedStringArray(["User-Agent: GrupoRSCentral/1.0"])
	var token := _arya_token()
	if token != "":
		headers.append("Authorization: Bearer %s" % token)
	return headers


func _arya_json_request_headers() -> PackedStringArray:
	var headers := _arya_request_headers()
	headers.append("Content-Type: application/json")
	return headers


func _arya_token() -> String:
	var env_token := OS.get_environment("ARYA_JWT_TOKEN").strip_edges()
	if env_token != "":
		return env_token
	var settings := _read_json_dictionary(SETTINGS_PATH)
	return str(settings.get("arya_token", "")).strip_edges()


func _arya_credentials() -> Dictionary:
	var env_email := OS.get_environment("ARYA_EMAIL").strip_edges()
	var env_password := OS.get_environment("ARYA_PASSWORD")
	if env_email != "" and env_password != "":
		return {"email": env_email, "password": env_password}
	var settings := _read_json_dictionary(SETTINGS_PATH)
	return {
		"email": str(settings.get("arya_email", "")).strip_edges(),
		"password": str(settings.get("arya_password", "")),
	}


func _save_arya_credentials_and_token(email: String, password: String, token: String) -> void:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var previous_password := str(settings.get("arya_password", ""))
	var credentials_stamp := str(settings.get("integrations_credentials_saved_at", "")).strip_edges()
	settings["arya_email"] = email.strip_edges()
	if password != "":
		settings["arya_password"] = password
	settings["arya_token"] = token.strip_edges()
	settings["arya_token_saved_at"] = Time.get_datetime_string_from_system(false, true)
	if credentials_stamp == "" or (password != "" and password != previous_password):
		settings["integrations_credentials_saved_at"] = Time.get_datetime_string_from_system(false, true)
	_write_json_dictionary(SETTINGS_PATH, settings)
	_register_integrations_credentials_log()


func _ensure_arya_token(force: bool = false) -> Dictionary:
	if not force and _arya_token() != "":
		return {"ok": true, "token": _arya_token(), "source": "saved"}
	var credentials := _arya_credentials()
	var email := str(credentials.get("email", "")).strip_edges()
	var password := str(credentials.get("password", ""))
	if email == "" or password == "":
		return {"ok": false, "message": "Credenciais Arya nao configuradas."}
	var login := await _login_arya(email, password)
	if not bool(login.get("ok", false)):
		return login
	_save_arya_credentials_and_token(email, password, str(login.get("token", "")))
	return {"ok": true, "token": str(login.get("token", "")), "source": "login"}


func _http_get_bytes(url: String) -> Dictionary:
	var request := HTTPRequest.new()
	request.timeout = 15.0
	add_child(request)
	var error := request.request(url, ["User-Agent: GrupoRSCentral/1.0"])
	if error != OK:
		request.call_deferred("queue_free")
		return {"ok": false, "bytes": PackedByteArray(), "result": error, "response_code": 0, "message": "Falha ao iniciar requisicao."}

	var completed: Array = await request.request_completed
	request.call_deferred("queue_free")
	var result := int(completed[0])
	var response_code := int(completed[1])
	var body := completed[3] as PackedByteArray
	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300:
		return {
			"ok": false,
			"bytes": PackedByteArray(),
			"result": result,
			"response_code": response_code,
			"message": _http_result_message(result, response_code),
		}
	return {"ok": true, "bytes": body, "result": result, "response_code": response_code}


func _http_result_message(result: int, response_code: int) -> String:
	if response_code > 0:
		return "HTTP %d" % response_code
	match result:
		HTTPRequest.RESULT_CANT_CONNECT:
			return "Sem conexao com o servidor."
		HTTPRequest.RESULT_CANT_RESOLVE:
			return "DNS nao resolveu o servidor."
		HTTPRequest.RESULT_CONNECTION_ERROR:
			return "Conexao encerrada pelo servidor."
		HTTPRequest.RESULT_TLS_HANDSHAKE_ERROR:
			return "Falha TLS/SSL na conexao."
		HTTPRequest.RESULT_NO_RESPONSE:
			return "Servidor nao respondeu."
		HTTPRequest.RESULT_TIMEOUT:
			return "Tempo de conexao esgotado."
		_:
			return "Falha de transporte HTTP (%d)." % result


