func _dashboard_day_greeting() -> String:
	var hour := int(Time.get_time_dict_from_system().get("hour", 12))
	if hour < 12:
		return "Bom dia"
	if hour < 18:
		return "Boa tarde"
	return "Boa noite"


func _capture_dashboard_trends(stats: Dictionary) -> Dictionary:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var snapshots: Dictionary = settings.get("dashboard_metric_snapshots", {})
	var branch_key := selected_branch_id.strip_edges().to_lower()
	if branch_key == "":
		branch_key = "default"
	var previous: Dictionary = snapshots.get(branch_key, {})
	var definitions := {
		"Equipamentos": {"key": "total", "positive_when_up": true},
		"Em estoque": {"key": "available", "positive_when_up": true},
		"Reserva": {"key": "reserved", "positive_when_up": false},
		"Instalados": {"key": "installed", "positive_when_up": true},
		"Manutencoes": {"key": "maintenance", "positive_when_up": false},
		"Inativos": {"key": "inactive", "positive_when_up": false},
	}
	var current: Dictionary = {"captured_at": int(Time.get_unix_time_from_system())}
	var trends: Dictionary = {}
	for title in definitions:
		var definition: Dictionary = definitions[title]
		var value := int(stats.get(str(definition.get("key", "")), 0))
		current[title] = value
		var trend := {
			"text": "Atualizado agora",
			"color": MUTED,
			"has_comparison": false,
		}
		if previous.has(title):
			var prior := int(previous.get(title, value))
			var delta := value - prior
			var percent := 0.0 if prior == 0 else (float(delta) / float(prior)) * 100.0
			var arrow := "↑" if delta > 0 else ("↓" if delta < 0 else "—")
			var positive_when_up := bool(definition.get("positive_when_up", true))
			var is_positive := delta == 0 or (delta > 0 and positive_when_up) or (delta < 0 and not positive_when_up)
			trend = {
				"text": "%s %+.1f%%" % [arrow, percent],
				"color": GREEN if is_positive else RED,
				"has_comparison": true,
			}
		trends[title] = trend
	snapshots[branch_key] = current
	settings["dashboard_metric_snapshots"] = snapshots
	_write_json_dictionary(SETTINGS_PATH, settings)
	return trends


