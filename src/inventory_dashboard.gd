func _show_auto_reset_dashboard(section: String = "") -> void:
	if not _branch_supports_auto_monitor():
		_show_warning("Comunicacoes", "O monitor automatico nao esta disponivel para esta base regional.")
		return
	_set_page_context("communications", "Central de comunicacoes", "Monitor automatico, SMS e recuperacoes")
	if section != "":
		auto_reset_view_section = section
	if not ["overview", "costs", "operation", "recovered", "sms"].has(auto_reset_view_section):
		auto_reset_view_section = "overview"
	_set_content_margins(38, 28, 38, 24)
	var view := _build_auto_reset_dashboard_view()
	view.set_meta("view_key", "auto_reset_dashboard")
	_set_content(view)


func _set_auto_reset_view_section(section: String) -> void:
	auto_reset_view_section = section
	_show_auto_reset_dashboard()


func _refresh_auto_reset_dashboard_if_visible() -> void:
	if content_area == null or not is_instance_valid(content_area):
		return
	for child in content_area.get_children():
		if child is Control and str((child as Control).get_meta("view_key", "")) == "auto_reset_dashboard":
			_show_auto_reset_dashboard()
			return


func _show_sms_panel() -> void:
	_set_page_context("sms_panel", "Painel SMS", "Envios, status e consumo da operacao em tempo real")
	_set_content_margins(28, 22, 28, 22)
	_set_content(_build_sms_panel_view(), true)


func _sms_panel_events_filtered() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var search := sms_panel_search_filter.strip_edges().to_lower()
	for event in sms_panel_events:
		if sms_panel_status_filter != "Todos" and str(event.get("status", "")) != sms_panel_status_filter:
			continue
		if sms_panel_origin_filter != "Todos" and str(event.get("origin", "")) != sms_panel_origin_filter:
			continue
		if (sms_panel_start_date != "" or sms_panel_end_date != "") and not _date_value_in_range(str(event.get("timestamp", event.get("date", ""))), sms_panel_start_date, sms_panel_end_date):
			continue
		if search != "":
			var haystack := "%s %s %s %s" % [
				str(event.get("serial", "")),
				str(event.get("phone", "")),
				str(event.get("message_id", "")),
				str(event.get("origin", "")),
			]
			if not haystack.to_lower().contains(search):
				continue
		result.append(event)
	return result


func _refresh_sms_panel_date_filters() -> void:
	if sms_panel_date_input != null and is_instance_valid(sms_panel_date_input):
		sms_panel_start_date = sms_panel_date_input.text.strip_edges()
	if sms_panel_end_date_input != null and is_instance_valid(sms_panel_end_date_input):
		sms_panel_end_date = sms_panel_end_date_input.text.strip_edges()
	if sms_panel_start_date != "" and sms_panel_end_date != "":
		var start := _log_input_date(sms_panel_start_date)
		var finish := _log_input_date(sms_panel_end_date)
		if start != "" and finish != "" and start > finish:
			_show_warning("Painel SMS", "A data final não pode ser anterior à data inicial.")
			return
	_show_sms_panel()


func _clear_sms_panel_filters() -> void:
	sms_panel_search_filter = ""
	sms_panel_start_date = ""
	sms_panel_end_date = ""
	_show_sms_panel()


