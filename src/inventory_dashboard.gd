class InternalBatteryIcon:
	extends Control

	var percent := -1
	var loading := false
	var no_data := false
	var icon_color := Color("#657487")
	var phase := 0.0

	func _init() -> void:
		custom_minimum_size = Vector2(22, 18)
		size = Vector2(22, 18)
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		set_process(false)

	func set_value(next_percent: int, next_loading: bool, next_color: Color, next_no_data: bool = false) -> void:
		percent = next_percent
		loading = next_loading
		no_data = next_no_data
		icon_color = next_color
		set_process(loading)
		queue_redraw()

	func _process(delta: float) -> void:
		phase = fmod(phase + delta * 1.8, 1.0)
		queue_redraw()

	func _draw() -> void:
		var outline := Rect2(Vector2(1.5, 3.0), Vector2(16.0, 12.0))
		draw_rect(outline, icon_color, false, 2.0)
		draw_rect(Rect2(Vector2(18.0, 6.0), Vector2(2.5, 6.0)), icon_color, true)
		var fill_ratio := 0.0
		if loading:
			fill_ratio = 0.22 + phase * 0.68
		elif percent >= 0:
			fill_ratio = clampf(float(percent) / 100.0, 0.06, 1.0)
		if no_data and not loading and percent < 0:
			draw_line(Vector2(4.0, 14.5), Vector2(16.5, 3.5), icon_color, 2.2, true)
			draw_circle(Vector2(12.6, 12.2), 1.25, icon_color)
			draw_arc(Vector2(11.0, 7.2), 3.2, deg_to_rad(205), deg_to_rad(330), 10, icon_color, 1.8, true)
			draw_line(Vector2(13.6, 8.4), Vector2(11.6, 10.2), icon_color, 1.8, true)
		elif fill_ratio > 0.0:
			draw_rect(Rect2(Vector2(3.5, 5.0), Vector2(12.0 * fill_ratio, 8.0)), icon_color, true)
		elif percent < 0:
			draw_line(Vector2(6.0, 9.0), Vector2(13.0, 9.0), icon_color, 2.0, true)


