func _system_log_calendar_month_name(month: int) -> String:
	var months := ["Janeiro", "Fevereiro", "Marco", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"]
	return months[clampi(month - 1, 0, months.size() - 1)]


func _system_log_calendar_days_in_month(year: int, month: int) -> int:
	var days := [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
	if month == 2 and (year % 400 == 0 or (year % 4 == 0 and year % 100 != 0)):
		return 29
	return days[clampi(month - 1, 0, days.size() - 1)]


func _system_log_calendar_weekday(year: int, month: int, day: int) -> int:
	var unix_time := Time.get_unix_time_from_datetime_dict({
		"year": year,
		"month": month,
		"day": day,
		"hour": 0,
		"minute": 0,
		"second": 0,
	})
	return int(Time.get_datetime_dict_from_unix_time(unix_time).get("weekday", 0))


func _system_log_calendar_parts(value: String) -> Dictionary:
	var clean := _log_input_date(value)
	var parts := clean.split("-")
	var today := Time.get_date_dict_from_system()
	var year := int(today.get("year", 2026))
	var month := int(today.get("month", 1))
	var day := int(today.get("day", 1))
	if parts.size() == 3 and str(parts[0]).is_valid_int() and str(parts[1]).is_valid_int() and str(parts[2]).is_valid_int():
		year = int(parts[0])
		month = clampi(int(parts[1]), 1, 12)
		day = clampi(int(parts[2]), 1, _system_log_calendar_days_in_month(year, month))
	return {"year": year, "month": month, "day": day}


func _system_log_calendar_display_value(value: String) -> String:
	if value.strip_edges() == "":
		return ""
	var parts := _system_log_calendar_parts(value)
	return "%02d/%02d/%04d" % [int(parts.get("day", 1)), int(parts.get("month", 1)), int(parts.get("year", 2026))]


func _open_system_log_calendar(input: LineEdit, end_of_day: bool) -> void:
	if is_instance_valid(system_log_calendar_popup):
		system_log_calendar_popup.hide()
		system_log_calendar_popup.queue_free()
	system_log_calendar_target = input
	system_log_calendar_end_of_day = end_of_day
	var parts := _system_log_calendar_parts(input.text if input != null else "")
	system_log_calendar_year = int(parts.get("year", 2026))
	system_log_calendar_month = int(parts.get("month", 1))
	var popup := PopupPanel.new()
	system_log_calendar_popup = popup
	popup.add_theme_stylebox_override("panel", _style_box(Color("#f8fbff"), Color("#c6dbea"), 1, 12, true))
	popup.popup_hide.connect(func():
		if system_log_calendar_popup == popup:
			system_log_calendar_popup = null
		if is_instance_valid(popup):
			popup.queue_free()
	)
	add_child(popup)
	_popup_system_log_calendar_content(popup)
	var anchor := input.get_global_rect()
	var popup_size := Vector2(376, 424)
	var viewport_size := Vector2(DisplayServer.window_get_size())
	var popup_position := anchor.position + Vector2(0, anchor.size.y + 5)
	if popup_position.x + popup_size.x > viewport_size.x - 8:
		popup_position.x = maxf(8.0, viewport_size.x - popup_size.x - 8.0)
	if popup_position.y + popup_size.y > viewport_size.y - 8:
		popup_position.y = maxf(8.0, anchor.position.y - popup_size.y - 5.0)
	popup.popup(Rect2(popup_position, popup_size))


