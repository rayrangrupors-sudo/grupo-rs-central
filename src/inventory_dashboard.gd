func _branch_config(branch_id: String) -> Dictionary:
	for config in _branch_configs():
		if str(config.get("id", "")) == branch_id:
			return config
	return {}


func _branch_feature_enabled(feature: String, fallback: bool = false) -> bool:
	var config := _branch_config(selected_branch_id)
	var raw_features: Variant = config.get("features", {})
	if typeof(raw_features) == TYPE_DICTIONARY:
		var features := raw_features as Dictionary
		if features.has(feature):
			return bool(features.get(feature, fallback))
	return fallback


