func _split_bulk_line(line: String) -> Array[String]:
	var separators := ["\t", ";", ","]
	var best: Array[String] = []

	for separator in separators:
		var parts := line.split(separator, false)
		if parts.size() <= best.size():
			continue

		best.clear()
		for part in parts:
			best.append(str(part).strip_edges())

	if best.is_empty() and line.strip_edges() != "":
		best.append(line.strip_edges())
	return best


func _is_bulk_header(cells: Array[String]) -> bool:
	var text_value := ""
	for cell in cells:
		text_value += str(cell).strip_edges().to_lower() + " "
	var key := _bulk_key(text_value)
	return _is_bulk_serial_header_key(key) and (_is_bulk_plate_header_key(key) or key.contains("operadora"))


func _clean_pasted_cell(value: String) -> String:
	var text_value := value.strip_edges()
	if text_value.length() >= 2 and text_value.begins_with("\"") and text_value.ends_with("\""):
		text_value = text_value.substr(1, text_value.length() - 2)
	return text_value.strip_edges()


func _normalize_bulk_model(value: String) -> String:
	var clean := value.strip_edges()
	var key := _bulk_key(clean)
	match key:
		"v735", "v7350", "v735versao", "v735version", "xrs":
			return "V7.3.5"
		"rsnovo", "rsnovos":
			return "RS Novo"
		"reutilizado", "reutilizada", "usado", "usada":
			return "Reutilizado"
		"novo", "nova":
			return "Novo"
		_:
			return clean


func _normalize_bulk_operator(value: String) -> String:
	var clean := value.strip_edges()
	var key := _bulk_key(clean)
	match key:
		"tim":
			return "Tim"
		"claro":
			return "Claro"
		"vivo":
			return "Vivo"
		"semoperadora":
			return "Sem operadora"
		_:
			return clean


func _infer_bulk_fields_from_plate(plate: String) -> Dictionary:
	return {
		"model": _infer_bulk_model_from_plate(plate),
		"operator": _infer_bulk_operator_from_plate(plate),
	}


func _infer_bulk_model_from_plate(plate: String) -> String:
	var key := _bulk_key(plate)
	if key.begins_with("xrs"):
		return "V7.3.5"
	if key.begins_with("aaa"):
		return "Reutilizado"
	if key.begins_with("grs"):
		return "RS Novo"
	if key.begins_with("nov"):
		return "Novo"
	return ""


func _infer_bulk_operator_from_plate(plate: String) -> String:
	var text_value := plate.strip_edges().to_upper()
	var key := _bulk_key(text_value)

	if text_value.contains("TIM") or key.contains("tim"):
		return "Tim"
	if text_value.contains("CLARO") or key.contains("claro"):
		return "Claro"
	if text_value.contains("VIVO") or key.contains("vivo"):
		return "Vivo"

	var operator_letter := ""
	var dash_index := text_value.find("-")
	if dash_index >= 0 and dash_index + 1 < text_value.length():
		var after_dash := text_value.substr(dash_index + 1).strip_edges()
		if after_dash.length() > 0:
			operator_letter = after_dash.substr(0, 1)

	if operator_letter == "":
		var prefix_length := 0
		if key.begins_with("aaa") or key.begins_with("grs") or key.begins_with("nov") or key.begins_with("xrs"):
			prefix_length = 3
		if prefix_length > 0 and key.length() > prefix_length:
			operator_letter = key.substr(prefix_length, 1).to_upper()

	match operator_letter:
		"T":
			return "Tim"
		"C":
			return "Claro"
		"V":
			return "Vivo"
		_:
			return "Sem operadora"


