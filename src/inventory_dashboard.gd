func _status_key_from_text(value: String) -> String:
	var text_value := value.strip_edges().to_lower()
	text_value = text_value.replace("Ã§", "c").replace("Ã£", "a").replace("Ã¡", "a").replace("Ã ", "a").replace("Ã¢", "a").replace("Ã©", "e").replace("Ãª", "e").replace("Ã­", "i").replace("Ã³", "o").replace("Ãµ", "o").replace("Ã´", "o").replace("Ãº", "u")
	text_value = text_value.replace("Ã§", "c").replace("Ã£", "a").replace("Ã¡", "a").replace("Ã¢", "a").replace("Ã©", "e").replace("Ã­", "i").replace("Ã³", "o")
	if text_value == "em estoque":
		return "estoque"
	if text_value == "em reserva":
		return "reserva"
	return text_value


func _truncate(value: String, max_length: int) -> String:
	if value.length() <= max_length:
		return value
	return value.substr(0, maxi(max_length - 3, 0)) + "..."


func _blank(value: String) -> String:
	return "-" if value.strip_edges() == "" else value


func _format_datetime(value: String) -> String:
	var text_value := value.strip_edges()
	if text_value == "":
		return ""

	var parts := text_value.split("T")
	if parts.size() < 2:
		parts = text_value.split(" ")
	if parts.size() < 2:
		return text_value

	var date_parts := parts[0].split("-")
	if date_parts.size() != 3:
		return text_value

	var time_part := str(parts[1])
	if time_part.length() > 8:
		time_part = time_part.substr(0, 8)

	return "%s/%s/%s %s" % [date_parts[2], date_parts[1], date_parts[0], time_part]


func _csv(value: String) -> String:
	return value.replace(";", ",").replace("\n", " ").replace("\r", " ")


