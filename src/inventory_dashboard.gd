func _export_sms_panel_xlsx() -> void:
	var rows: Array = [["Data", "Serie", "Telefone", "Origem", "Status", "ID", "Custo", "Erro"]]
	for event in _sms_panel_events_filtered():
		rows.append([
			str(event.get("timestamp", "")),
			str(event.get("serial", "")),
			str(event.get("phone", "")),
			str(event.get("origin", "")),
			str(event.get("status", "")),
			str(event.get("message_id", "")),
			_format_monitor_usd(float(event.get("price", 0.0))),
			str(event.get("error", "")),
		])
	if rows.size() <= 1:
		_show_warning("Painel SMS", "Nao ha eventos para exportar.")
		return
	var path := _downloads_export_path("painel_sms_export.xlsx")
	if _write_xlsx(path, "SMS", rows):
		_show_success("Painel SMS", "Historico exportado em XLSX:\n%s" % path)
	else:
		_show_error("Painel SMS", "Nao foi possivel criar o arquivo XLSX.")


