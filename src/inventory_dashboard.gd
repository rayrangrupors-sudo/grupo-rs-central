func _auto_start_branch_preview_sync() -> void:
	if branch_auto_sync_requested or selected_branch_id.strip_edges() != "":
		return
	for config in _branch_configs():
		if not bool(config.get("enabled", false)):
			continue
		branch_auto_sync_requested = true
		_select_branch(str(config.get("id", "")), true)
		return


