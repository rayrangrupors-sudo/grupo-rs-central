func _open_dashboard_communication_interval(interval_name: String) -> void:
	if dashboard_communication_snapshot.is_empty():
		_show_warning("Comunicacao dos veiculos", "A primeira leitura ainda esta em andamento. Aguarde alguns segundos.")
		return
	var rows_by_interval: Dictionary = dashboard_communication_snapshot.get("rows_by_interval", {})
	var values: Variant = rows_by_interval.get(interval_name, [])
	dashboard_communication_detail_rows = []
	if typeof(values) == TYPE_ARRAY:
		for value in values:
			if typeof(value) == TYPE_DICTIONARY:
				dashboard_communication_detail_rows.append((value as Dictionary).duplicate(true))
	dashboard_communication_detail_page = 0
	_show_dashboard_communication_detail(interval_name)


