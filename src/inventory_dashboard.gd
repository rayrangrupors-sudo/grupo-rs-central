func _show_equipment_registration_feedback(title_text: String, status_text: String, detail_text: String, color: Color) -> void:
	# O feedback remoto agora pertence exclusivamente a fila moderna. Este metodo
	# permanece como ponte para os fluxos antigos, mas nunca cria uma notificacao
	# flutuante no canto da tela.
	var feedback_details := "%s | %s" % [status_text.strip_edges(), detail_text.strip_edges()]
	_log_system_action(title_text, feedback_details)
	_dismiss_equipment_registration_feedback()


func _dismiss_equipment_registration_feedback() -> void:
	# A fila moderna substitui a caixa legada. Remova a caixa imediatamente para
	# evitar que uma notificacao antiga fique presa sobre o cabecalho.
	if equipment_registration_feedback_layer != null and is_instance_valid(equipment_registration_feedback_layer):
		equipment_registration_feedback_layer.queue_free()
	equipment_registration_feedback_layer = null
	equipment_registration_feedback_title = null
	equipment_registration_feedback_status = null
	equipment_registration_feedback_detail = null
	equipment_registration_feedback_dot = null


func _equipment_registration_timed_out() -> bool:
	return equipment_registration_deadline_msec > 0 and Time.get_ticks_msec() >= equipment_registration_deadline_msec


func _equipment_registration_timeout_result(stage: String) -> Dictionary:
	return {
		"ok": false,
		"timed_out": true,
		"message": "Cadastro remoto interrompido pelo limite de %ds durante %s. O cadastro local foi preservado." % [int(_equipment_registration_timeout_seconds()), stage],
	}


func _equipment_registration_timeout_seconds() -> float:
	return REMOTE_REGISTRATION_JOB_TIMEOUT_SECONDS


func _equipment_registration_is_current(generation: int) -> bool:
	return equipment_registration_running and equipment_registration_active_generation == generation


func _finish_equipment_registration_job(generation: int) -> void:
	if equipment_registration_active_generation != generation:
		return
	equipment_registration_running = false
	equipment_registration_deadline_msec = 0
	equipment_registration_active_generation = -1


func _watch_equipment_registration_job(generation: int) -> void:
	while _equipment_registration_is_current(generation) and is_inside_tree():
		if _equipment_registration_timed_out():
			var serial := str(equipment_registration_watch_serial.get(generation, ""))
			_show_equipment_registration_feedback(
				"Cadastro remoto encerrado",
				"Cadastro local preservado",
				"A API/portal nao respondeu em %ds. Nenhuma resposta atrasada sera aplicada; tente novamente quando o servico responder." % int(_equipment_registration_timeout_seconds()),
				ORANGE
			)
			_log_system_action("Cadastro remoto expirou", "A API/portal nao respondeu no prazo. Serie: %s" % serial, serial)
			equipment_registration_watch_serial.erase(generation)
			_finish_equipment_registration_job(generation)
			return
		await get_tree().create_timer(REMOTE_REGISTRATION_WATCHDOG_INTERVAL_SECONDS).timeout
	if not is_inside_tree() and equipment_registration_active_generation == generation:
		equipment_registration_watch_serial.erase(generation)
		_finish_equipment_registration_job(generation)


var equipment_registration_watch_serial: Dictionary = {}


func _start_equipment_registration_job(local_product: Dictionary, request: Dictionary) -> void:
	if not equipment_registration_running or equipment_registration_active_generation >= 0:
		return
	var serial := str(request.get("serial", "")).strip_edges()
	equipment_registration_generation += 1
	var generation := equipment_registration_generation
	equipment_registration_active_generation = generation
	equipment_registration_watch_serial[generation] = serial
	equipment_registration_deadline_msec = Time.get_ticks_msec() + int(_equipment_registration_timeout_seconds() * 1000.0)
	_show_equipment_registration_feedback(
		"Cadastro remoto em andamento",
		"Consultando formulario do Grupo RS",
		"Serie %s | a tela continua livre para outras tarefas." % serial,
		BLUE
	)
	call_deferred("_watch_equipment_registration_job", generation)
	var result := await _perform_equipment_registration(request)
	if not _equipment_registration_is_current(generation):
		return
	# Nenhum resultado parcial pode cair no caminho de conclusao. Isso evita o
	# defeito em que o POST era aceito, a leitura ainda vinha vazia e o sistema
	# gravava a placa como se ja estivesse vinculada.
	if bool(result.get("confirmation_pending", false)):
		var pending_message := str(result.get("message", "A API ainda nao confirmou a vinculacao da placa."))
		_show_equipment_registration_feedback(
			"Vinculacao nao confirmada",
			"Cadastro local preservado; nenhuma placa foi marcada como vinculada",
			pending_message,
			ORANGE
		)
		_log_system_action("Vinculacao pendente", pending_message, serial)
		equipment_registration_watch_serial.erase(generation)
		_finish_equipment_registration_job(generation)
		return
	if bool(result.get("ok", false)):
		var equipment_only := bool(request.get("equipment_only", false))
		var api_vehicle := bool(result.get("api_vehicle", false))
		var confirmation_pending := bool(result.get("confirmation_pending", false))
		if confirmation_pending and typeof(result.get("request", {})) == TYPE_DICTIONARY:
			request.merge(result.get("request", {}) as Dictionary, true)
		var confirmation_warning := str((result.get("vehicle", {}) as Dictionary).get("warning", "")).strip_edges()
		var completion_detail := "Serie %s | sem placa alterada neste passo" % serial if equipment_only else "%s | %s | RS300 | Carro" % [str(request.get("plate", "")), serial]
		if confirmation_warning != "":
			completion_detail = "%s | %s" % [completion_detail, confirmation_warning]
		if confirmation_pending:
			completion_detail = str(result.get("message", completion_detail))
		_show_equipment_registration_feedback(
			"Cadastro aceito pela API" if confirmation_pending else ("Equipamento cadastrado pela API" if equipment_only else "Cadastro concluido"),
			"Confirmacao completa pendente; nenhum fallback foi repetido" if confirmation_pending else ("Equipamento confirmado; placa e vinculo permanecem no portal web" if equipment_only else ("Placa e aparelho confirmados pela API oficial" if api_vehicle else "Placa criada e aparelho vinculado pelo portal web")),
			completion_detail,
			ORANGE if confirmation_pending else GREEN
		)
		var finalized := _finalize_local_equipment_registration(local_product, request)
		if not _equipment_registration_is_current(generation):
			return
		if bool(finalized.get("ok", false)):
			if confirmation_pending:
				_log_system_action("Confirmacao remota pendente", "A API aceitou a placa, mas a leitura completa ainda esta propagando. Nenhum fallback foi repetido. Serie: %s" % serial, serial)
			else:
				_log_system_action(
					"Cadastrou equipamento pela API" if equipment_only else "Vinculou veiculo Grupo RS",
					"Equipamento: %s | Placa/vinculo mantidos no portal web" % serial if equipment_only else "Placa: %s | Cliente: RS300 | Tipo: Carro | Equipamento: %s" % [str(request.get("plate", "")), serial],
					serial
				)
		else:
			_show_equipment_registration_feedback(
				"Vinculacao remota concluida",
				"Falha ao atualizar o cadastro local",
				str(finalized.get("message", "O equipamento remoto foi vinculado, mas o cadastro local precisa ser conferido.")),
				RED
			)
			_log_system_action("Falhou atualizacao local apos vinculacao", str(finalized.get("message", "")), serial)
	else:
		var message := str(result.get("message", "Nao foi possivel concluir o cadastro remoto."))
		_show_equipment_registration_feedback(
			"Cadastro remoto interrompido",
			"Equipamento preservado no estoque",
			message,
			RED
		)
		_log_system_action("Falhou cadastro remoto", message, serial)
	equipment_registration_watch_serial.erase(generation)
	_finish_equipment_registration_job(generation)


func _equipment_api_edit_is_current(generation: int) -> bool:
	return equipment_api_edit_running and equipment_api_edit_active_generation == generation


func _equipment_api_edit_queue_contains_serial(serial: String) -> bool:
	var candidate := _digits_only(serial)
	if candidate == "":
		return false
	if equipment_api_edit_running and _digits_only(equipment_api_edit_serial) == candidate:
		return true
	for queued_item in equipment_api_edit_queue:
		var queued_request: Dictionary = queued_item.get("request", {}) as Dictionary
		if _digits_only(str(queued_request.get("serial", ""))) == candidate:
			return true
	return false


func _enqueue_equipment_api_edit(local_product: Dictionary, request: Dictionary) -> void:
	var serial := _digits_only(str(request.get("serial", local_product.get("imei", ""))))
	if serial == "" or _equipment_api_edit_queue_contains_serial(serial):
		return
	equipment_api_edit_queue.append({
		"local_product": local_product.duplicate(true),
		"request": request.duplicate(true),
	})
	_log_system_action(
		"Edicao remota enfileirada",
		"Serie: %s | Posicao na fila: %d" % [serial, equipment_api_edit_queue.size()],
		serial
	)
	_show_equipment_registration_feedback(
		"Equipamento salvo localmente",
		"Edicao remota enfileirada",
		"Serie %s | %d alteracao(oes) aguardando processamento." % [serial, equipment_api_edit_queue.size()],
		ORANGE
	)
	_start_next_equipment_api_edit_job()


func _start_next_equipment_api_edit_job() -> void:
	if equipment_api_edit_running or equipment_api_edit_queue.is_empty():
		return
	var queued_item: Dictionary = equipment_api_edit_queue.pop_front()
	var local_product: Dictionary = queued_item.get("local_product", {}) as Dictionary
	var request: Dictionary = queued_item.get("request", {}) as Dictionary
	var serial := _digits_only(str(request.get("serial", local_product.get("imei", ""))))
	equipment_api_edit_running = true
	equipment_api_edit_serial = serial
	equipment_api_edit_generation += 1
	var generation := equipment_api_edit_generation
	equipment_api_edit_active_generation = generation
	equipment_api_edit_deadline_msec = Time.get_ticks_msec() + int(EQUIPMENT_API_EDIT_JOB_TIMEOUT_SECONDS * 1000.0)
	_show_equipment_registration_feedback(
		"Edicao remota em andamento",
		"Sincronizando pela API oficial",
		"Serie %s | a tela continua livre. Restam %d alteracao(oes) na fila." % [serial, equipment_api_edit_queue.size()],
		BLUE
	)
	call_deferred("_start_equipment_api_edit_job", local_product, request, generation)
	call_deferred("_watch_equipment_api_edit_job", generation)


func _finish_equipment_api_edit(generation: int) -> void:
	if equipment_api_edit_active_generation != generation:
		return
	equipment_api_edit_running = false
	equipment_api_edit_serial = ""
	equipment_api_edit_active_generation = -1
	equipment_api_edit_deadline_msec = 0
	call_deferred("_start_next_equipment_api_edit_job")


func _watch_equipment_api_edit_job(generation: int) -> void:
	while _equipment_api_edit_is_current(generation):
		if Time.get_ticks_msec() >= equipment_api_edit_deadline_msec:
			var serial := equipment_api_edit_serial
			_show_equipment_registration_feedback(
				"Edicao remota encerrada",
				"Cadastro local preservado",
				"A API nao confirmou a alteracao em %ds. Nenhuma resposta atrasada sera aplicada; tente novamente quando o servico responder." % int(EQUIPMENT_API_EDIT_JOB_TIMEOUT_SECONDS),
				ORANGE
			)
			_log_system_action("Edicao remota expirou", "A API nao confirmou a alteracao no prazo. Serie: %s" % serial, serial)
			_finish_equipment_api_edit(generation)
			return
		await get_tree().create_timer(EQUIPMENT_API_EDIT_WATCHDOG_INTERVAL_SECONDS).timeout


func _start_equipment_api_edit_job(local_product: Dictionary, request: Dictionary, generation: int) -> void:
	if not _equipment_api_edit_is_current(generation):
		return
	var serial := _digits_only(str(request.get("serial", local_product.get("imei", ""))))
	_show_equipment_registration_feedback(
		"Edicao remota em andamento",
		"Consultando equipamento pela API oficial",
		"Serie %s | o cadastro local ja foi preservado." % serial,
		BLUE
	)
	var found := await _grupo_rs_api_find_equipment(serial, true)
	if not _equipment_api_edit_is_current(generation):
		return
	if _grupo_rs_api_is_permission_denied(found):
		var portal_login := await _grupo_rs_api_login_as_portal()
		if not _equipment_api_edit_is_current(generation):
			return
		if bool(portal_login.get("ok", false)):
			found = await _grupo_rs_api_find_equipment(serial, true)
			if not _equipment_api_edit_is_current(generation):
				return
	var result: Dictionary = {}
	if bool(found.get("ok", false)):
		result = await _grupo_rs_api_patch_equipment(request, found.get("row", {}) as Dictionary)
		if not _equipment_api_edit_is_current(generation):
			return
		if _grupo_rs_api_is_permission_denied(result):
			var portal_login := await _grupo_rs_api_login_as_portal()
			if not _equipment_api_edit_is_current(generation):
				return
			if bool(portal_login.get("ok", false)):
				result = await _grupo_rs_api_patch_equipment(request, found.get("row", {}) as Dictionary)
				if not _equipment_api_edit_is_current(generation):
					return
	else:
		var lookup_code := int(found.get("response_code", 0))
		var can_use_web_fallback := bool(found.get("fallback_web", false)) \
				or bool(found.get("not_found", false)) \
				or lookup_code in [403, 404, 405, 501]
		if can_use_web_fallback and not bool(found.get("partial", false)):
			_set_progress_dialog_content(null, "API sem leitura do equipamento; usando o portal web", "Serie %s" % serial)
			result = await _modify_modern_equipment_via_web(request)
		else:
			result = found
	if not _equipment_api_edit_is_current(generation):
		return
	if bool(result.get("ok", false)):
		_show_equipment_registration_feedback(
			"Equipamento atualizado",
			"Alteracao confirmada pela API oficial",
			"Serie %s | APN, chip, telefone e campos permitidos sincronizados." % serial,
			GREEN
		)
		_log_system_action("Atualizou equipamento pela API", "Serie: %s" % serial, serial)
	else:
		var message := str(result.get("message", "A API nao confirmou a edicao do equipamento."))
		_show_equipment_registration_feedback(
			"Edicao remota interrompida",
			"Cadastro local preservado",
			message,
			RED
		)
		_log_system_action("Falhou atualizacao de equipamento pela API", message, serial)
	_finish_equipment_api_edit(generation)


func _smart_registration_operator_label(value: String) -> String:
	match _search_key(value):
		"claro":
			return "Claro"
		"multioperadora", "multioperador":
			return "Multi Operadora"
		"nlt":
			return "NLT"
		"oi":
			return "OI"
		"tim":
			return "Tim"
		"vivo", "telefonica":
			return "Vivo"
	return value.strip_edges()


func _smart_registration_prepare_request(request: Dictionary) -> Dictionary:
	var prepared := request.duplicate(true)
	var serial := _digits_only(str(prepared.get("serial", prepared.get("remote_serial", ""))))
	var chip := _digits_only(str(prepared.get("chip_number", prepared.get("chip", ""))))
	var phone := _local_registration_phone(str(prepared.get("phone", prepared.get("chip_phone", ""))))
	var apn := str(prepared.get("apn", "")).strip_edges().to_lower()
	var operator_name := _smart_registration_operator_label(str(prepared.get("operator", "")))
	var plate := _format_grupo_rs_vehicle_plate(str(prepared.get("plate", prepared.get("new_plate", ""))))
	prepared["serial"] = serial
	prepared["chip_number"] = chip
	prepared["phone"] = phone
	prepared["apn"] = apn
	prepared["operator"] = operator_name
	if plate != "":
		prepared["plate"] = plate
	# A chave permite reconhecer a mesma operacao depois de um HTTP 500 ou de
	# uma perda de conexao sem repetir o POST por outro canal.
	prepared["_smart_operation_key"] = "cadastro:%s:%s:%s:%s:%s" % [
		serial,
		chip,
		phone,
		apn,
		_search_key(plate),
	]
	prepared["_smart_plan_state"] = "prepared"
	return prepared


func _confirm_smart_registered_equipment(request: Dictionary, result: Dictionary) -> Dictionary:
	var serial := _digits_only(str(request.get("serial", "")))
	if serial == "":
		return {"ok": false, "partial": true, "confirmation_pending": true, "message": "Serie ausente na confirmacao inteligente."}
	var confirmed := await _grupo_rs_api_wait_for_equipment(serial)
	if not bool(confirmed.get("ok", false)):
		return {
			"ok": false,
			"partial": true,
			"confirmation_pending": true,
			"message": str(confirmed.get("message", "O equipamento ainda nao foi confirmado pela API.")),
			"equipment": result,
			"request": request,
		}
	var row := confirmed.get("row", {}) as Dictionary
	if not _grupo_rs_api_equipment_row_matches_request(row, request):
		return {
			"ok": false,
			"partial": true,
			"confirmation_pending": true,
			"message": "A API localizou a serie, mas os dados do chip ainda divergem da solicitacao.",
			"equipment": result,
			"row": row,
			"request": request,
		}
	return {"ok": true, "result": result, "row": row}


func _perform_equipment_registration(request: Dictionary) -> Dictionary:
	request = await _await_registration_probe_data(request)
	request = _smart_registration_prepare_request(request)
	var serial := _digits_only(str(request.get("serial", "")))
	var plate := _format_grupo_rs_vehicle_plate(str(request.get("plate", "")))
	_remote_queue_stage(request, "Consultando equipamento", "API oficial | chip, telefone e APN")
	if serial == "":
		return {"ok": false, "message": "Serie ou placa ausente no cadastro remoto."}
	if not bool(request.get("equipment_only", false)) and plate == "":
		return {"ok": false, "message": "Serie ou placa ausente no cadastro remoto."}
	if _digits_only(str(request.get("chip_number", ""))).length() < 18 or _local_registration_phone(str(request.get("phone", ""))) == "" or str(request.get("apn", "")).strip_edges().to_lower() not in ["hinova.br", "linksolutions.br"]:
		return {"ok": false, "message": "A busca em segundo plano nao confirmou ICCID completo, telefone e APN do chip. O cadastro local foi preservado; tente novamente apos a consulta concluir."}
	if _equipment_registration_timed_out():
		return _equipment_registration_timeout_result("validacao inicial")
	var equipment_result: Dictionary
	# Depois que o POST foi aceito, nunca repita o cadastro do equipamento. A
	# fila pode chamar este fluxo novamente somente para continuar a partir da
	# leitura confirmada do IMEI.
	if bool(request.get("_skip_equipment_registration", false)):
		var pending_row: Variant = request.get("_pending_equipment_row", {})
		if typeof(pending_row) != TYPE_DICTIONARY or (pending_row as Dictionary).is_empty():
			return {
				"ok": true,
				"partial": true,
				"confirmation_pending": true,
				"message": "O equipamento foi aceito, mas a leitura de confirmacao ainda nao retornou uma linha segura.",
				"request": request,
			}
		equipment_result = {
			"ok": true,
			"row": (pending_row as Dictionary).duplicate(true),
			"api": true,
			"confirmed_after_pending": true,
		}
	else:
		equipment_result = await _register_or_find_modern_equipment(request)
	if _equipment_registration_timed_out():
		return _equipment_registration_timeout_result("confirmacao do equipamento")
	if bool(equipment_result.get("confirmation_pending", false)):
		request["_smart_confirmation_pending"] = true
		return {
			"ok": true,
			"partial": true,
			"confirmation_pending": true,
			"message": str(equipment_result.get("message", "A API aceitou o equipamento, mas a confirmacao ainda esta pendente.")),
			"response_code": int(equipment_result.get("response_code", 0)),
			"equipment": equipment_result,
			"request": request,
		}
	if not bool(equipment_result.get("ok", false)):
		# A API e sempre tentada primeiro. Se ela falhar antes de aceitar a
		# gravacao, o formulario web assume a operacao; respostas parciais nunca
		# sao repetidas para evitar duplicidade.
		if bool(equipment_result.get("fallback_web", false)) and not bool(equipment_result.get("partial", false)):
			_remote_queue_stage(request, "Cadastro do equipamento", "API indisponivel; usando portal web", "fallback", "Fallback web")
			_show_equipment_registration_feedback(
				"Cadastro remoto em andamento",
				"API de equipamentos indisponivel; usando o portal web como fallback",
				str(equipment_result.get("message", "A API nao aceitou o cadastro do equipamento.")),
				ORANGE
			)
			equipment_result = await _register_modern_equipment_via_web(request)
			if _equipment_registration_timed_out():
				return _equipment_registration_timeout_result("fallback web do equipamento")
		if not bool(equipment_result.get("ok", false)):
			return equipment_result
	# Um HTTP 2xx da gravacao nao basta: confirme a serie e compare os dados
	# explicitos do chip antes de iniciar a etapa da placa. Se a API ainda estiver
	# propagando a linha, mantenha a operacao pendente e nao repita pelo portal.
	if not bool(equipment_result.get("web", false)):
		var equipment_confirmation := await _confirm_smart_registered_equipment(request, equipment_result)
		if not bool(equipment_confirmation.get("ok", false)):
			return equipment_confirmation
		if typeof(equipment_confirmation.get("row", {})) == TYPE_DICTIONARY:
			equipment_result["row"] = equipment_confirmation.get("row", {})
	request["_smart_plan_state"] = "equipment_confirmed"
	if bool(request.get("equipment_only", false)):
		return {"ok": true, "equipment": equipment_result, "equipment_only": true}

	_show_equipment_registration_feedback(
		"Cadastro remoto em andamento",
		"Equipamento confirmado; abrindo cadastro do veiculo",
		"Serie %s | agora a placa sera criada com o aparelho vinculado." % serial,
		BLUE
	)
	_remote_queue_stage(request, "Vinculando com a placa", plate, "running", "API")
	if _equipment_registration_timed_out():
		return _equipment_registration_timeout_result("preparacao da placa")

	# A API oficial agora tambem grava a placa e a associacao. So usamos o
	# formulario web quando a rota de veiculos estiver ausente ou sem permissao;
	# uma resposta aceita sem confirmacao nunca e repetida por outro canal.
	var api_vehicle_result := await _grupo_rs_api_register_vehicle(request, equipment_result.get("row", {}) as Dictionary)
	if _equipment_registration_timed_out():
		return _equipment_registration_timeout_result("cadastro da placa e associacao")
	if bool(api_vehicle_result.get("ok", false)):
		# A associacao so e sucesso quando a rota devolve uma linha confirmada.
		# Quando a API apenas aceitou o POST e ainda nao publicou a linha, o
		# cadastro permanece pendente: nao finalizamos o estoque nem exibimos
		# "sucesso" com uma placa que ainda nao foi vinculada.
		if bool(api_vehicle_result.get("confirmation_pending", false)):
			request["_smart_confirmation_pending"] = true
			return {
				"ok": true,
				"partial": true,
				"confirmation_pending": true,
				"message": "A API aceitou a placa, mas ainda nao confirmou o equipamento vinculado. Nenhuma mensagem de sucesso foi emitida; tente sincronizar novamente quando a linha aparecer.",
				"equipment": equipment_result,
				"vehicle": api_vehicle_result,
				"request": request,
			}
		# A resposta confirmada da API ja prova placa + equipamento. Se a rota nao
		# devolveu uma linha (compatibilidade com respostas antigas), usamos a
		# verificacao HTML como segunda fonte antes de concluir; nunca concluimos
		# com um marcador inventado.
		var api_vehicle_row := api_vehicle_result.get("row", {}) as Dictionary
		if api_vehicle_row.is_empty():
			var full_vehicle_confirmation := await _verify_modern_vehicle_registration(serial, plate)
			if not bool(full_vehicle_confirmation.get("ok", false)):
				request["_smart_confirmation_pending"] = true
				return {
					"ok": true,
					"partial": true,
					"confirmation_pending": true,
					"pending_verify": true,
					"message": "A API aceitou a placa, mas a confirmacao do equipamento ainda nao foi publicada.",
					"equipment": equipment_result,
					"vehicle": api_vehicle_result,
					"request": request,
				}
			api_vehicle_result["full_verification"] = full_vehicle_confirmation
		request["_smart_plan_state"] = "remote_confirmed"
		return {"ok": true, "equipment": equipment_result, "vehicle": api_vehicle_result, "api_vehicle": true}
	if not bool(api_vehicle_result.get("fallback_web", false)):
		return api_vehicle_result
	_show_equipment_registration_feedback(
		"Cadastro remoto em andamento",
		"API de placas indisponivel; usando o portal web como fallback",
		str(api_vehicle_result.get("message", "A API nao aceitou a rota de veiculos.")),
		ORANGE
	)
	_remote_queue_stage(request, "Vinculando com a placa", plate, "fallback", "Fallback web")
	if _equipment_registration_timed_out():
		return _equipment_registration_timeout_result("fallback web da placa")

	var page: Dictionary = {}
	var built: Dictionary = {}
	for attempt in range(2):
		page = await _modern_grupo_rs_get("veiculos_editar.php?acao=novo")
		if not bool(page.get("ok", false)):
			return {"ok": false, "message": "Nao foi possivel abrir a tela de novo veiculo no Grupo RS."}
		var form_html := _extract_html_form_by_action(str(page.get("body", "")), "veiculos_actions.php")
		built = _build_modern_vehicle_registration_fields(form_html, request)
		if bool(built.get("ok", false)):
			break
		var build_message := str(built.get("message", ""))
		if not build_message.contains("lista Trocar Equipamento"):
			return built
		if attempt < 1:
			await get_tree().create_timer(0.8).timeout
	if not bool(built.get("ok", false)):
		return built

	_show_equipment_registration_feedback(
		"Cadastro remoto em andamento",
		"Salvando placa e vinculando equipamento",
		"Aguardando confirmacao do Grupo RS...",
		BLUE
	)
	var response := await _modern_grupo_rs_post_form(
		"veiculos_actions.php",
		built.get("fields", {}) as Dictionary,
		"veiculos_editar.php?acao=novo",
		true,
		0
	)
	if _equipment_registration_timed_out():
		return _equipment_registration_timeout_result("envio do formulario web")
	var transport_message := ""
	if not bool(response.get("ok", false)):
		transport_message = str(response.get("message", "Conexao encerrada antes da resposta.")).strip_edges()
	var verification := await _verify_modern_vehicle_registration(serial, plate)
	if _equipment_registration_timed_out():
		return _equipment_registration_timeout_result("confirmacao da placa e associacao")
	if bool(verification.get("ok", false)):
		return {"ok": true, "verification": verification, "transport_warning": transport_message, "api_vehicle": false}
	var message := str(verification.get("message", "O Grupo RS nao confirmou a placa e o equipamento."))
	if transport_message != "":
		message = "%s. %s" % [transport_message, message]
	return {"ok": false, "message": message, "partial": true}


func _retry_pending_equipment_registration(request: Dictionary, pending_result: Dictionary) -> Dictionary:
	"""Reconcilia uma escrita aceita sem repetir o POST.

	A API de cadastro pode responder antes de a listagem estar consistente. O
	IMEI e a placa enviados continuam sendo a mesma operacao; apenas lemos até
	que a linha apareça e retomamos a etapa seguinte.
	"""
	var serial := _digits_only(str(request.get("serial", request.get("remote_serial", ""))))
	if serial == "":
		return pending_result
	var equipment_pending := pending_result.get("equipment", {}) as Dictionary
	var vehicle_pending := pending_result.get("vehicle", {}) as Dictionary

	# Primeiro caso: o equipamento foi aceito, mas ainda nao apareceu. Depois da
	# leitura confirmada, continua para o vinculo da placa sem novo cadastro.
	if bool(equipment_pending.get("confirmation_pending", false)) and vehicle_pending.is_empty():
		var last_message := str(pending_result.get("message", "Aguardando publicacao do equipamento."))
		for attempt in range(REMOTE_PENDING_CONFIRMATION_ATTEMPTS + 2):
			if attempt > 0:
				await get_tree().create_timer(REMOTE_PENDING_CONFIRMATION_DELAY_SECONDS).timeout
			var confirmed := await _grupo_rs_api_find_equipment(serial, true)
			if bool(confirmed.get("ok", false)):
				request["_skip_equipment_registration"] = true
				request["_pending_equipment_row"] = (confirmed.get("row", {}) as Dictionary).duplicate(true)
				request.erase("_smart_confirmation_pending")
				return await _perform_equipment_registration(request)
			last_message = str(confirmed.get("message", last_message))
		var unresolved := pending_result.duplicate(true)
		unresolved["ok"] = true
		unresolved["partial"] = true
		unresolved["confirmation_pending"] = true
		unresolved["message"] = "%s A confirmacao sera retomada automaticamente sem repetir o cadastro." % last_message
		unresolved["request"] = request
		return unresolved

	# Segundo caso: o equipamento ja foi confirmado, mas a associacao veicular
	# ainda nao apareceu. Confirme a placa pela leitura completa do portal/API.
	if not vehicle_pending.is_empty() or not equipment_pending.is_empty():
		var plate := _format_grupo_rs_vehicle_plate(str(request.get("plate", request.get("vehicle_target_plate", ""))))
		if plate != "":
			var last_message := str(pending_result.get("message", "Aguardando confirmacao da placa."))
			for attempt in range(REMOTE_PENDING_CONFIRMATION_ATTEMPTS + 2):
				if attempt > 0:
					await get_tree().create_timer(REMOTE_PENDING_CONFIRMATION_DELAY_SECONDS).timeout
				var confirmation := await _verify_modern_vehicle_registration(serial, plate)
				if bool(confirmation.get("ok", false)):
					var resumed := pending_result.duplicate(true)
					resumed["ok"] = true
					resumed.erase("confirmation_pending")
					resumed["partial"] = false
					resumed["api_vehicle"] = true
					resumed["full_verification"] = confirmation
					request.erase("_smart_confirmation_pending")
					resumed["request"] = request
					return resumed
				last_message = str(confirmation.get("message", last_message))
			var unresolved := pending_result.duplicate(true)
			unresolved["ok"] = true
			unresolved["partial"] = true
			unresolved["confirmation_pending"] = true
			unresolved["message"] = "%s A confirmacao sera retomada automaticamente sem repetir a operacao." % last_message
			unresolved["request"] = request
			return unresolved
	return pending_result


func _register_or_find_modern_equipment(request: Dictionary) -> Dictionary:
	_show_equipment_registration_feedback(
		"Cadastro remoto em andamento",
		"Gravando equipamento pela API oficial",
		"Serie %s | APN %s | sem abrir o formulario web." % [str(request.get("serial", "")), str(request.get("apn", ""))],
		BLUE
	)
	return await _grupo_rs_api_register_equipment(request)


func _register_modern_equipment_via_web(request: Dictionary) -> Dictionary:
	var page := await _modern_grupo_rs_get("equipamentos_editar.php?acao=novo")
	if not bool(page.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel abrir a tela de novo equipamento no Grupo RS.", "fallback_web": true}
	var form_html := _extract_html_form_by_action(str(page.get("body", "")), "equipamentos_actions.php")
	var submit_action := "equipamentos_actions.php"
	if form_html == "":
		# O portal novo usa singular em algumas bases: equipamentos_action.php.
		# O formulario e a mesma operacao; apenas o endpoint de POST mudou.
		form_html = _extract_html_form_by_action(str(page.get("body", "")), "equipamentos_action.php")
		submit_action = "equipamentos_action.php"
	var built := _build_modern_equipment_registration_fields(form_html, request)
	if not bool(built.get("ok", false)):
		return built
	var response := await _modern_grupo_rs_post_form(
		submit_action,
		built.get("fields", {}) as Dictionary,
		"equipamentos_editar.php?acao=novo",
		true,
		0
	)
	var transport_message := ""
	if not bool(response.get("ok", false)):
		transport_message = str(response.get("message", "Conexao encerrada antes da resposta.")).strip_edges()
	var confirmed := await _wait_for_modern_equipment_row(str(request.get("serial", "")))
	if bool(confirmed.get("ok", false)):
		return {
			"ok": true,
			"row": confirmed.get("row", {}),
			"existing": false,
			"web": true,
			"transport_warning": transport_message,
		}
	var message := str(confirmed.get("message", "O portal web nao confirmou o equipamento."))
	if transport_message != "":
		message = "%s. %s" % [transport_message, message]
	return {"ok": false, "message": message, "partial": not transport_message.is_empty(), "fallback_web": true}


func _build_modern_equipment_registration_fields(form_html: String, request: Dictionary) -> Dictionary:
	if form_html == "":
		return {"ok": false, "message": "O formulario de novo equipamento nao foi identificado."}
	var fields := _legacy_form_fields(form_html)
	var serial := _digits_only(str(request.get("serial", "")))
	var apn := str(request.get("apn", "")).strip_edges().to_lower()
	var chip := _digits_only(str(request.get("chip_number", "")))
	var phone := _local_registration_phone(str(request.get("phone", "")))
	if serial == "" or apn == "" or chip == "" or phone == "":
		return {"ok": false, "message": "Serie, APN, ICCID e telefone sao obrigatorios no equipamento remoto."}
	var model_id := _html_select_option_value_by_label(form_html, "CodModelo", "RS 300")
	var operator_label := str(request.get("operator", "")).strip_edges()
	if operator_label == "" or _search_key(operator_label) == _search_key("selecione"):
		return {"ok": false, "message": "Selecione a operadora antes do cadastro remoto."}
	var operator_id := _html_select_option_value_by_label(form_html, "CodOperadora", operator_label)
	if operator_id == "":
		return {
			"ok": false,
			"message": "A operadora %s nao apareceu no catalogo remoto; o cadastro foi bloqueado para evitar substituicao por outra operadora." % operator_label,
			"operator_catalog_missing": true,
		}
	if model_id == "" or operator_id == "":
		return {"ok": false, "message": "Modelo RS 300 ou operadora nao apareceu no formulario remoto."}
	fields["CodEquipamento"] = "0"
	fields["NumeroEquipamento"] = serial
	fields["NumeroSerie"] = serial
	fields["Apn"] = apn
	fields["NumeroChip"] = chip
	fields["NumeroTelefone"] = phone
	fields["CodModelo"] = model_id
	fields["CodOperadora"] = operator_id
	# O portal so processa o cadastro quando o submit nomeado chega junto do formulario.
	fields["salvar"] = "1"
	return {"ok": true, "fields": fields}


func _wait_for_modern_equipment_row(serial: String) -> Dictionary:
	var serial_key := _search_key(serial)
	for attempt in range(2):
		var response := await _modern_grupo_rs_get("equipamentos_listar.php?busca=%s&status=todos" % serial.uri_encode())
		if bool(response.get("ok", false)):
			var rows := _parse_grupo_rs_equipment_rows(str(response.get("body", "")))
			for row in rows:
				if _search_key(str(row.get("serial", ""))) == serial_key:
					return {"ok": true, "row": row}
		if attempt < 1:
			await get_tree().create_timer(0.8).timeout
	return {"ok": false, "message": "O equipamento foi enviado, mas nao apareceu na lista do Grupo RS apos as tentativas de confirmacao."}


func _is_modern_equipment_unlinked_plate(value: String) -> bool:
	var clean := _search_key(value)
	return clean == "" or clean == "-" or clean.contains("semequip") or clean.contains("naoequip") or clean.contains("estoque")


func _build_modern_vehicle_registration_fields(form_html: String, request: Dictionary) -> Dictionary:
	if form_html == "":
		return {"ok": false, "message": "O formulario de novo veiculo nao foi identificado."}
	var fields := _legacy_form_fields(form_html)
	var client_id := _html_select_option_value_by_label(form_html, "CodCliente", "RS300")
	var vehicle_type_id := _html_select_option_value_by_label(form_html, "CodTipoVeiculo", "Carro")
	if client_id == "":
		return {"ok": false, "message": "O cliente titular RS300 nao apareceu no formulario remoto."}
	if vehicle_type_id == "":
		return {"ok": false, "message": "O tipo de veiculo Carro nao apareceu no formulario remoto."}
	var serial := _digits_only(str(request.get("serial", "")))
	var equipment_value := ""
	for option in _legacy_select_options(form_html, "TrocarEquip"):
		var value := str(option.get("value", "")).strip_edges()
		var label := str(option.get("label", "")).strip_edges()
		if _digits_only(value) == serial or _digits_only(label) == serial or label.contains(serial):
			equipment_value = value if value != "" else label
			break
	if equipment_value == "":
		return {"ok": false, "message": "O aparelho ainda nao apareceu na lista Trocar Equipamento do Grupo RS."}
	var action := str(fields.get("acao", "")).strip_edges()
	if action == "":
		fields["acao"] = "cadastrar"
	fields["TipoIdentificacao"] = "placa"
	fields["Placa"] = _format_grupo_rs_vehicle_plate(str(request.get("plate", "")))
	fields["CodCliente"] = client_id
	fields["CodTipoVeiculo"] = vehicle_type_id
	fields["TrocarEquip"] = equipment_value
	var metadata_map := {
		"Modelo": "vehicle_model",
		"Marca": "vehicle_brand",
		"Ano": "vehicle_year",
		"Cor": "vehicle_color",
		"Chassi": "vehicle_chassis",
		"Observacao": "vehicle_observation",
	}
	for field_name in metadata_map.keys():
		if not fields.has(field_name):
			continue
		var requested_value := str(request.get(metadata_map[field_name], "")).strip_edges()
		fields[field_name] = requested_value if requested_value != "" else ("" if bool(request.get("clear_vehicle_fields", true)) else str(fields.get(field_name, "")))
	if fields.has("DataCompra") and bool(request.get("clear_vehicle_fields", true)):
		fields["DataCompra"] = ""
	return {"ok": true, "fields": fields}


func _verify_modern_vehicle_registration(serial: String, plate: String) -> Dictionary:
	var last_message := "O aparelho nao apareceu vinculado a placa esperada."
	for attempt in range(GRUPO_RS_WEB_CONFIRM_ATTEMPTS):
		if attempt > 0:
			var delay_seconds := minf(
				GRUPO_RS_WEB_CONFIRM_INITIAL_DELAY_SECONDS + ((attempt - 1) * GRUPO_RS_WEB_CONFIRM_STEP_SECONDS),
				GRUPO_RS_WEB_CONFIRM_MAX_DELAY_SECONDS
			)
			await get_tree().create_timer(delay_seconds).timeout
		var equipment_response := await _modern_grupo_rs_get("equipamentos_listar.php?busca=%s&status=todos&__codex_refresh=%s" % [serial.uri_encode(), str(Time.get_ticks_msec()).uri_encode()])
		if not bool(equipment_response.get("ok", false)):
			last_message = "Nao foi possivel verificar o aparelho vinculado."
			continue
		var equipment_rows := _parse_grupo_rs_equipment_rows(str(equipment_response.get("body", "")))
		var equipment := _choose_grupo_rs_equipment_row_exact(equipment_rows, serial, plate)
		if equipment.is_empty():
			# A tabela de equipamentos de algumas versoes do portal usa a coluna
			# "modelo" no lugar da placa. A serie continua sendo a chave unica e
			# pode confirmar a associacao sem inventar uma placa.
			equipment = _choose_modern_grupo_rs_equipment_row_by_serial_exact(equipment_rows, serial)
		if equipment.is_empty():
			last_message = "O aparelho ainda nao apareceu vinculado a placa esperada."
			continue
		var vehicle_response := await _fetch_modern_grupo_rs_vehicle_rows_all_statuses(plate, true)
		if not bool(vehicle_response.get("ok", false)):
			last_message = "A placa foi criada, mas a lista de veiculos nao respondeu para verificacao."
			continue
		var vehicle_rows: Array[Dictionary] = vehicle_response.get("rows", []) as Array[Dictionary]
		var vehicle := _choose_modern_grupo_rs_vehicle_row_exact(vehicle_rows, serial, plate)
		if vehicle.is_empty():
			var plate_matches: Array[Dictionary] = []
			for candidate in vehicle_rows:
				if _normalize_location_plate(str(candidate.get("plate", ""))) == _normalize_location_plate(plate):
					plate_matches.append(candidate)
			if plate_matches.size() == 1:
				vehicle = plate_matches[0]
		if vehicle.is_empty():
			last_message = "A placa apareceu, mas ainda nao foi encontrada com o equipamento correto."
			continue
		var edit_href := str(vehicle.get("edit_href", "")).strip_edges()
		if edit_href == "":
			last_message = "O Grupo RS nao forneceu a tela para confirmar os campos do veiculo."
			continue
		var edit_response := await _modern_grupo_rs_get(edit_href)
		if not bool(edit_response.get("ok", false)):
			last_message = "Nao foi possivel abrir a confirmacao final do veiculo."
			continue
		var snapshot := _modern_vehicle_edit_snapshot(str(edit_response.get("body", "")))
		if _modern_vehicle_snapshot_matches_registration(snapshot, plate):
			return {"ok": true, "equipment": equipment, "vehicle": vehicle, "snapshot": snapshot}
		last_message = "O Grupo RS ainda nao confirmou RS300 e Carro na verificacao final."
	return {"ok": false, "message": "%s A verificacao foi repetida %d vezes." % [last_message, GRUPO_RS_WEB_CONFIRM_ATTEMPTS]}


func _reconcile_pending_equipment_registration(request: Dictionary, equipment_result: Dictionary, vehicle_result: Dictionary) -> Dictionary:
	var serial := _digits_only(str(request.get("serial", "")))
	var plate := _format_grupo_rs_vehicle_plate(str(request.get("plate", "")))
	var last_message := "A confirmacao completa ainda nao foi publicada pelo Grupo RS."
	for attempt in range(REMOTE_PENDING_CONFIRMATION_ATTEMPTS):
		if attempt > 0:
			await get_tree().create_timer(REMOTE_PENDING_CONFIRMATION_DELAY_SECONDS).timeout
		if _equipment_registration_timed_out():
			break
		var confirmation := await _verify_modern_vehicle_registration(serial, plate)
		if bool(confirmation.get("ok", false)):
			return {
				"ok": true,
				"equipment": equipment_result,
				"vehicle": vehicle_result,
				"api_vehicle": true,
				"reconciled": true,
				"full_verification": confirmation,
			}
		last_message = str(confirmation.get("message", last_message))
	return {
		"ok": false,
		"partial": true,
		"confirmation_pending": true,
		"message": "%s A API ja aceitou a placa; a operacao sera retomada pela proxima leitura, sem repetir o cadastro." % last_message,
		"equipment": equipment_result,
		"vehicle": vehicle_result,
	}


func _modern_vehicle_snapshot_matches_registration(snapshot: Dictionary, target_plate: String) -> bool:
	return not snapshot.is_empty() \
		and _normalize_location_plate(str(snapshot.get("plate", ""))) == _normalize_location_plate(target_plate) \
		and _search_key(str(snapshot.get("client", ""))) == _search_key("RS300") \
		and _search_key(str(snapshot.get("vehicle_type", ""))) == _search_key("Carro")


func _finalize_local_equipment_registration(local_product: Dictionary, request: Dictionary) -> Dictionary:
	var sku := str(request.get("local_sku", local_product.get("sku", ""))).strip_edges()
	var product := store.get_product(sku)
	if product.is_empty():
		product = local_product.duplicate(true)
	var equipment_only := bool(request.get("equipment_only", false))
	var requested_status := str(request.get("tracker_status", product.get("tracker_status", "Estoque"))).strip_edges()
	var final_status := _registration_final_status(requested_status, equipment_only)
	var final_status_key := _status_key_from_text(final_status)
	var remote_confirmation_pending := bool(request.get("_smart_confirmation_pending", false))
	product["sku"] = sku
	product["imei"] = str(request.get("serial", product.get("imei", "")))
	product["equipment_number"] = str(request.get("serial", product.get("equipment_number", "")))
	product["plate"] = "" if equipment_only or remote_confirmation_pending else str(request.get("plate", ""))
	# RS300 e um padrao interno do equipamento; a placa, por outro lado, so
	# aparece quando a associacao remota foi confirmada.
	product["client"] = "" if equipment_only else "RS300"
	product["tracker_status"] = final_status
	product["status"] = final_status
	product["location"] = final_status
	product["stock"] = 1 if final_status_key == "estoque" else 0
	product["remote_registration_status"] = "confirmacao_pendente" if remote_confirmation_pending else ("equipamento_cadastrado" if equipment_only else "vinculado")
	var note := (
		"Cadastro aceito pela API; confirmacao completa pendente para a placa %s" % str(request.get("plate", ""))
		if remote_confirmation_pending
		else (
			"Equipamento cadastrado no Grupo RS pela API: status %s" % final_status
			if equipment_only
			else "Veiculo criado e equipamento vinculado no Grupo RS: %s" % str(request.get("plate", ""))
		)
	)
	var notes := str(product.get("notes", "")).strip_edges()
	if not notes.contains(note):
		product["notes"] = "%s | %s" % [notes, note] if notes != "" else note
	var saved := store.upsert_product_replacing_sku(sku, product)
	return {"ok": not saved.is_empty(), "product": saved, "message": "Falha ao salvar o status %s localmente." % final_status if saved.is_empty() else ""}


func _registration_final_status(requested_status: String, _equipment_only: bool = false) -> String:
	var clean_status := requested_status.strip_edges()
	return clean_status if clean_status != "" else "Estoque"


func _request_modify_grupo_rs_equipment() -> void:
	if not _grupo_rs_supports_modern_api():
		_show_warning("Modificacao remota", "Esta funcao esta disponivel somente para Imperatriz no Grupo RS novo.")
		return

	var remote_serial := str(form_grupo_rs_data.get("serial", "")).strip_edges()
	if remote_serial == "":
		remote_serial = _digits_only(_field_text("imei"))
	var old_plate := str(form_grupo_rs_data.get("plate", "")).strip_edges()
	var requested_plate := _format_grupo_rs_vehicle_plate(_field_text("plate"))
	if remote_serial == "":
		_show_warning("Modificacao remota", "Use Buscar no Grupo RS e confirme o aparelho antes de continuar.")
		return
	if (remote_queue_controller != null and remote_queue_controller.has_serial(remote_serial)) or _equipment_api_edit_queue_contains_serial(_digits_only(remote_serial)):
		_show_warning("Modificacao remota", "Existe outra edicao remota aguardando confirmacao para este aparelho.")
		return
	if requested_plate != "" and not _is_valid_grupo_rs_vehicle_reassignment_plate(requested_plate):
		_show_warning("Modificacao remota", "Informe uma placa valida ou deixe o campo vazio para manter a placa atual.")
		return

	var chip := _digits_only(_field_text("chip_number"))
	var phone := _local_registration_phone(_field_text("chip_phone"))
	var apn := _selected_option_text(form_options.get("apn_source"), true).strip_edges().to_lower()
	var raw_chip := _field_text("chip_number")
	var raw_phone := _field_text("chip_phone")
	var raw_apn := _selected_option_text(form_options.get("apn_source"), true).strip_edges().to_lower()
	var typed_chip := _digits_only(raw_chip)
	var typed_phone := _local_registration_phone(raw_phone)
	if chip == "":
		chip = _digits_only(str(form_grupo_rs_data.get("chip", "")))
	if phone == "":
		phone = _local_registration_phone(str(form_grupo_rs_data.get("phone", "")))
	if apn == "":
		apn = str(form_grupo_rs_data.get("apn", "")).strip_edges().to_lower()
	if raw_chip.strip_edges() != "" and (typed_chip == "" or typed_chip.length() < 8):
		_show_warning("Modificacao remota", "Informe um ICCID valido com pelo menos 8 digitos.")
		return
	if raw_phone.strip_edges() != "" and typed_phone == "":
		_show_warning("Modificacao remota", "Informe um telefone valido com 10 ou 11 digitos.")
		return
	if raw_apn != "" and not _apn_is_hinova(raw_apn) and not _apn_is_linksolutions(raw_apn):
		_show_warning("Modificacao remota", "A APN deve ser hinova.br ou linksolutions.br.")
		return
	var current_plate := _format_grupo_rs_vehicle_plate(old_plate)
	var associate_vehicle := form_associate_vehicle_toggle == null or form_associate_vehicle_toggle.button_pressed
	var clear_previous_link := form_clear_previous_toggle != null and form_clear_previous_toggle.button_pressed
	var selected_status_for_policy := _selected_option_text(form_options.get("tracker_status"), false).strip_edges()
	# O formulario moderno nao exibe um checkbox destrutivo. Para a operacao
	# comum de devolucao, limpar a placa e escolher Estoque equivale a confirmar
	# a remocao do vinculo anterior.
	if form_mode == "reentry" and current_plate != "" and requested_plate == "" \
			and _search_key(selected_status_for_policy) == _search_key("Estoque"):
		associate_vehicle = false
		clear_previous_link = true
	if current_plate != "" and not associate_vehicle and not clear_previous_link:
		_show_warning("Reentrada incompleta", "Para devolver um aparelho vinculado ao estoque, marque 'Limpar dados do vinculo anterior'. Isso evita remover uma associacao por engano.")
		return
	if associate_vehicle and requested_plate == "" and current_plate == "":
		_show_warning("Novo vinculo", "Informe uma placa valida ou desative a associacao veicular para salvar somente no estoque.")
		return
	# Quando a placa nao muda, mantemos o alvo atual apenas para a reconciliacao
	# explicita. A limpeza/desassociacao, por outro lado, nunca e inferida.
	var vehicle_target_plate := requested_plate if associate_vehicle and requested_plate != "" else (current_plate if associate_vehicle else "")
	var current_chip := _digits_only(str(form_grupo_rs_data.get("chip", "")))
	var current_phone := _local_registration_phone(str(form_grupo_rs_data.get("phone", "")))
	var current_apn := str(form_grupo_rs_data.get("apn", "")).strip_edges().to_lower()
	var local_product := store.get_product(editing_sku if editing_sku != "" else remote_serial) if store != null else {}
	var selected_model := _selected_option_text(form_options.get("model"), true).strip_edges()
	var current_model := str(local_product.get("model", local_product.get("category", ""))).strip_edges()
	var selected_status := _selected_option_text(form_options.get("tracker_status"), false).strip_edges()
	var current_status := str(local_product.get("tracker_status", local_product.get("status", "Estoque"))).strip_edges()
	var selected_operator := _selected_option_text(form_options.get("operator"), true).strip_edges()
	var current_operator := str(local_product.get("operator", form_grupo_rs_data.get("operator", ""))).strip_edges()
	var plate_changed := requested_plate != "" and _normalize_location_plate(requested_plate) != _normalize_location_plate(current_plate)
	# Ao trocar a placa, a ficha do veiculo anterior nao pode ser carregada para
	# o novo vinculo. O portal recebe a instrucao de limpar modelo, marca, ano,
	# cor, chassi e observacoes; esses dados serao preenchidos apenas se o
	# operador os informar posteriormente na plataforma.
	var clear_vehicle_fields_for_change := clear_previous_link or (plate_changed and associate_vehicle)
	var model_changed := selected_model != "" and _search_key(selected_model) != _search_key(current_model)
	var operator_changed := selected_operator != "" and _search_key(selected_operator) != _search_key(current_operator)
	var status_changed := selected_status != "" and _search_key(selected_status) != _search_key(current_status)
	var vehicle_policy_needs_reconciliation := (associate_vehicle and current_plate != "") or clear_previous_link
	var fields_changed := plate_changed or chip != current_chip or phone != current_phone or apn != current_apn or model_changed or operator_changed or status_changed or vehicle_policy_needs_reconciliation
	if not fields_changed:
		_show_warning("Modificacao remota", "Nenhum campo foi alterado e nao existe associacao veicular para reconciliar.")
		return

	var request := {
		"local_sku": editing_sku if editing_sku != "" else _field_text("imei"),
		"serial": remote_serial,
		"remote_serial": remote_serial,
		"old_plate": current_plate,
		"new_plate": vehicle_target_plate,
		"vehicle_target_plate": vehicle_target_plate,
		"apply_vehicle_policy": associate_vehicle and vehicle_target_plate != "",
		"vehicle_association_requested": associate_vehicle,
		"clear_vehicle_association": clear_previous_link and not associate_vehicle,
		"clear_vehicle_fields": clear_vehicle_fields_for_change,
		"vehicle_model": _field_text("vehicle_model"),
		"vehicle_brand": _field_text("vehicle_brand"),
		"vehicle_year": _field_text("vehicle_year"),
		"vehicle_color": _field_text("vehicle_color"),
		"vehicle_chassis": _field_text("vehicle_chassis"),
		"vehicle_observation": _field_text("vehicle_observation"),
		"client": _selected_option_text(form_options.get("client"), false),
		"vehicle_type": _selected_option_text(form_options.get("vehicle_type"), false),
		"old_client": str(form_grupo_rs_data.get("client", "")).strip_edges(),
		"model": selected_model,
		"operator": selected_operator,
		"tracker_status": selected_status,
		"model_changed": model_changed,
		"status_changed": status_changed,
		"chip": chip,
		"chip_number": chip,
		"phone": phone,
		"apn": apn,
		"equipment_fields_changed": chip != current_chip or phone != current_phone or apn != current_apn or model_changed or operator_changed,
	}
	_show_vehicle_reassignment_password_dialog(request)


# Compatibilidade para chamadas internas antigas: a acao exibida na tela agora
# e Modificar e passa sempre pelo fluxo unificado acima.
func _request_modern_grupo_rs_vehicle_reassignment() -> void:
	_request_modify_grupo_rs_equipment()


func _perform_equipment_modification(request: Dictionary, progress: CanvasLayer = null) -> Dictionary:
	var serial := _digits_only(str(request.get("serial", request.get("remote_serial", ""))))
	if serial == "":
		return {"ok": false, "message": "Numero de serie ausente para a modificacao remota."}
	_set_progress_dialog_content(progress, "1/3 Consultando o equipamento pela API oficial", "Serie %s" % serial)
	var found := await _grupo_rs_api_find_equipment(serial, true)
	if _grupo_rs_api_is_permission_denied(found):
		var portal_login := await _grupo_rs_api_login_as_portal()
		if bool(portal_login.get("ok", false)):
			found = await _grupo_rs_api_find_equipment(serial, true)
	var equipment_activated := false
	if bool(found.get("ok", false)):
		_set_progress_dialog_content(progress, "2/3 Verificando status do aparelho", "Ativando automaticamente se estiver inativo")
		var activation := await _grupo_rs_api_activate_equipment(found.get("row", {}) as Dictionary, serial)
		if not bool(activation.get("ok", false)):
			# Algumas instalacoes deixam a acao de ativar somente no portal web.
			# Nao encerre a modificacao antes de tentar o comando exposto para o
			# mesmo serial; a leitura posterior continua obrigatoria.
			var portal_activation_after_api_error := await _activate_modern_grupo_rs_equipment_if_needed(serial)
			if not bool(portal_activation_after_api_error.get("ok", false)):
				return portal_activation_after_api_error
			activation = portal_activation_after_api_error
		else:
			# Mesmo quando a API diz que ativou, confirme o estado no portal para
			# evitar concluir com o equipamento ainda Inativo na plataforma.
			var portal_activation := await _activate_modern_grupo_rs_equipment_if_needed(serial)
			if not bool(portal_activation.get("ok", false)):
				return portal_activation
			if bool(portal_activation.get("activated", false)):
				activation = portal_activation
		equipment_activated = bool(activation.get("activated", false))
		if equipment_activated:
			found["row"] = activation.get("row", found.get("row", {}))
	else:
		# Quando a API principal estiver indisponivel, ainda assim verifique o
		# estado no portal antes de executar o fallback de edicao.
		var portal_activation_without_api := await _activate_modern_grupo_rs_equipment_if_needed(serial)
		if not bool(portal_activation_without_api.get("ok", false)):
			return portal_activation_without_api
		equipment_activated = bool(portal_activation_without_api.get("activated", false))
	var equipment_result: Dictionary = {"ok": true, "skipped": true}
	if not bool(request.get("equipment_fields_changed", true)):
		_set_progress_dialog_content(progress, "2/3 Equipamento sem alteracoes", "Somente a placa sera modificada")
	elif bool(found.get("ok", false)):
		_set_progress_dialog_content(progress, "2/3 Atualizando chip, telefone e APN", "A API altera somente os campos informados")
		equipment_result = await _grupo_rs_api_patch_equipment(request, found.get("row", {}) as Dictionary)
		if not bool(equipment_result.get("ok", false)) and bool(equipment_result.get("fallback_web", false)):
			equipment_result = await _modify_modern_equipment_via_web(request)
	elif bool(request.get("equipment_fields_changed", true)):
		_set_progress_dialog_content(progress, "2/3 API indisponivel; usando o portal web", "A serie foi confirmada na consulta do Grupo RS")
		equipment_result = await _modify_modern_equipment_via_web(request)
	if not bool(equipment_result.get("ok", false)):
		return equipment_result
	if bool(request.get("clear_vehicle_association", false)):
		_set_progress_dialog_content(progress, "3/3 Removendo o vinculo veicular", "Acao explicita de devolucao ao estoque")
		var unlinked := await _delete_modern_grupo_rs_vehicle_for_serial(serial)
		if not bool(unlinked.get("ok", false)):
			return {"ok": false, "message": str(unlinked.get("message", "Nao foi possivel limpar o vinculo veicular.")), "vehicle": unlinked}
		return {"ok": true, "equipment": equipment_result, "vehicle": unlinked, "unlinked": true, "equipment_activated": equipment_activated}

	var new_plate := _format_grupo_rs_vehicle_plate(str(request.get("vehicle_target_plate", request.get("new_plate", ""))))
	var old_plate := _format_grupo_rs_vehicle_plate(str(request.get("old_plate", "")))
	# Mesmo sem trocar a placa, a associacao pode estar com titular/tipo/dados
	# legados. Reaplique a politica na placa atual quando houver uma associacao.
	if new_plate != "" and bool(request.get("apply_vehicle_policy", true)):
		_set_progress_dialog_content(progress, "3/3 Modificando a placa e confirmando o vinculo", "%s -> %s" % [old_plate if old_plate != "" else "sem placa", new_plate])
		var vehicle_request := request.duplicate(true)
		vehicle_request["new_plate"] = new_plate
		vehicle_request["vehicle_target_plate"] = new_plate
		vehicle_request["apply_vehicle_policy"] = true
		var vehicle_result := await _perform_api_vehicle_modification(vehicle_request)
		if not bool(vehicle_result.get("handled", false)):
			vehicle_result = await _perform_modern_vehicle_modification(vehicle_request)
		if not bool(vehicle_result.get("ok", false)):
			return vehicle_result
		return {"ok": true, "equipment": equipment_result, "vehicle": vehicle_result, "equipment_activated": equipment_activated}
	return {"ok": true, "equipment": equipment_result, "vehicle": {"ok": true, "skipped": true}, "equipment_activated": equipment_activated}


func _perform_api_vehicle_modification(request: Dictionary) -> Dictionary:
	var serial := _digits_only(str(request.get("remote_serial", request.get("serial", ""))))
	var old_plate := _format_grupo_rs_vehicle_plate(str(request.get("old_plate", "")))
	var new_plate := _format_grupo_rs_vehicle_plate(str(request.get("vehicle_target_plate", request.get("new_plate", ""))))
	if new_plate == "":
		return {"handled": true, "ok": true, "skipped": true}

	var current_result: Dictionary
	if old_plate != "":
		current_result = await _grupo_rs_api_find_vehicle(old_plate, serial, true, false)
	if not bool(current_result.get("ok", false)):
		current_result = await _grupo_rs_api_find_vehicle("", serial, true, false)
	if not bool(current_result.get("ok", false)):
		# Modificar nunca cadastra uma associacao nova. Sem um veiculo existente,
		# interrompa o fluxo e oriente o operador a usar "Novo equipamento".
		# Isso evita que uma falha de consulta transforme uma alteracao em cadastro
		# duplicado ou deixe o equipamento associado a uma placa inesperada.
		var lookup_code := int(current_result.get("response_code", 0))
		var not_found := bool(current_result.get("not_found", false)) or lookup_code in [0, 404]
		if old_plate != "" and not not_found:
			return {"handled": false, "fallback_web": true, "message": str(current_result.get("message", "A API nao confirmou a associacao atual.")), "response_code": lookup_code}
		return {
			"handled": true,
			"ok": false,
			"no_existing_vehicle": true,
			"response_code": lookup_code,
			"message": "O aparelho %s nao possui um veiculo vinculado para modificar. Use 'Novo equipamento' para cadastrar uma nova placa." % serial,
		}

	var current := current_result.get("row", {}) as Dictionary
	var current_id := str(current.get("vehicle_id", "")).strip_edges()
	if current_id == "":
		return {"handled": false, "fallback_web": true, "message": "A API nao informou o codigo da associacao atual."}
	var collision := await _grupo_rs_api_find_vehicle(new_plate, "", true, false)
	if bool(collision.get("ok", false)):
		var collision_id := str((collision.get("row", {}) as Dictionary).get("vehicle_id", "")).strip_edges()
		if collision_id != current_id:
			return {"handled": true, "ok": false, "message": "A placa %s ja pertence a outro veiculo." % new_plate}
		# Mesmo que a placa ja esteja no mesmo veiculo, continue pelo PATCH para
		# aplicar a padronizacao RS300/Carro e limpar os dados antigos.
	var collision_code := int(collision.get("response_code", 0))
	# HTTP 200 com zero linhas e a resposta normal da API para uma placa nova.
	# Somente falhas reais de consulta devem liberar o fallback web.
	if collision_code not in [0, 404] and not bool(collision.get("not_found", false)):
		return {"handled": false, "fallback_web": true, "message": str(collision.get("message", "Nao foi possivel validar a nova placa.")), "response_code": collision_code}
	var api_request := request.duplicate(true)
	# A troca de placa inicia uma nova ficha veicular: nao reutilize os dados do
	# veiculo anterior (modelo, marca, ano, cor, chassi e observacoes).
	api_request["force_rs300_titular"] = bool(request.get("force_rs300_titular", true))
	api_request["clear_vehicle_fields"] = bool(request.get("clear_vehicle_fields", false))
	api_request["vehicle_type"] = str(request.get("vehicle_type", "Carro")).strip_edges()
	if api_request["vehicle_type"] == "":
		api_request["vehicle_type"] = "Carro"
	api_request["api_vehicle_type_id"] = int(request.get("api_vehicle_type_id", 1))
	api_request["api_display_plate"] = true
	api_request["api_vehicle_status"] = "A"
	var client_resolution := await _grupo_rs_api_resolve_rs300_client_id()
	if not bool(client_resolution.get("ok", false)):
		return {"handled": false, "fallback_web": true, "message": str(client_resolution.get("message", "Nao foi possivel resolver o titular RS300 para a API."))}
	api_request["api_client_id"] = str(client_resolution.get("client_id", ""))
	var updated := await _grupo_rs_api_update_vehicle(api_request, current, new_plate)
	if bool(updated.get("fallback_web", false)):
		return {"handled": false, "fallback_web": true, "message": str(updated.get("message", "A API nao permitiu modificar a placa."))}
	if not bool(updated.get("ok", false)):
		return {"handled": true, "ok": false, "message": str(updated.get("message", "A API nao confirmou a modificacao da placa."))}
	# A API pode confirmar a placa e o equipamento sem devolver a ficha completa.
	# Nesse caso nao trate o payload enviado como prova: confirme os campos reais
	# e somente depois decida se o portal web precisa assumir como fallback.
	var updated_row := updated.get("row", {}) as Dictionary
	if _grupo_rs_api_reassignment_row_is_complete(updated_row, new_plate, bool(api_request.get("clear_vehicle_fields", false))):
		return {"handled": true, "ok": true, "api": true, "row": updated_row, "policy_verified": "api"}
	var portal_verification := await _verify_modern_grupo_rs_vehicle_reassignment(serial, new_plate, bool(api_request.get("clear_vehicle_fields", false)), api_request)
	if not bool(portal_verification.get("ok", false)):
		return {
			"handled": false,
			"fallback_web": true,
			"api": true,
			"message": "A API aceitou a alteracao, mas a ficha completa ainda diverge; usando o portal web como fallback.",
			"row": updated_row,
		}
	return {"handled": true, "ok": true, "api": true, "row": updated_row, "portal_verification": portal_verification.get("after", {}), "policy_verified": "portal"}


func _finalize_local_equipment_modification(request: Dictionary) -> Dictionary:
	var serial := _digits_only(str(request.get("serial", request.get("remote_serial", ""))))
	var sku := str(request.get("local_sku", serial)).strip_edges()
	var product := store.get_product(sku)
	if product.is_empty():
		product = store.get_product(serial)
	if product.is_empty():
		# Aparelhos que ja existiam no Grupo RS antes da implantacao do Firebase
		# nao possuem uma linha local ainda. Depois de uma modificacao remota
		# confirmada, crie o espelho completo em vez de descartar a alteracao.
		# Assim o primeiro sincronismo passa a ser um cadastro valido, nunca um
		# registro parcial ou silenciosamente perdido.
		product = {
			"sku": sku.to_upper() if sku != "" else serial,
			"imei": serial,
			"equipment_number": serial,
			"serial": serial,
			"plate": "",
			"client": "",
			"model": "Reutilizado",
			"category": "Reutilizado",
			"operator": "",
			"chip_number": "",
			"chip_phone": "",
			"apn": "",
			"tracker_status": "Estoque",
			"status": "Estoque",
			"location": "Estoque",
			"active": true,
			"stock": 1,
			"source": "grupo_rs_modificacao",
			"notes": "Registro importado do Grupo RS durante uma modificacao; aparelho preexistente ao Firebase.",
		}
	product["sku"] = sku.to_upper() if sku != "" else serial
	product["imei"] = serial
	product["equipment_number"] = serial
	var target_plate := _format_grupo_rs_vehicle_plate(str(request.get("vehicle_target_plate", request.get("new_plate", ""))))
	if bool(request.get("clear_vehicle_association", false)):
		product["plate"] = ""
		product["client"] = ""
		product["tracker_status"] = "Estoque"
		product["status"] = "Estoque"
		product["location"] = "Estoque"
		product["active"] = true
		product["stock"] = 1
	elif target_plate != "":
		product["plate"] = target_plate
		# A modificacao de placa padroniza a associacao remota para RS300.
		# Atualize o espelho local junto com a placa para nao exibir o titular
		# antigo depois que a API confirmar a operacao.
		product["client"] = "RS300"
	if str(request.get("chip_number", request.get("chip", ""))).strip_edges() != "":
		product["chip_number"] = _digits_only(str(request.get("chip_number", request.get("chip", ""))))
	if str(request.get("phone", "")).strip_edges() != "":
		product["chip_phone"] = _local_registration_phone(str(request.get("phone", "")))
	if str(request.get("apn", "")).strip_edges() != "":
		product["apn"] = str(request.get("apn", "")).strip_edges().to_lower()
	var requested_model := str(request.get("model", "")).strip_edges()
	if requested_model != "" and _search_key(requested_model) != _search_key("selecione"):
		product["model"] = requested_model
		product["category"] = requested_model
	var requested_operator := str(request.get("operator", "")).strip_edges()
	if requested_operator != "" and _search_key(requested_operator) != _search_key("selecione"):
		product["operator"] = requested_operator
	for metadata_key in ["vehicle_model", "vehicle_brand", "vehicle_year", "vehicle_color", "vehicle_chassis", "vehicle_observation"]:
		var metadata_value := str(request.get(metadata_key, "")).strip_edges()
		if metadata_value != "":
			product[metadata_key] = metadata_value
	var requested_status := str(request.get("tracker_status", "")).strip_edges()
	if requested_status != "" and _search_key(requested_status) != _search_key("selecione"):
		var status_key := _status_key_from_text(requested_status)
		product["tracker_status"] = requested_status
		product["status"] = requested_status
		product["location"] = requested_status
		product["active"] = status_key != "inativo"
		product["stock"] = 1 if status_key == "estoque" else 0
	var saved := store.upsert_product_replacing_sku(sku, product)
	return {"ok": not saved.is_empty(), "product": saved, "message": "Falha ao atualizar o cadastro local." if saved.is_empty() else ""}


func _ensure_firebase_modification_saved(serial: String = "", expected_product: Dictionary = {}) -> Dictionary:
	if store == null:
		return {"ok": false, "message": "A base operacional nao esta disponivel para salvar a modificacao no Firebase."}
	var firebase_sync := _firebase_sync()
	if firebase_sync == null or not firebase_sync.has_method("sync_now"):
		return {"ok": false, "message": "O sincronizador do Firebase nao esta disponivel; a modificacao nao foi marcada como concluida."}
	var synced: Variant = await firebase_sync.call("sync_now")
	var status: Dictionary = synced as Dictionary if typeof(synced) == TYPE_DICTIONARY else {}
	if bool(status.get("ok", false)):
		if not expected_product.is_empty() and firebase_sync.has_method("verify_product_persisted"):
			var verification: Variant = await firebase_sync.call("verify_product_persisted", serial, expected_product)
			var verified: Dictionary = verification as Dictionary if typeof(verification) == TYPE_DICTIONARY else {}
			if not bool(verified.get("ok", false)):
				return {
					"ok": false,
					"message": str(verified.get("message", "O Firebase nao confirmou a leitura da alteracao.")),
					"status": status,
					"verification": verified,
				}
			return {"ok": true, "status": status, "verification": verified, "serial": serial}
		return {"ok": true, "status": status, "serial": serial}
	return {
		"ok": false,
		"message": "A modificacao remota foi confirmada, mas o Firebase nao confirmou a gravacao local%s. A operacao nao sera apresentada como concluida." % (" da serie %s" % serial if serial != "" else ""),
		"status": status,
	}


func _ensure_firebase_registration_saved(serial: String = "", expected_product: Dictionary = {}) -> Dictionary:
	"""Persiste e rele a inclusao do cadastro antes de liberar a fila.

	O cadastro remoto pode ser confirmado antes da sincronizacao do espelho. A
	operacao so deve aparecer como concluida quando a escrita do Firebase e a
	leitura da mesma serie tiverem sido confirmadas.
	"""
	if store == null:
		return {"ok": false, "message": "A base operacional nao esta disponivel para salvar o cadastro no Firebase."}
	var firebase_sync := _firebase_sync()
	if firebase_sync == null or not firebase_sync.has_method("sync_now"):
		return {"ok": false, "message": "O sincronizador do Firebase nao esta disponivel; o cadastro remoto foi preservado como pendente."}
	var synced: Variant = await firebase_sync.call("sync_now")
	var status: Dictionary = synced as Dictionary if typeof(synced) == TYPE_DICTIONARY else {}
	if not bool(status.get("ok", false)):
		return {
			"ok": false,
			"message": "O cadastro remoto foi confirmado, mas o Firebase recusou ou nao concluiu a gravacao.",
			"status": status,
		}
	if not expected_product.is_empty() and firebase_sync.has_method("verify_product_persisted"):
		var verification: Variant = await firebase_sync.call("verify_product_persisted", serial, expected_product)
		var verified: Dictionary = verification as Dictionary if typeof(verification) == TYPE_DICTIONARY else {}
		if not bool(verified.get("ok", false)):
			return {
				"ok": false,
				"message": str(verified.get("message", "O Firebase nao confirmou a leitura do cadastro.")),
				"status": status,
				"verification": verified,
			}
		return {"ok": true, "status": status, "verification": verified, "serial": serial}
	return {"ok": true, "status": status, "serial": serial}


func _choose_modern_grupo_rs_equipment_row_by_serial_exact(rows: Array[Dictionary], serial: String) -> Dictionary:
	var target := _search_key(serial)
	var selected: Dictionary = {}
	for row in rows:
		if _search_key(str(row.get("serial", ""))) != target:
			continue
		if not selected.is_empty():
			return {}
		selected = row
	return selected


func _modify_modern_equipment_via_web(request: Dictionary) -> Dictionary:
	var serial := _digits_only(str(request.get("serial", request.get("remote_serial", ""))))
	var rows := await _fetch_modern_grupo_rs_equipment_rows(serial)
	var equipment := _choose_modern_grupo_rs_equipment_row_by_serial_exact(rows, serial)
	if equipment.is_empty():
		return {"ok": false, "message": "O portal web nao confirmou uma unica linha para o equipamento %s." % serial, "fallback_web": true}
	var edit_href := str(equipment.get("edit_href", "")).strip_edges()
	if edit_href == "" and str(equipment.get("edit_id", "")).strip_edges() != "":
		edit_href = _grupo_rs_edit_url(str(equipment.get("edit_id", "")))
	if edit_href == "":
		return {"ok": false, "message": "O portal web nao forneceu a tela de edicao do equipamento.", "fallback_web": true}
	var page := await _modern_grupo_rs_get(edit_href)
	if not bool(page.get("ok", false)):
		return {"ok": false, "message": "Nao foi possivel abrir a edicao do equipamento no portal web.", "fallback_web": true}
	var html := str(page.get("body", ""))
	var form_html := _extract_html_form_by_action(html, "equipamentos_action.php")
	var submit_action := "equipamentos_action.php"
	if form_html == "":
		form_html = _extract_html_form_by_action(html, "equipamentos_actions.php")
		submit_action = "equipamentos_actions.php"
	var built := _build_modern_equipment_modification_fields(form_html, request, equipment)
	if not bool(built.get("ok", false)):
		return built
	var response := await _modern_grupo_rs_post_form(submit_action, built.get("fields", {}) as Dictionary, edit_href, true, 0)
	# O portal pode fechar a conexao depois de aceitar o POST. A leitura exata
	# abaixo e a fonte de verdade e impede repetir uma modificacao aplicada.
	var confirmed := await _verify_modern_equipment_modification(serial, request)
	if bool(confirmed.get("ok", false)):
		return {"ok": true, "row": confirmed.get("row", {}), "web": true, "transport_warning": str(response.get("message", "")) if not bool(response.get("ok", false)) else ""}
	return {"ok": false, "message": str(confirmed.get("message", "O portal web nao confirmou a modificacao.")), "fallback_web": true}


func _build_modern_equipment_modification_fields(form_html: String, request: Dictionary, existing: Dictionary = {}) -> Dictionary:
	if form_html == "":
		return {"ok": false, "message": "O formulario de edicao do equipamento nao foi identificado."}
	var fields := _legacy_form_fields(form_html)
	var serial := _digits_only(str(request.get("serial", request.get("remote_serial", ""))))
	var chip := _digits_only(str(request.get("chip_number", request.get("chip", ""))))
	var phone := _local_registration_phone(str(request.get("phone", "")))
	var apn := str(request.get("apn", "")).strip_edges().to_lower()
	# Quando a tela foi aberta para alterar apenas um campo, preserve os demais
	# valores atuais do formulario remoto em vez de exigir que o operador os
	# redigite.
	if chip == "":
		chip = _digits_only(str(fields.get("NumeroChip", "")))
	if phone == "":
		phone = _local_registration_phone(str(fields.get("NumeroTelefone", "")))
	if apn == "":
		apn = str(fields.get("Apn", "")).strip_edges().to_lower()
	if chip == "":
		chip = _digits_only(str(existing.get("chip", existing.get("chip_number", ""))))
	if phone == "":
		phone = _local_registration_phone(str(existing.get("phone", existing.get("phone_number", ""))))
	if apn == "":
		apn = str(existing.get("apn", "")).strip_edges().to_lower()
	if serial == "" or chip == "" or phone == "" or apn == "":
		return {"ok": false, "message": "Serie, chip, telefone e APN sao obrigatorios para modificar o equipamento."}
	var equipment_id := str(fields.get("CodEquipamento", "")).strip_edges()
	if equipment_id == "":
		equipment_id = str(existing.get("edit_id", existing.get("api_id", ""))).strip_edges()
	if equipment_id == "" or not equipment_id.is_valid_int() or int(equipment_id) <= 0:
		return {"ok": false, "message": "O portal nao informou um codigo valido para o equipamento."}
	fields["CodEquipamento"] = equipment_id
	fields["NumeroEquipamento"] = serial
	fields["NumeroSerie"] = serial
	fields["Apn"] = apn
	fields["NumeroChip"] = chip
	fields["NumeroTelefone"] = phone
	var model_label := str(request.get("model", "")).strip_edges()
	var model_id := str(fields.get("CodModelo", "")).strip_edges()
	if model_label != "" and _search_key(model_label) != _search_key("selecione"):
		var requested_model_id := _html_select_option_value_by_label(form_html, "CodModelo", model_label)
		if requested_model_id != "":
			model_id = requested_model_id
	if model_id == "":
		model_id = str(existing.get("codModelo", existing.get("model_id", ""))).strip_edges()
	if model_id == "" and model_label != "":
		model_id = _html_select_option_value_by_label(form_html, "CodModelo", "RS 300")
	if model_id != "":
		fields["CodModelo"] = model_id
	var operator_label := str(request.get("operator", "")).strip_edges()
	var operator_id := str(fields.get("CodOperadora", "")).strip_edges()
	if operator_label != "" and _search_key(operator_label) != _search_key("selecione"):
		var requested_operator_id := _html_select_option_value_by_label(form_html, "CodOperadora", operator_label)
		if requested_operator_id == "":
			return {
				"ok": false,
				"message": "A operadora %s nao apareceu no catalogo remoto; a modificacao foi bloqueada para evitar gravar uma operadora diferente." % operator_label,
				"operator_catalog_missing": true,
			}
		operator_id = requested_operator_id
	if operator_id == "":
		operator_id = str(existing.get("codOperadora", existing.get("operator_id", ""))).strip_edges()
	if operator_id != "":
		fields["CodOperadora"] = operator_id
	fields["acao"] = "editar"
	fields["salvar"] = "1"
	return {"ok": true, "fields": fields}


func _modern_equipment_confirmation_mismatches(row: Dictionary, details: Dictionary, request: Dictionary) -> Array[String]:
	var mismatches: Array[String] = []
	var expected_chip := _digits_only(str(request.get("chip_number", request.get("chip", ""))))
	var actual_chip := _digits_only(str(row.get("chip", "")))
	if actual_chip == "":
		actual_chip = _digits_only(str(details.get("chip", "")))
	if expected_chip != "" and actual_chip != "":
		# Algumas instalacoes exibem apenas os ultimos digitos do ICCID na
		# listagem, embora o formulario grave o ICCID completo. Aceite somente
		# esse caso verificavel por sufixo; qualquer outro valor continua sendo
		# divergencia e bloqueia a confirmacao.
		var chip_matches := actual_chip == expected_chip
		if not chip_matches and actual_chip.length() >= 8 and expected_chip.ends_with(actual_chip):
			chip_matches = true
		if not chip_matches:
			mismatches.append("chip")
	elif expected_chip != "":
		mismatches.append("chip ausente")

	var expected_phone := _local_registration_phone(str(request.get("phone", "")))
	var actual_phone := _local_registration_phone(str(row.get("phone", "")))
	if actual_phone == "":
		actual_phone = _local_registration_phone(str(details.get("phone", "")))
	if expected_phone != "" and actual_phone != expected_phone:
		mismatches.append("phone")

	var expected_apn := str(request.get("apn", "")).strip_edges().to_lower()
	var actual_apn := str(details.get("apn", "")).strip_edges().to_lower()
	if actual_apn == "":
		actual_apn = str(row.get("apn", "")).strip_edges().to_lower()
	if expected_apn != "" and actual_apn != expected_apn:
		mismatches.append("apn")

	var expected_operator := _smart_registration_operator_label(str(request.get("operator", "")))
	var actual_operator := _smart_registration_operator_label(str(details.get("operator", row.get("operator", ""))))
	if expected_operator != "" and _search_key(expected_operator) != _search_key("selecione") \
			and actual_operator != "" and _search_key(actual_operator) != _search_key(expected_operator):
		mismatches.append("operadora")
	return mismatches


func _verify_modern_equipment_modification(serial: String, request: Dictionary) -> Dictionary:
	var last_message := "O equipamento modificado nao apareceu na consulta do portal."
	var last_mismatches: Array[String] = []
	for attempt in range(EQUIPMENT_MODIFICATION_CONFIRM_ATTEMPTS):
		if attempt > 0:
			var delay_seconds := minf(
				EQUIPMENT_MODIFICATION_CONFIRM_INITIAL_DELAY_SECONDS + ((attempt - 1) * EQUIPMENT_MODIFICATION_CONFIRM_STEP_SECONDS),
				EQUIPMENT_MODIFICATION_CONFIRM_MAX_DELAY_SECONDS
			)
			await get_tree().create_timer(delay_seconds).timeout
		var rows := await _fetch_modern_grupo_rs_equipment_rows(serial, true)
		var row := _choose_modern_grupo_rs_equipment_row_by_serial_exact(rows, serial)
		if row.is_empty():
			last_message = "O equipamento modificado ainda nao apareceu na consulta do portal."
			continue
		var details := await _fetch_grupo_rs_equipment_details(row)
		last_mismatches = _modern_equipment_confirmation_mismatches(row, details, request)
		if last_mismatches.is_empty():
			return {
				"ok": true,
				"row": row,
				"details": details,
				"attempt": attempt + 1,
				"max_attempts": EQUIPMENT_MODIFICATION_CONFIRM_ATTEMPTS,
			}
		last_message = "O portal ainda nao confirmou: %s." % ", ".join(last_mismatches)

	var suffix := ""
	if not last_mismatches.is_empty():
		suffix = " Campos pendentes: %s." % ", ".join(last_mismatches)
	return {
		"ok": false,
		"message": "%s Foram feitas %d leituras de confirmacao.%s" % [last_message, EQUIPMENT_MODIFICATION_CONFIRM_ATTEMPTS, suffix],
		"confirmation_pending": true,
		"attempt": EQUIPMENT_MODIFICATION_CONFIRM_ATTEMPTS,
		"max_attempts": EQUIPMENT_MODIFICATION_CONFIRM_ATTEMPTS,
	}


func _perform_modern_vehicle_modification(request: Dictionary) -> Dictionary:
	var serial := _digits_only(str(request.get("remote_serial", request.get("serial", ""))))
	var old_plate := _format_grupo_rs_vehicle_plate(str(request.get("old_plate", "")))
	var new_plate := _format_grupo_rs_vehicle_plate(str(request.get("new_plate", "")))
	if serial == "" or new_plate == "":
		return {"ok": false, "message": "Serie e nova placa validas sao necessarias para o fallback web."}
	if old_plate == "":
		# O fallback web segue a mesma regra da API: ele apenas edita uma ficha
		# existente. Cadastro de placa nova pertence exclusivamente ao fluxo
		# "Novo equipamento" e nunca deve ser disparado por "Modificar".
		return {
			"ok": false,
			"no_existing_vehicle": true,
			"created": false,
			"message": "O aparelho %s nao possui um veiculo vinculado para modificar. Use 'Novo equipamento' para cadastrar uma nova placa." % serial,
		}
	var prepared_request := request.duplicate(true)
	prepared_request["remote_serial"] = serial
	prepared_request["old_plate"] = old_plate
	prepared_request["new_plate"] = new_plate
	var prepared := await _prepare_modern_vehicle_reassignment(prepared_request)
	if not bool(prepared.get("ok", false)):
		# A API anterior pode ter aceitado a placa antes de devolver uma resposta
		# incompleta. Nesse caso a segunda etapa nao deve tentar localizar a placa
		# antiga novamente: confirme a nova associacao e, se necessario, reabra a
		# mesma ficha para completar os metadados solicitados.
		var new_rows_response := await _fetch_modern_grupo_rs_vehicle_rows_all_statuses(new_plate, true)
		if bool(new_rows_response.get("ok", false)):
			var new_rows: Array[Dictionary] = new_rows_response.get("rows", []) as Array[Dictionary]
			var already_new := _choose_modern_grupo_rs_vehicle_row_exact(new_rows, serial, new_plate)
			if not already_new.is_empty():
				var already_href := str(already_new.get("edit_href", "")).strip_edges()
				if already_href != "":
					var already_page := await _modern_grupo_rs_get(already_href)
					if bool(already_page.get("ok", false)):
						var already_snapshot := _modern_vehicle_edit_snapshot(str(already_page.get("body", "")))
						var clear_already := bool(request.get("clear_vehicle_fields", false))
						if _modern_vehicle_snapshot_matches_reassignment(already_snapshot, new_plate, clear_already, request):
							return {"ok": true, "row": already_new, "web": true, "already_applied": true}
						# A placa ja mudou, mas ainda faltam os metadados. Reaproveite a
						# ficha agora apontando para a placa efetivamente encontrada.
						var retry_request := prepared_request.duplicate(true)
						retry_request["old_plate"] = new_plate
						var retry_prepared := await _prepare_modern_vehicle_reassignment(retry_request)
						if bool(retry_prepared.get("ok", false)):
							return await _update_modern_grupo_rs_vehicle_reassignment(retry_prepared)
		return prepared
	# Nao reutilizar o formulario bruto: ele traz o titular, marca, cor,
	# chassi e demais dados antigos. O builder abaixo monta explicitamente a
	# ficha hibrida exigida (RS300/Carro e campos veiculares limpos) e depois
	# confirma cada campo na tela real do portal.
	return await _update_modern_grupo_rs_vehicle_reassignment(prepared)


