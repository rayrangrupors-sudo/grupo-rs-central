func _refresh_guardian_view_body() -> void:
	if guardian_overview_host == null \
			or not is_instance_valid(guardian_overview_host) \
			or guardian_details_host == null \
			or not is_instance_valid(guardian_details_host):
		return
	_clear_dynamic_container(guardian_overview_host)
	_clear_dynamic_container(guardian_details_host)
	if system_guardian == null or not is_instance_valid(system_guardian):
		guardian_overview_host.add_child(_make_guardian_message_panel("Assistente indisponivel", "Abra uma filial para iniciar o diagnostico local.", RED))
		return

	var snapshot: Dictionary = system_guardian.call("get_snapshot")
	guardian_overview_host.add_child(_make_guardian_overview(snapshot))

	var section_title := Label.new()
	section_title.text = "Componentes monitorados"
	section_title.add_theme_font_override("font", UI_FONT)
	section_title.add_theme_font_size_override("font_size", 20)
	section_title.add_theme_color_override("font_color", TEXT)
	guardian_details_host.add_child(section_title)

	var components: Array = snapshot.get("components", [])
	if components.is_empty():
		guardian_details_host.add_child(_make_guardian_message_panel("Primeira verificacao pendente", "O primeiro ciclo comeca poucos segundos depois que a filial e aberta.", BLUE))
	else:
		var component_grid := GridContainer.new()
		component_grid.columns = 5
		component_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		component_grid.add_theme_constant_override("h_separation", 12)
		component_grid.add_theme_constant_override("v_separation", 12)
		guardian_details_host.add_child(component_grid)
		for raw_component in components:
			if typeof(raw_component) == TYPE_DICTIONARY:
				component_grid.add_child(_make_guardian_component_card(raw_component as Dictionary))

	guardian_details_host.add_child(_build_guardian_events_panel(snapshot.get("events", [])))


func _clear_dynamic_container(container: Container) -> void:
	if container == null or not is_instance_valid(container):
		return
	for child in container.get_children():
		container.remove_child(child)
		child.queue_free()


