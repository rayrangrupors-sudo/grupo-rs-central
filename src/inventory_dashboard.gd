	var selected_url := selected_branch_grupo_rs_base_url.strip_edges() if _grupo_rs_supports_modern_api() else GRUPO_RS_BASE_URL
	return _normalize_modern_grupo_rs_base_url(configured_url if configured_url != "" else selected_url)


func _normalize_modern_grupo_rs_base_url(value: String) -> String:
	var url := value.strip_edges()
	if url == "":
		url = GRUPO_RS_BASE_URL
	for _index in range(4):
		if url.length() == 0 or not url.ends_with("/"):
			break
		var trimmed_url := url.substr(0, url.length() - 1)
		if trimmed_url == url:
			break
		url = trimmed_url
	var lower_url := url.to_lower()
	var portal_suffixes: Array[String] = [
		"/cadastro/veiculos_listar.php",
		"/cadastro/veiculos_editar.php",
		"/cadastro/equipamentos_listar.php",
		"/cadastro/login.php",
		"/login.php",
		"/cadastro/home_adm.php",
		"/home_adm.php",
		"/cadastro/index.php",
		"/index.php",
	]
	for suffix: String in portal_suffixes:
		if lower_url.ends_with(suffix):
			url = url.substr(0, url.length() - suffix.length()) + "/cadastro"
			break
	if not url.ends_with("/"):
		url += "/"
	if url.ends_with("/cadastro/"):
		return url
	if url.ends_with("/cadastro"):
		return "%s/" % url
	return url
func _configured_modern_grupo_rs_base_url() -> String:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	return _normalize_modern_grupo_rs_base_url(str(settings.get("grupo_rs_modern_base_url", GRUPO_RS_BASE_URL)))


func _modern_grupo_rs_root_url() -> String:
	var url := _modern_grupo_rs_base_url()
	if url.ends_with("/cadastro/"):
		return url.substr(0, url.length() - "/cadastro/".length())
	if url.ends_with("/cadastro"):
		return url.substr(0, url.length() - "/cadastro".length())
	return url.trim_suffix("/")


func _modern_grupo_rs_url(path: String) -> String:
	var clean_path := path.strip_edges()
	if clean_path.begins_with("http"):
		return clean_path
	if clean_path.begins_with("/"):
		return "%s%s" % [_modern_grupo_rs_root_url(), clean_path]
	return "%s%s" % [_modern_grupo_rs_base_url(), clean_path]


func _modern_grupo_rs_vehicle_list_url(query: String, status: String, cache_buster: String = "") -> String:
	var path := "veiculos_listar.php?busca=%s&status=%s" % [
		query.uri_encode(),
		status.uri_encode(),
	]
	if cache_buster.strip_edges() != "":
		path += "&__codex_refresh=%s" % cache_buster.uri_encode()
	return _modern_grupo_rs_url(path)


func _legacy_grupo_rs_root_from_url(value: String) -> String:
	var url := value.strip_edges()
	if url == "":
		return ""
	# A configuracao pode conter a pagina de equipamentos, a tela inicial
	# antiga ou somente a raiz. Em todos os casos, as requisicoes internas
	# precisam partir do dominio antes de /Login e /Cadastros.
	var query_start := url.find("?")
	if query_start >= 0:
		url = url.substr(0, query_start)
	url = url.trim_suffix("/")
	var lower_url := url.to_lower()
	for suffix in [
		"/cadastros/equipamentoslistar",
		"/cadastros/veiculosequipamentoslistar",
		"/cadastros/veiculoslistar",
		"/base/frmprincipal",
		"/base",
		"/cadastro"
	]:
		if lower_url.ends_with(suffix):
			return url.substr(0, url.length() - suffix.length()).trim_suffix("/")
	return url.trim_suffix("/")


func _legacy_grupo_rs_root_url() -> String:
	return _legacy_grupo_rs_root_from_url(selected_branch_grupo_rs_base_url)


func _legacy_grupo_rs_url(path: String) -> String:
	var root := _legacy_grupo_rs_root_url()
	if root == "":
		return ""
	var clean_path := path.strip_edges()
	if not clean_path.begins_with("/"):
		clean_path = "/%s" % clean_path
	return "%s%s" % [root, clean_path]


func _legacy_grupo_rs_delete_base_url() -> String:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var url := str(settings.get("grupo_rs_legacy_delete_base_url", LEGACY_GRUPO_RS_DELETE_BASE_URL)).strip_edges()
	if url == "":
		url = LEGACY_GRUPO_RS_DELETE_BASE_URL
	elif url.to_lower().trim_suffix("/") == LEGACY_GRUPO_RS_PREVIOUS_DEFAULT_URL.to_lower():
		# Migra silenciosamente o endereco padrao salvo antes da troca de acesso.
		url = LEGACY_GRUPO_RS_DELETE_BASE_URL
	return url


func _legacy_grupo_rs_delete_platform_url() -> String:
	var url := _legacy_grupo_rs_delete_base_url().strip_edges().trim_suffix("/")
	if url.to_lower().ends_with("/cadastros/equipamentoslistar"):
		return url
	if url.ends_with("/Base/FrmPrincipal"):
		return url
	if url.ends_with("/Base"):
		return "%s/FrmPrincipal" % url
	if url.ends_with("/FrmPrincipal"):
		return url
	return "%s/Base/FrmPrincipal" % url


