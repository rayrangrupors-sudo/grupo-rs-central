			var button := child as Button
			var active := str(button.get_meta("status_key", "")) == selected_status_filter_key
			_style_status_filter_button(button, active)


func _apply_inventory_date_filters() -> void:
	if inventory_date_input != null and is_instance_valid(inventory_date_input):
		inventory_start_date = inventory_date_input.text.strip_edges()
	if inventory_end_date_input != null and is_instance_valid(inventory_end_date_input):
		inventory_end_date = inventory_end_date_input.text.strip_edges()
	if inventory_start_date != "" and inventory_end_date != "":
		var start := _log_input_date(inventory_start_date)
		var finish := _log_input_date(inventory_end_date)
		if start != "" and finish != "" and start > finish:
			_show_warning("Filtro de estoque", "A data final não pode ser anterior à data inicial.")
			return
	table_current_page = 0
	_refresh_table()


func _clear_inventory_date_filters() -> void:
	inventory_start_date = ""
	inventory_end_date = ""
	if inventory_date_input != null and is_instance_valid(inventory_date_input):
		inventory_date_input.text = ""
	if inventory_end_date_input != null and is_instance_valid(inventory_end_date_input):
		inventory_end_date_input.text = ""
	table_current_page = 0
	_refresh_table()


func _inventory_product_date(product: Dictionary) -> String:
	for key in ["updated_at", "created_at", "source_date", "purchase_date", "date"]:
		var value := str(product.get(key, "")).strip_edges()
		if value != "":
			return value.replace("T", " ")
	return ""


func _date_value_in_range(raw_value: String, start_value: String, end_value: String) -> bool:
	var record := _log_input_date(raw_value)
	if record == "":
		return false
	var start := _log_input_date(start_value)
	var finish := _log_input_date(end_value)
	if start != "" and record < start:
		return false
	if finish != "" and record > finish:
		return false
	return true


