func _load_rs300_settings() -> void:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	production_next_plate_number = int(settings.get("rs300_next_plate", RS300_DEFAULT_NEXT_PLATE))
	if production_next_plate_number < RS300_DEFAULT_NEXT_PLATE:
		production_next_plate_number = RS300_DEFAULT_NEXT_PLATE


func _save_rs300_settings() -> void:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	settings["rs300_next_plate"] = production_next_plate_number
	_write_json_dictionary(SETTINGS_PATH, settings)


func _format_rs300_plate(number: int) -> String:
	return "GRS - T%d" % maxi(number, RS300_DEFAULT_NEXT_PLATE)


func _rs300_field_text(key: String) -> String:
	var input: Variant = production_fields.get(key)
	if input is LineEdit:
		return (input as LineEdit).text.strip_edges()
	return ""


func _set_rs300_field(key: String, value: String) -> void:
	var input: Variant = production_fields.get(key)
	if input is LineEdit:
		(input as LineEdit).text = value


func _rs300_digits_only(value: String) -> String:
	var result := ""
	for i in range(value.length()):
		var character := value.substr(i, 1)
		if character >= "0" and character <= "9":
			result += character
	return result


func _local_phone_from_arya(phone_value: String) -> String:
	var digits := _rs300_digits_only(phone_value)
	if digits.begins_with("55") and digits.length() > 11:
		digits = digits.substr(2)
	return digits


func _derive_rs300_data() -> void:
	var chip_short := _rs300_digits_only(_rs300_field_text("chip_short"))
	if chip_short == "":
		_show_warning("RS300", "Informe o numero curto do chip antes de derivar os dados.")
		return

	_set_rs300_field("chip_short", chip_short)
	if _rs300_field_text("iccid") == "":
		_set_rs300_field("iccid", "895554830000%s" % chip_short)
	if _rs300_field_text("client") == "":
		_set_rs300_field("client", "RS300")
	if _rs300_field_text("plate") == "":
		_set_rs300_field("plate", _format_rs300_plate(production_next_plate_number))

	var phone_local := _local_phone_from_arya(_rs300_field_text("phone_arya"))
	if phone_local != "":
		_set_rs300_field("phone_local", phone_local)

	_update_rs300_summary()
	_set_rs300_status("Dados derivados. Confira Arya e ULURU antes de salvar.", BLUE_DARK)


func _request_rs300_arya_status() -> void:
	var chip_short := _rs300_digits_only(_rs300_field_text("chip_short"))
	if chip_short == "":
		_show_warning("Arya", "Informe o numero curto do chip para consultar.")
		return
	if production_arya_request == null:
		return

	_set_rs300_field("chip_short", chip_short)
	_set_arya_status("Arya: consultando chip %s..." % chip_short, BLUE_DARK)
	production_arya_request.cancel_request()
	var url := ARYA_API_INVENTARY_URL % chip_short.uri_encode()
	var error := production_arya_request.request(url, _arya_request_headers())
	if error != OK:
		_set_arya_status("Arya: nao foi possivel iniciar a consulta.", RED)


func _on_rs300_arya_completed(result: int, response_code: int, _headers: PackedStringArray, body: PackedByteArray) -> void:
	if response_code == 401 or response_code == 403:
		_set_arya_status("Arya: login necessario para consultar online/offline.", YELLOW)
		return
	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300:
		_set_arya_status("Arya: indisponivel ou sem permissao HTTP agora.", RED)
		return

	var text_value := body.get_string_from_utf8()
	var lower := text_value.to_lower()
	if lower.contains("login") or lower.contains("senha") or lower.contains("entrar"):
		_set_arya_status("Arya: login necessario. Use a Arya aberta no Chrome para confirmar o chip.", YELLOW)
		return

	var parsed := _parse_rs300_arya_response(text_value, _rs300_digits_only(_rs300_field_text("chip_short")))
	if parsed.is_empty():
		_set_arya_status("Arya: chip nao localizado automaticamente. Confira pela tela da Arya.", YELLOW)
		return

	if str(parsed.get("iccid", "")) != "":
		_set_rs300_field("iccid", str(parsed.get("iccid", "")))
	if str(parsed.get("phone", "")) != "":
		_set_rs300_field("phone_arya", str(parsed.get("phone", "")))
		_set_rs300_field("phone_local", _local_phone_from_arya(str(parsed.get("phone", ""))))
	if str(parsed.get("imei", "")) != "":
		_set_rs300_field("imei", str(parsed.get("imei", "")))
	if _rs300_field_text("serial") == "" and str(parsed.get("serial", "")) != "":
		_set_rs300_field("serial", str(parsed.get("serial", "")))

	var status := str(parsed.get("status", "desconhecido"))
	var color := GREEN if status.to_lower() == "online" else YELLOW
	if status.to_lower() == "offline":
		color = RED
	_set_arya_status("Arya: chip %s." % status, color)
	_update_rs300_summary()


func _parse_rs300_arya_response(text_value: String, chip_short: String) -> Dictionary:
	var api_result := _parse_arya_inventory_json(text_value, chip_short)
	if not api_result.is_empty():
		return api_result

	var clean := text_value.replace("\r", "\n").replace("\t", " ")
	if chip_short != "" and not clean.contains(chip_short):
		return {}

	var result: Dictionary = {}
	var full_iccid := _find_digits_with_suffix(clean, chip_short, 18)
	if full_iccid != "":
		result["iccid"] = full_iccid
	var phone := _find_brazil_phone(clean)
	if phone != "":
		result["phone"] = phone
	var imei := _find_long_number(clean, 12, 17, [full_iccid])
	if imei != "":
		result["imei"] = imei
		result["serial"] = imei
	result["status"] = _guess_arya_status(clean)
	return result


func _parse_arya_inventory_json(text_value: String, query: String) -> Dictionary:
	var parsed: Variant = JSON.parse_string(text_value)
	if typeof(parsed) != TYPE_DICTIONARY:
		return {}

	var root := parsed as Dictionary
	if root.has("status") and not bool(root.get("status", false)):
		return {}

	var data: Variant = root.get("data", root)
	if typeof(data) == TYPE_DICTIONARY:
		return _parse_arya_inventory_item(data as Dictionary, query)
	if typeof(data) == TYPE_ARRAY:
		for item in data as Array:
			if typeof(item) != TYPE_DICTIONARY:
				continue
			var parsed_item := _parse_arya_inventory_item(item as Dictionary, query)
			if not parsed_item.is_empty():
				return parsed_item
	return {}


func _parse_arya_inventory_item(item: Dictionary, query: String) -> Dictionary:
	var iccid := _digits_only(str(item.get("iccid", "")))
	var imei := _digits_only(str(item.get("imei", "")))
	var number := _digits_only(str(item.get("msisdn", item.get("number", ""))))
	var clean_query := _digits_only(query)
	if clean_query != "":
		var matches := iccid.contains(clean_query) or imei.contains(clean_query) or number.contains(clean_query)
		if not matches and clean_query.length() >= 6:
			matches = iccid.ends_with(clean_query) or imei.ends_with(clean_query) or number.ends_with(clean_query)
		if not matches:
			return {}

	var result: Dictionary = {}
	result["iccid"] = iccid
	result["imei"] = imei
	result["serial"] = imei
	result["phone"] = number
	result["operator"] = str(item.get("provider", item.get("operator", item.get("operadora", "")))).strip_edges()
	result["operator__name"] = result["operator"]
	result["apn"] = str(item.get("apn", "")).strip_edges()
	result["status"] = _normalize_arya_connection_status(item.get("conn_status", item.get("inSession", "")))
	result["last_conn_update"] = str(item.get("last_conn_update", item.get("lastConnUpdate", ""))).strip_edges()
	result["rat_type"] = str(item.get("rat_type", "")).strip_edges()
	return result


func _normalize_arya_connection_status(value: Variant) -> String:
	match typeof(value):
		TYPE_BOOL:
			return "online" if bool(value) else "offline"
		TYPE_INT, TYPE_FLOAT:
			return "online" if int(value) != 0 else "offline"

	var text_value := str(value).strip_edges().to_lower()
	if ["1", "true", "online", "on", "connected", "conectado", "em sessao", "em_sessao"].has(text_value):
		return "online"
	if ["0", "false", "offline", "off", "disconnected", "desconectado", "fora de sessao", "fora_sessao"].has(text_value):
		return "offline"
	return "desconhecido"


func _find_digits_with_suffix(text_value: String, suffix: String, min_length: int) -> String:
	var numbers := _extract_digit_runs(text_value, min_length, 24)
	for number in numbers:
		if str(number).ends_with(suffix):
			return str(number)
	return ""


func _find_brazil_phone(text_value: String) -> String:
	var numbers := _extract_digit_runs(text_value, 10, 13)
	for number in numbers:
		var digits := str(number)
		if digits.begins_with("55") and digits.length() >= 12:
			return digits
		if digits.length() == 10 or digits.length() == 11:
			return "55%s" % digits
	return ""


func _find_long_number(text_value: String, min_length: int, max_length: int, ignored: Array) -> String:
	var numbers := _extract_digit_runs(text_value, min_length, max_length)
	for number in numbers:
		var digits := str(number)
		if ignored.has(digits):
			continue
		return digits
	return ""


func _extract_digit_runs(text_value: String, min_length: int, max_length: int) -> Array[String]:
	var result: Array[String] = []
	var current := ""
	for i in range(text_value.length()):
		var character := text_value.substr(i, 1)
		if character >= "0" and character <= "9":
			current += character
		else:
			if current.length() >= min_length and current.length() <= max_length:
				result.append(current)
			current = ""
	if current.length() >= min_length and current.length() <= max_length:
		result.append(current)
	return result


func _guess_arya_status(text_value: String) -> String:
	var upper := text_value.to_upper()
	if upper.contains(">OFFLINE<") or upper.contains(" OFFLINE ") or upper.contains("\nOFFLINE"):
		return "offline"
	if upper.contains(">ONLINE<") or upper.contains(" ONLINE ") or upper.contains("\nONLINE"):
		return "online"
	if upper.contains(">OFF<") or upper.contains(" OFF ") or upper.contains("\nOFF"):
		return "offline"
	if upper.contains(">ON<") or upper.contains(" ON ") or upper.contains("\nON"):
		return "online"
	return "desconhecido"


func _build_rs300_product() -> Dictionary:
	var serial := _rs300_field_text("serial")
	if serial == "":
		serial = _rs300_field_text("imei")
	if serial == "":
		serial = _rs300_field_text("iccid")

	var plate := _rs300_field_text("plate").to_upper()
	var status := "Instalado" if plate != "" else "Estoque"
	var notes := "RS300 produzido pelo fluxo rapido. Tempo primeiro; APN Grupo RS com usuario/senha hinova."
	if production_arya_status_label:
		notes += " %s" % production_arya_status_label.text

	return {
		"sku": serial,
		"name": serial,
		"category": "RS300",
		"location": status,
		"unit": "un",
		"stock": 0 if status == "Instalado" else 1,
		"min_stock": 0,
		"cost": 0,
		"notes": notes,
		"active": true,
		"equipment_number": serial,
		"imei": serial,
		"apn": "hinova.br",
		"chip_number": _rs300_field_text("iccid"),
		"chip_phone": _rs300_field_text("phone_local"),
		"model": "RS300",
		"operator": "TIM",
		"plate": plate,
		"client": _rs300_field_text("client"),
		"tracker_status": status,
		"status": status,
	}


func _save_rs300_product() -> void:
	if _rs300_digits_only(_rs300_field_text("chip_short")) == "":
		_show_warning("RS300", "Informe o numero curto do chip antes de salvar.")
		return
	_derive_rs300_data()
	var product := _build_rs300_product()
	var serial := str(product.get("sku", "")).strip_edges()
	if serial == "":
		_show_warning("RS300", "Informe o numero de serie, IMEI ou ICCID antes de salvar.")
		return

	var duplicate := store.find_duplicate_product(product, "")
	if not duplicate.is_empty():
		var existing: Dictionary = duplicate.get("product", {})
		_show_warning(
			"Cadastro duplicado",
			"Ja existe cadastro com o mesmo %s: %s" % [
				str(duplicate.get("field", "campo")),
				str(existing.get("sku", "")),
			]
		)
		return

	var saved := store.upsert_product(product)
	if saved.is_empty():
		_show_error("RS300", "Nao foi possivel salvar no estoque.")
		return

	_log_system_action("Cadastro rapido RS300", _log_product_details(saved), str(saved.get("sku", "")))
	_set_rs300_status("RS300 salvo no estoque: %s" % str(saved.get("sku", "")), GREEN)
	_show_success("RS300", "Cadastro salvo no sistema.")


func _save_rs300_and_next() -> void:
	_save_rs300_product()
	if production_status_label and production_status_label.text.begins_with("RS300 salvo"):
		_advance_rs300_plate()
		_clear_rs300_fields(false)


func _advance_rs300_plate() -> void:
	production_next_plate_number += 1
	_save_rs300_settings()
	_set_rs300_field("plate", _format_rs300_plate(production_next_plate_number))
	_update_rs300_summary()


func _clear_rs300_fields(clear_plate: bool = true) -> void:
	for key in production_fields.keys():
		if clear_plate == false and key == "plate":
			continue
		if key == "client":
			_set_rs300_field(key, "RS300")
		else:
			_set_rs300_field(key, "")
	if clear_plate:
		_set_rs300_field("plate", _format_rs300_plate(production_next_plate_number))
	for check_key in production_checks.keys():
		var check: Variant = production_checks.get(check_key)
		if check is CheckBox:
			(check as CheckBox).button_pressed = false
	_set_arya_status("Arya: aguardando consulta.", MUTED)
	_set_rs300_status("Pronto para iniciar.", MUTED)
	_update_rs300_summary()


