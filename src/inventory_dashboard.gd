func _refresh_maintenance_schedule_rows() -> void:
	if maintenance_schedule_body == null or not is_instance_valid(maintenance_schedule_body):
		return
	_refresh_maintenance_summary_labels()
	var existing_rows := {}
	var disposable_nodes: Array[Node] = []
	for child in maintenance_schedule_body.get_children():
		var id := str(child.get_meta("maintenance_id", ""))
		if id != "" and not existing_rows.has(id):
			existing_rows[id] = child
		else:
			disposable_nodes.append(child)
	for node in disposable_nodes:
		_remove_maintenance_schedule_node(node)

	var rows := _filtered_maintenance_rows()
	var total_count := rows.size()
	if rows.is_empty():
		for row_node in existing_rows.values():
			_remove_maintenance_schedule_node(row_node as Node)
		maintenance_row_nodes.clear()
		maintenance_row_signatures.clear()
		var empty := Label.new()
		empty.text = "Nenhuma manutencao encontrada." if maintenance_search_input and maintenance_search_input.text.strip_edges() != "" else "Nenhuma manutencao cadastrada."
		empty.custom_minimum_size = Vector2(0, 58)
		empty.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		empty.add_theme_color_override("font_color", MUTED)
		maintenance_schedule_body.add_child(empty)
		_refresh_maintenance_pager(0, 0, 0, 0)
		return

	var page_count := ceili(float(total_count) / float(TABLE_PAGE_SIZE))
	maintenance_current_page = clampi(maintenance_current_page, 0, maxi(page_count - 1, 0))
	var start_index := maintenance_current_page * TABLE_PAGE_SIZE
	var end_index := mini(start_index + TABLE_PAGE_SIZE, total_count)
	var next_nodes := {}
	var next_signatures := {}
	for index in range(start_index, end_index):
		var item := rows[index] as Dictionary
		var id := str(item.get("id", ""))
		var signature := _maintenance_row_signature(item)
		var row_node := existing_rows.get(id) as Control
		if row_node == null \
				or not is_instance_valid(row_node) \
				or str(row_node.get_meta("maintenance_signature", "")) != signature:
			var replacement := _make_maintenance_row(item)
			if row_node != null and is_instance_valid(row_node):
				_remove_maintenance_schedule_node(row_node)
			maintenance_schedule_body.add_child(replacement)
			row_node = replacement
		maintenance_schedule_body.move_child(row_node, index - start_index)
		next_nodes[id] = row_node
		next_signatures[id] = signature

	for id in existing_rows:
		if not next_nodes.has(id):
			_remove_maintenance_schedule_node(existing_rows.get(id) as Node)
	maintenance_row_nodes = next_nodes
	maintenance_row_signatures = next_signatures

	_refresh_maintenance_pager(total_count, page_count, start_index, end_index)


func _maintenance_row_signature(item: Dictionary) -> String:
	return str(JSON.stringify(item).hash())


func _remove_maintenance_schedule_node(node: Node) -> void:
	if node == null or not is_instance_valid(node):
		return
	if node.get_parent() != null:
		node.get_parent().remove_child(node)
	node.queue_free()


func _refresh_maintenance_summary_labels() -> void:
	if maintenance_summary_value_labels.is_empty():
		return
	var pending := store.get_maintenances()
	var all_rows := store.get_maintenances(true)
	var scheduled := 0
	var completed := 0
	for item in pending:
		if str(item.get("scheduled_date", "")).strip_edges() != "" \
				or str(item.get("scheduled_time", "")).strip_edges() != "":
			scheduled += 1
	for item in all_rows:
		if str(item.get("status", "")) == "concluido":
			completed += 1
	var values := {
		"total": pending.size(),
		"scheduled": scheduled,
		"unscheduled": maxi(pending.size() - scheduled, 0),
		"completed": completed,
	}
	for key in values:
		var label := maintenance_summary_value_labels.get(key) as Label
		if label != null and is_instance_valid(label):
			label.text = str(values.get(key, 0))


func _filtered_maintenance_rows() -> Array[Dictionary]:
	var rows := store.get_maintenances()
	var query := _search_key(str(maintenance_search_input.text if maintenance_search_input else ""))
	var result: Array[Dictionary] = []
	for item in rows:
		if maintenance_status_filter == "scheduled" \
			and str(item.get("scheduled_date", "")).strip_edges() == "" \
			and str(item.get("scheduled_time", "")).strip_edges() == "":
			continue
		var searchable := _search_key("%s %s %s %s %s %s" % [
			str(item.get("client", "")),
			str(item.get("plate", "")),
			str(item.get("serial", "")),
			str(item.get("scheduled_date", "")),
			str(item.get("scheduled_time", "")),
			str(item.get("note", "")),
		])
		if query == "" or searchable.contains(query):
			result.append(item)
	return result


