		row.add_child(_make_preview_cell(str(result.get("sga_rastreio_text", "")), 290, _sga_result_color(rastreio)))
		row.add_child(_make_preview_cell(str(result.get("sga_protecao_text", "")), 0, _sga_result_color(protecao), true))
