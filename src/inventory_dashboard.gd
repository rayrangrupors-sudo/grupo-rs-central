func _request_register_maintenances() -> void:
	if maintenance_text_edit == null or maintenance_text_edit.text.strip_edges() == "":
		_show_warning("Aviso", "Cole os dados antes de cadastrar.")
		return

	_confirm_action(
		"Cadastrar manutencoes",
		"Deseja realmente cadastrar as manutencoes informadas?",
		func(): _register_maintenances(true)
	)


func _register_maintenances(show_dialog: bool = true) -> void:
	if maintenance_text_edit == null:
		return

	var parsed: ParseResult = _parse_maintenance_text(maintenance_text_edit.text)

	var rows := parsed.rows
	var errors := parsed.errors

	if rows.is_empty():
		@warning_ignore("confusable_local_declaration")
		var message := "Nenhuma linha válida encontrada."

		if not errors.is_empty():
			message += "\n" + _join_messages(errors, 6)

		_show_maintenance_result(message, false)

		if show_dialog:
			_show_error("Erro", message)

		return

	var result := store.add_maintenances(rows)

	var created: int = result.get("created", 0)
	var updated: int = result.get("updated", 0)
	var save_errors: Array[String] = []
	for error_value in result.get("errors", []) as Array:
		save_errors.append(str(error_value))

	var all_errors: Array[String] = []
	all_errors.append_array(errors)
	all_errors.append_array(save_errors)

	var message := "Cadastradas: %d | Atualizadas: %d" % [created, updated]

	if not all_errors.is_empty():
		message += "\n" + _join_messages(all_errors, 6)

	_show_maintenance_result(message, all_errors.is_empty())
	_log_system_action("Cadastro de manutenções", message)

	if show_dialog:
		if all_errors.is_empty():
			_show_success("Sucesso", message)
		else:
			_show_error("Erro", message)


