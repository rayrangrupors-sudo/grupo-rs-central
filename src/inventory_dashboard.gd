func _guardian_apply_safe_fix(action: String, _component: Dictionary) -> Dictionary:
	match action:
		"restart_timers":
			var restarted: Array[String] = []
			for timer_name in _guardian_timer_map().keys():
				var timer: Variant = _guardian_timer_map().get(timer_name)
				if timer != null and is_instance_valid(timer) and (timer as Timer).is_stopped():
					(timer as Timer).start()
					restarted.append(str(timer_name))
			return {
				"ok": _guardian_timer_component().get("status", "error") == "ok",
				"message": "Rotinas reiniciadas: %s" % (", ".join(restarted) if not restarted.is_empty() else "nenhuma"),
			}
		"renew_grupo_rs_session":
			if _grupo_rs_api_reads_enabled():
				grupo_rs_api_logged_in = false
				grupo_rs_api_token = ""
				var api_result := await _grupo_rs_api_login()
				if bool(api_result.get("ok", false)):
					return {"ok": true, "message": "Sessao da API oficial renovada."}
			if _grupo_rs_platform_reads_enabled() and _grupo_rs_supports_modern_api():
				modern_grupo_rs_cookies.clear()
				modern_grupo_rs_logged_in = false
				var modern_result := await _modern_grupo_rs_login()
				return {"ok": bool(modern_result.get("ok", false)), "message": str(modern_result.get("message", "Sessao Grupo RS renovada."))}
			if _grupo_rs_platform_reads_enabled():
				legacy_grupo_rs_cookies.erase(_legacy_grupo_rs_root_url())
				legacy_grupo_rs_logged_in.erase(_legacy_grupo_rs_root_url())
				var legacy_result := await _legacy_grupo_rs_login()
				return {"ok": bool(legacy_result.get("ok", false)), "message": str(legacy_result.get("message", "Sessao Grupo RS renovada."))}
			return {"ok": false, "message": "As fontes de leitura do Grupo RS estao desligadas."}
		"renew_linksolutions_session":
			var link_result := await _request_linksolutions_login()
			return {"ok": bool(link_result.get("ok", false)), "message": str(link_result.get("message", "Sessao Link Solutions renovada."))}
		"release_transient_locks":
			auto_reset_running = false
			online_plate_sync_running = false
			return {"ok": true, "message": "Travas temporarias locais liberadas."}
		"clear_transient_caches":
			var reset_result := _reset_operational_query_state()
			return {"ok": true, "message": str(reset_result.get("message", "Filas e caches temporarios reiniciados."))}
	return {"ok": false, "message": "Acao nao reconhecida pelo painel."}


func _guardian_audit_event(event: Dictionary) -> void:
	var kind := str(event.get("kind", "info"))
	if not ["repair", "error", "blocked"].has(kind):
		return
	_log_system_action(
		"Assistente IA %s" % kind,
		"Componente: %s | %s | %s" % [
			str(event.get("component", "")),
			str(event.get("title", "")),
			str(event.get("details", "")),
		]
	)
	if ["error", "blocked"].has(kind):
		_assistant_create_codex_escalation_from_guardian_event(event.duplicate(true))


func _setup_auto_reset_monitor() -> void:
	if not _branch_supports_auto_monitor():
		return
	_load_auto_reset_state()
	_setup_experttexting_poll()

	auto_reset_timer = Timer.new()
	auto_reset_timer.wait_time = AUTO_RESET_MONITOR_INTERVAL_SECONDS
	auto_reset_timer.one_shot = false
	auto_reset_timer.timeout.connect(func(): _run_auto_reset_monitor("intervalo"))
	add_child(auto_reset_timer)
	if auto_reset_enabled:
		auto_reset_timer.start()

	auto_reset_recheck_timer = Timer.new()
	auto_reset_recheck_timer.wait_time = 60.0
	auto_reset_recheck_timer.one_shot = false
	auto_reset_recheck_timer.timeout.connect(_process_auto_reset_rechecks)
	auto_reset_recheck_timer.timeout.connect(_audit_auto_reset_maintenances)
	add_child(auto_reset_recheck_timer)
	if auto_reset_enabled:
		auto_reset_recheck_timer.start()

	auto_reset_countdown_timer = Timer.new()
	auto_reset_countdown_timer.wait_time = 1.0
	auto_reset_countdown_timer.one_shot = false
	auto_reset_countdown_timer.timeout.connect(_refresh_auto_reset_countdown)
	add_child(auto_reset_countdown_timer)
	auto_reset_countdown_timer.start()

	var startup_timer := Timer.new()
	startup_timer.one_shot = true
	startup_timer.wait_time = 60.0
	startup_timer.timeout.connect(func():
		if is_instance_valid(startup_timer):
			startup_timer.queue_free()
		if auto_reset_enabled:
			_run_auto_reset_monitor("inicial")
	)
	add_child(startup_timer)
	startup_timer.start()
	_update_auto_reset_feedback("Monitor: aguardando" if auto_reset_enabled else "Monitor: desligado", MUTED)


func _setup_experttexting_poll() -> void:
	if experttexting_poll_timer != null and is_instance_valid(experttexting_poll_timer):
		return
	experttexting_poll_timer = Timer.new()
	experttexting_poll_timer.wait_time = EXPERTTEXTING_POLL_SECONDS
	experttexting_poll_timer.one_shot = false
	experttexting_poll_timer.timeout.connect(func(): _poll_experttexting("intervalo"))
	add_child(experttexting_poll_timer)
	experttexting_poll_timer.start()
	if _experttexting_is_configured() and _experttexting_is_enabled():
		call_deferred("_poll_experttexting", "inicial")


func _experttexting_credentials() -> Dictionary:
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var username := OS.get_environment("EXPERTTEXTING_USERNAME").strip_edges()
	var api_key := OS.get_environment("EXPERTTEXTING_API_KEY").strip_edges()
	var api_secret := OS.get_environment("EXPERTTEXTING_API_SECRET").strip_edges()
	if username == "":
		username = str(settings.get("experttexting_username", "")).strip_edges()
	if api_key == "":
		api_key = str(settings.get("experttexting_api_key", "")).strip_edges()
	if api_secret == "":
		api_secret = str(settings.get("experttexting_api_secret", "")).strip_edges()
	return {
		"username": username,
		"api_key": api_key,
		"api_secret": api_secret,
		"from": str(settings.get("experttexting_sender", "DEFAULT")).strip_edges(),
	}


func _experttexting_is_configured() -> bool:
	var credentials := _experttexting_credentials()
	return str(credentials.get("username", "")) != "" \
		and str(credentials.get("api_key", "")) != "" \
		and str(credentials.get("api_secret", "")) != ""


func _experttexting_is_enabled() -> bool:
	return bool(_read_json_dictionary(SETTINGS_PATH).get("experttexting_enabled", true))


func _experttexting_inbox_is_enabled() -> bool:
	return bool(_read_json_dictionary(SETTINGS_PATH).get("experttexting_inbox_enabled", true))


func _experttexting_limit(setting_key: String, fallback: float) -> float:
	return maxf(float(_read_json_dictionary(SETTINGS_PATH).get(setting_key, fallback)), 0.0)


func _experttexting_auth_fields() -> Dictionary:
	var credentials := _experttexting_credentials()
	return {
		"username": str(credentials.get("username", "")),
		"api_key": str(credentials.get("api_key", "")),
		"api_secret": str(credentials.get("api_secret", "")),
	}


func _experttexting_url(endpoint: String, extra_fields: Dictionary = {}) -> String:
	var fields := _experttexting_auth_fields()
	for key in extra_fields.keys():
		fields[key] = extra_fields.get(key)
	return "%s?%s" % [endpoint, _form_urlencode(fields)]


func _parse_experttexting_response(body: String) -> Dictionary:
	var parsed: Variant = JSON.parse_string(body)
	if typeof(parsed) != TYPE_DICTIONARY:
		return {"ok": false, "message": "ExpertTexting retornou JSON invalido."}
	var data := parsed as Dictionary
	var status := int(data.get("Status", data.get("status", -1)))
	var error_message := str(data.get("ErrorMessage", data.get("errorMessage", data.get("message", "")))).strip_edges()
	var response: Variant = data.get("Response", data.get("response", null))
	if status != 0:
		if error_message == "":
			error_message = "ExpertTexting recusou a solicitacao (codigo %d)." % status
		return {"ok": false, "status_code": status, "message": error_message, "response": response}
	return {"ok": true, "status_code": status, "message": error_message, "response": response}


func _experttexting_e164_number(value: String) -> String:
	var digits := _digits_only(value)
	while digits.begins_with("00"):
		digits = digits.substr(2)
	if (digits.length() == 10 or digits.length() == 11) and not digits.begins_with("55"):
		digits = "55" + digits
	if digits.length() < 10 or digits.length() > 15:
		return ""
	return digits


func _experttexting_usage_for_prefix(prefix: String) -> Dictionary:
	var metrics := {"count": 0, "cost": 0.0}
	for date_key in experttexting_usage_ledger.keys():
		if not str(date_key).begins_with(prefix):
			continue
		var item: Dictionary = experttexting_usage_ledger.get(date_key, {})
		metrics["count"] = int(metrics.get("count", 0)) + int(item.get("count", 0))
		metrics["cost"] = float(metrics.get("cost", 0.0)) + float(item.get("cost", 0.0))
	return metrics


func _experttexting_record_usage(price: float) -> void:
	var date_key := Time.get_date_string_from_system()
	var item: Dictionary = experttexting_usage_ledger.get(date_key, {"count": 0, "cost": 0.0})
	item["count"] = int(item.get("count", 0)) + 1
	item["cost"] = float(item.get("cost", 0.0)) + maxf(price, 0.0)
	experttexting_usage_ledger[date_key] = item
	_prune_experttexting_local_state()
	_save_auto_reset_state()


func _experttexting_budget_guard() -> Dictionary:
	if not _experttexting_is_enabled():
		return {"ok": false, "message": "Integracao ExpertTexting esta desativada."}
	if not _experttexting_is_configured():
		return {"ok": false, "message": "Informe usuario, chave e segredo da API ExpertTexting."}
	if experttexting_last_balance_at <= 0 or _auto_reset_now_unix() - experttexting_last_balance_at >= EXPERTTEXTING_BALANCE_CACHE_SECONDS:
		var refreshed := await _experttexting_refresh_balance(false)
		if not bool(refreshed.get("ok", false)):
			return {"ok": false, "message": "Saldo ExpertTexting nao confirmado: %s" % str(refreshed.get("message", "consulta indisponivel"))}
	var estimated_cost := EXPERTTEXTING_FALLBACK_SMS_COST_USD
	var today := _experttexting_usage_for_prefix(Time.get_date_string_from_system())
	var month := _experttexting_usage_for_prefix(Time.get_date_string_from_system().substr(0, 7))
	var daily_limit := _experttexting_limit("experttexting_daily_limit_usd", EXPERTTEXTING_DEFAULT_DAILY_LIMIT_USD)
	var monthly_limit := _experttexting_limit("experttexting_monthly_limit_usd", EXPERTTEXTING_DEFAULT_MONTHLY_LIMIT_USD)
	var minimum_balance := _experttexting_limit("experttexting_minimum_balance_usd", EXPERTTEXTING_DEFAULT_MINIMUM_BALANCE_USD)
	if daily_limit > 0.0 and float(today.get("cost", 0.0)) + estimated_cost > daily_limit:
		return {"ok": false, "message": "Limite diario de SMS atingido (%s)." % _format_monitor_usd(daily_limit)}
	if monthly_limit > 0.0 and float(month.get("cost", 0.0)) + estimated_cost > monthly_limit:
		return {"ok": false, "message": "Limite mensal de SMS atingido (%s)." % _format_monitor_usd(monthly_limit)}
	if experttexting_last_balance >= 0.0 and experttexting_last_balance - estimated_cost < minimum_balance:
		return {"ok": false, "message": "Saldo protegido: %s. Minimo configurado: %s." % [_format_monitor_usd(experttexting_last_balance), _format_monitor_usd(minimum_balance)]}
	return {"ok": true}


func _experttexting_send_sms(number: String, message: String) -> Dictionary:
	var clean_number := _experttexting_e164_number(number)
	var clean_message := message.strip_edges()
	if clean_number == "" or clean_message == "":
		return {"ok": false, "message": "Telefone ou mensagem invalidos para ExpertTexting."}
	var guard := await _experttexting_budget_guard()
	if not bool(guard.get("ok", false)):
		return guard
	var credentials := _experttexting_credentials()
	var fields := _experttexting_auth_fields()
	fields["from"] = str(credentials.get("from", "DEFAULT")) if str(credentials.get("from", "")).strip_edges() != "" else "DEFAULT"
	fields["to"] = clean_number
	fields["text"] = clean_message
	fields["type"] = "text"
	var response := await _http_post_form_with_headers(
		EXPERTTEXTING_SEND_URL,
		fields,
		PackedStringArray(["User-Agent: GrupoRSCentral/1.0"])
	)
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": str(response.get("message", "Falha HTTP ExpertTexting."))}
	var parsed := _parse_experttexting_response(str(response.get("body", "")))
	if not bool(parsed.get("ok", false)):
		return parsed
	var provider_response: Dictionary = {}
	if typeof(parsed.get("response", null)) == TYPE_DICTIONARY:
		provider_response = parsed.get("response") as Dictionary
	var message_id := str(provider_response.get("message_id", provider_response.get("MessageId", ""))).strip_edges()
	var price := float(provider_response.get("price", provider_response.get("Price", EXPERTTEXTING_FALLBACK_SMS_COST_USD)))
	if price <= 0.0:
		price = EXPERTTEXTING_FALLBACK_SMS_COST_USD
	_experttexting_record_usage(price)
	if experttexting_last_balance >= 0.0:
		experttexting_last_balance = maxf(experttexting_last_balance - price, 0.0)
	return {
		"ok": true,
		"provider": "experttexting",
		"message_id": message_id,
		"price": price,
		"phone": clean_number,
		"provider_status": "ACEITO",
	}


func _experttexting_refresh_balance(save_state: bool = true) -> Dictionary:
	if not _experttexting_is_configured():
		return {"ok": false, "message": "API ExpertTexting nao configurada."}
	var response := await _http_get_text_with_headers(
		_experttexting_url(EXPERTTEXTING_BALANCE_URL),
		PackedStringArray(["User-Agent: GrupoRSCentral/1.0"])
	)
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": str(response.get("message", "Falha ao consultar saldo."))}
	var parsed := _parse_experttexting_response(str(response.get("body", "")))
	if not bool(parsed.get("ok", false)):
		return parsed
	var provider_response: Dictionary = {}
	if typeof(parsed.get("response", null)) == TYPE_DICTIONARY:
		provider_response = parsed.get("response") as Dictionary
	experttexting_last_balance = float(provider_response.get("Balance", provider_response.get("balance", -1.0)))
	experttexting_last_balance_at = _auto_reset_now_unix()
	experttexting_last_sync_at = experttexting_last_balance_at
	experttexting_last_error = ""
	if save_state:
		_save_auto_reset_state()
	return {"ok": experttexting_last_balance >= 0.0, "balance": experttexting_last_balance, "message": "Saldo atualizado."}


func _experttexting_message_status(message_id: String) -> Dictionary:
	if message_id.strip_edges() == "" or not _experttexting_is_configured():
		return {"ok": false, "message": "Mensagem ou API ExpertTexting indisponivel."}
	var response := await _http_get_text_with_headers(
		_experttexting_url(EXPERTTEXTING_STATUS_URL, {"message_id": message_id}),
		PackedStringArray(["User-Agent: GrupoRSCentral/1.0"])
	)
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": str(response.get("message", "Falha ao consultar status."))}
	var parsed := _parse_experttexting_response(str(response.get("body", "")))
	if not bool(parsed.get("ok", false)):
		return parsed
	var provider_response: Dictionary = {}
	if typeof(parsed.get("response", null)) == TYPE_DICTIONARY:
		provider_response = parsed.get("response") as Dictionary
	return {"ok": true, "status": str(provider_response.get("Status", provider_response.get("status", "DESCONHECIDO"))).strip_edges().to_upper()}


func _experttexting_unread_inbox() -> Dictionary:
	if not _experttexting_is_configured():
		return {"ok": false, "message": "API ExpertTexting nao configurada.", "messages": []}
	var response := await _http_get_text_with_headers(
		_experttexting_url(EXPERTTEXTING_UNREAD_INBOX_URL),
		PackedStringArray(["User-Agent: GrupoRSCentral/1.0"])
	)
	if not bool(response.get("ok", false)):
		return {"ok": false, "message": str(response.get("message", "Falha ao consultar recebidos.")), "messages": []}
	var parsed := _parse_experttexting_response(str(response.get("body", "")))
	if not bool(parsed.get("ok", false)):
		parsed["messages"] = []
		return parsed
	var messages: Array[Dictionary] = []
	var raw_response: Variant = parsed.get("response", [])
	if typeof(raw_response) == TYPE_ARRAY:
		for raw_message in raw_response:
			if typeof(raw_message) == TYPE_DICTIONARY:
				var item := raw_message as Dictionary
				messages.append({
					"sender": _experttexting_e164_number(str(item.get("Sender", item.get("sender", "")))),
					"text": str(item.get("Text", item.get("text", ""))).strip_edges(),
					"date": str(item.get("Date", item.get("date", ""))).strip_edges(),
				})
	return {"ok": true, "messages": messages}


func _poll_experttexting(reason: String = "manual") -> Dictionary:
	if experttexting_poll_running:
		return {"ok": false, "message": "Consulta ExpertTexting ja esta em andamento."}
	if not _experttexting_is_enabled() or not _experttexting_is_configured():
		return {"ok": false, "message": "API ExpertTexting aguardando configuracao."}
	experttexting_poll_running = true
	var errors: Array[String] = []
	var balance_result := await _experttexting_refresh_balance(false)
	if not bool(balance_result.get("ok", false)):
		errors.append(str(balance_result.get("message", "saldo indisponivel")))
	if _experttexting_inbox_is_enabled():
		var inbox_result := await _experttexting_pull_inbox()
		if not bool(inbox_result.get("ok", false)):
			errors.append(str(inbox_result.get("message", "caixa de entrada indisponivel")))
	var status_result := await _experttexting_poll_pending_statuses()
	if not bool(status_result.get("ok", false)):
		errors.append(str(status_result.get("message", "status indisponivel")))
	experttexting_last_sync_at = _auto_reset_now_unix()
	experttexting_last_error = "; ".join(errors)
	experttexting_poll_running = false
	_save_auto_reset_state()
	_refresh_auto_reset_dashboard_if_visible()
	# O painel SMS e atualizado tanto na consulta inicial quanto nos intervalos;
	# assim o operador ve saldo, status e ultima sincronizacao sem trocar de aba.
	if current_section == "sms_panel":
		call_deferred("_show_sms_panel")
	return {"ok": errors.is_empty(), "message": "Integracao atualizada." if errors.is_empty() else experttexting_last_error}


func _experttexting_poll_pending_statuses() -> Dictionary:
	var checked := 0
	var errors := 0
	for serial in auto_reset_attempts.keys():
		if checked >= EXPERTTEXTING_MAX_STATUS_PER_POLL:
			break
		var attempt: Dictionary = auto_reset_attempts.get(serial, {})
		var message_id := str(attempt.get("message_id", "")).strip_edges()
		var current_status := str(attempt.get("provider_status", "")).to_upper()
		if message_id == "" or ["SENT", "DELIVERED", "FAILED", "REJECTED", "EXPIRED", "UNDELIVERED"].has(current_status):
			continue
		var result := await _experttexting_message_status(message_id)
		checked += 1
		if not bool(result.get("ok", false)):
			errors += 1
			continue
		var next_status := str(result.get("status", "DESCONHECIDO")).to_upper()
		attempt["provider_status"] = next_status
		attempt["provider_status_at"] = _auto_reset_now_unix()
		auto_reset_attempts[serial] = attempt
		if next_status != current_status:
			_log_system_action("ExpertTexting status", "Mensagem %s | Status: %s" % [message_id, next_status], str(serial))
		await get_tree().process_frame
	return {"ok": errors == 0, "checked": checked, "message": "%d status com falha." % errors if errors > 0 else ""}


func _experttexting_pull_inbox() -> Dictionary:
	var result := await _experttexting_unread_inbox()
	if not bool(result.get("ok", false)):
		return result
	var added := 0
	var raw_messages: Variant = result.get("messages", [])
	if typeof(raw_messages) != TYPE_ARRAY:
		return {"ok": true, "added": 0}
	for raw_message in raw_messages:
		if typeof(raw_message) != TYPE_DICTIONARY:
			continue
		var message := raw_message as Dictionary
		var sender := _experttexting_e164_number(str(message.get("sender", "")))
		var text_value := str(message.get("text", "")).strip_edges()
		var date_value := str(message.get("date", "")).strip_edges()
		var signature := "%s|%s|%s" % [sender, text_value, date_value]
		var message_hash := signature.sha256_text()
		if experttexting_seen_inbox.has(message_hash):
			continue
		experttexting_seen_inbox[message_hash] = _auto_reset_now_unix()
		var serial := _experttexting_find_serial_by_phone(sender)
		var event := {
			"sender": sender,
			"text": text_value,
			"date": date_value,
			"serial": serial,
			"received_at": _auto_reset_now_unix(),
		}
		experttexting_inbox_events.push_front(event)
		if serial != "":
			var attempt: Dictionary = auto_reset_attempts.get(serial, {})
			attempt["reply_at"] = _auto_reset_now_unix()
			attempt["reply_text"] = text_value
			attempt["provider_status"] = "REPLIED"
			auto_reset_attempts[serial] = attempt
		_log_system_action(
			"ExpertTexting recebeu SMS",
			"Remetente: %s | Data: %s | Texto: %s" % [sender, date_value, text_value.left(240)],
			serial
		)
		added += 1
	_prune_experttexting_local_state()
	return {"ok": true, "added": added}


func _experttexting_find_serial_by_phone(phone: String) -> String:
	var wanted := _experttexting_e164_number(phone)
	if wanted == "":
		return ""
	for serial in auto_reset_attempts.keys():
		var attempt: Dictionary = auto_reset_attempts.get(serial, {})
		if _experttexting_e164_number(str(attempt.get("phone", ""))) == wanted:
			return str(serial)
	for serial in auto_reset_due_rechecks.keys():
		var item: Dictionary = auto_reset_due_rechecks.get(serial, {})
		var product: Dictionary = item.get("product", {}) if typeof(item.get("product", {})) == TYPE_DICTIONARY else {}
		var candidate := str(product.get("phone", product.get("chip_phone", "")))
		if _experttexting_e164_number(candidate) == wanted:
			return str(serial)
	return ""


func _prune_experttexting_local_state() -> void:
	if experttexting_inbox_events.size() > EXPERTTEXTING_INBOX_HISTORY_LIMIT:
		experttexting_inbox_events.resize(EXPERTTEXTING_INBOX_HISTORY_LIMIT)
	var ledger_keys: Array = experttexting_usage_ledger.keys()
	ledger_keys.sort()
	while ledger_keys.size() > EXPERTTEXTING_USAGE_RETENTION_DAYS:
		experttexting_usage_ledger.erase(ledger_keys.pop_front())
	var seen_keys: Array = experttexting_seen_inbox.keys()
	seen_keys.sort_custom(func(a, b): return int(experttexting_seen_inbox.get(a, 0)) < int(experttexting_seen_inbox.get(b, 0)))
	while seen_keys.size() > EXPERTTEXTING_INBOX_HISTORY_LIMIT * 2:
		experttexting_seen_inbox.erase(seen_keys.pop_front())


func _prune_sms_panel_events() -> void:
	if sms_panel_events.size() > SMS_PANEL_HISTORY_LIMIT:
		sms_panel_events.resize(SMS_PANEL_HISTORY_LIMIT)


func _sms_panel_mask_phone(phone: String) -> String:
	var digits := _digits_only(phone)
	if digits.length() <= 4:
		return digits
	return "(**) *****-%s" % digits.right(4)


func _sms_panel_status_label(raw_status: String, ok: bool = false) -> String:
	var status := raw_status.strip_edges().to_upper()
	if status == "":
		return "Aceito" if ok else "Falho"
	match status:
		"ACEITO", "ACCEPTED", "QUEUED", "QUEUE", "PENDING", "PROCESSING":
			return "Aceito"
		"SENT", "ENVIADO", "SUBMITTED":
			return "Enviado"
		"DELIVERED", "ENTREGUE", "REPLIED":
			return "Entregue"
		"FAILED", "FAIL", "FALHO", "REJECTED", "UNDELIVERED", "EXPIRED", "ERROR":
			return "Falho"
		_:
			return status.capitalize()


func _sms_panel_record_send(serial: String, phone: String, result: Dictionary, origin: String = "Programa", message: String = "") -> void:
	var ok := bool(result.get("ok", false))
	var provider_status := str(result.get("provider_status", result.get("status", ""))).strip_edges().to_upper()
	var status := _sms_panel_status_label(provider_status, ok)
	var now := Time.get_datetime_dict_from_system()
	var event := {
		"id": str(result.get("message_id", "")) if str(result.get("message_id", "")).strip_edges() != "" else "%s-%s-%s" % [str(Time.get_unix_time_from_system()), str(Time.get_ticks_msec()), str(serial)],
		"serial": _digits_only(serial),
		"phone": _sms_panel_mask_phone(phone),
		"origin": origin,
		"status": status,
		"provider_status": provider_status if provider_status != "" else ("ACCEPTED" if ok else "FAILED"),
		"message_id": str(result.get("message_id", "")),
		"price": float(result.get("price", 0.0)),
		"timestamp": Time.get_datetime_string_from_system(false, true),
		"date": "%04d-%02d-%02d" % [int(now.get("year", 0)), int(now.get("month", 0)), int(now.get("day", 0))],
		"time": "%02d:%02d:%02d" % [int(now.get("hour", 0)), int(now.get("minute", 0)), int(now.get("second", 0))],
		"error": str(result.get("message", "")) if not ok else "",
		"message_preview": message.strip_edges().left(80),
	}
	sms_panel_events.push_front(event)
	_prune_sms_panel_events()
	# O estado da tela e apenas um cache de sessao. O registro permanente fica
	# no log estruturado, que tambem permite reconstruir o historico depois que
	# o executavel for fechado ou o cache de runtime for limpo.
	var log_details := "Origem: %s | Serie: %s | Telefone: %s | Status: %s | Provedor: %s | ID: %s | Custo: %s" % [
		origin,
		str(event.get("serial", "")),
		str(event.get("phone", "")),
		status,
		str(event.get("provider_status", "")),
		str(event.get("message_id", "")) if str(event.get("message_id", "")).strip_edges() != "" else "--",
		_format_monitor_usd(float(event.get("price", 0.0))),
	]
	var error_text := str(event.get("error", "")).strip_edges()
	if error_text != "":
		log_details += " | Erro: %s" % error_text.left(180)
	_log_system_action_event(
		"SMS painel",
		log_details,
		str(event.get("serial", "")),
		{
			"phase": "sms",
			"operation": "send",
			"origin": origin,
			"status": "completed" if ok else "failed",
			"message": error_text,
			"sms_event": event.duplicate(true),
		}
	)
	_save_auto_reset_state()
	if current_section == "sms_panel":
		call_deferred("_show_sms_panel")


func _load_sms_panel_history() -> void:
	if store == null:
		return
	var restored: Array[Dictionary] = []
	var known_ids: Dictionary = {}
	# Runtime state continua sendo usado como cache rapido quando disponivel.
	# A fonte duravel e o log abaixo, portanto uma falha do cache nao apaga o
	# historico visivel para o operador.
	var raw_states: Variant = store.get_runtime_state(AUTO_RESET_STATE_SETTINGS_KEY, {})
	if typeof(raw_states) == TYPE_DICTIONARY:
		var raw_state: Variant = (raw_states as Dictionary).get(_auto_reset_state_branch_key(), {})
		if typeof(raw_state) == TYPE_DICTIONARY:
			var raw_events: Variant = (raw_state as Dictionary).get("sms_panel_events", [])
			if typeof(raw_events) == TYPE_ARRAY:
				for raw_event in raw_events:
					if typeof(raw_event) != TYPE_DICTIONARY:
						continue
					var event := (raw_event as Dictionary).duplicate(true)
					var event_id := str(event.get("id", "")).strip_edges()
					if event_id == "":
						continue
					known_ids[event_id] = true
					restored.append(event)

	# Os logs chegam do Firebase depois da sincronizacao e sobrevivem ao
	# encerramento do programa. Eventos estruturados novos sao preferidos;
	# registros antigos sem esse bloco continuam preservados no log, mas nao
	# podem ser reconstruidos com seguranca.
	for log_entry in store.get_system_logs(0):
		var action := str(log_entry.get("action", "")).to_lower()
		if not action.contains("sms painel"):
			continue
		var raw_event: Variant = log_entry.get("sms_event", {})
		if typeof(raw_event) != TYPE_DICTIONARY:
			continue
		var event := (raw_event as Dictionary).duplicate(true)
		var event_id := str(event.get("id", "")).strip_edges()
		if event_id == "":
			event_id = str(log_entry.get("id", "")).strip_edges()
			event["id"] = event_id
		if known_ids.has(event_id):
			continue
		known_ids[event_id] = true
		restored.append(event)

	restored.sort_custom(func(a: Dictionary, b: Dictionary):
		return str(a.get("timestamp", "")) > str(b.get("timestamp", ""))
	)
	sms_panel_events = restored
	_prune_sms_panel_events()


func _auto_reset_state_branch_key() -> String:
	return selected_branch_id if selected_branch_id.strip_edges() != "" else "default"


func _request_auto_reset_safe_stop() -> void:
	if not auto_reset_enabled:
		_update_auto_reset_feedback("Monitor: ja esta desligado", MUTED)
		return
	if auto_reset_stop_requested:
		_update_auto_reset_feedback("Monitor: parada segura solicitada", YELLOW)
		return

	auto_reset_stop_requested = true
	_log_system_action(
		"Monitor recebeu pedido de parada",
		"A parada sera concluida depois da operacao atual, sem interromper SMS ou consulta em andamento."
	)
	if auto_reset_running:
		_update_auto_reset_feedback("Monitor: concluindo operacao para desligar", YELLOW)
	else:
		_complete_auto_reset_safe_stop()


func _complete_auto_reset_safe_stop() -> void:
	auto_reset_enabled = false
	auto_reset_stop_requested = false
	if auto_reset_timer != null and is_instance_valid(auto_reset_timer):
		auto_reset_timer.stop()
	if auto_reset_recheck_timer != null and is_instance_valid(auto_reset_recheck_timer):
		auto_reset_recheck_timer.stop()
	_update_auto_reset_feedback("Monitor: desligado com seguranca", MUTED)
	_save_auto_reset_state()
	_log_system_action(
		"Monitor desligado com seguranca",
		"Nenhuma operacao foi interrompida. Rechecks pendentes preservados: %d." % auto_reset_due_rechecks.size()
	)
	if auto_reset_view_section != "":
		call_deferred("_refresh_auto_reset_dashboard_if_visible")


func _resume_auto_reset_monitor() -> void:
	if auto_reset_enabled and not auto_reset_stop_requested:
		_update_auto_reset_feedback("Monitor: ja esta ligado", GREEN)
		return
	auto_reset_enabled = true
	auto_reset_stop_requested = false
	if auto_reset_timer != null and is_instance_valid(auto_reset_timer):
		auto_reset_timer.start(AUTO_RESET_MONITOR_INTERVAL_SECONDS)
	if auto_reset_recheck_timer != null and is_instance_valid(auto_reset_recheck_timer):
		auto_reset_recheck_timer.start(60.0)
	_update_auto_reset_feedback("Monitor: ligado, preparando ciclo", GREEN)
	_save_auto_reset_state()
	_log_system_action("Monitor ligado", "Ciclos automaticos e rechecks retomados com seguranca.")
	call_deferred("_run_auto_reset_monitor", "retomada manual")
	call_deferred("_refresh_auto_reset_dashboard_if_visible")


func _load_auto_reset_state() -> void:
	auto_reset_scan_cursor = 0
	auto_reset_remote_scan_cursor = 0
	auto_reset_attempts.clear()
	auto_reset_due_rechecks.clear()
	auto_reset_first_stale.clear()
	auto_reset_last_summary = "Monitor: ativo"
	auto_reset_enabled = true
	auto_reset_stop_requested = false
	experttexting_last_balance = -1.0
	experttexting_last_balance_at = 0
	experttexting_last_sync_at = 0
	experttexting_last_error = ""
	experttexting_inbox_events.clear()
	experttexting_usage_ledger.clear()
	experttexting_seen_inbox.clear()
	sms_panel_events.clear()
	var raw_states: Variant = store.get_runtime_state(AUTO_RESET_STATE_SETTINGS_KEY, {}) if store != null else {}
	if typeof(raw_states) == TYPE_DICTIONARY and (raw_states as Dictionary).is_empty():
		var legacy_settings := _read_json_dictionary(SETTINGS_PATH)
		var legacy_states: Variant = legacy_settings.get(AUTO_RESET_STATE_SETTINGS_KEY, {})
		if typeof(legacy_states) == TYPE_DICTIONARY and not (legacy_states as Dictionary).is_empty():
			raw_states = (legacy_states as Dictionary).duplicate(true)
			if store != null:
				store.set_runtime_state(AUTO_RESET_STATE_SETTINGS_KEY, raw_states)
			legacy_settings.erase(AUTO_RESET_STATE_SETTINGS_KEY)
			_write_json_dictionary(SETTINGS_PATH, legacy_settings)
	if typeof(raw_states) != TYPE_DICTIONARY:
		return

	var states := raw_states as Dictionary
	var raw_state: Variant = states.get(_auto_reset_state_branch_key(), {})
	if typeof(raw_state) != TYPE_DICTIONARY:
		return

	var state := raw_state as Dictionary
	auto_reset_scan_cursor = int(state.get("scan_cursor", 0))
	auto_reset_remote_scan_cursor = int(state.get("remote_scan_cursor", 0))

	var raw_attempts: Variant = state.get("attempts", {})
	if typeof(raw_attempts) == TYPE_DICTIONARY:
		auto_reset_attempts = (raw_attempts as Dictionary).duplicate(true)

	var raw_rechecks: Variant = state.get("due_rechecks", {})
	if typeof(raw_rechecks) == TYPE_DICTIONARY:
		auto_reset_due_rechecks = (raw_rechecks as Dictionary).duplicate(true)

	var raw_first_stale: Variant = state.get("first_stale", {})
	if typeof(raw_first_stale) == TYPE_DICTIONARY:
		auto_reset_first_stale = (raw_first_stale as Dictionary).duplicate(true)

	var summary := str(state.get("summary", "")).strip_edges()
	if summary != "":
		auto_reset_last_summary = summary
	auto_reset_enabled = bool(state.get("enabled", true))
	auto_reset_stop_requested = false
	experttexting_last_balance = float(state.get("experttexting_last_balance", -1.0))
	experttexting_last_balance_at = int(state.get("experttexting_last_balance_at", 0))
	experttexting_last_sync_at = int(state.get("experttexting_last_sync_at", 0))
	experttexting_last_error = str(state.get("experttexting_last_error", ""))
	var raw_inbox: Variant = state.get("experttexting_inbox_events", [])
	if typeof(raw_inbox) == TYPE_ARRAY:
		for event in raw_inbox:
			if typeof(event) == TYPE_DICTIONARY:
				experttexting_inbox_events.append((event as Dictionary).duplicate(true))
	var raw_ledger: Variant = state.get("experttexting_usage_ledger", {})
	if typeof(raw_ledger) == TYPE_DICTIONARY:
		experttexting_usage_ledger = (raw_ledger as Dictionary).duplicate(true)
	var raw_seen: Variant = state.get("experttexting_seen_inbox", {})
	if typeof(raw_seen) == TYPE_DICTIONARY:
		experttexting_seen_inbox = (raw_seen as Dictionary).duplicate(true)
	var raw_sms_events: Variant = state.get("sms_panel_events", [])
	if typeof(raw_sms_events) == TYPE_ARRAY:
		for event in raw_sms_events:
			if typeof(event) == TYPE_DICTIONARY:
				sms_panel_events.append((event as Dictionary).duplicate(true))
	_prune_experttexting_local_state()
	_prune_sms_panel_events()
	if _migrate_auto_reset_recheck_deadlines():
		_save_auto_reset_state()


func _migrate_auto_reset_recheck_deadlines() -> bool:
	var changed := false
	var now := _auto_reset_now_unix()
	for serial in auto_reset_due_rechecks.keys():
		var item: Dictionary = auto_reset_due_rechecks.get(serial, {})
		var attempt: Dictionary = auto_reset_attempts.get(serial, {})
		var last_sent := int(attempt.get("last_sent", 0))
		var minimum_due := last_sent + AUTO_RESET_RECHECK_SECONDS if last_sent > 0 else now + AUTO_RESET_RECHECK_SECONDS
		if int(item.get("due_at", 0)) >= minimum_due:
			continue
		item["due_at"] = minimum_due
		item["migrated_to_24h"] = true
		auto_reset_due_rechecks[serial] = item
		changed = true
	return changed


func _save_auto_reset_state() -> void:
	if store == null or not store.is_remote_available():
		return
	var raw_states: Variant = store.get_runtime_state(AUTO_RESET_STATE_SETTINGS_KEY, {})
	var states: Dictionary = {}
	if typeof(raw_states) == TYPE_DICTIONARY:
		states = (raw_states as Dictionary).duplicate(true)
	states[_auto_reset_state_branch_key()] = {
		"scan_cursor": auto_reset_scan_cursor,
		"remote_scan_cursor": auto_reset_remote_scan_cursor,
		"attempts": auto_reset_attempts,
		"due_rechecks": auto_reset_due_rechecks,
		"first_stale": auto_reset_first_stale,
		"summary": auto_reset_last_summary,
		"enabled": auto_reset_enabled,
		"experttexting_last_balance": experttexting_last_balance,
		"experttexting_last_balance_at": experttexting_last_balance_at,
		"experttexting_last_sync_at": experttexting_last_sync_at,
		"experttexting_last_error": experttexting_last_error,
		"experttexting_inbox_events": experttexting_inbox_events,
		"experttexting_usage_ledger": experttexting_usage_ledger,
		"experttexting_seen_inbox": experttexting_seen_inbox,
		"sms_panel_events": sms_panel_events,
		"saved_at": Time.get_datetime_string_from_system(false, true),
	}
	store.set_runtime_state(AUTO_RESET_STATE_SETTINGS_KEY, states)


func _log_auto_reset_shutdown() -> void:
	_save_auto_reset_state()
	_log_system_action(
		"Monitor encerrado",
		"Cursor local: %d | cursor Grupo RS: %d | rechecks pendentes: %d" % [
			auto_reset_scan_cursor,
			auto_reset_remote_scan_cursor,
			auto_reset_due_rechecks.size(),
		]
	)


func _setup_online_plate_sync() -> void:
	online_plate_sync_timer = Timer.new()
	online_plate_sync_timer.wait_time = ONLINE_PLATE_SYNC_INTERVAL_SECONDS
	online_plate_sync_timer.one_shot = false
	online_plate_sync_timer.timeout.connect(func(): _run_online_plate_sync("intervalo"))
	add_child(online_plate_sync_timer)
	online_plate_sync_timer.start()

	var startup_timer := Timer.new()
	startup_timer.one_shot = true
	startup_timer.wait_time = 95.0
	startup_timer.timeout.connect(func():
		if is_instance_valid(startup_timer):
			startup_timer.queue_free()
		_run_online_plate_sync("inicial")
	)
	add_child(startup_timer)
	startup_timer.start()


func _run_online_plate_sync(reason: String) -> void:
	if online_plate_sync_running or store == null or not _branch_supports_stock_sync():
		return
	if _grupo_rs_supports_modern_api() and not _grupo_rs_platform_reads_enabled():
		_log_system_action(
			"Sincronizacao Grupo RS",
			"%s | ignorada: a API atual ainda nao retorna a associacao serie/placa necessaria para esta rotina." % reason
		)
		return

	online_plate_sync_running = true
	var products := store.get_products("", "all", false)
	products = products.filter(func(product: Dictionary) -> bool:
		var status := _status_key(product)
		return status == "estoque" or status == "reserva" or status == "manutencao" or status == "instalado"
	)

	var checked := 0
	var stock_like := 0
	var installed := 0
	var updated := 0
	var errors := 0
	var data_errors := 0
	var transport_errors := 0
	var pending_errors := 0
	var local_errors := 0

	if products.is_empty():
		online_plate_sync_running = false
		return

	var sync_started_at := Time.get_ticks_msec()
	var sync_errors: Array[Dictionary] = []
	while checked < mini(ONLINE_PLATE_SYNC_MAX_PER_CYCLE, products.size()):
		var index := online_plate_sync_cursor % products.size()
		online_plate_sync_cursor = (online_plate_sync_cursor + 1) % products.size()
		var product := products[index] as Dictionary
		var result := await _sync_product_plate_from_grupo_rs(product)
		checked += 1
		match str(result.get("action", "")):
			"stock":
				stock_like += 1
			"installed":
				installed += 1
			"updated":
				updated += 1
			"error":
				errors += 1
				var error_kind := str(result.get("error_kind", "data"))
				match error_kind:
					"transport":
						transport_errors += 1
					"pending":
						pending_errors += 1
					"local":
						local_errors += 1
					_:
						data_errors += 1
				sync_errors.append({
					"serial": _digits_only(str(product.get("imei", product.get("sku", "")))),
					"message": str(result.get("message", "Falha sem mensagem.")),
					"http_code": int(result.get("response_code", result.get("http_code", 0))),
					"kind": error_kind,
				})
		await get_tree().process_frame

	var successful := stock_like + installed + updated
	var sync_status := "completed" if errors == 0 else ("partial" if successful > 0 else "failed")
	var sync_action := "Sincronizacao Grupo RS concluida" if sync_status == "completed" else ("Sincronizacao Grupo RS parcial" if sync_status == "partial" else "Sincronizacao Grupo RS")
	var sync_details := "%s | verificados: %d | estoque/reserva: %d | baixas: %d | atualizados: %d | erros: %d" % [
			reason,
			checked,
			stock_like,
			installed,
			updated,
			errors,
	]
	if errors > 0:
		sync_details += " | dados invalidos: %d | transporte: %d | pendentes: %d | locais: %d" % [data_errors, transport_errors, pending_errors, local_errors]
	if not sync_errors.is_empty():
		var compact_errors: Array[String] = []
		for item in sync_errors.slice(0, 8):
			compact_errors.append("%s [%s%s]: %s" % [
				str(item.get("serial", "")),
				str(item.get("kind", "data")),
				(" HTTP %d" % int(item.get("http_code", 0))) if int(item.get("http_code", 0)) > 0 else "",
				str(item.get("message", "")),
			])
		sync_details += " | detalhes: %s" % " ; ".join(compact_errors)
	var first_http_code := 0
	var http_codes: Array[int] = []
	for item in sync_errors:
		var item_code := int(item.get("http_code", 0))
		if item_code <= 0:
			continue
		if first_http_code == 0:
			first_http_code = item_code
		if item_code not in http_codes:
			http_codes.append(item_code)
	_log_system_action_event(
		sync_action,
		sync_details,
		"",
		{
			"status": sync_status,
			"phase": "sincronizacao",
			"operation": "sincronizacao",
			"transport": "api" if _grupo_rs_supports_modern_api() and _grupo_rs_api_reads_enabled() else "web",
			"origin": "API Grupo RS" if _grupo_rs_supports_modern_api() and _grupo_rs_api_reads_enabled() else "Portal web",
			"http_code": first_http_code,
			"http_codes": http_codes,
			"attempt": 1,
			"max_attempts": 1,
			"latency_ms": maxi(int(Time.get_ticks_msec() - sync_started_at), 0),
			"correlation_id": "sync-%s-%d" % [reason, sync_started_at],
			"retryable": transport_errors > 0 or pending_errors > 0,
			"error_count": errors,
			"data_error_count": data_errors,
			"transport_error_count": transport_errors,
			"pending_error_count": pending_errors,
			"local_error_count": local_errors,
			"checked": checked,
			"stock_like": stock_like,
			"installed": installed,
			"updated": updated,
			"message": sync_details,
		}
	)
	if installed > 0 or updated > 0:
		_refresh_table()
	online_plate_sync_running = false


func _sync_product_plate_from_grupo_rs(product: Dictionary) -> Dictionary:
	var sku := str(product.get("sku", "")).strip_edges()
	var serial := _digits_only(str(product.get("imei", product.get("sku", ""))))
	if serial == "":
		serial = _digits_only(str(product.get("equipment_number", "")))
	if serial == "":
		return {"action": "error", "error_kind": "data", "message": "sem serie"}

	var rows := await _fetch_grupo_rs_equipment_rows(serial)
	if rows.is_empty():
		return {"action": "error", "error_kind": "data", "message": "nao encontrado"}

	var equipment := _choose_grupo_rs_equipment_row(rows, serial)
	var remote_plate := str(equipment.get("plate", "")).strip_edges().to_upper()
	if remote_plate == "":
		return {"action": "error", "error_kind": "data", "message": "sem placa online"}

	var local_plate := str(product.get("plate", "")).strip_edges().to_upper()
	var local_status := _status_key(product)
	var details := "Serie: %s | Placa online: %s | Placa local: %s" % [
		serial,
		remote_plate,
		_blank(local_plate),
	]

	if _is_internal_stock_plate(remote_plate):
		if local_status == "instalado" or _search_key(local_plate) != _search_key(remote_plate):
			var updated_product := product.duplicate(true)
			updated_product["plate"] = remote_plate
			if local_status == "instalado":
				updated_product["tracker_status"] = "Estoque"
				updated_product["status"] = "Estoque"
				updated_product["location"] = "Estoque"
				updated_product["stock"] = 1
				updated_product["installed_at"] = ""
				updated_product["discharged_at"] = ""
			var saved := store.upsert_product(updated_product)
			if saved.is_empty():
				return {"action": "error", "error_kind": "local", "message": "falha ao atualizar estoque"}
			_log_system_action("Sincronizou estoque Grupo RS", details, sku)
			return {"action": "updated"}
		return {"action": "stock"}

	if not _looks_like_vehicle_plate(remote_plate):
		return {"action": "error", "error_kind": "data", "message": "placa online invalida"}

	if local_status != "instalado":
		if not store.install_tracker(sku, remote_plate):
			return {"action": "error", "error_kind": "local", "message": "falha ao dar baixa"}
		_log_system_action("Baixa automatica Grupo RS", details, sku)
		return {"action": "installed"}

	if _search_key(local_plate) != _search_key(remote_plate):
		var updated_installed := product.duplicate(true)
		updated_installed["plate"] = remote_plate
		var saved_installed := store.upsert_product(updated_installed)
		if saved_installed.is_empty():
			return {"action": "error", "error_kind": "local", "message": "falha ao atualizar placa"}
		_log_system_action("Atualizou placa Grupo RS", details, sku)
		return {"action": "updated"}

	return {"action": "stock"}


func _is_internal_stock_plate(plate: String) -> bool:
	var text_value := plate.strip_edges().to_upper()
	var key := _search_key(text_value).to_upper()
	for prefix in INTERNAL_STOCK_PLATE_PREFIXES:
		if text_value.begins_with(prefix) or key.begins_with(prefix):
			return true
	return false


func _looks_like_vehicle_plate(plate: String) -> bool:
	var key := _search_key(plate).to_upper()
	if key.length() < 7:
		return false
	if _is_internal_stock_plate(plate):
		return false
	var regex := RegEx.new()
	if regex.compile("^[A-Z]{3}[A-Z0-9]{4,5}$") != OK:
		return key.length() >= 7
	return regex.search(key) != null


func _update_auto_reset_feedback(message: String, color: Color = MUTED) -> void:
	auto_reset_last_summary = message
	if color != Color.TRANSPARENT:
		auto_reset_status_color = color
	_refresh_auto_reset_countdown(color)


func _refresh_auto_reset_countdown(color: Color = Color.TRANSPARENT) -> void:
	_refresh_guardian_status_labels()
	if auto_reset_status_label == null or not is_instance_valid(auto_reset_status_label):
		if auto_reset_stage_indicator != null and is_instance_valid(auto_reset_stage_indicator):
			auto_reset_stage_indicator.set_state(_auto_reset_stage_from_summary(auto_reset_last_summary), auto_reset_status_color)
		return
	if color != Color.TRANSPARENT:
		auto_reset_status_color = color
		auto_reset_status_label.add_theme_color_override("font_color", color)

	auto_reset_status_label.text = _auto_reset_status_summary_text()
	if auto_reset_time_label != null and is_instance_valid(auto_reset_time_label):
		auto_reset_time_label.text = _auto_reset_time_text()
		var next_recheck := _next_auto_reset_recheck_seconds()
		if next_recheck >= 0:
			auto_reset_time_label.tooltip_text = "Proximo recheck em %s" % auto_reset_time_label.text
		elif auto_reset_timer != null and not auto_reset_timer.is_stopped():
			auto_reset_time_label.tooltip_text = "Proximo ciclo em %s" % auto_reset_time_label.text
		else:
			auto_reset_time_label.tooltip_text = "Temporizador do monitor"
		var timer_color := GREEN if auto_reset_running else BLUE_DARK
		if _next_auto_reset_recheck_seconds() >= 0:
			timer_color = YELLOW
		auto_reset_time_label.add_theme_color_override("font_color", timer_color)
	if auto_reset_stage_indicator != null and is_instance_valid(auto_reset_stage_indicator):
		auto_reset_stage_indicator.set_state(_auto_reset_stage_from_summary(auto_reset_last_summary), auto_reset_status_color)


func _auto_reset_stage_from_summary(summary: String) -> int:
	var key := summary.to_lower()
	if key.contains("recuper") or key.contains("manut"):
		return 3
	if key.contains("sms") or key.contains("reset") or key.contains("rechec"):
		return 2
	if key.contains("aguard") or key.contains("prox"):
		return 1
	return 0


func _auto_reset_status_text() -> String:
	var summary := _auto_reset_status_summary_text()
	var time_text := _auto_reset_time_text()
	if time_text != "":
		return "%s | %s" % [summary, time_text]
	return summary


func _auto_reset_status_summary_text() -> String:
	if auto_reset_last_summary.strip_edges() == "":
		return "Monitor: ativo"
	return auto_reset_last_summary


func _auto_reset_time_text() -> String:
	if not auto_reset_enabled:
		return "desligado"
	if auto_reset_running:
		return "parando" if auto_reset_stop_requested else "agora"

	var next_recheck := _next_auto_reset_recheck_seconds()
	if next_recheck >= 0:
		return _format_countdown(next_recheck)

	if auto_reset_timer != null and not auto_reset_timer.is_stopped():
		return _format_countdown(ceili(auto_reset_timer.time_left))

	return "--:--"


func _next_auto_reset_recheck_seconds() -> int:
	if auto_reset_due_rechecks.is_empty():
		return -1
	var now := _auto_reset_now_unix()
	var best := 999999999
	for serial in auto_reset_due_rechecks.keys():
		var item: Dictionary = auto_reset_due_rechecks.get(serial, {})
		var due := int(item.get("due_at", 0))
		if due <= 0:
			continue
		best = mini(best, maxi(due - now, 0))
	return -1 if best == 999999999 else best


func _format_countdown(seconds: int) -> String:
	var clean_seconds := maxi(seconds, 0)
	var minutes := clean_seconds / 60
	var secs := clean_seconds % 60
	if minutes >= 60:
		var hours := minutes / 60
		var rem_minutes := minutes % 60
		return "%02d:%02d:%02d" % [hours, rem_minutes, secs]
	return "%02d:%02d" % [minutes, secs]


func _run_auto_reset_monitor(reason: String = "manual") -> void:
	if auto_reset_running or store == null or not auto_reset_enabled or auto_reset_stop_requested:
		return
	if not auto_reset_due_rechecks.is_empty():
		var next_recheck := _next_auto_reset_recheck_seconds()
		if next_recheck == 0:
			call_deferred("_process_auto_reset_rechecks")
		_update_auto_reset_feedback(
			"Monitor: aguardando recheck de 24h (%s)" % _format_countdown(maxi(next_recheck, 0)),
			YELLOW
		)
		return

	auto_reset_running = true
	_update_auto_reset_feedback("Monitor: verificando...", BLUE_DARK)

	var stats := {
		"checked": 0,
		"stale": 0,
		"sent": 0,
		"skipped": 0,
		"errors": 0,
		"maintenance": 0,
	}

	var processed_serials := {}
	if _grupo_rs_supports_modern_api():
		var maintenance_products := await _auto_reset_grupo_rs_maintenance_products_for_cycle()
		var cycle_sent_serials: Array[String] = []
		var consecutive_errors := 0
		var paused_for_safety := false
		for index in range(maintenance_products.size()):
			if auto_reset_stop_requested:
				paused_for_safety = true
				break
			if int(stats.get("sent", 0)) >= AUTO_RESET_GRUPO_RS_MAX_SMS_PER_CYCLE:
				paused_for_safety = true
				_log_system_action(
					"Monitor pausou fila SMS",
					"Limite de seguranca por ciclo atingido: %d SMS. Restante fica para o proximo ciclo." % AUTO_RESET_GRUPO_RS_MAX_SMS_PER_CYCLE
				)
				break
			var remote_product := maintenance_products[index] as Dictionary
			var result := await _evaluate_auto_reset_grupo_rs_maintenance_product(remote_product)
			_update_auto_reset_stats(stats, result)
			var serial := _digits_only(_location_serial_for_product(remote_product))
			if serial != "":
				processed_serials[serial] = true
			if bool(result.get("sent", false)):
				consecutive_errors = 0
				if serial != "":
					cycle_sent_serials.append(serial)
				if index < maintenance_products.size() - 1:
					await _auto_reset_wait_between_grupo_rs_sms()
			elif bool(result.get("errors", false)):
				consecutive_errors += 1
				if consecutive_errors >= AUTO_RESET_GRUPO_RS_MAX_CONSECUTIVE_ERRORS:
					paused_for_safety = true
					_log_system_action(
						"Monitor pausou fila SMS",
						"%d falhas consecutivas no envio Grupo RS. Fila interrompida para evitar disparo incorreto." % consecutive_errors,
						serial
					)
					break
			await get_tree().process_frame
		if not cycle_sent_serials.is_empty():
			_auto_reset_defer_rechecks_after_batch(cycle_sent_serials)
		if paused_for_safety:
			stats["skipped"] = int(stats.get("skipped", 0)) + maxi(maintenance_products.size() - int(stats.get("checked", 0)), 0)
	else:
		var installed := _auto_reset_installed_products()
		if not installed.is_empty():
			var start := clampi(auto_reset_scan_cursor, 0, maxi(installed.size() - 1, 0))
			var processed := 0
			var index := start
			while processed < mini(AUTO_RESET_MAX_SCAN_PER_CYCLE, installed.size()):
				var product := installed[index] as Dictionary
				var serial := _digits_only(_location_serial_for_product(product))
				if serial != "":
					processed_serials[serial] = true
				var result := await _evaluate_auto_reset_product(product, false)
				_update_auto_reset_stats(stats, result)
				processed += 1
				index = (index + 1) % installed.size()
				if processed % 5 == 0:
					await get_tree().process_frame
			auto_reset_scan_cursor = index

		var grupo_rs_products := await _auto_reset_grupo_rs_products_for_cycle(processed_serials)
		for remote_product in grupo_rs_products:
			var result := await _evaluate_auto_reset_product(remote_product, false)
			_update_auto_reset_stats(stats, result)
			var serial := _digits_only(_location_serial_for_product(remote_product))
			if serial != "":
				processed_serials[serial] = true
			await get_tree().process_frame

	auto_reset_running = false
	_save_auto_reset_state()
	_log_system_action(
		"Monitor automatico",
		"%s | verificados: %d | desatualizados: %d | SMS: %d | manutencoes: %d | ignorados: %d | erros: %d" % [
			reason,
			int(stats.get("checked", 0)),
			int(stats.get("stale", 0)),
			int(stats.get("sent", 0)),
			int(stats.get("maintenance", 0)),
			int(stats.get("skipped", 0)),
			int(stats.get("errors", 0)),
		]
	)
	if auto_reset_stop_requested:
		_complete_auto_reset_safe_stop()
		return
	if int(stats.get("checked", 0)) <= 0:
		_update_auto_reset_feedback("Monitor: sem itens elegiveis", MUTED)
		return

	_update_auto_reset_feedback(
		"Monitor: %d ok, %d SMS, %d manut." % [
			int(stats.get("checked", 0)),
			int(stats.get("sent", 0)),
			int(stats.get("maintenance", 0)),
		],
		GREEN if int(stats.get("sent", 0)) > 0 else MUTED
	)


func _process_auto_reset_rechecks() -> void:
	if not auto_reset_enabled or auto_reset_stop_requested or auto_reset_running or auto_reset_due_rechecks.is_empty():
		return
	var now := _auto_reset_now_unix()
	var due_serials: Array[String] = []
	for serial in auto_reset_due_rechecks.keys():
		var item: Dictionary = auto_reset_due_rechecks.get(serial, {})
		if int(item.get("due_at", 0)) <= now:
			due_serials.append(str(serial))

	if due_serials.is_empty():
		return

	auto_reset_running = true
	_update_auto_reset_feedback("Monitor: rechecando...", BLUE_DARK)
	var grupo_rs_snapshot: Dictionary = {}
	for serial in due_serials:
		var pending_item: Dictionary = auto_reset_due_rechecks.get(serial, {})
		if str(pending_item.get("sms_queue_source", "")).strip_edges() == "grupo_rs_manual":
			grupo_rs_snapshot = await _build_auto_reset_grupo_rs_recheck_snapshot()
			break
	var sent := 0
	var resolved := 0
	var maintenance := 0
	for serial in due_serials:
		if auto_reset_stop_requested:
			break
		var item: Dictionary = auto_reset_due_rechecks.get(serial, {})
		auto_reset_due_rechecks.erase(serial)
		var product: Dictionary = {}
		var raw_product: Variant = item.get("product", {})
		if typeof(raw_product) == TYPE_DICTIONARY:
			product = (raw_product as Dictionary).duplicate(true)
		if product.is_empty():
			product = store.get_product(str(item.get("sku", serial)))
		if product.is_empty():
			product = {
				"sku": serial,
				"imei": serial,
				"equipment_number": serial,
				"monitor_source": str(item.get("source", AUTO_RESET_SOURCE_GRUPO_RS)),
			}
		if product.is_empty():
			continue
		var result: Dictionary = {}
		if _auto_reset_recheck_uses_grupo_rs_sms_queue(item, product):
			result = await _evaluate_auto_reset_grupo_rs_sms_recheck(str(serial), product, item, grupo_rs_snapshot)
		else:
			result = await _evaluate_auto_reset_product(product, true)
		if bool(result.get("resolved", false)):
			resolved += 1
		if bool(result.get("sent", false)):
			sent += 1
		if bool(result.get("maintenance", false)):
			maintenance += 1
		await get_tree().process_frame
	auto_reset_running = false
	_save_auto_reset_state()
	if auto_reset_stop_requested:
		_complete_auto_reset_safe_stop()
		return
	if not auto_reset_due_rechecks.is_empty():
		_update_auto_reset_feedback(
			"Monitor: aguardando recheck de 24h (%s)" % _format_countdown(maxi(_next_auto_reset_recheck_seconds(), 0)),
			YELLOW
		)
		return
	_update_auto_reset_feedback("Monitor: %d recuperado, %d manut.; buscando novos" % [resolved, maintenance], GREEN if resolved > 0 else MUTED)
	call_deferred("_run_auto_reset_monitor", "apos recheck de 24h")


func _auto_reset_grupo_rs_products_for_cycle(already_processed: Dictionary) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	if not _grupo_rs_supports_modern_api():
		return result

	var prefixes := _auto_reset_grupo_rs_prefixes()
	if prefixes.is_empty():
		return result

	var seen := {}
	var consumed := 0
	while consumed < mini(AUTO_RESET_REMOTE_PREFIXES_PER_CYCLE, prefixes.size()) and result.size() < AUTO_RESET_REMOTE_MAX_PER_CYCLE:
		var index := posmod(auto_reset_remote_scan_cursor, prefixes.size())
		auto_reset_remote_scan_cursor = (auto_reset_remote_scan_cursor + 1) % prefixes.size()
		var prefix := str(prefixes[index])
		var rows := await _fetch_grupo_rs_equipment_rows(prefix)
		for row in rows:
			if typeof(row) != TYPE_DICTIONARY:
				continue
			var product := _auto_reset_product_from_grupo_rs_row(row as Dictionary)
			if product.is_empty():
				continue
			var serial := _digits_only(_location_serial_for_product(product))
			if serial == "" or seen.has(serial) or already_processed.has(serial):
				continue
			if _auto_reset_grupo_rs_product_is_blocked(product):
				continue
			if _auto_reset_is_in_maintenance(serial, str(product.get("plate", ""))):
				continue
			seen[serial] = true
			result.append(product)
			if result.size() >= AUTO_RESET_REMOTE_MAX_PER_CYCLE:
				break
		consumed += 1
		await get_tree().process_frame

	_save_auto_reset_state()
	return result


func _auto_reset_grupo_rs_maintenance_products_for_cycle() -> Array[Dictionary]:
	var rows := await _fetch_grupo_rs_maintenance_rows()
	var result: Array[Dictionary] = []
	var result_index_by_serial := {}
	if rows.is_empty():
		return result

	var start := clampi(auto_reset_remote_scan_cursor, 0, maxi(rows.size() - 1, 0))
	var processed := 0
	var index := start
	while processed < rows.size():
		var row := rows[index] as Dictionary
		var serial := _digits_only(str(row.get("serial", "")))
		if _auto_reset_serial_is_024(serial) and _auto_reset_is_sms_candidate_interval(row):
			if not result_index_by_serial.has(serial):
				result_index_by_serial[serial] = result.size()
				result.append(row)
			else:
				var existing_index := int(result_index_by_serial.get(serial, -1))
				if existing_index >= 0 \
					and _auto_reset_is_platform_maintenance(row) \
					and not _auto_reset_is_platform_maintenance(result[existing_index]):
					result[existing_index] = row
		processed += 1
		index = (index + 1) % rows.size()

	auto_reset_remote_scan_cursor = index
	_save_auto_reset_state()
	return result


func _fetch_grupo_rs_maintenance_rows() -> Array[Dictionary]:
	var status := await _fetch_grupo_rs_maintenance_rows_with_status()
	var rows: Array[Dictionary] = []
	var raw_rows: Variant = status.get("rows", [])
	if typeof(raw_rows) == TYPE_ARRAY:
		for row in raw_rows:
			if typeof(row) == TYPE_DICTIONARY:
				rows.append((row as Dictionary).duplicate(true))
	return rows


func _fetch_grupo_rs_maintenance_rows_with_status(require_supported_apn: bool = true) -> Dictionary:
	if not _grupo_rs_supports_modern_api():
		return {"ok": false, "rows": [], "message": "Grupo RS novo indisponivel nesta base."}
	var rows: Array[Dictionary] = []
	var success_count := 0
	var requested_count := 0
	var succeeded_intervals: Array[String] = []
	var errors: Array[String] = []
	for interval_name in AUTO_RESET_GRUPO_RS_SMS_INTERVALS:
		var clean_interval := str(interval_name).strip_edges()
		if clean_interval == "":
			continue
		requested_count += 1
		var response := await _http_get_text(_modern_grupo_rs_url("/get_veiculos_intervalo.php?intervalo=%s" % clean_interval.uri_encode()))
		if not bool(response.get("ok", false)):
			errors.append("%s: %s" % [clean_interval, str(response.get("message", "falha na consulta"))])
			continue
		success_count += 1
		succeeded_intervals.append(clean_interval)
		rows.append_array(_parse_grupo_rs_maintenance_rows(str(response.get("body", "")), clean_interval, require_supported_apn))
		await get_tree().process_frame
	return {
		"ok": success_count > 0,
		"complete": requested_count > 0 and success_count == requested_count,
		"rows": rows,
		"succeeded_intervals": succeeded_intervals,
		"errors": errors,
		"message": "; ".join(errors),
	}


func _parse_grupo_rs_maintenance_rows(html: String, interval_name: String = "", require_supported_apn: bool = true) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	var tbody := _regex_first_group(html, "(?is)<tbody[^>]*>(.*?)</tbody>")
	if tbody == "":
		return rows

	var row_regex := RegEx.new()
	if row_regex.compile("(?is)<tr[^>]*>(.*?)</tr>") != OK:
		return rows

	for match_result in row_regex.search_all(tbody):
		var row_html := match_result.get_string(1)
		if row_html.contains("dcm-apn-row"):
			continue
		var cells := _html_table_cells(row_html)
		if cells.size() < 6:
			continue

		var sms_args := _parse_grupo_rs_sms_modal_args(row_html)
		var serial := _digits_only(str(sms_args.get("serial", cells[2])))
		var apn := str(sms_args.get("apn", cells[3])).strip_edges().to_lower()
		var phone := str(sms_args.get("phone", cells[4])).strip_edges()
		if not _auto_reset_serial_is_024(serial):
			continue
		if require_supported_apn and not _apn_is_hinova(apn) and not _apn_is_linksolutions(apn):
			continue

		rows.append({
			"sku": serial,
			"imei": serial,
			"equipment_number": serial,
			"serial": serial,
			"plate": str(cells[1]).strip_edges().to_upper(),
			"client": str(cells[0]).strip_edges(),
			"apn": apn,
			"chip_phone": phone,
			"phone": phone,
			"updated_at": str(cells[5]).strip_edges(),
			"monitor_interval": interval_name,
			"sms_queue_source": "grupo_rs_manual",
			"tracker_status": "Instalado",
			"status": "Instalado",
			"monitor_source": AUTO_RESET_SOURCE_GRUPO_RS,
		})
	return rows


func _parse_grupo_rs_sms_modal_args(onclick: String) -> Dictionary:
	var result := {"phone": "", "serial": "", "apn": ""}
	if onclick.strip_edges() == "":
		return result

	var regex := RegEx.new()
	if regex.compile("(?is)abrirSmsManualModal\\s*\\(\\s*['\"]([^'\"]*)['\"]\\s*,\\s*['\"]([^'\"]*)['\"]\\s*,\\s*['\"]([^'\"]*)['\"]") != OK:
		return result
	var match_result := regex.search(onclick)
	if match_result == null:
		return result
	result["phone"] = _decode_basic_html_entities(match_result.get_string(1)).strip_edges()
	result["serial"] = _digits_only(match_result.get_string(2))
	result["apn"] = _decode_basic_html_entities(match_result.get_string(3)).strip_edges().to_lower()
	return result


func _auto_reset_location_from_grupo_rs_product(product: Dictionary) -> Dictionary:
	var serial := _digits_only(str(product.get("serial", product.get("equipment_number", product.get("imei", "")))))
	return {
		"ok": true,
		"serial": serial,
		"equipment_serial": serial,
		"client": str(product.get("client", "")).strip_edges(),
		"plate": str(product.get("plate", "")).strip_edges().to_upper(),
		"updated_at": str(product.get("updated_at", product.get("source_date", ""))).strip_edges(),
		"monitor_interval": str(product.get("monitor_interval", "")).strip_edges(),
		"apn": str(product.get("apn", "")).strip_edges().to_lower(),
		"phone": str(product.get("phone", product.get("chip_phone", ""))).strip_edges(),
	}


func _evaluate_auto_reset_grupo_rs_maintenance_product(product: Dictionary) -> Dictionary:
	var serial := _digits_only(str(product.get("serial", product.get("equipment_number", product.get("imei", "")))))
	if not _auto_reset_serial_is_024(serial):
		return {"checked": true, "skipped": true, "message": "Ignorado: nao comeca com 024."}
	if not _auto_reset_is_sms_candidate_interval(product):
		return {"checked": true, "skipped": true, "message": "Fora da faixa de envio 24 - 72 Horas."}
	if _auto_reset_is_in_maintenance(serial, str(product.get("plate", ""))):
		return {"checked": true, "stale": true, "skipped": true, "message": "Ja esta na lista de manutencao."}
	var location := _auto_reset_location_from_grupo_rs_product(product)
	if not _auto_reset_location_is_stale(location):
		return {"checked": true, "skipped": true, "message": "Aguardando completar 24h01 sem comunicacao."}
	if _auto_reset_attempt_count_total(serial) >= AUTO_RESET_MAX_SMS_PER_INCIDENT:
		return {"checked": true, "stale": true, "skipped": true, "message": "SMS ja enviado anteriormente; bloqueio permanente ativo."}

	var apn := str(product.get("apn", "")).strip_edges().to_lower()
	if not _apn_is_hinova(apn) and not _apn_is_linksolutions(apn):
		return {"checked": true, "stale": true, "skipped": true, "message": "APN %s" % _blank(apn)}
	if not _auto_reset_can_send(serial):
		return {"checked": true, "stale": true, "skipped": true, "message": "SMS unico ja registrado."}

	var phone := str(product.get("phone", product.get("chip_phone", ""))).strip_edges()
	if _normalize_arya_sms_number(phone) == "":
		return {"checked": true, "stale": true, "skipped": true, "message": "Telefone invalido."}

	var command := _rs300_apn_command_for_apn(serial, apn)
	if command == "":
		return {"checked": true, "stale": true, "skipped": true, "message": "Sem comando para APN %s." % _blank(apn)}

	var interval_name := str(product.get("monitor_interval", "")).strip_edges()
	_update_auto_reset_feedback("Monitor: fila SMS %s %s" % [serial, apn.to_upper()], BLUE)
	var send_result := await _send_grupo_rs_sms_manual_queue(phone, serial, apn, command)
	var details := "Serie: %s | Placa: %s | Cliente: %s | Intervalo: %s | APN: %s | Telefone: %s | Ultima comunicacao: %s | Comando: %s" % [
		serial,
		str(product.get("plate", "")),
		str(product.get("client", "")),
		interval_name,
		apn,
		phone,
		str(product.get("updated_at", "")),
		command,
	]
	if bool(send_result.get("ok", false)):
		_auto_reset_register_attempt(serial, send_result)
		var recheck_product := product.duplicate(true)
		recheck_product["sms_queue_source"] = "grupo_rs_manual"
		recheck_product["monitor_source"] = AUTO_RESET_SOURCE_GRUPO_RS
		_schedule_auto_reset_recheck(serial, serial, recheck_product, _auto_reset_location_from_grupo_rs_product(recheck_product))
		_log_system_action("Monitor enviou SMS Grupo RS", "%s | Envio unico: %d/%d" % [
			details,
			_auto_reset_attempt_count_total(serial),
			AUTO_RESET_MAX_SMS_PER_INCIDENT,
		], serial)
		return {"checked": true, "stale": true, "sent": true}

	_log_system_action("Monitor falhou SMS Grupo RS", "%s | Erro: %s" % [details, str(send_result.get("message", ""))], serial)
	return {"checked": true, "stale": true, "errors": true}


func _send_grupo_rs_sms_manual_queue(phone: String, serial: String, apn: String, command: String) -> Dictionary:
	if not _branch_supports_sms():
		var disabled := {"ok": false, "message": "SMS desativado para esta base."}
		_sms_panel_record_send(serial, phone, disabled, "Programa", command)
		return disabled
	if _experttexting_is_enabled() and _experttexting_is_configured():
		var expert_result := await _experttexting_send_sms(phone, command)
		_sms_panel_record_send(serial, phone, expert_result, "Programa", command)
		return expert_result
	if not _grupo_rs_supports_modern_api():
		var unsupported := {"ok": false, "message": "Fila SMS Manual disponivel somente no Grupo RS novo."}
		_sms_panel_record_send(serial, phone, unsupported, "Programa", command)
		return unsupported
	var clean_phone := _format_grupo_rs_sms_phone(phone)
	var clean_serial := _digits_only(serial)
	if clean_phone == "" or not _manual_sms_serial_is_024(clean_serial) or command.strip_edges() == "":
		var invalid := {"ok": false, "message": "Dados insuficientes para SMS manual."}
		_sms_panel_record_send(serial, phone, invalid, "Programa", command)
		return invalid
	if not modern_grupo_rs_logged_in:
		var login := await _modern_grupo_rs_login()
		if not bool(login.get("ok", false)):
			_sms_panel_record_send(serial, phone, login, "Programa", command)
			return login

	var url := _modern_grupo_rs_url("/sms_manual.php?telefone=%s&equipamento=%s&apn=%s" % [
		clean_phone.uri_encode(),
		clean_serial.uri_encode(),
		apn.strip_edges().to_lower().uri_encode(),
	])
	var headers := _modern_grupo_rs_headers()
	headers.append("Referer: %s" % _modern_grupo_rs_url("/home_adm.php"))
	headers.append("Origin: %s" % _modern_grupo_rs_root_url())
	var response := await _http_post_form_with_headers(url, {
		"telefone": clean_phone,
		"mensagem": command.strip_edges(),
	}, headers)
	if not bool(response.get("ok", false)):
		_sms_panel_record_send(serial, phone, response, "Programa", command)
		return response
	var body := str(response.get("body", "")).to_lower()
	if body.contains("login.php") or body.contains("senha"):
		modern_grupo_rs_logged_in = false
		var relogin := await _modern_grupo_rs_login()
		if bool(relogin.get("ok", false)):
			headers = _modern_grupo_rs_headers()
			headers.append("Referer: %s" % _modern_grupo_rs_url("/home_adm.php"))
			headers.append("Origin: %s" % _modern_grupo_rs_root_url())
			response = await _http_post_form_with_headers(url, {
				"telefone": clean_phone,
				"mensagem": command.strip_edges(),
			}, headers)
			if not bool(response.get("ok", false)):
				_sms_panel_record_send(serial, phone, response, "Programa", command)
				return response
			body = str(response.get("body", "")).to_lower()
		if body.contains("login.php") or body.contains("senha"):
			var expired := {"ok": false, "message": "Sessao do Grupo RS expirou."}
			_sms_panel_record_send(serial, phone, expired, "Programa", command)
			return expired
	if body.contains("acesso negado"):
		modern_grupo_rs_logged_in = false
		var denied := {"ok": false, "message": "Grupo RS recusou o envio; confira login do sistema novo."}
		_sms_panel_record_send(serial, phone, denied, "Programa", command)
		return denied
	# HTTP 200 nao significa fila aceita: a tela precisa trazer evidencia do envio.
	var accepted_markers := ["sucesso", "enviado", "fila", "agendado", "confirmado", "mensagem"]
	var accepted := false
	for marker in accepted_markers:
		if body.contains(marker):
			accepted = true
			break
	if not accepted:
		var unconfirmed := {"ok": false, "message": "O portal respondeu sem confirmar a entrada na fila SMS."}
		_sms_panel_record_send(serial, phone, unconfirmed, "Programa", command)
		return unconfirmed
	var queued := {"ok": true, "provider_status": "QUEUED", "body": str(response.get("body", ""))}
	_sms_panel_record_send(serial, phone, queued, "Programa", command)
	return queued


func _auto_reset_recheck_uses_grupo_rs_sms_queue(item: Dictionary, product: Dictionary) -> bool:
	if str(item.get("sms_queue_source", "")).strip_edges() == "grupo_rs_manual":
		return true
	if str(product.get("sms_queue_source", "")).strip_edges() == "grupo_rs_manual":
		return true
	return str(product.get("monitor_interval", "")).strip_edges() != ""


func _evaluate_auto_reset_grupo_rs_sms_recheck(serial: String, product: Dictionary, item: Dictionary, snapshot: Dictionary = {}) -> Dictionary:
	var clean_serial := _digits_only(serial)
	if clean_serial == "":
		clean_serial = _digits_only(str(product.get("serial", product.get("equipment_number", product.get("imei", "")))))
	if not _auto_reset_serial_is_024(clean_serial):
		return {"checked": true, "skipped": true, "message": "Ignorado: nao comeca com 024."}

	var lookup: Dictionary = {}
	if snapshot.is_empty():
		lookup = await _find_grupo_rs_pending_sms_product(clean_serial)
	else:
		lookup = _find_grupo_rs_pending_sms_product_in_snapshot(clean_serial, snapshot)
	if not bool(lookup.get("ok", false)):
		item["due_at"] = _auto_reset_now_unix() + 300
		auto_reset_due_rechecks[clean_serial] = item.duplicate(true)
		_log_system_action("Monitor recheck pendente", "Serie: %s | Erro: %s" % [clean_serial, str(lookup.get("message", "Grupo RS indisponivel."))], clean_serial)
		return {"checked": true, "stale": true, "errors": true}

	if not bool(lookup.get("found", false)):
		_auto_reset_clear_stale_state(clean_serial)
		_update_auto_reset_feedback("Monitor: recuperado %s" % clean_serial, GREEN)
		_log_system_action("Monitor recuperado", "Serie: %s saiu da lista grafica apos o SMS." % clean_serial, clean_serial)
		return {"checked": true, "resolved": true}

	var pending_product: Dictionary = product.duplicate(true)
	var raw_pending: Variant = lookup.get("product", {})
	if typeof(raw_pending) == TYPE_DICTIONARY:
		pending_product = _merge_auto_reset_products(product, raw_pending as Dictionary)
	pending_product["monitor_confirmed_no_return"] = true
	var added := _auto_reset_add_maintenance_from_grupo_rs_product(clean_serial, pending_product)
	if added:
		_notify_auto_reset_oscillation(clean_serial, pending_product)
	return {"checked": true, "stale": true, "maintenance": added, "skipped": not added}


func _find_grupo_rs_pending_sms_product(serial: String) -> Dictionary:
	var clean_serial := _digits_only(serial)
	var fetched := await _build_auto_reset_grupo_rs_recheck_snapshot()
	return _find_grupo_rs_pending_sms_product_in_snapshot(clean_serial, fetched)


func _build_auto_reset_grupo_rs_recheck_snapshot() -> Dictionary:
	var fetched := await _fetch_grupo_rs_maintenance_rows_with_status()
	if not bool(fetched.get("ok", false)) or not bool(fetched.get("complete", false)):
		return {
			"ok": false,
			"products_by_serial": {},
			"message": str(fetched.get("message", "Falha ao consultar a lista grafica.")),
		}

	var products_by_serial := {}
	var raw_rows: Variant = fetched.get("rows", [])
	if typeof(raw_rows) == TYPE_ARRAY:
		for row in raw_rows:
			if typeof(row) != TYPE_DICTIONARY:
				continue
			var product := row as Dictionary
			var row_serial := _digits_only(str(product.get("serial", product.get("equipment_number", product.get("imei", "")))))
			if row_serial == "":
				continue
			if not products_by_serial.has(row_serial) or _auto_reset_is_platform_maintenance(product):
				products_by_serial[row_serial] = product.duplicate(true)
	return {"ok": true, "products_by_serial": products_by_serial}


func _find_grupo_rs_pending_sms_product_in_snapshot(serial: String, snapshot: Dictionary) -> Dictionary:
	if not bool(snapshot.get("ok", false)):
		return {"ok": false, "found": false, "message": str(snapshot.get("message", "Falha ao consultar a lista grafica."))}
	var products_by_serial: Dictionary = snapshot.get("products_by_serial", {})
	var clean_serial := _digits_only(serial)
	if products_by_serial.has(clean_serial):
		var product: Dictionary = products_by_serial.get(clean_serial, {})
		return {"ok": true, "found": true, "product": product.duplicate(true)}
	return {"ok": true, "found": false}


func _merge_auto_reset_products(original: Dictionary, latest: Dictionary) -> Dictionary:
	var merged := original.duplicate(true)
	for key in latest.keys():
		var latest_value: Variant = latest.get(key)
		if str(latest_value).strip_edges() != "":
			merged[key] = latest_value
	return merged


func _auto_reset_add_maintenance_from_grupo_rs_product(serial: String, product: Dictionary) -> bool:
	var recheck_product := product.duplicate(true)
	recheck_product["sms_queue_source"] = "grupo_rs_manual"
	recheck_product["monitor_source"] = AUTO_RESET_SOURCE_GRUPO_RS
	return _auto_reset_add_maintenance_from_location(
		serial,
		_auto_reset_location_from_grupo_rs_product(recheck_product),
		recheck_product
	)


func _auto_reset_is_platform_maintenance(product: Dictionary) -> bool:
	var interval_key := _auto_reset_text_key(str(product.get("monitor_interval", "")))
	return interval_key == "manutencao"


func _auto_reset_is_sms_candidate_interval(product: Dictionary) -> bool:
	return _auto_reset_text_key(str(product.get("monitor_interval", ""))) == "2472horas"


func _auto_reset_reschedule_preventive_watch(serial: String, product: Dictionary, previous_item: Dictionary = {}) -> void:
	var clean_serial := _digits_only(serial)
	if clean_serial == "":
		return
	var item := previous_item.duplicate(true)
	item["sku"] = str(item.get("sku", clean_serial))
	item["due_at"] = _auto_reset_now_unix() + AUTO_RESET_RECHECK_SECONDS
	item["source"] = str(product.get("monitor_source", AUTO_RESET_SOURCE_GRUPO_RS))
	item["sms_queue_source"] = "grupo_rs_manual"
	item["product"] = product.duplicate(true)
	item["location"] = _auto_reset_location_from_grupo_rs_product(product)
	item["preventive_watch"] = true
	auto_reset_due_rechecks[clean_serial] = item
	_save_auto_reset_state()


func _auto_reset_serial_is_024(serial: String) -> bool:
	var clean := _digits_only(serial)
	return clean.length() == 9 and clean.begins_with("024")


func _manual_sms_serial_is_024(serial: String) -> bool:
	var clean := _digits_only(serial)
	return clean.begins_with("024") and clean.length() >= 8 and clean.length() <= 12


func _auto_reset_grupo_rs_prefixes() -> Array[String]:
	var prefixes: Array[String] = []
	for number in range(100):
		prefixes.append("024%02d" % number)
	return prefixes


func _auto_reset_product_from_grupo_rs_row(row: Dictionary) -> Dictionary:
	var serial := _digits_only(str(row.get("serial", row.get("equipment_number", ""))))
	if serial == "" or not serial.begins_with("024"):
		return {}
	var status_key := _search_key(str(row.get("status", "")))
	if status_key.contains("inativo"):
		return {}
	return {
		"sku": serial,
		"imei": serial,
		"equipment_number": serial,
		"plate": str(row.get("plate", "")).strip_edges().to_upper(),
		"client": str(row.get("client", "")).strip_edges(),
		"chip_number": str(row.get("chip", "")).strip_edges(),
		"chip_phone": str(row.get("phone", "")).strip_edges(),
		"tracker_status": "Instalado",
		"status": "Instalado",
		"monitor_source": AUTO_RESET_SOURCE_GRUPO_RS,
	}


func _auto_reset_grupo_rs_product_is_blocked(product: Dictionary) -> bool:
	var client_key := _auto_reset_text_key(str(product.get("client", "")))
	var plate := str(product.get("plate", "")).strip_edges()
	var plate_key := _auto_reset_text_key(plate)
	if client_key.contains("rs300") or client_key.contains("manutencoes"):
		return true
	if plate_key.contains("rs300") or plate_key.contains("manutencoes"):
		return true
	return _is_internal_stock_plate(plate)


func _auto_reset_text_key(value: String) -> String:
	return _search_key(value) \
		.replace("ç", "c") \
		.replace("ã", "a") \
		.replace("á", "a") \
		.replace("à", "a") \
		.replace("â", "a") \
		.replace("é", "e") \
		.replace("ê", "e") \
		.replace("í", "i") \
		.replace("ó", "o") \
		.replace("õ", "o") \
		.replace("ô", "o") \
		.replace("ú", "u")


func _auto_reset_installed_products() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for product in store.get_products():
		if typeof(product) != TYPE_DICTIONARY:
			continue
		var item := product as Dictionary
		if _status_key(item) == "instalado":
			result.append(item)
	return result


func _evaluate_auto_reset_product(product: Dictionary, is_recheck: bool) -> Dictionary:
	var sku := str(product.get("sku", ""))
	var serial := _digits_only(_location_serial_for_product(product))
	if serial == "":
		return {"checked": true, "skipped": true, "message": "Sem serie."}
	if not serial.begins_with("024"):
		return {"checked": true, "skipped": true, "message": "Somente aparelhos 4G iniciados por 024."}
	if _auto_reset_is_in_maintenance(serial, str(product.get("plate", ""))):
		return {"checked": true, "skipped": true, "message": "Ja esta na lista de manutencao."}

	var location := await _lookup_grupo_rs_location(serial)
	if not bool(location.get("ok", false)):
		return {"checked": true, "errors": true, "message": str(location.get("message", "Grupo RS indisponivel."))}

	var command_serial := _digits_only(str(location.get("equipment_serial", serial)).strip_edges())
	if command_serial == "":
		command_serial = serial
	if not command_serial.begins_with("024"):
		return {"checked": true, "skipped": true, "message": "Equipamento retornado nao e 4G."}
	if _auto_reset_is_in_maintenance(command_serial, str(location.get("plate", product.get("plate", "")))):
		return {"checked": true, "skipped": true, "message": "Ja esta na lista de manutencao."}

	if not _auto_reset_location_is_stale(location):
		_auto_reset_clear_stale_state(command_serial)
		if is_recheck:
			var recovery_details := "Recuperado apos comando/SMS | Placa: %s | Cliente: %s | Voltou a comunicar: %s" % [
				str(location.get("plate", product.get("plate", ""))),
				str(location.get("client", product.get("client", ""))),
				str(location.get("updated_at", "")),
			]
			_update_auto_reset_feedback("Monitor: recuperado %s" % command_serial, GREEN)
			_log_system_action("Monitor recuperado", recovery_details, command_serial)
			return {"checked": true, "resolved": true}
		return {"checked": true}

	if _auto_reset_attempt_count_total(command_serial) >= AUTO_RESET_MAX_SMS_PER_INCIDENT:
		if is_recheck:
			var added := _auto_reset_add_maintenance_from_location(command_serial, location, product)
			if added:
				_notify_auto_reset_oscillation(command_serial, product)
			return {"checked": true, "stale": true, "maintenance": added, "skipped": not added}
		return {"checked": true, "stale": true, "skipped": true, "message": "SMS ja enviado anteriormente; bloqueio permanente ativo."}

	var resolved := await _resolve_arya_iccid_for_product_cached(product)
	if not bool(resolved.get("ok", false)):
		return {"checked": true, "stale": true, "skipped": true, "message": str(resolved.get("message", "Sem ICCID."))}

	var apn := str(resolved.get("apn", "")).strip_edges()
	if not _apn_is_hinova(apn):
		return {"checked": true, "stale": true, "skipped": true, "message": "APN %s" % _blank(apn)}

	if not _auto_reset_can_send(command_serial):
		return {"checked": true, "stale": true, "skipped": true, "message": "SMS unico ja registrado; aguardando recheck."}

	var iccid := str(resolved.get("iccid", ""))
	var inventory := await _lookup_arya_inventory_data(iccid)
	if not bool(inventory.get("ok", false)):
		return {"checked": true, "stale": true, "errors": true, "message": str(inventory.get("message", "Arya indisponivel."))}

	var parsed: Dictionary = inventory.get("parsed", {})
	if str(parsed.get("status", "")) != "online":
		return {"checked": true, "stale": true, "skipped": true, "message": "Chip nao esta online na Arya."}

	var number := _digits_only(str(parsed.get("phone", "")))
	if number == "":
		return {"checked": true, "stale": true, "skipped": true, "message": "Arya sem numero."}

	var command := str(_rs300_sms_commands(command_serial).get("apn", ""))
	_update_auto_reset_feedback("Monitor: enviando SMS %s" % command_serial, BLUE)
	var send_result := await _send_arya_sms(number, command)
	var source_label := "Grupo RS online" if str(product.get("monitor_source", AUTO_RESET_SOURCE_LOCAL)) == AUTO_RESET_SOURCE_GRUPO_RS else "cadastro local"
	var details := "Serie: %s | Placa: %s | ICCID: %s | Numero: %s | Ultima comunicacao: %s" % [
		command_serial,
		str(location.get("plate", product.get("plate", ""))),
		iccid,
		number,
		str(location.get("updated_at", "")),
	]
	if bool(send_result.get("ok", false)):
		_auto_reset_register_attempt(command_serial, send_result)
		_schedule_auto_reset_recheck(command_serial, sku, product, location)
		_log_system_action("Monitor enviou reset", "%s | Origem: %s | Envio unico: %d/%d | Comando: %s" % [
			details,
			source_label,
			_auto_reset_attempt_count_total(command_serial),
			AUTO_RESET_MAX_SMS_PER_INCIDENT,
			command,
		], command_serial)
		return {"checked": true, "stale": true, "sent": true}

	_log_system_action("Monitor falhou reset", "%s | Serie continua liberada para nova tentativa | Erro: %s" % [details, str(send_result.get("message", ""))], command_serial)
	return {"checked": true, "stale": true, "errors": true}


func _auto_reset_location_is_stale(location: Dictionary) -> bool:
	var updated_at := str(location.get("updated_at", "")).strip_edges()
	if updated_at == "":
		return false
	return _minutes_since_grupo_rs_datetime(updated_at) >= AUTO_RESET_STALE_MINUTES


func _minutes_since_grupo_rs_datetime(value: String) -> float:
	var unix := _grupo_rs_datetime_to_unix(value)
	if unix <= 0:
		return 0.0
	return maxf(0.0, float(_local_now_to_unix_like() - unix) / 60.0)


func _auto_reset_now_unix() -> int:
	return int(Time.get_unix_time_from_system())


func _auto_reset_can_send(serial: String) -> bool:
	var clean_serial := serial.strip_edges()
	if clean_serial == "":
		return false
	return _auto_reset_attempt_count_total(clean_serial) < AUTO_RESET_MAX_SMS_PER_INCIDENT


func _auto_reset_register_attempt(serial: String, provider_result: Dictionary = {}) -> void:
	var clean_serial := serial.strip_edges()
	var today := Time.get_date_string_from_system()
	var item: Dictionary = auto_reset_attempts.get(clean_serial, {})
	var total_attempts := int(item.get("total", item.get("count", 0)))
	if str(item.get("date", "")) != today:
		item = {"date": today, "count": 0, "last_sent": int(item.get("last_sent", 0)), "total": total_attempts}
	item["count"] = int(item.get("count", 0)) + 1
	item["total"] = total_attempts + 1
	item["last_sent"] = _auto_reset_now_unix()
	for key in ["provider", "message_id", "price", "provider_status", "phone"]:
		var value: Variant = provider_result.get(key, null)
		if value != null and str(value).strip_edges() != "":
			item[key] = value
	auto_reset_attempts[clean_serial] = item
	_save_auto_reset_state()


func _schedule_auto_reset_recheck(serial: String, sku: String, product: Dictionary = {}, location: Dictionary = {}) -> void:
	var clean_serial := serial.strip_edges()
	if clean_serial == "":
		return
	auto_reset_due_rechecks[clean_serial] = {
		"sku": sku,
		"due_at": _auto_reset_now_unix() + AUTO_RESET_RECHECK_SECONDS,
		"source": str(product.get("monitor_source", AUTO_RESET_SOURCE_LOCAL)),
		"sms_queue_source": str(product.get("sms_queue_source", "")),
		"product": product.duplicate(true),
		"location": location.duplicate(true),
	}
	_save_auto_reset_state()


func _auto_reset_defer_rechecks_after_batch(serials: Array[String]) -> void:
	if serials.is_empty():
		return
	var due_at := _auto_reset_now_unix() + AUTO_RESET_RECHECK_SECONDS
	var changed := 0
	for serial in serials:
		var clean_serial := _digits_only(serial)
		if clean_serial == "":
			continue
		if not auto_reset_due_rechecks.has(clean_serial):
			continue
		var item: Dictionary = auto_reset_due_rechecks.get(clean_serial, {})
		item["due_at"] = due_at
		item["batch_recheck"] = true
		auto_reset_due_rechecks[clean_serial] = item
		changed += 1
	if changed > 0:
		_save_auto_reset_state()
		_log_system_action(
			"Monitor agendou recheck em lote",
			"%d aparelho(s) serao rechecados em 24 horas apos o fim da fila." % changed
		)


func _auto_reset_wait_between_grupo_rs_sms() -> void:
	var delay := _auto_reset_grupo_rs_sms_delay_seconds()
	if delay <= 0.0:
		return
	_update_auto_reset_feedback("Monitor: aguardando %.0fs entre SMS" % delay, MUTED)
	await get_tree().create_timer(delay).timeout


func _auto_reset_grupo_rs_sms_delay_seconds() -> float:
	return AUTO_RESET_GRUPO_RS_SEND_DELAY_SECONDS


func _auto_reset_attempt_count_today(serial: String) -> int:
	var item: Dictionary = auto_reset_attempts.get(serial.strip_edges(), {})
	if str(item.get("date", "")) != Time.get_date_string_from_system():
		return 0
	return int(item.get("count", 0))


func _auto_reset_attempt_count_total(serial: String) -> int:
	var item: Dictionary = auto_reset_attempts.get(serial.strip_edges(), {})
	return int(item.get("total", item.get("count", 0)))


func _auto_reset_attempt_recheck_due(serial: String) -> bool:
	var item: Dictionary = auto_reset_attempts.get(serial.strip_edges(), {})
	var last_sent := int(item.get("last_sent", 0))
	return last_sent > 0 and _auto_reset_now_unix() - last_sent >= AUTO_RESET_RECHECK_SECONDS


func _auto_reset_stale_is_ready(serial: String, location: Dictionary) -> bool:
	var clean_serial := serial.strip_edges()
	if clean_serial == "":
		return false

	var now := _auto_reset_now_unix()
	var updated_at := str(location.get("updated_at", "")).strip_edges()
	var item: Dictionary = auto_reset_first_stale.get(clean_serial, {})
	if item.is_empty() or str(item.get("updated_at", "")) != updated_at:
		auto_reset_first_stale[clean_serial] = {
			"first_seen": now,
			"updated_at": updated_at,
			"plate": str(location.get("plate", "")),
			"client": str(location.get("client", "")),
		}
		_save_auto_reset_state()
		return false

	var first_seen := int(item.get("first_seen", now))
	return now - first_seen >= AUTO_RESET_STALE_MINUTES * 60


func _auto_reset_clear_stale_state(serial: String) -> void:
	var clean_serial := serial.strip_edges()
	if clean_serial == "":
		return
	var changed := false
	if auto_reset_first_stale.has(clean_serial):
		auto_reset_first_stale.erase(clean_serial)
		changed = true
	if auto_reset_due_rechecks.has(clean_serial):
		auto_reset_due_rechecks.erase(clean_serial)
		changed = true
	if changed:
		_save_auto_reset_state()


func _auto_reset_is_in_maintenance(serial: String, plate: String = "") -> bool:
	if store == null:
		return false
	var serial_key := _search_key(_digits_only(serial))
	var plate_key := _search_key(plate)
	for item in store.get_maintenances(false):
		if typeof(item) != TYPE_DICTIONARY:
			continue
		var row := item as Dictionary
		if not _auto_reset_maintenance_blocks_sms(row):
			continue
		var row_serial_key := _search_key(_digits_only(str(row.get("serial", ""))))
		var row_plate_key := _search_key(str(row.get("plate", "")))
		if serial_key != "" and row_serial_key == serial_key:
			return true
		if plate_key != "" and row_plate_key != "" and row_plate_key == plate_key:
			return true
	return false


func _auto_reset_maintenance_blocks_sms(item: Dictionary) -> bool:
	if _search_key(str(item.get("provider", ""))) == "monitorgruporsmanutencao":
		return true
	var note_key := _auto_reset_text_key(str(item.get("note", "")))
	if not note_key.contains("entradaautomaticapelomonitor"):
		return true
	if note_key.contains("intervalomanutencao"):
		return true
	if note_key.contains("intervalo624horas") or note_key.contains("intervalo2472horas"):
		return false
	return true


func _auto_reset_add_maintenance_from_location(serial: String, location: Dictionary, product: Dictionary) -> bool:
	if store == null:
		return false
	var clean_serial := _digits_only(serial)
	if clean_serial == "":
		return false

	var client := str(location.get("client", product.get("client", ""))).strip_edges()
	var plate := str(location.get("plate", product.get("plate", ""))).strip_edges().to_upper()
	if client == "":
		client = "CLIENTE NAO INFORMADO"
	if plate == "":
		plate = "SEM PLACA"

	var note := "Entrada automatica pelo monitor: sem retorno apos 24 horas do SMS. Ultima comunicacao: %s" % [
		str(location.get("updated_at", "")),
	]
	var interval_name := str(location.get("monitor_interval", product.get("monitor_interval", ""))).strip_edges()
	var apn := str(location.get("apn", product.get("apn", ""))).strip_edges()
	var phone := str(location.get("phone", product.get("phone", product.get("chip_phone", "")))).strip_edges()
	if interval_name != "":
		note += " | Intervalo: %s" % interval_name
	if apn != "":
		note += " | APN: %s" % apn
	if phone != "":
		note += " | Telefone: %s" % phone
	var promoted_maintenance_id := ""
	if _auto_reset_is_platform_maintenance(product):
		for existing_item in store.get_maintenances(false):
			if typeof(existing_item) != TYPE_DICTIONARY:
				continue
			var existing := existing_item as Dictionary
			if _digits_only(str(existing.get("serial", ""))) == clean_serial \
				and not _auto_reset_maintenance_blocks_sms(existing):
				promoted_maintenance_id = str(existing.get("id", ""))
				break
	var result := store.add_maintenances([{
		"client": client,
		"plate": plate,
		"serial": clean_serial,
		"provider": "monitor_grupo_rs_manutencao" if bool(product.get("monitor_confirmed_no_return", false)) or _auto_reset_is_platform_maintenance(product) else "monitor_automatico",
		"phone": phone,
		"source_date": str(location.get("updated_at", "")),
		"note": note,
	}])

	var created := int(result.get("created", 0))
	var updated := int(result.get("updated", 0))
	var ok := created > 0 or updated > 0
	if ok:
		if promoted_maintenance_id != "":
			store.update_maintenance_note(promoted_maintenance_id, note)
		_update_auto_reset_feedback("Monitor: manutencao %s" % clean_serial, YELLOW)
		_log_system_action(
			"Monitor colocou em manutencao",
			"Cliente: %s | Placa: %s | Serie: %s | Motivo: %s" % [client, plate, clean_serial, note],
			clean_serial
		)
		auto_reset_due_rechecks.erase(clean_serial)
		_save_auto_reset_state()
		if maintenance_schedule_body != null and is_instance_valid(maintenance_schedule_body):
			_refresh_maintenance_schedule_rows()
	return ok


func _notify_auto_reset_oscillation(serial: String, product: Dictionary) -> void:
	var clean_serial := _digits_only(serial)
	var client := str(product.get("client", "")).strip_edges()
	var plate := str(product.get("plate", "")).strip_edges().to_upper()
	var message := "Aparelho %s oscilante. Entre em contato com o associado" % clean_serial
	if client != "":
		message += " %s" % client
	message += ". Abra Manutencoes para ler mais."
	_log_system_action(
		"Alerta de aparelho oscilante",
		"%s | Placa: %s" % [message, _blank(plate)],
		clean_serial
	)
	_send_auto_reset_desktop_notification("Grupo RS Central", message)


func _send_auto_reset_desktop_notification(title: String, message: String) -> bool:
	if OS.get_name() != "Windows":
		return false
	DisplayServer.window_request_attention()
	var title_base64 := Marshalls.raw_to_base64(title.to_utf8_buffer())
	var message_base64 := Marshalls.raw_to_base64(message.to_utf8_buffer())
	var script := """
[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType=WindowsRuntime] > $null
[Windows.UI.Notifications.ToastNotification, Windows.UI.Notifications, ContentType=WindowsRuntime] > $null
[Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom.XmlDocument, ContentType=WindowsRuntime] > $null
$title = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('__TITLE_BASE64__'))
$message = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('__MESSAGE_BASE64__'))
$title = [Security.SecurityElement]::Escape($title)
$message = [Security.SecurityElement]::Escape($message)
$xml = New-Object Windows.Data.Xml.Dom.XmlDocument
$xmlText = '<toast><visual><binding template=''ToastGeneric''><text>' + $title + '</text><text>' + $message + '</text></binding></visual></toast>'
$xml.LoadXml($xmlText)
$toast = [Windows.UI.Notifications.ToastNotification]::new($xml)
[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('Grupo RS Central').Show($toast)
"""
	script = script.replace("__TITLE_BASE64__", title_base64).replace("__MESSAGE_BASE64__", message_base64)
	var pid := OS.create_process(
		"powershell.exe",
		PackedStringArray(["-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden", "-Command", script]),
		false
	)
	return pid > 0


func _audit_auto_reset_maintenances(force: bool = false) -> Dictionary:
	if store == null or auto_reset_maintenance_audit_running:
		return {"ok": false, "message": "Auditoria indisponivel."}
	if not force and (not auto_reset_enabled or auto_reset_stop_requested or auto_reset_running):
		return {"ok": false, "message": "Auditoria aguardando o monitor."}
	var now := _auto_reset_now_unix()
	if not force and now - auto_reset_maintenance_audit_last_at < AUTO_RESET_MAINTENANCE_AUDIT_INTERVAL_SECONDS:
		return {"ok": true, "skipped": true}

	auto_reset_maintenance_audit_running = true
	auto_reset_maintenance_audit_last_at = now
	var fetched := await _fetch_grupo_rs_maintenance_rows_with_status(false)
	if not bool(fetched.get("ok", false)) or not bool(fetched.get("complete", false)):
		auto_reset_maintenance_audit_running = false
		_log_system_action(
			"Auditoria de manutencoes adiada",
			"As listas 24 - 72 Horas e Manutencao nao responderam por completo. Nenhum registro foi removido. %s" % str(fetched.get("message", ""))
		)
		return {"ok": false, "message": str(fetched.get("message", "Consulta incompleta."))}

	var stale_serials := {}
	var raw_rows: Variant = fetched.get("rows", [])
	if typeof(raw_rows) == TYPE_ARRAY:
		for row in raw_rows:
			if typeof(row) != TYPE_DICTIONARY:
				continue
			var stale_serial := _digits_only(str((row as Dictionary).get("serial", "")))
			if _auto_reset_serial_is_024(stale_serial):
				stale_serials[stale_serial] = true

	var remove_ids: Array[String] = []
	var recovered_serials: Array[String] = []
	var deleted_serials: Array[String] = []
	var kept := 0
	var protected_errors := 0
	for maintenance in store.get_maintenances(false):
		if typeof(maintenance) != TYPE_DICTIONARY:
			continue
		var item := maintenance as Dictionary
		if not _auto_reset_maintenance_is_managed(item):
			continue
		var serial := _digits_only(str(item.get("serial", "")))
		if not _auto_reset_serial_is_024(serial):
			continue
		if stale_serials.has(serial):
			kept += 1
			continue
		var equipment_status := await _fetch_grupo_rs_equipment_presence(serial)
		if not bool(equipment_status.get("ok", false)):
			protected_errors += 1
			continue
		remove_ids.append(str(item.get("id", "")))
		if bool(equipment_status.get("found", false)):
			recovered_serials.append(serial)
		else:
			deleted_serials.append(serial)
		await get_tree().process_frame

	var removed := store.delete_maintenances(remove_ids)
	auto_reset_maintenance_audit_running = false
	if removed > 0:
		_log_system_action(
			"Monitor limpou manutencoes automaticas",
			"Removidas: %d | Voltaram a comunicar: %d (%s) | Excluidas da plataforma: %d (%s) | Mantidas desatualizadas: %d | Protegidas por erro de consulta: %d" % [
				removed,
				recovered_serials.size(),
				", ".join(recovered_serials),
				deleted_serials.size(),
				", ".join(deleted_serials),
				kept,
				protected_errors,
			]
		)
		if maintenance_schedule_body != null and is_instance_valid(maintenance_schedule_body):
			_refresh_maintenance_schedule_rows()
	return {
		"ok": true,
		"removed": removed,
		"recovered": recovered_serials.size(),
		"deleted": deleted_serials.size(),
		"kept": kept,
		"protected_errors": protected_errors,
	}


func _auto_reset_maintenance_is_managed(item: Dictionary) -> bool:
	var provider := _search_key(str(item.get("provider", "")))
	if provider in ["monitorgruporsmanutencao", "monitorautomatico"]:
		return true
	return _auto_reset_text_key(str(item.get("note", ""))).contains("entradaautomaticapelomonitor")


func _fetch_grupo_rs_equipment_presence(serial: String) -> Dictionary:
	if not _grupo_rs_supports_modern_api():
		return {"ok": false, "found": false, "message": "Grupo RS novo indisponivel."}
	var clean_serial := _digits_only(serial)
	var response := await _modern_grupo_rs_read_get("equipamentos_listar.php?busca=%s&status=todos" % clean_serial.uri_encode())
	if not bool(response.get("ok", false)):
		return {"ok": false, "found": false, "message": str(response.get("message", "Falha na consulta."))}
	for row in _parse_grupo_rs_equipment_rows(str(response.get("body", ""))):
		if _digits_only(str(row.get("serial", row.get("equipment_number", "")))) == clean_serial:
			return {"ok": true, "found": true}
	return {"ok": true, "found": false}


func _update_auto_reset_stats(stats: Dictionary, result: Dictionary) -> void:
	if bool(result.get("checked", false)):
		stats["checked"] = int(stats.get("checked", 0)) + 1
	if bool(result.get("stale", false)):
		stats["stale"] = int(stats.get("stale", 0)) + 1
	if bool(result.get("sent", false)):
		stats["sent"] = int(stats.get("sent", 0)) + 1
	if bool(result.get("skipped", false)):
		stats["skipped"] = int(stats.get("skipped", 0)) + 1
	if bool(result.get("errors", false)):
		stats["errors"] = int(stats.get("errors", 0)) + 1
	if bool(result.get("maintenance", false)):
		stats["maintenance"] = int(stats.get("maintenance", 0)) + 1


