func _make_page_button(text_value: String, enabled: bool, callback: Callable, selected: bool) -> Button:
	var button := Button.new()
	button.text = text_value
	button.disabled = not enabled
	button.custom_minimum_size = Vector2(44 if text_value.length() <= 2 else 92, 42)
	button.add_theme_font_override("font", UI_FONT)
	button.add_theme_font_size_override("font_size", 16)
	button.add_theme_color_override("font_color", Color.WHITE if selected else BLUE_DARK)
	button.add_theme_color_override("font_hover_color", Color.WHITE if selected else BLUE_DARK)
	button.add_theme_color_override("font_pressed_color", Color.WHITE if selected else BLUE_DARK)
	button.add_theme_color_override("font_disabled_color", Color.WHITE if selected else Color("#9aa3ad"))

	var fill := BLUE if selected else BUTTON_LIGHT_BLUE
	var border := BLUE if selected else BUTTON_LIGHT_BLUE_BORDER
	button.add_theme_stylebox_override("normal", _style_box(fill, border, 1, 6))
	button.add_theme_stylebox_override("hover", _style_box(fill.lightened(0.05), BLUE, 1, 6))
	button.add_theme_stylebox_override("pressed", _style_box(fill.darkened(0.05), BLUE, 1, 6))
	button.add_theme_stylebox_override("disabled", _style_box(fill if selected else BUTTON_GRAY, border if selected else BUTTON_GRAY_BORDER, 1, 6))
	if enabled and callback.is_valid():
		button.pressed.connect(callback)
	return button


