class FirebaseTopbarPulse:
	extends Control

	var state := "connecting"
	var phase := 0.0
	var animation_elapsed := 0.0
	const ANIMATION_INTERVAL_SECONDS := 0.08

	func _init() -> void:
		custom_minimum_size = Vector2(34, 34)
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		set_process(true)

	func set_status(next_state: String) -> void:
		state = next_state
		queue_redraw()

	func _process(delta: float) -> void:
		animation_elapsed += delta
		if animation_elapsed < ANIMATION_INTERVAL_SECONDS:
			return
		var elapsed := animation_elapsed
		animation_elapsed = 0.0
		phase = fmod(phase + elapsed * 0.9, 1.0)
		queue_redraw()

	func _draw() -> void:
		var center := size * 0.5
		var radius := minf(size.x, size.y) * 0.31
		var color := _state_color()
		var pulse := (sin(phase * TAU) + 1.0) * 0.5
		var arc_start := -PI * 0.5 + phase * TAU

		draw_circle(center, radius + 7.0 + pulse * 2.0, Color(color.r, color.g, color.b, 0.06))
		draw_arc(center, radius + 5.0, 0.0, TAU, 64, Color("#dbe8f2"), 2.0, true)
		draw_arc(center, radius + 5.0, arc_start, arc_start + PI * 1.35, 40, color, 2.5, true)
		draw_circle(center, radius, Color("#f7fbff"))
		draw_circle(center, radius, Color(color.r, color.g, color.b, 0.24), false, 1.5, true)
		draw_circle(center, radius * 0.53, Color(color.r, color.g, color.b, 0.12 + pulse * 0.04))
		draw_circle(center, radius * 0.25, color)
		draw_circle(center, radius * 0.10, Color.WHITE)

	func _state_color() -> Color:
		match state:
			"synced", "online":
				return Color("#13a56a")
			"degraded":
				return Color("#f29727")
			"syncing", "connecting", "pending", "idle":
				return Color("#0070b8")
			"offline":
				return Color("#f29727")
			"conflict", "auth_error", "error":
				return Color("#d64545")
			_:
				return Color("#8291a2")


class MonitorStageIndicator:
	extends Control

	var active_stage := 0
	var accent_color := Color("#0070b8")
	var phase := 0.0
	var animation_elapsed := 0.0
	const ANIMATION_INTERVAL_SECONDS := 0.08

	func _init() -> void:
		custom_minimum_size = Vector2(118, 34)
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		set_process(true)

	func set_state(next_stage: int, next_color: Color) -> void:
		active_stage = clampi(next_stage, 0, 3)
		accent_color = next_color
		queue_redraw()

	func _process(delta: float) -> void:
		animation_elapsed += delta
		if animation_elapsed < ANIMATION_INTERVAL_SECONDS:
			return
		var elapsed := animation_elapsed
		animation_elapsed = 0.0
		phase = fmod(phase + elapsed * 1.85, 1.0)
		queue_redraw()

	func _draw() -> void:
		var y := size.y * 0.5
		var start_x := 13.0
		var end_x := size.x - 13.0
		var gap := (end_x - start_x) / 3.0
		var progress_end := start_x + gap * float(active_stage)
		if active_stage < 3:
			progress_end += gap * phase

		draw_line(Vector2(start_x, y), Vector2(end_x, y), Color("#d9e7f4"), 4.0, true)
		draw_line(Vector2(start_x, y), Vector2(clampf(progress_end, start_x, end_x), y), accent_color, 4.0, true)

		var comet_x := clampf(progress_end, start_x, end_x)
		draw_circle(Vector2(comet_x, y), 9.0 + sin(phase * TAU) * 1.5, Color(accent_color.r, accent_color.g, accent_color.b, 0.16))
		draw_circle(Vector2(comet_x, y), 3.6, accent_color)

		for i in range(4):
			var center := Vector2(start_x + gap * float(i), y)
			var completed := i <= active_stage
			var color := accent_color if completed else Color("#b9c6d3")
			if i == active_stage:
				var pulse_radius := 10.0 + sin(phase * TAU) * 2.4
				draw_circle(center, pulse_radius, Color(accent_color.r, accent_color.g, accent_color.b, 0.18))
			draw_circle(center, 7.0, Color.WHITE)
			draw_circle(center, 5.2, color)
			draw_circle(center, 2.0, Color.WHITE if completed else Color("#eef4fa"))


class RsSignalMap:
	extends Control

	var progress := 0.0

	func set_progress(value: float) -> void:
		progress = clampf(value, 0.0, 1.0)
		queue_redraw()

	func _draw() -> void:
		var grid_color := Color(1, 1, 1, 0.055)
		for i in range(1, 8):
			var x := size.x * float(i) / 8.0
			draw_line(Vector2(x, 0), Vector2(x, size.y), grid_color, 1.0)
		for i in range(1, 5):
			var y := size.y * float(i) / 5.0
			draw_line(Vector2(0, y), Vector2(size.x, y), grid_color, 1.0)

		var points := PackedVector2Array([
			Vector2(size.x * 0.13, size.y * 0.66),
			Vector2(size.x * 0.28, size.y * 0.48),
			Vector2(size.x * 0.44, size.y * 0.58),
			Vector2(size.x * 0.61, size.y * 0.36),
			Vector2(size.x * 0.78, size.y * 0.51),
			Vector2(size.x * 0.90, size.y * 0.31),
		])
		var total_length := 0.0
		for i in range(points.size() - 1):
			total_length += points[i].distance_to(points[i + 1])

		for i in range(points.size() - 1):
			draw_line(points[i], points[i + 1], Color(1, 1, 1, 0.13), 2.0, true)

		var remaining := total_length * progress
		for i in range(points.size() - 1):
			var from := points[i]
			var to := points[i + 1]
			var segment_length := from.distance_to(to)
			if remaining <= 0.0:
				break
			var t := clampf(remaining / segment_length, 0.0, 1.0)
			draw_line(from, from.lerp(to, t), Color("#ff7a00"), 4.0, true)
			remaining -= segment_length

		for i in range(points.size()):
			var node_alpha := clampf(progress * float(points.size() + 1) - float(i), 0.0, 1.0)
			draw_circle(points[i], 13.0, Color(1, 1, 1, 0.10 + node_alpha * 0.14))
			draw_circle(points[i], 5.0, Color(1.0, 0.478, 0.0, 0.35 + node_alpha * 0.65))


