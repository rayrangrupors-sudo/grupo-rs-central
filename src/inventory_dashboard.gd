func _bulk_delete_stage_meta(stage_key: String) -> Dictionary:
	match stage_key:
		"prepare":
			return {"title": "Conectar", "index": 0}
		"link":
			return {"title": "Vinculo", "index": 1}
		"plate":
			return {"title": "Placa", "index": 2}
		"equipment":
			return {"title": "Aparelho", "index": 3}
		"verify":
			return {"title": "Verificar", "index": 4}
		_:
			return {"title": stage_key, "index": 0}


func _bulk_delete_progress_begin_item(index: int, total: int, label: String, kind: String = "equipment") -> void:
	if bulk_delete_progress_layer == null:
		return
	var noun := "Placa" if kind == "plate" else "Equipamento"
	bulk_delete_progress_current_label.text = "%s %d de %d" % [noun, index, total]
	bulk_delete_progress_serial_label.text = label
	bulk_delete_progress_detail_label.text = "Iniciando exclusao de %s" % label
	if bulk_delete_progress_bar:
		bulk_delete_progress_bar.max_value = maxi(total, 1)
		bulk_delete_progress_bar.value = maxi(index - 1, 0)
	if bulk_delete_progress_flow:
		bulk_delete_progress_flow.set_stage(0)
	for key in ["prepare", "link", "plate", "equipment", "verify"]:
		_bulk_delete_progress_set_step(key, "pending", "Pendente")
	_bulk_delete_progress_set_step("prepare", "active", "Conectando")


func _bulk_delete_progress_stage(stage_key: String, status: String, detail: String = "") -> void:
	if bulk_delete_progress_layer == null:
		return
	_bulk_delete_progress_set_step(stage_key, status, detail)
	var meta := _bulk_delete_stage_meta(stage_key)
	var stage_index := int(meta.get("index", 0))
	if bulk_delete_progress_flow:
		bulk_delete_progress_flow.set_stage(stage_index + (1 if status == "done" else 0))
	if detail != "":
		bulk_delete_progress_detail_label.text = detail


func _bulk_delete_progress_set_step(stage_key: String, status: String, detail: String = "") -> void:
	if not bulk_delete_progress_steps.has(stage_key):
		return
	var data: Dictionary = bulk_delete_progress_steps[stage_key]
	var panel := data.get("panel") as PanelContainer
	var status_label := data.get("status") as Label
	var fill := Color("#f8fafc")
	var border := Color("#dfe8f2")
	var text_color := MUTED
	var text := "Pendente"
	match status:
		"active":
			fill = Color("#e8f3ff")
			border = Color("#a9cfee")
			text_color = BLUE
			text = "Em andamento"
		"done":
			fill = Color("#e9f9f1")
			border = Color("#bfe8d3")
			text_color = GREEN
			text = "Concluido"
		"failed":
			fill = Color("#fff4f4")
			border = Color("#f0b8b8")
			text_color = RED
			text = "Falhou"
		"skipped":
			fill = Color("#f5f7fa")
			border = Color("#d6dde5")
			text_color = BUTTON_MEDIUM_GRAY
			text = "Sem acao"
	if detail != "":
		text = detail
	panel.add_theme_stylebox_override("panel", _style_box(fill, border, 1, 9))
	status_label.text = text
	status_label.add_theme_color_override("font_color", text_color)


func _bulk_delete_progress_finish_item(serial: String, ok: bool, message: String, completed: int, total: int) -> void:
	if bulk_delete_progress_layer == null:
		return
	if ok:
		bulk_delete_progress_success_count += 1
		_bulk_delete_progress_stage("verify", "done", "Confirmado")
	else:
		bulk_delete_progress_fail_count += 1
		_bulk_delete_progress_stage("verify", "failed", "Revisar")
	if bulk_delete_progress_bar:
		bulk_delete_progress_bar.value = completed
	if bulk_delete_progress_score_label:
		bulk_delete_progress_score_label.text = "%d ok | %d falha" % [bulk_delete_progress_success_count, bulk_delete_progress_fail_count]
		bulk_delete_progress_score_label.add_theme_stylebox_override(
			"normal",
			_style_box(Color("#e9f9f1") if bulk_delete_progress_fail_count == 0 else Color("#fff4f4"), Color("#bfe8d3") if bulk_delete_progress_fail_count == 0 else Color("#f0b8b8"), 1, 19)
		)
	bulk_delete_progress_detail_label.text = message
	_bulk_delete_progress_add_result("%s: %s" % [serial, "OK" if ok else "FALHOU"], ok)


func _bulk_delete_progress_add_result(message: String, ok: bool) -> void:
	if bulk_delete_progress_results_body == null:
		return
	bulk_delete_progress_recent_results.push_front(message)
	while bulk_delete_progress_recent_results.size() > 6:
		bulk_delete_progress_recent_results.pop_back()
	for child in bulk_delete_progress_results_body.get_children():
		bulk_delete_progress_results_body.remove_child(child)
		child.queue_free()
	for index in range(bulk_delete_progress_recent_results.size()):
		var label := Label.new()
		label.text = str(bulk_delete_progress_recent_results[index])
		label.clip_text = true
		label.add_theme_font_override("font", UI_FONT)
		label.add_theme_font_size_override("font_size", 14)
		label.add_theme_color_override("font_color", GREEN if index == 0 and ok else MUTED)
		bulk_delete_progress_results_body.add_child(label)


func _bulk_delete_progress_complete(success_count: int, fail_count: int, total: int) -> void:
	if bulk_delete_progress_layer == null:
		return
	if bulk_delete_progress_bar:
		bulk_delete_progress_bar.value = total
	if bulk_delete_progress_flow:
		bulk_delete_progress_flow.set_stage(5)
	bulk_delete_progress_current_label.text = "Processo concluido"
	bulk_delete_progress_serial_label.text = "%d sucesso(s), %d falha(s)" % [success_count, fail_count]
	bulk_delete_progress_detail_label.text = "Exclusao em massa finalizada."


func _close_bulk_delete_progress() -> void:
	if bulk_delete_progress_layer == null:
		return
	remove_child(bulk_delete_progress_layer)
	bulk_delete_progress_layer.queue_free()
	bulk_delete_progress_layer = null
	bulk_delete_progress_bar = null
	bulk_delete_progress_current_label = null
	bulk_delete_progress_serial_label = null
	bulk_delete_progress_detail_label = null
	bulk_delete_progress_score_label = null
