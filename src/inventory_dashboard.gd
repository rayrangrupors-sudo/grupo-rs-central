	actions.add_child(_make_action_button("Testar", ORANGE, ORANGE, Color("#17212b"), Vector2(120, 46), _retry_online_connection))

	firebase_config_status_label = Label.new()
	firebase_config_status_label.text = "Servidor configurado." if bool(summary.get("configured", false)) else "Servidor ainda nao configurado."
	firebase_config_status_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	firebase_config_status_label.add_theme_font_override("font", UI_FONT)
	firebase_config_status_label.add_theme_font_size_override("font_size", 15)
	firebase_config_status_label.add_theme_color_override("font_color", GREEN if bool(summary.get("configured", false)) else RED)
	stack.add_child(firebase_config_status_label)


func _save_firebase_configuration() -> void:
	if not _require_config_vault_access():
		return
	var firebase_sync := _firebase_sync()
	if firebase_sync == null:
		_show_error("Firebase", "Modulo do servidor indisponivel.")
		return
	var saved := bool(firebase_sync.call("configure_account", {
		"database_url": firebase_url_input.text if firebase_url_input != null else "",
		"api_key": firebase_api_key_input.text if firebase_api_key_input != null else "",
		"refresh_token": firebase_refresh_token_input.text if firebase_refresh_token_input != null else "",
	}))
	if not saved:
		_show_warning("Firebase", "Informe URL, chave Web API e um refresh token valido.")
		return
	if firebase_refresh_token_input != null:
		firebase_refresh_token_input.clear()
	_show_success("Firebase", "Configuracao salva. Conectando ao servidor...")


func _show_config_section(section_key: String) -> void:
	if section_key == "sms" and not _branch_supports_sms():
		config_selected_section = "grupo_rs"
		_show_arya_config()
		return
	config_selected_section = section_key
	_show_arya_config()


func _config_section_requires_vault(section_key: String) -> bool:
	return section_key != "updates"


func _build_config_vault_unlock(stack: VBoxContainer) -> void:
	_add_config_section_heading(
		stack,
		"Cofre de credenciais",
		"Digite a senha de seguranca para visualizar ou alterar as integracoes."
	)
	var vault := _secret_vault()
	var vault_status: Dictionary = vault.call("status") if vault != null else {}

	var panel := PanelContainer.new()
	panel.add_theme_stylebox_override("panel", _style_box(Color("#F7FAFD"), Color("#C9D9E7"), 1, 8))
	stack.add_child(panel)
	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 18)
	margin.add_theme_constant_override("margin_right", 18)
	margin.add_theme_constant_override("margin_top", 18)
	margin.add_theme_constant_override("margin_bottom", 18)
	panel.add_child(margin)
	var content := VBoxContainer.new()
	content.add_theme_constant_override("separation", 12)
	margin.add_child(content)

	var state_label := Label.new()
	state_label.text = "Arquivo criptografado pronto." \
		if bool(vault_status.get("ok", false)) else str(vault_status.get("error", "Cofre indisponivel."))
	state_label.add_theme_font_override("font", UI_FONT)
	state_label.add_theme_font_size_override("font_size", 15)
	state_label.add_theme_color_override("font_color", GREEN if bool(vault_status.get("ok", false)) else RED)
	content.add_child(state_label)

	var password_input := LineEdit.new()
	password_input.name = "VaultUnlockPassword"
	password_input.placeholder_text = "Senha do cofre"
	password_input.secret = true
	password_input.custom_minimum_size = Vector2(0, 46)
	password_input.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_style_line_edit(password_input)
	content.add_child(_make_labeled_control("Senha de seguranca", password_input))

	var feedback := Label.new()
	feedback.name = "VaultUnlockFeedback"
	feedback.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	feedback.add_theme_font_override("font", UI_FONT)
	feedback.add_theme_font_size_override("font_size", 14)
	feedback.add_theme_color_override("font_color", MUTED)
	content.add_child(feedback)

	var unlock_action := func() -> void:
		if vault == null:
			feedback.text = "Cofre indisponivel."
			feedback.add_theme_color_override("font_color", RED)
			return
		var result: Dictionary = vault.call("unlock_view", password_input.text)
		password_input.clear()
		if not bool(result.get("ok", false)):
			feedback.text = str(result.get("message", "Senha incorreta."))
			feedback.add_theme_color_override("font_color", RED)
			password_input.grab_focus()
			return
		config_secrets_revealed = false
		_show_config_section(config_selected_section)

	password_input.text_submitted.connect(func(_value: String): unlock_action.call())
	var actions := HBoxContainer.new()
	actions.add_theme_constant_override("separation", 10)
	content.add_child(actions)
	actions.add_child(_make_action_button("Desbloquear", BLUE, BLUE, Color.WHITE, Vector2(160, 44), unlock_action))
	password_input.call_deferred("grab_focus")


func _build_config_vault_toolbar(stack: VBoxContainer) -> void:
	var vault := _secret_vault()
	var seconds_remaining := int(vault.call("view_seconds_remaining")) if vault != null else 0
	var panel := PanelContainer.new()
	panel.add_theme_stylebox_override("panel", _style_box(Color("#EAF8F1"), Color("#9BD8BA"), 1, 7))
	stack.add_child(panel)
	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_top", 8)
	margin.add_theme_constant_override("margin_bottom", 8)
	panel.add_child(margin)
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 9)
	margin.add_child(row)
	var state := Label.new()
	state.text = "Cofre desbloqueado por %d min" % maxi(int(ceil(float(seconds_remaining) / 60.0)), 1)
	state.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	state.add_theme_font_override("font", UI_FONT)
	state.add_theme_font_size_override("font_size", 14)
	state.add_theme_color_override("font_color", Color("#087A4D"))
	row.add_child(state)
	var reveal_text := "Ocultar credenciais" if config_secrets_revealed else "Mostrar credenciais"
	row.add_child(_make_action_button(
		reveal_text,
		Color("#EAF8F1"),
		Color("#6EC49B"),
		Color("#087A4D"),
		Vector2(175, 36),
		_toggle_config_secret_visibility
	))
	row.add_child(_make_action_button(
		"Bloquear",
		Color("#6C7F91"),
		Color("#6C7F91"),
		Color.WHITE,
		Vector2(105, 36),
		_lock_config_vault
	))


func _toggle_config_secret_visibility() -> void:
	if not _require_config_vault_access():
		return
	config_secrets_revealed = not config_secrets_revealed
	_show_config_section(config_selected_section)


func _lock_config_vault() -> void:
	var vault := _secret_vault()
	if vault != null:
		vault.call("lock_view")
	config_secrets_revealed = false
	_show_config_section(config_selected_section)


func _require_config_vault_access() -> bool:
	var vault := _secret_vault()
	if vault != null and bool(vault.call("is_view_unlocked")):
		return true
	config_secrets_revealed = false
	_show_warning("Cofre bloqueado", "Desbloqueie as credenciais novamente em Configuracoes.")
	_show_config_section(config_selected_section)
	return false


func _populate_unlocked_config_credentials(settings: Dictionary) -> void:
	if not config_secrets_revealed:
		return
	var vault := _secret_vault()
	_reveal_config_line_edit(arya_email_input, str(settings.get("arya_email", "")), false)
	_reveal_config_line_edit(arya_password_input, str(settings.get("arya_password", "")))
	if arya_manual_token_input != null and is_instance_valid(arya_manual_token_input):
		arya_manual_token_input.text = str(settings.get("arya_token", ""))
	_reveal_config_line_edit(grupo_rs_modern_user_input, str(settings.get("grupo_rs_modern_user", "")), false)
	_reveal_config_line_edit(grupo_rs_modern_password_input, str(settings.get("grupo_rs_modern_password", "")))
	_reveal_config_line_edit(grupo_rs_api_user_input, str(settings.get("grupo_rs_api_user", "")), false)
	_reveal_config_line_edit(grupo_rs_api_password_input, str(settings.get("grupo_rs_api_password", "")))
	_reveal_config_line_edit(grupo_rs_legacy_user_input, str(settings.get("grupo_rs_legacy_user", "")), false)
	_reveal_config_line_edit(grupo_rs_legacy_password_input, str(settings.get("grupo_rs_legacy_password", "")))
	for branch_id in grupo_rs_legacy_branch_inputs.keys():
		var controls: Dictionary = grupo_rs_legacy_branch_inputs.get(branch_id, {})
		var branch_config := _branch_config(str(branch_id))
		var credentials := _legacy_grupo_rs_credentials_for_branch(str(branch_id), settings)
		var url_input: LineEdit = controls.get("url") as LineEdit
		var user_input: LineEdit = controls.get("user") as LineEdit
		var password_input: LineEdit = controls.get("password") as LineEdit
		_reveal_config_line_edit(url_input, str(branch_config.get("grupo_rs_base_url", "")), false)
		_reveal_config_line_edit(user_input, str(credentials.get("username", "")), false)
		_reveal_config_line_edit(password_input, str(credentials.get("password", "")))
	_reveal_config_line_edit(sga_rastreio_api_token_input, str(settings.get("sga_rastreio_api_token", "")))
	_reveal_config_line_edit(sga_rastreio_user_input, str(settings.get("sga_rastreio_user", "")), false)
	_reveal_config_line_edit(sga_rastreio_password_input, str(settings.get("sga_rastreio_password", "")))
	_reveal_config_line_edit(sga_protecao_api_token_input, str(settings.get("sga_protecao_api_token", "")))
	_reveal_config_line_edit(sga_protecao_user_input, str(settings.get("sga_protecao_user", "")), false)
	_reveal_config_line_edit(sga_protecao_password_input, str(settings.get("sga_protecao_password", "")))
	_reveal_config_line_edit(linksolutions_email_input, str(settings.get("linksolutions_email", "")), false)
	_reveal_config_line_edit(linksolutions_password_input, str(settings.get("linksolutions_password", "")))
	_reveal_config_line_edit(experttexting_username_input, str(settings.get("experttexting_username", "")), false)
	_reveal_config_line_edit(experttexting_api_key_input, str(settings.get("experttexting_api_key", "")))
	_reveal_config_line_edit(experttexting_api_secret_input, str(settings.get("experttexting_api_secret", "")))
	_reveal_config_line_edit(openai_api_key_input, str(settings.get("openai_api_key", "")))
	if vault != null:
		_reveal_config_line_edit(
			firebase_api_key_input,
			str(vault.call("get_secret", "firebase", "api_key", ""))
		)
		_reveal_config_line_edit(
			firebase_refresh_token_input,
			str(vault.call("get_secret", "firebase", "refresh_token", ""))
		)


func _reveal_config_line_edit(input: Variant, value: String, keep_secret_style: bool = true) -> void:
	if input == null or not is_instance_valid(input) or not input is LineEdit:
		return
	var line_edit := input as LineEdit
	line_edit.text = value
	if keep_secret_style:
		line_edit.secret = false


func _make_config_nav_button(text_value: String, section_key: String) -> Button:
	var active := config_selected_section == section_key
	var button := Button.new()
	button.text = text_value
	button.custom_minimum_size = Vector2(0, 43)
	button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	button.focus_mode = Control.FOCUS_NONE
	var icon_path := _config_nav_icon_path(section_key)
	if icon_path != "":
		button.icon = load(icon_path)
		button.icon_alignment = HORIZONTAL_ALIGNMENT_LEFT
		button.add_theme_constant_override("h_separation", 9)
	button.add_theme_font_override("font", UI_FONT)
	button.add_theme_font_size_override("font_size", 14)
	var fill := BLUE_DARK if active else Color("#F8FAFD")
	var border := BLUE_DARK if active else Color("#F8FAFD")
	var font_color := Color.WHITE if active else BLUE_DARK
	button.add_theme_color_override("font_color", font_color)
	button.add_theme_color_override("font_hover_color", font_color)
	button.add_theme_color_override("font_pressed_color", font_color)
	button.add_theme_color_override("icon_normal_color", font_color)
	button.add_theme_color_override("icon_hover_color", font_color)
	button.add_theme_color_override("icon_pressed_color", font_color)
	button.add_theme_stylebox_override("normal", _style_box(fill, border, 1, 6))
	button.add_theme_stylebox_override("hover", _style_box(_button_hover_fill(fill), Color("#D9E5F0"), 1, 6))
	button.add_theme_stylebox_override("pressed", _style_box(_button_pressed_fill(fill), border.darkened(0.08), 1, 6))
	button.pressed.connect(func(): _show_config_section(section_key))
	return button


func _config_nav_icon_path(section_key: String) -> String:
	match section_key:
		"firebase":
			return ICON_DIR + "navigation/communications.svg"
		"arya", "codex", "luna":
			return ICON_DIR + "navigation/guardian.svg"
		"grupo_rs", "grupo_rs_araguaina", "grupo_rs_acailandia", "grupo_rs_maraba":
			return ICON_DIR + "navigation/monitor.svg"
		"sga":
			return ICON_DIR + "navigation/settings.svg"
		"linksolutions":
			return ICON_DIR + "navigation/inventory.svg"
		"sms":
			return ICON_DIR + "mensagem.svg"
		"updates":
			return ICON_DIR + "atualizar.svg"
	return ""


