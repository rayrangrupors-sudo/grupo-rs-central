func _request_delete_all_maintenances() -> void:
	var rows := store.get_maintenances()
	if rows.is_empty():
		_show_warning("Manutencoes", "Nao ha manutencoes pendentes para deletar.")
		return

	_confirm_action(
		"Deletar todas",
		"Deseja realmente deletar todas as %d manutencoes desta lista?\nEsta acao remove apenas os registros locais de manutencao." % rows.size(),
		_delete_all_maintenances
	)


func _delete_all_maintenances() -> void:
	var rows := store.get_maintenances()
	var deleted := 0
	var failures := 0
	for item in rows:
		var id := str(item.get("id", "")).strip_edges()
		if id == "":
			failures += 1
			continue
		if store.delete_maintenance(id):
			deleted += 1
		else:
			failures += 1

	var message := "Deletadas: %d | Falhas: %d" % [deleted, failures]
	_log_system_action("Deletou manutencoes em massa", message)
	_refresh_maintenance_schedule_rows()
	_refresh_maintenance_done_rows()
	if failures == 0:
		_show_success("Manutencoes", message)
	else:
		_show_warning("Manutencoes", message)


func _delete_maintenance(id: String) -> void:
	if store.delete_maintenance(id):
		_log_system_action("Deletou manutencao", id)
		_refresh_maintenance_schedule_rows()
		_refresh_maintenance_done_rows()
		_show_success("Sucesso", "Manutencao deletada.")
	else:
		_show_error("Erro", "Nao foi possivel deletar.")


func _parse_maintenance_text(text: String) -> ParseResult:
	var result := ParseResult.new()

	var rows: Array[Dictionary] = []
	var errors: Array[String] = []

	var normalized_text := text.replace("\r\n", "\n").replace("\r", "\n")
	var line_number := 0

	for raw_line in normalized_text.split("\n"):
		line_number += 1

		var line := str(raw_line).strip_edges()
		if line == "":
			continue

		var cells := _split_bulk_line(line)

		if cells.size() < 3:
			errors.append("Linha %d: use cliente, placa e número de série." % line_number)
			continue

		var client := _clean_pasted_cell(cells[0])
		var plate := _normalize_bulk_plate(_clean_pasted_cell(cells[1]))
		var serial := _clean_xlsx_serial(_clean_pasted_cell(cells[2]))

		if client == "" or plate == "" or serial == "":
			errors.append("Linha %d: dados incompletos." % line_number)
			continue

		rows.append({
			"client": client,
			"plate": plate,
			"serial": serial,
			"provider": _clean_pasted_cell(cells[3]) if cells.size() > 3 else "",
			"phone": _clean_pasted_cell(cells[4]) if cells.size() > 4 else "",
			"source_date": _clean_pasted_cell(cells[5]) if cells.size() > 5 else "",
		})

	result.rows = rows
	result.errors = errors

	return result


func _filter_logs_by_type(logs: Array[Dictionary], filter_key: String) -> Array[Dictionary]:
	var key := filter_key.strip_edges().to_lower()
	if key == "" or key == "all":
		return logs
	var result: Array[Dictionary] = []
	for entry in logs:
		if _log_matches_type(entry, key):
			result.append(entry)
	return result


func _log_matches_type(entry: Dictionary, filter_key: String) -> bool:
	var action := str(entry.get("action", "")).to_lower()
	var details := str(entry.get("details", "")).to_lower()
	var joined := "%s %s" % [action, details]
	match filter_key:
		"completed":
			return _system_log_is_completed(entry)
		"progress":
			return not _system_log_is_error(entry) and not _system_log_is_completed(entry)
		"fallback":
			return bool(entry.get("fallback_used", false)) or str(entry.get("transport", "")).to_lower() == "web"
		"sms":
			return action.contains("enviou reset") or joined.contains("sms")
		"recovered":
			return action.contains("recuperado")
		"maintenance":
			return joined.contains("manut")
		"errors":
			return _system_log_is_error(entry)
		_:
			return true


