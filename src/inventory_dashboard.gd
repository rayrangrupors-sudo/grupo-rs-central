func _save_legacy_grupo_rs_credentials() -> bool:
	if not _require_config_vault_access():
		return false
	var settings := _read_json_dictionary(SETTINGS_PATH)
	var branch_ids := _visible_legacy_branch_ids()
	if branch_ids.is_empty():
		_set_legacy_grupo_rs_config_status("Abra uma pagina regional antes de salvar as credenciais.", RED)
		return false
	var invalid: Array[String] = []
	var saved_count := 0
	for branch_id in branch_ids:
		var config := _branch_config(branch_id)
		var controls: Dictionary = grupo_rs_legacy_branch_inputs.get(branch_id, {})
		var url_input: LineEdit = controls.get("url") as LineEdit
		var user_input: LineEdit = controls.get("user") as LineEdit
		var password_input: LineEdit = controls.get("password") as LineEdit
		var configured_url := str(url_input.text if url_input else config.get("grupo_rs_base_url", "")).strip_edges()
		var credentials := _legacy_grupo_rs_credentials_for_branch(branch_id, settings)
		var username := str(user_input.text if user_input else "").strip_edges()
		var password := str(password_input.text if password_input else "")
		if username == "":
			username = str(credentials.get("username", "")).strip_edges()
		if password == "":
			password = str(credentials.get("password", ""))
		if not (configured_url.begins_with("http://") or configured_url.begins_with("https://")):
			invalid.append("%s: URL invalida" % str(config.get("name", branch_id)).capitalize())
			continue
		if username == "" or password == "":
			invalid.append("%s: login ou senha ausente" % str(config.get("name", branch_id)).capitalize())
			continue
		settings[_legacy_branch_setting_key(branch_id, "base_url")] = configured_url
		settings[_legacy_branch_setting_key(branch_id, "user")] = username
		settings[_legacy_branch_setting_key(branch_id, "password")] = password
		saved_count += 1

	# Mantem os campos antigos para importar configuracoes existentes, sem usa-los quando a base possui credencial propria.
	if saved_count > 0:
		var first_config := _branch_configs().filter(func(item: Dictionary): return str(item.get("grupo_rs_mode", "")) == "legacy")
		if not first_config.is_empty():
			var first_id := str((first_config[0] as Dictionary).get("id", "")).strip_edges().to_lower()
			var first_credentials := _legacy_grupo_rs_credentials_for_branch(first_id, settings)
			settings["grupo_rs_legacy_user"] = str(first_credentials.get("username", ""))
			settings["grupo_rs_legacy_password"] = str(first_credentials.get("password", ""))
	settings["grupo_rs_legacy_saved_at"] = Time.get_datetime_string_from_system(false, true)
	settings["grupo_rs_legacy_delete_base_url"] = str(grupo_rs_legacy_delete_url_input.text if grupo_rs_legacy_delete_url_input else settings.get("grupo_rs_legacy_delete_base_url", LEGACY_GRUPO_RS_DELETE_BASE_URL)).strip_edges()
	if str(settings.get("grupo_rs_legacy_delete_base_url", "")).strip_edges() == "":
		settings["grupo_rs_legacy_delete_base_url"] = LEGACY_GRUPO_RS_DELETE_BASE_URL
	settings["integrations_credentials_saved_at"] = Time.get_datetime_string_from_system(false, true)
	_write_json_dictionary(SETTINGS_PATH, settings)
	if grupo_rs_legacy_password_input:
		grupo_rs_legacy_password_input.clear()
	for controls in grupo_rs_legacy_branch_inputs.values():
		var password_input: LineEdit = (controls as Dictionary).get("password") as LineEdit
		if password_input:
			password_input.clear()
	legacy_grupo_rs_cookies.clear()
	legacy_grupo_rs_logged_in.clear()
	var expected_count := branch_ids.size()
	var branch_names: Array[String] = []
	for visible_branch_id in branch_ids:
		branch_names.append(str(_branch_config(visible_branch_id).get("name", visible_branch_id)).capitalize())
	if invalid.is_empty() and saved_count == expected_count:
		_set_legacy_grupo_rs_config_status("URL e credenciais de %s salvas." % ", ".join(branch_names), GREEN)
	else:
		_set_legacy_grupo_rs_config_status("Salvas %d/%d bases. Pendencias: %s" % [saved_count, expected_count, "; ".join(invalid)], YELLOW if saved_count > 0 else RED)
	_register_integrations_credentials_log()
	return invalid.is_empty() and saved_count == expected_count


func _test_legacy_grupo_rs_credentials() -> void:
	if not _save_legacy_grupo_rs_credentials():
		_set_legacy_grupo_rs_config_status("Salve URL, login e senha desta base regional antes de testar.", YELLOW)
		return
	var branch_ids := _visible_legacy_branch_ids()
	var branch_names: Array[String] = []
	for branch_id in branch_ids:
		branch_names.append(str(_branch_config(branch_id).get("name", branch_id)).capitalize())
	_set_legacy_grupo_rs_config_status("Testando %s..." % ", ".join(branch_names), BLUE_DARK)
	var previous_branch_id := selected_branch_id
	var previous_mode := selected_branch_grupo_rs_mode
	var previous_base_url := selected_branch_grupo_rs_base_url
	var previous_platform_url := selected_branch_grupo_rs_platform_url
	var connected: Array[String] = []
	var failed: Array[String] = []
	for branch_id in branch_ids:
		var config := _branch_config(branch_id)
		selected_branch_id = branch_id
		selected_branch_grupo_rs_mode = "legacy"
		selected_branch_grupo_rs_base_url = str(config.get("grupo_rs_base_url", ""))
		selected_branch_grupo_rs_platform_url = str(config.get("grupo_rs_platform_url", ""))
		var root := _legacy_grupo_rs_root_url()
		legacy_grupo_rs_cookies.erase(root)
		legacy_grupo_rs_logged_in.erase(root)
		var result := await _legacy_grupo_rs_login()
		var name := str(config.get("name", "BASE")).capitalize()
		if bool(result.get("ok", false)):
			connected.append(name)
		else:
			failed.append("%s: %s" % [name, str(result.get("message", "login recusado"))])
	selected_branch_grupo_rs_mode = previous_mode
	selected_branch_grupo_rs_base_url = previous_base_url
	selected_branch_grupo_rs_platform_url = previous_platform_url
	selected_branch_id = previous_branch_id
	if failed.is_empty():
		_set_legacy_grupo_rs_config_status("Bases antigas conectadas: %s." % ", ".join(connected), GREEN)
	else:
		_set_legacy_grupo_rs_config_status("Conectadas: %s | Falhas: %s" % [", ".join(connected), "; ".join(failed)], RED)


func _visible_legacy_branch_ids() -> Array[String]:
	var branch_ids: Array[String] = []
	for branch_id in grupo_rs_legacy_branch_inputs.keys():
		var clean_id := str(branch_id).strip_edges().to_lower()
		if clean_id != "" and not branch_ids.has(clean_id):
			branch_ids.append(clean_id)
	return branch_ids


