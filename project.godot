; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GRUPO RS CENTRAL"
config/version="4.0.115"
run/main_scene="res://scenes/estoque_profissional.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.027451, 0.227451, 0.458824, 1)
boot_splash/show_image=false
config/icon="res://assets/branding/app_icon.png"

[autoload]

SecretVault="*res://src/security/secret_vault.gd"
UpdateBootstrap="*res://src/update_bootstrap.gd"
FirebaseSync="*res://src/firebase_sync.gd"
AppEventBus="*res://src/core/app_event_bus.gd"
IntegrationManager="*res://src/integrations/integration_manager.gd"
ModuleRegistry="*res://src/core/module_registry.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

EXIT={
"deadzone": 0.2,
"events": [null, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
minimizar={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194342,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
